  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "PSA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekele maka mmeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.1",
                "verseOrgIds": [
                  "PSA.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", lee na eze na-aṅụrị ọṅụ nʼike gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:1"
      },
      "items": [
        {
          "text": "Obi na-atọkwa ya ụtọ nke ukwuu nʼihi mmeri niile i nyere ya!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nyela ya ihe obi ya chọrọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:2"
      },
      "items": [
        {
          "text": "i mekwaara ya ihe niile ọ rịọrọ gị!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.2",
                "verseOrgIds": [
                  "PSA.21.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ji ngọzị bara ụba nabata ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:3"
      },
      "items": [
        {
          "text": "ọ bụkwa okpueze e ji ọlaedo a ṅụchara nke ọma kpụọ ka i kpukwasịrị ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ rịọrọ ka i nye ya ndụ, i zara ekpere ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:4"
      },
      "items": [
        {
          "text": "mekwaa ka o nwee ogologo ndụ nke ga-adịgide ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsọpụrụ ya dị ukwuu site na mmeri niile i nyere ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:5"
      },
      "items": [
        {
          "text": "ebube na ịma mma bụ onyinye i nyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, i nyela ya ngọzị na-adịgide ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:6"
      },
      "items": [
        {
          "text": "i mere ka o nwee obi ụtọ nke na-esite nʼọṅụ nke nọnyere gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na eze na-atụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.7",
                "verseOrgIds": [
                  "PSA.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "obi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "agaghị ewezuga ya nʼọnọdụ ya site nʼịhụnanya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "nke Onye kachasị ihe niile elu nke na-enweghị ọgwụgwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-anwụchi ndị iro gị niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:8"
      },
      "items": [
        {
          "text": "aka nri gị ga-ejidekwa ndị kpọrọ gị asị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị pụtara ịlụ ọgụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "ị ga-erepịa ha dịka ọkụ nke na-enwu ajọ onwunwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "Nʼoke iwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.9",
                "verseOrgIds": [
                  "PSA.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-elo ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "ọkụ ya ga-erepịakwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-esite nʼelu ụwa laa agbụrụ ha niile nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:10"
      },
      "items": [
        {
          "text": "ụmụ ha kwa site, nʼetiti ụmụ mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na ha nwere ike ịpịa ọpịpịa ọjọọ megide gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:11"
      },
      "items": [
        {
          "text": "maọbụ tụpụta atụmatụ ọjọọ, ha agaghị emezu ebumnuche ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na i ga-eme ka ha gbaghachi azụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:12"
      },
      "items": [
        {
          "text": "mgbe i kwere ụta gị tụgide ha nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.13",
                "verseOrgIds": [
                  "PSA.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ka e bulie gị elu nʼihi ike gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:13"
      },
      "items": [
        {
          "text": "anyị ga-abụ abụ ma tokwaa ike gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.13",
            "verseOrgIds": [
              "PSA.21.14"
            ]
          }
        }
      ]
    }
  ],
