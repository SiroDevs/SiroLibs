          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ndị agha eze apụghị ịzọpụta ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
