      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:15"
      },
      "items": [
        {
          "text": "ọ na-ahụzu, na-amazukwa ihe niile ha na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
