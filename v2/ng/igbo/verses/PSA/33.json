      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:14"
      },
      "items": [
        {
          "text": "onye ọbụla bi nʼelu ụwa anya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
