      "attrs": {
        "style": "q2",
        "vid": "PSA 33:18"
      },
      "items": [
        {
          "text": "ya bụ ndị niile na-atụkwasị obi ha nʼịhụnanya ya, nke na-adịghị agwụ agwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
