      "attrs": {
        "style": "q2",
        "vid": "PSA 33:16"
      },
      "items": [
        {
          "text": "o nweghị onye agha ọbụla na-azọpụta onwe ya, site nʼịdị ukwuu nke ike ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
