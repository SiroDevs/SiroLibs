          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼebe obibi ya na-ele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
