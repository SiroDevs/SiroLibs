      "attrs": {
        "style": "q2",
        "vid": "PSA 33:17"
      },
      "items": [
        {
          "text": "Ọ bụ ezie na ịnyịnya dị ike, ma ha apụghị ịzọpụta ndị nwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
