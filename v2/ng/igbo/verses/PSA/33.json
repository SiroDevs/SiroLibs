                "verseOrgIds": [
                  "PSA.33.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ji anya ya na-eche ndị niile na-atụ ya egwu nche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
