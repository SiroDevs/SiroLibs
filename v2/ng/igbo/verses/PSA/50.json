  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "PSA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Asaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ofufe zuruoke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.50.1",
                "verseOrgIds": [
                  "PSA.50.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke, Onye kachasị chi niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:1"
      },
      "items": [
        {
          "text": "ekwuola okwu ma kpọkọta ụwa niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:1"
      },
      "items": [
        {
          "text": "site na ọwụwa anyanwụ ruo na ọdịda ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke na-enwupụta dịka ìhè, site na Zayọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:2"
      },
      "items": [
        {
          "text": "nke zuruoke nʼime ịma mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke anyị na-abịa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "ọ gaghị emechikwa ọnụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "ọkụ na-erepịa erepịa dị nʼihu ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "oke ifufe na-efesi ike gbakwara ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-akpọku eluigwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:4"
      },
      "items": [
        {
          "text": "na ụwa ka o kpee ndị ya ikpe: Ọ na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chikọtaranụ m ndị m e doro nsọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:5"
      },
      "items": [
        {
          "text": "bụ ndị mụ na ha ji ịchụ aja gbaa ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eluigwe na-ekwupụta ezi omume ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:6"
      },
      "items": [
        {
          "text": "nʼihi na Chineke nʼonwe ya bụ onye ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.50.6",
                "verseOrgIds": [
                  "PSA.50.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nụrụnụ, ndị m, m ga-ekwukwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:7"
      },
      "items": [
        {
          "text": "Izrel, aga m agba ama megide unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:7"
      },
      "items": [
        {
          "text": "Abụ m Chineke, Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaghị m abara unu mba nʼihi ịchụ aja unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:8"
      },
      "items": [
        {
          "text": "na aja nsure ọkụ unu nke na-adị m nʼihu oge niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enweghị m mkpa maka oke ehi unu site nʼụlọ anụmanụ unu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:9"
      },
      "items": [
        {
          "text": "maọbụ mkpi site nʼọgba igwe ewu na atụrụ unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ụmụ anụmanụ niile nke oke ọhịa bụ nke m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:10"
      },
      "items": [
        {
          "text": "ha na ehi niile nọ nʼelu otu puku ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaara m ụmụ nnụnụ niile nọ nʼelu ugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:11"
      },
      "items": [
        {
          "text": "ihe niile e kere eke nọ nʼọhịa bụ nke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na agụụ agụọ m, agaghị m agwa gị ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:12"
      },
      "items": [
        {
          "text": "nʼihi na ụwa na ihe niile dị nʼime ya bụ nke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m ata anụ oke ehi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:13"
      },
      "items": [
        {
          "text": "ka ọ bụ ọbara mkpi ka m ga-aṅụ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chụọrọ Chineke aja ekele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:14"
      },
      "items": [
        {
          "text": "mezuo nkwa i kwere Onye kachasị ihe niile elu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma kpọkuo m nʼụbọchị nsogbu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:15"
      },
      "items": [
        {
          "text": "aga m agbapụta unu, unu ga-enyekwa m nsọpụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke na-agwa ndị na-eme ihe ọjọọ okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "\"Olee, nkwuwa okwu unu nwere ịgụgharị iwu m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "maọbụ kwupụta ọgbụgba ndụ m nʼọnụ unu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu kpọrọ ndụmọdụ m asị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:17"
      },
      "items": [
        {
          "text": "na-atụfekwa okwu m nʼazụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu hụrụ onye ohi, unu na ya na-ejikọta aka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.18",
            "verseOrgIds": [
              "PSA.50.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:18"
      },
      "items": [
        {
          "text": "unu na ndị na-akwa iko na-ekekọkwa oke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.18",
            "verseOrgIds": [
              "PSA.50.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ unu na-eme ọsịịsọ ikwu okwu ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.19",
            "verseOrgIds": [
              "PSA.50.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:19"
      },
      "items": [
        {
          "text": "okwu aghụghọ na nke rere ure na-esikwa nʼọnụ unu na-asọpụta dịka iyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.19",
            "verseOrgIds": [
              "PSA.50.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na-ekwugide ụmụnna unu mgbe niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.20",
            "verseOrgIds": [
              "PSA.50.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:20"
      },
      "items": [
        {
          "text": "na-ekwutọkwa nwanne unu nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.20",
            "verseOrgIds": [
              "PSA.50.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka unu mere ma agbachiri m nkịtị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:21"
      },
      "items": [
        {
          "text": "unu chekwara na adị m ka unu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 50:21"
      },
      "items": [
        {
          "text": "Ma aga m abara unu mba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:21"
      },
      "items": [
        {
          "text": "ma bokwaa unu ebubo unu nʼihu unu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tụgharịa uche na nke a, unu ndị na-echefu Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.22",
            "verseOrgIds": [
              "PSA.50.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:22"
      },
      "items": [
        {
          "text": "ma ọ bụghị ya, aga m adọrisi unu, ọ dịkwaghị onye ga-agbapụta unu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.22",
            "verseOrgIds": [
              "PSA.50.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eji ekele achụrụ m aja, na-asọpụrụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.23",
            "verseOrgIds": [
              "PSA.50.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:23"
      },
      "items": [
        {
          "text": "ọ bụkwa onye na-edozi ụzọ ya, ka m ga-eme ka ọ hụ nzọpụta Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.23",
            "verseOrgIds": [
              "PSA.50.23"
            ]
          }
        }
      ]
    }
