            "number": "1",
            "style": "v",
            "sid": "PSA 103:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m, too",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.1",
                "verseOrgIds": [
                  "PSA.103.1"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:1"
      },
      "items": [
        {
          "text": "ka ihe niile dị nʼime m too aha nsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 103:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m, too",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.2",
                "verseOrgIds": [
                  "PSA.103.2"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:2"
      },
      "items": [
        {
          "text": "echefukwala mmeso ọma ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 103:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụ ya na-agbaghara gị mmehie gị niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:3"
      },
      "items": [
        {
          "text": "na-agwọkwa gị ọrịa gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 103:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye na-agbapụta ndụ gị site nʼolulu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:4"
      },
      "items": [
        {
          "text": "werekwa ịhụnanya na ọmịiko kpukwasị gị dịka okpueze,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 103:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye na-eji ezi ihe na-emejupụta ọchịchọ gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:5"
      },
      "items": [
        {
          "text": "ka oge okorobịa gị bụrụ ihe a gbanwere dịka nke ugo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 103:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.6",
                "verseOrgIds": [
                  "PSA.103.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na-arụ ọrụ ezi omume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:6"
      },
      "items": [
        {
          "text": "na-ekpe ikpe ziri ezi nye ndị a na-emegbu emegbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 103:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka Mosis mata ụzọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:7"
      },
      "items": [
        {
          "text": "mekwaa ka ụmụ Izrel mara ọrụ ya dị iche iche:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 103:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.8",
                "verseOrgIds": [
                  "PSA.103.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nwere obi ọmịiko na-emekwa amara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:8"
      },
      "items": [
        {
          "text": "Ọ dịghị ewe iwe ọsịịsọ, o jupụtara nʼịhụnanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 103:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ya anaghị adịgide ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:9"
      },
      "items": [
        {
          "text": "ọ bụghị oge niile ka ọ na-anọgide na-ata mmadụ ụta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 103:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụghị dịka mmehie anyị si dị ka ọ na-emeso anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:10"
      },
      "items": [
        {
          "text": "ọ dịghị akwụghachi anyị dịka ajọ omume anyị si dị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 103:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na dịka eluigwe si dị elu karịa ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:11"
      },
      "items": [
        {
          "text": "otu a ka ịhụnanya ya si dị ukwuu nʼebe ndị na-atụ egwu ya nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 103:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ọwụwa anyanwụ si dị anya, site nʼọdịda anyanwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:12"
      },
      "items": [
        {
          "text": "otu a ka o sirila mee ka mmehie anyị niile dịrị anya site nʼebe anyị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 103:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka nna si enwe obi ebere nʼebe ụmụ ya nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:13"
      },
      "items": [
        {
          "text": "otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.13",
                "verseOrgIds": [
                  "PSA.103.13"
                ]
              }
            }
          ]
        },
        {
          "text": "si enwe obi ebere nʼebe ndị na-atụ egwu ya nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 103:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ya onwe ya maara otu e si kpụọ anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:14"
      },
      "items": [
        {
          "text": "ọ na-echeta na anyị bụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 103:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe mmadụ nọ, ụbọchị ya niile dị ka ahịhịa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:15"
      },
      "items": [
        {
          "text": "ọ na-etopụta, na-awasa dịka okoko osisi ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
