          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye bụ onye ahụ nwere ike irigo nʼelu ugwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.24.3",
                "verseOrgIds": [
                  "PSA.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:3"
      },
      "items": [
        {
          "text": "Onye nwere ike ịbata guzo nʼime ụlọnsọ ya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ onye aka ya emeghị ihe ọjọọ, obi ya dịkwa ọcha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "onye na-adịghị atụkwasị obi na chi arụsị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "maọbụ ṅụọ iyi aghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
