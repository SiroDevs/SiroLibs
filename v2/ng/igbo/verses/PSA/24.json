    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:1"
      },
      "items": [
        {
          "text": "ụwa na ndị niile bi nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
