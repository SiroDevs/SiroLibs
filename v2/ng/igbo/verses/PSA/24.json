            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụwa na ihe niile dị nʼime ya bụ nke",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.24.1",
                "verseOrgIds": [
                  "PSA.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
