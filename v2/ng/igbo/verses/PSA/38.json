  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "PSA 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Devid. Arịrịọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ nʼoge nsogbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.1",
                "verseOrgIds": [
                  "PSA.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", abarala m mba nʼiwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:1"
      },
      "items": [
        {
          "text": "maọbụ taa m ahụhụ mgbe iwe gị dị ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.1",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na àkụ gị niile amapuola m ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:2"
      },
      "items": [
        {
          "text": "aka gị adakwasịkwala m, dịka ọ bụ ọkpọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi oke iwe gị, ọ dịghị izuoke dị nʼime anụ ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:3"
      },
      "items": [
        {
          "text": "enweghịkwa m udo nʼime ọkpụkpụ m niile nʼihi mmehie m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmetụta ikpe ọmụma m na-adakwasị m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:4"
      },
      "items": [
        {
          "text": "dịka ibu arọ nke dị arọ karịa m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnya m na-ere ure na-asọ oyi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:5"
      },
      "items": [
        {
          "text": "nʼihi mmehie enweghị uche m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m onye a nyidara ma kwatukwaa nʼala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:6"
      },
      "items": [
        {
          "text": "ogologo ụbọchị niile, ana m agagharị nʼiru ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azụ na-egbu m mgbu nke ukwuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:7"
      },
      "items": [
        {
          "text": "ahụ adịghịkwa m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ume ọbụla adịghịkwa nʼime. Adị m ka onye e gwepịara egwepịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:8"
      },
      "items": [
        {
          "text": "Ana m asụ ude nʼihi oke ihe mgbu nke obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Onyenwe m, ị maara agụụ niile nke na-agụ obi m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:9"
      },
      "items": [
        {
          "text": "ịsụ ude m ezokwaghị ezo nʼebe ị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi na-alọ m mmiri, ike na-agwụkwa m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:10"
      },
      "items": [
        {
          "text": "ìhè esitekwala nʼanya m pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị m hụrụ nʼanya na ndị enyi m na-asọ m oyi nʼihi ọnya m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:11"
      },
      "items": [
        {
          "text": "ndị agbataobi m na-anọ m ebe dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-achọ igbu m na-esiri m ọnya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "ndị ahụ chọrọ imerụ m ahụ na-ekwu maka ihe dakwasịrị m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "ogologo ụbọchị niile ha na-agba izuzu aghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adị m ka onye ntị chiri, onye na-apụghị ịnụ ihe ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:13"
      },
      "items": [
        {
          "text": "dịka onye ogbu, onye na-apụghị imeghe ọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adịla m dịka onye na-anaghị anụ ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:14"
      },
      "items": [
        {
          "text": "onye ọnụ ya apụghị ịsa okwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.38.15",
                "verseOrgIds": [
                  "PSA.38.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", ana m eche gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:15"
      },
      "items": [
        {
          "text": "o Onyenwe m Chineke m, ị ga-aza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na asịrị m, \"Ekwela ka ha ṅụrịa ọṅụ nʼisi m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:16"
      },
      "items": [
        {
          "text": "maọbụ bulie onwe ha elu nʼebe m nọ mgbe ụkwụ m na-agbuchapụ.\"",
          "type": "text",
          "attrs": {
