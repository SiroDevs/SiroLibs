      "items": [
        {
          "text": "94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke, onye ikpe nke mmadụ niile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 94:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.1",
                "verseOrgIds": [
                  "PSA.94.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke onye na-abọ ọbọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "o Chineke, onye na-abọ ọbọ, zipụta onwe gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 94:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilie, o Onye Ikpe nke ụwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:2"
      },
      "items": [
        {
          "text": "kwụghachi ndị nganga ụgwọ ọrụ ruuru ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 94:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.3",
                "verseOrgIds": [
                  "PSA.94.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ bụ ruo ole mgbe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:3"
      },
      "items": [
        {
          "text": "Ọ bụ ruo ole mgbe ka ndị na-eme ajọ omume ga-anọgide na-aṅụrị ọṅụ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 94:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-ekwuwapụ okwu mpako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:4"
      },
      "items": [
        {
          "text": "ndị niile na-eme ajọ ihe jupụtara nʼitu ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 94:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-azọpịa ndị gị, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.5",
                "verseOrgIds": [
                  "PSA.94.5"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:5"
      },
      "items": [
        {
          "text": "ha na-emegbu ihe nketa gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 94:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-egbu ndị di ha nwụrụ na ndị ọbịa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:6"
      },
      "items": [
        {
          "text": "ha na-egbu ndị na-enweghị nna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 94:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-asị, \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.7",
                "verseOrgIds": [
                  "PSA.94.7"
                ]
              }
            }
          ]
        },
        {
          "text": "anaghị ahụ ihe ndị a;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:7"
      },
      "items": [
        {
          "text": "Chineke Jekọb na-agba nkịtị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 94:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezienụ anya, unu ndị amamihe kọrọ nʼetiti ndị m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:8"
      },
      "items": [
        {
          "text": "unu ndị nzuzu, olee mgbe unu ga-amụta ihe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 94:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ pụtara na onye kpụrụ ntị anaghị anụ ihe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:9"
      },
      "items": [
        {
          "text": "Ọ pụtara na onye kere anya anaghị ahụ ụzọ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 94:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ pụtara na onye na-adọ mba niile aka na ntị agaghị ata ha ahụhụ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:10"
      },
      "items": [
        {
          "text": "Ọ pụtara na onye na-ezi mmadụ ihe enweghị ihe ọmụma?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 94:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.11",
                "verseOrgIds": [
                  "PSA.94.11"
                ]
              }
            }
          ]
        },
        {
          "text": "maara echiche obi mmadụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:11"
      },
      "items": [
        {
          "text": "ọ maara na ihe mmadụ na-eche nʼobi ya bụ naanị ihe na-enweghị isi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 94:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye a gọziri agọzi ka mmadụ ahụ bụ, onye ị na-adọ aka na ntị, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.12",
                "verseOrgIds": [
                  "PSA.94.12"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:12"
      },
      "items": [
        {
          "text": "onye ahụ ị na-akụziri ihe site nʼiwu gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 94:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ị na-enye ya izuike site nʼụbọchị nsogbu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:13"
      },
      "items": [
        {
          "text": "tutu ruo mgbe a ga-egwuru ndị ajọ omume olulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 94:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.14",
                "verseOrgIds": [
                  "PSA.94.14"
                ]
              }
            }
          ]
        },
        {
          "text": "agaghị ajụ ndị ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:14"
      },
      "items": [
        {
          "text": "ọ gaghị agbakụta ihe nketa ya azụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 94:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi omume ga-abụ ntọala ikpe ikpe niile;",
          "type": "text",
          "attrs": {
