  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "63",
        "style": "c",
        "sid": "PSA 63"
      },
      "items": [
        {
          "text": "63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Devid, mgbe ọ nọ nʼọzara Juda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye ihe Chineke na-agụsị agụụ ike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, ị bụ Chineke m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "e ji m obi m niile na-achọ gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "akpịrị na-akpọ mkpụrụobi m nkụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "anụ ahụ m na-achọsi gị ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "nʼala kpọrọ nkụ na nke ịda mba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "ebe mmiri na-adịghị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụla m gị nʼụlọnsọ gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "hụkwa ike gị na ebube gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ịhụnanya gị dị mma karịa ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:3"
      },
      "items": [
        {
          "text": "aga m eji egbugbere ọnụ m jaa gị mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo ụbọchị m niile ka m ga-eto gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:4"
      },
      "items": [
        {
          "text": "aga m eweli aka m abụọ elu kpọkuo aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m ga-enwe afọ ojuju dịka onye ji ezi nri rijuo afọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:5"
      },
      "items": [
        {
          "text": "aga m eji egbugbere ọnụ jupụtara nʼabụ too gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu ihe ndina m, ana m echeta gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "ana m atụgharị uche nʼihe banyere gị, ogologo abalị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ị bụ onye inyeaka m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:7"
      },
      "items": [
        {
          "text": "ana m abụ abụ nʼokpuru ndo nke nku gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m na-arapara gị nʼahụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:8"
      },
      "items": [
        {
          "text": "aka nri gị na-ejigide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ala ndị na-achọ ndụ m nʼiyi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:9"
      },
      "items": [
        {
          "text": "ha ga-arịda ruo ebe omimi nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-eji mma agha laa ha nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:10"
      },
      "items": [
        {
          "text": "ha ga-abụkwa nri nye nkịta ọhịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 63:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze ga-aṅụrị ọṅụ nʼime Chineke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "ndị niile na-eji aha Chineke aṅụ iyi ga-eto ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "ma a ga-eme ka ọnụ ndị niile na-agha ụgha dere duu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.64",
    "number": "64",
