          "text": "82",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 82",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Asaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke onye ikpe kachasị ndị ikpe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 82:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke na-ewere ọnọdụ ịchị isi nʼetiti ọgbakọ dị ukwuu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:1"
      },
      "items": [
        {
          "text": "ọ na-ekpebi ikpe nʼetiti chi niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 82:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruo ole mgbe ka unu ga-anọgide na-ekpe ikpe na-ezighị ezi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:2"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka unu ga na-egosi ndị ajọ omume ihuọma?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.82.2",
                "verseOrgIds": [
                  "PSA.82.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 82:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kperenụ ndị na-adịghị ike na ndị na-enweghị nna ikpe ziri ezi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:3"
      },
      "items": [
        {
          "text": "hụnụ na ndị ogbenye na ndị a na-emegbu nwetara ihe ruuru ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 82:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbapụtanụ ndị na-adịghị ike na ndị nọ na mkpa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:4"
      },
      "items": [
        {
          "text": "napụta ha site nʼaka ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 82:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        },
        {
          "text": "amaghị ihe ọbụla, ha aghọtaghị ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "Ha na-ejegharị nʼọchịchịrị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "ntọala niile nke ụwa na-ama jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 82:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asịrị m, 'Unu bụ \"chi,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:6"
      },
      "items": [
        {
          "text": "unu niile bụ ụmụ ndị ikom nke Onye kachasị ihe niile elu.'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 82:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu ga-anwụ ọnwụ dịka mmadụ ndị ọzọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:7"
      },
      "items": [
        {
          "text": "unu ga-ada dịka ndị ọchịchị ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 82:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, bilie kpee ụwa ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:8"
      },
      "items": [
        {
          "text": "nʼihi na mba niile bụ ihe nketa gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    }
  ],
