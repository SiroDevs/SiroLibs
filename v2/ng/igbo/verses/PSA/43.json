        {
          "text": "Abụ Ọma 43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ maka enyemaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, kpepụta m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "kpechitere m ikpe m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "nʼebe mba na-amaghị Chineke nọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "gbapụta m site nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "ndị ajọ omume na ndị aghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị bụ Chineke, ebe m e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Gịnị mere i ji jụ m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Gịnị mere m ga-eji na-ejegharị nʼiru ụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "nʼihi mmegbu nke onye iro?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zipụ ìhè gị na eziokwu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "ka ha duo m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "ka ha kpọbata m nʼugwu nsọ gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "bụ ebe i bi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, aga m aga nʼebe ịchụ aja Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "gakwuru Chineke, bụ ọṅụ m na obi ụtọ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "Aga m eji ụbọ akwara too gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "O Chineke, bụ Chineke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mkpụrụobi m, gịnị mere i ji daa mba?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Gịnị mere i ji na-asụ ude nʼime m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Nwee olileanya na Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "nʼihi na m ka ga-eto ya ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "onye Nzọpụta m na Chineke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    }
  ],
