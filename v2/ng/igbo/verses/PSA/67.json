          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 67:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ala ga-amịpụta ihe owuwe ubi ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:6"
      },
      "items": [
        {
          "text": "Chineke, onye bụ Chineke anyị, ga-agọzikwa anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 67:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke ga-agọzi anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:7"
      },
      "items": [
        {
          "text": "nsọtụ niile nke ụwa ga-atụ egwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
