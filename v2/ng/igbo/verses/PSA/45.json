{
  "id": "PSA.45",
  "number": "45",
  "bookId": "PSA",
  "reference": "Abụ Ọma 45",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "PSA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Nʼusoro olu abụ \"Okoko osisi lili.\" Abụ maskil ụmụ Kora. Abụ maka agbamakwụkwọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ ọlụlụ nwunye eze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi okwu dị ebube na-akpali mkpụrụobi m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "mgbe m na-agụgharị abụ m nye eze;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "ire m bụ mkpisi akwụkwọ dị nʼaka ọka ode akwụkwọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I bụ onye kachasị mma nʼetiti ụmụ mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "e ji amara tee egbugbere ọnụ gị mmanụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "ebe ọ bụ na Chineke agọziela gị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenye mma agha gị nʼukwu gị, gị onye dị ike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:3"
      },
      "items": [
        {
          "text": "yikwasị onwe gị ebube na ịma mma dịka uwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebube gị, gaa nʼihu nʼime mmeri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "nʼihi eziokwu, na ịdị obi umeala, na ezi omume;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "ka aka nri gị gosipụta ọrụ gị niile nke na-eju anya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka àkụ gị niile dị nkọ mapuo mkpụrụobi ndị iro niile nke eze;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "text": "ka mba niile na-adakwa nʼokpuru ụkwụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, ocheeze gị ga-adịgide ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:6"
      },
      "items": [
        {
          "text": "mkpara omume ziri ezi ka mkpara alaeze gị ga-abụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị hụrụ ezi omume nʼanya, ma kpọọ ihe ọjọọ asị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "ya mere, Chineke, onye bụ Chineke gị, emeela ka ịdị elu karịa ndị ibe gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "site na ite gị mmanụ nke ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe gị niile jupụtara nʼisisi ụtọ nke si na mmanụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        },
        {
          "text": "máá na aloos na akashia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "ha sitere nʼụlọeze niile, e ji ọdụ enyi chọọ mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "Egwu sitere nʼụbọ akwara na-eme ka i nwee obi ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ agbọghọ eze nọ nʼetiti ndị inyom gị ka a na-asọpụrụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "nwunye eze, onye yikwasịrị ọlaedo nke Ọfịa na-eguzo nʼaka nri gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị, gị nwaagbọghọ, tulee ma nụrụkwa ihe m na-ekwu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:10"
      },
      "items": [
        {
          "text": "\"Chefuo ndị gị na ezinaụlọ nna gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ịma mma gị ga-eme ka eze chọsie gị ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:11"
      },
      "items": [
        {
          "text": "Sọpụrụ ya nʼihi na ọ bụ onyenwe gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada Taịa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        },
        {
          "text": "ga-eji onyinye bịa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:12"
      },
      "items": [
        {
          "text": "ndị ọgaranya ga-achọkwa ka i gosi ha ihuọma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaeze, lee ka o si maa mma dị ukwuu nʼime ụlọ ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:13"
      },
      "items": [
        {
          "text": "ọ bụ akwa a kpanyere ọlaedo ka e ji dụọ uwe mwụda ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ agbọghọ ibe ya, ndị na-amaghị nwoke, na-eso ya bịakwute gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "ọ bụ uwe mwụda a kpanyere ihe ọkpụkpa ka o yi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "mgbe e dubatara ya nʼụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
