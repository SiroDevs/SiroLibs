            "number": "1",
            "style": "v",
            "sid": "PSA 98:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bụkuonụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.1",
                "verseOrgIds": [
                  "PSA.98.1"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ ọhụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "nʼihi na ọ rụọla ọtụtụ ọrụ dị ebube;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "aka nri ya na aka nsọ ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "arụpụtarala ya nzọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 98:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.2",
                "verseOrgIds": [
                  "PSA.98.2"
                ]
              }
            }
          ]
        },
        {
          "text": "emeela ka a mata nzọpụta ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:2"
      },
      "items": [
        {
          "text": "o kpugheela ezi omume ya nye mba niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 98:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O chetala ịhụnanya ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "na ikwesi ntụkwasị obi ya nʼebe ụlọ Izrel dị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "nsọtụ nke ụwa niile ahụla",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "nzọpụta Chineke anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 98:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikusienụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.4",
                "verseOrgIds": [
                  "PSA.98.4"
                ]
              }
            }
          ]
        },
        {
          "text": "mkpu ọṅụ ike, ụwa niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:4"
      },
      "items": [
        {
          "text": "jirinụ iti egwu tiwaa mkpu abụ ọṅụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 98:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "werenụ ụbọ akwara bụkuo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.5",
                "verseOrgIds": [
                  "PSA.98.5"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:5"
      },
      "items": [
        {
          "text": "e, were ụbọ akwara na olu abụ ọma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 98:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "jirinụ opi na opi ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:6"
      },
      "items": [
        {
          "text": "tisie mkpu ọṅụ ike nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.6",
                "verseOrgIds": [
                  "PSA.98.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye bụ Eze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 98:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka oke osimiri niile gbọọ ụja, ya na ihe niile dị nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:7"
      },
      "items": [
        {
          "text": "ụwa na ndị niile bi nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 98:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka osimiri na iyi niile kụọ aka ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:8"
      },
      "items": [
        {
          "text": "ka ugwu niile bụkuokwa ya abụ nʼihi ọṅụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 98:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ha bụọ abụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.9",
                "verseOrgIds": [
                  "PSA.98.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "nʼihi na ọ na-abịa ikpe ụwa ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "Ọ ga-eji ezi omume kpee ụwa ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "Ọ ga-eji ikpe ziri ezi kpee ndị niile ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    }
