            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.11",
                "verseOrgIds": [
                  "PSA.46.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile nọnyere anyị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.11",
            "verseOrgIds": [
              "PSA.46.12"
            ]
          }
        }
      ]
