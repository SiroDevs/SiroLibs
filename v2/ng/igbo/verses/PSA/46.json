  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "PSA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ ụmụ Kora. Nʼusoro olu abụ alamot. Otu Abụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke bụ ebe mgbaba anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke bụ ebe mgbaba anyị, na ike anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:1"
      },
      "items": [
        {
          "text": "onye inyeaka anyị ka ọ bụ nʼoge nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, anyị agaghị atụ egwu, ọ bụladị mgbe ụwa niile na-emebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:2"
      },
      "items": [
        {
          "text": "maọbụ mgbe a na-ewezuga ugwu nʼọnọdụ ha, mee ka ha daba nʼoke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na mmiri ya na-agba aghara, na-asụkwa ụfụfụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:3"
      },
      "items": [
        {
          "text": "maọbụ na ugwu niile na-eme mkpọtụ site nʼoke mbili elu ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.3",
                "verseOrgIds": [
                  "PSA.46.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu iyi dị nke na-asọbata na-eweta ọṅụ nʼime obodo Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:4"
      },
      "items": [
        {
          "text": "nʼime ebe obibi dị nsọ nke Onye kachasị ihe niile elu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke bi nʼime ya, ọ gaghị ada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:5"
      },
      "items": [
        {
          "text": "Chineke ga-enyere ya aka mgbe chi bọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile na-agba aghara, alaeze niile na-adakwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:6"
      },
      "items": [
        {
          "text": "o welitere olu ya elu, ụwa na-agbaze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.7",
                "verseOrgIds": [
                  "PSA.46.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile nọnyere anyị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:7"
      },
      "items": [
        {
          "text": "Chineke nke Jekọb bụ ebe mgbaba anyị e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.7",
                "verseOrgIds": [
                  "PSA.46.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bịa, hụrụ ihe ebube niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.8",
                "verseOrgIds": [
                  "PSA.46.9"
                ]
              }
            }
          ]
        },
        {
          "text": "mere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:8"
      },
      "items": [
        {
          "text": "lee oke ịla nʼiyi niile o webatara nʼelu ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eme ka agha kwụsị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:9"
      },
      "items": [
        {
          "text": "ruo nsọtụ nke elu ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 46:9"
      },
      "items": [
        {
          "text": "Ọ na-agbaji ụta, na-ebibi ùbe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:9"
      },
      "items": [
        {
          "text": "ma na-esu ọta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        },
        {
          "text": "agha niile ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-asị, \"Nọọnụ juu! Maranụ na mụ onwe m bụ Chineke!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "A ga-ebuli m elu nʼetiti mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "a ga-ebulikwa m elu nʼụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
