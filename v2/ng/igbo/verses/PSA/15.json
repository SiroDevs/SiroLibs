        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye ga-ebi nʼugwu nsọ Onyenwe anyị?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.15.1",
                "verseOrgIds": [
                  "PSA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye pụrụ ịnọgide nʼụlọnsọ ukwu gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:1"
      },
      "items": [
        {
          "text": "Onye pụrụ ibi nʼugwu nsọ gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-ebi ndụ nke na-enweghị ịta ụta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "onye na-arụ ọrụ ezi omume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:2"
      },
      "items": [
        {
          "text": "onye na-ekwu eziokwu site nʼobi ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.2",
            "verseOrgIds": [
              "PSA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye jụrụ ikwutọsị ndị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "onye na-adịghị eme onye agbataobi ya ihe ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:3"
      },
      "items": [
        {
          "text": "na onye na-adịghị ekwulu mmadụ ibe ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye na-eleda onye ajọ omume anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "ma na-asọpụrụ ndị ahụ na-atụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.15.4",
                "verseOrgIds": [
                  "PSA.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "onye na-adịghị agbanwe nkwa ọbụla o kwere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:4"
      },
      "items": [
        {
          "text": "ọ bụladị mgbe nkwa ahụ na-emegide ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.4",
            "verseOrgIds": [
              "PSA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye na-agbazinye mmadụ ego na-anaghị ụma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "onye na-adịghị a nara ngarị imegide onye aka ya dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 15:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "Onye na-eme ihe ndị a",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:5"
      },
      "items": [
        {
          "text": "agaghị ama jijiji nʼọnọdụ ya, mgbe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.5",
            "verseOrgIds": [
              "PSA.15.5"
            ]
          }
        }
      ]
    }
  ],
