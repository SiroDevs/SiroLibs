            "number": "20",
            "style": "v",
            "sid": "1CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụkwa ndị ndu a họpụtara nʼebo Livayị:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 24:20"
      },
      "items": []
    },
    {
