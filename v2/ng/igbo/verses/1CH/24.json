      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:20"
      },
      "items": [
        {
          "text": "Site nʼụmụ Shubuel a họpụtara Jehdeia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        }
      ]
    },
    {
