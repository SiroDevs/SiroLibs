          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụmụ Hebrọn a họpụtara",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:23"
      },
      "items": [
        {
          "text": "Jeraya, nwa mbụ ya, Amaraya nwa nke abụọ ya, Jahaziel nwa nke atọ ya na Jekameam nwa nke anọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A họpụtara Maịka nwa Uziel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:24"
      },
      "items": [
        {
          "text": "sitekwa nʼụmụ Maịka họpụta Shamia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A họpụtara nwanne Maịka nke nwoke aha ya bụ Ishaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:25"
      },
      "items": [
        {
          "text": "sitekwa nʼụmụ Ishaya họpụta Zekaraya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụmụ Merari e nwere Mahali na Mushi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:26"
      },
      "items": [
        {
          "text": "A họpụtakwara Beno nwa Jaazia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitekwa nʼụmụ Merari a họpụtara ụmụ Jaazia ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:27"
      },
      "items": [
        {
          "text": "Beno, Shoham, Zakua na Ibri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụmụ Mahali a họpụtara Elieza, ma Elieza nʼonwe ya amụtaghị nwa nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
              "1CH.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụmụ Kish a họpụtara Jerameel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
              "1CH.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
