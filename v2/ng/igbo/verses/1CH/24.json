      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 24:20"
      },
      "items": [
        {
          "text": "Site nʼụmụ Amram, a họpụtara Shubuel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        }
      ]
    },
    {
