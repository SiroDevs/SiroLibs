            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka e si keere ha usoro ije ozi ha mgbe ha batara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.24.19",
                "verseOrgIds": [
                  "1CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". E mere ya dị ka ụkpụrụ nna nna ha Erọn nyere ha si dị, dịka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.24.19",
                "verseOrgIds": [
                  "1CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ndu ọzọ e nwere nʼebo Livayị",
          "type": "text"
        }
      ]
    },
    {
