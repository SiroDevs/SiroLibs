  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzube Devid banyere Ụlọnsọ ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid kpọkọtara ndịisi ozi niile nke Izrel, ka ha zukọọ na Jerusalem, bụ ndị ndu ebo Izrel niile, na ndị ọchịagha nke otu ndị agha nọ nʼọrụ eze. Ndị ọzọ bụ ndịisi agha na-achị ọtụtụ puku ndị agha, na ndịisi agha na-achị ọtụtụ narị ndị agha, na ndịisi ozi na-elekọta ihe niile na anụ ụlọ niile nke eze na ụmụ ya ndị ikom nwere, tinyere ndị ozi niile nọ nʼụlọeze, na ndị bụ dimkpa na ndị niile bụ dike nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Devid biliri kwụrụ ọtọ sị, \"Geenụ m ntị, unu ụmụnna m, na ndị m. Ọ bụrịị ihe dị m nʼobi iwu ụlọ nke ga-abụ ebe izuike nye igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.2",
            "verseOrgIds": [
              "1CH.28.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.2",
                "verseOrgIds": [
                  "1CH.28.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke ga-abụ ebe mgbakwasị ụkwụ nye Chineke anyị. Edokọtachaala m ihe e ji ewu ya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.2",
            "verseOrgIds": [
              "1CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma Chineke sịrị m, 'Ọ bụghị gị ga-ewu ụlọ nye Aha m, nʼihi na ị bụ onye na-ebu agha, onye wufuru ọbara site nʼigbu ọtụtụ mmadụ nʼagha.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.3",
            "verseOrgIds": [
              "1CH.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma otu ọ dị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.4",
                "verseOrgIds": [
                  "1CH.28.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel esitela nʼetiti ikwu m họpụta m, mee m eze Izrel ruo ebighị ebi. Ọ họọrọ ebo Juda dịka onyendu. Ọ bụkwa site nʼebo Juda ka o si họrọ ụlọ nna m, sitekwa nʼetiti ụmụnne m ndị ikom họrọ m. Mee m eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.5",
                "verseOrgIds": [
                  "1CH.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "enyela m ọtụtụ ụmụ ndị ikom, ma site nʼime ha ọ họpụtara Solomọn nwa m ka ọ nọkwasị nʼocheeze nke alaeze",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.5",
                "verseOrgIds": [
                  "1CH.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara m, 'Solomọn nwa gị, bụ onye ga-ewuru m ụlọ m, na ogige m niile, nʼihi na ahọpụtala m ya ị bụrụ m nwa, aga m abụkwara ya nna.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.6",
            "verseOrgIds": [
              "1CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na o debe ihe niile m nyere nʼiwu, mezuo ha dịka o si eme nʼoge a. Aga m eme ka alaeze ya dịgide ruo ebighị ebi.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, ugbu a ana m enye unu iwu nʼihu ndị Izrel niile, na nʼihu ọgbakọ ndị nke",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.8",
                "verseOrgIds": [
                  "1CH.28.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nʼihu Chineke anyị. Kpachapụnụ anya chọpụta ma debekwa iwu niile nke",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.8",
                "verseOrgIds": [
                  "1CH.28.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, ka unu nwee ike nweta ezi ala nke a; ma nyefeekwa ya dịka ihe nketa nʼaka ụmụ ụmụ unu ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị, Solomọn nwa m, mara Chineke nke nna gị, jiri obi zuruoke, na mmụọ nwere njikere mgbe niile fee",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.9",
                "verseOrgIds": [
                  "1CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ofufe, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.9",
                "verseOrgIds": [
                  "1CH.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "na-enyocha obi mmadụ niile. Ọ na-aghọtakwa ihe niile anyị bu nʼobi na echiche niile. Ọ bụrụ na ị chọsie ụzọ ya ike, ị ga-achọta ya, ma ọ bụrụ na ị jụ ya, ọ ga-ajụ gị ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpachapụ anya, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.10",
                "verseOrgIds": [
                  "1CH.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọrọla gị iwuru ya ụlọnsọ ya. Dị ike, rụọkwa ọrụ a e tinyere gị nʼaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid nyere Solomọn nwa ya ihe e sere gbasara otu ọ ga-esi wuo ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.11",
                "verseOrgIds": [
                  "1CH.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, na nke ụlọ ndị ọzọ niile ga-adị nʼime ya, na nʼakụkụ ya; ụlọakụ ya niile, na ime ụlọ elu ya, na ime ụlọ ya, na ụlọ ebe ikpuchi mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyekwara ya ihe osise gosiri ihe niile nke Mmụọ Nsọ tinyere ya nʼuche banyere ogige ụlọnsọ ukwuu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.12",
                "verseOrgIds": [
                  "1CH.28.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, na ọnụụlọ niile dị ya gburugburu, maka ụlọ nchịkọta akụ nke ụlọnsọ Chineke nakwa akụ niile nke e doro nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid nyekwara Solomọn iwu otu ọ ga-esi kewaa ndị nchụaja na ndị Livayị, na iwu metụtara ọrụ ije ozi niile nke ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.28.13",
                "verseOrgIds": [
                  "1CH.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", na iwu metụtara ngwongwo niile e ji eje ozi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ wepụtara ọlaedo dị ukwuu maka iji ya kpụọ ngwongwo ọlaedo a ga-eji jee ozi dị iche iche. Ọ wepụtakwara ọlaọcha dị ukwu maka iji ya kpụọ ngwongwo ọlaọcha a ga-eji jee ozi dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ wepụtara ọlaedo nke e ji akpụ iheọkụ na ihe ịdọba iheọkụ. Wepụtakwa ọlaọcha ga-ezu ịkpụ oriọna ọlaọcha, na ihe ịdọba ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ wepụtara ọlaedo e ji akpụ tebul achịcha nsọ, na ọlaedo e ji akpụ tebul ndị ọzọ, na ọlaọcha e ji akpụ tebul ọlaọcha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.16",
            "verseOrgIds": [
              "1CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ wepụtara ọlaedo a nụchara anụcha a ga-eji kpụọ ndụdụ e ji adụrụ anụ e ji chụọ aja, efere ịkwọsa mmiri na ite mmiri; ọlaedo zuru nke e ji akpụta efere ọlaedo ọbụla, na ọlaọcha zuru nke e ji akpụta efere ọlaọcha ọbụla, wepụtakwa ọlaọcha na ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, o wepụtara ọlaedo a nụchara anụcha a ga-eji kpụọ ebe ịchụ aja ihe nsure ọkụ na-esi isi ụtọ. O nyere ya ihe osise gosiri otu a ga-esi wuo ụgbọ agha, ya bụ, mmụọ ozi cherubim ndị ahụ e ji ọlaedo kpụọ, ndị gbasapụrụ nku ha nʼelu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.18",
            "verseOrgIds": [
              "1CH.28.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
