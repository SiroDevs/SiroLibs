                "verseOrgIds": [
                  "1CH.28.20"
                ]
              }
            }
          ]
        },
        {
          "text": "gwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
            "verseOrgIds": [
              "1CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja ndị a niile, na ndị Livayị jikeere ịrụ ọrụ niile metụtara ụlọnsọ ukwu Chineke ahụ. Ndị ọzọ bụ ndị ọka ọrụ dị iche iche ndị o metụrụ nʼobi ga-abịakwa inyere gị aka, ma ndị ozi, ma ndị Izrel niile; ha ga-emezu iwu ọbụla i nyere ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.21",
            "verseOrgIds": [
              "1CH.28.21"
            ]
          }
        }
