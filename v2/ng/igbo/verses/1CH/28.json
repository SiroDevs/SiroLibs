              "type": "text"
            }
          ]
        },
        {
          "text": "Devid kwuru sị, \"E deela ihe niile gbasara osise ụlọnsọ ukwu a nʼakwụkwọ nke m sitere na ntụziaka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
