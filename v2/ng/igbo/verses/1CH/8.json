  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1CH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usoro ọmụmụ Sọl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benjamin mụtara ụmụ ndị ikom ise. Aha ha nʼusoro dịka e si mụọ ha bụ:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:1"
      },
      "items": [
        {
          "text": "Bela nke mbụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:1"
      },
      "items": [
        {
          "text": "nke abụọ Ashbel, nke atọ Ahara,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke anọ Noha, na nke ise Rafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom Bela mụrụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.3",
            "verseOrgIds": [
              "1CH.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:3"
      },
      "items": [
        {
          "text": "Aada, Gera, Abihud,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.3",
            "verseOrgIds": [
              "1CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishua, Neeman, Ahoa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.4",
            "verseOrgIds": [
              "1CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gera, Shefufan na Huram.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.5",
            "verseOrgIds": [
              "1CH.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Ehud ndị bụ ndịisi ezinaụlọ na Geba, ndị bụkwa ndị e si na Geba chụpụ mee ka ha gaa biri na Manahat bụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6",
            "verseOrgIds": [
              "1CH.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeman, Ahija na Gera, onye chụpụrụ ha na onye bụkwa nna Ụza na Ahihud.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.7",
            "verseOrgIds": [
              "1CH.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mụtara Shaharaim ụmụ ndị ikom na Moab mgbe ọ gbachara ndị nwunye ya abụọ bụ Hushim na Baara alụkwaghị m.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.8",
            "verseOrgIds": [
              "1CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwunye ya Hodesh mụtara Jobab, Zibịa, Mesha, Malkam,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.9",
            "verseOrgIds": [
              "1CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeuz, Sakia na Miama. Ndị a bụ ụmụ ya ndị ikom, ndị bụkwa ndịisi ezi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.10",
            "verseOrgIds": [
              "1CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupu ọ chụpụ nwunye ya Hushim, ọ mụtaara ya Abaịtub, na Elpaal.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.11",
            "verseOrgIds": [
              "1CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elpaal mụrụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:12"
      },
      "items": [
        {
          "text": "Eba, Misham, Shemed (onye wuru obodo Ono na Lod, na obodo nta gbara ha gburugburu).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ya ndị ọzọ bụ Beriya, na Shema, ndị bụ ndịisi ezinaụlọ ndị bi nʼAijalon. Ọ bụ ha chụpụrụ ndị Gat site nʼobodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beriya mụrụ Ahio, Shashak, Jeremot,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.14",
            "verseOrgIds": [
              "1CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebadaya, Arad, Eda,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.15",
            "verseOrgIds": [
              "1CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maikel, Ishpa na Joha, ndị a bụ ụmụ ndị ikom Beriya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.16",
            "verseOrgIds": [
              "1CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebadaya, Meshulam, Hizki, Heba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.17",
            "verseOrgIds": [
              "1CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmerai, Izlaya na Jobab bụ ụmụ Elpaal.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.18",
            "verseOrgIds": [
              "1CH.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakim, Zikri, Zabdi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.19",
            "verseOrgIds": [
              "1CH.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elienai, Ziletai, Eliel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.20",
            "verseOrgIds": [
              "1CH.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaya, Beraya na Shimrat bụ ụmụ Shimei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.21",
            "verseOrgIds": [
              "1CH.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishpan, Eba, Eliel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.22",
            "verseOrgIds": [
              "1CH.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abdon, Zikri, Hanan,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.23",
            "verseOrgIds": [
              "1CH.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hananaya, Elam, Antotija,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.24",
            "verseOrgIds": [
              "1CH.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifdeya na Penuel bụ ụmụ ndị ikom Shashak.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.25",
            "verseOrgIds": [
              "1CH.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroham mụrụ Shamsherai, Sheharaya, Atalaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.26",
            "verseOrgIds": [
              "1CH.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaareshaya, Ịlaịja na Zikri bụ ụmụ ndị ikom Jeroham.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a niile bụ ndịisi ezi, ndị ndu, ndị bi na Jerusalem, ndị e depụtara aha ha nʼakwụkwọ usoro ọmụmụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeiel nna Gibiọn biri na Gibiọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:29"
      },
      "items": [
        {
          "text": "Aha nwunye ya bụ Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ mụrụ Abdon, ọkpara ya, Zua, Kish, Baal, Nea, Nadab,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.30",
            "verseOrgIds": [
              "1CH.8.30"
            ]
          }
        },
        {
          "name": "verse",
