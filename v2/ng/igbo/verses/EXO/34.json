  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "EXO 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbadamba nkume ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.1",
                "verseOrgIds": [
                  "EXO.34.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis, \"Wapụta mbadamba nkume abụọ dịka nke mbụ, aga m edekwasị nʼelu ha okwu niile nke dị nʼelu mbadamba nkume ndị mbụ ahụ, bụ nke ị tụpịasịrị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.1",
            "verseOrgIds": [
              "EXO.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jikere nʼụtụtụ, rigoro ugwu Saịnaị ka i chee onwe gị nʼihu m nʼelu ugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.2",
            "verseOrgIds": [
              "EXO.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla esokwala gị, ma ọ bụkwanụ nọdụ nso ugwu ahụ. Ekwekwala ka igwe ehi maọbụ igwe atụrụ kpaa nri nso nso ugwu ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.3",
            "verseOrgIds": [
              "EXO.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis biliri nʼisi ụtụtụ, waa mbadamba nkume abụọ dịka ndị nke mbụ, rigoro ugwu Saịnaị dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.4",
                "verseOrgIds": [
                  "EXO.34.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ya. Ọ jikwa nkume abụọ ahụ nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.5",
                "verseOrgIds": [
                  "EXO.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": "rịdatara nʼime ogidi igwe ojii, guzo nʼihu Mosis, kwupụta aha ya bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.5",
                "verseOrgIds": [
                  "EXO.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O si nʼihu Mosis gafee na-ekwu na-asị, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.6",
                "verseOrgIds": [
                  "EXO.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.6",
                "verseOrgIds": [
                  "EXO.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke ọmịiko na onye amara, onye na-adịghị ewe iwe ọsịịsọ, na onye babigara ụba oke nʼịhụnanya na ikwesi ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-egosi ịhụnanya ya nye imerime puku, ma na-agbaghara ajọ omume na nnupu isi, na mmehie. Ma ọ dịghị ahapụ ka onye ikpe mara laa na-anataghị ahụhụ, ọ na-ata ụmụ na ụmụ ụmụ ha ahụhụ nʼihi mmehie nna nna ha ruo nʼọgbọ nke atọ na nke anọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.7",
            "verseOrgIds": [
              "EXO.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mgbe ahụ, Mosis hulatara kpọọ isiala,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.8",
            "verseOrgIds": [
              "EXO.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "sị ya, \"Ọ bụrụ nʼezie na m achọtala ihuọma nʼanya gị, Onyenwe m, ka Onyenwe m, biko soro anyị gaa. Ọ bụ ezie na ndị a bụ ndị isiike, gbaghara anyị ajọ omume anyị, na mmehie anyị niile, ka ị nabatakwa anyị dịka ndị nke gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.9",
            "verseOrgIds": [
              "EXO.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.10",
                "verseOrgIds": [
                  "EXO.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Mụ onwe m na gị na-agba ndụ. Nʼihu ndị gị niile, aga m arụ oke ọrụ ịtụnanya dị ukwu, ụdị nke a na-emetụbeghị mbụ nʼụwa, maọbụ na mba ọ bụla. Ndị niile unu bi nʼetiti ha ga-ahụ ọrụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.10",
                "verseOrgIds": [
                  "EXO.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọrụ ahụ dị oke egwu nke m ga-arụ nʼihi unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debe ihe niile m nyere gị nʼiwu taa. Aga m esite nʼihu unu chụpụ ndị Amọrait, ndị Kenan, ndị Het, ndị Periz, ndị Hiv na ndị Jebus.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.11",
            "verseOrgIds": [
              "EXO.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpacharanụ anya ka unu na ndị bi nʼala ahụ unu na-aba nʼime ya ghara ịgba ndụ. Ka ha ghara ị bụ ihe ịma nʼọnya nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.12",
            "verseOrgIds": [
              "EXO.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, tikpọọnụ ebe ịchụ aja ha niile. Kụrienụ ogidi arụsị ha niile. Gbutukwaanụ osisi Ashera ha jiri mere chi ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.13",
            "verseOrgIds": [
              "EXO.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu efela chi ọzọ, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.14",
                "verseOrgIds": [
                  "EXO.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye aha ya bụ Ekworo, bụ Chineke na-ekwo ekworo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kpacharanụ anya ka unu na ndị bi nʼala ahụ ghara ịgba ndụ, nʼihi na mgbe ha na-akwaso chi ha iko, na-achụkwa aja nye chi ha, ha ga-akpọ unu oku nri, mgbe ahụ, unu ga-eri site nʼihe aja ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu lụtara ụfọdụ ndị inyom ha dịka nwunye nye ụmụ unu ndị ikom, ndị inyom ndị a na-akwaso chi ha iko, ga-eme ka ụmụ unu ndị ikom soro ha nʼomume dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu akpụla chi ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Na-emenụ mmemme achịcha na-ekoghị eko. Rienụ achịcha na-ekoghị eko ụbọchị asaa, dịka m nyere nʼiwu na a ga-eme nʼụbọchị ndị ahụ a họpụtara, nʼọnwa Abib, nʼihi na ọ bụ nʼọnwa ahụ ka unu si nʼala Ijipt pụta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nwoke ọbụla e bụ ụzọ mụọ bụ nke m, tinyere ụmụ anụ ụlọ, ma ehi, ma atụrụ, ma ewu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere ike ịgbapụta nwa oke ịnyịnya ibu site nʼiwere nwa atụrụ dochie nʼọnọdụ ya. Ọ bụrụ na i kpebie na ị gaghị agbapụta ya, mgbe ahụ, ị ga-agbaji olu ya. Ma ụmụ unu ndị ikom niile ka a ga-agbapụta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 34:20"
      },
      "items": [
        {
          "text": "\"O nweghị onye ọbụla nʼime unu ga-abịa guzo m nʼihu na-ejighị onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼoge ịkụ ihe nʼubi na nʼoge owuwe ihe ubi, rụọnụ ọrụ naanị ụbọchị isii. Zukwanụ ike nʼụbọchị nke asaa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.21",
            "verseOrgIds": [
              "EXO.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mee Mmemme Izu Ụka asaa, bụ nke ị ga-eji mkpụrụ mbụ nke ọka wiiti mee, na Mmemme Nchịkọta Ihe nʼọgwụgwụ afọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugboro atọ nʼafọ ka ndị ikom unu niile ga-abịa chee onwe ha nʼihu Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.23",
                "verseOrgIds": [
                  "EXO.34.23"
                ]
              }
            }
          ]
        },
        {
          "text": "nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na aga m esite nʼihu unu chụpụ mba dị iche iche. Meekwa ka ala unu saa mbara. Ọ dịghị onye ọbụla ga-enwe anya ukwu nʼebe ala unu dị, mgbe unu na-aga iche onwe unu nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.24",
                "verseOrgIds": [
                  "EXO.34.24"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, ugbo atọ nʼafọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu etinyekwala ihe ọbụla nke nwere ihe na-eko achịcha nʼime ya, mgbe unu na-achụ ọbara nke aja nye m. Unu ahapụkwala aja sitere na Mmemme Ngabiga ka ọ nọọ ruo ụtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wetanụ mkpụrụ mbụ niile nke ala ubi unu, bụ ndị kachasị mma nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.26",
                "verseOrgIds": [
                  "EXO.34.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 34:26"
      },
      "items": [
        {
          "text": "\"Unu esikwala nwa ewu nʼime mmiri ara nne ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.27",
                "verseOrgIds": [
                  "EXO.34.27"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị, \"Dee iwu ndị a m nyere gị, nʼihi na dịka okwu ndị a si dị, ka ọgbụgba ndụ mụ na gị na ụmụ Izrel gbara si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.28",
                "verseOrgIds": [
                  "EXO.34.28"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ nʼebe ahụ iri ụbọchị anọ, ehihie na abalị. Ma nʼoge ndị a niile o righị nri ọbụla. Ọ ṅụkwaghị ihe ọṅụṅụ ọbụla. O dere na mbadamba nkume abụọ ahụ okwu niile nke ọgbụgba ndụ ahụ, nke bụ iwu iri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mosis arịdata site nʼugwu Saịnaị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis ji mbadamba nkume abụọ nke ihe ama ahụ na-arịdata site nʼelu ugwu ahụ, ọ mataghị na ihu ya na-egbuke egbuke, nʼihi ọnọdụ nke ọ nọrọ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.29",
                "verseOrgIds": [
                  "EXO.34.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi mgbuke ahụ ihu Mosis na-egbuke, ụjọ ekweghị Erọn na ụmụ Izrel bịaruo ya nso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Mosis kpọrọ ha ka ha bịakwute ya. Nʼihi ya, Erọn na ndị ndu nzukọ Izrel bịara ka ha na Mosis kparịtaa ụka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e mesịrị, ndị Izrel niile bịakwutere ya. O nyekwara ha iwu ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.32",
                "verseOrgIds": [
                  "EXO.34.32"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya nʼelu ugwu Saịnaị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis gwachara ha okwu, o weere akwa kpuchie ihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọbụla ọ na-abanye nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.34",
                "verseOrgIds": [
                  "EXO.34.34"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ha kparịtaa ụka nʼime ụlọ nzute ahụ, ọ na-ekepụ akwa ahụ o ji kpuchie ihu ya tutu ruo mgbe ọ nọchara pụta. Mgbe ọ pụtara, ọ na-agwa ndị Izrel ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.34",
                "verseOrgIds": [
                  "EXO.34.34"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha hụkwara na ihu ya na akpụkpọ ihu ya na-egbuke egbuke. Emesịa, Mosis na-ekpuchikwa ihu ya tutu ruo mgbe ọ ga-abanye nʼime ka ya na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.35",
                "verseOrgIds": [
                  "EXO.34.35"
                ]
              }
            }
          ]
        },
        {
          "text": "kparịta ụka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        }
      ]
    }
  ],
