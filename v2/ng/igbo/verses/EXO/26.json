  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "EXO 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụlọ nzute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rụọ ụlọ nzute nke ga-enwe akwa mgbochi iri, nke e ji ezi ogho na-acha anụnụ anụnụ, na ngwakọta anụnụ na uhie, na uhie uhie kpaa akwa ndị a. Onye ọrụ aka na-eme ǹka kpanyekwara oyiyi cherubim nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi ndị a ga-aha nʼotu. O nweghị nke ga-aka ibe ya. Ogologo akwa mgbochi ọbụla ga-abụ mita iri na abụọ na ọkara. Obosara ya bụ otu mita na sentimita asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dụkọtaa akwa mgbochi ise nʼotu, dụkọtaakwa ise nke ọzọ nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri akwa na-acha anụnụ anụnụ dụnye anya nko nʼelu ọnụ akwa mgbochi nke otu ụzọ, otu a ka ị ga-emekwa na nsọtụ ọnụ akwa mgbochi nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dụnye iri anya nko ise nʼotu akwa mgbochi, dụnyekwa iri anya nko ise nʼọnụ akwa mgbochi nke ọzọ. Mee ka anya nko ndị a chee ibe ha ihu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-emekwa iri nko ọlaedo ise, nke ị ga-eji jikọta akwa mgbochi abụọ ahụ nʼotu, si otu a mee ka ụlọ nzute ahụ bụrụ otu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị ga-eji akpụkpọ ajị ewu mee akwa mgbochi maka i ji kpuchie elu ụlọ nzute ahụ. Iri na otu ka ha ga-adị nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi iri na otu ndị a ga-aha nʼotu. Ọ ga-abụ mita iri na atọ na ọkara nʼogologo. Ebe obosara ya bụ otu mita na iri sentimita asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dụkọtaa ise nʼime akwa mgbochi ahụ. Debe ya iche. Dụkọtakwa isii nke fọdụrụ debekwa ya iche. Pịajie akwa mgbochi nke isii ụzọ abụọ nʼihu ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dụnyekwa iri anya nko ise nʼelu ọnụ otu akwa mgbochi ndị ahụ. Meekwa otu ihe ahụ nʼọnụ akwa mgbochi nke ọzọ e debere iche.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meekwa iri nko bronz ise, mee ka nko ahụ baa nʼanya nko nke ọzọ, i ji jikọta ụlọ nzute ahụ ka ọ bụrụ otu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ogologo akwa mgbochi nke fọdụrụ maka ụlọ nzute, ya bụ ọkara akwa mgbochi nke mapụtara, nke a ga-akwụba nʼazụ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi ahụ ga-eji ihe ruru ọkara mita nʼogologo karịa nʼakụkụ abụọ. Ụma ndị a mapụtara ga-akwụdata nʼakụkụ abụọ nke ụlọ nzute ahụ ikpuchi ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eji akpụkpọ ebule e sijiri uhie uhie mee ihe mkpuchi maka ụlọ nzute ahụ, ya na akwa mkpuchi ọzọ nke e ji akpụkpọ ehi mmiri mee maka ikpukwasị nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị ga-emere ụlọ nzute ahụ mbudo ibo osisi akashia, guzo ọtọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbudo ibo ọbụla ga-adị mita anọ na ọkara nʼogologo, dịrịkwa iri sentimita asaa nʼobosara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbudo ibo ndị a ga-enwe ihe nhịọnye abụọ nke ga-abanye nʼime ibe ya ijikọ ha nʼotu. Ị ga-arụ mbudo ibo ụlọ nzute ahụ niile otu a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-arụ mbudo ibo iri abụọ maka akụkụ ndịda nke ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meekwa iri ụkwụ ọlaọcha anọ nʼokpuru ha. Otu mbudo ibo ga-enwe ụkwụ abụọ, otu ụkwụ nʼokpuru otu ihe nhịọnye, otu ụkwụ nʼokpuru ihe nhịọnye nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ nke ọzọ, bụ akụkụ ugwu nke ụlọ nzute ahụ, ị ga-arụkwa iri mbudo ibo abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rụkwaa iri ụkwụ ọlaọcha anọ, ụkwụ abụọ nʼokpuru mbudo ibo ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe isi isi nsọtụ, ya bụ akụkụ ọdịda anyanwụ nke ụlọ nzute, ị ga-arụ mbudo ibo isii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rụọ mbudo ibo abụọ, ga-adị na nkuku niile nke nsọtụ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi nkuku abụọ ndị a, ha ga-anọ iche iche site nʼokpuru ruo nʼelu ya, ma a ga-ejikọ ha ọnụ nʼime otu mgbaaka, ha abụọ ga-adị otu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile ga-adị mbudo ibo asatọ na ụkwụ ọlaọcha dị iri na isii, ya bụ ụkwụ abụọ nʼokpuru mbudo ibo ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jiri osisi akashia mee osisi ntụbichi, ise maka mbudo ibo ndị dị nʼotu akụkụ nke ụlọ nzute,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ise nke ọzọ maka ndị dị nʼakụkụ nke ọzọ, ise nke ọzọ maka mbudo ibo dị nʼakụkụ ọdịda anyanwụ, nʼebe ndịda ndịda nke ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osisi ntụbichi nke dị nʼetiti ga-esite nʼotu isi ruo nʼisi nke ọzọ nke mbudo ibo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri ọlaedo machie mbudo ibo ndị ahụ niile, kpụọ mgbaaka ọlaedo ka ọ bụrụ ọnọdụ ịchịkọta osisi ntụbichi ndị a. Jirikwa ọlaedo machie osisi ntụbichi ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Guzobe ụlọ nzute a nʼusoro dịka ụdịdị ihe ahụ m ziri gị nʼelu ugwu si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
            "verseOrgIds": [
              "EXO.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meekwa akwa mgbochi nke e ji ogho na-acha anụnụ anụnụ, ngwakọta anụnụ na uhie, uhie uhie na ezi akwa ọcha a kpara nke ọma, onye ǹka kpanyekwara oyiyi cherubim nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were anya nko ọlaedo kwụba ya nʼelu ogidi osisi akashia anọ nke e ji ọlaedo machie, mee ka o guzoro nʼelu ụkwụ ọlaọcha anọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye akwa mgbochi ahụ na nko ndị ahụ, ma dọnye igbe ihe ama ahụ nʼazụ akwa mgbochi ahụ. Akwa mgbochi ahụ ga-ekewapụ Ebe Nsọ ahụ site nʼEbe Kachasị Nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinye ihe mkpuchi mmehie ahụ nʼelu igbe ihe ama nʼime Ebe Kachasị Nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dọnye tebul ahụ na mpụta nke akwa mgbochi ahụ, nʼakụkụ ugwu nke ụlọ nzute ahụ. Dọnyekwa ihe ịdọkwasị iheọkụ na ncherita ihu tebul ahụ, nʼakụkụ ndịda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị ga-eme akwa mgbochi maka ọnụ ụzọ mbata nke ụlọ ikwu ahụ nke eji ogho na-acha anụnụ anụnụ na ngwakọta anụnụ na uhie, na uhie uhie, na ezi akwa ọcha a kpara nke ọma, nke bụ akaọrụ onye ǹka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-arụrụ akwa mgbochi a anya nko ọlaedo na ogidi ise nke osisi akashia nke e ji ọlaedo machie. Ị ga-arụkwa ụkwụ bronz ise maka ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
              "EXO.26.37"
            ]
          }
        }
      ]
    }
