  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "EXO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebe ịchụ aja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị ga-eji osisi akashia wuo ebe ịchụ aja. Ịdị elu ya ga-abụ otu mita na iri sentimita anọ. Ogologo ya na obosara ya ga-aha nʼotu, mita abụọ na iri sentimita atọ, mita abụọ na iri sentimita atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rụnye mpi nʼakụkụ anọ nke ebe ịchụ aja ahụ nʼotu nʼotu. Mee ka mpi ndị a na ebe ịchụ aja ahụ bụrụ ihe e jikọtara nʼotu. Jiri bronz machie ebe ịchụ aja a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.2",
            "verseOrgIds": [
              "EXO.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri bronz kpụọ ngwongwo niile dị iche iche, ya bụ efere ikpofu ntụ, shọvel ya niile, efere ịkwọsa mmiri niile, ngaji eze ịdụta anụ na efere ndị e ji agụ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.3",
            "verseOrgIds": [
              "EXO.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eme ngịga mbadamba, ihe ọkpụkpa bronz, meekwa mgbaaka bronz nke ga-adị nʼakụkụ anọ nke ngịga ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.4",
            "verseOrgIds": [
              "EXO.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinye ya nʼokpuru oghere dị nʼebe ịchụ aja ahụ. Tinye ya ka ọ dịrị nʼetiti ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.5",
            "verseOrgIds": [
              "EXO.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri osisi akashia mee mkpara osisi maka ebe ịchụ aja ahụ, were bronz machie ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.6",
            "verseOrgIds": [
              "EXO.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-eme ka mkpara ahụ baa nʼime mgbaaka ndị ahụ, ka ha dị nʼakụkụ abụọ nke ebe ịchụ aja ahụ mgbe ọbụla a na-ebu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri obodobo osisi rụọ ebe ịchụ aja ahụ, ka o nwee oghere nʼime, dịka igbe. Ị ga-arụ ya dịka e gosiri gị nʼelu ugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogige ụlọ nzute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị ga-arụkwa ogige maka ụlọ nzute ahụ. Nʼakụkụ ndịda ya ga-adị iri mita anọ na ise nʼogologo. Ọ ga-enwekwa akwa mgbochi nke e ji ezi akwa ọcha a kpara nke ọma mee.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ogidi abụọ ga-adị na iri ebe ndọkwasị abụọ nke e ji bronz kpụọ. Anya nko ogidi ndị ahụ ha na ihe ikegide ha ga-abụ ọlaọcha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, akụkụ ugwu ga-adịkwa iri mita anọ na ise. Ọ ga-enwe akwa mgbochi, nwekwa iri ogidi abụọ na iri ebe ndọkwasị abụọ nke e ji bronz kpụọ, ya na anya nko nke ọlaọcha na ihe e ji ekegide ha nʼogidi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akụkụ ọdịda anyanwụ nke ogige ahụ ga-adị iri mita abụọ na atọ nʼobosara. Ọ ga-enwe akwa mgbochi, na ogidi iri na ebe ndọkwasị iri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ọwụwa anyanwụ, ebe anwụ na-awalite, akwa mgbochi ahụ ga-adịkwa iri mita abụọ na atọ nʼobosara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi nke ogologo ya dị mita isii na sentimita iri asatọ ga-adị nʼotu akụkụ nke ọnụ ụzọ mbata ahụ. O nwere ogidi atọ na ebe ndọkwasị atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, akwa mgbochi nke ịdị ogologo ya dị mita asaa ga-adị nʼakụkụ nke ọzọ. Ọ ga-enwekwa ogidi atọ na ebe ndọkwasị atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Banyere ọnụ ụzọ mbata nke ogige ahụ, mee akwa mgbochi ga-adị mita itoolu nke e ji ogho na-acha anụnụ anụnụ, ngwakọta anụnụ na uhie, uhie uhie na ezi akwa ọcha a kpara nke ọma, akaọrụ nke onye na-akpa ihe ịchọ mma. Ọ ga-enwe ogidi anọ na ihe ndọkwasị anọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogidi niile dị gburugburu ogige ahụ ga-enwe ihe njikọta ọlaọcha na nko, tinyere ebe ndọkwasị bronz.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo ogige ahụ ga-abụ iri mita anọ na ise. Ebe obosara ya ga-adị iri mita abụọ na atọ. Ọ ga-enwe akwa mgbochi nke ịdị elu ya dị iri mita abụọ na atọ, nke e ji ezi akwa ọcha a kpara nke ọma mee, nwekwa ebe ndọkwasị bronz.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwongwo niile nke e ji eje ozi nʼụlọ nzute ahụ, ihe ọbụla bụ ọrụ ha, tinyere ǹtu ya niile na nke ogige ahụ, ga-abụ ihe e ji bronz rụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmanụ ịmụ ọkụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nye ndị Izrel niile iwu ka ha wetara gị mmanụ oliv asụrụ asụ nke a na-agwaghị ihe maka itinye nʼiheọkụ ime ka ọkụ oriọna na-enwu mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ụlọ nzute ahụ, na mpụta nke akwa mgbochi nke kpuchiri igbe Ihe Ama ahụ, Erọn na ụmụ ya ndị ikom ga-eme ka oriọna ndị ahụ dị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.27.21",
                "verseOrgIds": [
                  "EXO.27.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-enwu ọkụ, site nʼuhuruchi ruo nʼụtụtụ. Nke a bụ ụkpụrụ ga-adịgide nʼetiti ndị Izrel nye ọgbọ niile dị nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
  ],
