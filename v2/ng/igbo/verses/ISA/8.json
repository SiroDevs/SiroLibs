            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee mụ onwe m, na ụmụ ndị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.18",
                "verseOrgIds": [
                  "ISA.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere m. Anyị bụ ihe ịrịbama na ihe iji cheta ihe nye ndị Izrel site na",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.18",
                "verseOrgIds": [
                  "ISA.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, onye na-ebi nʼugwu Zayọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọchịchịrị ghọrọ ìhè",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye ọbụla sịrị unu, jụtanụ ndị na-ajụ mmụọ ọjọọ ase na ndị dibịa afa ihe, bụ ndị na-ekwu okwu nʼolu dị nta nke mmadụ na-adịghị anụ nke ọma na ndị na-atamu atamu, ndị mmadụ ọ gaghị ajụ Chineke ha ase? Ọ bụ nʼihi gịnị ka eji jụta ndị nwụrụ anwụ ase nʼihi ndị dị ndụ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezienụ okwu ntụziaka na nke ịdọ aka na ntị Chineke anya. Ọ bụrụ na ozi ha dị iche na nke a, o gosiri na ha enweghị ìhè maọbụ eziokwu ọbụla nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a ga-awagharị nʼala a niile. Agụụ ga-agụ ha, ha ga-adakwa mba. Nʼọnọdụ oke agụụ nke ga-agụ ha, iwe dị ukwuu ga-ewe ha, mee ka ha lelie anya ha nʼelu, kọchaa eze ha, na Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ bụrụ na ha eledata anya ha nʼala ọ bụ naanị oke nsogbu na oke ihe mgbu ka ha ga-ahụ. Ha ga-ahụkwa oke ihe egwu na ọchịchịrị. Ụzọ mgbapụ agaghị adịkwara ha nʼoge nsogbu a. A ga-achụbanye ha nʼime ọchịchịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.22",
            "verseOrgIds": [
              "ISA.8.22"
            ]
          }
        }
      ]
    }
