  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "62",
        "style": "c",
        "sid": "ISA 62"
      },
      "items": [
        {
          "text": "62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aha ọhụrụ nke Zayọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi Zayọn agaghị m emechi ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "nʼihi Jerusalem agaghị m anọ jii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "ruo mgbe ezi omume ya ga-enwuwa dịka ihe ụtụtụ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "mgbe nzọpụta ya kwa ga-enwukwa dịka ọwaọkụ na-enwu enwu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile ga-ahụ ezi omume gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "Ndị eze niile ga-ahụkwa ebube gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "A ga-akpọkwa gị aha ọhụrụ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "nke ọnụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.2",
                "verseOrgIds": [
                  "ISA.62.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-agụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-aghọ okpueze nke ịma mma nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.3",
                "verseOrgIds": [
                  "ISA.62.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:3"
      },
      "items": [
        {
          "text": "ihe iyi nʼisi nke ndị ụlọeze nʼaka Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gakwaghị akpọ gị onye ahapụrụ ahapụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "maọbụ kpọọ ala gị ala tọgbọrọ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "Ma a ga-akpọ gị Hefziba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "kpọkwa ala gị Beula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "nʼihi na ihe gị ga-atọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.4",
                "verseOrgIds": [
                  "ISA.62.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "a ga-alụkwa ala gị dịka nwunye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka nwokorobịa si alụrụ nwaagbọghọ na-amaghị nwoke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "otu a ka Onye na-ewu gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        },
        {
          "text": "ga-alụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "dịka onye lụrụ nwunye ọhụrụ sị aṅụrị ọṅụ nʼebe nwunye ọhụrụ ya nọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "otu a ka Chineke gị ga-aṅụrị ọṅụ nʼihi gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyela m ndị nche ọnọdụ ọrụ nʼelu mgbidi gị niile, Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:6"
      },
      "items": [
        {
          "text": "Ha agaghị edebe ọnụ ha duu mgbe ọbụla, ma ehihie ma abalị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:6"
      },
      "items": [
        {
          "text": "Unu ndị na-akpọku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.6",
                "verseOrgIds": [
                  "ISA.62.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:6"
      },
      "items": [
        {
          "text": "unu enyela onwe unu izuike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu enyekwala ya izuike tutu ruo mgbe ọ ga-eme ka Jerusalem guzosie ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:7"
      },
      "items": [
        {
          "text": "meekwa ya otuto nke ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.8",
                "verseOrgIds": [
                  "ISA.62.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ewerela aka nri ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "werekwa ogwe aka ya ṅụọ iyi sị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "\"Ọ dịghịkwa mgbe m ga-enye mkpụrụ ubi gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "ka ọ bụrụ nri nye ndị iro gị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "ọ dịghịkwa mgbe ndị ọbịa ga-aṅụkwa mmanya ọhụrụ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "bụ nke ị dọgburu onwe gị nʼọrụ nʼihi ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị were ya ka ihe ubi ga-eri ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:9"
      },
      "items": [
        {
          "text": "tookwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.9",
                "verseOrgIds": [
                  "ISA.62.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
