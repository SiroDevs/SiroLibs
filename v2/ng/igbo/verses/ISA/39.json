  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "ISA 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ozi si Babilọn bịa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, Merodak-Baladan, nwa Baladan, bụ eze Babilọn zigaara Hezekaya akwụkwọ ozi ekele na onyinye, nʼihi na ọ nụrụ na Hezekaya rịara ọrịa ma nwe ahụ ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
            "verseOrgIds": [
              "ISA.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya nabatara ndị ozi ahụ nke ọma gosi ha ihe ndị dị nʼụlọakụ ya, ọlaọcha, na ọlaedo, ụda dị iche iche na-esi isi ụtọ, ezigbo mmanụ oliv, ụlọ niile ebe ngwa agha ya niile dị, na ihe niile bụ akụ o nwere. Ọ dịghị ihe dị nʼụlọeze ya maọbụ nʼalaeze ya niile nke ọ na-egosighị ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.2",
            "verseOrgIds": [
              "ISA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Aịzaya onye amụma jekwuru eze Hezekaya jụọ ya sị, \"Gịnị ka ndị ikom ndị ahụ kwuru? Ebeekwa ka ha si bịakwute gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 39:3"
      },
      "items": [
        {
          "text": "Hezekaya zara sị, \"Ọ bụ nʼala dị anya ka ha si bịakwute m, ha si Babilọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye amụma jụrụ, \"Gịnị ka ha hụrụ nʼụlọ gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 39:4"
      },
      "items": [
        {
          "text": "Hezekaya zara sị, \"Ihe niile nke dị nʼụlọ m ka ha hụrụ. Ọ dịghị ihe niile dị nʼụlọakụ m nke m na-egosighị ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Aịzaya sịrị Hezekaya, \"Gee ntị nụrụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.5",
                "verseOrgIds": [
                  "ISA.39.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, oge na-abịa mgbe a ga-eburu ihe niile dị nʼụlọeze gị, na ihe niile nke nna nna gị ha debere nʼụlọakụ ruo taa, buru ha bulaa Babilọn. Ọ dịkwaghị ihe ga-afọdụ, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.6",
                "verseOrgIds": [
                  "ISA.39.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ebupụ ụfọdụ nʼime ụmụ gị, ndị bụ ahụ na ọbara gị, ndị a ga-amụtara gị, buru ha pụọ nʼebe dị anya, ha ga-abụ ndị onozi nʼụlọeze nke eze Babilọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya zaghachiri, \"Okwu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.8",
                "verseOrgIds": [
                  "ISA.39.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nke i kwuru dị mma.\" Nʼihi na o chere nʼobi ya sị, \"Udo na nchekwa ga-adị nʼoge ndụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
  ],
