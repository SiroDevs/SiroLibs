  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "ISA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọdịda Babilọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rịda nʼala, nọdụ na uzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "gị nwaagbọghọ na-amaghị nwoke, bụ ada Babilọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "nọdụ nʼala na-ejighị ocheeze,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "gị eze nwanyị obodo ndị Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "Agaghị akpọkwa gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "onye dị nro, maọbụ onye dị pekepeke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were nkume igwe nri gwee ọka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "wepụ akwa ahụ i ji kpuchie ihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "Chilite uwe mwụda gị, kpughepụ ogwe ụkwụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "mgbe ị na-agabiga iyi dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ekpughe ọtọ gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "tinyekwa gị nʼọnọdụ ihere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "Nʼihi na aga m abọtara ndị m ọbọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "agaghị m elekwa anya nʼazụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka Onye mgbapụta anyị kwuru, Onye ga-azọpụta Izrel. Aha ya bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:4"
      },
      "items": [
        {
          "text": "Onye nsọ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nọdụ duu, baa nʼime ọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "gị eze obodo nke ndị Kaldịa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "Ọ dịkwaghị mgbe ọzọ a ga-akpọ gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "nwanyị nwe alaeze dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewesoro m ndị m iwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "mee ndị ahụ bụ ihe nketa m ka ha ghọọ ihe na-adịghị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "Eweere m ha tinye gị nʼaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "ma i gosighị ha obi ebere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "Ọ bụladị ndị bụ agadi nʼetiti ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "ka ị bokwasịrị ibu arọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "'Abụ m eze nwanyị ruo mgbe ebighị ebi!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "Ma i cheghị echiche banyere ihe ndị a,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "ị tụgharịghị uche banyere ihe pụrụ ime.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a gee ntị, gị onye na-eme dịka o si tọọ gị ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "Gee ntị, gị onye na-anọ nʼudo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "na-asị onwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "'Ọ bụ naanị m dị, o nweghị onye ọzọ ka m nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "O nweghị mgbe m ga-adị ka nwanyị di ya nwụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "maọbụ dịka nwanyị ụmụ ya nwụrụ.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lee anya!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "Ihe abụọ ndị a na-aga ịbịakwasị gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "na mberede.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "Nʼotu ụbọchị di gị ga-anwụ, ụmụ gị ga-anwụchakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "Mgbaasị gị niile, na ịdị ike nke ọgwụ okike gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "agaghị egbochi ihe ndị a ịbịakwasị gị nʼuju.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na i werela obi gị tụkwasị nʼajọ omume gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "ị na-asị, 'O nweghị onye na-ahụ m.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "Ma amamihe gị na ihe ọmụma gị na-eduhie gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "mgbe ị na-asị onwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "'Ọ bụ naanị mụ onwe m, ọ dịghịkwa onye ọzọ ma ewezuga m.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọjọọ ga-abịakwasị gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "ị gaghị ama otu ị ga-esi gbaa afa iwezuga ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "Oke mbibi ga-adakwasị gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "nke ị na-agaghị enwe ike iji ego gbara onwe gị;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "Ịla nʼiyi nke ị na-atụghị anya ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "ga-abịakwasị gị na mberede.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dokọtazie ọgwụ okike gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "na ihe mgbaasị gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "Ihe ndị ahụ niile i jirila na-eche onwe gị siterị na mgbe ị bụ nwantakịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "Ma eleghị anya ha pụrụ inyere gị aka nʼoge dị nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "Ị pụrụ iji ha menye ndị iro gị ụjọ, maọbụ mee ka ha maa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndụmọdụ niile a na-enye gị adịghị enyere gị aka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "Mee ka ndị ahụ ihe banyere ngagharị ọnwa na kpakpando doro anya bịa nso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "Kpọpụta ndị ahụ na-esite nʼihe ha hụrụ na kpakpando akọwa ihe ga-eme site nʼotu ọnwa ruo nʼọnwa nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "Kpọkuo ha ka ha zọpụta gị site na nsogbu nke na-aga ịbịakwasị gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, ha bụ ihe efu dịka ahịhịa kpọrọ nkụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "Ọkụ ga-erechapụkwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "Ha apụghịkwa ịzọpụta onwe ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "site nʼọkụ ahụ na-enwusi ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "Nʼihi na ọkụ ahụ adịghị ka ọkụ a na-akwanye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "nke a na-anya nʼoge oyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ihe ndị a na-enyocha kpakpando ga-emere gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "bụ ndị ị na-aṅa ntị na ndụmọdụ ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "site na mgbe ị bụ nwantakịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "Ha ga-ahapụ gị gaa nʼụzọ nke aka ha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "ị gaghị enwekwa onye ga-azọpụta gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    }
  ],
