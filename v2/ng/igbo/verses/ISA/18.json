      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amụma e buru banyere Kush",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ ga-adịrị ala ahụ a na-anụ ụzụ ọtụtụ nku nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:1"
      },
      "items": [
        {
          "text": "ala ahụ dị nʼofe iyi ukwu niile nke Kush.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala nke na-ezipụ ndị ozi ya site nʼosimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "bụ ndị na-eji ụgbọ mmiri papịrọs nʼaga nʼelu mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 18:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "Gaanụ ngwangwa, unu ndị ozi dị nkọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "gakwuru ndị toro ogologo nke ahụ ha na-akwọ mụrụmụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "gakwuru ndị a na-atụ egwu nʼebe niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "mba na-achọ okwu na ụka, nke na-azọpịakwa azọpịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "ndị osimiri dị iche iche kewara ala ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu niile bi nʼelu ụwa dum,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "na unu ndị nwere ebe obibi nʼụwa, geenụ m ntị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "Mgbe e buliri ọkọlọtọ elu nʼelu ugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "lee anya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "mgbe a fụrụ opi ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "gee ntị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe ndị a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.18.4",
                "verseOrgIds": [
                  "ISA.18.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "\"Aga m anọ jụụ na-elepụ anya site nʼebe obibi m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "dịka mgbe igirigi na-ada nʼoge okpomọkụ nke owuwe ihe ubi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "na dịka anyanwụ si acha nʼoge okpomọkụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na tupu oge owuwe ihe ubi eruo, mgbe ifuru dapụsịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "mgbe okoko na-aghọ mkpụrụ vaịnị nke ka na-achata achata,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "ọ ga-eji mma oge gbuchapụ ụmụ alaka ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "ọ ga-egbutu ma wezugakwa alaka ndị ahụ na-awasa awasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ahapụ ozu ndị agha ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "ka anụ ufe nke ugwu na ụmụ anụ ọhịa rie ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "Ụmụ nnụnụ ga-eri anụ ha nʼoge okpomọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "ma ụmụ anụ ọhịa ga-eri ha nʼoge oyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ahụ, a ga-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.18.7",
                "verseOrgIds": [
                  "ISA.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile onyinye dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "site na ndị toro ogologo, ndị ahụ na-akwọ mụrụmụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "site na ndị a na-atụ egwu nʼebe niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "bụ mba ndị okwu na ụka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
        {
          "text": "nke na-azọpịakwa azọpịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "ndị osimiri dị iche iche kewara ala ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "A ga-eweta onyinye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
        {
          "text": "a nʼUgwu Zayọn, nʼebe ahụ a na-akpọku aha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.18.7",
                "verseOrgIds": [
                  "ISA.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    }
  ],
