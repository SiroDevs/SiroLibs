  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyinye ndị ọzọ Mmụọ Nsọ na-enye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ịhụnanya bụrụ isi ihe unu na-achọ. Chọsienụ onyinye nke Mmụọ Nsọ ike, nke ka nke onyinye inwe ike ibu amụma.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-asụ asụsụ ọ na-amụghị amụ, bụ Chineke ka ọ na-agwa okwu, ọ bụghị mmadụ. Nʼezie, ọ dịghị onye na-aghọta ihe ọ na-ekwu; nʼihi na okwu ọ na-ekwu bụ ihe omimi site nʼike Mmụọ Nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye ọbụla na-ebu amụma na-ezisa ozi na-enyere ndị mmadụ aka ito eto. Ọ na-agwakwa ha okwu nkasiobi na okwu na-ebuli mmụọ ha elu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, onye ahụ na-ebu amụma na-enyere chọọchị aka, ma onye ahụ na-asụ asụsụ ọzọ, na-enyere naanị onwe ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaara atọ m ụtọ ma a sị na unu niile nwere onyinye ịsụ asụsụ dị iche iche; ma ọ ga-atọ m karịa ma ọ bụrụ na unu niile enwee onyinye ibu amụma. Nke a bụ nʼihi na onye ahụ na-ebu amụma bara uru karịa onye na-asụ asụsụ dị iche iche. Ịsụ asụsụ ya ga-aba uru ma ọ bụrụ na ọ dị onye na-aghọta ihe ọ na-asụ, ka e nwee ike wulie chọọchị.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna m ọ bụrụ na m bịakwutere unu malite ịsụ asụsụ unu na-adịghị aghọta, ole uru m baara unu, ma ọ bụghị ma m na-ekwu okwu banyere ihe ekpughere gosi m, maọbụ ihe niile m maara, maọbụ ihe gaje ime, maọbụ ihe nkuzi?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa otu a ka ọ dị nʼetiti ihe niile na-enweghị ndụ, nke na-ada ụda, dịka ọja, maọbụ ụbọ akwara. Ọ bụrụ na ha enyeghị ụda dị iche site na nke ọzọ, olee ụzọ mmadụ ga-eji mara maọbụ ọja ka a na-afụ, maọbụ ụbọ akwara ka a na-akpọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na opi ike e ji akpọ ndị agha oku adapụtaghị ụda nke ọma, onye ga-ejikere ije agha?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu aka ahụ kwa, ọ bụrụ na ị na-agwa mmadụ okwu nʼasụsụ ọ na-adịghị anụ, olee otu ọ ga-esi ghọta ihe ị na-ekwu? Nʼoge ahụ, ifufe ka unu na-agwa okwu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asụsụ a na-asụ nʼụwa a dị ukwuu, ma ha niile bara uru nye ndị na-anụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m aghọtaghị ihe onye na-asụ otu nʼime asụsụ ndị a na-ekwu, aga m abụ ọbịa nʼebe onye na-asụ asụsụ ahụ nọ, ya onwe ya ga-abụkwa ọbịa nʼebe m nọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ na-agụ unu agụụ inweta onyinye nke Mmụọ Nsọ, chọọnụ onyinye ndị ahụ ga-enyere unu aka iwuli nzukọ elu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-asụ asụsụ nʼolu dị iche iche, ga-ekpe ekpere ka e nye ya onyinye ịkọwa olu dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m ji asụsụ dị iche na-ekpe ekpere, mmụọ m ga-eso m na-ekpe ekpere ahụ, ma uche m agaghị aghọta ekpere m na-ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ dị otu a, olee ihe m ga-eme? Aga m eji mmụọ m kpee ekpere, jirikwa uche kpee ekpere. Aga m ejikwa mmụọ m bụọ abụ, jirikwa uche m bụọ abụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o bụghị otu a, mgbe i ji asụsụ ọzọ nke a na-amaghị na-eto Chineke nʼime mmụọ, olee otu ndị niile nọ nʼụlọ nzukọ ahụ na-aghọtaghị ihe ị na-ekwu ga-esi zaa Amen?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ị na-enye ekele nke ọma, ma ọ naghị ewuli onye ọbụla elu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m ekele Chineke nʼihi na ana m asụ asụsụ dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "text": "karịa unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọbụla a gbakọrọ na nzukọ ife ofufe, ọ na-akara m mma ikwu naanị mkpụrụ okwu ise nke mmadụ niile ga-aghọta na nke ga-abakwara ha uru, karịa na m kwuru puku mkpụrụ okwu iri nʼasụsụ dị iche iche nke onye ọbụla na-apụghị ịghọta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna m, unu abụla ụmụntakịrị nʼechiche unu. Bụrụnụ ụmụntakịrị nʼihe gbasara ime ihe ọjọọ, ma bụrụnụ ndị nwere uche nʼihe gbasara ụdị okwu a.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E dere ya nʼakwụkwọ iwu,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "\"Site na egbugbere ọnụ ndị mba ọzọ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "sitekwa nʼire ndị na-asụ iche iche",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "ka m ga-agwa ndị a okwu,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "ma ọbụladị otu a, ha agaghị ege m ntị,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "ka Onyenwe anyị kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịsụ asụsụ dị iche iche abụghị ihe nlere anya nye ndị kwere ekwe, kama ọ bụ ihe ama nye ndị na-ekweghị ekwe. Ma ibu amụma bụ maka ndị kwere ekwe, ọ bụghị maka ndị na-ekweghị ekwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na nzukọ niile ezukọọ nʼọgbakọ ekpere, mmadụ niile a na-asụ nʼolu dị iche iche nʼotu mgbe, ọ bụrụkwa na ndị na-aghọtaghị, maọbụ ndị na-ekweghị ekwe abata nʼebe ahụ, gịnị ka ha ga-ekwu? Ha ọ gaghị asị na isi emebiela ndị a?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye na-ekweghị ekwe maọbụ onye ọhụrụ abata mgbe onye ọbụla na-ebu amụma, ha ga-abụ ndị mmadụ niile ga-atụ mmehie ha nʼanya maakwa ha ikpe mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a na-eme ka ihe nzuzo nke obi ha niile pụta ìhè, onye dị otu a ga-egbu ikpere nʼala kpọọ isiala nye Chineke sị, \"Nʼezie, Chineke nọ nʼetiti unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usoro Ofufe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ụmụnna m, kedụ otu o kwesiri ịdị? Mgbe ọbụla unu zukọrọ, ụfọdụ kwesiri ịbụ abụ, onye ọzọ ga-ezi unu ihe; maọbụ gwa unu ozi dị mkpa e gosiri ya, maọbụ jiri asụsụ nke ọ na-amụghị gwa unu okwu, ka onye ọzọ kọwaa ihe onye ji asụsụ a dị iche kwuo okwu kwuru. Ma ka ihe ọbụla e mere nʼime ụlọ chọọchị bụrụ ihe ga-ewuli onye ọbụla elu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwa na ọ dị ndị chọrọ iji asụsụ dị iche kwuo okwu, ka mmadụ abụọ maọbụ atọ kwuo. Kama ka ha kwuo nʼotu nʼotu nʼusoro. Ka onye ga-akọwa ihe ha kwuru nọrọkwa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
              "1CO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ dịghị onye ga-akọwa ihe ha na-asụ, ka onye ahụ na-asụ asụsụ dị iche na chọọchị mechie ọnụ ya. Ya na Chineke sụrịta ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.28",
            "verseOrgIds": [
              "1CO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mmadụ abụọ maọbụ atọ nwere onyinye ibu amụma kwuo okwu nʼotu nʼotu, ka ndị ọzọ tulee ihe ha kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na-ekpughere onye ọzọ nọdụ nʼakụkụ ya ihe, ka onye mbụ mechie ọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na unu nwere ike ibu amụma nʼotu nʼotu, ka mmadụ niile nwee ike ịmụta ihe ma bụrụkwa ndị a gbara ume.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ niile nke ndị amụma ka a na-edokwa nʼokpuru ndị amụma.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Chineke abụghị Chineke nke aghara, kama ọ bụ nke udo. Otu a ka ọ dị nʼime ọgbakọ niile nke ndị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ nwanyị ekwesighị ikwu okwu nʼime chọọchị. Ha ekwesighị itinye ọnụ na ntụgha ụka ọbụla, nʼihi na iwu kwuru ka ha debe onwe ha nʼokpuru ndị ọchịchị.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ dị ihe ha chọrọ ịmata, ha jụọ di ha mgbe ha lara nʼụlọ. Nʼihi na ọ bụ ihe ihere na nwanyị ga-ekwu okwu nʼime ọgbakọ chọọchị.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu chere na okwu Chineke malitere nʼaka unu? Unu chekwara na ọ ga-akwụsị nʼaka unu? Ụgha!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ dị onye na-eche na ya bụ onye amụma, maọbụ na ya nwere onyinye nke Mmụọ Nsọ, naanị ihe m na-achọ ka ọ ghọta bụ na ihe m na-edere unu bụ iwu Onyenwe anyị nʼonwe ya nyere m.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ dị onye nọgidere jụ ịnabata ihe ndị a, unu aṅala ya ntị.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụnna m, ka ibu amụma bụrụ ihe na-agụ unu agụụ, unu egbochikwala onyinye nke ịsụ nʼire dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma meenụ ihe niile nʼụzọ dị mma, ka ha dịkwa nʼusoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
      ]
    }
  ],
