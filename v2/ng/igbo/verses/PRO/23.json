          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ka obi ya jupụtara nʼahụhụ? Onye nọ na iru ụjụ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:29"
      },
      "items": [
        {
          "text": "Olee onye nwere esemokwu? Onye nwere ọtụtụ ihe mkpesa?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:29"
      },
      "items": [
        {
          "text": "Onye nwere mmerụ ahụ nke na-abaghị uru? Onye nwere anya nke na-acha ọbara ọbara?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ndị na-anọ ogologo oge na-aṅụ mmanya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.30",
            "verseOrgIds": [
              "PRO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:30"
      },
      "items": [
        {
          "text": "onye na-aga ịchọpụta mmanya agwara agwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.30",
            "verseOrgIds": [
              "PRO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
