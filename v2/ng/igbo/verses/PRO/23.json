      "attrs": {
        "style": "q2",
        "vid": "PRO 23:20"
      },
      "items": [
        {
          "text": "na ndị iri oke oriri na-atọ ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.20",
            "verseOrgIds": [
              "PRO.23.20"
            ]
