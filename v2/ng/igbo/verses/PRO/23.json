      "attrs": {
        "style": "q2",
        "vid": "PRO 23:21"
      },
      "items": [
        {
          "text": "Ọ bụkwa nkịrịnka akwa ka onye oke ụra na-eyi nʼahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
            "verseOrgIds": [
              "PRO.23.21"
            ]
