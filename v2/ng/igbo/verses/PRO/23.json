      "attrs": {
        "style": "q2",
        "vid": "PRO 23:26"
      },
      "items": [
        {
          "text": "ka ụzọ m niile nyekwa anya gị ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.26",
            "verseOrgIds": [
              "PRO.23.26"
            ]
          }
        }
      ]
    },
    {
