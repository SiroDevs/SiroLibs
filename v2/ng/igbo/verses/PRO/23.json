      "attrs": {
        "style": "q2",
        "vid": "PRO 23:23"
      },
      "items": [
        {
          "text": "zụtakwa amamihe, ntụziaka, na nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.23",
            "verseOrgIds": [
              "PRO.23.23"
            ]
          }
