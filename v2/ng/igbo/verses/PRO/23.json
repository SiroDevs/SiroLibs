      "attrs": {
        "style": "q2",
        "vid": "PRO 23:25"
      },
      "items": [
        {
          "text": "Ka onye mụrụ gị ṅụrịa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.25",
            "verseOrgIds": [
              "PRO.23.25"
            ]
          }
