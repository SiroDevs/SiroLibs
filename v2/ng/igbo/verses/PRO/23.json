      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:27"
      },
      "items": [
        {
          "text": "nwanyị nwe di na-akwa iko bụ olulu mmiri dị warawara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.27",
            "verseOrgIds": [
              "PRO.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
