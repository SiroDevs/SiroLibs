      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:28"
      },
      "items": [
        {
          "text": "na-emekwa ka ndị na-ekwesighị ntụkwasị obi baa ụba nʼetiti ụmụ nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.28",
            "verseOrgIds": [
              "PRO.23.28"
            ]
          }
        }
      ]
    },
