          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ihe niile ga-akọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
