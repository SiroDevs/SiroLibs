              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e gbupụchara ahịhịa ochie, nke ọhụrụ na-epupụta,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.25",
            "verseOrgIds": [
