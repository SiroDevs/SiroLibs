              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eche osisi fiig nche ga-eri mkpụrụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.18",
            "verseOrgIds": [
              "PRO.27.18"
            ]
