          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka e si eji igwe amụ igwe ọzọ ka ọ dị nkọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
        }
      ]
