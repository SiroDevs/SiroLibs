      "attrs": {
        "style": "q2",
        "vid": "PRO 27:26"
      },
      "items": [
        {
          "text": "ụmụ ewu ga-enyekwa gị ego ọnụahịa ala ubi gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.26",
            "verseOrgIds": [
