      "attrs": {
        "style": "q2",
        "vid": "PRO 27:19"
      },
      "items": [
        {
          "text": "otu a ka obi mmadụ si egosi ihe onye ahụ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.19",
            "verseOrgIds": [
              "PRO.27.19"
            ]
