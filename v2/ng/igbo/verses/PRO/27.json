              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka afọ adịghị eju ọnwụ na mbibi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.20",
            "verseOrgIds": [
