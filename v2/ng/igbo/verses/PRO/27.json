      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:17"
      },
      "items": [
        {
          "text": "otu a ka mmadụ si enyere ibe ya aka ịdị nkọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
        }
      ]
