              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka e si ahụ ihu mmadụ nʼime mmiri",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.19",
            "verseOrgIds": [
              "PRO.27.19"
