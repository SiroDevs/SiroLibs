  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PRO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyala isi banyere echi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:1"
      },
      "items": [
        {
          "text": "nʼihi na ị maghị ihe echi ga-abụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye ọzọ too gị, ọ bụghị ọnụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "Ka onye ọzọ too gị, ka egbugbere ọnụ gị abụọ ghara ito gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkume dị arọ, aja bụkwa ibu arọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:3"
      },
      "items": [
        {
          "text": "ma mkpasu iwe nke onye nzuzu dị arọ karịa ha abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe na-emebi ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:4"
      },
      "items": [
        {
          "text": "ma ekworo jọrọ njọ karịa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba abara nʼihe ka mma",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:5"
      },
      "items": [
        {
          "text": "karịa ịhụnanya ezoro ezo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe kwesiri ntụkwasị obi ka mmerụ ahụ nke sitere nʼaka enyi bụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:6"
      },
      "items": [
        {
          "text": "ma onye iro na-eme ka isutu ọnụ mụbaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmanụ aṅụ adịghị atọ onye rijuru afọ ụtọ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:7"
      },
      "items": [
        {
          "text": "ma mgbe agụụ ji ya, ọ ga-eri ọ bụladị ihe dị ilu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke na-akpafu site nʼụlọ ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:8"
      },
      "items": [
        {
          "text": "dị ka nnụnụ na-amakwaghị akwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmanụ isi ụtọ na ihe nsure ọkụ na-esi isi ụtọ na-eme ka obi ṅụrịa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "otu a ka ụtọ enyi dị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "site na ndụmọdụ nke mkpụrụobi ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahapụla enyi gị maọbụ ndị enyi nna gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "Mgbe ị nọ na mkpa arịọla nwanne gị ka o nyere gị aka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "Onye agbataobi nọ gị nso nwere ike inyere gị aka karịa nwanne gị nọ ebe dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa m, obi ga-atọ m ụtọ nke ukwuu ma a sị na ị ga-amụta ihe!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "Mgbe ahụ, aga m enwe ihe m ga-asa ndị na-akọcha m.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nwere uche na-ahụ nsogbu nke na-abịa nʼihu ma zobe onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "Ma onye na-enweghị uche anaghị ele anya, ọ na-adaba nʼime nsogbu ahụ taa ahụhụ so ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chịrị uwe onye ahụ nke naara onye mba ọzọ na mbe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "E, chiri ya ma ọ bụrụ nwanyị na-abụghị nwunye ya ka o nara na mbe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye ọbụla e jiri oke olu gọzie onye agbataobi ya nʼisi ụtụtụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:14"
      },
      "items": [
        {
          "text": "a ga-agụ nke a dịka ịbụ ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmiri na-ata nʼime ụlọ mgbe mmiri na-ezo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:15"
      },
      "items": [
        {
          "text": "na nwanyị na-eso okwu bụ otu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nwere ike ịkwụsị ya nwere ike iji aka jide ifufe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:16"
      },
      "items": [
        {
          "text": "maọbụ were aka jide mmanụ.",
          "type": "text",
          "attrs": {
