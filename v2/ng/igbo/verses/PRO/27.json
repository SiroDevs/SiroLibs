      "attrs": {
        "style": "q2",
        "vid": "PRO 27:18"
      },
      "items": [
        {
          "text": "onye na-echebekwa nna ya ukwu ka a ga-asọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.18",
            "verseOrgIds": [
              "PRO.27.18"
            ]
