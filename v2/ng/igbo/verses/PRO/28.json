          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ na-atụkwasị onwe ya obi bụ onye nzuzu!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.26",
            "verseOrgIds": [
              "PRO.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:26"
      },
      "items": [
        {
          "text": "Ma ndị na-agbaso amamihe Chineke, aka adịghị akpa ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.26",
            "verseOrgIds": [
              "PRO.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i nye ogbenye, a ga-egboro gị mkpa gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.27",
            "verseOrgIds": [
              "PRO.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:27"
      },
      "items": [
        {
          "text": "Ma ọbụbụ ọnụ dịrị ndị ahụ na-ekpuchi anya ha nʼebe ndị ogbenye nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.27",
            "verseOrgIds": [
              "PRO.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ajọ omume na-aga nʼihu, ndị ezi omume na-ezo onwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.28",
            "verseOrgIds": [
              "PRO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:28"
      },
      "items": [
        {
          "text": "ma mgbe ha nʼala nʼiyi, ndị ezi omume nʼaba ụba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.28",
            "verseOrgIds": [
              "PRO.28.28"
            ]
          }
        }
      ]
