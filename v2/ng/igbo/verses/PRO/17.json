      "attrs": {
        "style": "q2",
        "vid": "PRO 17:17"
      },
      "items": [
        {
          "text": "Otu a kwa, nwanne na-aba uru nʼoge mkpa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
              "PRO.17.17"
            ]
          }
        }
      ]
