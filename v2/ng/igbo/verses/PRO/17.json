  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "PRO 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ka mma ịta iberibe achịcha kpọrọ nkụ ma ịnọ nʼudo adị ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:1"
      },
      "items": [
        {
          "text": "karịa nʼụlọ jupụtara nʼoke oriri na ịlụ ọgụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohu nwere uche ga-achị nwa nna ya ukwu na-eweta ihere",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:2"
      },
      "items": [
        {
          "text": "ma ketakwa oke nʼihe nketa dịka otu nʼime ndị ezinaụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ite eji anụcha ihe dịrị ọlaọcha, oke ọkụ dịkwara ọlaedo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:3"
      },
      "items": [
        {
          "text": "ma",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.3",
                "verseOrgIds": [
                  "PRO.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na-anwale obi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajọ mmadụ na-aṅa ntị nʼegbugbere ọnụ na-eduhie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:4"
      },
      "items": [
        {
          "text": "onye ụgha na-aṅakwa ntị nye ire na-ekwu okwu ịla nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-akwa ogbenye emo ọ bụ Chineke kere ha ka ọ na-elelị anya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:5"
      },
      "items": [
        {
          "text": "Ndị niile na-aṅụrị ọṅụ nʼihi ihe ike dakwasịrị ha aghaghị ịta ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ụmụ bụ okpueze ndị okenye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:6"
      },
      "items": [
        {
          "text": "Nne na nna bụ ịnya isi nke ụmụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egbugbere ọnụ na-ekwu okwu dị mma abụghị nke onye nzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:7"
      },
      "items": [
        {
          "text": "otu a kwa, egbugbere ọnụ na-agha ụgha ekwesighị ịbụ nke onye na-achị achị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼanya onye na-enye ngarị ọ na-ahụta ya dịka ọgwụ ịrata mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:8"
      },
      "items": [
        {
          "text": "ha na-eche nʼebe ọbụla ha chere ihu ihe ga-aga nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-akwado ịhụnanya na-ekpuchi njehie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:9"
      },
      "items": [
        {
          "text": "ma onye na-ekwu ihe mere mgbe na mgbe na-ekewa ezi enyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịba mba ntakịrị a baara onye nwere nghọta bara uru",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:10"
      },
      "items": [
        {
          "text": "karịa narị ụtarị nke a pịara onye nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọjọọ na-ebi naanị ndụ nnupu isi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        },
        {
          "text": "megide Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:11"
      },
      "items": [
        {
          "text": "Ọ bụkwa onyeozi nke ọnwụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        },
        {
          "text": "ka a ga-eziga imegide ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ka mma izute nne Bịa a napụrụ ụmụ ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:12"
      },
      "items": [
        {
          "text": "karịa izute onye nzuzu uche ya gbagọrọ agbagọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i jiri ihe ọjọọ kwụọ ụgwọ ihe ọma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:13"
      },
      "items": [
        {
          "text": "ọbụbụ ọnụ dịrị ezinaụlọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esemokwu malite ọ na-esi ike imedo ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:14"
      },
      "items": [
        {
          "text": "nʼihi ya ekwela ka ọ malite.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-asị onye ikpe maara na ikpe amaghị ya na-amakwa onye aka ya dị ọcha ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.15",
                "verseOrgIds": [
                  "PRO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "na-akpọ omume abụọ a asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
