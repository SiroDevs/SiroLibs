              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru gịnị ka ego bara nʼaka onye nzuzu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
