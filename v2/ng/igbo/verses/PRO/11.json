  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "PRO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọtụtụ aghụghọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        },
        {
          "text": "bụ arụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.1",
                "verseOrgIds": [
                  "PRO.11.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:1"
      },
      "items": [
        {
          "text": "ma ihe ọtụtụ zuru ezu na-anata ihuọma nʼebe ọ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga bịa, nlelị a na-eso ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:2"
      },
      "items": [
        {
          "text": "ma onye dị umeala nʼobi na-amụta ihe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eziokwu nke ndị ziri ezi nʼobi na-edu ha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:3"
      },
      "items": [
        {
          "text": "ma omume gbagọrọ agbagọ nke ndị aghụghọ nʼala ha nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụnụba gị agaghị azọpụta gị nʼụbọchị ikpe;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.4",
            "verseOrgIds": [
              "PRO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:4"
      },
      "items": [
        {
          "text": "ọ bụ naanị ezi omume na-anapụta site nʼọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.4",
            "verseOrgIds": [
              "PRO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi omume nke ndị na-enweghị ịta ụta na-eme ka ụzọ ha zie ezi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.5",
            "verseOrgIds": [
              "PRO.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:5"
      },
      "items": [
        {
          "text": "ma ajọ omume nke ndị na-emebi iwu na-akwada ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.5",
            "verseOrgIds": [
              "PRO.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi omume nke onye ziri ezi na-azọpụta ya;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:6"
      },
      "items": [
        {
          "text": "ma ọchịchọ ọjọọ nke ndị na-aghọ aghụghọ ka a ga-eji jide ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye ajọ omume nwụrụ, olileanya ya niile alala nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:7"
      },
      "items": [
        {
          "text": "ihe niile ọ na-ele anya inweta site nʼike ya alaakwala nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke na-azọpụta ndị ezi omume site na nsogbu ha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.8",
            "verseOrgIds": [
              "PRO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:8"
      },
      "items": [
        {
          "text": "ma ndị ajọ omume ka ọ na-ahapụ ka ha daba nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.8",
            "verseOrgIds": [
              "PRO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu ọjọọ ka onye ajọ omume ji emebi onye agbataobi ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.9",
            "verseOrgIds": [
              "PRO.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:9"
      },
      "items": [
        {
          "text": "Ma site nʼihe ọmụma ka onye ezi omume ga-eji dọpụta ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.9",
            "verseOrgIds": [
              "PRO.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọganihu nke onye ezi omume na-atọ mmadụ niile ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.10",
            "verseOrgIds": [
              "PRO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:10"
      },
      "items": [
        {
          "text": "otu aka ahụ kwa, ọnwụ onye ajọ omume na-atọ mmadụ niile ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.10",
            "verseOrgIds": [
              "PRO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-esite na ngọzị nke ndị ziri ezi bulie obodo elu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.11",
            "verseOrgIds": [
              "PRO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:11"
      },
      "items": [
        {
          "text": "ma a nʼala ya nʼiyi site nʼokwu ọnụ ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.11",
            "verseOrgIds": [
              "PRO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwu okwu nleda megide onye agbataobi gị bụ nzuzu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:12"
      },
      "items": [
        {
          "text": "ma onye ahụ nwere nghọta na-agba nkịtị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-agba asịrị na-ekpughe ihe nzuzo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.13",
            "verseOrgIds": [
              "PRO.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:13"
      },
      "items": [
        {
          "text": "ma onye kwesiri ntụkwasị obi na-ekpuchi ihe nzuzo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.13",
            "verseOrgIds": [
              "PRO.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi enweghị ezi ndị ndu ka obodo ji ada,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.14",
            "verseOrgIds": [
              "PRO.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:14"
      },
      "items": [
        {
          "text": "ma ọtụtụ ndị ezi ndụmọdụ na-eweta mmeri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.14",
            "verseOrgIds": [
              "PRO.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-ana onye ọbịa nʼakaebe ga-ata ahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
            "verseOrgIds": [
              "PRO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:15"
      },
      "items": [
        {
          "text": "ma onye jụrụ ịkwụ ụgwọ onye ọzọ ji, nọ na ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
            "verseOrgIds": [
              "PRO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsọpụrụ na-adịrị nwanyị nwere obiọma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
              "PRO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:16"
      },
      "items": [
        {
          "text": "ma ndị na-adịghị eme ebere bụ naanị akụnụba ka ha na-enweta.",
          "type": "text",
          "attrs": {
