  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "PRO 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye a na-abara mba mgbe niile ma ọ naghị anata ndụmọdụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:1"
      },
      "items": [
        {
          "text": "nʼotu ntabi anya ka a ga-etipịa ya, ọ gaghị ekulikwa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ezi omume nọ nʼọchịchị, ndị a na-achị na-aṅụrị ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:2"
      },
      "items": [
        {
          "text": "ma ha na-asụ ude mgbe onye ajọ omume na-achị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke hụrụ amamihe nʼanya na-eme ka nna ṅụrịa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:3"
      },
      "items": [
        {
          "text": "ma onye bụ enyi ụmụ nwanyị akwụna, na-ala akụnụba ya nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze na-achị nʼeziokwu na-ewetara obodo ya ọganihu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:4"
      },
      "items": [
        {
          "text": "ma nke na-achọ ngarị na-ala ya nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ ji ire ụtọ na-aja onye agbataobi ya mma",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:5"
      },
      "items": [
        {
          "text": "bụ ọnya ka ọ na-esiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ onye ajọ omume siri ọnya ka ọnya ahụ na-ama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:6"
      },
      "items": [
        {
          "text": "Ma ndị ezi omume na-anọrọ onwe ha na-agụ egwu ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ezi omume na-etinye anya nʼihe banyere ikpe ziri ezi nke ndị ogbenye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:7"
      },
      "items": [
        {
          "text": "ma ụdị echiche ahụ adịghị abata ndị ajọ omume nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nzuzu na-amalite ọgụ ebe niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:8"
      },
      "items": [
        {
          "text": "ma ndị nwere uche na-agbalịsị ike ime ka udo dị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye maara ihe esoro onye nzuzu gaa nʼụlọikpe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:9"
      },
      "items": [
        {
          "text": "onye nzuzu ga-ewe iwe ọkụ, mee mkpọtụ, kwaa emo ma udo agaghị adị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ndụ ha na-ebi bụ ime ihe ike na-akpọ onye eziokwu asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:10"
      },
      "items": [
        {
          "text": "ha na-achọsikwa ike ụzọ ha ga-esi gbuo onye ndụ ya ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nzuzu na-egosi oke iwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:11"
      },
      "items": [
        {
          "text": "ma onye nwere uche na-ejide onwe ya na-emekwa ka mmụọ ya dajụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye na-achị achị aṅaa ntị nʼokwu ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:12"
      },
      "items": [
        {
          "text": "ndị niile na-ejere ya ozi ga-aghọ ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogbenye na ọgaranya bụ otu na nke a:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:13"
      },
      "items": [
        {
          "text": "ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.29.13",
                "verseOrgIds": [
                  "PRO.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "na-eme ka ha jiri anya ha na-ahụ ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na eze esite nʼizi ezi kpee ndị ogbenye ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:14"
      },
      "items": [
        {
          "text": "a ga-eme ka ocheeze ya guzosie ike ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịba mba na iti nwantakịrị ihe na-enye aka mee ka ọ bụrụ ezi nwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:15"
      },
      "items": [
        {
          "text": "ma nwantakịrị a na-adịghị adụ ọdụ na-eme nne ya ihe ihere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị na-emebi iwu na-aga nʼihu, njehie na-aba ụba nʼetiti ndị a na-achị achị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:16"
      },
      "items": [
        {
