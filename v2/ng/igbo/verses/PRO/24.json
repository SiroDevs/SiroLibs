          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṅụrịla ọṅụ mgbe onye iro gị dabara na nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
