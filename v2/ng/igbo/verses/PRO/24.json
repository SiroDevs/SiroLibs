                "verseId": "PRO.24.18",
                "verseOrgIds": [
                  "PRO.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "pụrụ iwe iwe nʼihi ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
