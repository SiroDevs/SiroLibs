      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:17"
      },
      "items": [
        {
          "text": "Ka obi gharakwa ịtọ gị ụtọ mgbe ọ dara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
          }
        }
      ]
