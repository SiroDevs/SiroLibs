          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye na-emebi iwu enweghị ọdịnihu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
