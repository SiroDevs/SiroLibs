          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ ga-adịrị ndị ahụ na-abara onye ikpe mara mba na mma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        }
      ]
