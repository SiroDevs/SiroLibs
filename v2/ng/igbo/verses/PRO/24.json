      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:21"
      },
      "items": [
        {
          "text": "esonyerela ndị ozi na-enupu isi megide nna ha ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        }
      ]
    },
    {
