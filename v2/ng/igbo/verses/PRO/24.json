      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:19"
      },
      "items": [
        {
          "text": "maọbụ nwe anya ukwu nʼebe onye ajọ omume nọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        }
      ]
    },
    {
