        "style": "q2",
        "vid": "PRO 24:29"
      },
      "items": [
        {
          "text": "Aga m akwụghachi ha ụgwọ ihe ha mere.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.29",
            "verseOrgIds": [
              "PRO.24.29"
            ]
          }
