      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:24"
      },
      "items": [
        {
          "text": "ga-anata ọbụbụ ọnụ site nʼọnụ ọtụtụ mmadụ, mba niile ga-eweso ya iwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
