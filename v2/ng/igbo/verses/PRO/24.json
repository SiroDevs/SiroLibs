      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:20"
      },
      "items": [
        {
          "text": "a ga-afụnyụkwa ọkụ onye ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri atọ",
          "type": "text"
        }
      ]
    },
    {
