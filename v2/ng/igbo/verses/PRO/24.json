          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ na mberede ka ị ga-eso ha daba na nhụju anya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
