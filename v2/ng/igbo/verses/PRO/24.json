  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "PRO 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwosola ndị ajọ omume ekworo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:1"
      },
      "items": [
        {
          "text": "ka ihe banyere ha ghara ịtọ gị ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na-atụmatụ obi ha niile bụ otu ha ga-esi mee ihe ike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:2"
      },
      "items": [
        {
          "text": "egbugbere ọnụ ha na-ekwu naanị maka ọgbaaghara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na otu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ amamihe ka e ji ewu ụlọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:3"
      },
      "items": [
        {
          "text": "ọ bụkwa nghọta ka e ji eme ka o guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitekwa nʼihe ọmụma ka akụ niile ji ejupụta nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:4"
      },
      "items": [
        {
          "text": "bụ akụ ndị pụrụ iche ma dịkwa oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye maara ihe na-emeri site nʼịdị ike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:5"
      },
      "items": [
        {
          "text": "ndị nwere ọmụma ihe na-akpali ike ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejela ọgụ ma ọ bụghị na i nwetara ezi ndụmọdụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:6"
      },
      "items": [
        {
          "text": "nʼihi na nzọpụta dị nʼige ọtụtụ ndị ndụmọdụ ntị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na atọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe dị elu nke ukwuu nye ndị nzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:7"
      },
      "items": [
        {
          "text": "ha gaghị asaghe ọnụ ha nʼọgbakọ ọnụ ụzọ ama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na anọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eche echiche ime ihe ọjọọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:8"
      },
      "items": [
        {
          "text": "ka a ga-agụ dịka onye nzube ihe ọjọọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzube niile nke onye na-enweghị uche bụ mmehie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:9"
      },
      "items": [
        {
          "text": "ndị mmadụ na-akpọ onye na-akwa emo asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na ise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị pụghị iguzosi ike nʼoge nsogbu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:10"
      },
      "items": [
        {
          "text": "ị bụ nnọọ onye ike ya dị ntakịrị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napụta ndị a na-eduba nʼọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:11"
      },
      "items": [
        {
          "text": "Napụtakwa ndị ahụ a mara ikpe ọnwụ nʼụzọ na-ezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị sị, \"Anyị amaghị banyere ihe ndị a,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "ọ bụ na onye na-enyocha obi aghọtaghị ya?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Ọ bụ na onye na-eche ndụ gị amaghị ya?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Ọ bụ na ọ gaghị akwụghachi onye ọbụla ụgwọ dịka akaọrụ ya siri dị?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na isii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa m nwoke, rachaa mmanụ aṅụ nʼihi na ọ dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "Mmanụ aṅụ nke si nʼugbugbo mmanụ aṅụ na-adị gị ụtọ nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marakwa na otu a ka amamihe kwesiri isi tọọ obi gị ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "Ọ bụrụ na i chọta ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "i nwere olileanya nke ga-adịgide.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na asaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adịla ka onye na-emebi iwu, onye echiche ya niile bụ imegide ụlọ onye ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:15"
      },
      "items": [
        {
          "text": "A gakwala ga kwakọrọ ihe dị nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye ezi omume nwere ike daa ugboro asaa ma o ga-ebilikwa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:16"
      },
      "items": [
        {
          "text": "Ma ndị na-emebi iwu na-asọ ngọngọ mgbe nsogbu bịakwasịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Okwu nke iri abụọ na asatọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
