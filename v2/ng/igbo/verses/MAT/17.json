  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "MAT 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nnwogha Jisọs nwoghara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị isii gasịrị, Jisọs kpọọrọ Pita, na Jemis na Jọn nwanne ya, rigoro nʼugwu dị elu ebe naanị ha nọdụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ a gbanwere ọdịdị ya nʼihu ha, ihu ya na-enwupụ dị ka anyanwụ, uwe ya chapụkwara dị ka ìhè.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.2",
            "verseOrgIds": [
              "MAT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu ntabi anya ahụ, ha hụrụ Mosis na Ịlaịja ka ha na ya na-ekwurịta okwu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.3",
            "verseOrgIds": [
              "MAT.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Pita sịrị Jisọs, \"Onyenwe anyị. Ọ dị mma ka anyị niile nọdụ nʼebe a. Ọ bụrụ na ị ga-enye m ike, aga m ewu ụlọ ikwu atọ nʼebe a. Otu nʼime ụlọ ndị a ga-abụ nke gị, otu nke Mosis, nke ọzọ nke Ịlaịja.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.4",
            "verseOrgIds": [
              "MAT.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ka kpụ okwu nʼọnụ, igwe ojii nke na-enwu enwu kpuchiri ha, olu sitere nʼigwe ojii ahụ daa sị, \"Onye a bụ Ọkpara m, onye m hụrụ nʼanya, onye ihe ya dị m ezi mma. Geenụ ya ntị.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.5",
            "verseOrgIds": [
              "MAT.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị na-eso ụzọ ya nụrụ olu a, ha dara nʼala nʼihi egwu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.6",
            "verseOrgIds": [
              "MAT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jisọs jekwuuru ha metụ ha aka sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.7",
            "verseOrgIds": [
              "MAT.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bilienụ, unu atụla egwu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.7",
                "verseOrgIds": [
                  "MAT.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.7",
            "verseOrgIds": [
              "MAT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha lelitere anya ha, o nwekwaghị onye ọzọ ha hụrụ ma ọ bụghị naanị Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.8",
            "verseOrgIds": [
              "MAT.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha si nʼelu ugwu ahụ na-arịdata, Jisọs nyere ha iwu, sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.9",
            "verseOrgIds": [
              "MAT.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu agwala onye ọbụla ihe unu hụrụ tutu ruo mgbe Nwa nke Mmadụ ga-esi nʼọnwụ bilie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.9",
                "verseOrgIds": [
                  "MAT.17.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-eso ụzọ ya jụrụ ya sị, \"Gịnị mere ndị ozizi iwu ji na-ekwu na Ịlaịja aghaghị ibu ụzọ bịa?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.10",
            "verseOrgIds": [
              "MAT.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zara sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.11",
            "verseOrgIds": [
              "MAT.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụ ezie, Ịlaịja na-abịa, ọ ga-emekwa ka ihe niile dị ka ọ dị na mbụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.11",
                "verseOrgIds": [
                  "MAT.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.11",
            "verseOrgIds": [
              "MAT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma Ịlaịja abịalarị, ma ndị mmadụ amataghị ya. Kama ndị mmadụ emeela ya ihe ọjọọ dị iche iche. Otu a kwa ka mụ onwe m bụ Nwa nke Mmadụ ga-esi ahụ ahụhụ site nʼaka ha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.12",
                "verseOrgIds": [
                  "MAT.17.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.12",
            "verseOrgIds": [
              "MAT.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ndị na-eso ụzọ ya ghọtara na ọ bụ Jọn omee baptizim ka ọ na-ekwu banyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.13",
            "verseOrgIds": [
              "MAT.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ gwọrọ nwa akwụkwụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bịarutere nʼebe igwe mmadụ ahụ nọ, otu nwoke bịakwutere ya gbuo ikpere nʼihu ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.14",
            "verseOrgIds": [
              "MAT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "rịọọ ya sị, \"Onyenwe m, biko, meere nwa m nwoke ebere, nʼihi na akwụkwụ na-adọ ya. Ọ na-ata oke ahụhụ, ọtụtụ mgbe ọ na-adaba nʼime ọkụ maọbụ nʼime mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.15",
            "verseOrgIds": [
              "MAT.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ekuteere m ya ndị na-eso ụzọ gị ka ha gwọọ ya, ma ha enweghị ike ime ka ahụ dị ya mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.16",
            "verseOrgIds": [
              "MAT.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs zara sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.17",
            "verseOrgIds": [
              "MAT.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu ọgbọ a na-enweghị okwukwe, ndị na-adịghị erubekwa isi. Ruo ole mgbe ka mụ na unu ga-anọ? Ruo ole mgbe ka m ga-anọ na-anagide ekweghị ekwe unu? Kpọtaranụ m nwata ahụ nʼebe a.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.17",
                "verseOrgIds": [
                  "MAT.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.17",
            "verseOrgIds": [
              "MAT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs baara mmụọ ọjọọ ahụ mba, mee ka o si nʼime nwata ahụ pụta. Otu mgbe ahụ, mmụọ ọjọọ ahụ pụtara, nwata ahụ bụ onye agwọkwara nʼotu oge ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.18",
            "verseOrgIds": [
              "MAT.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e mesịrị, ndị na-eso ụzọ Jisọs bịakwutere ya na nzuzo jụọ ya sị, \"Gịnị mere o ji siere anyị ike ịchụpụ mmụọ ọjọọ ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.19",
            "verseOrgIds": [
              "MAT.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.20",
            "verseOrgIds": [
              "MAT.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụ nʼihi na okwukwe unu nwere esighị ike. Nʼezie, agwa m unu, ọ bụrụ na unu e nwee okwukwe nke dị nta ka mkpụrụ mọstaadị, unu nwere ike ị sị ugwu a, 'Site nʼebe a wezuga onwe gị,' ọ ga-apụtakwa. Ọ dịghị ihe unu na-agaghị enwe ike ime.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.20",
                "verseOrgIds": [
                  "MAT.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.20",
            "verseOrgIds": [
              "MAT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mmụọ ọjọọ dị otu a agaghị apụ, ma ọ bụghị naanị site nʼikpe ekpere na ibu ọnụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.21",
                "verseOrgIds": [
                  "MAT.17.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs ekwuo okwu ọnwụ ya ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha gbakọrọ na Galili, Jisọs gwara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A ga-arara Nwa nke Mmadụ nye nʼaka ndị mmadụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.22",
                "verseOrgIds": [
                  "MAT.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ha ga-egbukwa ya, ma nʼụbọchị nke atọ a ga-eme ka o si nʼọnwụ bilie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.23",
                "verseOrgIds": [
                  "MAT.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Nke a wutere ha nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịtụ ụtụ ụlọnsọ ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bịaruru na Kapanọm, ndị na-ana ụtụ nʼihi ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        },
        {
          "text": "bịakwutere Pita jụọ ya sị, \"Onye ozizi unu ọ dịghị atụ ụtụ ụlọnsọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.24",
            "verseOrgIds": [
              "MAT.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita zara ha sị, \"E, ọ na-atụ ụtụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 17:25"
      },
      "items": [
        {
          "text": "Mgbe ọ batara nʼụlọ, Jisọs buru ụzọ jụọ ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ka i chere banyere nke a Saimọn? Ọ bụ nʼaka ndị ole ka ndị eze ụwa si anakọta ụtụ taks? Ọ bụ nʼaka ụmụ ha, ka ọ bụ nʼaka ndị ọbịa?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.25",
                "verseOrgIds": [
                  "MAT.17.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Pita zara ya sị, \"Ọ bụ site nʼaka ndị ọbịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 17:26"
      },
      "items": [
        {
          "text": "Jisọs sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dị mma. Iwu ejighị ndị bụ ụmụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.26",
                "verseOrgIds": [
                  "MAT.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma otu ọ dị, achọghị m ka anyị mee ka iwe wee ha. Gaa nʼosimiri ahụ tụnye nko azụ gị nʼime ya. Meghe ọnụ azụ mbụ ị ga-egbute. Ị ga-ahụ otu mkpụrụ ego nʼime ọnụ ya. Were ya nye ha, ka ọ bụrụ ụtụ nke mụ na gị.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.17.27",
                "verseOrgIds": [
                  "MAT.17.27"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
