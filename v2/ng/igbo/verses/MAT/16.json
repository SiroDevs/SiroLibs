{
  "id": "MAT.16",
  "number": "16",
  "bookId": "MAT",
  "reference": "Matiu 16",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "MAT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ ka e gosi ihe ịrịbama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Farisii na ndị Sadusii bịakwutere Jisọs ịnwa ya ọnwụnwa. Ha gwara ya sị, \"Gosi anyị ihe ịrịbama si nʼeluigwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zara ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe o ruru anyasị unu na-asị, 'Ihu eluigwe ga-adị mma nʼihi na ọ na-acha uhie uhie.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.2",
                "verseOrgIds": [
                  "MAT.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼụtụtụ unu na-asị, 'Anyị ga-enwe mmiri ozuzo taa nʼihi na ihu eluigwe na-acha uhie uhie ma na-eji oji.' Lee na unu pụrụ ịkọwa ihu eluigwe, ma unu apụghị isite nʼihe ịrịbama ndị a unu na-ahụ anya kọwaa ihe oge a anyị nọ nʼime ya pụtara.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.3",
                "verseOrgIds": [
                  "MAT.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ajọ ọgbọ nke jupụtara nʼịkwa iko, nke na-arịọkwa ihe ịrịbama. Ọ nweghị ihe ịrịbama ọzọ a ga-egosi ya karịa ihe ịrịbama Jona.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.4",
                "verseOrgIds": [
                  "MAT.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mgbe ahụ ọ sitere nʼebe ahụ ha nọ pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe na-eko achịcha ndị Farisii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha gafesịrị nʼofe ọzọ, ndị na-eso ụzọ ya chetara na ha ejighị achịcha ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ kwa, Jisọs dụrụ ha ọdụ sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lezienụ anya, ma na-ezekwa ihe ndị na-eko achịcha ndị Farisii na ndị Sadusii.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.6",
                "verseOrgIds": [
                  "MAT.16.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha malitere na-ekwurịta nʼetiti onwe ha, na-asị, ọ bụ nʼihi na anyị ewetaghị ogbe achịcha ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na Jisọs matara ihe ha na-eche, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu ndị okwukwe nta! Gịnị mere unu ji na-esogbu onwe unu nʼihi na unu enweghị achịcha?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.8",
                "verseOrgIds": [
                  "MAT.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee mgbe unu ga-amata ihe? Ọ bụ na unu echetaghị puku mmadụ ise ahụ m jiri ogbe achịcha ise mee ka ha rijuo afọ? Ọ bụ nkata ole ka unu tụtụjuru?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.9",
                "verseOrgIds": [
                  "MAT.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu echetakwaghị na m ji ogbe achịcha asaa zụọ puku mmadụ anọ? Iberibe achịcha juru nkata ole ka unu tụtụkọtara?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.10",
                "verseOrgIds": [
                  "MAT.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gịnị mere unu aghọtaghị na ọ bụghị ihe banyere achịcha ka m na-ekwu? Cheenụ onwe unu nche nʼebe ihe na-eko achịcha ndị Farisii na ndị Sadusii nọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.11",
                "verseOrgIds": [
                  "MAT.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ka ha ghọtara na ihe ọ na-akọwara ha abụghị ihe banyere ihe na-eko achịcha nke a na-ata ata, kama ọ bụ ihe banyere ozizi ndị Farisii na ndị Sadusii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbụgba ama Pita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs bịaruru obodo a na-akpọ Sizaria Filipai, ọ jụrụ ndị na-eso ụzọ ya ajụjụ sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ka ndị mmadụ na-asị na Nwa nke Mmadụ bụ?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.13",
                "verseOrgIds": [
                  "MAT.16.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara ya sị, \"Ụfọdụ na-asị na ị bụ Jọn omee baptizim, ụfọdụ na-asị na ị bụ Ịlaịja, ndị ọzọ na-asịkwa na ị bụ Jeremaya, maọbụ otu nʼime ndị amụma.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ jụrụ ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma unu onwe unu, ọ bụ onye ka unu na-asị na m bụ?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.15",
                "verseOrgIds": [
                  "MAT.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn Pita zara sị ya, \"Ị bụ Kraịst",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        },
        {
          "text": "ahụ, Ọkpara Chineke dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs gwara ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Saimọn Pita nwa Jona, ị bụ onye a gọziri agọzi, nʼihi na anụ ahụ na ọbara ekpugheghị ya nye gị. Kama, ọ bụ Nna m bi nʼeluigwe mere ka ị mata ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.17",
                "verseOrgIds": [
                  "MAT.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mụ onwe m na-agwa gị, na gị onwe gị bụ Pita.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.18",
                "verseOrgIds": [
                  "MAT.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụkwa nʼelu nkume a ka m ga-ewu ụlọ chọọchị m. Ike niile nke ọkụ ala mmụọ apụghịkwa iguzo megide ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.18",
                "verseOrgIds": [
                  "MAT.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aga m enye gị mkpisi igodo alaeze eluigwe. Ihe ọbụla ị ga-eke agbụ nʼelu ụwa, ka a ga-ekekwa agbụ nʼeluigwe. Ihe ọbụla ị ga-atọpụ nʼagbụ nʼụwa, a ga-atọpụkwa ya nʼeluigwe.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.19",
                "verseOrgIds": [
                  "MAT.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, o nyere ndị na-eso ụzọ ya iwu ka ha ghara ime ka onye ọbụla mata na ya bụ Kraịst ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs ekwuo okwu ọnwụ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼoge ahụ Jisọs malitere ịkọwara ndị na-eso ụzọ ya, na ya aghaghị ịga Jerusalem, ebe ọ ga-ahụ ọtụtụ ahụhụ dị iche iche site nʼaka ndị okenye, na ndịisi nchụaja, na ndị ozizi iwu. O mere ka ha mata na aghaghị igbu ya, ma nʼụbọchị nke atọ, a ga-eme ka o site nʼọnwụ bilie.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita duuru ya pụọ nʼotu akụkụ, nọdụ nʼebe ahụ baara ya mba sị ya, \"Onyenwe m, Chineke ekwela. Ihe ndị a agaghị adakwasị gị!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o chigharịrị sị Pita,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Si nʼebe m nọ pụọ, ekwensu! Ị bụ ihe mgbochi nye m. Nʼihi na ihe ị na-eche echiche ya bụ naanị echiche mmadụ, ọ bụghị uche Chineke.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.23",
                "verseOrgIds": [
                  "MAT.16.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Jisọs gwara ndị na-eso ụzọ ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na onye ọbụla achọọ ịbụ onye na-eso ụzọ m, ya buru ụzọ jụ onwe ya, buru obe ya, soro m nʼazụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.24",
                "verseOrgIds": [
                  "MAT.16.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na onye ọbụla na-eche ndụ ya nche ka ọ hapụ ifunarị ya ga-atụfu ya. Ma onye ọbụla tufuru ndụ ya nʼihi m, ga-achọtakwa ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.25",
                "verseOrgIds": [
                  "MAT.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na uru gịnị ka mmadụ nwetara ma ọ bụrụ na o ritechaa ụwa niile nʼuru ma tufuo ndụ ya? Maọbụ gịnị bụ ihe ahụ dị nʼụwa nke mmadụ ga-eji gbanwee ndụ ya?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.26",
                "verseOrgIds": [
                  "MAT.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na Nwa nke Mmadụ ga-abịa nʼebube nke Nna ya, ya na ndị mmụọ ozi ya. Mgbe ahụ ka ọ ga-ekpe onye ọbụla ikpe dị ka ọrụ ya si dị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.27",
                "verseOrgIds": [
                  "MAT.16.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼezie asị m unu, ụfọdụ nʼime ndị guzo nʼebe, agaghị edetụ ọnwụ ire, tụpụ ha ahụ Nwa nke Mmadụ ka ọ na-abịa nʼalaeze ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.28",
                "verseOrgIds": [
                  "MAT.16.28"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
