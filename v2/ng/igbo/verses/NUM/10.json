  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "NUM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Opi ọlaọcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.1",
                "verseOrgIds": [
                  "NUM.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kpụọ opi ọlaọcha abụọ, jiri ha na-akpọ mkpọkọta nzukọ ụmụ Izrel na ime ka ha mara mgbe mbuli ije nke ọmụma ụlọ ikwu ruru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a fụrụ opi abụọ ahụ, nzukọ Izrel niile ga-ezukọta nʼihu gị nʼọnụ ụzọ ụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ naanị otu opi ka a fụrụ, ọ bụ ndị ndu, ndịisi ikwu Izrel niile ga-ezukọta bịakwute gị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụda opi ike ga-egosi na ebo Izrel niile mara ụlọ ikwu ha nʼakụkụ ọwụwa anyanwụ ga-ebuli ije.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi ike ahụ daa ụda nke ugboro abụọ, ọ na-egosi na ndị mara ụlọ ikwu ha na ndịda ga-ebuli ije. Ịda ụda nke opi ike bụ ihe e ji amata na oge ibuli ije eruola.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a ga-akpọkọta ndị Izrel niile a ga-egbu opi, kama ụda ya ga-adị iche.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ naanị ụmụ ndị ikom Erọn, ndị nchụaja ga-egbu opi ndị a. Nke a bụ iwu ga-adịgide nye unu site nʼọgbọ ruo nʼọgbọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu gara ibu agha nʼala unu imegide onye iro na-akpagbu unu, fụọnụ opi ike. Nke a ga-eme ka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.9",
                "verseOrgIds": [
                  "NUM.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu cheta unu, ma napụta unu site nʼaka ndị iro unu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-egbukwa opi ndị a nʼoge aṅụrị, nʼoge mmemme unu a kara aka, na nʼoge mmemme ọnwa ọhụrụ niile. Gbukwaanụ opi mgbe unu na-achụ aja nsure ọkụ unu, na aja udo unu niile. Ka ọ bụrụ ihe a ga-eji na-echeta unu nʼihu Chineke unu. Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.10",
                "verseOrgIds": [
                  "NUM.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị Izrel ahapụ Saịnaị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị iri abụọ, nʼime ọnwa nke abụọ, nʼafọ nke abụọ, igwe ojii ahụ biliri site nʼelu ụlọ nzute nke igbe iwu ọgbụgba ndụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ụmụ Izrel biliri ije site nʼọzara Saịnaị jegharịa site nʼotu ebe ruo nʼebe ọzọ tutu igwe ojii ahụ akwụsị nʼọzara Paran.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ njem mbụ ha mere dịka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.13",
                "verseOrgIds": [
                  "NUM.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "si nye Mosis iwu banyere ije ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuu ọmụma ụlọ ikwu nke ebo Juda buru ụzọ bulie ije a, nʼokpuru ọkọlọtọ ha. Nashọn, nwa Aminadab, bụ onyendu ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netanel nwa Zua bụ onyendu usuu ebo Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliab nwa Helọn bụ onyendu usuu ebo Zebụlọn",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, e wedara ụlọ nzute ahụ. Ụmụ Geshọn na Merari buru ya, bilikwaa ije ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuu ọmụma ụlọ ikwu ebo Ruben biliri ije, nʼokpuru ọkọlọtọ ha. Elizọ nwa Shedeua bụ onyendu ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.18",
            "verseOrgIds": [
              "NUM.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelumiel nwa Zurishadai bụ onyendu usuu ebo Simiọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.19",
            "verseOrgIds": [
              "NUM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliasaf nwa Deuel bụ onyendu usuu ebo Gad.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ụmụ Kohat ndị bu ihe nsọ ndị ahụ niile, biliri ije ha. Tutu ha erute, e guzobere ụlọ nzute ahụ nʼebe o kwesiri ịdị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuu ọmụma ụlọ ikwu ebo Ifrem biliri ije nʼokpuru ọkọlọtọ ha. Elishama nwa Amihud bụ onyendu ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamaliel nwa Pedazo bụ onyendu usuu ebo Manase.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abidan nwa Gidiọni bụ onyendu usuu ebo Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngwụsị usoro ahụ, usuu ọmụma ụlọ ikwu ebo Dan biliri ije nʼokpuru ọkọlọtọ ha. Onyendu ha bụ Ahieza nwa Amishadai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pagịel nwa Okran bụ onyendu usuu ebo Asha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahira nwa Enan bụ onyendu usuu ebo Naftalị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ usoro usuu ụmụ Izrel si bilie ije ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis gwara Hobab nwa Reuel,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        },
        {
          "text": "nna nwunye ya onye Midia okwu sị, \"Anyị ebiliela ije ịga ebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.29",
                "verseOrgIds": [
                  "NUM.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara anyị sị, 'Aga m enye unu.' Bịa ka ị soro anyị. Anyị ga-emezi gị nke ọma nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.29",
                "verseOrgIds": [
                  "NUM.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwela Izrel nkwa ọtụtụ ezi ihe.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        }
      ]
    },
    {
