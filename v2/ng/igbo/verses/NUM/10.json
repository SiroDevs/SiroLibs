                "verseOrgIds": [
                  "NUM.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "bilie ije. Jeekwa ije abalị atọ. Igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
