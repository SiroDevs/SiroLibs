                "verseOrgIds": [
                  "NUM.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "na-aga ha nʼihu ụbọchị atọ ndị ahụ niile ịchọtara ha ebe ha ga-akwụsị zuo ike.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
