            }
          ]
        },
        {
          "text": "dị nʼelu ha nʼehihie mgbe ha si nʼọmụma ụlọ ikwu ha bilie ije.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
