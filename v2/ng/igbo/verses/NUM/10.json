              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ zara sị, \"E e, agaghị m eso unu. Ana m alaghachi nʼala nke aka m ịlaghachikwuru ụmụnna m.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
            "verseOrgIds": [
              "NUM.10.30"
            ]
          }
        }
      ]
    },
    {
