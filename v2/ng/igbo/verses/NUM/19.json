          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmiri ido ihe ọcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.1",
                "verseOrgIds": [
                  "NUM.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.1",
            "verseOrgIds": [
              "NUM.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndị a bụ ụkpụrụ dị nʼiwu ahụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.2",
                "verseOrgIds": [
                  "NUM.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere. Gwa ụmụ Izrel ka ha wetara gị nwa nne ehi na-acha uhie uhie nke na-enweghị ntụpọ, na nke ụdọ yoku na-agabeghị nʼolu ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ya Elieza onye nchụaja, ka ọ kpụrụ ya pụọ nʼazụ ogige, ebe otu onye ga-egbu ya mgbe ọ nọ na-ele ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elieza bụ onye nchụaja ga-arụrụ ụfọdụ nʼime ọbara ya na mkpịsịaka ya, fesa ya na ncherita ihu ụlọ nzute ahụ ugboro asaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye ọzọ ga-akpọ nwa nne ehi ahụ ọkụ mgbe Elieza nọkwa na-ele ya anya. Ọ ga-akpọ akpụkpọ ya, anụ ya, ọbara na mgbịrị afọ ya ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ewere osisi sida, na osisi hisọp, na ogho uhie, tụba ha nʼetiti ebe ahụ a kpọrọ nwa nne ehi ahụ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, onye nchụaja ahụ ga-asacha uwe niile o yi; sakwaa ahụ ya. Ọ ga-alọghachikwa azụ nʼime ogige ahụ ebe ọ ga-anọ dịka onye na-adịghị ọcha ruo nʼuhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ kpọrọ nwa ehi ahụ ọkụ aghaghị ịsa uwe ya niile, sakwaa ahụ ya. Ọ ga-anọkwa ọnọdụ onye na-adịghị ọcha ruo anyasị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, onye nke dị ọcha, ga-ekpokọta ntụ ozu nwa nne ehi ahụ, wụnye ya nʼebe dị ọcha nʼazụ ogige ahụ. Ebe ahụ ka nzukọ Izrel ga-edebe ya maka ikporo wụnye na mmiri e ji asachapụ adịghị ọcha. Ọ bụ maka nsacha pụọ na mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye ahụ ga-ekpokọta ntụ nsure ọkụ nwa nne ehi ahụ aghaghị ịsa uwe ya niile, sakwaa ahụ ya, nọkwaa dịka onye na-adịghị ọcha ruo nʼuhuruchi. Iwu a ga-adịgidere ndị Izrel na ndị ọbịa binyere ha site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ọbụla metụrụ ozu mmadụ aka ga-abụ onye na-adịghị ọcha ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha aghaghị iji mmiri e ji asachapụ adịghị ọcha saa ahụ ha nʼụbọchị nke atọ na nʼụbọchị nke asaa. Mgbe ahụ, ha ga-adị ọcha. Ma ọ bụrụ na ha asaghị ahụ ha nʼụbọchị nke atọ nakwa nʼụbọchị nke asaa, ha ga-anọgide bụrụ ndị na-adịghị ọcha ọ bụladị mgbe ụbọchị asaa ahụ gafesịrị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla metụrụ ozu mmadụ aka ma ọ saghị ahụ ya dịka usoro a si dị, o merụọla ebe nsọ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.13",
                "verseOrgIds": [
                  "NUM.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": ". A ga-ewezuga onye dị otu a site nʼetiti ndị Izrel. Ebe ọ bụ na a wụsaghị ya mmiri nsacha ahụ; ọ ga-anọgide bụrụ onye na-adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe mmadụ nwụrụ nʼụlọ ikwu, ndị a ga-abụ iwu unu ga-eso. Ndị nọ nʼime ụlọ ikwu ahụ mgbe ọ nwụrụ na onye ọbụla banyere nʼụlọ ikwu ahụ, ga-abụ ndị na-adịghị ọcha ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọbụla nke ghere oghe, nke na-enweghị ihe mkpuchi eriri e ji kechie elu ya, ga-abụ ihe na-adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye gara nʼọhịa metụ onye e gburu nʼagha aka, maọbụ onye nwụrụ nʼụzọ ọzọ dị iche, ma ọ bụkwanụ metụ ọkpụkpụ, maọbụ ili onye nwụrụ anwụ aka, ọ ga-abụ onye na-adịghị ọcha ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma banyere onye ahụ na-adịghị ọcha, kporo ntụ site nʼime aja mmehie ahụ a kpọrọ ọkụ, tinye ya nʼime ite, wụkwasị ya mmiri e si nʼiyi na-eru eru kute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nwoke nke nọ nʼọnọdụ ịdị ọcha ga-ewere ụfọdụ hisọp, denye ya na mmiri ahụ fesaa ya nʼime ụlọ ikwu ahụ, na ngwongwo niile e ji dozie ụlọ ahụ, na ndị mmadụ nọ nʼebe ahụ. Ọ ga-efesakwa ya nʼahụ onye ọbụla metụrụ ọkpụkpụ, maọbụ onye e gburu egbu, maọbụ onye nwụrụ anwụ ma ọ bụkwanụ ili aka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.18",
            "verseOrgIds": [
              "NUM.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ dị ọcha ga-efesakwa ndị ahụ rụrụ arụ nʼụbọchị nke atọ na nʼụbọchị nke asaa. Nʼụbọchị nke asaa ka ọ ga-eme ka ha dị ọcha. Ndị ahụ a na-edo ọcha ga-asa uwe ha mmiri, saa ahụ ha, nʼuhuruchi ụbọchị ahụ ka ha ga-adị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.19",
            "verseOrgIds": [
              "NUM.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ndị ahụ merụrụ onwe ha e doghị onwe ha ọcha, aghaghị iwepụ ha site nʼetiti ọgbakọ Izrel. Nʼihi na ha merụrụ ebe nsọ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.20",
                "verseOrgIds": [
                  "NUM.19.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". E fesakwaghị ha mmiri nke ịdị ọcha nʼahụ, nke mere na ha adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ụkpụrụ ga-adịgide mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 19:21"
      },
      "items": [
        {
          "text": "\"Nwoke ahụ na-efesa mmiri ahụ e ji edo mmadụ ọcha, aghaghị ịsacha uwe ya niile. Onye ọbụla metụrụ mmiri nke ịdị ọcha ahụ aka, ga-abụ onye na-adịghị ọcha ruo nʼuhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọbụla kwa onye na-adịghị ọcha metụrụ aka, ga-aghọ ihe na-adịghị ọcha, onye ọbụla metụkwara ya aka ga-abụ onye na-adịghị ọcha ruo nʼuhuruchi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.22",
            "verseOrgIds": [
              "NUM.19.22"
            ]
          }
        }
      ]
    }
  ],
