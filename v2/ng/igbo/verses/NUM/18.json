  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "NUM 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ ndị nchụaja na ndị Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.1",
                "verseOrgIds": [
                  "NUM.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Erọn sị, \"Gị, na ụmụ gị ndị ikom gị, na ezinaụlọ nna gị ga-ebu ahụhụ ajọ omume metụtara ebe nsọ ahụ. Gị na ụmụ gị ndị ikom naanị ka ọ dị nʼaka ịsa ajụjụ ihe ọjọọ ọbụla banyere ọrụ nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.1",
            "verseOrgIds": [
              "NUM.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebo unu kpọbata ụmụnna gị ndị Livayị ka ha sonyere gị ma nyere gị aka mgbe gị na ụmụ gị ndị ikom na-eje ozi nʼụlọ nzute Ihe Ama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.2",
            "verseOrgIds": [
              "NUM.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-anọ gị nʼokpuru ije ozi niile nʼụlọ nzute, ma ha agaghị abịaru nso ngwongwo e ji chọọ ebe nsọ ahụ mma, maọbụ nʼebe ịchụ aja. Ma ọ bụghị otu a, gị na ha ga-anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.3",
            "verseOrgIds": [
              "NUM.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ka ọ dịrị, isonye gị nʼilekọta ụlọ ikwu ahụ, ya bụ, ihe niile metụtara ụlọ ikwu anya. O nweghị onye ọzọ nke ga-abịa nso ebe ị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.4",
            "verseOrgIds": [
              "NUM.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gị ka ọ dịrị ilekọta ihe niile metụtara ebe nsọ ahụ, na ebe ịchụ aja ahụ, ka oke iwe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.5",
            "verseOrgIds": [
              "NUM.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.5",
                "verseOrgIds": [
                  "NUM.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ghara ịdakwasị onye ọbụla nʼala Izrel ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.5",
            "verseOrgIds": [
              "NUM.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ahọpụtala ụmụnna gị ndị Livayị site nʼetiti ndị Izrel, were ha nye gị dịka onyinye, ka ha bụrụ ndị e doro nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.6",
            "verseOrgIds": [
              "NUM.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.6",
                "verseOrgIds": [
                  "NUM.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "maka ịrụ ọrụ ụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.6",
            "verseOrgIds": [
              "NUM.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ naanị gị, na ụmụ gị ndị ikom, ga-aga ozi dịka ndị nchụaja, ozi metụtara ebe ịchụ aja, na ihe niile dị nʼazụ akwa mgbochi ahụ. Ana m enye gị ọrụ nchụaja dịka onyinye. Onye ọbụla ọzọ bịara nso ebe nsọ ahụ ga-anwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.7",
            "verseOrgIds": [
              "NUM.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ndị nchụaja na ndị Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.8",
            "verseOrgIds": [
              "NUM.18.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.8",
                "verseOrgIds": [
                  "NUM.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Erọn okwu sị ya, \"Mụ onwe m emeela gị onye nlekọta onyinye niile a na-eche nʼihu m, onyinye niile dị nsọ nke ụmụ Izrel wetara m ka m na-enye gị na ụmụ gị ndị ikom dịka oke ruuru unu site nʼụkpụrụ ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.8",
            "verseOrgIds": [
              "NUM.18.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.8",
            "verseOrgIds": [
              "NUM.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-enwere akụkụ aja ahụ kachasị nsọ nke a na-edopụ iche site nʼọkụ. Site nʼonyinye niile nke a na-ewetara m, bụ onyinye mkpụrụ ọka maọbụ aja mmehie maọbụ aja ikpe ọmụma, ndị ahụ a na-edopụ iche dịka ihe kachasị nsọ, ha ga-abụ oke gị na ụmụ gị ndị ikom.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.9",
            "verseOrgIds": [
              "NUM.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-eri ha dịka ihe dịkarịrị nsọ. Nwa nwoke ọbụla ga-eri ya. Unu ga-agụ ha dịka ihe dị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.10",
            "verseOrgIds": [
              "NUM.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụkwa nke gị: Ihe ọbụla nke ewezugara site nʼonyinye nke aja mfufe niile nke ndị Izrel wetara. Mụ onwe m na-ewere nke a nye gị na ụmụ gị ndị ikom, na ụmụ gị ndị inyom dịka oke unu nʼụkpụrụ ebighị ebi. Onye ọbụla nke dooro onwe ya ọcha nʼezinaụlọ nwere ike iri ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.11",
            "verseOrgIds": [
              "NUM.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ana m enye gị mmanụ oliv nke kachasị mma, na mmanya ọhụrụ nke kachasị mma na ọka, bụ mkpụrụ mbụ nke owuwe ihe ubi ha na-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.12",
            "verseOrgIds": [
              "NUM.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.12",
                "verseOrgIds": [
                  "NUM.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.12",
            "verseOrgIds": [
              "NUM.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụ mbụ nke ihe niile dị nʼala nke ha na-ewebatara",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.13",
            "verseOrgIds": [
              "NUM.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.13",
                "verseOrgIds": [
                  "NUM.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ga-abụ nke gị. Onye ọbụla nke dị ọcha nʼezinaụlọ unu nwere ike iso rie ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.13",
            "verseOrgIds": [
              "NUM.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe niile e doro nsọ nʼala Izrel niile nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.14",
                "verseOrgIds": [
                  "NUM.18.14"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ nke gị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile e bụ ụzọ mụọ, ma mmadụ ma anụ ụlọ, nke e nyere",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.15",
            "verseOrgIds": [
              "NUM.18.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.15",
                "verseOrgIds": [
                  "NUM.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka onyinye, bụ nke gị. Ma unu aghaghị ịgbara ụmụ ndị ikom niile e bụ ụzọ mụọ, na ụmụ oke anụ ụlọ niile e bụ ụzọ mụọ ndị na-adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.15",
            "verseOrgIds": [
              "NUM.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha dị otu ọnwa, a ga-eji shekel ọlaọcha ise, nʼusoro shekel ebe nsọ, nke bụ iri ihe ọtụtụ gera abụọ gbapụta ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.16",
            "verseOrgIds": [
              "NUM.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma a gaghị agbara nwa ehi mbụ, maọbụ nwa atụrụ mbụ maọbụ nwa ewu mbụ. Ha dị nsọ. Fesa ọbara ha nʼelu ebe ịchụ aja ahụ, ma kpọọ abụba ha ọkụ dịka onyinye e nyere site nʼọkụ, nke na-esi isi ụtọ nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.17",
            "verseOrgIds": [
              "NUM.18.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.17",
                "verseOrgIds": [
                  "NUM.18.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.17",
            "verseOrgIds": [
              "NUM.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozu anụ ndị a niile e gburu ga-abụ nke gị, dịka obi anụ na apata ụkwụ aka nri anụ nke aja mfufe a na-eche nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.18",
                "verseOrgIds": [
                  "NUM.18.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼebe ịchụ aja si bụrụ nke gị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọbụla e dopụrụ iche site nʼonyinye nsọ niile ụmụ Izrel chere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.19",
                "verseOrgIds": [
                  "NUM.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ka m na-enye gị na ụmụ gị ndị ikom, na ụmụ gị ndị inyom dịka oke ruuru unu nʼụkpụrụ ebighị ebi. Ọ bụ ọgbụgba ndụ nnu ebighị ebi nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.19",
                "verseOrgIds": [
                  "NUM.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "nye gị na ụmụ ụmụ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.20",
                "verseOrgIds": [
                  "NUM.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Erọn okwu sị ya, \"Unu agaghị enwe ihe nketa nke ala, a gaghị ekenyekwa unu ala ọbụla nʼala Izrel niile. Nʼihi na mụ onwe m bụ oke na ihe nketa unu nwere nʼetiti ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enyela m ndị Livayị, onyinye otu ụzọ nʼụzọ iri ahụ ụmụ Izrel niile na-akwụbatara m. Nke a bụ ihe nketa ha nʼihi ọrụ ha na-arụ nʼụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site ugbu a gaa nʼihu, o nweghị onye Izrel ọbụla kwesiri ịbịa nso ụlọ nzute ahụ, ka ha ghara iwetara onwe ha ikpe ọmụma, mmehie na ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ naanị ụmụ Livayị ga-arụ ọrụ nʼụlọ nzute ahụ. Ha ka ọ dịrị ibu ahụhụ ajọ omume ọbụla banyere ejezighị ozi nke ụlọ nzute. Ụkpụrụ a ga-adị ebighị ebi ruo ọgbọ niile dị nʼihu. Ndị Livayị agaghị enwe ihe nketa nke aka ha nʼetiti ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, enyela m ndị Livayị onyinye otu ụzọ nʼime ụzọ iri ahụ niile ndị Izrel na-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.24",
                "verseOrgIds": [
                  "NUM.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ọ bụrụ ihe nketa ha. Ọ bụ nke a mere m ji kwuo sị, 'Ha agaghị enweta ihe nketa nʼetiti ụmụ Izrel.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.25",
                "verseOrgIds": [
                  "NUM.18.25"
                ]
              }
            }
          ]
        },
        {
          "text": "gwakwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ndị Livayị okwu sị, 'Mgbe unu si nʼaka ụmụ Izrel nata onyinye otu ụzọ nʼime ụzọ iri ahụ m nyere unu dịka ihe nketa, unu aghaghị isite nʼonyinye ahụ nye otu ụzọ nʼime ụzọ iri dịka onyinye nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.26",
                "verseOrgIds": [
                  "NUM.18.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-agụ onyinye unu wetara dịka ọ bụ onyinye ọka unu si nʼebe ịzọcha ọka weta, maọbụ dịka mmanya unu si nʼebe ịzọcha mmanya weta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, unu onwe unu ga-eche onyinye unu nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.28",
                "verseOrgIds": [
                  "NUM.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼonyinye otu ụzọ nʼime ụzọ iri unu si nʼaka ụmụ Izrel nata. Site nʼonyinye ndị a unu natara, unu ga-enye Erọn onye nchụaja onyinye ahụ ruuru",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.28",
                "verseOrgIds": [
                  "NUM.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyinye unu ga-enye dịka nke ruuru",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.29",
                "verseOrgIds": [
                  "NUM.18.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-abụ akụkụ onyinye ndị ahụ kachasị mma, na ndị kachasị ịdị nsọ.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ndị Livayị okwu sị ha, 'Mgbe unu wetara akụkụ onyinye ndị ahụ kachasị mma, a ga-agụnyere unu ya dịka a ga-asị na ọ bụ onyinye unu si nʼebe ịzọcha ọka, na nʼebe ịzọcha mmanya vaịnị unu weta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na ezinaụlọ unu nwere ike iri ndị fọdụrụ nʼụlọ unu, maọbụ nʼebe ọbụla masịrị unu, nʼihi na ha bụ ụgwọ ọrụ unu nʼihi ozi niile unu jere nʼụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikpe ọmụma agaghị adịrị unu mgbe unu na-eri ya ma ọ bụrụ na unu chere onyinye ndị ahụ kachasị mma nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.18.32",
                "verseOrgIds": [
                  "NUM.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ma kpachapụnụ anya hụ na unu e merụghị onyinye ndị a dị nsọ ụmụ Izrel webatara. Ọ bụrụ na unu emee nke a, unu ga-anwụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
        }
      ]
    }
  ],
