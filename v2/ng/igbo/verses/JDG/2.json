                ]
              }
            }
          ]
        },
        {
          "text": "dị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.18",
                "verseOrgIds": [
                  "JDG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ụmụ Izrel onye ikpe, ọ na-anọnyere onye ikpe ahụ ogologo ụbọchị niile nke ndụ ya. Ọ na-esitekwa nʼaka onye ikpe a napụta ụmụ Izrel nʼaka ndị iro ha nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.18",
                "verseOrgIds": [
                  "JDG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nwere obi ebere nʼahụ ụmụ Izrel, mgbe ha na-asụ ude, nʼihi mmegbu na mkpagbu niile ndị iro ha na-emegbu ha, ma na-akpagbukwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọbụla onye ikpe a nwụrụ, ụmụ Izrel na-alaghachi azụ biwe ndụ ọjọọ karịa nke nna nna ha ochie. Ha na-agbaso chi ndị ọzọ, na-akpọ isiala nye ha, na ife ha ofufe. Ha jụrụ iwezuga agwa ọjọọ ha ndị a ma ọ bụkwa ụzụ isiike ha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.19",
            "verseOrgIds": [
              "JDG.2.19"
            ]
          }
        }
      ]
