          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eji ha nwalee Izrel, ịchọpụta ma ha ga-elezi anya idebe ụzọ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
