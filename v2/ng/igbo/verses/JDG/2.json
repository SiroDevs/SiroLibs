          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "agaghị m achụpụkwa site nʼihu ha mba ndị ahụ Joshua hapụrụ mgbe ọ nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.21",
            "verseOrgIds": [
