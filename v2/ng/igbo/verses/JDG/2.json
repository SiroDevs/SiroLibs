                  "JDG.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "were iwe dị ọkụ megide Izrel, ma sị, \"Nʼihi na mba a emebiela ọgbụgba ndụ ahụ m nyere nna ha nʼiwu, jụkwa ige m ntị,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.20",
            "verseOrgIds": [
              "JDG.2.20"
            ]
          }
        },
