  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JDG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gidiọn emerie ndị Midia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerub-Baal, onye bụkwa Gidiọn, na ndị agha ya niile biliri nʼisi ụtụtụ, maa ụlọ ikwu ha nʼisi iyi Harod. Ma ndị agha Midia mara ụlọ ikwu nke ha nʼakụkụ ugwu ebe ndị Izrel nọ, nʼime ndagwurugwu nke dị nso nʼugwu nta More.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.1",
            "verseOrgIds": [
              "JDG.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.2",
                "verseOrgIds": [
                  "JDG.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Gidiọn okwu sị ya, \"Lee, ndị ikom gị dị ọtụtụ. Agaghị m enyefe ndị Midia nʼaka ha, ma ọ bụghị otu a, Izrel ga-anya isi megide m, sị, 'Ike aka m azọpụtala m.'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, maa ọkwa nye ndị agha sị ha, 'Onye ọbụla ụjọ na-atụ, ya hapụ ugwu Gilead laghachi azụ.' \" Nʼihi nke a, iri puku ndị agha abụọ na abụọ laghachiri azụ nʼụlọ nke aka ha. Ma ndị agha dị puku iri nʼọnụọgụgụ fọdụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.3",
            "verseOrgIds": [
              "JDG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.4",
            "verseOrgIds": [
              "JDG.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.4",
                "verseOrgIds": [
                  "JDG.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Gidiọn, sị ya, \"Lee, ndị agha gị ka dị ọtụtụ. Duru ha gbada na mmiri ala, m ga-anwale ha ma webilatara gị ọnụọgụgụ ha nʼebe ahụ. Ọ bụrụ na m sị, 'Onye nke a ga-eso gị jee,' ọ ga-eje, ma ọ bụrụ na m sị, 'Onye nke a agaghị eso gị jee,' ọ gaghị eso jee.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.4",
            "verseOrgIds": [
              "JDG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Gidiọn duuru ha bịa na mmiri ala ahụ. Nʼebe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.5",
            "verseOrgIds": [
              "JDG.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.5",
                "verseOrgIds": [
                  "JDG.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ya okwu sị ya, \"Kewapụ ndị ji ire ha rachara mmiri dịka nkịta, site na ndị ahụ gburu ikpere nʼala ịṅụ mmiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.5",
            "verseOrgIds": [
              "JDG.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ naanị narị ndị agha atọ ji ọbụ aka ha kwọlịte mmiri ha ṅụrụ. Ma ndị agha fọdụrụ gburu ikpere ha abụọ nʼala tinye ọnụ ha na mmiri, ṅụọ mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.6",
            "verseOrgIds": [
              "JDG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.7",
                "verseOrgIds": [
                  "JDG.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Gidiọn, \"Ọ bụ narị ndị ikom atọ ndị a raara mmiri ka m ga-eji zọpụta gị, ma rarakwa ndị Midia nye gị nʼaka. Zilaga ndị fọdụrụ ka ha laa nʼụlọ nke aka ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.7",
            "verseOrgIds": [
              "JDG.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidiọn zilagara ndị Izrel ndị a nʼụlọ ikwu ha ma hapụ naanị narị mmadụ atọ ndị napụtara ndị ahụ na-ala ala ngwongwo niile ha ji ebu agha, na opi ike.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.8",
            "verseOrgIds": [
              "JDG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 7:8"
      },
      "items": [
        {
          "text": "Ndị Midia mara ụlọ ikwu ha na ndagwurugwu, nʼebe na-adịghị anya site nʼebe Gidiọn nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.8",
            "verseOrgIds": [
              "JDG.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.9",
                "verseOrgIds": [
                  "JDG.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Gidiọn okwu sị ya, \"Bilie, gaa lụso ọmụma ụlọ ikwu ahụ agha, nʼihi na ana m aga inyefe ha nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ụjọ na-atụ gị ibuso ha agha, duru Pura onyeozi gị gaa nso nʼọmụma ụlọ ikwu ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.10",
            "verseOrgIds": [
              "JDG.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṅaa ntị, nụrụ ihe ha na-ekwu. Emesịa, ị ga-abụ onye a gbara ume ibu agha megide ọmụma ụlọ ikwu ahụ.\" Ya mere, ya na Pura onyeozi ya gara nʼebe dị nso, nʼebe ndị nche ọmụma ụlọ ikwu ahụ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.11",
            "verseOrgIds": [
              "JDG.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lee, usuu ndị agha Midia, na ndị Amalek, na ndị obodo ndị ọzọ ahụ si nʼọwụwa anyanwụ bịa jupụtara na ndagwurugwu ahụ dị ka igurube. Nʼezie, ịnyịnya kamel ha dị ọtụtụ, dịka aja dị nʼakụkụ oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.12",
            "verseOrgIds": [
              "JDG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidiọn rutere mgbe otu onye nọ na-akọrọ enyi ya banyere nrọ ọ rọrọ. Ọ na-asị, \"Arọrọ m nrọ, ebe otu ogbe achịcha dị gburugburu, e ji ọka balị mee dabatara nʼime ụlọ ikwu ndị Midia. O ji ike dị egwu tie ụlọ ikwu a, nke mere na ụlọ ikwu a dajiri, kpuo ihu nʼala.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.13",
            "verseOrgIds": [
              "JDG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ibe ya zara sị, \"Nke a abụghị ihe ọzọ karịa mma agha Gidiọn nwa Joash, onye Izrel na-aga ịbịakwute anyị nʼebe a. Chineke enyefeela ndị Midia na ụlọ ikwu ya niile nʼaka ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Gidiọn nụrụ nrọ ahụ, na nkọwa ya, ọ kpọrọ isiala kelee Chineke. Ọ laghachiri na ọmụma ụlọ ikwu ndị Izrel sị ha, \"Bilienụ ọtọ! Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.15",
                "verseOrgIds": [
                  "JDG.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "enyefeela unu ọmụma ụlọ ikwu ndị Midia nʼaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kewara ndị agha ya ụzọ atọ, nyekwa onye ọbụla nʼime ha opi ike, na ite aja nke iheọkụ dị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.16",
            "verseOrgIds": [
              "JDG.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha, \"Unu na-ele m anya, meekwa ihe m na-eme. Mgbe anyị bịaruru nso na mpụta ebe ụlọ ikwu ahụ dị, meenụ ihe ọbụla unu hụrụ m mere.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.17",
            "verseOrgIds": [
              "JDG.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla mụ na ndị so m nʼazụ fụrụ opi ike anyị, unu niile ga-afụkwa opi ike unu nʼakụkụ ọbụla unu nọ, tie mkpu, sị, 'Anyị dịnyere",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.18",
                "verseOrgIds": [
                  "JDG.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", dịnyekwara Gidiọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ahụ, mgbe etiti abalị ahụ gabigasịrị, Gidiọn na narị ndị agha ya gbeere egbere ruo na mpụta ebe ndị agha Midia mara ụlọ ikwu ha. Nʼoge a, ha ka gbanwere ndị agha na-eche nche.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.19",
            "verseOrgIds": [
              "JDG.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzọ ndị agha Gidiọn atọ ahụ fụrụ opi ike ha, tiwakwaa ite aja ha. Ha ji ọwaọkụ ndị ahụ nʼaka ekpe ha na opi ike ha gaje igbu nʼaka nri ha, ha tiri mkpu sị, \"Mma agha",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.20",
                "verseOrgIds": [
                  "JDG.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", na mma agha Gidiọn!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla nʼime ha guzoro nʼebe o kwesiri ịnọ gburugburu ọmụma ụlọ ikwu ahụ. Ndị Midia niile malitere ịgba ọsọ, na-etikwa mkpu akwa mgbe ha na-agbalaga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha fụrụ narị opi ike atọ ndị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.7.22",
                "verseOrgIds": [
                  "JDG.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka ndị ikom niile nọ nʼakụkụ niile nke ọmụma ụlọ ikwu ahụ tụgharịa were mma agha gburịta onwe ha. Ndị agha ahụ gbapụrụ ọsọ gbara gaa Bet-Shita nʼụzọ Zerera, gbarukwaa nke oke ala Ebel-Mehola, nke dị nso Tabat.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kpọpụtara ndị Izrel si Naftalị, na Asha na Manase niile ka ha pụta chụso ndị Midia ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
            "verseOrgIds": [
              "JDG.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidiọn ziri ozi nʼala ugwu ugwu Ifrem sị ha, \"Pụtanụ gbochie ụzọ niile ndị Midia si agbafe. Cheenụ ọnụ mmiri Jọdan niile nche ruo na Bet-Bara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 7:24"
      },
      "items": [
        {
          "text": "Ya mere, a kpọpụtara ndị ikom niile nọ na Ifrem, bụ ndị gbochiri mmiri Jọdan ruo na Bet-Bara.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jidekwara ọchịagha ndị Midia abụọ, ndị aha ha bụ Oreb na Zeeb. Ha gburu Oreb nʼelu nkume nke na-aza aha ya ruo taa. E gbukwara Zeeb nʼebe a na-azọcha vaịnị. Ebe ahụ na-azakwa aha Zeeb ruo taa. Ha bipụrụ Oreb na Zeeb isi buru ha jekwuru Gidiọn nʼakụkụ osimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.25",
            "verseOrgIds": [
              "JDG.7.25"
            ]
          }
        }
      ]
    }
  ],
