  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "GEN 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef gara gwa Fero sị, \"Nna m na ụmụnne m ejirila igwe ewu na atụrụ ha, igwe ehi ha na ihe niile ha nwere site nʼala Kenan bịa nʼebe a. Ha nọ nʼala Goshen.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ gara ịgwa Fero okwu, o duuru mmadụ ise nʼetiti ụmụnne ya ndị ikom gosi ha Fero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero jụrụ ụmụnne ya ajụjụ sị ha, \"Gịnị bụ ọrụ aka unu?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 47:3"
      },
      "items": [
        {
          "text": "Ha zara sị ya, \"Ndị ohu gị bụ ndị ọzụzụ atụrụ dịka nna nna anyị ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kwukwara sị, \"Anyị bịara ịnọ dịka ọbịa nʼala a nʼihi na ụnwụ a siri oke ike nʼala Kenan. O nweghị nri igwe ewu na atụrụ anyị nwere iri nʼala ahụ. Ya mere, anyị na-arịọ ka i nye ndị ohu gị ike ka ha biri nʼala Goshen.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.4",
            "verseOrgIds": [
              "GEN.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero gwara Josef sị, \"Nna gị na ụmụnne gị abịakwutela gị. Ha biri nʼala Goshen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.5",
            "verseOrgIds": [
              "GEN.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Ijipt dịkwa gị nʼihu. Họrọ ebe ọbụla masịrị gị nke dịkwa ezi mma nye nna gị na ụmụnne gị ka ha biri. Ka ha biri na Goshen. Ọ bụrụkwa na ị maara ndị ikom nʼetiti ha ndị nwere ike, mee ha ndị na-elekọta igwe anụ ụlọ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef kpọtara nna ya Jekọb, mee ka o guzo nʼihu Fero. Jekọb nọ nʼebe ahụ gọzie Fero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.7",
            "verseOrgIds": [
              "GEN.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero jụrụ Jekọb sị, \"Ị gbaala afọ ole ugbu a?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.8",
            "verseOrgIds": [
              "GEN.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb zara Fero sị ya: \"Ebiela m dịka onye ọbịa narị afọ na iri afọ atọ. Ọnụọgụgụ afọ ndị a ehighị nne, ma ha jupụtara nʼahụhụ na nsogbu. Ma a nọrubeghị m ọnụọgụgụ afọ nna m ha gbara mgbe ha biri nʼụwa dịka ọbịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.9",
            "verseOrgIds": [
              "GEN.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb gọziri Fero, site nʼihu ya pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.10",
            "verseOrgIds": [
              "GEN.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Josef mere ka nna ya na ụmụnne ya biri nʼala Ijipt. O nyere ha ala kachasị mma nʼala ahụ na mpaghara Ramesis, dịka Fero nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.11",
            "verseOrgIds": [
              "GEN.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef nyere nna ya na ụmụnne ya na ezinaụlọ nna ya nri dịka ọnụọgụgụ nke ụmụ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.12",
            "verseOrgIds": [
              "GEN.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụnwụ na ụkọ nri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nri adịghị nʼala ahụ niile nʼihi na ụnwụ ahụ dị nnọọ njọ. Ihe siri ike nʼala Ijipt ma nʼala Kenan nʼihi ụnwụ a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.13",
            "verseOrgIds": [
              "GEN.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef chịkọtara ego niile dị nʼala Ijipt, na nʼala Kenan, nke ndị mmadụ ji kwụọ ụgwọ nri ha zụrụ webata ha nʼụlọeze Fero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.14",
            "verseOrgIds": [
              "GEN.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ego niile dị ndị mmadụ nʼaka gwụchara nʼala Ijipt ma nʼala Kenan, ndị Ijipt niile bịakwutere Josef sị ya, \"Nye anyị nri, gịnị mere anyị ga-eji nwụọ nʼihu gị? Ego anyị agwụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.15",
            "verseOrgIds": [
              "GEN.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Josef zara sị ha: \"Jirinụ anụ ụlọ unu kwụọ ụgwọ nri m ga-enye unu, ebe ọ bụ na ego unu agwụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.16",
            "verseOrgIds": [
              "GEN.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha kpụtaara Josef anụ ụlọ ha. Josef nyere ha nri nʼọnọdụ ịnyịnya ha, na atụrụ ha, na ewu ha, na ehi, na ịnyịnya ibu ha. O were nri zụọ ha nʼafọ ahụ nʼọnọdụ anụ ụlọ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.17",
            "verseOrgIds": [
              "GEN.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe afọ ahụ gafesịrị, ha bịakwutekwara ya nʼafọ nke ọzọ sị ya, \"Anyị agaghị ezoro onyenwe anyị na ego anyị agwụla, na igwe anụ ụlọ anyị bụkwa nke gị. O nweghị ihe ọzọ fọdụrụ anyị karịa ahụ anyị na ala anyị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.18",
            "verseOrgIds": [
              "GEN.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere anyị ga-eji nọọ nʼagụụ nʼihu gị? Zụrụ anyị na ala anyị nʼọnọdụ ụgwọ anyị ga-akwụ maka nri ị ga-enye anyị. Ka anyị na ala anyị bụrụ ndị ohu Fero. Nye anyị mkpụrụ ubi ka anyị dịrị ndụ ghara ịnwụ, ka ala a ghara ịbụ ihe tọgbọrọ nʼefu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.19",
            "verseOrgIds": [
              "GEN.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Josef zụtaara Fero ala Ijipt niile. Ndị Ijipt niile nʼotu nʼotu rere ala ha nʼihi oke ụnwụ ahụ dakwasịrị ha. Mgbe ahụ, ala ha niile ghọrọ nke Fero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.20",
            "verseOrgIds": [
              "GEN.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Josef si otu a mee ka ndị Ijipt niile ghọọ ndị ohu Fero, site nʼotu obodo nʼala ahụ ruo na nke ọzọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.21",
            "verseOrgIds": [
              "GEN.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala nke Josef na-azụtaghị nʼoge a bụ naanị ala ndị nchụaja. Nʼihi na ndị nchụaja si nʼaka Fero na-enweta nri ha site nʼoge ruo nʼoge. Ha nwekwara nri na-ezuru ha site na oke ahụ Fero na-enye ha. Ya mere ha ereghị ala ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.22",
            "verseOrgIds": [
              "GEN.47.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Josef gwara ndị mmadụ ahụ niile okwu sị, \"Lee, azụọla unu taa, zụkwaa a ala unu nye Fero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.23",
            "verseOrgIds": [
              "GEN.47.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 47:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge owuwe ihe ubi, otu ụzọ nʼime ụzọ ise nke ihe unu nwetara nʼubi unu bụ nke Fero. Deberenụ onwe unu ụzọ anọ fọdụrụ ka ọ bụrụ ihe unu ga-akụ nʼubi na ihe unu ga-eri na ihe ndị ezinaụlọ unu, na nke ụmụntakịrị unu ga-eri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.24",
            "verseOrgIds": [
              "GEN.47.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 47:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara sị ya, \"Ị zọpụtala ndụ anyị. Ka anyị hụta amara nʼihu nna anyị ukwu. Anyị ga-abụ ndị ohu Fero.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef mere ka nke a bụrụ iwu nʼala Ijipt niile ruo taa, na Fero ga-ewe otu ụzọ nʼime ụzọ ise nke ihe ọbụla si nʼala. Naanị ihe si nʼala ndị nchụaja bụ nke na-esoghị nʼiwu a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izrel biri na Goshen nke dị nʼala Ijipt. Ha kpatara akụ hie nne, mụbaa nʼọmụmụ, ma nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb biri nʼala Ijipt afọ iri na asaa. Ya mere, afọ niile Jekọb gbara bụ narị afọ na iri afọ anọ na asaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 47:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ọnwụ Izrel na-abịaru nso, ọ kpọrọ Josef nwa ya sị ya, \"Ọ bụrụ na m ahụtala amara nʼihu gị, tinye aka gị nʼokpuru apata m, kwee m nkwa na ị ga-egosi m obi ebere na ezi ntụkwasị obi. Elila m nʼala nʼIjipt.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, mgbe m nwụrụ, site nʼala Ijipt bupụ m. Buru ozu m gaa lie ya ebe e liri nna m ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 47:30"
      },
      "items": [
        {
          "text": "Ọ zara, \"Aga m eme dịka i kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 47:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ya, \"Ṅụọrọ m iyi na ị ga-eme ya.\" Josef ṅụọrọ ya iyi. Izrel nʼonwe ya, kpọrọ isiala dịka ọ dabere nʼelu mkpanaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.31",
            "verseOrgIds": [
              "GEN.47.31"
            ]
          }
        }
      ]
    }
