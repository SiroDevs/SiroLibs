  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "GEN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajọ omume dị nʼime Ụwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị mmadụ bidoro mụbaa nʼụwa, mgbe a mụtakwaara ha ọtụtụ ụmụ ndị inyom,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ụmụ ndị ikom Chineke bidoro ilekwasị ụmụ ndị inyom ndị mmadụ anya, hụ na ha mara mma. Ha duuru ndị inyom ọbụla masịrị ha ka ha bụrụ nwunye ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.3",
                "verseOrgIds": [
                  "GEN.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Mmụọ m na mmadụ agaghị anọgide nʼịgba mgba nʼime mmadụ ruo ebighị ebi, nʼihi na mmadụ efu ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "text": "Ọnụọgụgụ ndụ ya ga-abụ narị afọ na iri afọ abụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Nefilim nọ nʼụwa nʼoge ahụ, ma nʼoge sotere ya mgbe ahụ, ụmụ ndị ikom Chineke na-abakwuru ndị inyom ụmụ mmadụ, site na mmekọrịta dị otu a mụọ ụmụ. Ndị a bụ ndị dike mgbe ochie ahụ, ndị a ma ama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.5",
                "verseOrgIds": [
                  "GEN.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "hụrụ otu ịba ụba nke ajọ omume mmadụ si dị ukwuu, hụkwa na echiche uche nke obi ya niile dị naanị nʼime ihe ọjọọ, mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wutere",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.6",
                "verseOrgIds": [
                  "GEN.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nke ukwuu na o kere mmadụ, mkpụrụobi ya jupụtakwara nʼihe mgbu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.7",
                "verseOrgIds": [
                  "GEN.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Aga m esi nʼụwa kpochapụ mmadụ niile m kere eke. E e, mmadụ na anụmanụ niile, na ihe e kere eke na-akpụgharị nʼelu ala, na anụ ufe niile. Nʼihi na o wutere m na m kere ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Noa nwetara ihuọma nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.8",
                "verseOrgIds": [
                  "GEN.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Noa na uju mmiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere usoro ndụ Noa na ezinaụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 6:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 6:9"
      },
      "items": [
        {
          "text": "Noa bụ onye ezi omume. Onye na-enweghị ịta ụta ọbụla nʼetiti ndị bi nʼoge ya. O mere ihe nʼụzọ Chineke chọrọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa mụtara ụmụ ndị ikom atọ aha ha bụ, Shem, Ham, na Jafet.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.10",
            "verseOrgIds": [
              "GEN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼanya Chineke, ụwa bụ ihe rụrụ arụ, jupụtakwa nʼihe ike.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.11",
            "verseOrgIds": [
              "GEN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke hụrụ otu ụwa si jọgbuo onwe ya na njọ, hụkwa na ụmụ mmadụ bụ ndị ihe ọjọọ riri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke sịrị Noa, \"Aga m ebibi ihe niile bụ mmadụ, nʼihi na ụwa jupụtara nʼihe ike nʼihi omume mmadụ. E e, aga m ebibi ụwa na ndị niile nọ nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, jiri osisi gofa wuore onwe gị ụgbọ mmiri. Rụnye ọtụtụ ọnụụlọ nʼime ya. Jiri korota techie elu ya na ime ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka i ga-esi wuo ya: mee ka ogologo ụgbọ mmiri ahụ dịrị narị mita na iri mita anọ, obosara ya dịrị iri mita abụọ na atọ, ịdị elu ya dịrị mita iri na atọ na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meere ụgbọ mmiri ahụ ihe e ji ekpuchi elu ya. Mekwa oghere ga-adị ọkara mita site nʼebe ihe mkpuchi elu ụgbọ mmiri ahụ gbadata. Tinye ọnụ ụzọ nʼakụkụ ụgbọ mmiri ahụ, ma rụọkwa okpukpu nkwasa atọ, nke ala ala, nke etiti na nke elu elu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na aga m eweta uju mmiri nʼụwa, ibibi ihe niile nwere ndụ dị nʼokpuru eluigwe. Ihe niile e kere eke na-eku ume ndụ ga-anwụ. Ihe niile nọ nʼụwa ga-ala nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m eme ka ọgbụgba ndụ m dịrị gị. Ị ga-abanye nʼụgbọ mmiri ahụ, gị na ụmụ gị ndị ikom, na nwunye gị, na ndị nwunye ụmụ gị ndị ikom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ewebata ihe niile e kere eke dị ndụ, abụọ abụọ, oke na nwunye, ichebe ha ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụdị nnụnụ dị iche iche, abụọ abụọ, na ụdị anụmanụ ọbụla dị iche iche, na ụdị anụ na-akpụ akpụ dị iche iche, ga-abịakwute gị ka i debe ha ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ewebata ụdị nri dị iche iche a na-eri eri, chịkọtaa ha ka ọ bụrụ nri nke gị na nke ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa mere ihe niile dịka Chineke nyere ya iwu ime.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.22",
            "verseOrgIds": [
              "GEN.6.22"
            ]
          }
        }
      ]
    }
  ],
