  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "GEN 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụnwa a nwara Ebraham",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, Chineke nwara Ebraham. Ọ sịrị ya, \"Ebraham.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:1"
      },
      "items": [
        {
          "text": "Ebraham zara sị, \"Lekwa m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke sịrị, \"Duru nwa gị nwoke, naanị otu nwa gị nwoke, Aịzik onye ị hụrụ nʼanya, gaa nʼala Mọrịa. Jiri ya chụọrọ m aja nsure ọkụ nʼelu otu nʼime ugwu dị nʼebe m ga-egosi gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ echi ya, Ebraham biliri kwadoo ịnyịnya ibu ya. O duuru ndị ikom abụọ na-ejere ya ozi, na nwa ya nwoke Aịzik. O gbutere nkụ ga-ezuru ya ịchụ aja nsure ọkụ, bilie gawa ebe ahụ Chineke gwara ya maka ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.3",
            "verseOrgIds": [
              "GEN.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke atọ, Ebraham lepụrụ anya hụ ebe ahụ nʼebe dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.4",
            "verseOrgIds": [
              "GEN.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ndị na-ejere ya ozi sị, \"Nọdụnụ nʼebe a, unu na ịnyịnya ibu anyị, ka mụ na nwokorobịa a gaa nʼebe ahụ. Anyị feecha ofufe, anyị ga-alọghachikwute unu ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.5",
            "verseOrgIds": [
              "GEN.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham boro nwa ya nwoke Aịzik ukwu nkụ ahụ e ji achụ aja nsure ọkụ nʼisi, ma ya onwe ya jidere ọkụ na mma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.6",
            "verseOrgIds": [
              "GEN.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aịzik gwara nna ya Ebraham sị, \"Nna m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:7"
      },
      "items": [
        {
          "text": "Ebraham zara, \"Ehee, nwa m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:7"
      },
      "items": [
        {
          "text": "Aịzik sịrị, \"Ọkụ na nkụ dị nʼebe a, olee nwa atụrụ e ji achụ aja nsure ọkụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham zara, \"Nwa m, Chineke nʼonwe ya ga-eweta nwa atụrụ e ji achụ aja nsure ọkụ.\" Ha abụọ gakwara nʼihu nʼije ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha ruru ebe ahụ Chineke gwara ya maka ya, Ebraham wuru ebe ịchụ aja nʼebe ahụ, doo nkụ ndị ahụ niile nʼusoro nʼelu ya. O kere nwa ya Aịzik agbụ, tụkwasị ya nʼelu ebe ịchụ aja ahụ, na nʼelu nkụ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Ebraham setịpụrụ aka ya, welite mma ka o gbuo nwa ya nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.11",
                "verseOrgIds": [
                  "GEN.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "si nʼeluigwe kpọọ ya oku sị ya, \"Ebraham! Ebraham!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:11"
      },
      "items": [
        {
          "text": "Ebraham zara, \"Lekwa m nʼebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ya, \"Emetụkwala nwokorobịa ahụ aka. Emekwala ya ihe ọbụla. Nʼihi na amatala m ugbu a na ị na-atụ egwu Chineke, ebe ọ bụ na i kwenyere iji nwa gị nwoke, naanị otu nwa nwoke i nwere chụọrọ m aja.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham leliri anya hụ otu ebule nke eriri ọhịa jidere na mpi ya. Ebraham gara jide ebule ahụ, were ya chụọ aja nsure ọkụ nʼọnọdụ nwa ya nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Ebraham kpọrọ ebe ahụ, \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.14",
                "verseOrgIds": [
                  "GEN.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-arọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "text": "\" Ya mere ruo taa a na-asị, \"Nʼugwu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.14",
                "verseOrgIds": [
                  "GEN.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", a ga-arọpụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.15",
                "verseOrgIds": [
                  "GEN.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼeluigwe kpọọ Ebraham oku nke ugboro abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "sị, \"Mụ onwe m, bụ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.16",
                "verseOrgIds": [
                  "GEN.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", ji onwe m na-aṅụ iyi na-ekwupụta sị, ebe ọ bụ na i mere ihe dị otu a, na i kwenyere iji nwa gị nwoke, naanị otu nwoke i nwere chụọrọ m aja,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "aga m agọzi gị nʼezie, mekwa ka ụmụ ụmụ gị mụbaa nʼọnụọgụgụ dịka kpakpando nke mbara eluigwe na dịka aja dị nʼọnụ mmiri osimiri. Ụmụ ụmụ gị ga-enwetara onwe ha ọnụ ụzọ ama ndị iro ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.17",
            "verseOrgIds": [
              "GEN.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitekwa na mkpụrụ gị ka a ga-agọzikwa agbụrụ niile nọ nʼụwa, nʼihi na i rubeere m isi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Ebraham laghachikwuru ndị na-ejere ya ozi. Ha niile laghachikwara Bịasheba. Ebraham birikwara na Bịasheba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Nahọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, e ziri Ebraham ozi si ya, \"Lee, Milka ya onwe ya amụkwaarala nwanne gị nwoke bụ Nahọ, ụmụ ndị ikom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha ha bụ Uz, onye bụ ọkpara, na Buz nwanne ya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
