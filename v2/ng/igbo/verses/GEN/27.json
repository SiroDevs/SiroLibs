    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara Ribeka ihe nwa ya nwoke nke okenye bụ Ịsọ kwuru, o ziri kpọọ nwa ya nwoke nke nta bụ Jekọb sị ya, \"Lee, Ịsọ nwanne gị na-akasị onwe ya obi site nʼechiche ọ na-eche igbu gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, nwa m nwoke, mee ihe m gwara gị, gbapụ ọsọ ngwangwa, gbakwuru nwanne m Leban na Haran,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nọdụ nʼebe ahụ ruo mgbe iwe nwanne gị ga-adajụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwanne gị kwụsịrị iwe iwe megide gị, mgbe o chefuru ihe i mere ya, aga m ezitere gị ozi ka ị lọta. Nʼihi gịnị ka m ga-eji gbara aka unu abụọ nʼotu ụbọchị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        }
      ]
    },
