          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Ribeka gara gwa Aịzik sị, \"Ike ịdị ndụ agwụla m nʼihi ndị inyom Het ndị a. Ọ bụrụ na Jekọb esite nʼetiti ndị inyom ala a, site nʼetiti ndị inyom Het ndị a lụọ nwunye, mara na ọnwụ ga-akara m ịdị ndụ mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
