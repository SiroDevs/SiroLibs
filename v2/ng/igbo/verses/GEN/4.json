              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a ga-abọtara Ken ọbọ ugboro asaa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
            "verseOrgIds": [
              "GEN.4.24"
            ]
          }
        }
