      "attrs": {
        "style": "q2",
        "vid": "GEN 4:24"
      },
      "items": [
        {
          "text": "mgbe ahụ, a ga-abọtara Lamek ọbọ iri ugboro asaa na asaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
            "verseOrgIds": [
