      "attrs": {
        "style": "q2",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "otu nwokorobịa nʼihi na ọ mehịara m ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
