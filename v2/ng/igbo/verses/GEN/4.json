  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "GEN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ken na Ebel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Adam na nwunye ya Iiv dinakọrọ dịka di na nwunye. Iiv tụụrụ ime mụọ nwa nwoke, onye ha gụrụ Ken. Iiv sịrị, \"Site nʼinyeaka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.1",
                "verseOrgIds": [
                  "GEN.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", amụtala m nwa nwoke!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa Iiv mụtara nwanne ya nwoke Ebel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 4:2"
      },
      "items": [
        {
          "text": "Ebel ghọrọ onye na-azụ igwe atụrụ. Ma Ken ghọrọ onye ọrụ ubi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụfọdụ oge gasịrị, Ken wetaara",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.3",
                "verseOrgIds": [
                  "GEN.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ụfọdụ ihe ubi ya dịka onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ebel, ya onwe ya nyekwara onyinye site nʼigwe ewu na atụrụ ya e bụ ụzọ mụọ, nke mara abụba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.4",
                "verseOrgIds": [
                  "GEN.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nabatara Ebel na onyinye ya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ọ nabataghị Ken na onyinye ya. Nke a wutere Ken, mee ka o wee iwe dị ukwuu. Ihu ya agbarụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.5",
            "verseOrgIds": [
              "GEN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.6",
            "verseOrgIds": [
              "GEN.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.6",
                "verseOrgIds": [
                  "GEN.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "jụrụ ya sị, \"Gịnị mere i ji ewe iwe? Gịnị mere ihu gị ji gbarụọ?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.6",
            "verseOrgIds": [
              "GEN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i mee ihe ziri ezi, agaghị anabata gị? Ọ bụrụkwanụ na ị jụ ime ihe ziri ezi, mmehie nọ nʼọnụ ụzọ na-eche gị ịla gị nʼiyi. Lezie anya hụ na i meriri ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.7",
            "verseOrgIds": [
              "GEN.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ken gwara nwanne ya Ebel sị, \"Bịa soro m ka anyị banye ọhịa.\" Mgbe ha nọ nʼebe ahụ, Ken jidere nwanne ya gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.8",
            "verseOrgIds": [
              "GEN.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.9",
                "verseOrgIds": [
                  "GEN.4.9"
                ]
              }
            }
          ]
        },
        {
          "text": "jụrụ Ken ajụjụ sị, \"Ebee ka Ebel nwanne gị nwoke nọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 4:9"
      },
      "items": [
        {
          "text": "Ọ zaghachiri, \"Amaghị m. Abụ m onye nche nwanne m?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.10",
            "verseOrgIds": [
              "GEN.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.10",
                "verseOrgIds": [
                  "GEN.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "zara sị ya, \"Gịnị ka i mere? Gee ntị, ọbara nwanne gị na-akpọku m site nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.10",
            "verseOrgIds": [
              "GEN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site ugbu a gaa nʼihu ị bụrụla onye a bụrụ ọnụ, na onye e si nʼala chụpụ, ala ahụ meghepụrụ ọnụ ya nabata ọbara nwanne gị, site nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.11",
            "verseOrgIds": [
              "GEN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị kụrụ ihe ọbụla nʼime ya, ala agaghị enye gị mkpụrụ ya nʼuju. Site ugbu a gaa nʼihu, ị ga-abụ onye na-awagharị awagharị na onye na-abaghị nʼihe nʼụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.12",
            "verseOrgIds": [
              "GEN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ken zara",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.13",
                "verseOrgIds": [
                  "GEN.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Ntaramahụhụ i nyere m dị ukwuu karịa nke m nwere ike ibu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, abụ m onye i si nʼala ubi ya chụpụ. Abụkwa m onye i si nʼihu gị chụpụ. Bido taa aga m abụ onye na-awagharị awagharị nʼime ụwa. Onye ọbụla hụkwara m ga-egbu m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.14",
            "verseOrgIds": [
              "GEN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.15",
                "verseOrgIds": [
                  "GEN.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "zara sị ya, \"O nweghị onye ga-egbu gị, nʼihi na aga m atụkwasịrị onye ọbụla metụrụ gị aka ntaramahụhụ okpukpu asaa karịa nke m nyere gị.\" Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.15",
                "verseOrgIds": [
                  "GEN.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "kara Ken akara iji gbochie onye ọbụla hụrụ ya igbu ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ken sitere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.16",
                "verseOrgIds": [
                  "GEN.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "pụọ gaa biri nʼala Nọd,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        },
        {
          "text": "obodo dị nʼakụkụ ọwụwa anyanwụ Iden.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ken na nwunye ya dinakọrọ, nwunye ya tụụrụ ime mụta nwa nwoke aha ya bụ Enọk. Nʼoge a, Ken nọ na-ewu otu obodo ọ gụrụ Enọk, nke bụ aha nwa ya nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.17",
            "verseOrgIds": [
              "GEN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enọk bụ nna Irad, Irad bụ nna Mehujael, Mehujael bụ nna Metusael, Metusael abụrụ nna Lamek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.18",
            "verseOrgIds": [
              "GEN.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamek lụrụ ụmụ nwanyị abụọ. Aha nwunye ya nke mbụ bụ Ada. Aha nke ọzọ bụ Zila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.19",
            "verseOrgIds": [
              "GEN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada mụtara Jabal, onye bụ nna ndị na-azụ anụ ụlọ, na ndị na-ebi nʼụlọ ikwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.20",
            "verseOrgIds": [
              "GEN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nwanne ya nwoke bụ Jubal, onye mbụ bụ nna ndị na-akpọ ụbọ akwara, na ndị na-afụ opi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.21",
            "verseOrgIds": [
              "GEN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zila, mụtara otu nwa nwoke aha ya bụ Tubal Ken, onye bụ nna ndị niile na-akpụ ihe dị iche iche e ji bronz maọbụ igwe kpụọ. Aha nwanne nwanyị Tubal Ken bụ Naama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamek kpọrọ ndị nwunye ya sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "\"Geenụ m ntị, Ada na Zila,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "unu ndị nwunye Lamek, nụrụ okwu sị m nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "Egbuola m otu nwoke nʼihi na ọ merụrụ m ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
      ]
