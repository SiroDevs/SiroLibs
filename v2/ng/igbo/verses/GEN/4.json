              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam na Iiv dinakọrọ ọzọ, Iiv tụụrụ ime mụta nwa nwoke ọ gụrụ Set. Nʼihi na Iiv kwuru sị, \"Chineke enyela m nwa nwoke ọzọ nʼọnọdụ Ebel onye Ken gburu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Set mụtara nwa nwoke gụọ ya Enọsh.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.26",
            "verseOrgIds": [
              "GEN.4.26"
            ]
          }
        }
      ]
    },
    {
