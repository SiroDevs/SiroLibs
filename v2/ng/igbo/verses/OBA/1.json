  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "OBA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọhụ Ọbadaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "OBA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọhụ nke Ọbadaya hụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.1",
                "verseOrgIds": [
                  "OBA.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu banyere Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "Anyị anụla ozi si nʼọnụ Onyenwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "e zipụla onyeozi ka ọ gaa mba niile dị iche iche zie ha ozi, sị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "\"Bilikwanụ ka anyị gaa buo agha megide ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "OBA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lee, aga m eme ka ị dị nta nʼetiti mba dị iche iche;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:2"
      },
      "items": [
        {
          "text": "ị ga-abụ ihe a na-elelị anya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "OBA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga nke obi gị eduhiela gị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "gị onye bi na mgbawa niile nke nkume dị elu,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "onye ebe obibi ya dị nʼebe dị oke elu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "Gị onye na-ekwu nʼime obi ya,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "'Onye ga-akpụdata m nʼala?'",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "OBA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na i felie elu dịka ugo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "ọ bụrụkwa na ị kpaa akwụ gị nʼetiti kpakpando,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "aga m esite nʼebe ahụ kpụdata gị nʼala.\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.4",
                "verseOrgIds": [
                  "OBA.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "OBA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ndị ohi abịakwute gị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "e, ọ bụrụ na ndị na-apụnara mmadụ ihe abịakwute gị nʼetiti abalị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "lee, ụdị mbibi na-echere ịdakwasị gị!",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "Ọ bụghị naanị ihe ha chọrọ ka ha ga-ezuru?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "Ọ bụrụ na ndị na-aghọ mkpụrụ vaịnị abịakwute gị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "ọ bụ na ha agaghị ahapụrụ gị mkpụrụ ole na ole?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "OBA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lee ka e si nyochapụtachaa ebe niile Ịsọ debere akụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:6"
      },
      "items": [
        {
          "text": "lekwaa ka e si chịkọrọ akụ ya niile bụ nke zoro ezo!",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "OBA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị enyi gị niile aghọgbuola gị, nwee ike imegide gị,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "ndị gị na ha na-adị na mma achụrụla gị ruo nʼoke ala;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "ndị gị na ha na-erikọ nri gị ga-esiri gị ọnya igbudu,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "ma ị gaghị achọpụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "OBA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼụbọchị ahụ,\" otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.8",
                "verseOrgIds": [
                  "OBA.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "\"ọ bụ na mụ agaghị ala ndị oke amamihe niile nọ nʼEdọm nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "bụ ndị nwere mmụọ nghọta nọ nʼugwu Ịsọ?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "OBA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị gị bụ dike nʼagha, o Teman, ka ụjọ ga-eri.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "Onye ọbụlakwa nọ nʼugwu Ịsọ niile,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "ka a ga-egbuda nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "OBA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na i gbuola ma mesokwa nwanne gị bụ Jekọb ihe ike.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
