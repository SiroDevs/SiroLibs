          "attrs": {
            "verseId": "SNG.5.13",
            "verseOrgIds": [
              "SNG.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
