          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi ya dịka ọlaedo a nụchara anụcha,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.11",
            "verseOrgIds": [
              "SNG.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:11"
      },
      "items": [
        {
          "text": "agịrị isi ya na-eruda dịka igu nkwụ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.11",
            "verseOrgIds": [
              "SNG.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:11"
      },
      "items": [
        {
          "text": "na-ejikwa nji dịka ugolọma.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.11",
            "verseOrgIds": [
              "SNG.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
