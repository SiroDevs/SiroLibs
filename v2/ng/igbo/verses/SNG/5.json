      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:14"
      },
      "items": [
        {
          "text": "nke a hịọnyere nkume oke ọnụahịa beril nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.14",
            "verseOrgIds": [
              "SNG.5.14"
            ]
