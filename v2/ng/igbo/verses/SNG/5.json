          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya ya abụọ dịka nduru",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.12",
            "verseOrgIds": [
              "SNG.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:12"
      },
      "items": [
        {
          "text": "nọ nʼakụkụ mmiri iyi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.12",
            "verseOrgIds": [
              "SNG.5.12"
            ]
          }
        }
      ]
    },
