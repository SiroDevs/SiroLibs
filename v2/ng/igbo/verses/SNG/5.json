      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:13"
      },
      "items": [
        {
          "text": "Egbugbere ọnụ ya dị ka okoko urodi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.13",
            "verseOrgIds": [
              "SNG.5.13"
            ]
          }
        }
