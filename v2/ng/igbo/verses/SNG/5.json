      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:14"
      },
      "items": [
        {
          "text": "nke e ji nkume dị oke ọnụahịa safaia chọọ mma.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.14",
            "verseOrgIds": [
              "SNG.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
