      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:12"
      },
      "items": [
        {
          "text": "nke e jiri mmiri ara ehi sachaa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.12",
            "verseOrgIds": [
              "SNG.5.12"
            ]
          }
        }
      ]
    },
    {
