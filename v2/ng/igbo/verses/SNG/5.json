          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nti ya abụọ dị ka ihe ndina ụda",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.13",
            "verseOrgIds": [
              "SNG.5.13"
            ]
          }
        }
      ]
    },
