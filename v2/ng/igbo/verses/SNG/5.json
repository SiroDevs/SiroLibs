          "attrs": {
            "verseId": "SNG.5.12",
            "verseOrgIds": [
              "SNG.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
