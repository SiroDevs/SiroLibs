      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:11"
      },
      "items": [
        {
          "text": "o nyefere ubi vaịnị ya nʼaka ndị ọrụ nlekọta.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.11",
            "verseOrgIds": [
