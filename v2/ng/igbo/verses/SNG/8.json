              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn nwere ubi vaịnị na Baal-Hamon,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.11",
            "verseOrgIds": [
