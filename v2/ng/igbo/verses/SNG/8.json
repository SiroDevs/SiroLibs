{
  "id": "SNG.8",
  "number": "8",
  "bookId": "SNG",
  "reference": "Abụ nke Abụ 8",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "SNG 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, a sịkwarị na ị bụ nwanne m nwoke;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "nke otu nne mụrụ mụ na ya",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "m gaara esutu gị ọnụ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "mgbe anyị zutere nʼokporoụzọ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "ma ọ dịkwaghị onye ọbụla ga-eleda m anya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaara m akpọrọ gị baa nʼụlọ nne m,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "ka ị nọdụ nʼebe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "nʼụlọ onye ziri m ihe.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "Agaara m enye gị mmanya e tinyere ihe na-esi isi ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "mmanya ụtọ nke pomegranet.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ekpe ya dị nʼokpuru isi m,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:3"
      },
      "items": [
        {
          "text": "aka nri ya na-ejikụ m.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ụmụ agbọghọ Jerusalem, ana m agba unu iyi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "unu agaghị akpọte maọbụ mee ka ịhụnanya teta",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "tupu ruo mgbe ọ masịrị ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ndị Enyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye bụ onye a si nʼọzara na-abịa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "onye na-adabere nʼahụ onye ọ hụrụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Onye a hụrụ nʼanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Nʼokpuru osisi apụl ka m kpọtere gị;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "nʼebe ahụ ka nne gị tụrụ ime gị;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "nʼebe ahụ ka ọ nọ mụọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụkwasị m dịka mgbaaka ihe a kara nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "dịka mgbaaka ihe a kara nʼaka gị",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "nʼihi na ịhụnanya dị ike dịka ọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "ekworo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        },
        {
          "text": "ya dịkwa ike dịka ala mmụọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Ọ na-enwupụtakwa dịka ọkụ na-ere ere,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "dịka ọkụ nke dị ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ mmiri apụghị imenyụ ịhụnanya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "osimiri niile enwekwaghị ike iri ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "Ọ bụrụ na mmadụ ga-enye",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "akụ niile nke ụlọ ya nʼihi ịhụnanya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "a ga-eleda ya anya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ndị Enyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nwekwara otu nwanne nwanyị nta",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "ma ọ kpụbeghị ara.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "Gịnị ka anyị ga-emere nwanne anyị nwanyị,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "nʼụbọchị a ga-abịa ịlụ ya?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ bụ mgbidi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "anyị ga-ewukwasị ụlọ elu ọlaọcha nʼelu ya;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "ma ọ bụrụ na ọ bụ ọnụ ụzọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "anyị ga-eji ibo e ji osisi sida wuo mechie ya, ichebe ya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Onye a hụrụ nʼanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m mgbidi,",
