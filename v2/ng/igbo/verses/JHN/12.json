              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs tiri mkpu sị,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.44",
            "verseOrgIds": [
              "JHN.12.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ọbụla kwere na m, ọ bụghị na m ka o kwere, kama ọ bụ na onye nke zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.44",
                "verseOrgIds": [
                  "JHN.12.44"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.44",
            "verseOrgIds": [
              "JHN.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na onye ọbụla hụrụ m ahụla onye nke zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.45",
                "verseOrgIds": [
                  "JHN.12.45"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.45",
            "verseOrgIds": [
              "JHN.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abịara m nʼime ụwa dị ka ìhè ka onye ọbụla nke kwere na m ghara ịnọ nʼọchịchịrị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.46",
                "verseOrgIds": [
                  "JHN.12.46"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
