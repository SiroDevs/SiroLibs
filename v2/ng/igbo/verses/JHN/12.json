              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla jụrụ m ma jụkwa okwu m, nwere onye ga-ekpe ya ikpe. Okwu niile m kwuru ga-ama ya ikpe nʼụbọchị ikpeazụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.48",
                "verseOrgIds": [
                  "JHN.12.48"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.48",
            "verseOrgIds": [
              "JHN.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Okwu ndị a esiteghị nʼaka m. Ha sitere nʼaka Nna ahụ onye zitere m ma nyekwa m iwu ihe m ga-ekwu na otu m ga esi kwuo ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.49",
                "verseOrgIds": [
                  "JHN.12.49"
                ]
              }
            }
