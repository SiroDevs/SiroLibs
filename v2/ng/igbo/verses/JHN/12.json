        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ọ bụrụ na onye ọbụla anụ okwu m ma ju ime ya, ọ bụghị m na-ekpe ya ikpe. Nʼihi na abịara m ịzọpụta ụwa, ọ bụghị ikpe ụwa ikpe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.47",
                "verseOrgIds": [
                  "JHN.12.47"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.47",
            "verseOrgIds": [
              "JHN.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
