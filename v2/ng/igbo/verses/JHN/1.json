              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịkwara ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.51",
            "verseOrgIds": [
              "JHN.1.51"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼezie, nʼezie agwa m unu, unu ga-ahụ eluigwe ka o meghere hụkwa ndị mmụọ ozi Chineke ka ha na-arịgokwuru, ma na-arịdakwuru Nwa nke Mmadụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.51",
