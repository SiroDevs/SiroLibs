  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JHN 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu ghọrọ mmadụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbụ okwu ahụ dịrịị, okwu ahụ na Chineke nọ, okwu ahụ bụkwa Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.1",
            "verseOrgIds": [
              "JHN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya na Chineke nọ site na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.2",
            "verseOrgIds": [
              "JHN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E sitere na ya kee ihe niile, ọ dịghịkwa ihe ọbụla e kere eke nke a na-ekeghị site na ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.3",
            "verseOrgIds": [
              "JHN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ya ka ndụ dịrịị, ndụ ahụ bụkwa ìhè nye mmadụ niile,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.4",
            "verseOrgIds": [
              "JHN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìhè ahụ na-enwu nʼime ọchịchịrị, ma ọchịchịrị ahụ emenyụghị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.5",
            "verseOrgIds": [
              "JHN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị otu nwoke Chineke zitere, aha ya bụ Jọn.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.6",
            "verseOrgIds": [
              "JHN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bịara dị ka onye akaebe ịgba ama banyere ìhè ahụ, ka mmadụ niile site nʼaka ya kwere.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.7",
            "verseOrgIds": [
              "JHN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya onwe ya abụghị ìhè ahụ, ọ bịara naanị ịgba akaebe banyere ìhè ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.8",
            "verseOrgIds": [
              "JHN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi ìhè ahụ nke na-enye mmadụ ọbụla ìhè na-abịa nʼime ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bịara nʼụwa, ma ụwa bụ ihe e kere site nʼaka ya, ma ụwa amataghị onye ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.10",
            "verseOrgIds": [
              "JHN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bịakwutere ihe ndị ahụ bụ ndị nke ya, ma ndị ahụ bụ ndị nke ya anabataghị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.11",
            "verseOrgIds": [
              "JHN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ahụ niile nabatara ya, ndị ahụ niile kweere nʼaha ya ka o nyere ike ịghọ ụmụ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.12",
            "verseOrgIds": [
              "JHN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ a na-amụghị site nʼọbara, maọbụ site na mkpebi nke anụ ahụ, ma ọ bụkwanụ mkpebi nke mmadụ, kama site na Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu ahụ ghọrọ anụ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        },
        {
          "text": "birikwa nʼetiti anyị. Anyị ahụla ebube ya, ebube nke onye naanị ya bụ Ọkpara Nna mụrụ, onye si nʼebe Nna nọ bịa, onye jupụtara nʼamara na eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jọn gbara ama banyere ya mgbe ọ na-eti mkpu na-asị, \"Onye a bụ onye ahụ m kwuru banyere ya, 'Onye na-abịa m nʼazụ dị ukwuu karịa m, nʼihi na o bukwa m ụzọ dịrị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.15",
            "verseOrgIds": [
              "JHN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼịba ụba nke amara ya, anyị niile anatala amara a tụkwasịrị nʼamara.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.16",
            "verseOrgIds": [
              "JHN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e nyere iwu site nʼaka Mosis, ma amara na eziokwu bịara site nʼaka Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.17",
            "verseOrgIds": [
              "JHN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịbeghị onye ọbụla hụrụla Chineke, ma Chineke, onye naanị ya bụ Ọkpara Nna mụrụ. Onye ya na Nna dị na mma, emeela ka anyị mata ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jọn ekwupụta na ya abụghị Kraịst",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ịgba ama Jọn mgbe ndị ndu ndị Juu nọ na Jerusalem zipụrụ ndị nchụaja na ndị Livayị ka ha bịa jụọ ya onye ọ bụ?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.19",
            "verseOrgIds": [
              "JHN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mechighị ọnụ ya, kama o kwupụtara sị, \"Abụghị m Kraịst ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.20",
            "verseOrgIds": [
              "JHN.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ha jụrụ ya sị, \"Ị bụkwanụ onye? Ị bụ Ịlaịja?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "Ọ zara sị ha, \"Abụghị m ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "\"Ị bụ Onye amụma ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "\"Mba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị ya, \"Ị bụ onye? Nye anyị ọsịsa anyị ga-eweghachiri ndị zitere anyị. Gịnị ka i kwuru banyere onwe gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.22",
            "verseOrgIds": [
              "JHN.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, dịka Aịzaya onye amụma kwuru, \"Abụ m onye na-eti mkpu nʼime ọzara, 'Meenụ ka ụzọ Onyenwe anyị guzozie.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Farisii ahụ ezitere",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.24",
            "verseOrgIds": [
              "JHN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "jụrụ ya, sị, \"Gịnị mere i ji na-eme baptizim ọ bụrụ na ị bụghị Kraịst maọbụ Ịlaịja, maọbụ onye amụma ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.25",
            "verseOrgIds": [
              "JHN.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jọn zara ha sị, \"Eji m mmiri na-eme baptizim, ma ọ dị otu onye nọ nʼetiti unu nke unu na-amaghị.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.26",
            "verseOrgIds": [
              "JHN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ nke na-abịa nʼazụ m, onye m na-erughị ịtọpụ eriri akpụkpọụkwụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.27",
            "verseOrgIds": [
              "JHN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a mere na Betani nʼofe osimiri Jọdan bụ ebe Jọn nọ na-eme baptizim.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwa atụrụ Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya, ọ hụrụ ka Jisọs na-abịakwute ya sị, \"Leekwa, Nwa Atụrụ Chineke, onye na-ebupụ mmehie ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.29",
            "verseOrgIds": [
              "JHN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ onye a ka m kwuru okwu ya mgbe ahụ m sịrị, 'otu nwoke na-abịa nʼazụ m, onye dị ukwuu karịa m, nʼihi na o bukwa m ụzọ dịrị.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.30",
            "verseOrgIds": [
              "JHN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m amataghị ya, ma a bịara m were mmiri na-eme baptizim nʼihi nke a, ka e kpughee ya nye ndị Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.31",
            "verseOrgIds": [
              "JHN.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Jọn gbara ama a sị, \"Ahụrụ m ka Mmụọ Nsọ sitere nʼeluigwe rịdata dị ka nduru, nọkwasị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.32",
            "verseOrgIds": [
              "JHN.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m amabughị ya, ma onye ahụ zitere m ka m jiri mmiri mee baptizim kwuru, 'Onye ahụ ị ga-ahụ, onye Mmụọ Nsọ ga-ebekwasị, ma nọgidekwa, ọ bụ ya ga-eji Mmụọ Nsọ mee baptizim.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.33",
            "verseOrgIds": [
              "JHN.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ahụla ya, na-agbakwa ama na onye a bụ Ọkpara Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị mbụ soro Kraịst",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya, Jọn na mmadụ abụọ ndị na-eso ụzọ ya guzoro nʼebe ahụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.35",
            "verseOrgIds": [
              "JHN.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụrụ Jisọs ka ọ na-agafe, ọ sịrị, \"Leenụ, Nwa Atụrụ Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.36",
            "verseOrgIds": [
              "JHN.1.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmadụ abụọ ahụ na-eso ụzọ ya nụrụ nke a, ha tụgharịrị soro Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.37",
            "verseOrgIds": [
              "JHN.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs tụgharịrị hụ ka ha na-eso ya, ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ka unu chọrọ?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.38",
                "verseOrgIds": [
                  "JHN.1.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:38"
      },
      "items": [
        {
          "text": "Ha sịrị ya, \"Rabbi\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "text": "(nke pụtara \"Onye ozizi\"), \"olee ebe i bi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bịanụ, unu ga-ahụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.39",
                "verseOrgIds": [
                  "JHN.1.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:39"
      },
      "items": [
        {
          "text": "Ha sooro ya ga hụ ebe ọ na-anọ. Ha nọnyekwara ya ụbọchị ahụ niile. Ọ bụ nʼihe dị ka elekere anọ nke mgbede.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime mmadụ abụọ ahụ nụrụ ihe Jọn kwuru, nke sooro ya bụ Andru nwanne Saimọn Pita.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.40",
            "verseOrgIds": [
              "JHN.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe mbụ o mere bụ ịchọta Saimọn nwanne ya sị ya, \"Anyị achọtala Mezaya ahụ\" (onye a na-akpọkwa Kraịst).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.41",
            "verseOrgIds": [
              "JHN.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọtaara ya Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:42"
      },
      "items": [
        {
          "text": "O lere ya anya sị,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ị bụ Saimọn nwa Jọn. A ga-akpọ gị Sefas\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.42",
                "verseOrgIds": [
                  "JHN.1.42"
                ]
              }
            }
          ]
        },
        {
          "text": "(nke nsụgharị ya, pụtara Pita",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "text": ").",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs akpọọ Filip na Nataniel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya, o kpebiri ịga Galili. Mgbe ọ hụrụ Filip, ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Soro m.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.43",
                "verseOrgIds": [
                  "JHN.1.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filip bụ onye obodo Betsaida dị ka Andru na Pita.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.44",
            "verseOrgIds": [
              "JHN.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filip chọtara Nataniel sị ya, \"Anyị achọtala onye ahụ Mosis dere banyere ya nʼiwu, onye ndị amụma dekwara banyere ya, Jisọs onye Nazaret, nwa Josef.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.45",
            "verseOrgIds": [
              "JHN.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nataniel sịrị ya, \"Ihe ọma ọbụla ọ pụrụ i si na Nazaret pụta?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:46"
      },
      "items": [
        {
          "text": "Ma Filip sịrị ya, \"Bịa ka ị hụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs hụrụ ka Nataniel na-abịaru ya nso, o kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Leenụ ezi nwa afọ Izrel onye aghụghọ na-adịghị nʼime ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.47",
                "verseOrgIds": [
                  "JHN.1.47"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nataniel sịrị ya, \"Olee otu i si mata onye m bụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:48"
      },
      "items": [
        {
          "text": "Jisọs sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tupu Filip akpọ gị, ahụlarị m gị ka ị nọ nʼokpuru osisi fiig.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.48",
                "verseOrgIds": [
                  "JHN.1.48"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Nataniel zaghachiri, \"Onye ozizi, ị bụ Ọkpara Chineke; ị bụ eze Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.49",
            "verseOrgIds": [
              "JHN.1.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs zara sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"I kwere nʼihi na agwara m gị na ahụrụ m gị nʼokpuru osisi fiig? Ị ga-ahụ ihe dị ukwuu karịa nke a.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.50",
                "verseOrgIds": [
                  "JHN.1.50"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
