  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MRK 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mímọ́ àti àìmọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Farisi sì péjọ sí ọ̀dọ̀ rẹ̀, àti àwọn kan nínú àwọn akọ̀wé, tí ó wá láti Jerusalẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.1",
            "verseOrgIds": [
              "MRK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n sì ṣe àkíyèsí wí pé díẹ̀ nínú àwọn ọmọ-ẹ̀yìn Jesu ń fi ọwọ́ àìmọ́ jẹun, èyí yìí ni wẹ ọwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Àwọn Farisi, àti gbogbo àwọn Júù, bí wọ́n kò bá wẹ ọwọ́ wọn gidigidi, wọn kì í jẹun nítorí wọ́n ti pa òfin àtọwọ́dọ́wọ́ àwọn àgbà mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.3",
            "verseOrgIds": [
              "MRK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá sì ti ọjà dé sílé, wọn kò gbọdọ̀ fi ọwọ́ kan oúnjẹ àfi tí wọ́n bá bu omi wẹ ara wọn. Èyí sì jẹ́ ọ̀kan nínú ogunlọ́gọ̀ àpẹẹrẹ òfin àti ìlànà tí wọ́n ti dì mú fún ọ̀pọ̀lọpọ̀ ọdún sẹ́yìn, bí i fífọ kọ́ọ̀bù, àwọn ìkòkò, àti kẹ́tù.)",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí àwọn Farisi àti àwọn olùkọ́ òfin béèrè lọ́wọ́ rẹ̀ pé, \"Èéṣe tí àwọn ọmọ-ẹ̀yìn rẹ̀ kò tẹ̀lé àwọn òfin àtọwọ́dọ́wọ́ àwọn àgbà nítorí wọ́n fi ọwọ́ àìmọ́ jẹun?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.5",
            "verseOrgIds": [
              "MRK.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá wọn lóhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹyin àgàbàgebè yìí, òtítọ́ ni wòlíì Isaiah ń sọtẹ́lẹ̀ nípa tí ẹ̀yin àgàbàgebè, bí a ti kọ ọ́ pé:",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.6",
                "verseOrgIds": [
                  "MRK.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 7:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Àwọn ènìyàn wọ̀nyí fi ẹnu wọn bu ọlá fún mi",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.6",
                "verseOrgIds": [
                  "MRK.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 7:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ṣùgbọ́n ọkàn wọn jìnà sí mi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.6",
                "verseOrgIds": [
                  "MRK.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìsìn wọn jẹ́ lásán,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.7",
                "verseOrgIds": [
                  "MRK.7.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 7:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ìkọ́ni wọ́n jẹ́ kìkìdá òfin tí àwọn ènìyàn fi ń kọ́ni.'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.7",
                "verseOrgIds": [
                  "MRK.7.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí tí ẹ̀yin fi òfin Ọlọ́run sí apá kan, ẹ̀yin ń tẹ̀lé àṣà àwọn ènìyàn.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.8",
                "verseOrgIds": [
                  "MRK.7.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó si wí fún wọn:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.9",
            "verseOrgIds": [
              "MRK.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin sá à mọ̀ bí ẹ ti ń gbé òfin Ọlọ́run jù sẹ́yìn kí ẹ lè mú òfin tiyín ṣẹ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.9",
                "verseOrgIds": [
                  "MRK.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.9",
            "verseOrgIds": [
              "MRK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mose fún un yín ní òfin yìí láti ọ̀dọ̀ Ọlọ́run pé, 'Bọ̀wọ̀ fún baba òun ìyá rẹ.' Ó tún sọ pé, 'Ẹnikẹ́ni tí ó bá sọ̀rọ̀ aburú sí baba tàbí ìyá rẹ̀ ní láti kú ni.'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.10",
                "verseOrgIds": [
                  "MRK.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.10",
            "verseOrgIds": [
              "MRK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ẹ̀yin wá sọ pé ó dára bákan náà fún ọkùnrin kan bí kò bá tilẹ̀ pèsè fún àìní àwọn òbí rẹ̀, ṣùgbọ́n kí o sọ fún wọn pé, 'Ẹ má ṣe bínú baba tàbí ìyá mi, n kò lè ràn yín lọ́wọ́ nísinsin yìí,' nítorí tí mo ti fi ẹ̀bùn tí ǹ bá fi fún un yín fún Ọlọ́run.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.11",
                "verseOrgIds": [
                  "MRK.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.11",
            "verseOrgIds": [
              "MRK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bẹ́ẹ̀ ni ẹ̀yin kò si jẹ́ kí ó ṣe ohunkóhun fún baba tàbí ìyá rẹ̀ mọ́.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.12",
                "verseOrgIds": [
                  "MRK.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.12",
            "verseOrgIds": [
              "MRK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin ń fi òfin àtọwọ́dọ́wọ́ tiyín tí ẹ fi lélẹ̀, sọ ọ̀rọ̀ Ọlọ́run di asán àti ọ̀pọ̀ irú nǹkan bẹ́ẹ̀ ni ẹ̀yin ń ṣe.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.13",
                "verseOrgIds": [
                  "MRK.7.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, Jesu pe ọ̀pọ̀ ènìyàn láti wá gbọ́ ọ̀rọ̀ rẹ̀. Ó sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.14",
            "verseOrgIds": [
              "MRK.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gbogbo yín ẹ tẹ́tí sílẹ̀ kí ẹ sì jẹ́ kí èyí ó yé e yín.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.14",
                "verseOrgIds": [
                  "MRK.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.14",
            "verseOrgIds": [
              "MRK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kò sí ohunkóhun láti òde ènìyàn, tí ó wọ inú rẹ̀ lọ, tí ó lè sọ ọ́ di aláìmọ́, ṣùgbọ́n àwọn nǹkan tí ó ti inú rẹ jáde, àwọn wọ̀nyí ní ń sọ ènìyàn di aláìmọ́.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.15",
                "verseOrgIds": [
                  "MRK.7.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu sì wọ inú ilé kan lọ, àwọn ọmọ-ẹ̀yìn tẹ̀lé é, wọ́n sì béèrè ìtumọ̀ àwọn òwe tí ó pa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.17",
            "verseOrgIds": [
              "MRK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu béèrè wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.18",
            "verseOrgIds": [
              "MRK.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àbí kò sí èyí tí ó yé yín nínú ọ̀rọ̀ náà? Ẹ̀yin kò rí i wí pé ohunkóhun tí ó wọ inú ènìyàn láti òde kò lè sọ ènìyàn di aláìmọ́?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.18",
                "verseOrgIds": [
                  "MRK.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.18",
            "verseOrgIds": [
              "MRK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí tí kò lọ sínú ọkàn rẹ̀, ṣùgbọ́n sínú ara, a sì yà á jáde, a sì gbá gbogbo oúnjẹ dànù.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.19",
                "verseOrgIds": [
                  "MRK.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "(Nípa sísọ èyí, Jesu fihàn pé gbogbo oúnjẹ jẹ́ \"mímọ́.\")",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ó fi kún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èyí ti ó ti ọkàn ènìyàn jáde ni ń sọ ni di aláìmọ́.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.20",
                "verseOrgIds": [
                  "MRK.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí pé láti inú ọkàn ènìyàn ni àwọn èrò búburú wọ̀nyí ti ń jáde wá: àgbèrè, olè, ìpànìyàn, panṣágà,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.21",
                "verseOrgIds": [
                  "MRK.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ọ̀kánjúwà, odì yíyàn, ìtànjẹ, ìmọ-tara-ẹni, ìlara, ọ̀rọ̀ ẹ̀yìn, ìgbéraga, òmùgọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.22",
                "verseOrgIds": [
                  "MRK.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
            "verseOrgIds": [
              "MRK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gbogbo àwọn nǹkan búburú wọ̀nyí ń tí inú wá, àwọn ló sì ń sọ yín di aláìmọ́.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.23",
                "verseOrgIds": [
                  "MRK.7.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbàgbọ́ obìnrin ará Kenaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jesu kúrò ní Galili, ó sí lọ sí agbègbè Tire àti Sidoni, ó sì gbìyànjú láti nìkan wà pẹ̀lú àwọn ọmọ-ẹ̀yìn rẹ̀ fún àkókò díẹ̀, ṣùgbọ́n eléyìí kò ṣe é ṣe, nítorí pé kò pẹ́ púpọ̀ tí ó wọ ìlú nígbà tí ìròyìn dídé rẹ̀ tàn káàkiri.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láìpẹ́, obìnrin kan tí ọmọbìnrin rẹ̀ ní ẹ̀mí àìmọ́ tọ̀ ọ́ wá, ó ti gbọ́ nípa Jesu, ó wá, ó sì wólẹ̀ lẹ́sẹ̀ Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.25",
            "verseOrgIds": [
              "MRK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giriki ní obìnrin náà, Siro-Fonisia ní orílẹ̀-èdè rẹ̀. Ó bẹ Jesu kí ó bá òun lé ẹ̀mí èṣù náà jáde lára ọmọbìnrin òun.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.26",
            "verseOrgIds": [
              "MRK.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sọ fún obìnrin yìí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ní àkọ́kọ́, ó yẹ kí a fi oúnjẹ tẹ́ àwọn ọmọ lọ́rùn ná. Nítorí kò tọ́ kí a mú oúnjẹ àwọn ọmọ fún àwọn ajá.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.27",
                "verseOrgIds": [
                  "MRK.7.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà dáhùn wí pé, \"Òótọ́ ni ọ̀rọ̀ yín Olúwa, ṣùgbọ́n àwọn ọmọ ajá pàápàá a máa ní àǹfààní láti jẹ èérún oúnjẹ tí ó bá bọ́ sílẹ̀ láti orí tábìlì.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó sì wí fún un pé, nítorí ọ̀rọ̀ yìí, máa lọ, ẹ̀mí àìmọ́ náà ti jáde kúrò lára ọmọbìnrin rẹ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.29",
                "verseOrgIds": [
                  "MRK.7.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó padà dé ilé, ó bá ọmọbìnrin rẹ̀ ní ìdùbúlẹ̀ jẹ́jẹ́ lórí ibùsùn, ẹ̀mí àìmọ́ náà ti fi í sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwòsàn ọkùnrin odi àti afọ́jú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jesu fi agbègbè Tire àti Sidoni sílẹ̀, ó wá si Òkun Galili láàrín agbègbè Dekapoli.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ọkùnrin kan tí kò lè sọ̀rọ̀ wá sí ọ̀dọ̀ Jesu, àwọn ènìyàn sì bẹ Jesu pé kí ó gbé ọwọ́ rẹ̀ lé e.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
              "MRK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì mú ọkùnrin náà kúrò láàrín ọ̀pọ̀ ènìyàn. Ó sì fi àwọn ìka rẹ̀ sí etí ọkùnrin náà, ó tu itọ́ ṣọ́wọ́. Ó sì fi kan ahọ́n rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jesu wòkè ọ̀run, ó sì mí kanlẹ̀, ó sì pàṣẹ wí pé, \"Efata!\" (èyí ni,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ìwọ ṣí!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.7.34",
                "verseOrgIds": [
                  "MRK.7.34"
                ]
              }
            }
          ]
        },
        {
          "text": ").",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lójúkan náà, etí rẹ̀ sì ṣí, okùn ahọ́n rẹ̀ sì tú, ó sì ń sọ̀rọ̀ ketekete.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu pàṣẹ fún ọ̀pọ̀ ènìyàn tó wà níbẹ̀ pé kí wọn má ṣe tan ìròyìn náà ká. Ṣùgbọ́n bí ó ti ń pa wọ́n lẹ́nu mọ́ tó, náà ni wọ́n ń tan ìròyìn náà káàkiri tó.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
            "verseOrgIds": [
              "MRK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì kún fún ìyanu, wọ́n wí pé, \"Ó ṣe ohun gbogbo dáradára, Ó mú kí adití gbọ́rọ̀, odi sì sọ̀rọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.37",
            "verseOrgIds": [
              "MRK.7.37"
            ]
          }
        }
      ]
    }
  ],
