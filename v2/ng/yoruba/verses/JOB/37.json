          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wúrà dídán ti inú ìhà àríwá jáde wá;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:22"
      },
      "items": [
        {
          "text": "lọ́dọ̀ Ọlọ́run ni ọláńlá ẹ̀rù ńlá wa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ti Olódùmarè àwa kò le wádìí rẹ̀, ó rékọjá ní ipá;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:23"
      },
      "items": [
        {
          "text": "nínú ìdájọ́ àti títí bi òun kì í ba ẹ̀tọ́ àti ọ̀pọ̀lọpọ̀ òtítọ́ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ènìyàn ha máa bẹ̀rù rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.24",
            "verseOrgIds": [
              "JOB.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:24"
      },
      "items": [
        {
          "text": "òun kì í ṣe ojú sájú ẹnikẹ́ni tí ó gbọ́n ní ayé?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.24",
            "verseOrgIds": [
              "JOB.37.24"
            ]
          }
        }
