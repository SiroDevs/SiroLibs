  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "JOB 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlọ́run pe Jobu níjà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.38.1",
                "verseOrgIds": [
                  "JOB.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dá Jobu lóhùn láti inú ìjì àjàyíká wá, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ta ni èyí tí ń fi ọ̀rọ̀ àìlóye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:2"
      },
      "items": [
        {
          "text": "láti fi ṣókùnkùn bo ìmọ̀ mi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Di ẹ̀gbẹ́ ara rẹ ní àmùrè bí ọkùnrin nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "nítorí pé èmi yóò béèrè lọ́wọ́ rẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "kí o sì dá mi lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Níbo ni ìwọ wà nígbà tí mo fi ìpìlẹ̀ ayé sọlẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:4"
      },
      "items": [
        {
          "text": "Wí bí ìwọ bá mòye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó fi ìwọ̀n rẹ lélẹ̀, dájú bí ìwọ bá mọ̀ ọ́n?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:5"
      },
      "items": [
        {
          "text": "Tàbí ta ni ó ta okùn wíwọ̀n sórí rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lórí ibo ni a gbé kan ìpìlẹ̀ rẹ̀ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:6"
      },
      "items": [
        {
          "text": "tàbí ta ni ó fi òkúta igun rẹ̀ lélẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà àwọn ìràwọ̀ òwúrọ̀ jùmọ̀ kọrin pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:7"
      },
      "items": [
        {
          "text": "tí gbogbo àwọn ọmọ Ọlọ́run hó ìhó ayọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tàbí ta ni ó fi ìlẹ̀kùn sé omi òkun mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:8"
      },
      "items": [
        {
          "text": "nígbà tí ó ya padà bí ẹni pé ó ti inú jáde wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo fi àwọsánmọ̀ ṣe aṣọ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:9"
      },
      "items": [
        {
          "text": "tí mo sì fi òkùnkùn biribiri ṣe ọ̀já ìgbà inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo ti pàṣẹ ìpinnu mi fún un,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:10"
      },
      "items": [
        {
          "text": "tí mo sì ṣe bèbè àti ìlẹ̀kùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí mo sì wí pé níhìn-ín ni ìwọ ó dé, kí o má sì rékọjá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:11"
      },
      "items": [
        {
          "text": "níhìn-ín sì ni ìgbéraga rẹ yóò gbé dúró mọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ pàṣẹ fún òwúrọ̀ láti ìgbà ọjọ́ rẹ̀ wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:12"
      },
      "items": [
        {
          "text": "ìwọ sì mú ìlà-oòrùn mọ ipò rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "í ó lè di òpin ilẹ̀ ayé mú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:13"
      },
      "items": [
        {
          "text": "ki a lè gbọ́n àwọn ènìyàn búburú kúrò nínú rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó yí padà bí amọ̀ fún èdìdì amọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:14"
      },
      "items": [
        {
          "text": "kí gbogbo rẹ̀ kí ó sì fi ara rẹ̀ hàn bí ẹni pé nínú aṣọ ìgúnwà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì fa ìmọ́lẹ̀ wọn sẹ́yìn kúrò lọ́dọ̀ ènìyàn búburú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:15"
      },
      "items": [
        {
          "text": "apá gíga ni a sì ṣẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ ha wọ inú ìsun òkun lọ rí bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:16"
      },
      "items": [
        {
          "text": "Ìwọ sì rìn lórí ìsàlẹ̀ ibú ńlá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ha ṣílẹ̀kùn ikú sílẹ̀ fún ọ rí bí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:17"
      },
      "items": [
        {
          "text": "ìwọ sì rí ìlẹ̀kùn òjìji òkú?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mòye ìbú ayé bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:18"
      },
      "items": [
        {
          "text": "Sọ bí ìwọ bá mọ gbogbo èyí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ̀nà wo ni ìmọ́lẹ̀ ń gbé?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.19",
            "verseOrgIds": [
              "JOB.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:19"
      },
      "items": [
        {
          "text": "Bí ó ṣe ti òkùnkùn, níbo ni ipò rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.19",
            "verseOrgIds": [
              "JOB.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ìwọ í fi mú un lọ sí ibi àlá rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.20",
            "verseOrgIds": [
              "JOB.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:20"
      },
      "items": [
        {
          "text": "tí ìwọ ó sì le mọ ipa ọ̀nà lọ sínú ilé rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.20",
            "verseOrgIds": [
              "JOB.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mọ èyí, nítorí nígbà náà ni a bí ọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.21",
            "verseOrgIds": [
              "JOB.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:21"
      },
      "items": [
        {
          "text": "Iye ọjọ́ rẹ sì pọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.21",
            "verseOrgIds": [
              "JOB.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ ha wọ inú ìṣúra ìdì òjò lọ rí bí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.22",
            "verseOrgIds": [
              "JOB.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:22"
      },
      "items": [
        {
          "text": "ìwọ sì rí ilé ìṣúra yìnyín rí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.22",
            "verseOrgIds": [
              "JOB.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí mo ti fi pamọ́ de ìgbà ìyọnu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.23",
            "verseOrgIds": [
              "JOB.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:23"
      },
      "items": [
        {
          "text": "dé ọjọ́ ogun àti ìjà?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.23",
            "verseOrgIds": [
              "JOB.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀nà wo ni ó lọ sí ibi tí ìmọ́lẹ̀ fi ń la,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.24",
            "verseOrgIds": [
              "JOB.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:24"
      },
      "items": [
        {
          "text": "tí afẹ́fẹ́ ìlà-oòrùn ń tàn káàkiri lórí ilẹ̀ ayé?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.24",
            "verseOrgIds": [
              "JOB.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó la ipadò fún ẹ̀kún omi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.25",
            "verseOrgIds": [
              "JOB.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:25"
      },
      "items": [
        {
          "text": "àti ọ̀nà fún mọ̀nàmọ́ná àrá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.25",
            "verseOrgIds": [
              "JOB.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti mú u rọ̀jò sórí ayé níbi tí ènìyàn kò sí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.26",
            "verseOrgIds": [
              "JOB.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:26"
      },
      "items": [
        {
          "text": "ní aginjù níbi tí ènìyàn kò sí;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.26",
            "verseOrgIds": [
              "JOB.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti mú ilẹ̀ tútù, ijù àti aláìro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.27",
            "verseOrgIds": [
              "JOB.38.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:27"
      },
      "items": [
        {
          "text": "láti mú àṣẹ̀ṣẹ̀yọ ewéko rú jáde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.27",
            "verseOrgIds": [
              "JOB.38.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òjò ha ní baba bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.28",
            "verseOrgIds": [
              "JOB.38.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:28"
      },
      "items": [
        {
          "text": "Tàbí ta ni o bí ìkún ìṣe ìrì?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.28",
            "verseOrgIds": [
              "JOB.38.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti inú ta ni ìdì omi ti jáde wá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.29",
            "verseOrgIds": [
              "JOB.38.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:29"
      },
      "items": [
        {
          "text": "Ta ni ó bí ìrì dídì ọ̀run?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.29",
            "verseOrgIds": [
              "JOB.38.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí omi di líle bí òkúta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.30",
            "verseOrgIds": [
              "JOB.38.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:30"
      },
      "items": [
        {
          "text": "nígbà tí ojú ibú ńlá sì dìpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.30",
            "verseOrgIds": [
              "JOB.38.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 38:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ ha le fi ọ̀já de àwọn ìràwọ̀ Pleiadesi dáradára?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.31",
            "verseOrgIds": [
              "JOB.38.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:31"
      },
      "items": [
        {
          "text": "Tàbí ìwọ le tún di ìràwọ̀ Orioni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.31",
            "verseOrgIds": [
              "JOB.38.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 38:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ le mú àwọn àmì méjìlá ìràwọ̀ Masaroti jáde wá nígbà àkókò wọn?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.32",
            "verseOrgIds": [
              "JOB.38.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:32"
      },
      "items": [
        {
          "text": "Tàbí ìwọ le ṣe amọ̀nà Beari pẹ̀lú àwọn ọmọ rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.32",
            "verseOrgIds": [
              "JOB.38.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 38:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ìwọ mọ ìlànà ọ̀run?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.33",
            "verseOrgIds": [
              "JOB.38.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:33"
      },
      "items": [
        {
          "text": "Ìwọ le fi ìjọba Ọlọ́run lélẹ̀ lórí ayé?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.33",
            "verseOrgIds": [
              "JOB.38.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 38:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ le gbé ohùn rẹ sókè dé àwọsánmọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.34",
            "verseOrgIds": [
              "JOB.38.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:34"
      },
      "items": [
        {
          "text": "kí ọ̀pọ̀lọpọ̀ omi kí ó lè bò ọ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.34",
            "verseOrgIds": [
              "JOB.38.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 38:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ le rán mọ̀nàmọ́ná kí wọn kí ó le lọ,",
