              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí kí ni a ṣe fi ìmọ́lẹ̀ fún òtòṣì,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.20",
