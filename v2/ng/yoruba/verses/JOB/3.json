        "style": "q2",
        "vid": "JOB 3:25"
      },
      "items": [
        {
          "text": "àti ohun tí mo fòyà rẹ̀ bá mi ó sì ṣubú lù mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.25",
            "verseOrgIds": [
