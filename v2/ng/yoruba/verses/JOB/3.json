              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi wà láìní àlàáfíà, bẹ́ẹ̀ ni èmi kò ní ìsinmi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.26",
            "verseOrgIds": [
              "JOB.3.26"
            ]
