          ]
        },
        {
          "text": "Nítorí pé ohun náà tí mo bẹ̀rù gidigidi ni ó dé bá mi yìí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.25",
            "verseOrgIds": [
