        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdánwò Jobu lẹ́ẹ̀kejì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún di ọjọ́ kan nígbà tí àwọn ọmọ Ọlọ́run wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.1",
                "verseOrgIds": [
                  "JOB.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Satani sì wá pẹ̀lú wọn láti pe níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.1",
                "verseOrgIds": [
                  "JOB.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.2",
                "verseOrgIds": [
                  "JOB.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bi Satani pé, \"Níbo ni ìwọ ti wá?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 2:2"
      },
      "items": [
        {
          "text": "Satani sì dá",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.2",
                "verseOrgIds": [
                  "JOB.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "lóhùn pé, \"Láti lọ síwá sẹ́yìn lórí ilẹ̀ ayé àti ní ìrìnkèrindò nínú rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.3",
                "verseOrgIds": [
                  "JOB.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Satani pé, \"Ìwọ ha kíyèsi Jobu ìránṣẹ́ mi, pé, kò sí ẹni tí ó dàbí rẹ̀ ní ayé, ọkùnrin tí ń ṣe olóòtítọ́ tí ó sì dúró ṣinṣin, ẹni tí ó bẹ̀rù Ọlọ́run, tí ó sì kórìíra ìwà búburú, bẹ́ẹ̀ ni ó sì di ìwà òtítọ́ rẹ̀ mu ṣinṣin, bí ìwọ tilẹ̀ ti dẹ mí sí i láti run ún láìnídìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani sì dá",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.4",
            "verseOrgIds": [
              "JOB.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.4",
                "verseOrgIds": [
                  "JOB.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "lóhùn wí pé, \"Awọ fún awọ; àní ohun gbogbo tí ènìyàn ní, òun ni yóò fi ra ẹ̀mí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.4",
            "verseOrgIds": [
              "JOB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nawọ́ rẹ nísinsin yìí, kí ó tọ́ egungun rẹ̀ àti ara rẹ̀, bí kì yóò sì bọ́hùn ní ojú rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.6",
                "verseOrgIds": [
                  "JOB.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Satani pé, \"Wò ó, ó ń bẹ ní ìkáwọ́ rẹ, ṣùgbọ́n dá ẹ̀mí rẹ̀ sí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Satani jáde lọ kúrò níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.2.7",
                "verseOrgIds": [
                  "JOB.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì sọ Jobu ní oówo kíkankíkan láti àtẹ́lẹsẹ̀ títí dé àtàrí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú àpáàdì, ó fi ń họ ara rẹ̀, ó sì jókòó nínú eérú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.8",
            "verseOrgIds": [
              "JOB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni aya rẹ̀ wí fún un pé, \"Ìwọ di ìwà òtítọ́ mú síbẹ̀! Bú Ọlọ́run, kí ó sì kú!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.9",
            "verseOrgIds": [
              "JOB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó dá a lóhùn pé, \"Ìwọ sọ̀rọ̀ bí ọ̀kan lára àwọn aṣiwèrè obìnrin ti í sọ̀rọ̀; há bà! Àwa yóò ha gba ìre lọ́wọ́ Ọlọ́run, kí a má sì gba ibi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 2:10"
      },
      "items": [
        {
          "text": "Nínú gbogbo èyí, Jobu kò fi ètè rẹ̀ ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́ Jobu mẹ́ta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọ̀rẹ́ Jobu mẹ́ta gbúròó gbogbo ibi tí ó bá a, wọ́n wá, olúkúlùkù láti ibùjókòó rẹ̀; Elifasi, ara Temani àti Bilidadi, ará Ṣuhi, àti Sofari, ará Naama: nítorí pé wọ́n ti dájọ́ ìpàdé pọ̀ láti bá a ṣọ̀fọ̀, àti láti ṣìpẹ̀ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n gbójú wọn wò ní òkèrè réré, tí wọ́n kò sì mọ̀ ọ́n, wọ́n gbé ohùn wọn sókè, wọ́n sọkún: olúkúlùkù sì fa aṣọ ìgúnwà rẹ̀ ya, wọ́n sì ku erùpẹ̀ sí ojú ọ̀run, wọ́n sì tẹ́ orí gbà á.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
            "verseOrgIds": [
              "JOB.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n jókòó tì í ní inú erùpẹ̀ ní ọjọ́ méje ti ọ̀sán ti òru, ẹnikẹ́ni kò sì bá a sọ ọ̀rọ̀ kan, nítorí tí wọ́n ti rí i pé ìbànújẹ́ rẹ̀ pọ̀ jọjọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.13",
            "verseOrgIds": [
              "JOB.2.13"
            ]
          }
        }
      ]
    }
  ],
