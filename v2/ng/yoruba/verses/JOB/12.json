  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JOB 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Jobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobu sì dáhùn, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.1",
            "verseOrgIds": [
              "JOB.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kò sí àní àní níbẹ̀, ṣùgbọ́n ẹ̀yin ni àwọn ènìyàn náà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:2"
      },
      "items": [
        {
          "text": "ọgbọ́n yóò sì kú pẹ̀lú yín!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi ní ìyè nínú gẹ́gẹ́ bí ẹ̀yin;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "èmi kò kéré sí i yín.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "Àní, ta ni kò mọ gbogbo nǹkan wọ̀nyí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi dàbí ẹni tí a ń fi ṣe ẹlẹ́yà lọ́dọ̀ aládùúgbò rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "tí ó ké pe Ọlọ́run, tí ó sì dá a lóhùn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "à ń fi olóòtítọ́ ẹni ìdúró ṣinṣin rẹ́rìn-ín ẹlẹ́yà!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rọrùn fún ènìyàn láti fi ìbànújẹ́ ẹlòmíràn ṣe ẹlẹ́yà",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:5"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ìpín àwọn ẹni tí ẹsẹ̀ wọn ṣetán láti yọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àgọ́ àwọn ìgárá ọlọ́ṣà wá láìní ìbẹ̀rù;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "àwọn tí ó sì ń mú Ọlọ́run bínú wà láìléwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "àwọn ẹni tí ó sì gbá òrìṣà mú ní ọwọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n nísinsin yìí bí àwọn ẹranko léèrè, wọn o kọ́ ọ ní ẹ̀kọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:7"
      },
      "items": [
        {
          "text": "àti ẹyẹ ojú ọ̀run, wọn ó sì sọ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tàbí ba ilẹ̀ ayé sọ̀rọ̀, yóò sì kọ́ ọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:8"
      },
      "items": [
        {
          "text": "àwọn ẹja inú òkun yóò sì sọ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni kò mọ̀ nínú gbogbo nǹkan wọ̀nyí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:9"
      },
      "items": [
        {
          "text": "ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.9",
                "verseOrgIds": [
                  "JOB.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó ṣe nǹkan yìí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọwọ́ ẹni tí ẹ̀mí ohun alààyè gbogbo gbé wà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:10"
      },
      "items": [
        {
          "text": "àti ẹ̀mí gbogbo aráyé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etí kì í dán ọ̀rọ̀ wò bí",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:11"
      },
      "items": [
        {
          "text": "tàbí adùn ẹnu kì í sì í tọ́ oúnjẹ rẹ̀ wò bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arúgbó ni ọgbọ́n wà fún,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:12"
      },
      "items": [
        {
          "text": "àti nínú gígùn ọjọ́ ni òye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ti Ọlọ́run ni ọgbọ́n àti agbára;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:13"
      },
      "items": [
        {
          "text": "òun ló ni ìmọ̀ àti òye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, ó bì wó, a kò sì lè gbe ró mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:14"
      },
      "items": [
        {
          "text": "Ó sé ènìyàn mọ́, kò sì sí ìtúsílẹ̀ kan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, ó dá àwọn omi dúró, wọ́n sì gbẹ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:15"
      },
      "items": [
        {
          "text": "Ó sì rán wọn jáde, wọ́n sì ṣẹ̀ bo ilẹ̀ ayé yípo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tìrẹ ni agbára àti ìṣẹ́gun;",
          "type": "text",
          "attrs": {
