  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOB 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Jobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ̀mí mi bàjẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "ọjọ́ mi ni a ti gé kúrú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "isà òkú dúró dè mí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ àwọn ẹlẹ́yà wà lọ́dọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:2"
      },
      "items": [
        {
          "text": "ojú mi sì tẹ̀mọ́ ìmúnibínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fi fún mi Olúwa, ìlérí tí ìwọ fẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:3"
      },
      "items": [
        {
          "text": "ta ni yóò le ṣe ààbò fún mi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìwọ ti sé wọ́n láyà kúrò nínú òye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:4"
      },
      "items": [
        {
          "text": "nítorí náà ìwọ kì yóò gbé wọn lékè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó sọ ọ̀rọ̀ ẹ̀tàn dídún fún àwọn ọ̀rẹ́ rẹ̀ fún èrè,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:5"
      },
      "items": [
        {
          "text": "òun ni ojú àwọn ọmọ rẹ̀ yóò mú òfo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọlọ́run ti sọ mi di ẹni òwe fún àwọn ènìyàn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:6"
      },
      "items": [
        {
          "text": "níwájú wọn ni mo dàbí ẹni ìtutọ́ sí ní ojú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú mí ṣú bàìbàì nítorí ìbìnújẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:7"
      },
      "items": [
        {
          "text": "gbogbo ẹ̀yà ara mi sì dàbí òjìji.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olódodo yóò yanu sí èyí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:8"
      },
      "items": [
        {
          "text": "ẹni aláìṣẹ̀ sì bínú sí àwọn àgàbàgebè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódodo pẹ̀lú yóò di ọ̀nà rẹ̀ mú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:9"
      },
      "items": [
        {
          "text": "àti ọlọ́wọ́ mímọ́ yóò máa lera síwájú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n bí ó ṣe ti gbogbo yín,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:10"
      },
      "items": [
        {
          "text": "ẹ yípadà, kí ẹ si tún padà nísinsin yìí;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:10"
      },
      "items": [
        {
          "text": "èmi kò le rí ọlọ́gbọ́n kan nínú yín.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ tí èmi ti kọjá, ìrò mi ti fà yá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:11"
      },
      "items": [
        {
          "text": "àní ìrò ọkàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn wọ̀nyí ń ṣọ́ òru di ọ̀sán;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:12"
      },
      "items": [
        {
          "text": "wọ́n ní, ìmọ́lẹ̀ súnmọ́ ibi tí òkùnkùn dé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo tilẹ̀ ní ìrètí, ipò òku ní ilé mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:13"
      },
      "items": [
        {
          "text": "mo ti tẹ́ ibùsùn mi sínú òkùnkùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti wí fún ìdíbàjẹ́ pé, ìwọ ni baba mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:14"
      },
      "items": [
        {
          "text": "àti fún kòkòrò pé, ìwọ ni ìyá mi àti arábìnrin mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìrètí mi ha dà nísinsin yìí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:15"
      },
      "items": [
        {
          "text": "Bí ó ṣe ti ìrètí mi ni, ta ni yóò rí i?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sọ̀kalẹ̀ lọ sínú ipò òkú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:16"
      },
      "items": [
        {
          "text": "nígbà tí a jùmọ̀ sinmi pọ̀ nínú erùpẹ̀ ilẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    }
  ],
