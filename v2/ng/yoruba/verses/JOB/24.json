          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́, bí kò bá rí bẹ́ẹ̀ nísinsin yìí, ta ni yóò mú mi ní èké,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:25"
      },
      "items": [
        {
          "text": "tí yóò sì sọ ọ̀rọ̀ mi di aláìníláárí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
      ]
    }
