            "number": "16",
            "style": "v",
            "sid": "JOB 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òkùnkùn wọn á rúnlẹ̀ wọlé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "tí wọ́n ti fi ojú sọ fún ara wọn ní ọ̀sán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "wọn kò mọ̀ ìmọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé bí òru dúdú ní òwúrọ̀ fún gbogbo wọn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:17"
      },
      "items": [
        {
          "text": "nítorí tí wọn sì mọ̀ ìbẹ̀rù òkùnkùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ó yára lọ bí ẹni lójú omi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:18"
      },
      "items": [
        {
          "text": "ìpín wọn ní ilé ayé ni a ó parun;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:18"
      },
      "items": [
        {
          "text": "òun kò rìn lọ mọ́ ní ọ̀nà ọgbà àjàrà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bi ọ̀dá àti òru ní í mú omi òjò-dídì yọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:19"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ní isà òkú í run àwọn tó dẹ́ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú ìbímọ yóò gbàgbé rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:20"
      },
      "items": [
        {
          "text": "kòkòrò ní yóò máa fi adùn jẹun lára rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 24:20"
      },
      "items": [
        {
          "text": "a kì yóò rántí ènìyàn búburú mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:20"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ní a ó sì ṣẹ ìwà búburú bí ẹní ṣẹ́ igi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí o hù ìwà búburú sí àgàn",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:21"
      },
      "items": [
        {
          "text": "tí kò ṣe rere sí opó.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run fi ipá agbára rẹ̀ fa alágbára,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:22"
      },
      "items": [
        {
          "text": "bí wọ́n tilẹ̀ fìdímúlẹ̀, kò sí ìrètí ìyè fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì fi àìléwu fún un,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:23"
      },
      "items": [
        {
          "text": "àti nínú èyí ni a ó sì tì i lẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:23"
      },
      "items": [
        {
          "text": "ojú rẹ̀ sì wà ní ipa ọ̀nà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbé wọn lékè nígbà díẹ̀, wọ́n kọjá lọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:24"
      },
      "items": [
        {
          "text": "a sì rẹ̀ wọ́n sílẹ̀, a sì mú wọn kúrò ní ọ̀nà bí àwọn ẹlòmíràn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:24"
      },
      "items": [
        {
          "text": "a sì ké wọn kúrò bí orí síírí ọkà bàbà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
