  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1KI 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ìyàwó Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ọba fẹ́ ọ̀pọ̀ àjèjì obìnrin yàtọ̀ sí ọmọbìnrin Farao, àwọn ọmọbìnrin Moabu, àti ti Ammoni, ti Edomu, ti Sidoni àti ti àwọn ọmọ Hiti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wá láti orílẹ̀-èdè tí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.2",
                "verseOrgIds": [
                  "1KI.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí fún àwọn ọmọ Israẹli pé, \"Ẹ̀yin kò gbọdọ̀ fẹ́ wọn níyàwó tàbí ní ọkọ, nítorí wọn yóò yí ọkàn yín padà sí òrìṣà wọn.\" Síbẹ̀síbẹ̀ Solomoni fàmọ́ wọn ní ìfẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ní ẹ̀ẹ́dẹ́gbẹ̀rin (700) obìnrin, àwọn ọmọ ọba àti ọ̀ọ́dúnrún (300) àlè, àwọn ìyàwó rẹ̀ sì yí i ní ọkàn padà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Solomoni sì ti di arúgbó, àwọn ìyàwó rẹ̀ sì yí i ní ọkàn padà sí ọlọ́run mìíràn, ọkàn rẹ̀ kò sì ṣe déédé pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.4",
                "verseOrgIds": [
                  "1KI.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀, gẹ́gẹ́ bí ọkàn Dafidi baba rẹ̀ ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni tọ Aṣtoreti òrìṣà àwọn ará Sidoni lẹ́yìn, àti Moleki òrìṣà ìríra àwọn ọmọ Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Solomoni ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.6",
                "verseOrgIds": [
                  "1KI.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "; kò sì tọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.6",
                "verseOrgIds": [
                  "1KI.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "lẹ́yìn ní pípé, bí Dafidi baba rẹ̀ ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lórí òkè tí ń bẹ níwájú Jerusalẹmu, Solomoni kọ́ ibi gíga kan fún Kemoṣi, òrìṣà ìríra Moabu, àti fún Moleki, òrìṣà ìríra àwọn ọmọ Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó sì ṣe bẹ́ẹ̀ fún gbogbo àwọn àjèjì obìnrin rẹ̀, ẹni tí ń sun tùràrí, tí wọ́n sì ń rú ẹbọ fún òrìṣà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.9",
                "verseOrgIds": [
                  "1KI.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bínú sí Solomoni nítorí ọkàn rẹ̀ ti yípadà kúrò lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.9",
                "verseOrgIds": [
                  "1KI.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, tí ó ti fi ara hàn án lẹ́ẹ̀méjì.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o tilẹ̀ jẹ́ pé ó ti kìlọ̀ fún Solomoni kí ó má ṣe tọ àwọn ọlọ́run mìíràn lẹ́yìn, ṣùgbọ́n Solomoni kò pa àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.10",
                "verseOrgIds": [
                  "1KI.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.11",
                "verseOrgIds": [
                  "1KI.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún Solomoni pé, \"Nítorí bí ìwọ ti ṣe nǹkan yìí, tí ìwọ kò sì pa májẹ̀mú mi àti àṣẹ mi mọ́, tí mo ti pàṣẹ fún ọ, dájúdájú èmi yóò fa ìjọba ya kúrò lọ́wọ́ rẹ, èmi yóò sì fi fún ẹlòmíràn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, nítorí Dafidi baba rẹ, Èmi kì yóò ṣe é ní ọjọ́ rẹ. Èmi yóò fà á ya kúrò lọ́wọ́ ọmọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ èmi kì yóò fa gbogbo ìjọba náà ya, ṣùgbọ́n èmi yóò fi ẹ̀yà kan fún ọmọ rẹ nítorí Dafidi ìránṣẹ́ mi, àti nítorí Jerusalẹmu tí èmi ti yàn.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ọ̀tá Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.14",
                "verseOrgIds": [
                  "1KI.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gbé ọ̀tá kan dìde sí Solomoni, Hadadi ará Edomu ìdílé ọba ni ó ti wá ní Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, nígbà tí Dafidi wà ní Edomu, Joabu olórí ogun sì gòkè lọ láti sin àwọn ọmọ-ogun Israẹli ti a pa lójú ogun, ó sì pa gbogbo ọkùnrin Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15",
            "verseOrgIds": [
              "1KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Joabu àti gbogbo Israẹli sì dúró níbẹ̀ fún oṣù mẹ́fà, títí wọ́n fi pa gbogbo ọkùnrin Edomu run.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.16",
            "verseOrgIds": [
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Hadadi sálọ sí Ejibiti pẹ̀lú àwọn ará Edomu tí wọ́n jẹ́ ìránṣẹ́ baba rẹ̀. Hadadi sì wà ní ọmọdé nígbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dìde kúrò ní Midiani, wọ́n sì lọ sí Parani. Nígbà náà ni wọ́n mú ènìyàn pẹ̀lú wọn láti Parani wá, wọ́n sì lọ sí Ejibiti, sọ́dọ̀ Farao ọba Ejibiti ẹni tí ó fún Hadadi ní ilé àti ilẹ̀, ó sì fún un ní oúnjẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú Farao sì dùn sí Hadadi púpọ̀ tí ó fi fún un ní arábìnrin aya rẹ̀ ní aya, arábìnrin Tapenesi, ayaba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arábìnrin Tapenesi bí ọmọkùnrin kan fún un tí à ń pe orúkọ rẹ̀ ní Genubati, ẹni tí Tapenesi tọ́ dàgbà ní ààfin ọba. Níbẹ̀ ni Genubati ń gbé pẹ̀lú àwọn ọmọ Farao fúnra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì wà ní Ejibiti, Hadadi sì gbọ́ pé Dafidi ti sùn pẹ̀lú àwọn baba rẹ̀, àti pé Joabu olórí ogun sì ti kú pẹ̀lú. Nígbà náà ni Hadadi wí fún Farao pé, \"Jẹ́ kí n lọ, kí èmi kí ó le padà sí ìlú mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao sì wí fún un pé, \"Kí ni ìwọ ṣe aláìní níbí, tí ìwọ fi fẹ́ padà lọ sí ìlú rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 11:22"
      },
      "items": [
        {
          "text": "Hadadi sì wí pé, \"Kò sí nǹkan, ṣùgbọ́n sá à jẹ́ kí èmi kí ó lọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì gbé ọ̀tá mìíràn dìde sí Solomoni, Resoni ọmọ Eliada, ẹni tí ó ti sá kúrò lọ́dọ̀ Hadadeseri olúwa rẹ̀, ọba Soba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kó ènìyàn jọ sọ́dọ̀ ara rẹ̀, ó sì di olórí ogun ẹgbẹ́ kan, nígbà tí Dafidi fi pa ogun Soba run; wọ́n sì lọ sí Damasku, wọ́n ń gbé ibẹ̀, wọ́n sì jẹ ọba ní Damasku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resoni sì jẹ́ ọ̀tá Israẹli ní gbogbo ọjọ́ Solomoni, ó ń pa kún ibi ti Hadadi ṣe. Bẹ́ẹ̀ ni Resoni jẹ ọba ní Siria, ó sì ṣòdì sí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeroboamu ṣọ̀tẹ̀ sí Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bákan náà Jeroboamu ọmọ Nebati sì ṣọ̀tẹ̀ sí ọba. Ó sì jẹ́ ọ̀kan lára àwọn ìránṣẹ́ Solomoni, ará Efraimu ti Sereda, ìyá rẹ̀ sì jẹ́ opó, orúkọ rẹ̀ ni Serua.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí sì ni ìdí tí ó fi ṣọ̀tẹ̀ sí ọba: Solomoni kọ́ Millo, ó sì di ẹ̀yà ìlú Dafidi baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboamu jẹ́ ọkùnrin alágbára, nígbà tí Solomoni sì rí bí ọ̀dọ́mọkùnrin náà ti ṣe iṣẹ́ rẹ̀ dáradára, ó fi í ṣe olórí iṣẹ́ ìrú ilé Josẹfu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, ní àkókò náà Jeroboamu ń jáde kúrò ní Jerusalẹmu. Wòlíì Ahijah ti Ṣilo sì pàdé rẹ̀ lójú ọ̀nà, ó sì wọ agbádá tuntun. Àwọn méjèèjì nìkan ni ó sì ń bẹ ní oko,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahijah sì gbá agbádá tuntun tí ó wọ̀ mú, ó sì fà á ya sí ọ̀nà méjìlá.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó sọ fún Jeroboamu pé, \"Mú ọ̀nà mẹ́wàá fún ara rẹ, nítorí báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.31",
                "verseOrgIds": [
                  "1KI.11.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli wí pé, 'Wò ó, èmi yóò fa ìjọba náà ya kúrò ní ọwọ́ Solomoni, èmi yóò sì fi ẹ̀yà mẹ́wàá fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nítorí ti Dafidi ìránṣẹ́ mi àti nítorí Jerusalẹmu, ìlú tí mo ti yàn nínú gbogbo ẹ̀yà Israẹli, òun yóò ní ẹ̀yà kan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ṣe èyí nítorí tí wọ́n ti kọ̀ mí sílẹ̀, wọ́n sì ti sin Aṣtoreti òrìṣà àwọn ará Sidoni, Kemoṣi òrìṣà àwọn ará Moabu, àti Moleki òrìṣà àwọn ọmọ Ammoni, wọn kò sì rìn ní ọ̀nà mi, tàbí ṣe èyí tí ó dára lójú mi, tàbí pa àṣẹ àti òfin mi mọ́ bí Dafidi baba Solomoni ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n èmi kì yóò gba gbogbo ìjọba náà lọ́wọ́ Solomoni; èmi ti mú un jẹ́ olórí ní gbogbo ọjọ́ ayé rẹ̀ nítorí ti Dafidi ìránṣẹ́ mi, ẹni tí mo yàn, tí ó sì ti pa òfin mi àti àṣẹ mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò gba ìjọba náà ní ọwọ́ ọmọ rẹ̀, èmi yóò sì fi ẹ̀yà mẹ́wàá fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fi ẹ̀yà kan fún ọmọ rẹ kí Dafidi ìránṣẹ́ mi lè máa ní ìmọ́lẹ̀ níwájú mi nígbà gbogbo ní Jerusalẹmu, ìlú tí mo ti yàn láti fi orúkọ mi síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ti ìwọ, Èmi yóò mú ọ, ìwọ yóò sì jẹ ọba lórí ohun gbogbo tí ọkàn rẹ ń fẹ́; ìwọ yóò jẹ ọba lórí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá ṣe gbogbo èyí tí mo pàṣẹ fún ọ, tí o sì rìn ní ọ̀nà mi, tí o sì ṣe èyí tí ó tọ́ lójú mi nípa pípa òfin àti àṣẹ mi mọ́, bí i Dafidi ìránṣẹ́ mi ti ṣe, Èmi yóò wà pẹ̀lú rẹ. Èmi yóò kọ́ ilé òtítọ́ fún ọ bí èyí tí mo kọ́ fún Dafidi, èmi yóò sì fi Israẹli fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì rẹ irú-ọmọ Dafidi sílẹ̀ nítorí èyí, ṣùgbọ́n kì í ṣe títí láé.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wá ọ̀nà láti pa Jeroboamu, ṣùgbọ́n Jeroboamu sálọ sí Ejibiti, sọ́dọ̀ Ṣiṣaki ọba Ejibiti, ó sì wà níbẹ̀ títí Solomoni fi kú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù iṣẹ́ Solomoni àti gbogbo èyí tí ó ṣe, àti ọgbọ́n rẹ̀, a kò ha kọ wọ́n sínú ìwé ìṣe Solomoni bí?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì jẹ ọba ní Jerusalẹmu lórí gbogbo Israẹli ní ogójì ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Solomoni sì sùn pẹ̀lú àwọn baba rẹ̀, a sì sin ín ní ìlú Dafidi baba rẹ̀. Rehoboamu ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
  ],
