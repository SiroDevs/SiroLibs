  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1KI 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "farahan Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Solomoni sì parí kíkọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.1",
                "verseOrgIds": [
                  "1KI.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ààfin ọba, tí ó sì ti ṣe gbogbo nǹkan tí ó ń fẹ́ láti ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.2",
                "verseOrgIds": [
                  "1KI.9.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì farahàn Solomoni ní ìgbà kejì, bí ó ti farahàn án ní Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.3",
                "verseOrgIds": [
                  "1KI.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 9:3"
      },
      "items": [
        {
          "text": "\"Èmi ti gbọ́ àdúrà rẹ àti ẹ̀bẹ̀ rẹ tí ìwọ ti bẹ̀ níwájú mi, mo ti ya ilé yìí sí mímọ́, tí ìwọ ti kọ́, nípa fífi orúkọ mi síbẹ̀ títí láé. Ojú mi àti ọkàn mi yóò wà níbẹ̀ nígbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ìwọ bá rìn níwájú mi ní ọkàn òtítọ́ àti ìdúró ṣinṣin, bí i Dafidi baba rẹ ti rìn, kí o sì ṣe gbogbo èyí tí mo ti paláṣẹ fún ọ àti kí o sì pa àṣẹ mi àti òfin mi mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fi ìdí ìtẹ́ ìjọba rẹ múlẹ̀ lórí Israẹli títí láé, bí mo ti ṣe ìlérí fún Dafidi baba rẹ nígbà tí mo wí pé, 'Ìwọ kì yóò kùnà láti ní ọkùnrin kan lórí ìtẹ́ Israẹli.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n tí ìwọ tàbí àwọn ọmọ rẹ bá yípadà kúrò lọ́dọ̀ mi, tí ẹ kò sì pa òfin mi mọ́ àti àṣẹ mi tí mo ti fi fún ọ, tí ẹ sì lọ láti sin ọlọ́run mìíràn, tí ẹ sì ń sìn wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.6",
            "verseOrgIds": [
              "1KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni èmi yóò ké Israẹli kúrò ní ilẹ̀ tí èmi fi fún wọn, èmi yóò sì kọ ilé yìí tí èmi ti yà sí mímọ́ fún orúkọ mi. Nígbà náà ni Israẹli yóò sì di òwe àti ìmúṣẹ̀sín láàrín gbogbo orílẹ̀-èdè.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ilé yìí tí ó ga, ẹnu yóò sì ya olúkúlùkù ẹni tí ó kọjá lẹ́bàá rẹ̀, yóò sì pòṣé, wọn ó sì wí pé, 'Èéṣe tí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.8",
                "verseOrgIds": [
                  "1KI.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "fi ṣe irú nǹkan yìí sí ilẹ̀ yìí àti ilé yìí?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yóò sì dáhùn wí pé, 'Nítorí tí wọ́n ti kọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.9",
                "verseOrgIds": [
                  "1KI.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn sílẹ̀, tí ó mú àwọn baba wọn jáde láti Ejibiti wá, wọ́n sì ti gbá ọlọ́run mìíràn mú, wọ́n ń bọ wọ́n, wọ́n sì ń sìn wọ́n, ìdí nìyìí tí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.9",
                "verseOrgIds": [
                  "1KI.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe mú gbogbo ìjàǹbá yìí wá sórí wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ojúṣe Solomoni mìíràn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ogún ọdún, nígbà tí Solomoni kọ́ ilé méjèèjì yìí tan: ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.10",
                "verseOrgIds": [
                  "1KI.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ààfin ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ọba sì fi ogún ìlú ní Galili fún Hiramu ọba Tire, nítorí tí Hiramu ti bá a wá igi kedari àti igi firi àti wúrà gẹ́gẹ́ bí gbogbo ìfẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí Hiramu sì jáde láti Tire lọ wo ìlú tí Solomoni fi fún un, inú rẹ̀ kò sì dùn sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.12",
            "verseOrgIds": [
              "1KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Irú ìlú wo nìwọ̀nyí tí ìwọ fi fún mi, arákùnrin mi?\" Ó sì pè wọ́n ní ilẹ̀ Kabulu títí fi di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu sì ti fi ọgọ́fà tálẹ́ǹtì wúrà ránṣẹ́ sí ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdí àwọn asìnrú ti Solomoni ọba kójọ ni èyí; láti kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.15",
            "verseOrgIds": [
              "1KI.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.15",
                "verseOrgIds": [
                  "1KI.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ààfin òun tìkára rẹ̀; Millo, odi Jerusalẹmu, Hasori, Megido àti Geseri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.15",
            "verseOrgIds": [
              "1KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao ọba Ejibiti sì ti kọlu Geseri, ó sì ti fi iná sun ún, ó sì pa àwọn ará Kenaani tí ń gbé ìlú náà, ó sì fi ta ọmọbìnrin rẹ̀, aya Solomoni lọ́rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.16",
            "verseOrgIds": [
              "1KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì tún Geseri kọ́, àti Beti-Horoni ìsàlẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.17",
            "verseOrgIds": [
              "1KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti Baalati àti Tadmori ní aginjù, láàrín rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.18",
            "verseOrgIds": [
              "1KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti gbogbo ìlú ìṣúra tí Solomoni ní, àti ìlú kẹ̀kẹ́ rẹ̀, àti ìlú fún àwọn ẹlẹ́ṣin rẹ̀, àti èyí tí ó ń fẹ́ láti kọ́ ní Jerusalẹmu, ní Lebanoni àti ní gbogbo ilẹ̀ ìjọba rẹ̀ tí ó ń ṣe àkóso.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.19",
            "verseOrgIds": [
              "1KI.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn tí ó kù nínú àwọn ará Amori ará Hiti, Peresi, Hifi àti Jebusi, àwọn ènìyàn wọ̀nyí kì í ṣe ará Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.20",
            "verseOrgIds": [
              "1KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìyẹn ni pé àwọn ọmọ wọn tí ó kù ní ilẹ̀ náà, tí àwọn ọmọ Israẹli kò le parun pátápátá, àwọn ni Solomoni bu iṣẹ́ ẹrú fún títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.21",
            "verseOrgIds": [
              "1KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, Solomoni kò fi ẹnìkankan ṣe ẹrú nínú àwọn ọmọ Israẹli; àwọn ni ológun rẹ̀ àti àwọn ìránṣẹ́ rẹ̀, àti àwọn ìjòyè rẹ̀, àti àwọn balógun rẹ̀, àti àwọn olórí kẹ̀kẹ́ rẹ̀ àti ti àwọn ẹlẹ́ṣin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn sì tún ni àwọn olórí olùtọ́jú tí wọ́n wà lórí iṣẹ́ Solomoni, àádọ́ta dín lẹ́gbẹ̀ta (550), ní ń ṣe àkóso lórí àwọn ènìyàn tí ń ṣe iṣẹ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí ọmọbìnrin Farao ti gòkè láti ìlú Dafidi wá sí ààfin tí Solomoni kọ́ fún un, nígbà náà ni ó kọ́ Millo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà mẹ́ta lọ́dún ni Solomoni ń rú ẹbọ sísun àti ẹbọ àlàáfíà lórí pẹpẹ tí ó tẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.25",
                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì sun tùràrí níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.25",
                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú wọn, bẹ́ẹ̀ ni ó parí ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ọba sì túnṣe òwò ọkọ̀ ní Esioni-Geberi, tí ó wà ní ẹ̀bá Elati ní Edomu, létí Òkun Pupa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu sì rán àwọn ènìyàn rẹ̀, àwọn atukọ̀ tí ó mọ Òkun, pẹ̀lú àwọn ìránṣẹ́ Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dé Ofiri, wọ́n sì mú irinwó ó lé ogún (420) tálẹ́ǹtì wúrà, tí wọ́n ti gbà wá fún Solomoni ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.28",
            "verseOrgIds": [
              "1KI.9.28"
            ]
          }
        }
      ]
    }
