        "vid": "1KI 20:40"
      },
      "items": [
        {
          "text": "Ọba Israẹli sì wí fún un pé, \"Bẹ́ẹ̀ ni ìdájọ́ rẹ yóò rí, ìwọ fúnra rẹ̀ ti dá a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
