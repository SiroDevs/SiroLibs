              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún ọba pé, \"Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
