          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ìyókù ìṣe Nadabu àti gbogbo ohun tí ó ṣe, a kò ha kọ wọ́n sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun sì wà láàrín Asa àti Baaṣa ọba Israẹli ní gbogbo ọjọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
    },
