  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "NUM 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moabu tan Israẹli jẹ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn Israẹli dúró ní Ṣittimu, àwọn ènìyàn sì bẹ̀rẹ̀ sí í ṣe àgbèrè pẹ̀lú àwọn ọmọbìnrin Moabu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.1",
            "verseOrgIds": [
              "NUM.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ó pè wọ́n sí ibi ẹbọ òrìṣà wọn. Àwọn ènìyàn náà jẹun wọ́n sì foríbalẹ̀ níwájú òrìṣà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
            "verseOrgIds": [
              "NUM.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Israẹli ṣe darapọ̀ mọ́ wọn tí wọ́n sì jọ ń sin Baali-Peori. Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.3",
                "verseOrgIds": [
                  "NUM.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ru sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.4",
                "verseOrgIds": [
                  "NUM.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Mú gbogbo àwọn olórí àwọn ènìyàn wọ̀nyí, pa wọ́n kí o sì fi wọ́n kọ́ sórí igi ní gbangba nínú oòrùn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.4",
                "verseOrgIds": [
                  "NUM.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.4",
                "verseOrgIds": [
                  "NUM.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "lè kúrò ní ọ̀dọ̀ Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sọ fún àwọn onídàájọ́ Israẹli, \"Ẹnìkọ̀ọ̀kan yín gbọdọ̀ pa arákùnrin rẹ̀ èyí tí ó darapọ̀ ní fífi orí balẹ̀ fún Baali-Peori.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ ọ̀kan lára àwọn ọmọkùnrin Israẹli sì mú obìnrin Midiani wá síwájú ojú Mose àti gbogbo ìjọ ti Israẹli wọ́n sì ń sọkún ní àbáwọlé àgọ́ ìpàdé.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.6",
            "verseOrgIds": [
              "NUM.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Finehasi, ọmọ Eleasari, ọmọ Aaroni, àlùfáà, rí èyí, ó fi ìjọ sílẹ̀, pẹ̀lú ọ̀kọ̀ ní ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tẹ̀lé arákùnrin Israẹli yìí lọ sínú àgọ́. Ó sì fi ọ̀kọ̀ gún àwọn méjèèjì ní àgúnyọ láti ara ọkùnrin Israẹli àti sí ara obìnrin náà. Nígbà náà ni àjàkálẹ̀-ààrùn lórí àwọn ọmọ Israẹli sì dúró;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n gbogbo àwọn tí ó kú nínú àjàkálẹ̀-ààrùn náà jẹ́ ẹgbàá méjìlá (24,000).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.10",
                "verseOrgIds": [
                  "NUM.25.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tún sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Finehasi ọmọ Eleasari ọmọ Aaroni, àlùfáà, ti yí ìbínú mi padà kúrò lọ́dọ̀ àwọn ọmọ Israẹli, nítorí tí ó ní ìtara bí èmi náà ti ní ìtara fún iyì mi láàrín wọn, kí ó lè jẹ́ pé èmi ló pa wọ́n run nínú ìtara mi sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà sọ fún un pé èmi ṣe májẹ̀mú àlàáfíà mi pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun àti irú-ọmọ rẹ̀ yóò ní májẹ̀mú láéláé fún iṣẹ́ àlùfáà, nítorí pé ó ní ìtara fún Ọlọ́run rẹ̀ láti fi yẹ́ Ọlọ́run sí, ó sì ṣe ètùtù fún àwọn ọmọ Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ ọmọ Israẹli tí a pa pẹ̀lú obìnrin Midiani náà ni Simri, ọmọ Salu, olórí ilé kan nínú àwọn ọmọ Simeoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ ọmọbìnrin Midiani náà tí a pa ní Kosbi ọmọbìnrin Suri, tí ṣe olóyè àwọn ẹ̀yà kan nínú ìdílé kan ní Midiani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.16",
                "verseOrgIds": [
                  "NUM.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tún sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.16",
            "verseOrgIds": [
              "NUM.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka àwọn ará Midiani sí ọ̀tá, kí o sì pa wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí pé wọ́n ṣe sí yín gẹ́gẹ́ bí ọ̀tá nígbà tí wọ́n tàn yín nípa ìṣẹ̀lẹ̀ Peori, àti arábìnrin wọn Kosbi ọmọbìnrin ìjòyè Midiani kan, obìnrin tí a pa nígbà tí àjàkálẹ̀-ààrùn ṣẹlẹ̀ nítorí Peori.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.18",
            "verseOrgIds": [
              "NUM.25.18"
            ]
          }
        }
      ]
    }
  ],
