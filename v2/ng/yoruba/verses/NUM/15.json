                "verseOrgIds": [
                  "NUM.15.39"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ẹ bá à lè ṣe wọ́n, kí ẹ sì má bá à ṣe àgbèrè nípa títẹ̀lé ìfẹ́kúfẹ̀ẹ́ ọkàn àti ojú yín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
