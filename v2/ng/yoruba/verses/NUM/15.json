              "type": "text"
            }
          ]
        },
        {
          "text": "Wajawaja yìí ni ẹ sì máa wọ̀ láti lè mú yín rántí gbogbo òfin",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
