  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NUM 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kíkùn àwọn ènìyàn àti iná láti ọ̀dọ̀",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn ń ṣe àròyé nípa wàhálà wọn sí etí ìgbọ́",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.1",
                "verseOrgIds": [
                  "NUM.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.1",
                "verseOrgIds": [
                  "NUM.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ru sókè nígbà tí ó gbọ́ àròyé yìí. Nígbà náà ni iná jáde láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.1",
                "verseOrgIds": [
                  "NUM.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bọ́ sí àárín wọn, ó sì run àwọn tó wà ní òpin ibùdó.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ènìyàn kígbe sí Mose, Mose sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.2",
                "verseOrgIds": [
                  "NUM.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "iná náà sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ń pe ibẹ̀ ní Tabera nítorí pé, iná láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.3",
                "verseOrgIds": [
                  "NUM.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "jó láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹran àparò láti ọ̀dọ̀",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀pọ̀ ènìyàn aláìníláárí tó wà láàrín àwọn ọmọ Israẹli pẹ̀lú ọkàn ìfẹ́kúfẹ̀ẹ́ wọn fi ìtara béèrè fún oúnjẹ mìíràn, àwọn ọmọ Israẹli náà bá bẹ̀rẹ̀ sí í sọkún wí pé, \"Bí i pé kí á rí ẹran jẹ báyìí!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.4",
            "verseOrgIds": [
              "NUM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa rántí ẹja tí à ń jẹ lọ́fẹ̀ẹ́ ní Ejibiti, apálà, bàrà, ewébẹ̀, àlùbọ́sà àti àwọn ẹ̀fọ́ mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.5",
            "verseOrgIds": [
              "NUM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n báyìí gbogbo ara wa ti gbẹ, kò sí ohun mìíràn láti jẹ àfi manna nìkan tí a rí yìí!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manna náà dàbí èso korianderi, ìrísí rẹ̀ sì dàbí oje igi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn náà ń lọ káàkiri láti kó o, wọn ó lọ̀ ọ́ lórí ọlọ tàbí kí wọ́n gún un nínú odó. Wọ́n le sè é nínú ìkòkò tàbí kí wọn ó fi ṣe àkàrà, adùn rẹ̀ yóò sì dàbí adùn ohun tí a fi òróró ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìrì bá ẹ̀ sí ibùdó lórí ni manna náà máa ń bọ́ pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì gbọ́ tí àwọn ènìyàn ń sọkún ní gbogbo ìdílé wọn, oníkálùkù ní ẹnu-ọ̀nà àgọ́ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.10",
                "verseOrgIds": [
                  "NUM.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bínú gidigidi. Inú Mose sì bàjẹ́ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.11",
                "verseOrgIds": [
                  "NUM.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Kí ló dé tí o fi mú wàhálà yìí bá ìránṣẹ́ rẹ? Kí ni mo ṣe tí n kò fi tẹ ọ lọ́rùn tí ìwọ fi di ẹrù àwọn ènìyàn wọ̀nyí lé mi lórí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ni mo ha lóyún gbogbo àwọn ènìyàn wọ̀nyí bí? Àbí èmi ló bí wọn? Tí ìwọ fi sọ fún mi pé, máa gbé wọn sí oókan àyà rẹ, gẹ́gẹ́ bí abiyamọ ti máa ń gbe ọmọ ọmú lọ sí ilẹ̀ tí o ti búra láti fún àwọn baba ńlá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.12",
            "verseOrgIds": [
              "NUM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbo ni n ó ti rí ẹran fún àwọn ènìyàn wọ̀nyí? Nítorí wọ́n ń sọkún sí mi pé, 'Fún wa lẹ́ran jẹ́!'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.13",
            "verseOrgIds": [
              "NUM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi nìkan kò lè dágbé wàhálà àwọn ènìyàn wọ̀nyí, ẹrù wọn ti wúwo jù fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.14",
            "verseOrgIds": [
              "NUM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá sì ṣe pé báyìí ni ìwọ ó ṣe máa ṣe fún mi, kúkú pa mí báyìí, tí mo bá ti bá ojúrere rẹ pàdé—kí ojú mi má ba à rí ìparun mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.16",
                "verseOrgIds": [
                  "NUM.11.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Mú àádọ́rin ọkùnrin nínú àwọn àgbàgbà àwọn ọmọ Israẹli, àwọn tí o mọ̀ gẹ́gẹ́ bí olórí àti olóyè láàrín àwọn ènìyàn wá sínú àgọ́ ìpàdé, kí wọ́n lé dúró níwájú mi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó sì sọ̀kalẹ̀ wá bá yín sọ̀rọ̀ níbẹ̀. Èmi ó sì mú díẹ̀ nínú agbára Ẹ̀mí tí ń bẹ lára rẹ láti fi sí orí àwọn ènìyàn wọ̀nyí. Wọn ó sì máa ràn ọ́ lọ́wọ́ láti ru àjàgà àwọn ènìyàn kí ó má ṣe pé ìwọ nìkan ni ó o máa ru àjàgà náà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.17",
            "verseOrgIds": [
              "NUM.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ènìyàn náà pé, 'Ẹ ya ara yín sí mímọ́ ní ìmúrasílẹ̀ fún ọ̀la, ẹ ó sì jẹ ẹran. Nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.18",
                "verseOrgIds": [
                  "NUM.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbọ́ igbe ẹkún yín, èyí tí ẹ sun pé, \"Ìbá ṣe pé a lè rí ẹran jẹ ni! Ó sàn fún wa ní Ejibiti jù báyìí lọ!\" Nítorí náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.18",
                "verseOrgIds": [
                  "NUM.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi fún yín ní ẹran, ẹ ó sì jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò ní i jẹ ẹ́ fún ọjọ́ kan, ọjọ́ méjì, ọjọ́ márùn-ún, ọjọ́ mẹ́wàá tàbí ogúnjọ́ lásán,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.19",
            "verseOrgIds": [
              "NUM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n fún odidi oṣù kan, títí tí ẹran náà yóò fi máa yọ ní imú yín, tí yóò sì sú yín, nítorí pé ẹ ti kẹ́gàn",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.20",
                "verseOrgIds": [
                  "NUM.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó wà láàrín yín, ẹ sì ti sọkún fún un wí pé, \"Kí ló dé tí a fi kúrò ní Ejibiti gan an?\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Mose sọ pé, \"Mo wà láàrín ọgbọ̀n ọ̀kẹ́ ènìyàn (600,000) ni ìrìnkiri, ó sì sọ pé, 'Èmi ó fún wọn ní ẹran láti jẹ fún oṣù kan gbáko!'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.21",
            "verseOrgIds": [
              "NUM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí a tilẹ̀ pa àgbò ẹran àti ọmọ ẹran, yóò ha tó wọn bí? Tàbí bí a tilẹ̀ pa gbogbo ẹja inú omi fún wọn, yóò wa tó bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.23",
                "verseOrgIds": [
                  "NUM.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dá Mose lóhùn pé, \"Ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.23",
                "verseOrgIds": [
                  "NUM.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ha kúrú bí? Ìwọ yóò ri nísinsin yìí bóyá ọ̀rọ̀ tí mo sọ yóò ṣẹ tàbí kò ni í ṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì jáde, ó sọ ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.24",
                "verseOrgIds": [
                  "NUM.11.24"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún àwọn ènìyàn. Ó mú àwọn àádọ́rin àgbàgbà Israẹli dúró yí àgọ́ ká.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.25",
                "verseOrgIds": [
                  "NUM.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ̀kalẹ̀ nínú àwọ̀ sánmọ̀ ó sì bá wọn sọ̀rọ̀, ó sì mú lára Ẹ̀mí tó wà lára Mose sí ara àwọn àádọ́rin àgbàgbà náà, Ó sì ṣẹlẹ̀ pé nígbà tí Ẹ̀mí náà bà lé wọn, wọ́n sọtẹ́lẹ̀, ṣùgbọ́n lẹ́yìn èyí wọn kò sọtẹ́lẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin méjì, tí orúkọ wọn ń jẹ́ Eldadi àti Medadi kò kúrò nínú àgọ́. Orúkọ wọn wà lára àádọ́rin àgbàgbà yìí ṣùgbọ́n wọn kò jáde nínú àgọ́ síbẹ̀ Ẹ̀mí náà bà lé wọn, wọ́n sì sọtẹ́lẹ̀ nínú àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọkùnrin kan sì sáré lọ sọ fún Mose pé, \"Eldadi àti Medadi ń sọtẹ́lẹ̀ nínú àgọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua ọmọ Nuni tí í ṣe ìránṣẹ́ Mose, láti kékeré tó jẹ́ ọ̀kan nínú àwọn ọmọkùnrin rẹ̀ dáhùn pé, \"Mose olúwa mi, dá wọn lẹ́kun!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì wí fún un pé, \"Àbí ìwọ ń jowú nítorí mi? Ìbá ti wù mí tó, kí gbogbo àwọn ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.29",
                "verseOrgIds": [
                  "NUM.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ wòlíì, kí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.29",
                "verseOrgIds": [
                  "NUM.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi Ẹ̀mí rẹ̀ sí wọn lára!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose àti àwọn àgbàgbà Israẹli yìí sì padà sínú àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afẹ́fẹ́ sì jáde láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.31",
                "verseOrgIds": [
                  "NUM.11.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ó sì kó àparò wá láti inú Òkun. Ó sì dà wọ́n káàkiri gbogbo ibùdó ní ìwọ̀n gíga ẹsẹ̀ bàtà mẹ́ta sórí ilẹ̀, bí ìwọ̀n ìrìn ọjọ́ kan ní gbogbo àyíká.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo ọjọ́ náà àti òru, títí dé ọjọ́ kejì ni àwọn ènìyàn fi ń kó àparò yìí, ẹni tó kó kéré jùlọ kó ìwọ̀n homeri mẹ́wàá, wọ́n sì ṣà wọ́n sílẹ̀ fún ara wọn yí gbogbo ibùdó.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ẹran náà sì wà láàrín eyín wọn, kó tó di pé wọ́n jẹ ẹ́, ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.33",
                "verseOrgIds": [
                  "NUM.11.33"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ru sí àwọn ènìyàn, ó sì pa wọ́n pẹ̀lú àjàkálẹ̀-ààrùn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí èyí ni wọ́n ṣe pe ibẹ̀ ní Kibirotu-Hattaafa nítorí pé níbẹ̀ ni wọ́n gbé sìnkú àwọn ènìyàn tó ní ọ̀kánjúwà oúnjẹ sí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yòókù sì gbéra láti Kibirotu-Hattaafa lọ pa ibùdó sí Haserotu wọ́n sì dúró níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
      ]
    }
  ],
