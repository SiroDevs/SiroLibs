  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EZK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arábìnrin panṣágà méjì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.1",
                "verseOrgIds": [
                  "EZK.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, obìnrin méjì wà, ọmọ ìyá kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.2",
            "verseOrgIds": [
              "EZK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ń ṣe panṣágà ní Ejibiti, wọn ń ṣe panṣágà láti ìgbà èwe wọn. Ní ilẹ̀ yẹn ni wọn ti fi ọwọ́ pa ọyàn wọn, níbẹ̀ ni wọn sì fọwọ́ pa igbá àyà èwe wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.3",
            "verseOrgIds": [
              "EZK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ẹ̀gbọ́n ń jẹ́ Ohola, àbúrò rẹ̀ sì ń jẹ́ Oholiba. Tèmi ni wọ́n, wọ́n sì bí àwọn ọmọkùnrin àti àwọn ọmọbìnrin. Ohola ni Samaria, Oholiba sì ni Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ohola ń ṣe panṣágà nígbà tí ó sì jẹ́ tèmi; Ó sì ṣe ìfẹ́kúfẹ̀ẹ́ sí àwọn olólùfẹ́ rẹ̀, àwọn jagunjagun ará Asiria.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.5",
            "verseOrgIds": [
              "EZK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣọ aláró ni a fi wọ̀ wọ́n, àwọn gómìnà àti àwọn balógun, gbogbo wọn jẹ́ ọ̀dọ́mọkùnrin arẹwà àwọn tí ń gun ẹṣin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.6",
            "verseOrgIds": [
              "EZK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O fi ara rẹ̀ fún gbajúmọ̀ ọkùnrin Asiria gẹ́gẹ́ bí panṣágà obìnrin, o fi òrìṣà gbogbo àwọn tí ó ní ìfẹ́kúfẹ̀ẹ́ sí i sọ ara rẹ̀ di aláìmọ́,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.7",
            "verseOrgIds": [
              "EZK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kò fi ìwà panṣágà tí ó ti bẹ̀rẹ̀, ni Ejibiti sílẹ̀, ní ìgbà èwe rẹ̀ àwọn ọkùnrin n bá a sùn, wọn fi ọwọ́ pa àyà èwe rẹ̀ lára wọn sì ń ṣe ìfẹ́kúfẹ̀ẹ́ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.8",
            "verseOrgIds": [
              "EZK.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà mo fi i sílẹ̀ fún àwọn olólùfẹ́ rẹ̀, ará Asiria, tí ó ní ìfẹ́kúfẹ̀ẹ́ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.9",
            "verseOrgIds": [
              "EZK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n bọ́ ọ sí ìhòhò, wọ́n sì gba àwọn ọmọkùnrin àti ọmọbìnrin rẹ̀ wọn sì pa wọn pẹ̀lú idà. Ó di ẹni ìfisọ̀rọ̀ sọ láàrín àwọn obìnrin wọ́n sì fi ìyà jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àbúrò rẹ̀ Oholiba rí èyí, síbẹ̀ nínú ìfẹ́kúfẹ̀ẹ́ àti panṣágà rẹ̀, Ó ba ara rẹ jẹ́ ju ẹ̀gbọ́n rẹ̀ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.11",
            "verseOrgIds": [
              "EZK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun náà ní ìfẹ́kúfẹ̀ẹ́ sí ará Asiria àwọn gómìnà àti àwọn balógun, jagunjagun nínú aṣọ ogun, àwọn tí ń gun ẹṣin, gbogbo àwọn ọ̀dọ́mọkùnrin arẹwà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.12",
            "verseOrgIds": [
              "EZK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo rí i pé òun náà ba ara rẹ̀ jẹ́; àwọn méjèèjì rìn ojú ọ̀nà kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.13",
            "verseOrgIds": [
              "EZK.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ó tẹ̀síwájú nínú ṣíṣe panṣágà. O ri àwòrán àwọn ọkùnrin lára ògiri, àwòrán àwọn ara Kaldea àwòrán pupa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.14",
            "verseOrgIds": [
              "EZK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "pẹ̀lú ìgbànú ni ìdí wọn àti àwọn ìgbàrí ni orí wọn; gbogbo wọn dàbí olórí kẹ̀kẹ́ ogun Babeli ọmọ ìlú Kaldea.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.15",
            "verseOrgIds": [
              "EZK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní kété tí ó rí wọn, ó ní ìfẹ́kúfẹ̀ẹ́ sí wọn, ó sì rán oníṣẹ́ sí wọn ni Kaldea.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.16",
            "verseOrgIds": [
              "EZK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Babeli wá sọ́dọ̀ rẹ̀, lórí ibùsùn ìfẹ́, nínú ìfẹ́kúfẹ̀ẹ́ wọn, wọ́n bà á jẹ́. Lẹ́yìn ìgbà tí wọ́n bà á jẹ́ tán, ó yípadà kúrò lọ́dọ̀ wọn ní ìtìjú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.17",
            "verseOrgIds": [
              "EZK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó tẹ̀síwájú nínú iṣẹ́ panṣágà rẹ̀ ní gbangba wọ́n sì tú u sí ìhòhò, mo yí padà kúrò lọ́dọ̀ rẹ̀ ní ìtìjú, gẹ́gẹ́ bí mo ti yípadà kúrò lọ́dọ̀ ẹ̀gbọ́n rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.18",
            "verseOrgIds": [
              "EZK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀ ó ń pọ̀ sí i nínú ìdàpọ̀ rẹ̀ bí ó ti ń rántí ìgbà èwe rẹ̀ tí ó jẹ́ panṣágà ní Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.19",
            "verseOrgIds": [
              "EZK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ó fẹ́ olùfẹ́ àwọn olùfẹ́ wọn ní àfẹ́jù, tí àwọn tí nǹkan ọkùnrin wọn dàbí ti kẹ́tẹ́kẹ́tẹ́, àwọn ẹni tí ìtújáde ara wọn dàbí ti àwọn ẹṣin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.20",
            "verseOrgIds": [
              "EZK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni ìwọ pe ìwà ìfẹ́kúfẹ̀ẹ́ ìgbà èwe rẹ wá sí ìrántí, ní ti rírin orí ọmú rẹ láti ọwọ́ àwọn ará Ejibiti, fún ọmú ìgbà èwe rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, Oholiba, báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.22",
                "verseOrgIds": [
                  "EZK.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, Èmi yóò gbé olólùfẹ́ rẹ dìde sí ọ, àwọn tí o kẹ́yìn si ní ìtìjú, èmi yóò sì mú wọn dojúkọ ọ́ ní gbogbo ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ará Babeli àti gbogbo ara Kaldea àwọn ọkùnrin Pekodi àti Ṣoa àti Koa àti gbogbo ará Asiria pẹ̀lú wọn, àwọn ọ̀dọ́mọkùnrin arẹwà, gbogbo àwọn gómìnà àti balógun, olórí oníkẹ̀kẹ́ ogun àti àwọn onípò gíga, gbogbo àwọn tí ń gun ẹṣin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.23",
            "verseOrgIds": [
              "EZK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò wa dojúkọ ọ pẹ̀lú ohun ìjà, kẹ̀kẹ́ ogun pẹ̀lú kẹ̀kẹ́ ẹrù àti pẹ̀lú ìwọ́jọpọ̀ ènìyàn; wọn yóò mú ìdúró wọn lòdì sí ọ ní gbogbo ọ̀nà pẹ̀lú asà ńlá àti kékeré pẹ̀lú àṣíborí. Èmi yóò yí ọ padà sí wọn fun ìjìyà, wọn yóò sì fi ìyà jẹ ọ gẹ́gẹ́ bí wọn tí tó.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.24",
            "verseOrgIds": [
              "EZK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì dojú ìbínú owú mi kọ ọ́, wọn yóò sì fìyà jẹ ọ́ ní ìrunú. Wọ́n yóò gé àwọn imú àti àwọn etí yín kúrò, àwọn tí ó kù nínú yín yóò ti ipá idà ṣubú. Wọn yóò mú àwọn ọmọkùnrin àti àwọn ọmọkùnrin yín lọ, àwọn tí o kù nínú yín ni iná yóò jórun.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.25",
            "verseOrgIds": [
              "EZK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì kó àwọn aṣọ àti àwọn ohun ọ̀ṣọ́ iyebíye yín.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.26",
            "verseOrgIds": [
              "EZK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fi òpin sí ìwà ìfẹ́kúfẹ̀ẹ́ àti iṣẹ́ panṣágà tí ẹ bẹ̀rẹ̀ ni Ejibiti. Ẹ̀yin kò ní wo àwọn nǹkan wọ̀nyí pẹ̀lú ìpòùngbẹ, bẹ́ẹ̀ ni ẹ kò ní rántí Ejibiti mọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.27",
            "verseOrgIds": [
              "EZK.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.28",
                "verseOrgIds": [
                  "EZK.23.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Èmi yóò fi ọ lé ọwọ́ àwọn tí ó kórìíra, lọ́wọ́ àwọn ẹni tí ọkàn rẹ ti ṣí kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò fìyà jẹ ọ́ pẹ̀lú ìkórìíra, wọn yóò sì kó gbogbo ohun tí o ṣiṣẹ́ fún lọ. Wọn yóò fi ọ́ sílẹ̀ ní ìhòhò goloto, ìtìjú iṣẹ́ panṣágà rẹ ni yóò farahàn. Ìwà ìfẹ́kúfẹ̀ẹ́ rẹ̀ àti panṣágà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.29",
            "verseOrgIds": [
              "EZK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ṣe gbogbo nǹkan wọ̀nyí sí ọ, nítorí ìwọ ti bá àwọn kèfèrí ṣe àgbèrè lọ, o sì fi àwọn òrìṣà wọn ba ara rẹ̀ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.30",
            "verseOrgIds": [
              "EZK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti rin ọ̀nà ti ẹ̀gbọ́n rẹ rìn, Èmi yóò sì fi ago rẹ̀ lé ọ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.31",
            "verseOrgIds": [
              "EZK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí yìí ní ohun ti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.32",
                "verseOrgIds": [
                  "EZK.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "\"Ìwọ yóò mu nínú ago ẹ̀gbọ́n rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "ago tí ó tóbi tí ó sì jinnú:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "yóò mú ìfiṣẹ̀sín àti ìfiṣe ẹlẹ́yà wá,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "nítorí tí ago náà gba nǹkan púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò mu àmupara àti ìbànújẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "ago ìparun àti ìsọdahoro",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "ago ẹ̀gbọ́n rẹ Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò mú un ni àmugbẹ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "ìwọ yóò sì fọ sí wẹ́wẹ́",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "ìwọ yóò sì fa ọmú rẹ̀ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "Èmi ti sọ̀rọ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.34",
                "verseOrgIds": [
                  "EZK.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.35",
                "verseOrgIds": [
                  "EZK.23.35"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Níwọ́n bí ìwọ ti gbàgbé mi, tí ìwọ sì ti fi mi sí ẹ̀yìn rẹ, ìwọ gbọdọ̀ gba àbájáde ìfẹ́kúfẹ̀ẹ́ àti panṣágà rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.36",
                "verseOrgIds": [
                  "EZK.23.36"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún mi pé: \"Ọmọ ènìyàn, ń jẹ́ ìwọ yóò ṣe ìdájọ́ Ohola àti Oholiba? Nítorí náà dojúkọ wọn nípa ìkórìíra tí wọn ń ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.36",
            "verseOrgIds": [
              "EZK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí wọn ti dá ẹ̀ṣẹ̀ panṣágà ẹ̀jẹ̀ sì wà ní ọwọ́ wọn. Wọn dá ẹ̀ṣẹ̀ panṣágà pẹ̀lú àwọn òrìṣà wọn; kódà wọ́n fi àwọn ọmọ wọn tí wọn bí fún ni ṣe ìrúbọ, gẹ́gẹ́ bí oúnjẹ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.37",
            "verseOrgIds": [
              "EZK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bákan náà ni wọ́n ti ṣe èyí náà sí mi. Ní àkókò kan náà wọn ba ibi mímọ́ mi jẹ́, wọ́n sì lo ọjọ́ ìsinmi mi ní àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.38",
            "verseOrgIds": [
              "EZK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà gan an wọ́n fi àwọn ọmọ wọn rú ẹbọ sí àwọn òrìṣà, wọn wọ ibi mímọ́ mi lọ wọn sì lò ó ní ìlòkulò. Ìyẹn ní wọn ṣe ní ilé mi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.39",
            "verseOrgIds": [
              "EZK.23.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọn tilẹ̀ rán oníṣẹ́ sí àwọn ènìyàn tí wọ́n wá láti ọ̀nà jíjìn, nígbà tí wọ́n dé, ìwọ wẹ ara rẹ fún wọn, ìwọ kún ojú rẹ, ìwọ sì fi ọ̀ṣọ́ iyebíye sára.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.40",
            "verseOrgIds": [
              "EZK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ jókòó lórí ibùsùn ti o lẹ́wà, pẹ̀lú tábìlì tí a tẹ́ ní iwájú rẹ lórí, èyí tí o gbé tùràrí àti òróró tí ó jẹ́ tèmi kà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.41",
            "verseOrgIds": [
              "EZK.23.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ariwo ìjọ ènìyàn tí kò bìkítà wà ní àyíká rẹ̀; a mú àwọn ara Sabeani láti aginjù pẹ̀lú àwọn ọkùnrin láti ara àwọn ọ̀pọ̀ ènìyàn aláìníláárí, wọ́n sì mú àwọn ẹ̀gbà ọrùn ọwọ́ sí àwọn ọwọ́ obìnrin náà àti ẹ̀gbọ́n rẹ̀, adé dáradára sì wà ní orí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.42",
            "verseOrgIds": [
              "EZK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà mo sọ̀rọ̀ nípa èyí tí ó lo ara rẹ̀ sá nípa panṣágà ṣíṣe, 'Nísinsin yìí jẹ kí wọn lo o bí panṣágà, nítorí gbogbo ohun tí ó jẹ́ nìyẹn.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.43",
            "verseOrgIds": [
              "EZK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ba sùn bí ọkùnrin ti bá panṣágà sùn, bẹ́ẹ̀ ni wọ́n ṣe sùn pẹ̀lú obìnrin onífẹ̀kúfẹ̀ẹ́, Ohola àti Oholiba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.44",
            "verseOrgIds": [
              "EZK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ọkùnrin olódodo yóò pàṣẹ pé kí wọ́n fi ìyà jẹ àwọn obìnrin tí ó dá ẹ̀ṣẹ̀ àgbèrè tí ó sì ta ẹ̀jẹ̀ sílẹ̀ nítorí pé panṣágà ni wọ́n ẹ̀jẹ̀ sì wà ní ọwọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.46",
                "verseOrgIds": [
                  "EZK.23.46"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Mú àgbájọ àwọn ènìyànkénìyàn wá sọ́dọ̀ wọn ki ó sì fi wọn lé ọwọ́ ìpayà àti ìkógun.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyànkénìyàn náà yóò sọ wọ́n ni òkúta, yóò sì gé wọn lulẹ̀ pẹ̀lú idà wọn; wọn ó sì pa àwọn ọmọkùnrin àti àwọn ọmọbìnrin wọn, wọ́n ó sì jó àwọn ilé wọn kanlẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.47",
            "verseOrgIds": [
              "EZK.23.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi yóò sì fi òpin sí ìwà ìfẹ́kúfẹ̀ẹ́ ni ilẹ̀ náà, kí gbogbo àwọn obìnrin le gba ìkìlọ̀ kí wọn kí ó ma sì ṣe fi ara wé ọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.48",
            "verseOrgIds": [
              "EZK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì jìyà fún ìfẹ́kúfẹ̀ẹ́ rẹ, ìwọ yóò sì gba àbájáde àwọn ẹ̀ṣẹ̀ panṣágà tí o dá. Nígbà náà ìwọ yóò mọ̀ pé èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.49",
                "verseOrgIds": [
                  "EZK.23.49"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        }
      ]
    }
  ],
