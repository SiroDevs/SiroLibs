  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "EZK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkàn tí o bá sẹ̀ ni yóò kú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.18.1",
                "verseOrgIds": [
                  "EZK.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tún tọ̀ mí wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kín ni ẹ̀yin rò tí ẹ̀yin fi ń pa òwe nípa Israẹli wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:2"
      },
      "items": [
        {
          "text": "\" 'Àwọn baba ti jẹ èso àjàrà kíkan,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:2"
      },
      "items": [
        {
          "text": "eyín àwọn ọmọ sì kan.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí mo ti wà láààyè ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.18.3",
                "verseOrgIds": [
                  "EZK.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, ẹ̀yin kí yóò pa òwe yìí mọ́ ni Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé èmi ló ní gbogbo ọkàn, ọkàn baba tèmi bẹ́ẹ̀ ni ọkàn ọmọ pàápàá jẹ tèmi, ọkàn tó bá ṣẹ̀ ní yóò kú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin olódodo kan bá wà,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:5"
      },
      "items": [
        {
          "text": "tó ń ṣe ohun tó tọ́, tó sì yẹ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí kò bá wọn jẹun lórí òkè gíga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "tí kò gbójú rẹ̀ sókè sí àwọn òrìṣà ilẹ̀ Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "ti kò sì ba obìnrin aládùúgbò rẹ̀ jẹ́",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "tàbí kí ó sùn ti obìnrin ni àsìkò èérí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sì ni ẹnikẹ́ni lára,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "ó sì sanwó fún onígbèsè rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bó ṣe ṣe ìlérí fún un,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "kò fi ipá jalè",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ó fún ẹni tí ebi ń pa ní oúnjẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "tí ó sì fi ẹ̀wù wọ àwọn tí ó wà ní ìhòhò.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí kò fi fún ni láti gba ẹ̀dá,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "tàbí kò gba èlé tó pọ̀jù.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "Ó yọ ọwọ́ rẹ̀ kúrò nínú ìwà ẹ̀ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "ó sì ń ṣe ìdájọ́ òtítọ́ láàrín ọkùnrin kan àti èkejì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ó ń tẹ̀lé àṣẹ mi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "tí ó sì ń pa òfin mi mọ́ lóòtítọ́ àti lódodo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "Ó jẹ́ olódodo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "yóò yè nítòótọ́,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.18.9",
                "verseOrgIds": [
                  "EZK.18.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ó bá bi ọmọkùnrin, oníwà ipá, tó ń jalè, tó tún ń pànìyàn, tó sì ń ṣe gbogbo àwọn nǹkan wọ̀nyí sí arákùnrin rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.10",
            "verseOrgIds": [
              "EZK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(tí kò sì ṣe ọ̀kan nínú gbogbo iṣẹ́ wọ̀n-ọn-nì):",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:11"
      },
      "items": [
        {
          "text": "\"Ó ń jẹun lójúbọ lórí òkè gíga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:11"
      },
      "items": [
        {
          "text": "tí ó sì ba obìnrin aládùúgbò rẹ̀ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ni àwọn tálákà àti aláìní lára,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "ó ń fipá jalè, kì í dá padà gẹ́gẹ́ bí ìlérí,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "o gbójú sókè sí òrìṣà,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "ó sì ń ṣe ohun ìríra.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń fi owó ya ni pẹ̀lú èlé, ó sì tún ń gba èlé tó pọ̀jù.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 18:13"
      },
      "items": [
        {
          "text": "Ǹjẹ́ irú ọkùnrin yìí wa le è yè bí? Òun kì yóò wá láààyè! Nítorí pé òun ti ṣe àwọn ohun ìríra yìí, kíkú ni yóò kú, ẹ̀jẹ̀ rẹ yóò sì wá lórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ọkùnrin yìí bá bímọ ọkùnrin, tó sì rí gbogbo ẹ̀ṣẹ̀ ti baba rẹ ń ṣẹ̀ yìí, tó sì bẹ̀rù, ti kò ṣe irú rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tí kò jẹun lójúbọ lórí òkè gíga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:15"
      },
      "items": [
        {
          "text": "tàbí kò gbójú sókè sí àwọn òrìṣà ilé Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:15"
      },
      "items": [
        {
          "text": "tí kò sì ba obìnrin aládùúgbò rẹ̀ jẹ́",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí kò sì ni ẹnikẹ́ni lára,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "tí kò dá ohun ògo dúró",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "tí kò gba èlé tàbí kò fipá jalè",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "ṣùgbọ́n tí ó ń fún ẹni tébi ń pa lóúnjẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "tó sì fi aṣọ bo àwọn oníhòhò.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń yọ ọwọ́ rẹ kúrò nínú ẹ̀ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "kò sì gba èlé tàbí èlé tó pọ̀jù,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "tí ó ń pa òfin mi mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "tí ó sì ń tẹ̀lé àwọn àṣẹ mi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "Kò ní kú fún ẹ̀ṣẹ̀ baba rẹ̀, nítòótọ́ ní yóò yè!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n baba rẹ̀ ni yóò kú fún ẹ̀ṣẹ̀ ara rẹ̀, nítorí pé ó jẹ́ arẹ́nijẹ, ó jalè arákùnrin rẹ, ó ṣe ohun tí kò dára láàrín àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Síbẹ̀, ẹ tún ń béèrè pé, 'Kí ló dé ti ọmọ kò fi ní í ru ẹ̀bi baba rẹ̀?' Níwọ́n ìgbà tí ọmọ ti ṣe ohun tó tọ́, tó sì yẹ, tó sì ti kíyèsi ara láti pa gbogbo àṣẹ mi mọ́, nítòótọ́ ni pé yóò yè.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.19",
            "verseOrgIds": [
              "EZK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn tí ó bá ṣẹ̀ ní yóò kú. Ọmọ kò ní í ru ẹ̀bi baba rẹ̀, bẹ́ẹ̀ ni baba náà kò ní ru ẹ̀bi ọmọ rẹ̀. Ìwà rere ènìyàn rere yóò wà lórí rẹ̀, ìwà búburú ti ènìyàn búburú náà la ó kà sí i lọ́rùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n bí ènìyàn búburú bá yípadà kúrò nínú gbogbo ẹ̀ṣẹ̀ rẹ̀ tó ti dá, tó sì bẹ̀rẹ̀ sí í pa àṣẹ mi mọ́, tó sì ń ṣe ohun tó tọ́ àti ohun tó yẹ, nítòótọ́ ni yóò yè, kò sì ní kú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.21",
            "verseOrgIds": [
              "EZK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kò sì ní rántí gbogbo ẹ̀ṣẹ̀ rẹ tó ti dá tẹ́lẹ̀ láti kà á sí lọ́rùn nítorí tí ìwà òdodo rẹ tó fihàn, yóò yè.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.22",
            "verseOrgIds": [
              "EZK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ èmi ha ni inú dídùn si ikú ènìyàn búburú bí í? Ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
              "EZK.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.18.23",
                "verseOrgIds": [
                  "EZK.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí pé, dípò èyí inú mi kò ha ni i dùn nígbà tó ba yípadà kúrò ni àwọn ọ̀nà búburú rẹ̀ kí ó sì yè?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
              "EZK.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n bí ènìyàn rere bá yípadà kúrò ni ọ̀nà òdodo rẹ̀ tó sì ń dẹ́ṣẹ̀, tí ó sì tún ń ṣe àwọn ohun ìríra tí ènìyàn búburú ń ṣe, yóò wa yè bí? A kì yóò rántí ọ̀kankan nínú ìwà rere rẹ̀ mọ́, nítorí ó ti jẹ̀bi ìwà àrékérekè àti ẹ̀ṣẹ̀ tó dá, yóò sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.24",
            "verseOrgIds": [
              "EZK.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bẹ́ẹ̀ ni, ẹ̀yin tún wí pé, 'Ọ̀nà Olúwa kò gún.' Gbọ́ nísinsin yìí, ìwọ ilé Israẹli. Ọ̀nà mi ni kò ha gún? Kì í wa ṣé pé ọ̀nà tiyín gan an ni kò gún?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.25",
            "verseOrgIds": [
              "EZK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí olódodo ba yípadà kúrò nínú olódodo rẹ̀, tó sì dẹ́ṣẹ̀, yóò ku fún ẹ̀ṣẹ̀ rẹ̀, yóò kú nítorí ẹ̀ṣẹ̀ tó ti dá.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.26",
            "verseOrgIds": [
              "EZK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bi ènìyàn búburú bá yípadà kúrò nínú ìwà búburú tó ti ṣe, tó sì ṣe ohun tó tọ́ àti ohun tó yẹ, yóò gba ẹ̀mí rẹ̀ là.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.27",
            "verseOrgIds": [
              "EZK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ó ronú lórí gbogbo ẹ̀ṣẹ̀ tó ti dá, ó sì yípadà kúrò nínú wọn, nítòótọ́ ni yóò yè; kì yóò sí kú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
            "verseOrgIds": [
              "EZK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀, ilé Israẹli wí pé, 'Ọ̀nà Olúwa kò gún.' Ọ̀nà mi kò ha tọ́ bí ilé Israẹli? Kì í wa ṣe pè ọ̀nà tiyín gan an ni ko gún?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.29",
            "verseOrgIds": [
              "EZK.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, ilé Israẹli, èmi yóò da yín lẹ́jọ́, gẹ́gẹ́ bí ọ̀nà ẹnìkọ̀ọ̀kan yín bá ṣe rí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.30",
            "verseOrgIds": [
              "EZK.18.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.18.30",
                "verseOrgIds": [
                  "EZK.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí. Ẹ yípadà! Kí ẹ si yí kúrò nínú gbogbo ẹ̀ṣẹ̀ yín, bẹ́ẹ̀ ni ìrékọjá kì yóò jẹ́ ọ̀nà ìṣubú yín.",
          "type": "text",
