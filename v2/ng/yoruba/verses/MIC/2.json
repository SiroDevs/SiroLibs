  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MIC 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Èrò ènìyàn àti ti Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ni fún àwọn tí ń gbèrò àìṣedéédéé",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "tí wọ́n sì ń ṣiṣẹ́ ibi lórí ibùsùn wọn!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "Nígbà tí ojúmọ́ bá mọ́, wọn yóò gbé e jáde",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "nítorí ó wà ní agbára wọn láti ṣe é.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ń ṣe ojúkòkòrò oko, wọ́n sì fi agbára wọn gbà wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "àti àwọn ilé, wọ́n sì gbà wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "Wọ́n sì ni ènìyàn àti ilẹ̀ rẹ̀ lára",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "àní ènìyàn àti ohun ìní rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.3",
                "verseOrgIds": [
                  "MIC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "\"Èmi ń gbèrò ibi sí àwọn ìdílé wọ̀nyí,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "nínú èyí tí wọn kì yóò le è gba ara wọn là.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "Ìwọ kì yóò sì lè máa rìn ní ìgbéraga mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "nítorí yóò jẹ́ àkókò ibi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni ẹnìkan yóò pa òwe kan sí yín;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "wọn yóò sì pohùnréré ẹkún kíkorò pé:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "'Ní kíkó a ti kó wọn tán;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.4",
                "verseOrgIds": [
                  "MIC.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pín ohun ìní àwọn ènìyàn mi;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "Ó ti mú un kúrò lọ́dọ̀ mi!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "Ó fi oko wa lé àwọn ọlọ̀tẹ̀ lọ́wọ́.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ìwọ kò ní ní ẹnìkankan tí yóò ta okùn nínú ìjọ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.5",
                "verseOrgIds": [
                  "MIC.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:5"
      },
      "items": [
        {
          "text": "tí yóò pín ilẹ̀ nípa ìbò.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn wòlíì èké",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ má ṣe sọtẹ́lẹ̀,\" ni àwọn wòlíì wọn wí.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:6"
      },
      "items": [
        {
          "text": "\"Ẹ má ṣe sọtẹ́lẹ̀ nípa nǹkan wọ̀nyí;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:6"
      },
      "items": [
        {
          "text": "kí ìtìjú má ṣe le bá wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé kí á sọ ọ́, ìwọ ilé Jakọbu:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "\"Ǹjẹ́ ẹ̀mí",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.7",
                "verseOrgIds": [
                  "MIC.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ha ń bínú bí?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "Ǹjẹ́ iṣẹ́ rẹ ha nìwọ̀nyí?\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MIC 2:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "\"Ǹjẹ́ ọ̀rọ̀ mi kò ha ń ṣe rere",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "fún ẹni tí ń rìn déédé bí?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láìpẹ́ àwọn ènìyàn mi dìde",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "bí ọ̀tá sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "Ìwọ bọ́ aṣọ ọlọ́rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "kúrò lára àwọn tí ń kọjá lọ ní àìléwu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "bí àwọn ẹni tí ó padà bọ̀ láti ojú ogun.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin sì lé obìnrin àwọn ènìyàn mi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "kúrò nínú ilé ayọ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "ẹ̀yin sì ti gba ògo mi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "kúrò lọ́wọ́ àwọn ọmọ wọn láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ dìde, kí ẹ sì máa lọ!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:10"
      },
      "items": [
        {
          "text": "Nítorí èyí kì í ṣe ibi ìsinmi yín,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:10"
      },
      "items": [
        {
          "text": "nítorí tí a ti sọ ọ́ di àìmọ́",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:10"
      },
      "items": [
        {
          "text": "yóò pa yín run,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:10"
      },
      "items": [
        {
          "text": "àní ìparun kíkorò.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí òpùrọ́ àti ẹlẹ́tàn bá wà tí wọ́n sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.11",
            "verseOrgIds": [
              "MIC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:11"
      },
      "items": [
        {
          "text": "'Èmi yóò sọtẹ́lẹ̀ fún ọ nípa ọ̀pọ̀lọpọ̀ wáìnì àti ọtí líle,'",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.11",
            "verseOrgIds": [
              "MIC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:11"
      },
      "items": [
        {
          "text": "òun ni yóò tilẹ̀ ṣe wòlíì àwọn ènìyàn wọ̀nyí!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.11",
            "verseOrgIds": [
              "MIC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìlérí ìgbàlà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi yóò kó gbogbo yín jọ, ìwọ Jakọbu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "Èmi yóò gbá ìyókù Israẹli jọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "Èmi yóò kó wọn jọ pọ̀ gẹ́gẹ́ bí àgùntàn nínú agbo ẹran,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọ̀wọ́ ẹran nínú agbo wọn,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "ibẹ̀ yóò sì pariwo nítorí ọ̀pọ̀ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ń fọ ọ̀nà yóò lọ sókè níwájú wọn;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:13"
      },
      "items": [
        {
          "text": "wọn yóò fọ láti ẹnu ibodè, wọn yóò sì jáde lọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:13"
      },
      "items": [
        {
          "text": "Àwọn ọba wọn yóò sì kọjá lọ níwájú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.13",
                "verseOrgIds": [
                  "MIC.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ni yóò sì ṣe olórí wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
