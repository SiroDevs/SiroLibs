      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:13"
      },
      "items": [
        {
          "text": "àti àwọn àfẹ́sọ́nà yín yóò ṣe àgbèrè.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.13",
            "verseOrgIds": [
              "HOS.4.13"
            ]
          }
        }
      ]
    },
