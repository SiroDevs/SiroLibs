      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:14"
      },
      "items": [
        {
          "text": "Wọ́n sì ń rú ẹbọ pẹ̀lú àwọn alágbèrè ojúbọ òrìṣà.",
