      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:13"
      },
      "items": [
        {
          "text": "wọ́n sì ń sun ọrẹ tùràrí lórí àwọn òkè kékeré,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.13",
            "verseOrgIds": [
              "HOS.4.13"
            ]
          }
