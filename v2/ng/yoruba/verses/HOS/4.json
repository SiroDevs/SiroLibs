      "attrs": {
        "style": "q2",
        "vid": "HOS 4:15"
      },
      "items": [
        {
          "text": "ìdájọ́ yìí wà fún un yín. Ẹ má ṣe jẹ́ kí Juda di ẹlẹ́bi.",
