              "attrs": {
                "verseId": "HOS.4.16",
                "verseOrgIds": [
                  "HOS.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe fẹ́ bọ́ wọn",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.16",
            "verseOrgIds": [
              "HOS.4.16"
            ]
