      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:14"
      },
      "items": [
        {
          "text": "ní yà nígbà tí wọ́n bá ṣe àgbèrè",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.14",
            "verseOrgIds": [
              "HOS.4.14"
            ]
          }
        }
