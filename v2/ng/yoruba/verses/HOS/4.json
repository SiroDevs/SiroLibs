                "verseId": "HOS.4.15",
                "verseOrgIds": [
                  "HOS.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wà láààyè nítòótọ́!'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.15",
            "verseOrgIds": [
              "HOS.4.15"
            ]
