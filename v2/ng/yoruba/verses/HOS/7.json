      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:16"
      },
      "items": [
        {
          "text": "ẹlẹ́yà ní ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
