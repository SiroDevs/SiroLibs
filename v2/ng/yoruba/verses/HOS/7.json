  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "HOS 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà tí èmi ìbá mú Israẹli láradá.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "Ẹ̀ṣẹ̀ Efraimu ń farahàn",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "ìwà búburú Samaria sì ń hàn síta.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "Wọ́n ń ṣe ẹ̀tàn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "àwọn olè ń fọ́ ilé;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "àwọn ọlọ́ṣà ń jalè ní òpópónà;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n wọn kò mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "mo rántí gbogbo ìwà búburú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "Ẹ̀ṣẹ̀ wọn gbé wọn mì pátápátá;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "wọ́n wà níwájú mi nígbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọ́n ń mú inú ọba dùn pẹ̀lú ìwà búburú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.3",
            "verseOrgIds": [
              "HOS.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:3"
      },
      "items": [
        {
          "text": "àti inú ọmọ-aládé dùn pẹ̀lú irọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.3",
            "verseOrgIds": [
              "HOS.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alágbèrè ni gbogbo wọn",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "wọ́n gbóná bí ààrò àkàrà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "tí a dáwọ́ kíkoná dúró,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "lẹ́yìn ìgbà tí o ti pò ìyẹ̀fun tán, títí ìgbà tí yóò wú.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ àjọ̀dún ọba wa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:5"
      },
      "items": [
        {
          "text": "wáìnì mú ara ọmọ-aládé gbóná",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:5"
      },
      "items": [
        {
          "text": "ó sì darapọ̀ mọ́ àwọn oníyẹ̀yẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn wọn ń gbóná bí i ààrò",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "wọ́n sì tọ̀ ọ́ lọ pẹ̀lú rìkíṣí,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "ìbínú wọn pa lọ́lọ́ ní gbogbo òru",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "ó sì bú jáde bí ọ̀wọ́-iná ní òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wọn gbóná bí ààrò",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "wọ́n pa gbogbo olórí wọn run,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "gbogbo ọba wọn si ṣubú",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "kò sì ṣí ẹnìkan nínú wọn tí ó ké pè mí.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Efraimu ti darapọ̀ mọ́ àwọn ènìyàn náà;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.8",
            "verseOrgIds": [
              "HOS.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:8"
      },
      "items": [
        {
          "text": "Efraimu jẹ́ àkàrà tí a kò yípadà.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.8",
            "verseOrgIds": [
              "HOS.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlejò ti jẹ agbára rẹ̀ run",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "ṣùgbọ́n kò sì mọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "Ewú ti wà ní orí rẹ̀ káàkiri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni kò kíyèsi i.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbéraga Israẹli ń jẹ́rìí sí i",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "ṣùgbọ́n pẹ̀lú gbogbo èyí",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "kò padà sí ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.7.10",
                "verseOrgIds": [
                  "HOS.7.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "Ọlọ́run, tàbí kí ó wá a.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Efraimu dàbí àdàbà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "tó rọrùn láti tànjẹ àti aláìgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "tó wá ń pé Ejibiti nísinsin yìí",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "tó sì tún ń padà lọ si Asiria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá lọ, èmi ó ta àwọ̀n mi sórí wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:12"
      },
      "items": [
        {
          "text": "Èmi ó fà wọ́n lulẹ̀ gẹ́gẹ́ bí ẹyẹ ojú ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:12"
      },
      "items": [
        {
          "text": "Nígbà tí mo bá gbọ́ pé wọ́n rìn pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:12"
      },
      "items": [
        {
          "text": "Èmi ó nà wọ́n fún iṣẹ́ búburú ọwọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ní fún wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:13"
      },
      "items": [
        {
          "text": "nítorí pé wọ́n ti yà kúrò lọ́dọ̀ mi!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:13"
      },
      "items": [
        {
          "text": "Ìparun wà lórí wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:13"
      },
      "items": [
        {
          "text": "nítorí pé wọ́n ti ṣọ̀tẹ̀ sí mi!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:13"
      },
      "items": [
        {
          "text": "Èmi fẹ́ láti rà wọ́n padà.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:13"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n wọ́n ń parọ́ mọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò kégbe pè mí láti ọkàn wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:14"
      },
      "items": [
        {
          "text": "ṣùgbọ́n wọ́n ń pohùnréré ẹkún lórí ibùsùn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:14"
      },
      "items": [
        {
          "text": "Wọ́n kó ara wọn jọ, nítorí ọkà àti wáìnì",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:14"
      },
      "items": [
        {
          "text": "ṣùgbọ́n wọ́n yípadà kúrò ní ọ̀dọ̀ mi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo kọ́ wọn, mo sì fún wọn ní agbára,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.15",
            "verseOrgIds": [
              "HOS.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:15"
      },
      "items": [
        {
          "text": "síbẹ̀ wọ́n tún ń dìtẹ̀ mọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.15",
            "verseOrgIds": [
              "HOS.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò padà sí ọ̀dọ̀ Ọ̀gá-ògo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:16"
      },
      "items": [
        {
          "text": "wọ́n dàbí ọfà tí ó ti bàjẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:16"
      },
      "items": [
        {
          "text": "Àwọn aṣíwájú wọn yóò ti ipa idà ṣubú",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:16"
      },
      "items": [
        {
          "text": "nítorí ìrunú ahọ́n wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:16"
      },
      "items": [
        {
          "text": "Torí èyí, wọn ó fi wọ́n ṣe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
      ]
    },
