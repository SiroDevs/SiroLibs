  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "GEN 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kọ́ọ̀bù idẹ nínú àpò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Josẹfu pàṣẹ fún ìránṣẹ́ rẹ̀ pé, \"Di oúnjẹ kún inú àpò àwọn ọkùnrin náà tó ìwọ̀n èyí tí wọ́n le rù, kí o sì mú owó olúkúlùkù àwọn ọkùnrin náà padà sí ẹnu àpò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.1",
            "verseOrgIds": [
              "GEN.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni kí o mú kọ́ọ̀bù idẹ mi sí ẹnu àpò èyí tí ó jẹ́ àbíkẹ́yìn nínú wọn pẹ̀lú owó tí ó fi ra ọkà,\" ó sì ṣe bí Josẹfu ti sọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.2",
            "verseOrgIds": [
              "GEN.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ilẹ̀ ti ń mọ́, wọ́n bẹ̀rẹ̀ ìrìnàjò wọn padà lọ pẹ̀lú kẹ́tẹ́kẹ́tẹ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.3",
            "verseOrgIds": [
              "GEN.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò tí ì rìn jìnnà sí ìlú náà tí Josẹfu fi wí fún ìránṣẹ́ rẹ̀ pé, \"Lépa àwọn ọkùnrin náà, nígbà tí o bá sì bá wọn, kí o wí pé, 'Èéṣe ti ẹ fi búburú san rere?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.4",
            "verseOrgIds": [
              "GEN.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ha kọ́ ni kọ́ọ̀bù tí olúwa mi ń lò fún ohun mímu tí ó sì tún ń fi í ṣe àyẹ̀wò? Ohun tí ẹ ṣe yìí burú púpọ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.5",
            "verseOrgIds": [
              "GEN.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì bá wọn, o sọ ọ̀rọ̀ wọ̀nyí fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.6",
            "verseOrgIds": [
              "GEN.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n dá a lóhùn pé, \"Kí ló dé tí olúwa mi sọ irú nǹkan wọ̀nyí? Ká má rí i! Àwọn ìránṣẹ́ rẹ kò le ṣe irú nǹkan bẹ́ẹ̀!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.7",
            "verseOrgIds": [
              "GEN.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tilẹ̀ mú owó tí a rí lẹ́nu àpò wa padà tọ̀ ọ́ wá láti ilẹ̀ Kenaani. Nítorí náà èéṣe tí àwa yóò fi jí wúrà tàbí idẹ ní ilé olúwa à rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.8",
            "verseOrgIds": [
              "GEN.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a bá rí i lọ́wọ́ èyíkéyìí nínú àwọn ìránṣẹ́ rẹ, kíkú ni yóò kú, àwọn tí ó kù yóò sì di ẹrú fún olúwa à rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.9",
            "verseOrgIds": [
              "GEN.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Ó dára, kí ó rí bí ẹ ti ṣe sọ. Ẹnikẹ́ni tí mo bá rí i lọ́wọ́ rẹ̀ yóò di ẹrú mi. Ẹ̀yin tí ó kù yóò sì wà láìlẹ́bi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.10",
            "verseOrgIds": [
              "GEN.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúkúlùkù wọn yára sọ àpò rẹ̀ kalẹ̀, wọ́n sì tú u.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.11",
            "verseOrgIds": [
              "GEN.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìránṣẹ́ náà bẹ̀rẹ̀ sí ní í wá a, bẹ̀rẹ̀ láti orí ẹ̀gbọ́n títí lọ sórí àbúrò pátápátá. Ó sì rí kọ́ọ̀bù náà nínú àpò ti Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.12",
            "verseOrgIds": [
              "GEN.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n rí èyí, wọ́n fa aṣọ wọn ya, wọ́n sì banújẹ́ gidigidi, wọn tún ẹrù wọn dì sórí kẹ́tẹ́kẹ́tẹ́, wọ́n sì padà sí inú ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.13",
            "verseOrgIds": [
              "GEN.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì wà nínú ilé nígbà tí Juda àti àwọn arákùnrin rẹ̀ wọlé wá. Gbogbo wọn sì wólẹ̀ níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.14",
            "verseOrgIds": [
              "GEN.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu wí fún wọn pé, \"Èwo ni èyí tí ẹ ṣe yìí? Ṣe ẹ kò mọ pé, ènìyàn bí èmi le è rí ìdí nǹkan nípa ṣíṣe àyẹ̀wò?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.15",
            "verseOrgIds": [
              "GEN.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda dáhùn pé, \"Kí ni à bá sọ fún olúwa mi? Báwo ni a ṣe lè wẹ ara wa mọ́? Ọlọ́run ti tú àṣírí ẹ̀ṣẹ̀ àwọn ìránṣẹ́ rẹ̀, a ti di ẹrú olúwa à mi báyìí àwa fúnra wa àti ẹni náà tí a rí kọ́ọ̀bù lọ́wọ́ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.16",
            "verseOrgIds": [
              "GEN.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Josẹfu dáhùn pé, \"Ká má rí i pé mo ṣe irú nǹkan bẹ́ẹ̀! Ẹni tí a bá kọ́ọ̀bù mi lọ́wọ́ rẹ̀ nìkan ni yóò di ẹrú mi, ẹ̀yin tí ó kù, ẹ máa lọ sọ́dọ̀ baba yín ní àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
              "GEN.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Juda súnmọ́ ọ̀dọ̀ rẹ̀, ó sì wí pé, \"Jọ̀wọ́ olúwa mi, jẹ́ kí ìránṣẹ́ rẹ kí ó sọ ọ̀rọ̀ kan fún olúwa mi, má ṣe bínú sí ìránṣẹ́ rẹ bí ó tilẹ̀ jẹ́ wí pé ìwọ pẹ̀lú láṣẹ bí i ti Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.18",
            "verseOrgIds": [
              "GEN.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúwa mi béèrè lọ́wọ́ àwọn ìránṣẹ́ rẹ̀ pé, 'Ǹjẹ́ ó ní baba tàbí arákùnrin?'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.19",
            "verseOrgIds": [
              "GEN.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa sì wí fún olúwa mi pé, 'A ni baba tí ó ti darúgbó, ọmọkùnrin kan sì wà pẹ̀lú tí a bí fún un ní ọjọ́ ogbó rẹ̀. Ẹ̀gbọ́n rẹ̀ ti kú, òun nìkan sì ni ó kù nínú àwọn ọmọ ìyá rẹ̀, baba rẹ̀ sì fẹ́ràn án rẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.20",
            "verseOrgIds": [
              "GEN.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà náà ni ó sọ fún àwọn ìránṣẹ́ rẹ̀ pé, 'Ẹ mu un tọ̀ mí wá kí n le fojú ara mi rí i.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.21",
            "verseOrgIds": [
              "GEN.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì sọ fún olúwa à mi pé, 'Ọmọkùnrin náà kò le è fi baba rẹ̀ sílẹ̀, bí ó bá dán an wò baba rẹ̀ yóò kú.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.22",
            "verseOrgIds": [
              "GEN.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ wí fún àwọn ìránṣẹ́ rẹ̀ pé, 'Ẹ má ṣe padà tọ̀ mí wá àyàfi bí àbíkẹ́yìn yín bá bá yín wá.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.23",
            "verseOrgIds": [
              "GEN.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a padà lọ sọ́dọ̀ baba wa, tí í ṣe ìránṣẹ́ rẹ, a sọ ohun tí olúwa à mi wí fún un.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.24",
            "verseOrgIds": [
              "GEN.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà náà ni baba wa wí pé, 'Ẹ padà lọ láti lọ ra oúnjẹ díẹ̀ wá.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.25",
            "verseOrgIds": [
              "GEN.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n a wí pe, 'Àwa kò le è padà lọ, àyàfi bí àbúrò wa pátápátá yóò bá bá wa lọ. A kò le è rí ojú ọkùnrin náà àyàfi tí àbúrò wa bá lọ pẹ̀lú wa.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.26",
            "verseOrgIds": [
              "GEN.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba mi, ìránṣẹ́ rẹ wí fún wa pé, 'Ẹ mọ̀ pé ìyàwó mi bí ọmọkùnrin méjì fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.27",
            "verseOrgIds": [
              "GEN.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kan nínú wọn lọ kúrò lọ́dọ̀ mi, mo sì wí pé, \"Dájúdájú a ti fà á ya pẹ́rẹpẹ̀rẹ.\" N kò sì tí ì ri láti ọjọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.28",
            "verseOrgIds": [
              "GEN.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ẹ bá tún mú èyí lọ, kúrò lọ́dọ̀ mi, tí ohunkóhun bá ṣe é, ìbànújẹ́ ni ẹ ó fi mú ewú orí mi lọ sí ipò òkú.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, bí a bá padà tọ baba wa lọ láìsí ọmọ náà pẹ̀lú wa nígbà tí a mọ̀ pé, ọmọ náà ni ẹ̀mí baba wa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ó bá ri pé ọmọkùnrin náà kò wá pẹ̀lú wa, yóò kùú. Àwọn ìránṣẹ́ rẹ yóò wá mú baba wa tòun ti ewú orí lọ sí ipò òkú ní ìbànújẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 44:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ rẹ ló ṣe onídùúró fún ààbò ọmọ náà lọ́dọ̀ baba mi. Mo wí pé, 'Bí n kò bá mú un padà tọ̀ ọ́ wá, baba mi, èmi ó ru ẹ̀bi rẹ̀ ní gbogbo ọjọ́ ayé mi!'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 44:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, jẹ́ kí ìránṣẹ́ rẹ kí ó dúró ní ìhín lọ́dọ̀ olúwa à mi bí ẹrú dípò ọmọ náà. Kí ọmọ náà bá àwọn arákùnrin rẹ̀ padà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 44:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni mo ṣe lè padà tọ baba mi lọ láì bá ṣe pé ọmọ náà wà pẹ̀lú mi? Rárá, èmi kò fẹ́ kí n rí ìbànújẹ́ tí yóò dé bá baba mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.34",
            "verseOrgIds": [
              "GEN.44.34"
            ]
          }
        }
      ]
    }
