  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "GEN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkún omi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ènìyàn bẹ̀rẹ̀ sí ní pọ̀ si ní orí ilẹ̀, wọ́n sí bí àwọn ọmọbìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Ọlọ́run rí i wí pé àwọn ọmọbìnrin ènìyàn lẹ́wà, wọ́n sì fẹ́ èyíkéyìí tí ó wù wọ́n ṣe aya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.3",
                "verseOrgIds": [
                  "GEN.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Èémí ìyè tí mo mí sínú ènìyàn kò ní máa gbé inú ènìyàn títí láé, nítorí ẹran-ara sá à ni òun, ọgọ́fà ọdún ni ọjọ́ rẹ̀ yóò jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn òmíràn wà láyé ní ọjọ́ wọ̀n-ọn-nì, àti lẹ́yìn ìgbà náà; nígbà tí àwọn ọmọ Ọlọ́run lọ bá àwọn ọmọbìnrin ènìyàn lòpọ̀ tí wọ́n sì bímọ fún wọn. Àwọn náà ni ó di akọni àti olókìkí ìgbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.5",
                "verseOrgIds": [
                  "GEN.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì rí bí ìwà búburú ènìyàn ti ń gbilẹ̀ si, àti pé gbogbo èrò inú rẹ̀ kìkì ibi ni, ní ìgbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.6",
                "verseOrgIds": [
                  "GEN.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bàjẹ́ gidigidi nítorí pé ó dá ènìyàn sí ayé, ọkàn rẹ̀ sì gbọgbẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.7",
                "verseOrgIds": [
                  "GEN.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Èmi yóò pa ènìyàn tí mo ti dá run kúrò lórí ilẹ̀, ènìyàn àti ẹranko, àti ohun tí ń rákò, àti ẹyẹ ojú ọ̀run, nítorí inú mi bàjẹ́ pé mo ti dá wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, Noa rí ojúrere",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.6.8",
                "verseOrgIds": [
                  "GEN.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Noa àti ìkún omi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni ìtàn Noa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 6:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 6:9"
      },
      "items": [
        {
          "text": "Noa nìkan ni ó jẹ́ olóòótọ́ ènìyàn àti ẹni tí ó pé ní ìgbà ayé rẹ̀, ó sì fi òtítọ́ bá Ọlọ́run rìn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa sì bí ọmọkùnrin mẹ́ta, Ṣemu, Hamu àti Jafeti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.10",
            "verseOrgIds": [
              "GEN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayé sì kún fún ìbàjẹ́ gidigidi ní ojú Ọlọ́run, ó sì kún fún ìwà ipá pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.11",
            "verseOrgIds": [
              "GEN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì rí bí ayé ti bàjẹ́ tó, nítorí àwọn ènìyàn inú ayé ti bá ara wọn jẹ́ ní gbogbo ọ̀nà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì wí fún Noa pé, \"Èmi yóò pa gbogbo ènìyàn run, nítorí ilẹ̀ ayé kún fún ìwà ipá nípasẹ̀ wọn. Èmi yóò pa wọ́n run àti ayé pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà fi igi ọ̀mọ̀ kan ọkọ̀, kí o sì yọ yàrá sí inú rẹ̀, kí o sì fi ọ̀dà ilẹ̀ rẹ́ ẹ tinú-tẹ̀yìn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni ìwọ yóò ṣe kan ọkọ̀ náà: Gígùn rẹ̀ ní òró yóò jẹ́ ọ̀ọ́dúnrún (300) ìgbọ̀nwọ́, ìbú rẹ̀ yóò jẹ́ àádọ́ta ìgbọ̀nwọ́, nígbà tí gíga rẹ̀ yóò jẹ́ ọgbọ̀n ìgbọ̀nwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe òrùlé sí orí ọkọ̀ náà ní ìgbọ̀nwọ́ kan, sì ṣe ọkọ̀ náà ní alájà mẹ́ta, ipá kan ní ìsàlẹ̀, ọ̀kan ní àárín àti ọ̀kan tí ó kù ní òkè, ẹ̀gbẹ́ ni kí ó ṣe ẹnu-ọ̀nà ọkọ̀ náà sí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú ìkún omi wá sí ayé láti pa gbogbo ohun ẹlẹ́mìí run lábẹ́ ọ̀run. Gbogbo ẹ̀dá tí ó ní èémí ìyè ní inú. Gbogbo ohun tí ó wà nínú ayé yóò parun.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi ó dá májẹ̀mú mi pẹ̀lú rẹ, ìwọ yóò sì wọ ọkọ̀, ìwọ àti àwọn ọmọ rẹ pẹ̀lú aya rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò mú gbogbo ohun alààyè takọ tabo wá sí inú ọkọ̀, kí wọn le wà láààyè pẹ̀lú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú onírúurú àwọn ẹyẹ, ẹranko àti àwọn ohun tí ń rákò ní méjì méjì, kí a bá lè pa wọ́n mọ́ láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú onírúurú oúnjẹ wá sínú ọkọ̀, kí o pa wọ́n mọ́ fún jíjẹ gbogbo ẹ̀yin tí ẹ wà nínú ọkọ̀ àti ènìyàn àti ẹranko.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa sì ṣe ohun gbogbo bí Ọlọ́run ti pàṣẹ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.22",
            "verseOrgIds": [
              "GEN.6.22"
            ]
          }
        }
      ]
    }
  ],
