  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "GEN 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àlá Josẹfu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì gbé ilẹ̀ Kenaani ní ibi ti baba rẹ̀ ti gbé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.1",
            "verseOrgIds": [
              "GEN.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni àwọn ìtàn Jakọbu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 37:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:2"
      },
      "items": [
        {
          "text": "Nígbà tí Josẹfu di ọmọ ọdún mẹ́tàdínlógún, ó ń ṣọ́ agbo ẹran pẹ̀lú àwọn arákùnrin rẹ̀, àwọn ọmọ Biliha àti Silipa aya baba rẹ̀ Josẹfu sì ń ròyìn àwọn aburú tí wọ́n ń ṣe fún baba wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli sì fẹ́ràn Josẹfu ju gbogbo àwọn ọmọ rẹ̀ tókù lọ, nítorí ní ọjọ́ ogbó rẹ̀ ni ó bí i. O sì dá aṣọ aláràbarà tí ó kún fún onírúurú ọnà lára fún un.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.3",
            "verseOrgIds": [
              "GEN.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn arákùnrin rẹ̀ rí i pé baba àwọn fẹ́ràn rẹ̀ ju gbogbo wọn lọ, wọ́n kórìíra rẹ̀, wọ́n sì ń fi ẹ̀tanú bá a gbé, kò sì sí àlàáfíà láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.4",
            "verseOrgIds": [
              "GEN.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu lá àlá kan, nígbà tí ó sì sọ fún àwọn arákùnrin rẹ̀, wọ́n túbọ̀ kórìíra rẹ̀ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.5",
            "verseOrgIds": [
              "GEN.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wí fún wọn pé, \"Ẹ fetí sí àlá tí mo lá,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.6",
            "verseOrgIds": [
              "GEN.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "sá à wò ó, àwa ń yí ìtí ọkà nínú oko, ó sì ṣe ìtí ọkà tèmi sì dìde dúró ṣánṣán, àwọn ìtí ọkà tiyín sì dúró yí ìtí tèmi ká, wọ́n sì ń foríbalẹ̀ fún un.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.7",
            "verseOrgIds": [
              "GEN.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin rẹ̀ wí fún un pé, \"Ìwọ ń gbèrò àti jẹ ọba lé wa lórí bí? Tàbí ìwọ ó ṣe olórí wa nítòótọ́?\" Wọn sì túbọ̀ kórìíra rẹ̀ sí i, nítorí àlá rẹ̀ àti nítorí ohun tí ó wí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.8",
            "verseOrgIds": [
              "GEN.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sì tún lá àlá mìíràn, ó sì tún sọ ọ́ fún àwọn arákùnrin rẹ̀. Ó wí pé, ẹ tẹ́tí sí mi, \"Mo tún lá àlá mìíràn, wò ó, oòrùn, òṣùpá àti ìràwọ̀ mọ́kànlá ń foríbalẹ̀ fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.9",
            "verseOrgIds": [
              "GEN.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sọ fún baba rẹ̀ àti àwọn arákùnrin rẹ̀ pẹ̀lú, baba rẹ̀ bá a wí pé, \"Irú àlá wo ni ìwọ lá yìí? Ṣé ìyá rẹ, pẹ̀lú èmi àti àwọn ẹ̀gbọ́n rẹ yóò wá foríbalẹ̀ níwájú rẹ ni?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.10",
            "verseOrgIds": [
              "GEN.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin rẹ̀ sì ń ṣe ìlara rẹ̀ ṣùgbọ́n baba rẹ̀ pa ọ̀rọ̀ náà mọ́ lọ́kàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.11",
            "verseOrgIds": [
              "GEN.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn arákùnrin Josẹfu tà á",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin rẹ̀ sì da ẹran baba wọn lọ sí Ṣekemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.12",
            "verseOrgIds": [
              "GEN.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli sì wí fún Josẹfu pé, \"Ṣé o mọ̀ pé, àwọn arákùnrin rẹ ń da ẹran ní Ṣekemu, wá, jẹ́ kí n rán ọ sí wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:13"
      },
      "items": [
        {
          "text": "Josẹfu sì dáhùn pé, \"Èmi nìyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sì wí fún un pé, \"Lọ wò bí àwọn arákùnrin rẹ àti àwọn agbo ẹran bá wà ní àlàáfíà, kí o sì wá jíṣẹ́ fún mi.\" Ó sì rán Josẹfu lọ láti àfonífojì Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:14"
      },
      "items": [
        {
          "text": "Nígbà tí Josẹfu dé Ṣekemu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọkùnrin kan sì rí i tí ó ń rìn kiri inú pápá, ó sì bi í pé, \"Kín ni ò ń wá?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.15",
            "verseOrgIds": [
              "GEN.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dáhùn pé, \"Àwọn arákùnrin mi ni mò ń wá, ǹjẹ́ o mọ ibi tí wọ́n wà pẹ̀lú agbo ẹran?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.16",
            "verseOrgIds": [
              "GEN.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà dáhùn pé, \"Wọ́n ti kúrò ní ìhín, mo gbọ́ tí wọ́n ń wí pé, 'Ẹ jẹ́ kí a lọ sí Dotani.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:17"
      },
      "items": [
        {
          "text": "Josẹfu sì wá àwọn arákùnrin rẹ̀ lọ, ó sì rí wọn ní tòsí Dotani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí wọ́n sì ti rí i tí ń bọ̀ lókèèrè, kí ó sì tó dé ọ̀dọ̀ wọn, wọn gbìmọ̀ pọ̀ láti pa á.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.18",
            "verseOrgIds": [
              "GEN.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Alálàá ni ń bọ̀ yìí,\" ni wọ́n ń wí fún ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.19",
            "verseOrgIds": [
              "GEN.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ wá, ẹ jẹ́ kí a pa á. Kí a sì ju òkú rẹ̀ sínú kòtò, a ó sì wí pé, ẹranko búburú ni ó pa á, kí a máa wo ọ̀nà tí àlá rẹ̀ yóò gbà ṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.20",
            "verseOrgIds": [
              "GEN.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Reubeni gbọ́ èyí, ó gbìyànjú láti gbà á sílẹ̀ ní ọwọ́ wọn, ó sì wí pé, \"Ẹ má ṣe jẹ́ kí a gba ẹ̀mí rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.21",
            "verseOrgIds": [
              "GEN.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹ má ṣe jẹ́ kí a ta ẹ̀jẹ̀ sílẹ̀, ẹ má ṣe fọwọ́ kàn án, ẹ kúkú jù ú sínú kòtò láààyè nínú aginjù níbí.\" Reubeni sọ èyí, kí ó ba à le gbà á kúrò lọ́wọ́ wọn, kí ó sì dá a padà lọ fún baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.22",
            "verseOrgIds": [
              "GEN.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, nígbà tí Josẹfu dé ọ̀dọ̀ àwọn arákùnrin rẹ̀, wọ́n bọ́ ẹ̀wù rẹ̀—Ẹ̀wù ọlọ́nà, aláràbarà tí ó wọ̀—",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.23",
            "verseOrgIds": [
              "GEN.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n mú un, wọ́n sì jù ú sínú kòtò. Kòtò náà sì ṣófo, kò sí omi nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n sì ti jókòó láti jẹun, wọ́n gbójú sókè, wọ́n sì rí àwọn oníṣòwò ará Iṣmaeli tí wọ́n ń wọ́ bọ̀ láti Gileadi. Ìbákasẹ wọn sì ru tùràrí, ìkunra àti òjìá, wọ́n ń lọ sí Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.25",
            "verseOrgIds": [
              "GEN.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda wí fún àwọn arákùnrin rẹ̀ pé, \"Èrè kí ni ó jẹ́ bí a bá pa arákùnrin wa tí a bo ẹ̀jẹ̀ rẹ̀ mọ́lẹ̀ ti ọkàn wa sì ń dá wa lẹ́bi?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
            "verseOrgIds": [
              "GEN.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wá, ẹ jẹ́ kí á tà á fún àwọn ará Iṣmaeli, kí àwa má sì pa á, ṣè bí àbúrò wa ni, ẹran-ara wa àti ẹ̀jẹ̀ wa ní i ṣe.\" Àwọn arákùnrin rẹ̀ sì fi ara mọ́ ohun tí ó sọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.27",
            "verseOrgIds": [
              "GEN.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, nígbà tí àwọn oníṣòwò ara Midiani ń kọjá, àwọn arákùnrin Josẹfu fà á jáde láti inú kòtò, wọ́n sì tà á fún àwọn ará Iṣmaeli ní ogún owó wúrà, wọ́n sì mú Josẹfu lọ sí ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Reubeni padà dé ibi kòtò tí ó sì ri pé Josẹfu kò sí níbẹ̀ mọ́, ó fa aṣọ rẹ̀ ya pẹ̀lú ìbànújẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó padà lọ sí ọ̀dọ̀ àwọn arákùnrin rẹ̀, ó sì wí pé, \"Ọmọdékùnrin náà kò sí níbẹ̀ mọ́! Níbo ni ẹ fẹ́ kí n wọ̀ báyìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n mú aṣọ Josẹfu, wọ́n pa ewúrẹ́ kan, wọ́n sì tẹ aṣọ náà bọ inú ẹ̀jẹ̀ ewúrẹ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì mú aṣọ ọlọ́nà aláràbarà náà padà sí ọ̀dọ̀ baba wọn, wọ́n sì wí pé, \"A rí èyí he nínú oko, yẹ̀ ẹ́ wò, kí o sì mọ̀ bóyá ti ọmọ rẹ ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dá a mọ̀, ó wí pé, \"Háà! Aṣọ ọmọ mi ni, ẹranko búburú ti pa á jẹ, láìṣe àní àní, ó ti fa Josẹfu ya pẹ́rẹpẹ̀rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jakọbu fa aṣọ rẹ̀ ya, ó sì wọ aṣọ ọ̀fọ̀, ó sì ṣọ̀fọ̀ ọmọ rẹ̀ fún ọ̀pọ̀lọpọ̀ ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọmọ rẹ̀ lọ́kùnrin, lóbìnrin wá láti tù ú nínú, ṣùgbọ́n kò gbà. Ó wí pé, \"Rárá, nínú ọ̀fọ̀ yìí ni èmi yóò lọ sí isà òkú lọ́dọ̀ ọmọ mi.\" Baba Josẹfu sì sọkún fún un.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo àkókò wọ̀nyí, àwọn ará Midiani ta Josẹfu ní Ejibiti fún Potifari, ọ̀kan nínú àwọn ìjòyè Farao, tí í ṣe olórí ẹ̀ṣọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
      ]
    }
  ],
