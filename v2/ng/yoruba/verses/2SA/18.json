  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n pàdé ogun ní igbó Efraimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì ka àwọn ènìyàn tí ń bẹ lọ́dọ̀ rẹ̀, ó sì mú wọn jẹ balógun ẹgbẹẹgbẹ̀rún, àti balógun ọ̀rọ̀ọ̀rún lórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.1",
            "verseOrgIds": [
              "2SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì fi ìdámẹ́ta àwọn ènìyàn náà lé Joabu lọ́wọ́, ó sì rán wọn lọ, àti ìdámẹ́ta lé Abiṣai ọmọ Seruiah àbúrò Joabu lọ́wọ́ àti ìdámẹ́ta lè Ittai ará Gitti lọ́wọ́, ọba sì wí fún àwọn ènìyàn náà pé, \"Nítòótọ́ èmi tìkára mi yóò sì bá yín lọ pẹ̀lú.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.2",
            "verseOrgIds": [
              "2SA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn náà sì wí pé, \"Ìwọ kì yóò bá wa lọ, nítorí pé bí àwa bá sá, wọn kì yóò náání wa, tàbí bí ó tilẹ̀ ṣe pé ìdajì wa kú, wọn kì yóò náání wa, nítorí pé ìwọ nìkan tó ẹgbẹ̀rún mẹ́wàá (10,000) wa. Nítorí náà, ó sì dára kí ìwọ máa ràn wá lọ́wọ́ láti ìlú wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún wọn pé, \"Èyí tí ó bá tọ́ lójú yin ni èmi ó ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:4"
      },
      "items": [
        {
          "text": "Ọba sì dúró ní apá kan ẹnu odi, gbogbo àwọn ènìyàn náà sì jáde ní ọ̀rọ̀ọ̀rún àti ní ẹgbẹẹgbẹ̀rún.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì pàṣẹ fún Joabu àti Abiṣai àti Ittai pé, \"Ẹ tọ́jú ọ̀dọ́mọkùnrin náà Absalomu fún mi.\" Gbogbo àwọn ènìyàn náà sì gbọ́ nígbà tí ọba pàṣẹ fún gbogbo àwọn balógun nítorí Absalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn náà sì jáde láti pàdé Israẹli ní pápá; ní igbó Efraimu ni wọ́n gbé pàdé ìjà náà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni a gbé pa àwọn ènìyàn Israẹli níwájú àwọn ìránṣẹ́ Dafidi, ọ̀pọ̀lọpọ̀ ènìyàn ni ó ṣubú lọ́jọ́ náà, àní ogún ẹgbẹ̀rún (20,000) ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun náà sì fọ́n káàkiri lórí gbogbo ilẹ̀ náà, igbó náà sì pa ọ̀pọ̀ ènìyàn ju èyí tí idà pa lọ lọ́jọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joabu sì kọlu Absalomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalomu sì pàdé àwọn ìránṣẹ́ Dafidi. Absalomu sì gun orí ìbáaka kan, ìbáaka náà sì gba abẹ́ ẹ̀ka ńlá igi óákù kan tí ó tóbi lọ, orí rẹ̀ sì kọ́ igi óákù náà òun sì rọ̀ sókè ní agbede-méjì ọ̀run àti ilẹ̀; ìbáaka náà tí ó wà lábẹ́ rẹ̀ sì lọ kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin kan sì rí i, ó sì wí fún Joabu pé, \"Wò ó, èmi rí Absalomu so rọ̀ láàrín igi óákù kan.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì wí fún ọkùnrin náà tí ó sọ fún un pé, \"Sá wò ó, ìwọ rí i, èéha ti ṣe tí ìwọ kò fi lù ú bolẹ̀ níbẹ̀? Èmi ìbá sì fún ọ ní ṣékélì fàdákà mẹ́wàá, àti àmùrè kan.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà sì wí fún Joabu pé, \"Bí èmi tilẹ̀ gba ẹgbẹ̀rún (1,000) ṣékélì fàdákà sí ọwọ́ mí, èmi kì yóò fi ọwọ́ mi kan ọmọ ọba, nítorí pé àwa gbọ́ nígbà tí ọba kìlọ̀ fún ìwọ àti Abiṣai, àti Ittai, pé, 'Ẹ kíyèsi i, kí ẹnikẹ́ni má ṣe fi ọwọ́ kan ọ̀dọ́mọkùnrin náà Absalomu.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣe bẹ́ẹ̀ èmi ìbá ṣe sí ara mi, nítorí pé kò sí ọ̀ràn kan tí ó pamọ́ fún ọba, ìwọ tìkára rẹ̀ ìbá sì kọjú ìjà sí mi pẹ̀lú.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì wí pé, \"Èmi kì yóò dúró bẹ́ẹ̀ níwájú rẹ.\" Ó sì mú ọ̀kọ̀ mẹ́ta lọ́wọ́ rẹ̀, ó sì fi wọ́n gún Absalomu ní ọkàn, nígbà tí ó sì wà láààyè ní agbede-méjì igi óákù náà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀dọ́mọdékùnrin mẹ́wàá tí ó máa ń ru ìhámọ́ra Joabu sì yí Absalomu ká, wọ́n sì kọlù ú, wọ́n sì pa á.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì fun ìpè, àwọn ènìyàn náà sì yípadà láti máa lépa Israẹli, nítorí Joabu ti pe àwọn ènìyàn náà padà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
            "verseOrgIds": [
              "2SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì gbé Absalomu, wọ́n sì sọ ọ́ sínú ihò ńlá kan ní igbó náà, wọ́n sì kó òkúta púpọ̀ jọ sí i lórí, gbogbo Israẹli sì sá, olúkúlùkù sí inú àgọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalomu ní ìgbà ayé rẹ̀, sì mọ ọ̀wọ́n kan fún ara rẹ̀, tí ń bẹ ní àfonífojì Ọba: nítorí tí ó wí pé, \"Èmi kò ní ọmọkùnrin tí yóò pa orúkọ mi mọ́ ní ìrántí,\" òun sì pe ọ̀wọ́n náà nípa orúkọ rẹ̀, a sì ń pè é títí di òní, ní ọ̀wọ́n Absalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dafidi ṣọ̀fọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimasi ọmọ Sadoku sì wí pé, \"Jẹ́ kí èmi ó súré nísinsin yìí, kí èmi sì mú ìròyìn tọ ọba lọ, bí",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.19",
                "verseOrgIds": [
                  "2SA.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbẹ̀san rẹ̀ lára àwọn ọ̀tá rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì wí fún un pé, \"Ìwọ kì yóò mù ìròyìn lọ lónìí, ṣùgbọ́n ìwọ ó mú lọ ní ọjọ́ mìíràn, ṣùgbọ́n lónìí yìí ìwọ kì yóò mú ìròyìn kan lọ, nítorí tí ọmọ ọba ṣe aláìsí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì wí fún Kuṣi pé, \"Lọ, kí ìwọ ro ohun tí ìwọ rí fún ọba.\" Kuṣi sì wólẹ̀ fún Joabu ó sì sáré.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimasi ọmọ Sadoku sì tún wí fún Joabu pé, \"Jọ̀wọ́, bí ó ti wù kí ó rí, èmi ó sáré tọ Kuṣi lẹ́yìn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:22"
      },
      "items": [
        {
          "text": "Joabu sì bi í pé, \"Nítorí kín ni ìwọ ó ṣe sáré, ọmọ mi, ìwọ kò ri pé kò sí ìròyìn rere kan tí ìwọ ó mú lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Bí ó ti wù kí ó rí, èmi ó sáré.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:23"
      },
      "items": [
        {
          "text": "Ó sì wí fún un pé, \"Sáré!\" Ahimasi sì sáré ní ọ̀nà pẹ̀tẹ́lẹ̀, ó sì sáré kọjá Kuṣi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì jókòó lẹ́nu odi láàrín ìlẹ̀kùn méjì, alóre sì gòkè òrùlé bodè lórí odi, ó sì gbé ojú rẹ̀ sókè, ó sì wò, wò ó, ọkùnrin kan ń sáré òun nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alóre náà sì kígbe, ó sì wí fún ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:25"
      },
      "items": [
        {
          "text": "Ọba sì wí pé, \"Bí ó bá ṣe òun nìkan ni, ìròyìn rere ń bẹ lẹ́nu rẹ̀.\" Òun sì ń súnmọ́ tòsí.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alóre náà sì rí ọkùnrin mìíràn tí ń sáré, alóre sì kọ sí ẹni tí ń ṣọ́ bodè, ó sì wí pe, \"Wò ó, ọkùnrin kan ń sáré òun nìkan.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:26"
      },
      "items": [
        {
          "text": "Ọba sì wí pé, \"Èyí náà pẹ̀lú ń mú ìròyìn rere wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alóre náà sì wí pé, \"Èmi wo ìsáré ẹni tí ó wà níwájú ó dàbí ìsáré Ahimasi ọmọ Sadoku.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:27"
      },
      "items": [
        {
          "text": "Ọba sì wí pé, \"Ènìyàn re ni, ó sì ń mú ìyìnrere wá!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimasi sì dé, ó sì wí fún ọba pé, \"Àlàáfíà!\" Ó sì wólẹ̀ fún ọba, ó dojúbolẹ̀ ó sì wí pé, \"Alábùkún fún ni",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.28",
                "verseOrgIds": [
                  "2SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, ẹni tí ó fi àwọn ọkùnrin tí ó gbé ọwọ́ wọn sókè sí olúwa mi ọba lé ọ lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì béèrè pé, \"Àlàáfíà ha wà fún Absalomu, ọmọdékùnrin náà bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:29"
      },
      "items": [
        {
          "text": "Ahimasi sì dáhùn pé, \"Nígbà tí Joabu rán ìránṣẹ́ ọba, àti èmi ìránṣẹ́ rẹ̀, mo rí ọ̀pọ̀ ènìyàn, ṣùgbọ́n èmi kò mọ ìdí rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún un pé, \"Yípadà kí o sì dúró níhìn-ín.\" Òun sì yípadà, ó sì dúró jẹ́ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sì wò ó, Kuṣi sì wí pé, \"Ìyìnrere fún olúwa mi ọba, nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.31",
                "verseOrgIds": [
                  "2SA.18.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbẹ̀san rẹ lónìí lára gbogbo àwọn tí ó dìde sí ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì bi Kuṣi pé, \"Àlàáfíà kọ́ Absalomu ọ̀dọ́mọdékùnrin náà wá bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:32"
      },
      "items": [
        {
          "text": "Kuṣi sì dáhùn pe, \"Kí àwọn ọ̀tá olúwa mi ọba, àti gbogbo àwọn tí ó dìde sí ọ ní ibi, rí bí ọ̀dọ́mọdékùnrin náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì kẹ́dùn púpọ̀ ó sì gòkè lọ, sí yàrá tí ó wà lórí òkè ibodè, ó sì sọkún; báyìí ni ó sì ń wí bí ó ti ń lọ, \"Ọmọ mi Absalomu! Ọmọ mi, ọmọ mí Absalomu! Á à! Ìbá ṣe pé èmi ni ó kú ní ipò rẹ̀! Absalomu ọmọ mi, ọmọ mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.19.1"
            ]
          }
        }
      ]
    }
  ],
