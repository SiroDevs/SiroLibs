      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:13"
      },
      "items": [
        {
          "text": "mímu dúró ní ilé Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.13",
            "verseOrgIds": [
              "JOL.1.13"
            ]
          }
        }
      ]
    },
