      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:13"
      },
      "items": [
        {
          "text": "ẹ pohùnréré ẹkún, ẹ̀yin ìránṣẹ́ pẹpẹ:",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.13",
            "verseOrgIds": [
              "JOL.1.13"
            ]
          }
        }
      ]
