            "sid": "JOL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àjàrà gbẹ, igi ọ̀pọ̀tọ́ sì rọ̀ dànù;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:12"
      },
      "items": [
        {
          "text": "igi pomegiranate, igi ọ̀pẹ pẹ̀lú,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:12"
      },
      "items": [
        {
          "text": "àti igi apiili, gbogbo igi igbó ni o rọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:12"
      },
      "items": [
        {
          "text": "Nítorí náà ayọ̀ ọmọ ènìyàn gbẹ kúrò lọ́dọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.12",
            "verseOrgIds": [
              "JOL.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpè fún ìrònúpìwàdà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
