      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "nítorí ìkórè oko ṣègbé.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
