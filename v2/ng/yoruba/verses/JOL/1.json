      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:13"
      },
      "items": [
        {
          "text": "ẹ wá, fi gbogbo òru dùbúlẹ̀ nínú aṣọ ọ̀fọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.13",
            "verseOrgIds": [
              "JOL.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:13"
      },
      "items": [
        {
          "text": "ẹ̀yin ìránṣẹ́ Ọlọ́run mi, nítorí tí a dá ọrẹ-jíjẹ àti ọrẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.13",
            "verseOrgIds": [
              "JOL.1.13"
            ]
          }
        }
      ]
    },
