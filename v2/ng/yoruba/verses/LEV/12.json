        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwẹ̀nùmọ́ lẹ́yìn ìbímọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.12.1",
                "verseOrgIds": [
                  "LEV.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ará Israẹli pé: 'Obìnrin tí ó bá lóyún tí ó sì bí ọmọkùnrin, yóò wà láìmọ́ fún ọjọ́ méje bí ìgbà tí ó wà ní ipò àìmọ́ lákokò nǹkan oṣù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹjọ ni kí ẹ kọ ọmọ náà ní ilà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà yóò sì dúró fún ọjọ́ mẹ́tàlélọ́gbọ̀n láti di mímọ́ kúrò nínú ìsun ẹ̀jẹ̀ rẹ̀. Kò gbọdọ̀ fi ọwọ́ kan ohunkóhun tí ó jẹ́ mímọ́ tàbí kí ó lọ sí ibi mímọ́",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.12.4",
                "verseOrgIds": [
                  "LEV.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "títí di ọjọ́ tí ìwẹ̀nùmọ́ rẹ̀ yóò kọjá.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣe obìnrin ni ó bí, fún ọ̀sẹ̀ méjì ni obìnrin náà yóò fi wà ní ipò àìmọ́, gẹ́gẹ́ bí àkókò nǹkan oṣù rẹ̀. Ó sì gbọdọ̀ dúró ní ọjọ́ mẹ́rìndínláàádọ́rin láti di mímọ́ kúrò nínú ìsun ẹ̀jẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nígbà tí ọjọ́ ìwẹ̀nùmọ́ rẹ̀ fún ọmọkùnrin tàbí ọmọbìnrin bá kọjá kí ó mú ọ̀dọ́-àgùntàn ọlọ́dún kan wá fún àlùfáà ní ẹnu-ọ̀nà àgọ́ ìpàdé fún ẹbọ sísun àti ọmọ ẹyẹlé tàbí àdàbà kan fún ẹbọ ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó gbọdọ̀ fi wọ́n rú ẹbọ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.12.7",
                "verseOrgIds": [
                  "LEV.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ṣe ètùtù fún obìnrin náà lẹ́yìn náà ni yóò di mímọ́ kúrò nínú ìsun ẹ̀jẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 12:7"
      },
      "items": [
        {
          "text": "\" 'Ìwọ̀nyí ni àwọn ìlànà fún obìnrin tí ó bá bí ọmọkùnrin tàbí ọmọbìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò bá lágbára àti fi àgùntàn ṣe é, ó gbọdọ̀ le mú àdàbà méjì tàbí ọmọ ẹyẹlé méjì, ọ̀kan fún ẹbọ ẹ̀ṣẹ̀, àti èkejì fún ẹbọ sísun. Báyìí ni àlùfáà yóò ṣe ètùtù fún un. Òun yóò sì di mímọ́.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
        }
      ]
    }
  ],
