                "verseId": "LEV.8.29",
                "verseOrgIds": [
                  "LEV.8.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì mú díẹ̀ lára òróró ìtasórí àti díẹ̀ nínú ẹ̀jẹ̀ láti orí pẹpẹ, ó wọ́n sára àwọn ọmọ Aaroni àti aṣọ rẹ̀, ó sì tún wọ́n sára àwọn ọmọ Aaroni àti aṣọ wọn. Bẹ́ẹ̀ ní Mose ya Aaroni àti àwọn ọmọ rẹ̀ pẹ̀lú aṣọ wọn sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì sọ fún Aaroni àti àwọn ọmọ rẹ̀ pé, \"Ẹ se ẹran náà ní ẹnu-ọ̀nà àgọ́ ìpàdé kí ẹ sì jẹ ẹ́ níbẹ̀ pẹ̀lú àkàrà tí a mú láti inú apẹ̀rẹ̀ ọrẹ ìfinijoyè àlùfáà gẹ́gẹ́ bí mo ti pa á láṣẹ pé, 'Aaroni àti àwọn ọmọ rẹ̀ ni kí ó jẹ ẹ́.'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ fi iná sun ìyókù àkàrà àti ẹran náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe kúrò ní ẹnu-ọ̀nà àgọ́ ìpàdé fún ọjọ́ méje, títí tí ọjọ́ ìfinijoyè àlùfáà yín yóò fi pé, nítorí pé ìfinijoyè àlùfáà yín yóò gba ọjọ́ méje gbáko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun tí a ṣe lónìí jẹ́ ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.8.34",
                "verseOrgIds": [
                  "LEV.8.34"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ láti ṣe ètùtù fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ wà ní ẹnu-ọ̀nà àgọ́ ìpàdé lọ́sàn án àti lóru fún ọjọ́ méje kí ẹ sì ṣe ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.8.35",
                "verseOrgIds": [
                  "LEV.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": "fẹ́, kí ẹ má ba à kú, nítorí ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.8.35",
                "verseOrgIds": [
                  "LEV.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ fún mi ni èyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        }
      ]
    },
