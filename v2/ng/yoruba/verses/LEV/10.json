  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "LEV 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Nadabu àti Abihu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabu àti Abihu tí í ṣe ọmọ Aaroni sì mú àwo tùràrí kọ̀ọ̀kan, wọ́n fi iná àti tùràrí sínú rẹ̀, wọ́n sì rú iná àjèjì níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.1",
                "verseOrgIds": [
                  "LEV.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", èyí tó lòdì sí àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.1",
                "verseOrgIds": [
                  "LEV.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí èyí, iná jáde láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.2",
                "verseOrgIds": [
                  "LEV.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì jó wọn pa, wọ́n sì kú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.2",
                "verseOrgIds": [
                  "LEV.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì sọ fún Aaroni pé, \"Ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.3",
                "verseOrgIds": [
                  "LEV.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ń sọ nípa rẹ̀ nìyìí nígbà tó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "\" 'Ní àárín àwọn tó súnmọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "Èmi yóò fi ara mi hàn ní mímọ́",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "ojú gbogbo ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "Ní a ó ti bu ọlá fún mi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "Aaroni sì dákẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose pe Miṣaeli àti Elsafani ọmọ Usieli tí í ṣe arákùnrin Aaroni, ó sọ fún wọn pé, \"Ẹ wá, kí ẹ sì gbé àwọn arákùnrin yín jáde kúrò níwájú ibi mímọ́ lọ sí ẹ̀yìn ibùdó.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.4",
            "verseOrgIds": [
              "LEV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì wá gbé wọn, pẹ̀lú ẹ̀wù àwọ̀tẹ́lẹ̀ wọn ní ọrùn wọn lọ sí ẹ̀yìn ibùdó bí Mose ti sọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sọ fún Aaroni àti àwọn ọmọ rẹ̀ yòókù, Eleasari àti Itamari pé, \"ẹ má ṣe ṣọ̀fọ̀ nípa ṣíṣe aláìtọ́jú irun yín tàbí kí ẹ ṣí orí yín sílẹ̀, ẹ kò sì gbọdọ̀ ya aṣọ, bí ẹ bá ṣe bẹ́ẹ̀, ẹ ó kùú,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.6",
                "verseOrgIds": [
                  "LEV.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì bínú sí gbogbo ìjọ ènìyàn. Ṣùgbọ́n àwọn ẹbí yín, àti gbogbo ilé Israẹli le è ṣọ̀fọ̀ lórí àwọn tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.6",
                "verseOrgIds": [
                  "LEV.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "fi iná parun.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe kúrò ní ẹnu-ọ̀nà àgọ́ ìpàdé, bí ẹ bá kúrò níbẹ̀, ẹ ó kù ú, nítorí pé òróró ìtasórí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.7",
                "verseOrgIds": [
                  "LEV.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "wà lórí yín.\" Wọ́n sì ṣe bí Mose ti wí.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.8",
                "verseOrgIds": [
                  "LEV.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Aaroni pé.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.8",
            "verseOrgIds": [
              "LEV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ àti àwọn ọmọ rẹ̀ kò gbọdọ̀ mu ọtí wáìnì tàbí ọtí líle mìíràn nígbàkígbà tí ẹ bá n lọ inú àgọ́ ìpàdé, bí ẹ bá ṣe bẹ́ẹ̀, ẹ ó kù ú, èyí jẹ́ ìlànà títí láé fún un yín láti ìrandíran.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.9",
            "verseOrgIds": [
              "LEV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ mọ ìyàtọ̀ láàrín mímọ́ àti àìmọ́, láàrín èérí àti àìléèérí.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.10",
            "verseOrgIds": [
              "LEV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ kọ́ àwọn ara Israẹli ní gbogbo àṣẹ tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.11",
                "verseOrgIds": [
                  "LEV.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "fún wọn láti ẹnu Mose.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì sọ fún Aaroni, Eleasari àti Itamari àwọn ọmọ rẹ̀ yòókù pé, \"Ẹ mú ẹbọ ohun jíjẹ tó ṣẹ́kù láti inú ẹbọ àfinásun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.12",
                "verseOrgIds": [
                  "LEV.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ẹ jẹ ẹ́ láìní ìwúkàrà nínú, lẹ́gbẹ̀ẹ́ pẹpẹ nítorí ó jẹ́ mímọ́ jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ ní ibi mímọ́, nítorí pé òun ni ìpín rẹ àti ti àwọn ọmọ rẹ nínú ẹbọ tí a finá sun sí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.13",
                "verseOrgIds": [
                  "LEV.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nítorí pé bẹ́ẹ̀ ni mo ṣe pa á láṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ àti àwọn ọmọkùnrin àti àwọn ọmọbìnrin rẹ le jẹ igẹ̀ ẹran tí a fì níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.14",
                "verseOrgIds": [
                  "LEV.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "àti itan tí wọ́n gbé síwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.14",
                "verseOrgIds": [
                  "LEV.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ẹ jẹ wọ́n ní ibi tí a kà sí mímọ́, èyí ni a ti fún ìwọ àti àwọn ọmọ rẹ gẹ́gẹ́ bí ìpín yín nínú ẹbọ àlàáfíà àwọn ara Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itan tí wọ́n mú wá àti igẹ̀ ẹran tí ẹ fì ni ẹ gbọdọ̀ mú wá pẹ̀lú ọ̀rá ẹbọ tí a finá sun láti le è fì wọ́n níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.15",
                "verseOrgIds": [
                  "LEV.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bí ẹbọ fífì. Èyí yóò sì jẹ́ ìpín tìrẹ àti ti àwọn ọmọ rẹ nígbà gbogbo bí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.15",
                "verseOrgIds": [
                  "LEV.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe pàṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Mose wádìí nípa ewúrẹ́ ẹbọ ẹ̀ṣẹ̀ tó sì rí i pé wọ́n ti sun ún, ó bínú sí Eleasari àti Itamari, àwọn ọmọ Aaroni yòókù, ó sì béèrè pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èéṣe tí ẹ kò jẹ ẹbọ ẹ̀ṣẹ̀ náà ní agbègbè ibi mímọ́? Ó jẹ́ mímọ́ jùlọ, a fi fún yín láti lè mú ẹ̀ṣẹ̀ ìjọ ènìyàn kúrò nípa fífi ṣe ètùtù fún wọn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.17",
                "verseOrgIds": [
                  "LEV.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí ẹ kò mú ẹ̀jẹ̀ rẹ̀ wá sí Ibi Mímọ́, ẹ̀ bá ti jẹ ewúrẹ́ náà ní agbègbè Ibi Mímọ́ bí mo ṣe pa á láṣẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
              "LEV.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
