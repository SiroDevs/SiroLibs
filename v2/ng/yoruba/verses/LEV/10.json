          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni sì dá Mose lóhùn pé, \"Lónìí tí wọ́n rú ẹbọ ẹ̀ṣẹ̀ àti ẹbọ sísun wọn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.19",
                "verseOrgIds": [
                  "LEV.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ni irú èyí tún ṣẹlẹ̀ sí mi. Ǹjẹ́ inú",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.19",
                "verseOrgIds": [
                  "LEV.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò wá dùn bí mo bá jẹ ẹbọ ẹ̀ṣẹ̀ lónìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Mose gbọ́ èyí, ọkàn rẹ̀ balẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.20",
            "verseOrgIds": [
