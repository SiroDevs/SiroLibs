  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "LUK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Johanu onítẹ̀bọmi tún ọnà náà ṣe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹ́ẹ̀dógún ìjọba Tiberiu Kesari, nígbà tí Pọntiu Pilatu jẹ́ baálẹ̀ Judea, tí Herodu sì jẹ́ tetrarki Galili, Filipi arákùnrin rẹ̀ sì jẹ́ tetrarki Iturea àti ti Trakoniti, Lisania sì jẹ́ tetrarki Abilene,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí Annasi òun Kaiafa ń ṣe olórí àwọn àlùfáà, nígbà náà ni ọ̀rọ̀ Ọlọ́run tọ Johanu ọmọ Sekariah wá ní ijù.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wá sí gbogbo ilẹ̀ aginjù Jordani, ó ń wàásù ìtẹ̀bọmi ìrònúpìwàdà fún ìmúkúrò ẹ̀ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.3",
            "verseOrgIds": [
              "LUK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí a ti kọ ọ́ nínú ìwé ọ̀rọ̀ wòlíì Isaiah pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "\"Ohùn ẹni tí ń kígbe ní ijù,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "'Ẹ tún ọ̀nà Olúwa ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "ẹ mú ipa ọ̀nà rẹ̀ tọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọ̀gbun ni a yóò kún,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "gbogbo òkè ńlá àti òkè kékeré ni a ó tẹ́ pẹẹrẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "Wíwọ́ ni a ó ṣe ní títọ́,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "àti ọ̀nà gbọ́ngungbọ̀ngun ni a o sọ di dídán.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn ni yóò sì rí ìgbàlà Ọlọ́run.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.6",
            "verseOrgIds": [
              "LUK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó wí fún ọ̀pọ̀ àwọn ènìyàn tí ó wá láti ṣe ìtẹ̀bọmi lọ́dọ̀ rẹ̀ pé, \"Ẹ̀yin ìran paramọ́lẹ̀, ta ni ó kìlọ̀ fún un yín láti sá kúrò nínú ìbínú tí ń bọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà kí ẹ̀yin kí ó so èso tí ó yẹ fún ìrònúpìwàdà, kí ẹ má sì ṣe sí í wí nínú ara yín pé, 'Àwa ní Abrahamu ní baba.' Kí èmi kí ó wí fún un yín, Ọlọ́run lè gbé ọmọ dìde fún Abrahamu nínú òkúta wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nísinsin yìí pẹ̀lú, a fi àáké lé gbòǹgbò igi náà, gbogbo igi tí kò bá so èso rere, a óò ge lulẹ̀, a sì wọ jù sínú iná.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì ń bi í pé, \"Kí ni kí àwa kí ó ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dáhùn ó sì wí fún wọn pé, \"Ẹni tí ó bá ní ẹ̀wù méjì, kí ó fi ọ̀kan fún ẹni tí kò ní; ẹni tí ó bá sì ní oúnjẹ, kí ó ṣe bẹ́ẹ̀ pẹ̀lú.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn agbowó òde sì tọ̀ ọ́ wá láti ṣe ìtẹ̀bọmi lọ́dọ̀ rẹ̀, wọ́n sì bi í pé, \"Olùkọ́, kí ni àwa ó ha ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn pé, \"Ẹ má ṣe fi agbára gbà jù bí a ti rán yín lọ mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ogun sì béèrè lọ́dọ̀ rẹ̀ pé, \"Àti àwa, kí ni àwa ó ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 3:14"
      },
      "items": [
        {
          "text": "Ó sì wí fún wọn pé, \"Ẹ má ṣe hùwà ipá sí ẹnikẹ́ni, kí ẹ má sì ṣe ka ẹ̀sùn èké sí ẹnikẹ́ni; kí òwò ọ̀yà yín tó yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ènìyàn sì ti ń retí, tí gbogbo wọn sì ń rò nínú ara wọn nítorí Johanu, bí òun ni Kristi tàbí òun kọ́;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johanu dáhùn ó sì wí fún gbogbo wọn pé, \"Lóòótọ́ ni èmi ń fi omi bamitiisi yín, ṣùgbọ́n ẹni tí ó lágbára jù mí lọ ń bọ̀, okùn bàtà ẹsẹ̀ ẹni tí èmi kò tó tú, Òun ni yóò fi Ẹ̀mí Mímọ́ àti iná bamitiisi yín.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí àtẹ rẹ̀ ń bẹ ní ọwọ́ rẹ̀, láti gbá ilẹ̀ ìpakà rẹ̀ mọ́ tó tó, kí ó sì kó alikama rẹ̀ sínú àká; ṣùgbọ́n ìyàngbò ni yóò fi iná àjóòkú sun.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johanu lo oríṣìíríṣìí ọ̀rọ̀ púpọ̀ láti gba àwọn ènìyàn níyànjú àti láti wàásù ìyìnrere fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà ti Johanu bú Herodu tetrarki, tí ó bá wí nítorí Herodia aya Filipi arákùnrin rẹ̀, àti nítorí ohun búburú gbogbo tí Herodu tí ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi èyí parí gbogbo rẹ̀ nígbà tí ó fi Johanu sínú túbú.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìtẹ̀bọmi àti ìtàn ìdílé Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a ṣe ìtẹ̀bọmi àwọn ènìyàn gbogbo tán, ó sì ṣe, a bamitiisi Jesu pẹ̀lú, bí ó ti ń gbàdúrà, ọ̀run ṣí sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí Mímọ́ sì sọ̀kalẹ̀ sí orí rẹ̀ ní àwọ̀ àdàbà, ohùn kan sì ti ọ̀run wá, tí ó wí pé, \"Ìwọ ni àyànfẹ́ ọmọ mi; ẹni tí inú mi dùn sí gidigidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
