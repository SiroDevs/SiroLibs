  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "LUK 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oore opó",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì gbé ojú sókè, ó rí àwọn ọlọ́rọ̀ ń fi ẹ̀bùn wọn sínú àpótí ìṣúra.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rí tálákà opó kan pẹ̀lú, ó ń sọ owó idẹ wẹ́wẹ́ méjì síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lóòótọ́ ni mo wí fún yín, tálákà opó yìí fi sí i ju gbogbo wọn lọ,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.3",
                "verseOrgIds": [
                  "LUK.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nítorí gbogbo àwọn wọ̀nyí fi sínú ẹ̀bùn Ọlọ́run láti ọ̀pọ̀lọpọ̀ ìní wọn; ṣùgbọ́n òun nínú àìní rẹ̀ ó sọ gbogbo ohun ìní rẹ̀ tí ó ní sínú rẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.4",
                "verseOrgIds": [
                  "LUK.21.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn àmì ìkẹyìn ayé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn kan sì ti ń sọ̀rọ̀ nípa tẹmpili, bí a ti fi òkúta dáradára àti ẹ̀bùn ṣe é ní ọ̀ṣọ́, fun Ọlọ́run, Jesu wí pé",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ohun tí ẹ̀yin ń wò wọ̀nyí, ọjọ́ ń bọ̀, nígbà tí a kì yóò fi òkúta kan sílẹ̀ lórí èkejì tí a kì yóò wó lulẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.6",
                "verseOrgIds": [
                  "LUK.21.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì béèrè lọ́wọ́ rẹ̀, pé, \"Olùkọ́, nígbà wo ni nǹkan wọ̀nyí yóò rí bẹ́ẹ̀? Àti àmì kín ni yóò wà, nígbà tí nǹkan wọ̀nyí yóò fi ṣẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ máa kíyèsára, kí a má bá à mú yín ṣìnà: nítorí ọ̀pọ̀lọpọ̀ yóò wá ní orúkọ mi, tí yóò máa wí pé, 'Èmi ní Kristi náà àkókò náà sì kù sí dẹ̀dẹ̀.' Ẹ má ṣe tọ̀ wọ́n lẹ́yìn.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.8",
                "verseOrgIds": [
                  "LUK.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nígbà tí ẹ̀yin bá gbúròó ogun àti ìdágìrì, ẹ má ṣe fòyà; nítorí nǹkan wọ̀nyí ní láti kọ́kọ́ ṣẹlẹ̀, ṣùgbọ́n òpin náà kì í ṣe lójúkan náà.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.9",
                "verseOrgIds": [
                  "LUK.21.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Orílẹ̀-èdè yóò dìde sí orílẹ̀-èdè, àti ìjọba sí ìjọba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.10",
                "verseOrgIds": [
                  "LUK.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ilẹ̀-rírì ńlá yóò sì wà káàkiri, àti ìyàn àti àjàkálẹ̀-ààrùn; ohun ẹ̀rù, àti àmì ńlá yóò sì ti ọ̀run wá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.11",
                "verseOrgIds": [
                  "LUK.21.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n ṣáájú gbogbo nǹkan wọ̀nyí, wọn ó nawọ́ mú yín, wọn ó sì ṣe inúnibíni sí yín, wọn ó mú yín lọ sí Sinagọgu, àti sínú túbú, wọn ó mú yín lọ sọ́dọ̀ àwọn ọba àti àwọn ìjòyè nítorí orúkọ mi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.12",
                "verseOrgIds": [
                  "LUK.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ o si jẹ́rìí nípa mi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.13",
                "verseOrgIds": [
                  "LUK.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà ẹ pinnu rẹ̀ ní ọkàn yín pé ẹ ko ronú ṣáájú, bí ẹ ó ti dáhùn.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.14",
                "verseOrgIds": [
                  "LUK.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí tí èmi ó fún yín ní ẹnu àti ọgbọ́n, tí gbogbo àwọn ọ̀tá yín kì yóò lè sọ̀rọ̀-òdì sí, tí wọn kì yóò sì lè kò lójú.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.15",
                "verseOrgIds": [
                  "LUK.21.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A ó sì fi yín hàn láti ọwọ́ àwọn òbí yín wá, àti àwọn arákùnrin, àti àwọn ìbátan, àti àwọn ọ̀rẹ́; òun ó sì mú kì a pa nínú yín.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.16",
                "verseOrgIds": [
                  "LUK.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A ó sì kórìíra yín lọ́dọ̀ gbogbo ènìyàn nítorí orúkọ mi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.17",
                "verseOrgIds": [
                  "LUK.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n irun orí yín kan kì yóò ṣègbé.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.18",
                "verseOrgIds": [
                  "LUK.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nínú ìdúró ṣinṣin yín ni ẹ̀yin ó jèrè ọkàn yín.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.19",
                "verseOrgIds": [
                  "LUK.21.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà tí ẹ̀yin bá sì rí ti a fi ogun yí Jerusalẹmu ká, ẹ mọ̀ nígbà náà pé, ìsọdahoro rẹ̀ kù sí dẹ̀dẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.20",
                "verseOrgIds": [
                  "LUK.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà náà ni kí àwọn tí ń bẹ ní Judea sálọ sórí òkè; àti àwọn tí ń bẹ láàrín rẹ̀ kí wọn jáde kúrò; kí àwọn tí ó sì ń bọ̀ ní ìgbèríko má ṣe wọ inú rẹ̀ wá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.21",
                "verseOrgIds": [
                  "LUK.21.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ọjọ́ ẹ̀san ni ọjọ́ wọ̀nyí, kì a lè mú ohun gbogbo tí a ti kọ̀wé rẹ̀ ṣẹ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.22",
                "verseOrgIds": [
                  "LUK.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ègbé ni fún àwọn tí ó lóyún, àti àwọn tí ó fi ọyàn fún ọmọ mu ní ọjọ́ wọ̀nyí! Nítorí tí ìpọ́njú púpọ̀ yóò wà lórí ilẹ̀ àti ìbínú sí àwọn ènìyàn wọ̀nyí.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.23",
                "verseOrgIds": [
                  "LUK.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wọn ó sì ti ojú idà ṣubú, a ó sì dìwọ́n ní ìgbèkùn lọ sí orílẹ̀-èdè gbogbo; Jerusalẹmu yóò sì di ìtẹ̀mọ́lẹ̀ lẹ́sẹ̀ àwọn aláìkọlà, títí àkókò àwọn aláìkọlà yóò fi kún.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.24",
                "verseOrgIds": [
                  "LUK.21.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àmì yóò sì wà ní oorun, àti ní òṣùpá, àti ní ìràwọ̀; àti lórí ilẹ̀ ayé ìdààmú fún àwọn orílẹ̀-èdè nínú ìpayà híhó Òkun àti ìgbì omi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.25",
                "verseOrgIds": [
                  "LUK.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àyà àwọn ènìyàn yóò máa já fún ìbẹ̀rù, àti ìrètí nǹkan wọ̀nyí tí ń bọ̀ sórí ayé: nítorí àwọn agbára ọ̀run ni a ó mì tìtì.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.26",
                "verseOrgIds": [
                  "LUK.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà náà ni wọn ó sì rí Ọmọ Ènìyàn tí yóò máa bọ̀ wá nínú àwọsánmọ̀ pẹ̀lú agbára àti ògo ńlá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.27",
                "verseOrgIds": [
                  "LUK.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nígbà tí nǹkan wọ̀nyí bá bẹ̀rẹ̀ sí í ṣẹ, ǹjẹ́ kí ẹ wo òkè, kí ẹ sì gbé orí yín sókè; nítorí ìdáǹdè yín kù sí dẹ̀dẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.28",
                "verseOrgIds": [
                  "LUK.21.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pa òwe kan fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ kíyèsi igi ọ̀pọ̀tọ́, àti sí gbogbo igi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.29",
                "verseOrgIds": [
                  "LUK.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí wọ́n bá rúwé, ẹ̀yin rí i, ẹ sì mọ̀ fúnra ara yín pé, ìgbà ẹ̀ẹ̀rùn kù fẹ́ẹ́rẹ́.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.30",
                "verseOrgIds": [
                  "LUK.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gẹ́gẹ́ bẹ́ẹ̀ náà ni ẹ̀yin, nígbà tí ẹ̀yin bá rí nǹkan wọ̀nyí tí o ṣẹ, kí ẹ̀yin mọ̀ pé, ìjọba Ọlọ́run kù sí dẹ̀dẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.31",
                "verseOrgIds": [
                  "LUK.21.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lóòótọ́ ni mo wí fún yín, ìran yìí kì yóò rékọjá, títí gbogbo nǹkan wọ̀nyí yóò fi ṣẹ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.32",
                "verseOrgIds": [
                  "LUK.21.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ̀run àti ayé yóò rékọjá, ṣùgbọ́n ọ̀rọ̀ mi kì yóò rékọjá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.33",
                "verseOrgIds": [
                  "LUK.21.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n ẹ máa kíyèsára yín, kí ọkàn yín má ṣe kún fún wọ̀bìà, àti fún ọtí àmupara, àti fún àníyàn ayé yìí, tí ọjọ́ náà yóò sì fi dé bá yín lójijì bí ìkẹ́kùn.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.34",
                "verseOrgIds": [
                  "LUK.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí bẹ́ẹ̀ ni yóò dé bá gbogbo àwọn tí ń gbé orí gbogbo ilẹ̀ ayé.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.35",
                "verseOrgIds": [
                  "LUK.21.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ǹjẹ́ kì ẹ máa ṣọ́nà, kí ẹ sì máa gbàdúrà nígbà gbogbo, kí ẹ ba à lè la gbogbo nǹkan wọ̀nyí tí yóò ṣẹlẹ̀, kí ẹ sì lè dúró níwájú Ọmọ Ènìyàn.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.36",
                "verseOrgIds": [
                  "LUK.21.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ́sàn án, Jesu a sì máa kọ́ni ní tẹmpili, lóru, a sì máa jáde lọ í wọ̀ ní òkè tí à ń pè ní Òkè Olifi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn sì ń tọ̀ ọ́ wá ní tẹmpili ní kùtùkùtù òwúrọ̀, láti gbọ́rọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
          }
        }
      ]
    }
  ],
