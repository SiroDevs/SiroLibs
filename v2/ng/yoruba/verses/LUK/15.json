  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "LUK 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe àgùntàn tó sọnù",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn agbowó òde àti àwọn ẹlẹ́ṣẹ̀ sì súnmọ́ ọn láti gbọ́ ọ̀rọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti àwọn Farisi àti àwọn akọ̀wé ń kùn pé, \"Ọkùnrin yìí ń gba ẹlẹ́ṣẹ̀, ó sì ń bá wọn jẹun.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pa òwe yìí fún wọn, pé,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.3",
            "verseOrgIds": [
              "LUK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọkùnrin wo ni nínú yín, tí ó ní ọgọ́rùn-ún àgùntàn, bí ó bá sọ ọ̀kan nù nínú wọn, tí kì yóò fi mọ́kàndínlọ́gọ́rùn-ún yokù sílẹ̀ ni ijù tí kì yóò sì tọ ipasẹ̀ èyí tí ó nù lọ, títí yóò fi rí i?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.4",
                "verseOrgIds": [
                  "LUK.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ó bá sì rí i tán, yóò gbé e lé èjìká rẹ̀ pẹ̀lú ayọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.5",
                "verseOrgIds": [
                  "LUK.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ó bá sì dé ilé yóò pe àwọn ọ̀rẹ́ àti aládùúgbò rẹ̀ jọ, yóò sì wí fún wọn pé, 'Ẹ bá mí yọ̀; nítorí tí mo ti rí àgùntàn mi tí ó nù.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.6",
                "verseOrgIds": [
                  "LUK.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mo wí fún yín, gẹ́gẹ́ bẹ́ẹ̀ ni ayọ̀ yóò wà ní ọ̀run lórí ẹlẹ́ṣẹ̀ kan tí ó ronúpìwàdà, ju lórí olóòtítọ́ mọ́kàndínlọ́gọ́rùn-ún lọ, tí kò nílò ìrònúpìwàdà.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.7",
                "verseOrgIds": [
                  "LUK.15.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe owó tó sọnù",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tàbí obìnrin wo ni ó ní owó fàdákà mẹ́wàá bí ó bá sọ ọ̀kan nù, tí kì yóò tan fìtílà, kí ó fi gbá ilé, kí ó sì wá a gidigidi títí yóò fi rí i?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.8",
                "verseOrgIds": [
                  "LUK.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ó sì rí i, ó pe àwọn ọ̀rẹ́ àti àwọn aládùúgbò rẹ̀ jọ, ó wí pé, 'Ẹ bá mi yọ̀; nítorí mo rí owó fàdákà tí mo ti sọnù.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.9",
                "verseOrgIds": [
                  "LUK.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.9",
            "verseOrgIds": [
              "LUK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mo wí fún yín, gẹ́gẹ́ bẹ́ẹ̀ ni ayọ̀ ń bẹ níwájú àwọn angẹli Ọlọ́run lórí ẹlẹ́ṣẹ̀ kan tí ó ronúpìwàdà.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.10",
                "verseOrgIds": [
                  "LUK.15.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe ọmọ tó sọnù",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé ọkùnrin kan ní ọmọ méjì:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èyí àbúrò nínú wọn wí fún baba rẹ̀ pé, 'Baba, fún mi ní ìní tí ó kàn mí.' Ó sì pín ohun ìní rẹ̀ fún wọn.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.12",
                "verseOrgIds": [
                  "LUK.15.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kò sì tó ọjọ́ mélòó kan lẹ́yìn náà, èyí àbúrò kó ohun gbogbo tí ó ní jọ, ó sì mú ọ̀nà àjò rẹ̀ pọ̀n lọ sí ilẹ̀ òkèrè, níbẹ̀ ni ó sì gbé fi ìwà wọ̀bìà ná ohun ìní rẹ̀ ní ìnákúnàá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.13",
                "verseOrgIds": [
                  "LUK.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
            "verseOrgIds": [
              "LUK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ó sì ba gbogbo rẹ̀ jẹ́ tan, ìyàn ńlá wá mú ní ilẹ̀ náà; ó sì bẹ̀rẹ̀ sí di aláìní.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.14",
                "verseOrgIds": [
                  "LUK.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.14",
            "verseOrgIds": [
              "LUK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó sì fi ara rẹ sọfà fun ọ̀kan lára àwọn ọmọ ìlú náà; òun sì rán an lọ sí oko rẹ̀ láti tọ́jú ẹlẹ́dẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.15",
                "verseOrgIds": [
                  "LUK.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ayọ̀ ni ìbá fi jẹ oúnjẹ tí àwọn ẹlẹ́dẹ̀ ń jẹ ní àjẹyó, ṣùgbọ́n ẹnikẹ́ni kò sì fi fún un.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.16",
                "verseOrgIds": [
                  "LUK.15.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n nígbà tí ojú rẹ̀ wálẹ̀, ó ní 'Mélòó mélòó àwọn alágbàṣe baba mí ni ó ní oúnjẹ àjẹyó, àti àjẹtì, èmi sì ń kú fún ebi níhìn-ín.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.17",
                "verseOrgIds": [
                  "LUK.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.17",
            "verseOrgIds": [
              "LUK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi ó dìde, èmi ó sì tọ baba mi lọ, èmi ó sì wí fún un pé, Baba, èmí ti dẹ́ṣẹ̀ sí ọ̀run, àti níwájú rẹ,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.18",
                "verseOrgIds": [
                  "LUK.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "èmi kò sì yẹ, ní ẹni tí à bá pè ní ọmọ rẹ mọ́; fi mí ṣe ọ̀kan nínú àwọn alágbàṣe rẹ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.19",
                "verseOrgIds": [
                  "LUK.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó sì dìde, ó sì tọ baba rẹ̀ lọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.20",
                "verseOrgIds": [
                  "LUK.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 15:20"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n nígbà tí ó sì wà ní òkèrè, baba rẹ̀ rí i, àánú ṣe é, ó sì súré, ó rọ̀ mọ́ ọn ní ọrùn, ó sì fi ẹnu kò ó ní ẹnu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.20",
                "verseOrgIds": [
                  "LUK.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọmọ náà sì wí fún un pé, Baba, èmi ti dẹ́ṣẹ̀ sí ọ̀run, àti níwájú rẹ, èmi kò yẹ ní ẹni tí à bá pè ní ọmọ rẹ mọ́!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.21",
                "verseOrgIds": [
                  "LUK.15.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n baba náà wí fún àwọn ọmọ ọ̀dọ̀ rẹ̀ pé, Ẹ mú ààyò aṣọ wá kánkán, kí ẹ sì fi wọ̀ ọ́; ẹ sì fi òrùka bọ̀ ọ́ lọ́wọ́, àti bàtà sí ẹsẹ̀ rẹ̀:",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.22",
                "verseOrgIds": [
                  "LUK.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ sì mú ẹgbọrọ màlúù àbọ́pa wá, kí ẹ sì pa á, kí a máa ṣe àríyá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.23",
                "verseOrgIds": [
                  "LUK.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ọmọ mi yìí ti kú, ó sì tún yè, ó ti nù, a sì rí i. Wọ́n sì bẹ̀rẹ̀ sí í ṣe àríyá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.24",
                "verseOrgIds": [
                  "LUK.15.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n ọmọ rẹ̀ èyí ẹ̀gbọ́n ti wà ní oko: bí ó sì ti ń bọ̀, tí ó súnmọ́ etí ilé, ó gbọ́ orin àti ijó.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.25",
                "verseOrgIds": [
                  "LUK.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó sì pe ọ̀kan nínú àwọn ọmọ ọ̀dọ̀ wọn, ó béèrè, kín ni a mọ nǹkan wọ̀nyí sí?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.26",
                "verseOrgIds": [
                  "LUK.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó sì wí fún un pé, 'Arákùnrin rẹ dé, baba rẹ sì pa ẹgbọrọ màlúù àbọ́pa, nítorí tí ó rí i padà ní àlàáfíà àti ní ìlera.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.27",
                "verseOrgIds": [
                  "LUK.15.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó sì bínú, ó sì kọ̀ láti wọlé; baba rẹ̀ sì jáde, ó sì wá í ṣìpẹ̀ fún un.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.28",
                "verseOrgIds": [
                  "LUK.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó sì dáhùn ó wí fún baba rẹ̀ pé, 'Wò ó, láti ọdún mélòó wọ̀nyí ni èmi ti ń sìn ọ́, èmi kò sì rú òfin rẹ rí, ìwọ kò sì tí ì fi ọmọ ewúrẹ́ kan fún mi, láti fi bá àwọn ọ̀rẹ́ mi ṣe àríyá.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.29",
                "verseOrgIds": [
                  "LUK.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nígbà tí ọmọ rẹ yìí dé, ẹni tí ó fi panṣágà fi ọrọ̀ rẹ̀ ṣòfò, ìwọ sì ti pa ẹgbọrọ màlúù àbọ́pa fún un.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.30",
                "verseOrgIds": [
                  "LUK.15.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó sì wí fún un pé, 'Ọmọ, nígbà gbogbo ni ìwọ ń bẹ lọ́dọ̀ mi, ohun gbogbo tí mo sì ní, tìrẹ ni.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.31",
                "verseOrgIds": [
                  "LUK.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó yẹ kí a ṣe àríyá kí a sì yọ̀: nítorí arákùnrin rẹ yìí ti kú, ó sì tún yè; ó ti nù, a sì rí i.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.32",
                "verseOrgIds": [
                  "LUK.15.32"
                ]
              }
            }
          ]
        }
      ]
    }
