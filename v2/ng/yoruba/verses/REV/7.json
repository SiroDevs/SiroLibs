        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "\"wọn ṣe ń bẹ níwájú ìtẹ́ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
