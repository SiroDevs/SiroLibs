      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "ẹni tí o jókòó lórí ìtẹ́ náà yóò si síji bò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
