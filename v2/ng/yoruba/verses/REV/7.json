      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:17"
      },
      "items": [
        {
          "text": "'tí yóò sì máa ṣe amọ̀nà wọn sí ibi orísun omi ìyè.'",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
