      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:16"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni òùngbẹ kì yóò gbẹ́ wọ́n mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        }
