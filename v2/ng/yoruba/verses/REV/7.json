      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "tí wọn sì ń sìn ín, lọ́sàn àti lóru nínú tẹmpili rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
