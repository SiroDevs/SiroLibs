              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọ̀dọ́-àgùntàn tí ń bẹ ni àárín ìtẹ́ náà ni yóò máa ṣe olùṣọ́-àgùntàn wọn,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
