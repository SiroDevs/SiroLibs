              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi kì yóò pa wọn mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
