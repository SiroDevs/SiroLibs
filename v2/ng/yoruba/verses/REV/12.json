  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "REV 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obìnrin kan àti dragoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àmì ńlá kan sì hàn ni ọ̀run; obìnrin kan tí a fi oòrùn wọ̀ ní aṣọ, òṣùpá sì ń bẹ lábẹ́ ẹsẹ̀ rẹ̀, adé oníràwọ̀ méjìlá sì ń bẹ lórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.1",
            "verseOrgIds": [
              "REV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lóyún, ó sì kígbe ni ìrọbí, ó sì wà ni ìrora àti bímọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.2",
            "verseOrgIds": [
              "REV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àmì mìíràn sì hàn ní ọ̀run; sì kíyèsi i, dragoni pupa ńlá kan, tí ó ní orí méje àti ìwo mẹ́wàá, àti adé méje ní orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.3",
            "verseOrgIds": [
              "REV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrù rẹ̀ sì wọ́ ìdámẹ́ta àwọn ìràwọ̀ ní ojú ọ̀run, ó sì jù wọ́n sí ilẹ̀ ayé, dragoni náà sì dúró níwájú obìnrin náà tí ó fẹ́ bímọ, pé nígbà tí o bá bí i, kí òun lè pa ọmọ rẹ̀ jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.4",
            "verseOrgIds": [
              "REV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì bi ọmọkùnrin kan tí yóò fi ọ̀pá irin ṣe àkóso gbogbo àwọn orílẹ̀-èdè, a sì gba ọmọ rẹ̀ lọ sókè sí ọ̀dọ̀ Ọlọ́run, àti sí orí ìtẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà sì sálọ sí aginjù, níbi tí a gbé ti pèsè ààyè sílẹ̀ dè é láti ọwọ́ Ọlọ́run wá, pé kí wọ́n máa bọ́ ọ níbẹ̀ ní ẹgbẹ̀fà ọjọ́ ó lé ọgọ́ta (1,260).",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun sì ń bẹ ní ọ̀run: Mikaeli àti àwọn angẹli rẹ̀ bá dragoni náà jagun; dragoni sì jagun àti àwọn angẹli rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n kò sì lè ṣẹ́gun; bẹ́ẹ̀ ni a kò sì rí ipò wọn mọ́ ni ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì lé dragoni ńlá náà jáde, ejò láéláé nì, tí a ń pè ni Èṣù, àti Satani, tí ń tan gbogbo ayé jẹ: a sì lé e jù sí ilẹ̀ ayé, a sì lé àwọn angẹli rẹ̀ jáde pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì gbọ́ ohùn ńlá ní ọ̀run, wí pè:",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "\"Nígbà yìí ni ìgbàlà dé, àti agbára, àti ìjọba Ọlọ́run wá,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "àti ọlá àti Kristi rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "Nítorí a tí le olùfisùn àwọn arákùnrin wa jáde,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "tí o ń fi wọ́n sùn níwájú Ọlọ́run wa lọ́sàn án àti lóru.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ti ṣẹ́gun rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "nítorí ẹ̀jẹ̀ ọ̀dọ́-àgùntàn náà,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "àti nítorí ọ̀rọ̀ ẹ̀rí wọn,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "wọn kò sì fẹ́ràn ẹ̀mí wọn",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "àní títí dé ikú.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ẹ máa yọ̀, ẹ̀yin ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "àti ẹ̀yin tí ń gbé inú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "Ègbé ni fún ayé àti Òkun;",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "nítorí èṣù sọ̀kalẹ̀ tọ̀ yín wá ní ìbínú ńlá,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "nítorí ó mọ̀ pé ìgbà kúkúrú sá ni òun ní.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí dragoni náà rí pé a lé òun lọ sí ilẹ̀ ayé, ó ṣe inúnibíni sì obìnrin tí ó bí ọmọkùnrin náà.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì fi apá ìyẹ́ méjì tí idì ńlá náà fún obìnrin náà, pé kí ó fò lọ sí aginjù, sí ipò rẹ̀, níbi tí a ó gbe bọ ọ fún àkókò kan àti fún àwọn àkókò, àti fún ìdajì àkókò kúrò lọ́dọ̀ ejò náà.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejò náà sì tu omi jáde láti ẹnu rẹ̀ wá bí odò ńlá sẹ́yìn obìnrin náà, kí ó lè fi ìṣàn omi náà gbà á lọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ sì ran obìnrin náà lọ́wọ́, ilẹ̀ sì ya ẹnu rẹ̀, ó sì fi ìṣàn omi náà mú, tí dragoni náà tu jáde láti ẹnu rẹ̀ wá.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dragoni náà sì bínú gidigidi sí obìnrin náà, ó sì lọ bá àwọn irú-ọmọ rẹ̀ ìyókù jagun, tí wọ́n ń pa òfin Ọlọ́run mọ̀, tí wọn sì di ẹ̀rí Jesu mú, Ó sì dúró lórí iyanrìn Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
  ],
