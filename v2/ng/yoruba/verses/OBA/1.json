  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "OBA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "OBA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìran ti Obadiah.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.1",
                "verseOrgIds": [
                  "OBA.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí nípa Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "Àwa ti gbọ́ ohùn kan láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.1",
                "verseOrgIds": [
                  "OBA.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wá,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "a sì ti rán ikọ̀ kan sí gbogbo kèfèrí láti sọ pé,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "\"Ẹ dìde, ẹ jẹ́ kí a dìde ogun sí i.\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "OBA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi i, Èmi yóò sọ ọ́ di kékeré láàrín àwọn kèfèrí;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:2"
      },
      "items": [
        {
          "text": "ìwọ yóò sì di gígàn lọ́pọ̀lọ́pọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "OBA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbéraga àyà rẹ ti tàn ọ́ jẹ,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "ìwọ tí ń gbé inú pálapàla àpáta,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "tí o sì kọ́ ibùgbé rẹ sí ibi gíga,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "ìwọ wí nínú ọkàn rẹ pé,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "'Ta ni yóò mú mi sọ̀kalẹ̀?'",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "OBA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ tilẹ̀ gbé ara rẹ ga bí ẹyẹ idì,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "bí ìwọ tilẹ̀ tẹ́ ìtẹ́ rẹ sí àárín àwọn ìràwọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "láti ibẹ̀ ni èmi yóò ti sọ̀ ọ kalẹ̀,\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.4",
                "verseOrgIds": [
                  "OBA.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "OBA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí àwọn olè tọ̀ ọ́ wá,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "bí àwọn ọlọ́ṣà ní òru,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "Háà! Irú ìparun wo ló dúró dè ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "wọn kò ha jalè tó bí wọ́n ti fẹ́?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "Bí àwọn tí ń ká èso àjàrà tọ̀ ọ́ wá,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "wọn kò ha ni fi èso àjàrà díẹ̀ sílẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "OBA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni a ṣe ṣe àwárí nǹkan Esau,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:6"
      },
      "items": [
        {
          "text": "tí a sì wá ohun ìní ìkọ̀kọ̀ rẹ̀ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "OBA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ẹni ìmùlẹ̀ rẹ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "ti mú ọ dé ìpẹ̀kun ilẹ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "àwọn ọ̀rẹ́ rẹ ti tàn ọ́ jẹ, wọ́n sì ti borí rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "àwọn tó jẹ oúnjẹ rẹ dẹ pàkúté dè ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìwọ kò ní ní òye rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "OBA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.8",
                "verseOrgIds": [
                  "OBA.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Ní ọjọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "Èmi kì yóò ha pa àwọn ọlọ́gbọ́n Edomu run,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "àti àwọn amòye run kúrò ní òkè Esau?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "OBA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó ṣe ẹ̀rù ba àwọn jagunjagun rẹ, ìwọ Temani,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "gbogbo àwọn tó wà ní orí òkè Esau",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "ní a ó gé kúrò nínú ìpànìyàn náà.",
