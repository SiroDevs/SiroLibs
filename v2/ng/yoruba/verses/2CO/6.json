  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí alábáṣiṣẹ́pọ̀ nínú Ọlọ́run, ǹjẹ́, àwa ń rọ̀ yín kí ẹ má ṣe gba oore-ọ̀fẹ́ Ọlọ́run lásán.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí o wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "\"Ní àkókò ìtẹ́wọ́gbà mi, èmi tí gbọ́ ohùn rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "àti ọjọ́ ìgbàlà, èmi sì ti ràn ọ́ lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "Èmi wí fún ọ, nísinsin yìí ní àkókò ìtẹ́wọ́gbà, nísinsin yìí ni ọjọ́ ìgbàlà.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn wàhálà Paulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa kò sì gbé ohun ìkọ̀sẹ̀ kankan si ọ̀nà ẹnikẹ́ni, ki iṣẹ́ ìránṣẹ́ wa má ṣe di ìsọ̀rọ̀-òdì sí.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.3",
            "verseOrgIds": [
              "2CO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n dípò bẹ́ẹ̀, ni ọnà gbogbo, àwa ń fi ara wa hàn bí àwọn ìránṣẹ́ Ọlọ́run nínú ọ̀pọ̀lọpọ̀ sùúrù, nínú ìpọ́njú, nínú àìní, nínú wàhálà,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.4",
            "verseOrgIds": [
              "2CO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nípa nínà, nínú túbú, nínú ìrúkèrúdò, nínú iṣẹ́ àṣekára, nínú àìsàn, nínú ìgbààwẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ìwà mímọ́, nínú ìmọ̀, nínú ìpamọ́ra, nínú ìṣeun, nínú Ẹ̀mí Mímọ́, nínú ìfẹ́ àìṣẹ̀tàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú ọ̀rọ̀ òtítọ́, nínú agbára Ọlọ́run, nínú ìhámọ́ra òdodo ní apá ọ̀tún àti ní apá òsì.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ọlá àti ẹ̀gàn, nípa ìyìn búburú àti ìyìnrere: bí ẹlẹ́tàn, ṣùgbọ́n a jásí olóòtítọ́,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ẹni tí a kò mọ̀, ṣùgbọ́n a mọ̀ wá dájúdájú; bí ẹni tí ń kú lọ, ṣùgbọ́n a ṣì wà láààyè; bí ẹni tí a nà, ṣùgbọ́n a kò sì pa wá,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ẹni tí ó kún fún ìbànújẹ́, ṣùgbọ́n àwa ń yọ̀ nígbà gbogbo; bí tálákà, ṣùgbọ́n àwa ń sọ ọ̀pọ̀lọpọ̀ dí ọlọ́rọ̀; bí ẹni tí kò ní nǹkan, ṣùgbọ́n àwa ni ohun gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ará Kọrinti, a ti bá yín sọ òtítọ́ ọ̀rọ̀, a ṣí ọkàn wa páyà sí yín.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa kò fa ìfẹ́ wa sẹ́yìn fún yín, ṣùgbọ́n ẹ̀yin fa ìfẹ́ yín sẹ́yìn kúrò lọ́dọ̀ wa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní sísán padà, ní ọ̀nà tí ó dára, èmi ń sọ bí ẹni pé fún àwọn ọmọdé, ẹ̀yin náà ẹ ṣí ọkàn yín páyà pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Má ṣe dàpọ̀ pẹ̀lú àwọn aláìgbàgbọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe fi àìdọ́gba dàpọ̀ pẹ̀lú àwọn aláìgbàgbọ́, nítorí ìdàpọ̀ kín ni òdodo ní pẹ̀lú àìṣòdodo? Ìdàpọ̀ kín ni ìmọ́lẹ̀ sì ní pẹ̀lú òkùnkùn?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrẹ́pọ̀ kín ni Kristi ní pẹ̀lú Beliali? Tàbí ìpín wó ni ẹni tí ó gbàgbọ́ ní pẹ̀lú aláìgbàgbọ́?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrẹ́pọ̀ kín ni tẹmpili Ọlọ́run ní pẹ̀lú òrìṣà? Nítorí ẹ̀yin ní tẹmpili Ọlọ́run alààyè; gẹ́gẹ́ bí Ọlọ́run ti wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "\"Èmi á gbé inú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "èmi o sì máa rìn láàrín wọn,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "èmi ó sì jẹ́ Ọlọ́run wọn,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:16"
      },
      "items": [
        {
          "text": "wọn yóò sì jẹ́ ènìyàn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "\"Ẹ jáde kúrò láàrín wọn,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "kí ẹ sì yá ara yín si ọ̀tọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "ni Olúwa wí.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "Ki ẹ má ṣe fi ọwọ́ kan ohun àìmọ́;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "Èmi ó sì gbà yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "\"Èmi o sì jẹ́ Baba fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "Ẹ̀yin ó sì jẹ́ ọmọkùnrin mi àti ọmọbìnrin mi,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "ní Olúwa Olódùmarè wí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
