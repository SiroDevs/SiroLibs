  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulu aposteli Jesu Kristi nípa ìfẹ́ Ọlọ́run, àti Timotiu arákùnrin wá,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CO 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CO 1:1"
      },
      "items": [
        {
          "text": "Sí ìjọ Ọlọ́run tí ó wà ní Kọrinti pẹ̀lú gbogbo àwọn ènìyàn mímọ́ tí ó wà ní gbogbo Akaia:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oore-ọ̀fẹ́ sí yín àti àlàáfíà láti ọ̀dọ̀ Ọlọ́run Baba wa, àti Jesu Kristi Olúwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlọ́run gbogbo ìtùnú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùbùkún ni Ọlọ́run, àti Baba Jesu Kristi Olúwa wa, Baba ìyọ́nú, àti Ọlọ́run ìtùnú gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ń tù wá nínú ni gbogbo ìdààmú wa, ki àwa pẹ̀lú lè máa tu àwọn tí ó wá nínú ìdààmú nínú, nípá ìtùnú náà ti a fi ń tú àwa fúnra wa nínú láti ọ̀dọ̀ Ọlọ́run wá.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé bí àwa ti pín nínú ìjìyà Kristi, gẹ́gẹ́ bẹ́ẹ̀ nì ìtùnú wa dí púpọ̀ pẹ̀lú nípa Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí a bá sì ń pọ́n wa lójú, ó jẹ́ fún ìtùnú àti ìgbàlà yín; tàbí bi a bá ń tù wá nínú, ó jẹ́ fún ìtùnú yín ti ń ṣiṣẹ́ sùúrù láti mú yin ní irú ìfaradà ìyà kan náà ti àwa pẹ̀lú ń jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pé ìrètí wa nípa tiyín dúró ṣinṣin, àwa si mọ̀ pé, bí ẹ̀yin ti jẹ alábápín nínú ìyà wa, bẹ́ẹ̀ ni ẹ̀yin ń pín nínú ìtùnú náà pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arákùnrin àti arábìnrin, àwa kò fẹ́ kí ẹ̀yin jẹ́ òpè nípa wàhálà tí ó dé bá wa ní agbègbè Asia, ní ti pé a pọ́n wa lójú gidigidi rékọjá agbára ìfaradà wa, tó bẹ́ẹ̀ tí ìrètí kò tilẹ̀ sí fún ẹ̀mí wa mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́, nínú ọkàn wa a tilẹ̀ ní ìmọ̀lára wí pé a tí gba ìdálẹ́bi ikú, ṣùgbọ́n èyí farahàn láti má mú wa gbẹ́kẹ̀lé ara wa bí kò ṣe Ọlọ́run tí ń jí òkú dìde.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó gbà wá kúrò nínú irú ikú tí ó tóbi bẹ́ẹ̀, yóò sí tún gbà wá; òun ní àwa gbẹ́kẹ̀lé pé yóò sí máa gbà wá síbẹ̀síbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ẹ̀yin pẹ̀lú ti ń fi àdúrà yín ràn wá lọ́wọ́. Àti pé ọ̀pọ̀ ènìyàn ni yóò dúpẹ́ nítorí wa fún oore-ọ̀fẹ́ ojúrere tí a rí gbà nípa ìdáhùn sí àdúrà ọ̀pọ̀lọpọ̀ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulu yí ìpinnu rẹ̀ padà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí ní ìṣògo wá, ẹ̀rí láti inú ọkàn wa pẹ̀lú si jẹ́rìí wí pé àwa ń gbé ìgbésí ayé tí ó ní ìtumọ̀ pàápàá jùlọ nínú ìbágbépọ̀ wa pẹ̀lú yín, nínú ìwà mímọ́ àti òtítọ́ láti ọ̀dọ̀ Ọlọ́run wá. Kì í ṣe nípa ọgbọ́n ti ara ni àwa ń ṣe èyí bí kò ṣe nípa oore-ọ̀fẹ́ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé àwa kò kọ̀wé ohun tí eyín kò lè kà àti ni mòye rẹ̀ sí yín. Mo sì tún ní ìrètí wí pé.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí ẹ̀yin pẹ̀lú ti ní ìmọ̀ nípa wa ní apá kan, bákan náà ni ẹ ó ní ìmọ̀ lẹ́kùnrẹ́rẹ́ tí ẹ ó sì fi wá yangàn, bí àwa pẹ̀lú yóò ṣe fi yín yangàn ní ọjọ́ Jesu Olúwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí mo ní ìdánilójú yìí wí pé, mo pinnu láti kọ́kọ́ bẹ̀ yín wò kí ẹ lè jẹ àǹfààní ìgbà méjì.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo pinnu láti bẹ̀ yín wò ní ìrìnàjò mi sí Makedonia àti láti tún bẹ̀ yín wò nígbà tí mo bá ń padà bọ̀ láti Makedonia àti wí pé kí ẹ̀yin kí ó lè rán mi láti ọ̀dọ̀ yín ní ìrìnàjò mi sí Judea.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà nígbà tí èmi ń gbèrò bẹ́ẹ̀, èmi ha ṣiyèméjì bí? Tàbí àwọn ohun tí mo pinnu, mo ha pinnu wọn gẹ́gẹ́ bí ti ará bí, pé kí ó jẹ́ \"Bẹ́ẹ̀ ní, bẹ́ẹ̀ ní\" àti \"Bẹ́ẹ̀ kọ́, bẹ́ẹ̀ kọ́\"?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí Ọlọ́run tí jẹ́ olóòtítọ́, ọ̀rọ̀ wa fún yín kí í ṣe bẹ́ẹ̀ ni àti bẹ́ẹ̀ kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé Jesu Kristi, Ọmọ Ọlọ́run, ẹni tí a tí wàásù rẹ̀ láàrín yín nípasẹ̀ èmí àti Silfanu àti Timotiu, kì í ṣe bẹ́ẹ̀ ni bẹ́ẹ̀ kọ́, ṣùgbọ́n nínú rẹ̀ ni bẹ́ẹ̀ ní.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí gbogbo ìlérí Ọlọ́run dí bẹ́ẹ̀ ni nínú Kristi. Nítorí ìdí èyí ní a ṣe ń wí pé \"Àmín\" nípasẹ̀ rẹ̀ sí ògo Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí, Ọlọ́run ni ó fi ẹsẹ̀ wa múlẹ̀ pẹ̀lú yín nínú Kristi, Òun ni ó ti fi àmì òróró yàn wá,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì fi èdìdì rẹ̀ dì wá pẹ̀lú, ó sì tí fi Ẹ̀mí rẹ́ sí wa ní ọkàn gẹ́gẹ́ bí ẹ̀rí ìdánilójú ohun tí ó ń bọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì pe Ọlọ́run ṣe ẹlẹ́rìí ọkàn mi pé nítorí àti dá yín sí ní èmi kò ṣe padà sí Kọrinti.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
