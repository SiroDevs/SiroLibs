  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "AMO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ègbé ni fún àwọn tí ara rọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ni fún ẹ̀yin tí ará rọ̀ ní Sioni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "àti ẹ̀yin tí ẹ wà ní abẹ́ ààbò ní òkè Samaria",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "àti ẹ̀yin olókìkí orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "tí ẹ̀yin ènìyàn Israẹli máa ń tọ̀ ọ́ wá.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ lọ Kalne kí ẹ lọ wò ó",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "kí ẹ sí tí ibẹ̀ lọ sí Hamati ìlú ńlá a nì.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Kí ẹ sì tún sọ̀kalẹ̀ lọ Gati ní ilẹ̀ Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Ǹjẹ́ wọ́n ha dára ju ìpínlẹ̀ yín méjèèjì lọ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Ǹjẹ́ a ha rí ilẹ̀ tó tóbi ju tiyín lọ bí?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin sún ọjọ́ ibi síwájú,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:3"
      },
      "items": [
        {
          "text": "ẹ sì mú ìjọba òǹrorò súnmọ́ tòsí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin sùn lé ibùsùn tí a fi eyín erin ṣe",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "ẹ sì tẹ́ ara sílẹ̀ ni orí àwọn ibùsùn",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "ẹyin pa èyí tí o dára nínú àwọn ọ̀dọ́-àgùntàn yín jẹ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "ẹ sì ń pa àwọn ọ̀dọ́ màlúù láàrín agbo wọn jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ń lo ohun èlò orin bí i Dafidi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:5"
      },
      "items": [
        {
          "text": "ẹ sì ń ṣe àwọn àpilẹ̀rọ àwọn ohun èlò orin.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin mu wáìnì ẹ̀kún ọpọ́n kan",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "àti ìkunra tí o dára jùlọ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹ̀yin kò káàánú ilé Josẹfu tí ó di ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, àwọn ni yóò lọ sí ìgbèkùn",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:7"
      },
      "items": [
        {
          "text": "pẹ̀lú àwọn tí ó ti kó lọ sí ìgbèkùn",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:7"
      },
      "items": [
        {
          "text": "àsè àwọn tí ń ṣe àṣelékè ni a ó mú kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kórìíra Ìgbéraga Ọmọ Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè ti búra fúnra rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn ọmọ-ogun sì ti wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "\"Mo kórìíra ìgbéraga Jakọbu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "n kò sì ní inú dídùn sí odi alágbára rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "Èmi yóò sì fa ìlú náà lé wọn lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "àti ohun gbogbo tí ó wà nínú rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin mẹ́wàá bá ṣẹ́kù nínú ilé kan, àwọn náà yóò kú.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹbí tí ó yẹ kí ó gbé òkú wọn jáde fún sínsin bá wọlé, bí o ba sì béèrè pé ǹjẹ́ ẹnìkan wa tí ó fi ara pamọ́ níbẹ̀, \"Ǹjẹ́ ẹnìkankan wà lọ́dọ̀ yín?\" tí ó bá sì dáhùn wí pé, \"Rárá,\" nígbà náà ni yóò wí pé, \"Pa ẹnu rẹ mọ́ àwa kò gbọdọ̀ dárúkọ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.10",
                "verseOrgIds": [
                  "AMO.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.11",
                "verseOrgIds": [
                  "AMO.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "tí pa àṣẹ náà,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "Òun yóò sì wó ilé ńlá náà lulẹ̀ túútúú,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
