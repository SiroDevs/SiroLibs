  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "AMO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israẹli kò yípadà sí Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọ́ ọ̀rọ̀ yìí, ẹ̀yin màlúù Baṣani lórí òkè Samaria,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "ẹ̀yin obìnrin tí ó ń ni tálákà lára,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "tí ó ń tẹ aláìní mọ́lẹ̀, tí ó wí fún ọkọ rẹ̀, \"Gbé wá kí a sì mu!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.2",
                "verseOrgIds": [
                  "AMO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè ti fi ìwà mímọ́ rẹ̀ búra:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "\"Àkókò náà yóò dé nítòótọ́",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "nígbà tí a ó fi ìwọ̀ mú un yín lọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "ẹni tí ó kẹ́yìn pẹ̀lú ìwọ̀ ẹja.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni kọ̀ọ̀kan yín yóò jáde lọ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "gba àárín odi yíya",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "a ó sì lé e yín sí Harmoni,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.3",
                "verseOrgIds": [
                  "AMO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ lọ sí Beteli láti dẹ́ṣẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "ẹ lọ sí Gilgali kí ẹ sì dẹ́ṣẹ̀ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "Ẹ mú ẹbọ sísun yín láràárọ̀ wá,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "ìdámẹ́wàá yín ní ọdọọdún mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ mú ọ̀rẹ́ ìdúpẹ́ ìyẹ̀fun ìwúkàrà ti a sun",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "kí ẹ sì mú ọrẹ àtinúwá",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "lọ fi wọ́n yangàn, ẹ̀yin ènìyàn Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "nítorí èyí ni ẹ fẹ́ láti ṣe,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.5",
                "verseOrgIds": [
                  "AMO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi fún un yín ní mímọ́ eyín ní gbogbo ìlú yín,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "àti àìní oúnjẹ ní gbogbo ibùgbé yín,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "síbẹ̀, ẹ̀yin kò yípadà sọ́dọ̀ mi,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.6",
                "verseOrgIds": [
                  "AMO.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àti pẹ̀lú mo mú òjò dúró",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "nígbà tí ìkórè ku oṣù mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "Mo rán òjò sí ibùgbé kan",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n kò rọ̀ sí ìlú mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "Oko kan ní òjò;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "àwọn mìíràn kò ní ó sì gbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn ń rìn láti ìlú kan sí ìlú mìíràn fún omi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "wọn kò rí mu tẹ́ wọn lọ́rùn,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "síbẹ̀ ẹ̀yin kò padà sí ọ̀dọ̀ mi,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.8",
                "verseOrgIds": [
                  "AMO.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
