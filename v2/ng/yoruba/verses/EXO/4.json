  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EXO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn àmì fún Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose dáhùn ó sì wí pé, \"Ṣùgbọ́n bí wọn kò bá gbà mí gbọ́ ń kọ́? Tàbí tí wọn kò fi etí sílẹ̀ láti gbọ́ ọ̀rọ̀ ẹnu mi, tí wọn sì wí pé, '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.1",
                "verseOrgIds": [
                  "EXO.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kò farahàn ọ́'?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.2",
                "verseOrgIds": [
                  "EXO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún un pé, \"Kí ni ó wà ní ọwọ́ rẹ n nì?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:2"
      },
      "items": [
        {
          "text": "Ó sì dáhùn pé, \"Ọ̀pá ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.3",
                "verseOrgIds": [
                  "EXO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ pé, \"Sọ ọ̀pá náà sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:3"
      },
      "items": [
        {
          "text": "Mose sì sọ ọ̀pá náà sílẹ̀, lọ́gán ni ọ̀pá náà di ejò, ó sì sá fún un.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.4",
                "verseOrgIds": [
                  "EXO.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wá sọ fún un pé, \"Na ọwọ́ rẹ, kí o sì mú un ni ìrù.\" Mose sì na ọwọ́ rẹ̀, ó sì mu ejò náà, ejò náà sì padà di ọ̀pá tí ó wà ni ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, \"Èyí rí bẹ́ẹ̀ kí wọn bá à le è gbàgbọ́ pé,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn baba wọn, Ọlọ́run Abrahamu, Ọlọ́run Isaaki, àti Ọlọ́run Jakọbu; tí farahàn ọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.6",
                "verseOrgIds": [
                  "EXO.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Ti ọwọ́ rẹ bọ inú aṣọ ní igbá àyà rẹ̀.\" Mose sì ti ọwọ́ rẹ̀ bọ inú aṣọ ní igbá àyà rẹ̀, ní ìgbà ti ó sì yọ ọ́ jáde, ọwọ́ rẹ̀ ti dẹ́tẹ̀, ó sì ti funfun bí ẹ̀gbọ̀n òwú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Nísinsin yìí, fi ọwọ́ náà padà sí abẹ́ aṣọ ní igbá àyà rẹ.\" Mose sì ṣe bẹ́ẹ̀, ọwọ́ rẹ̀ sì padà bọ́ sípò bí àwọn ẹ̀yà ara rẹ̀ tókù.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.8",
                "verseOrgIds": [
                  "EXO.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Bí wọn kò bá gbà ọ́ gbọ́ tàbí kọ ibi ara sí iṣẹ́ ìyanu àkọ́kọ́, wọ́n le è ti ipasẹ̀ iṣẹ́ ìyanu kejì gbàgbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí wọn kò bá gba àmì méjèèjì wọ̀nyí gbọ́, tí wọn kò sì fetí sí ọ̀rọ̀ rẹ, bu omi díẹ̀ láti inú odò Naili kí o si dà á sí orí ìyàngbẹ ilẹ̀, omi tí ìwọ bù láti inú odò yìí yóò sì di ẹ̀jẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì sọ fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.10",
                "verseOrgIds": [
                  "EXO.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Èmi jẹ́ akólòlò, èmi kì í ṣe ẹni tó lè sọ̀rọ̀ já gaara láti ìgbà àtijọ́ wá tàbí láti ìgbà ti o ti ń bá ìránṣẹ́ rẹ sọ̀rọ̀, mo jẹ́ ẹni ti ahọ́n rẹ̀ lọ́, tí ó sì ń lọ́ra àti sọ̀rọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún un pé, \"Ta ni ó fún ènìyàn ni ẹnu? Ta ni ó mú un ya odi tàbí adití? Ta ni ó mú un ríran, tàbí mú un fọ́jú? Ǹjẹ́ kì í ṣe èmi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ nísinsin yìí, Èmi yóò ràn ọ́ lọ́wọ́ láti sọ̀rọ̀. Èmi yóò sì kọ́ ọ ni ohun ti ìwọ yóò sọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose dáhùn ó wí pé, \"Olúwa jọ̀wọ́ rán ẹlòmíràn láti lọ ṣe iṣẹ́ yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.14",
                "verseOrgIds": [
                  "EXO.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ru sókè sí Mose, ó sì sọ pé, \"Aaroni ará Lefi arákùnrin rẹ ń kọ́? Mo mọ̀ pé ó lè sọ̀rọ̀ já gaara, ó ti wà ní ọ̀nà rẹ̀ báyìí láti pàdé e rẹ. Inú rẹ̀ yóò sì dùn ti ó bá rí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sọ̀rọ̀ fún un, ìwọ yóò sì fi ọ̀rọ̀ sí i lẹ́nu, èmi yóò ràn yín lọ́wọ́ láti sọ̀rọ̀. Èmi yóò kọ́ ọ yín ni ohun ti ẹ ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò bá ọ sọ̀rọ̀ sí àwọn ènìyàn, yóò sì dàbí i pé ẹnu un rẹ ni a gbà sọ ọ̀rọ̀ náà, ìwọ yóò sì dàbí Ọlọ́run ní iwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mú ọ̀pá yìí ni ọwọ́ rẹ kí ìwọ bá à lè fi ṣe àwọn iṣẹ́ àmì ìyanu pẹ̀lú rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mose padà sí Ejibiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose padà sí ọ̀dọ̀ Jetro baba ìyàwó rẹ̀, ó sì sọ fún un pé, \"Jọ̀wọ́ jẹ́ kí n padà tọ àwọn ènìyàn mi lọ ni ilẹ̀ Ejibiti láti wò bóyá wọ́n ṣì wà láààyè síbẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:18"
      },
      "items": [
        {
          "text": "Jetro sì dáhùn, ó wí pé, \"Máa lọ ni àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.19",
                "verseOrgIds": [
                  "EXO.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún Mose ni ilẹ̀ Midiani pé, \"Máa padà lọ sí Ejibiti, nítorí àwọn ti ó fẹ́ pa ọ ti kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose mú ìyàwó rẹ̀ àti àwọn ọmọ rẹ̀, ó kó wọn lé orí kẹ́tẹ́kẹ́tẹ́, ó sì bẹ̀rẹ̀ ìrìnàjò rẹ̀ padà sí Ejibiti. Ó sì mú ọ̀pá Ọlọ́run sí ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.21",
                "verseOrgIds": [
                  "EXO.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Mose pé, \"Ní ìgbà tí ìwọ bá padà sí Ejibiti rí i pé ìwọ ṣe iṣẹ́ ìyanu ni iwájú Farao. Èmi ti fún ọ lágbára láti ṣe é. Èmi yóò sì sé àyà rẹ̀ le, òun kì yóò jẹ́ kí àwọn ènìyàn náà kí ó lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.21",
            "verseOrgIds": [
              "EXO.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, kí o sọ fún Farao pé, 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.22",
                "verseOrgIds": [
                  "EXO.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: Israẹli ní àkọ́bí ọmọ mi ọkùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mo sọ fún ọ, \"Jẹ́ kí ọmọ mi lọ, ki òun kí ó lè máa sìn mí.\" Ṣùgbọ́n ìwọ kọ̀ láti jẹ́ kí ó lọ; nítorí náà, èmi yóò pa àkọ́bí ọmọ rẹ ọkùnrin.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.23",
            "verseOrgIds": [
              "EXO.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọ̀nà ìrìnàjò rẹ, ni ibi tí wọ́n gbé sùn ní ilé èrò ní alẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.24",
                "verseOrgIds": [
                  "EXO.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "pàdé Mose, ó sì fẹ́ láti pa á.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Sippora mú ọ̀bẹ òkúta mímú, ó sì kọ ọmọ rẹ̀ ní ilà abẹ́, ó sì fi awọ rẹ̀ kan ẹsẹ̀ Mose. Sippora sì wí pé, \"Ọkọ ẹlẹ́jẹ̀ ni ìwọ jẹ́ sí mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.26",
                "verseOrgIds": [
                  "EXO.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "yọ̀ǹda rẹ láti ìgbà tí ó ti wí pé, \"Ẹlẹ́jẹ̀ ni ìwọ í ṣe.\" Èyí tó túmọ̀ sí ìkọlà abẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.27",
                "verseOrgIds": [
                  "EXO.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Aaroni pé, \"Lọ sínú aginjù láti lọ pàdé Mose.\" Ní ìgbà náà ni ó lọ pàdé Mose ní orí òkè Ọlọ́run, ó sì fi ẹnu kò ó ní ẹnu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni Mose sì sọ ohun gbogbo tí Ọlọ́run ti rán fún Aaroni àti nípa gbogbo iṣẹ́ ìyanu tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.28",
                "verseOrgIds": [
                  "EXO.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún un láti ṣe ní iwájú Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose àti Aaroni pe gbogbo àwọn àgbàgbà Israẹli jọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
              "EXO.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni sọ ohun gbogbo tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.30",
                "verseOrgIds": [
                  "EXO.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose fún wọn, ó sì ṣe iṣẹ́ àmì náà ní ojú àwọn ènìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì gbàgbọ́. Nígbà tí wọ́n gbọ́ pé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.31",
                "verseOrgIds": [
                  "EXO.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ti bẹ àwọn ọmọ Israẹli wò àti pé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.31",
                "verseOrgIds": [
                  "EXO.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbọ́ nípa ìpọ́njú wọn, wọ́n tẹríba, wọ́n sì sìn ín. Ó sì ṣe àwọn iṣẹ́ àmì náà níwájú àwọn ènìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        }
      ]
    }
