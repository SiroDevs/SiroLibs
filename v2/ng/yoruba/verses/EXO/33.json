                "verseId": "EXO.33.21",
                "verseOrgIds": [
                  "EXO.33.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, \"Ibìkan wà lẹ́gbẹ̀ẹ́ ọ̀dọ̀ mi, níbi tí o ti lè dúró lórí àpáta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ògo mi bá kọjá, Èmi yóò gbé ọ sínú pàlàpálá àpáta, Èmi yóò sì bò ọ́ pẹ̀lú ọwọ́ mi títí Èmi yóò fi rékọjá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
