  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EXO 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin òdodo àti àánú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ tan ìròyìn èké kalẹ̀. Ìwọ kò gbọdọ̀ ran ènìyàn búburú lọ́wọ́ láti jẹ́rìí èké.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ tẹ̀lé ọ̀pọ̀ ènìyàn láti ṣe aburú. Nígbà tí ìwọ bá jẹ́rìí sí ẹjọ́, ìwọ kò gbọdọ̀ yí ìdájọ́ po nípa gbígbé lẹ́yìn ọ̀pọ̀ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ìwọ kò gbọdọ̀ ṣe ojúsàájú sí tálákà nínú ẹjọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ìwọ bá ṣe alábàápàdé akọ màlúù tàbí akọ kẹ́tẹ́kẹ́tẹ́ ọ̀tá rẹ tí ó ṣìnà lọ, rí i dájú pé o mú un padà wá fún un.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá rí kẹ́tẹ́kẹ́tẹ́ ẹnìkan tí ó kórìíra rẹ tí ẹrù ṣubú lé lórí, má ṣe fi í sílẹ̀ bẹ́ẹ̀; rí i dájú pé o ran án lọ́wọ́ nípa rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ du aláìní ní ìdájọ́ òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe lọ́wọ́ nínú ẹ̀sùn èké, bẹ́ẹ̀ ni ìwọ kò gbọdọ̀ pa aláìṣẹ̀ tàbí olódodo ènìyàn, nítorí Èmi kò ní dá ẹlẹ́bi láre.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ gba àbẹ̀tẹ́lẹ̀, nítorí pé àbẹ̀tẹ́lẹ̀ ń fọ́ ojú ọlọ́gbọ́n, ó sì ń ba ọ̀rọ̀ olódodo jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ pọ́n àjèjì kan lójú, ẹ̀yin sa ti mọ inú àjèjì, nítorí ẹ̀yin náà ti jẹ́ àjèjì ní ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin Ọjọ́ Ìsinmi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ọdún mẹ́fà ni ìwọ yóò gbin oko rẹ, ìwọ yóò sì kóre èso rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ọdún keje, jẹ́ kí ilẹ̀ náà wà ní àìkọ àti ní àìlò, jẹ́ kí ilẹ̀ náà kí ó sinmi. Nígbà náà ni tálákà láàrín yín yóò rí oúnjẹ láti ibẹ̀. Ẹranko igbó yóò sì jẹ èyí tí wọ́n fi sílẹ̀. Ìwọ ṣe bákan náà pẹ̀lú ọgbà àjàrà rẹ àti ọgbà olifi rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọjọ́ mẹ́fà ni ìwọ yóò ṣe iṣẹ́ rẹ, ìwọ yóò sì sinmi ní ọjọ́ keje, kí akọ màlúù àti kẹ́tẹ́kẹ́tẹ́ rẹ bá à lè ní ìsinmi, kí a sì tú ọmọ ìránṣẹ́bìnrin rẹ àti àlejò ti ń gbé ni ilé rẹ lára.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ máa ṣọ́ra, kí ẹ sì ṣe ohun gbogbo tí mo wí fún un yín. Ẹ má ṣe pe orúkọ òrìṣà, kí a má ṣe gbọ́ orúkọ wọn ní ẹnu yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjọ̀dún Mẹ́ta Nínú Ọdún",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ìgbà mẹ́ta ni ìwọ yóò ṣe àjọ fún mi nínú ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣe àjọ àkàrà àìwú; jẹ àkàrà ti kò ní ìwúkàrà fún ọjọ́ méje, bí mo ṣe pàṣẹ fún ọ. Ṣe èyí ní àkókò tí a ti yàn ní oṣù Abibu, nítorí ni oṣù yìí ni ìwọ jáde kúrò ni ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:15"
      },
      "items": [
        {
          "text": "\"Ẹnikẹ́ni kò gbọdọ̀ wá sí iwájú mi ní ọwọ́ òfo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣe àjọ ìkórè pẹ̀lú èso àkọ́so ọ̀gbìn oko rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:16"
      },
      "items": [
        {
          "text": "\"Ṣe àjọ àkójọ oko rẹ ní òpin ọdún, nígbà tí ìwọ bá kó ìre oko rẹ jọ tan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ìgbà mẹ́ta ọ̀tọ̀ọ̀tọ̀ ni àwọn ọkùnrin yín yóò máa wá fi ara hàn ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.23.17",
                "verseOrgIds": [
                  "EXO.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ rú ẹbọ ẹ̀jẹ̀ sí mi ti òun ti àkàrà tó ní ìwúkàrà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:18"
      },
      "items": [
        {
          "text": "\"Bẹ́ẹ̀ ni ọ̀rá ẹbọ àjọ mi ni kò gbọdọ̀ kù títí di òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mú àkọ́ká èso ilẹ̀ rẹ tí ó dára jùlọ wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.23.19",
                "verseOrgIds": [
                  "EXO.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:19"
      },
      "items": [
        {
          "text": "\"Ìwọ kò gbọdọ̀ bọ ọmọ ewúrẹ́ nínú omi ọmú ìyá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Angẹli",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni yóò pèsè ọ̀nà sílẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi èmi rán angẹli kan lọ ní iwájú rẹ, láti ṣọ́ ọ ni ọ̀nà àti láti mú ọ dé ibi ti mo ti pèsè sílẹ̀ fún.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
            "verseOrgIds": [
              "EXO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ara balẹ̀, kí o sì fetísílẹ̀ sí i, kí o sì gba ohùn rẹ̀ gbọ́; má ṣe ṣọ̀tẹ̀ sí i, nítorí kò ní fi àìṣedéédéé yín jì yín, orúkọ mi wà lára rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá fetísílẹ̀ dáradára sí ohùn rẹ̀ tí ẹ sì ṣe ohun gbogbo ti mo ní kí ẹ ṣe, èmi yóò jẹ́ ọ̀tá àwọn ọ̀tá yín. Èmi yóò sì fóòro àwọn tí ń fóòro yín.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli mi yóò lọ níwájú rẹ, yóò sì mú ọ dé ọ̀dọ̀ àwọn ará: Amori, Hiti, Peresi, Kenaani, Hifi àti Jebusi, èmi a sì gé wọn kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ foríbalẹ̀ fún òrìṣà wọn, bẹ́ẹ̀ ni, ìwọ kò gbọdọ̀ sìn wọ́n, tàbí kí ẹ tẹ̀lé ìṣe wọn. Kí ìwọ kí ó si wó wọn lulẹ̀, kí ìwọ kí ó sì fọ́ ère òkúta wọ́n túútúú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin yóò sí máa sin",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.23.25",
                "verseOrgIds": [
                  "EXO.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yin, òun yóò si bùsi oúnjẹ rẹ. Èmi yóò mú àìsàn kúrò láàrín rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyún kò ní bàjẹ́ lára obìnrin kan, bẹ́ẹ̀ ni obìnrin kan kì yóò yàgàn ni ilẹ̀ rẹ. Èmi yóò fún ọ ní ẹ̀mí gígùn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi yóò rán ẹ̀rù mi lọ ṣáájú rẹ, ìdàrúdàpọ̀ yóò sì wà láàrín àwọn orílẹ̀-èdè tí ẹ bá da ojú kọ. Èmi yóò mú kí àwọn ọ̀tá rẹ yí ẹ̀yìn padà sí ọ, kí wọn sì sá ní iwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán oyin ṣáájú rẹ láti lé àwọn ará: Hifi, Kenaani àti Hiti kúrò ni ọ̀nà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, Èmi kò ni lé gbogbo wọn jáde ni ọdún kan ṣoṣo, ki ilẹ̀ náà má ba à di ahoro, àwọn ẹranko búburú yóò sì ti pọ̀jù fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Díẹ̀díẹ̀ ni èmi yóò máa lé wọn jáde kúrò ní iwájú rẹ, títí ìwọ yóò fi pọ̀ tó láti gba gbogbo ilẹ̀ náà gẹ́gẹ́ bí ìní.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi yóò fi ìdí òpin ààlà ilẹ̀ rẹ lélẹ̀ láti etí Òkun Pupa títí dé òkun àwọn ara Filistini, láti aṣálẹ̀ títí dé etí odò Eufurate, Èmi yóò fa àwọn ènìyàn ti ń gbé ilẹ̀ náà lé ọ lọ́wọ́, ìwọ yóò sì lé wọn jáde kúrò ní iwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ dá májẹ̀mú kankan pẹ̀lú wọn tàbí pẹ̀lú àwọn òrìṣà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ jẹ́ kí wọn gbé ni ilẹ̀ rẹ, bí bẹ́ẹ̀ kọ́, wọn yóò mú ọ dẹ́ṣẹ̀ sí mi: nítorí bí ìwọ bá sin òrìṣà wọn, èyí yóò jẹ́ ìdẹ̀kùn fun ọ nítòótọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
  ],
