  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EXO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aṣọ àlùfáà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ sì mú Aaroni arákùnrin rẹ wá sí ọ̀dọ̀ rẹ, mú un kúrò ni àárín àwọn ọmọ Israẹli, pẹ̀lú àwọn ọmọ rẹ̀ Nadabu, Abihu, Eleasari, àti Itamari, kí wọn kí ó lè sìn mí gẹ́gẹ́ bí àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì dá aṣọ mímọ́ fún Aaroni arákùnrin rẹ, láti fún un ni ọ̀ṣọ́ àti ọlá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì sọ fún gbogbo àwọn ọlọ́gbọ́n ènìyàn, àwọn ẹni tí mo fún ní ọgbọ́n, kí wọn kí ó lè dá aṣọ fún Aaroni, fún ìyàsímímọ́ rẹ̀, kí ó lè ba à sìn mí gẹ́gẹ́ bí àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni àwọn aṣọ tí wọn yóò dá: ìgbàyà kan, ẹ̀wù efodu, ọ̀já àmùrè kan, ẹ̀wù àwọ̀tẹ́lẹ̀ ọlọ́nà, fìlà àti aṣọ ìgúnwà. Kí wọn kí ó dá àwọn aṣọ mímọ́ yìí fún Aaroni arákùnrin rẹ àti àwọn ọmọ rẹ̀, kí wọn kí ó lè sìn mí gẹ́gẹ́ bí àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì lo wúrà, aṣọ aláró, elése àlùkò àti ti òdòdó àti ti ọ̀gbọ̀ dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀wù efodu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọn yóò sì dá ẹ̀wù efodu ti wúrà, tí aṣọ aláró, elése àlùkò àti ti òdòdó àti ti ọ̀gbọ̀ olókùn wíwẹ́, iṣẹ́ ọlọ́nà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó ni aṣọ èjìká méjì tí a so mọ́ igun rẹ̀ méjèèjì, kí a lè so ó pọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti onírúurú ọnà ọ̀já rẹ̀, tí ó wà ni orí rẹ̀, yóò rí bákan náà, gẹ́gẹ́ bi iṣẹ́ rẹ̀, tí wúrà, ti aṣọ aláró, òdòdó àti ọ̀gbọ̀ olókùn wíwẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ yóò sì mú òkúta óníkìsì méjì, ìwọ yóò sì fín orúkọ àwọn ọmọ Israẹli sára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ìbí wọn, orúkọ àwọn mẹ́fà sára òkúta kan àti orúkọ àwọn mẹ́fà tókù sára òkúta kejì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣẹ́ ọnà òkúta fínfín, bí ìfín èdìdì àmì, ni ìwọ yóò fún òkúta méjèèjì gẹ́gẹ́ bí orúkọ àwọn ọmọ Israẹli: ìwọ yóò sì dè wọ́n sí ojú ìdè wúrà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì so wọ́n pọ̀ mọ́ èjìká efodu náà ní òkúta ìrántí fún àwọn ọmọ Israẹli. Aaroni yóò sì máa ní orúkọ wọn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.12",
                "verseOrgIds": [
                  "EXO.28.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ní èjìká rẹ̀ méjèèjì fún ìrántí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì ṣe ojú ìdè wúrà,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti okùn ẹ̀wọ̀n méjì ti kìkì wúrà, gẹ́gẹ́ bí ọ̀já àmùrè kí o sì so ẹ̀wọ̀n náà mọ́ ojú ìdè náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbàyà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ yóò fi iṣẹ́ ọgbọ́n ṣe ìgbàyà fún ìpinnu iṣẹ́ ọnà gbẹ́nàgbẹ́nà. Ìwọ yóò ṣe é bí ẹ̀wù efodu ti wúrà, ti aṣọ aláró, ti elése àlùkò, ti òdòdó àti ti ọ̀gbọ̀ olókùn wíwẹ́ dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ìhà mẹ́rẹ̀ẹ̀rin rẹ̀ ṣe déédé—kí ó jẹ́ ìwọ̀n ìka kan ní ìnà àti ìwọ̀n ìka kan ní ìbú, kí o sì ṣe é ní ìṣẹ́po méjì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìwọ yóò de òkúta oníyebíye mẹ́rin sára ẹsẹ̀ rẹ̀. Ní ẹsẹ̀ àkọ́kọ́ ni kí rúbì, topasi àti berili wà;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ẹsẹ̀ kejì turikuose, emeradi, safire, àti diamọndi;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ẹsẹ̀ kẹta, jasiniti, agate, àti ametisiti;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ẹsẹ̀ kẹrin, topasi, àti óníkìsì àti jasperi. A ó sì tò wọ́n sí ojú wúrà ní dìde wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òkúta méjìlá yóò wà, ọ̀kọ̀ọ̀kan fún orúkọ àwọn ọmọ Israẹli olúkúlùkù èdìdì àmì pẹ̀lú orúkọ ẹnìkọ̀ọ̀kan bí ẹ̀yà Israẹli méjìlá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fún ìgbàyà náà, ìwọ yóò ṣe okùn ẹ̀wọ̀n ti kìkì wúrà, gẹ́gẹ́ bí ọ̀já àmùrè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò ṣe òrùka wúrà méjì fún un, kí o sì so wọ́n mọ́ igun méjèèjì ìgbàyà náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò so ẹ̀wọ̀n wúrà méjèèjì mọ́ òrùka ní igun ìgbàyà náà,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti etí ẹ̀wọ̀n méje ni kí o so mọ́ ojú ìdè méjèèjì, kí o sì fi sí èjìká ẹ̀wù efodu náà níwájú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò ṣe òrùka wúrà méjì, ìwọ yóò sì so wọ́n mọ́ igun méjì ìgbàyà kejì ní ìhà inú tí ó ti ẹ̀wù efodu náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì ṣe òrùka wúrà méjì, ìwọ yóò sì fi wọ́n sí èjìká ẹ̀wù efodu méjèèjì ní ìsàlẹ̀, sí ìhà iwájú rẹ̀, tí ó súnmọ́ ojú sí ìránṣọ náà, lókè onírúurú ọnà ọ̀já ẹ̀wù efodu náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì so òrùka ìgbàyà mọ́ òrùka ẹ̀wù efodu pẹ̀lú ọ̀já aláró, pa á pọ̀ mọ́ ìgbànú, kí a má ba à tú ìgbàyà náà kúrò lára ẹ̀wù efodu náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbàkígbà tí Aaroni bá wọ Ibi Mímọ́, òun yóò ru orúkọ àwọn ọmọ Israẹli ní gbogbo ọ̀kan rẹ̀ ni ìgbàyà ìpinnu bí ìrántí nígbà gbogbo níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.29",
                "verseOrgIds": [
                  "EXO.28.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bákan náà ìwọ yóò sì mu Urimu àti Tumimu sínú ìgbàyà, kí wọn kí ó wà ní ọkàn Aaroni nígbàkígbà tí ó bá ń wólẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.30",
                "verseOrgIds": [
                  "EXO.28.30"
                ]
              }
            }
          ]
        },
        {
          "text": ". Aaroni yóò sì máa ru ohun ti a ń fi ṣe ìpinnu fún àwọn ọmọ Israẹli ní ọkàn rẹ̀ nígbà gbogbo níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.30",
                "verseOrgIds": [
                  "EXO.28.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn Aṣọ Àlùfáà Mìíràn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ yóò ṣì ṣe aṣọ ìgúnwà ẹ̀wù efodu náà ní kìkì aṣọ aláró,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "pẹ̀lú ojú ọrùn kí ó wà láàrín rẹ̀ fún orí. Kí iṣẹ́ ọ̀nà wà létí rẹ̀ bí ìṣẹ́tí yí i ká bí agbádá, kí ó má ba à ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe pomegiranate ti aṣọ aláró, ti elése àlùkò àti ti òdòdó yí ìṣẹ́tí ọ̀já àmùrè náà ká, pẹ̀lú ṣaworo wúrà láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ṣaworo wúrà àti àwọn pomegiranate ni kí ó yí ìṣẹ́tí ọ̀já àmùrè náà ká.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni gbọdọ̀ máa wọ̀ ọ́ nígbà tí o bá ń ṣiṣẹ́. A ó sì máa gbọ́ ìró àwọn agogo nígbà tí ó bá ń wọ Ibi Mímọ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.35",
                "verseOrgIds": [
                  "EXO.28.35"
                ]
              }
            }
          ]
        },
        {
          "text": "àti nígbà tí ó bá ń jáde bọ̀, kí ó má ba à kú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ yóò sì ṣe àwo kìkì wúrà, ìwọ yóò sì fín sára rẹ̀ bí, fínfín èdìdì àmì pé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "EXO 28:36"
      },
      "items": [
        {
          "text": "Mímọ́ sí Olúwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò fi ọ̀já aláró sára rẹ̀ ìwọ yóò sì so ó mọ́ fìlà náà; kí ó sì wà níwájú fìlà náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó wà níwájú orí Aaroni, kí ó sì lè máa ru ẹ̀bi tí ó jẹ mọ́ ẹ̀bùn mímọ́ ti àwọn ọmọ Israẹli ti yà sí mímọ́, èyíkéyìí tí ẹ̀bùn wọn lè jẹ́. Yóò máa wà níwájú orí Aaroni nígbà gbogbo, kí wọn lè jẹ́ ìtẹ́wọ́gbà fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.38",
                "verseOrgIds": [
                  "EXO.28.38"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ yóò sì fi ọ̀gbọ̀ dáradára hun ẹ̀wù àwọ̀tẹ́lẹ̀, ìwọ yóò sì fi ọ̀gbọ̀ dáradára ṣe fìlà. Ìwọ yóò sì fi iṣẹ́ abẹ́rẹ́ ṣe ọ̀já àmùrè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì dá ẹ̀wù àwọ̀tẹ́lẹ̀, ọ̀já àmùrè àti ìgbàrí fún àwọn ọmọ Aaroni, láti fún wọn ní ọ̀ṣọ́ àti ọlá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí ìwọ ti fi àwọn aṣọ wọ̀nyí wọ Aaroni arákùnrin rẹ, ìwọ yóò sì fi wọ àwọn ọmọ rẹ̀ pẹ̀lú, ìwọ ó ta òróró sí wọn ní orí, ìwọ yóò sì ya wọ́n sí mímọ́. Ìwọ yóò sì sọ wọ́n di mímọ́, kí wọn kí o lè máa ṣe iṣẹ́ àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ yóò dá ṣòkòtò ọ̀gbọ̀ fún wọn, kí wọn lè máa fi bo ìhòhò wọn, kí ó dé ìbàdí dé itan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni àti àwọn ọmọ rẹ̀ gbọdọ̀ wọ̀ wọ́n nígbàkígbà tí wọ́n bá wọ àgọ́ àjọ lọ tàbí nígbà tí wọ́n bá súnmọ́ pẹpẹ láti ṣiṣẹ́ ní Ibi Mímọ́ kí wọn kí ó má ba à dẹ́ṣẹ̀, wọn a sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 28:43"
      },
      "items": [
        {
          "text": "\"Èyí jẹ́ ìlànà láéláé fún Aaroni àti fún irú-ọmọ rẹ̀ lẹ́yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    }
  ],
