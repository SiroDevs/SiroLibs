          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó lò ó láti fi ṣe ihò ìtẹ̀bọ̀ fún ẹnu-ọ̀nà àgọ́ àjọ, pẹpẹ idẹ náà pẹ̀lú ààrò idẹ rẹ̀ àti gbogbo ohun èlò rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
