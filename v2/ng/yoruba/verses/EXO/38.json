              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idẹ ara ọrẹ náà jẹ́ àádọ́rin tálẹ́ǹtì àti egbèjìlá (2,400) ṣékélì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
