                "verseOrgIds": [
                  "EXO.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún wọn. Ó gbé ọ̀pá rẹ̀ sókè ni iwájú Farao àti àwọn ìjòyè rẹ̀, ó sì lu omi odò Naili, omi odò náà sì yípadà sí ẹ̀jẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
