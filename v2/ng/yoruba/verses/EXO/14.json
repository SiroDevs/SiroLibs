  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "EXO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.1",
                "verseOrgIds": [
                  "EXO.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.1",
            "verseOrgIds": [
              "EXO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn ọmọ Israẹli kí wọn padà sẹ́yìn, kí wọ́n sì pàgọ́ sí tòsí Pi-Hahirotu láàrín Migdoli òun Òkun, kí wọn kí ó pàgọ́ sí ẹ̀bá Òkun, ní òdìkejì Baali-Ṣefoni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.2",
            "verseOrgIds": [
              "EXO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao yóò ronú pé àwọn ọmọ Israẹli ń ráre káàkiri ní ìdààmú ni àti wí pé aginjù náà ti sé wọn mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.3",
            "verseOrgIds": [
              "EXO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sé ọkàn Farao le ti yóò fi lépa wọn. Ṣùgbọ́n èmi yóò gba ògo fún ará mi láti ìpàṣẹ Farao àti ogun rẹ̀, àti pé àwọn ará Ejibiti yóò mọ̀ pé Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.4",
                "verseOrgIds": [
                  "EXO.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Àwọn Israẹli sì ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sọ fún ọba Ejibiti pé àwọn ènìyàn náà ti sálọ, ọkàn Farao àti àwọn ìránṣẹ́ rẹ̀ yí padà sí àwọn ènìyàn, wọ́n sì wí pé, \"Kí ni ohun tí àwa ṣe yìí? Àwa ti jẹ́ kí àwọn ọmọ Israẹli kí ó lọ, a sì ti pàdánù ìsìnrú wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.5",
            "verseOrgIds": [
              "EXO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì di kẹ̀kẹ́-ẹṣin rẹ̀, ó sì kó àwọn ọmọ-ogun rẹ̀ pẹ̀lú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.6",
            "verseOrgIds": [
              "EXO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó mú ẹgbẹ̀ta (600) ọmọ-ogun oníkẹ̀kẹ́ tí ó jáfáfá jùlọ àti gbogbo ọmọ-ogun oníkẹ̀kẹ́ mìíràn ní Ejibiti, olórí sì wà fún olúkúlùkù wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.7",
            "verseOrgIds": [
              "EXO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.8",
                "verseOrgIds": [
                  "EXO.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sé ọkàn Farao ọba Ejibiti le, ó sì bẹ̀rẹ̀ sí lépa àwọn ọmọ Israẹli ti ń jáde lọ ní àìbẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Ejibiti ń lépa wọn pẹ̀lú gbogbo ẹṣin kẹ̀kẹ́ ogun Farao àti àwọn ẹlẹ́ṣin rẹ̀, wọ́n sì lé wọn bá ni ibi tí wọ́n pa àgọ́ sí lẹ́bàá òkun ní ìhà Pi-Hahirotu, ni òdìkejì Baali-Ṣefoni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.9",
            "verseOrgIds": [
              "EXO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Farao ti súnmọ́ tòsí ọ̀dọ̀ wọn, àwọn ọmọ Israẹli gbé ojú wọn sókè, wọn sì rí àwọn ará Ejibiti tó súnmọ́ wọn. Ẹ̀rù ńlá sì bá àwọn ará Israẹli, wọ́n kígbe sókè sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.10",
            "verseOrgIds": [
              "EXO.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.10",
                "verseOrgIds": [
                  "EXO.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.10",
            "verseOrgIds": [
              "EXO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sọ fún Mose pé, \"Ṣe nítorí pé kò sí ibojì ni Ejibiti ní ìwọ ṣe mú wa wá láti kú sínú aginjù? Kí ni èyí tí ìwọ ṣe sí wa ti ìwọ fi mú wa jáde láti Ejibiti wá?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.11",
            "verseOrgIds": [
              "EXO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ èyí kọ́ ni àwa sọ fún ọ ni Ejibiti, 'Fi wá sílẹ̀, jẹ́ kí àwa máa sin ará Ejibiti'? Nítorí kò bá sàn fún wa kí a sin àwọn ará Ejibiti ju kí a kú sínú aginjù yìí lọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.12",
            "verseOrgIds": [
              "EXO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose sọ fún àwọn ènìyàn náà pé, \"Ẹ má bẹ̀rù, ẹ dúró ṣinṣin kí ẹ sì rí ìdáǹdè tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
              "EXO.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.13",
                "verseOrgIds": [
                  "EXO.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi fún un yín lónìí, àwọn ará Ejibiti ti ẹ̀yin rí lónìí ni ẹ kò ni tún padà rí wọn mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
              "EXO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.14",
                "verseOrgIds": [
                  "EXO.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò jà fún un yín; kí ẹ̀yin kí ó sá à mu sùúrù.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.15",
                "verseOrgIds": [
                  "EXO.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Èéṣe tí ìwọ fi ń ké pè mí? Sọ fún àwọn ará Israẹli kí wọn máa tẹ̀síwájú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, gbé ọ̀pá rẹ̀ sókè, kí o sì na ọwọ́ rẹ sí orí omi Òkun, kí ó lè pín ní yà kí àwọn ọmọ Israẹli lè la òkun kọjá ni orí ìyàngbẹ ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.16",
            "verseOrgIds": [
              "EXO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni èmi yóò sé ọkàn àwọn ará Ejibiti le, wọn yóò sì máa lépa wọn; Èmi yóò gba ògo fún ara mi lórí Farao; lórí gbogbo ogun rẹ̀, lórí kẹ̀kẹ́ ogun àti lórí àwọn ẹlẹ́ṣin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.17",
            "verseOrgIds": [
              "EXO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Ejibiti yóò mọ̀ pé Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.18",
                "verseOrgIds": [
                  "EXO.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nígbà ti èmi bá gba ògo fún ara mi lórí Farao: lórí kẹ̀kẹ́ ogun rẹ̀ àti lórí àwọn ẹlẹ́ṣin rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni angẹli Ọlọ́run tó ti ń ṣáájú ogun Israẹli lọ, padà o sì rìn ni ẹ̀yìn wọn; Òpó ìkùùkuu tí ń rìn ni iwájú wọn sì padà sí í rìn ni ẹ̀yìn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.19",
            "verseOrgIds": [
              "EXO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wà láàrín àwọn ọmọ-ogun Ejibiti àti Israẹli. Ìkùùkuu sì ṣú òkùnkùn sí àwọn ará Ejibiti ni òru náà. Ṣùgbọ́n ó tan ìmọ́lẹ̀ sí àwọn Israẹli ni òru náà, ọ̀kan kò sì súnmọ́ èkejì ni gbogbo òru náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose na ọwọ́ rẹ̀ sí orí Òkun, ni gbogbo òru náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.21",
                "verseOrgIds": [
                  "EXO.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "fi lé òkun sẹ́yìn pẹ̀lú ìjì líle láti ìlà-oòrùn wá, ó sì sọ ọ́ di ìyàngbẹ ilẹ̀. Omi òkun sì pínyà,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ọmọ Israẹli sì la ìyàngbẹ ilẹ̀ kọjá nínú òkun pẹ̀lú ògiri omi ní ọ̀tún àti òsì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Ejibiti sì ń lépa wọn, gbogbo ẹṣin Farao, kẹ̀kẹ́ ogun àti àwọn ẹlẹ́ṣin rẹ̀ wọ́ tọ̀ wọ́n lọ sínú òkun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.23",
            "verseOrgIds": [
              "EXO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìṣọ́ òwúrọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.24",
                "verseOrgIds": [
                  "EXO.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "bojú wo ogun àwọn ará Ejibiti láàrín ọ̀wọ̀n iná àti ìkùùkuu, ó sì kó ìpayà bá àwọn ọmọ-ogun Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì yọ àgbá ẹsẹ̀ kẹ̀kẹ́ ogun wọn kí ó bá à le ṣòro fún wọn láti fi kẹ̀kẹ́ ogun náà rìn. Àwọn ará Ejibiti wí pé, \"Ẹ jẹ́ kí a sá àsálà kúrò ní iwájú àwọn ará Israẹli nítorí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.25",
                "verseOrgIds": [
                  "EXO.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bá wa jà nítorí wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.26",
                "verseOrgIds": [
                  "EXO.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Mose pé, \"Na ọwọ́ rẹ sí orí òkun kí omi òkun lè ya padà sórí àwọn ará Ejibiti, kẹ̀kẹ́ ogun wọn àti sórí ẹlẹ́ṣin wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì na ọwọ́ rẹ̀ sí orí òkun, òkun sì padà bọ́ sí ipò rẹ̀ nígbà ti ilẹ̀ mọ́. Àwọn ará Ejibiti ń sá fún omi òkun,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.27",
                "verseOrgIds": [
                  "EXO.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sì gbá wọn sínú òkun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi òkun sì ya padà, ó sì bo kẹ̀kẹ́ ogun àti àwọn ẹlẹ́ṣin: àní, gbogbo ọmọ-ogun Farao tiwọn wọ inú òkun tọ àwọn ọmọ Israẹli lọ kò sí ọ̀kan nínú wọn tí ó yè.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
              "EXO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ará Israẹli la òkun kọjá lórí ìyàngbẹ ilẹ̀ pẹ̀lú ògiri omi ni ọ̀tún àti òsì wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ọjọ́ yìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.30",
                "verseOrgIds": [
                  "EXO.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "gba Israẹli là kúrò lọ́wọ́ àwọn ará Ejibiti; Israẹli sì rí òkú àwọn ará Ejibiti ni etí òkun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti àwọn ọmọ Israẹli rí iṣẹ́ ìyanu ńlá ti",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.31",
                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe fún wọn lára àwọn ará Ejibiti, àwọn ènìyàn bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.31",
                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì gba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.31",
                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "àti Mose ìránṣẹ́ rẹ gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        }
