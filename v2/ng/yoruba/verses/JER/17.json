      "items": [
        {
          "text": "Pípa ọjọ́ ìsinmi mọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.19",
                "verseOrgIds": [
                  "JER.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún mi: \"Lọ dúró ní ẹnu-ọ̀nà àwọn ènìyàn níbi tí àwọn ọba Juda ń gbà wọlé tí wọ́n ń gbà jáde àti ní gbogbo ẹnu-bodè Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún wọ́n pé, 'Ẹ gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.20",
                "verseOrgIds": [
                  "JER.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ẹ̀yin ọba Juda àti gbogbo ẹ̀yin ènìyàn Juda àti gbogbo ẹ̀yin tí ń gbé ní Jerusalẹmu tí ń wọlé láti ẹnu ibodè yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.21",
                "verseOrgIds": [
                  "JER.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, \"Ẹ kíyèsi láti máa ru ẹrù lọ́jọ́ ìsinmi tàbí kí ẹ gbé wọlé láti ẹnu ibodè Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe gbé ẹrù jáde kúrò nínú ilé yín, bẹ́ẹ̀ ni kí ẹ má ṣe ṣe iṣẹ́kíṣẹ́ ní ọjọ́ ìsinmi ṣùgbọ́n kí ẹ pa ọjọ́ ìsinmi mọ́ fún àwọn baba ńlá yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ wọn kò gbọ́ tàbí tẹ́tí sílẹ̀, wọ́n jẹ́ ọlọ́rùn líle; wọn kì í fẹ́ gbọ́ tàbí gba ìbáwí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ẹ̀yin bá kíyèsi láti gbọ́ tèmi ní",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.24",
                "verseOrgIds": [
                  "JER.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, tí ẹ kò sì gbe ẹrù gba ẹnu-bodè ìlú ní ọjọ́ ìsinmi, ṣùgbọ́n tí ẹ ya ọjọ́ ìsinmi, sí mímọ́, nípa pé ẹ kò ṣe iṣẹ́kíṣẹ́ ní ọjọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba tí ó jókòó lórí ìtẹ́ Dafidi yóò gba ẹnu ibodè wọlé pẹ̀lú àwọn ìjòyè rẹ̀. Àwọn àti ìjòyè wọn yóò gun ẹṣin àti kẹ́tẹ́kẹ́tẹ́ wá, àwọn ọkùnrin Juda àti àwọn olùgbé Jerusalẹmu yóò tẹ̀lé wọn; ìlú yìí yóò sì di ibi gbígbé títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.25",
            "verseOrgIds": [
              "JER.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yóò wá láti ìlú Juda àti ní agbègbè Jerusalẹmu, láti ilẹ̀ Benjamini, láti pẹ̀tẹ́lẹ̀, àti láti òkè, àti láti gúúsù wá, wọn yóò wá pẹ̀lú ọrẹ ẹbọ sísun, àti ọrẹ ẹran, àti tùràrí, àti àwọn tó mú ìyìn wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.26",
                "verseOrgIds": [
                  "JER.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹ̀yin kò bá pa òfin mi mọ́ láti ya ọjọ́ ìsinmi sí mímọ́, kí ẹ má sì ṣe ru ẹrùkẹ́rù bí ẹ̀yin yóò ṣe máa gba ẹnu ibodè Jerusalẹmu wọlé ní ọjọ́ ìsinmi, nígbà náà ni èmi yóò da iná tí kò ní ṣe é parun ní ẹnu-bodè Jerusalẹmu tí yóò sì jó odi agbára rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.27",
            "verseOrgIds": [
              "JER.17.27"
            ]
          }
        }
      ]
    }
  ],
