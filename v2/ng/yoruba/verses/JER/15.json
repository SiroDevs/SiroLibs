        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.16",
                "verseOrgIds": [
                  "JER.15.16"
                ]
              }
            }
          ]
        },
