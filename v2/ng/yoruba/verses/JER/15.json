          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọ̀rọ̀ rẹ dé, mo jẹ wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
