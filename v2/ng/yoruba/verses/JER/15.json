      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:12"
      },
      "items": [
        {
          "text": "irin láti àríwá tàbí idẹ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
