          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Háà! Ó ṣe tí ìyá mi bí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "ọkùnrin tí gbogbo ilẹ̀ dojúkọ tí wọ́n sì bá jà!",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "Èmi kò wínni, bẹ́ẹ̀ ni èmi kò yá lọ́wọ́ ẹnikẹ́ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "síbẹ̀, gbogbo ènìyàn ló ń fi mí ré.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
