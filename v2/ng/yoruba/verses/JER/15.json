      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "nígbà ibi àti ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
