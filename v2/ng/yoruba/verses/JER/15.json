          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí ìrora mi kò lópin,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:18"
      },
      "items": [
        {
          "text": "tí ọgbẹ́ mi kò sì ṣe é wòsàn?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:18"
      },
      "items": [
        {
          "text": "Ní òtítọ́ ìwọ yóò dàbí kànga ẹ̀tàn sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:18"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ìsun tó kọ̀ tí kò sun?",
