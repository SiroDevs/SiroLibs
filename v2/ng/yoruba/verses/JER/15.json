      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:13"
      },
      "items": [
        {
          "text": "jákèjádò orílẹ̀-èdè rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        }
      ]
    },
    {
