          "text": "sọ pé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "\"Dájúdájú èmi ò dá ọ sí fún ìdí kan pàtó;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "dájúdájú mo mú kí àwọn ọ̀tá rẹ tẹríba níwájú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
