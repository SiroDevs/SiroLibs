          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.19",
                "verseOrgIds": [
                  "JER.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        }
      ]
    },
