      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:19"
      },
      "items": [
        {
          "text": "\"Tí o bá ronúpìwàdà, Èmi ó dá ọ padà wá",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:19"
      },
      "items": [
        {
          "text": "kí o lè máa sìn mí;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:19"
      },
