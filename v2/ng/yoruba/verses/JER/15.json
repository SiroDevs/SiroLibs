          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò fìgbà kan jókòó láàrín àwọn ẹlẹ́gàn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:17"
      },
      "items": [
        {
          "text": "n ko bá wọn yọ ayọ̀ pọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:17"
      },
      "items": [
        {
          "text": "mo dá jókòó torí pé ọwọ́ rẹ wà lára mi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:17"
      },
      "items": [
        {
          "text": "ìwọ sì ti fi ìbínú rẹ kún inú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
