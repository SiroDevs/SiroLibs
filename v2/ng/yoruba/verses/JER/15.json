          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:15"
      },
      "items": [
        {
          "text": "Ìwọ ti jìyà fún ìgbà pípẹ́, má ṣe mú mi lọ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:15"
      },
      "items": [
        {
          "text": "nínú bí mo ṣe jìyà nítorí tìrẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
