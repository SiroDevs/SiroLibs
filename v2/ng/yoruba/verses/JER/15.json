      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:16"
      },
      "items": [
        {
          "text": "nítorí pé orúkọ rẹ ni a fi ń pè mí,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:16"
      },
      "items": [
