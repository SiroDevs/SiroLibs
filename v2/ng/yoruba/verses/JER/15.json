      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:16"
      },
      "items": [
        {
          "text": "àwọn ni ìdùnnú àti ayọ̀ ọkàn mi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
    },
