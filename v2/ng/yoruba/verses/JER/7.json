  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JER 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀sìn àìṣòótọ́ kò níláárí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ọ̀rọ̀ tó tọ Jeremiah wá láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.1",
                "verseOrgIds": [
                  "JER.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dúró ní ẹnu-ọ̀nà ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kí o sì kéde ọ̀rọ̀ yí:",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 7:2"
      },
      "items": [
        {
          "text": "\" 'Ẹ gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gbogbo ẹ̀yin ará Juda tí ń gba ọ̀nà yí wọlé láti wá sin",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ọ̀rọ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.3",
                "verseOrgIds": [
                  "JER.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun Ọlọ́run Israẹli wí: Tún àwọn ọ̀nà yín ṣe, èmi yóò sì jẹ́ kí ẹ gbé ilẹ̀ yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe gba ọ̀rọ̀ ẹ̀tàn gbọ́ kí ẹ sì wí pé, \"Èyí ni tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ilé tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ilé tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ̀yin bá tún ọ̀nà yín àti iṣẹ́ yín ṣe nítòótọ́, tí ẹ sì ń bá ara yín lò ní ọ̀nà tó tọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ kò bá fi ara ni àwọn àlejò, àwọn ọmọ aláìní baba àti àwọn opó tí ẹ kò sì ta ẹ̀jẹ̀ aláìṣẹ̀ sílẹ̀ ní ibí yìí, bí ẹ kò bá sì tọ ọlọ́run mìíràn lẹ́yìn sí ìpalára ara yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.6",
            "verseOrgIds": [
              "JER.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni èmi yóò jẹ́ kí ẹ gbé ìbí yìí, nílẹ̀ tí mo fún àwọn baba ńlá yín títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wò ó, ẹ ń gba ọ̀rọ̀ ẹ̀tàn tí kò níláárí gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.8",
            "verseOrgIds": [
              "JER.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹ̀yin yóò ha jalè, kí ẹ pànìyàn, kí ẹ ṣe panṣágà, kí ẹ búra èké, kí ẹ sun tùràrí sí Baali, kí ẹ sì tọ ọlọ́run mìíràn tí ẹ̀yin kò mọ̀ lọ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.9",
            "verseOrgIds": [
              "JER.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni kí ó wá dúró ní iwájú nínú ilé yìí tí a fi orúkọ mi pè, \"Kí ẹ wá wí pé àwa yè,\" àwa yè láti ṣe gbogbo àwọn nǹkan ìríra wọ̀nyí bí?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.10",
            "verseOrgIds": [
              "JER.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé ilé yìí, tí a fi orúkọ mi pè ti di ihò àwọn ọlọ́ṣà lọ́dọ̀ yín ni? Èmi ti ń wò ó! ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.11",
                "verseOrgIds": [
                  "JER.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹ lọ nísinsin yìí sí Ṣilo níbi ti mo kọ́ fi ṣe ibùgbé fún orúkọ mi, kí ẹ sì rí ohun tí mo ṣe sí i nítorí ìwà búburú Israẹli tí í ṣe ènìyàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ̀yin ń ṣe àwọn nǹkan wọ̀nyí ni èmi bá a yín sọ̀rọ̀ léraléra ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.13",
                "verseOrgIds": [
                  "JER.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí ẹ̀yin kò gbọ́, èmi pè yín, ẹ̀yin kò dáhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, èmi yóò ṣe ohun tí mo ṣe sí Ṣilo sí ilé náà tí a fi orúkọ mi pè, ilé tẹmpili nínú èyí tí ẹ ní ìgbẹ́kẹ̀lé, ààyè tí mo fún ẹ̀yin àti àwọn baba yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò tú kúrò ní iwájú mi gẹ́gẹ́ bí mo ti ṣe sí àwọn arákùnrin yín, àwọn ará Efraimu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà má ṣe gbàdúrà fún àwọn ènìyàn wọ̀nyí tàbí kí o bẹ̀bẹ̀ fún wọn; ma ṣe bẹ̀ mí, nítorí èmi kì yóò tẹ́tí sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé ìwọ kò rí ohun tí wọ́n ń ṣe ní àwọn ìlú Juda àti ní òpópó Jerusalẹmu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ ṣa igi jọ, àwọn baba fi iná sí i, àwọn ìyá sì po ìyẹ̀fun láti ṣe àkàrà fún ayaba ọ̀run, wọ́n tú ẹbọ ọrẹ mímu sí àwọn ọlọ́run àjèjì láti ru bínú mi sókè.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ṣe èmi ni wọ́n fẹ́ mú bínú? ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.19",
                "verseOrgIds": [
                  "JER.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. Ǹjẹ́ kì í ṣe pé wọ́n kúkú ń pa ara wọn lára sí ìtìjú ara wọn?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nítorí náà, èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.20",
                "verseOrgIds": [
                  "JER.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, \"Èmi yóò tú ìbínú àti ìrunú mi sí orílẹ̀ yìí ènìyàn àti ẹranko, igi, pápá àti èso orí ilẹ̀, yóò sì jó tí kò ní ṣe é pa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.21",
                "verseOrgIds": [
                  "JER.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn ọmọ-ogun, Ọlọ́run Israẹli wí: Tẹ̀síwájú kí ẹ kó ẹbọ sísun yín àti àwọn ẹbọ yòókù papọ̀ kí ẹ̀yin kí ó sì jẹ ẹran wọ́n fúnra yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní tòsí nígbà tí mo mú àwọn baba ńlá yín jáde kúrò ní ilẹ̀ Ejibiti tí mo sì bá wọn sọ̀rọ̀. N kò pàṣẹ fún wọn lórí ẹbọ sísun lásán.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo pàṣẹ fún wọn báyìí pé; gbọ́ tèmi, èmi yóò sì jẹ́ Ọlọ́run yín ẹ̀yin yóò sì jẹ́ ènìyàn mi. Máa rìn ní ojú ọ̀nà tí mo pàṣẹ fún yín, kí ó lè dára fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọn kò gbọ́, wọn kò sì fetísílẹ̀ dípò èyí wọ́n ń tẹ̀ sí ọ̀nà agídí ọkàn wọn. Dípò kí wọn tẹ̀síwájú wọ́n ń rẹ̀yìn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ìgbà tí àwọn baba ńlá yín ti jáde ní Ejibiti títí di òní, ni èmi ti ń rán àwọn ìránṣẹ́ mi, àwọn wòlíì sí yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò gbọ́ wọn kò sì fetísílẹ̀. Wọ́n wa ọrùn le, wọn wa ọrùn kì, wọ́n sì hu ìwà ìbàjẹ́ ju àwọn baba ńlá wọn.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ìwọ bá sọ gbogbo èyí fún wọn, wọn kì yóò gbọ́ tirẹ̀, nígbà tí ìwọ bá sì pè wọ́n, wọn kì yóò dáhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, sọ fún wọn pé, 'Èyí ni orílẹ̀-èdè tí kò gbọ́ ti",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.28",
                "verseOrgIds": [
                  "JER.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀ tàbí kí ó ṣe ìgbọ́ràn sí ìbáwí. Ọ̀rọ̀ òtítọ́ kò sí ní ètè wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gé irun yín kí ẹ sì dàánù, pohùnréré ẹkún lórí òkè, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.29",
                "verseOrgIds": [
                  "JER.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kọ ìran yìí tí ó wà lábẹ́ ìbínú rẹ̀ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àfonífojì ìparun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn ènìyàn Juda ti ṣe búburú lójú mi, ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.30",
                "verseOrgIds": [
                  "JER.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. Wọ́n ti to àwọn ère ìríra wọn jọ sí ilé tí a fi orúkọ mi pè wọ́n sì ti sọ ọ́ di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ti kọ́ àwọn ibi gíga ti Tofeti ní àfonífojì Beni-Hinnomu láti sun àwọn ọmọkùnrin àti ọmọbìnrin wọn nínú iná èyí tí èmi kò pàṣẹ tí kò sì wá sí ọkàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà kíyèsára ọjọ́ ń bọ̀, ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.32",
                "verseOrgIds": [
                  "JER.7.32"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, nígbà tí àwọn ènìyàn kò ní pè é ní Tafeti tàbí àfonífojì ti Beni-Hinnomu; ṣùgbọ́n yóò ma jẹ àfonífojì ìparun, nítorí wọn yóò sin òkú sí Tofeti títí kò fi ní sí ààyè mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni òkú àwọn ènìyàn wọ̀nyí yóò di oúnjẹ fún àwọn ẹyẹ ojú ọ̀run àti ẹranko ilẹ̀, kò sì ní sí ẹnìkan tí yóò dẹ́rùbà wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú òpin bá ìró ayọ̀ àti ìdùnnú àti ohùn àwọn tọkọtaya ní àwọn ìlú Juda àti ní ìgboro Jerusalẹmu, nítorí tí ilẹ̀ náà yóò di ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
            "verseOrgIds": [
              "JER.7.34"
            ]
          }
        }
      ]
    }
  ],
