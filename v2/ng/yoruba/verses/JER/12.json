  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JER 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀ Jeremiah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.12.1",
                "verseOrgIds": [
                  "JER.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", olódodo ni ọ́ nígbàkígbà,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "nígbà tí mo mú ẹjọ́ kan tọ̀ ọ́ wá.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Síbẹ̀ èmi yóò bá ọ sọ̀rọ̀ nípa òdodo rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Èéṣe tí ọ̀nà àwọn ènìyàn búburú fi ń ṣe déédé?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Èéṣe tí gbogbo àwọn aláìṣòdodo sì ń gbé ní ìrọ̀rùn?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti gbìn wọ́n, wọ́n sì ti fi egbò múlẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "wọ́n dàgbà wọ́n sì so èso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "Gbogbo ìgbà ni ó wà ní ètè wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "o jìnnà sí ọkàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ o mọ̀ mí ní",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.12.3",
                "verseOrgIds": [
                  "JER.12.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "o ti rí mi o sì ti dán èrò mi nípa rẹ wò.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Wọ, wọ́n lọ bí àgùntàn tí a fẹ́ pa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Yà wọ́n sọ́tọ̀ fún ọjọ́ pípa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò ti pẹ́ tó tí ọ̀gbẹlẹ̀ yóò fi wà,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "tí gbogbo ewéko igbó sì ń rọ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Nítorí àwọn ènìyàn búburú ni ó ń gbé ibẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Àwọn ẹranko àti àwọn ẹyẹ ti ṣègbé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "pẹ̀lúpẹ̀lú àwọn ènìyàn ń sọ pé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "\"Kò lè rí ohun tó ṣẹlẹ̀ sí wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáhùn Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá ń bá ẹlẹ́ṣẹ̀ sáré,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "tí àárẹ̀ sì mú ọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "báwo ni ìwọ yóò ṣe bá ẹṣin díje?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "Bí ìwọ bá kọsẹ̀ ní ilẹ̀ àlàáfíà,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "bí ìwọ bá ní ìgbẹ́kẹ̀lé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "kí ni ìwọ ó ṣe nínú ẹkùn odò Jordani?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin rẹ àti àwọn",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "ìdílé",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "ti dà ọ́, kódà wọ́n ti kẹ̀yìn sí ọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "wọ́n ti hó lé ọ lórí.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "Má ṣe gbà wọ́n gbọ́",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "bí ó tilẹ̀ jẹ́ pé wọ́n ń sọ̀rọ̀ rẹ dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò kọ ilé mi sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "èmi yóò fi ìní mi sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "Èmi yóò fi ẹni tí mo fẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "lé àwọn ọ̀tá rẹ̀ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogún mi ti rí sí mi",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "bí i kìnnìún nínú igbó.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "Ó ń bú ramúramù mọ́ mi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
