      "attrs": {
        "style": "q2",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "wọn yóò fi ara wọn ṣe wàhálà, ṣùgbọ́n òfo ni èrè wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
