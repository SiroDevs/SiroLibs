  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "JER 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n fi ikú halẹ̀ mọ́ Jeremiah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìbẹ̀rẹ̀ pẹ̀pẹ̀ ìjọba ọba Jehoiakimu ọmọ Josiah tí ń ṣe ọba Juda, ọ̀rọ̀ yìí wá láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.1",
                "verseOrgIds": [
                  "JER.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.2",
                "verseOrgIds": [
                  "JER.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, Dúró ní àgbàlá ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.2",
                "verseOrgIds": [
                  "JER.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí o sì sọ fún gbogbo ènìyàn ilẹ̀ Juda tí ó ti wá láti wá jọ́sìn ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.2",
                "verseOrgIds": [
                  "JER.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", sọ fún gbogbo ohun tí mo pàṣẹ fún ọ; má ṣaláìsọ gbogbo ọ̀rọ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bóyá gbogbo wọn máa gbọ́ ọ̀rọ̀ náà tí ọ̀kọ̀ọ̀kan wọn yóò kúrò nínú ìwà búburú wọn. Èmi ó yí ọkàn padà, n kò sì ní fi ibi tí mo ti rò sí wọn ṣe wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún wọn wí pé, 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.4",
                "verseOrgIds": [
                  "JER.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: Tí ẹ kò bá fi etí sí ọ̀rọ̀ mi, tí ẹ kò sì gbọ́ òfin mi, ti mo gbé kalẹ̀ níwájú yín,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti tí ẹ kò bá gbọ́ ọ̀rọ̀ àwọn ìránṣẹ́ mi, àwọn wòlíì tí mo rán sí i yín léraléra (ṣùgbọ́n ẹ̀yin kò gbọ́),",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni èmi yóò ṣe ilé yìí bí Ṣilo, èmi yóò sì ṣe ìlú yìí ní ìfibú sí gbogbo orílẹ̀-èdè ayé.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà, àwọn wòlíì àti gbogbo ènìyàn ni ó gbọ́ ọ̀rọ̀ Jeremiah tí ó sọ ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.7",
                "verseOrgIds": [
                  "JER.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní kété tí Jeremiah ti parí ọ̀rọ̀ rẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.8",
                "verseOrgIds": [
                  "JER.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ láti sọ; àwọn àlùfáà, àti gbogbo ènìyàn dìímú, wọ́n sì wí pé, \"Kíkú ni ìwọ yóò kú!",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ló dé tí ìwọ ṣe sọ àsọtẹ́lẹ̀ ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.9",
                "verseOrgIds": [
                  "JER.26.9"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, ilé yìí yóò dàbí Ṣilo, orílẹ̀-èdè yìí yóò sì di ahoro tí kì yóò ní olùgbé.\" Gbogbo àwọn ènìyàn sì kójọpọ̀ pẹ̀lú Jeremiah nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.9",
                "verseOrgIds": [
                  "JER.26.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn aláṣẹ Juda gbọ́ nípa nǹkan wọ̀nyí, wọ́n lọ láti ààfin ọba sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.10",
                "verseOrgIds": [
                  "JER.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì mú ààyè wọn, wọ́n jókòó ní ẹnu-ọ̀nà tuntun ilé",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.10",
                "verseOrgIds": [
                  "JER.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà àti àwọn wòlíì sọ fún àwọn aláṣẹ àti gbogbo ènìyàn pé, \"Arákùnrin yìí gbọdọ̀ gba ìdájọ́ ikú nítorí pé ó sọ àsọtẹ́lẹ̀ lórí ìlú yìí: bí ẹ̀yin ti fi etí yín gbọ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jeremiah sọ fún gbogbo àwọn aláṣẹ àti gbogbo àwọn ènìyàn wí pé: \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.12",
                "verseOrgIds": [
                  "JER.26.12"
                ]
              }
            }
          ]
        },
        {
          "text": "rán mi láti sọ àsọtẹ́lẹ̀ ní ilé yìí àti ìlú yìí, gbogbo ohun tí ẹ ti gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, tún ọ̀nà rẹ ṣe àti ìṣe rẹ, kí ẹ sì gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.13",
                "verseOrgIds": [
                  "JER.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.13",
                "verseOrgIds": [
                  "JER.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yí ọkàn rẹ̀ padà, kò sì ní mú ohun gbogbo tí ó ti sọ jáde ní búburú ṣẹ lórí yín.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣe tèmi ni, èmi wà ní ọwọ́ yín, ẹ ṣe ohun tí ẹ̀yin bá rò pé ó dára, tí ó sì tọ́ lójú yín fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ mọ̀ dájú pé tí ẹ bá pa mí, ẹ ó mú ẹ̀jẹ̀ aláìṣẹ̀ wá sórí ara yín, sórí ìlú yìí àti àwọn olùgbé inú rẹ̀; nítorí pé nítòótọ́ ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.15",
                "verseOrgIds": [
                  "JER.26.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ti rán mi láti sọ ọ̀rọ̀ yìí fún un yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn aláṣẹ àti gbogbo àwọn ènìyàn sọ fún àwọn àlùfáà àti àwọn wòlíì pé, \"Ẹ má ṣe pa ọkùnrin yìí nítorí ó ti bá wa sọ̀rọ̀ ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.16",
                "verseOrgIds": [
                  "JER.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára àwọn àgbàgbà ilẹ̀ náà sì sún síwájú, wọ́n sì sọ fún gbogbo àwọn ènìyàn náà wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mika ti Moreṣeti sọ àsọtẹ́lẹ̀ ní ọjọ́ Hesekiah ọba Juda. Ó sọ fún gbogbo ènìyàn Juda pé, 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.18",
                "verseOrgIds": [
                  "JER.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": "wí:",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "\" 'A ó sì fa Sioni tu bí oko",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "Jerusalẹmu yóò di òkìtì",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "àlàpà àti òkè ilẹ̀ yìí gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "ibi gíga igbó.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ Hesekiah ọba Juda tàbí ẹnikẹ́ni ní Juda pa á bí? Ǹjẹ́ Hesekiah kò bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.19",
                "verseOrgIds": [
                  "JER.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sì wá ojúrere rẹ̀? Ǹjẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.19",
                "verseOrgIds": [
                  "JER.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kò ha a sì yí ìpinnu rẹ̀ padà, tí kò sì mú ibi tí ó ti sọtẹ́lẹ̀ yẹ̀ kúrò lórí wọn? Ibi ni a fẹ́ mú wá sórí ara wa yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Bákan náà Uriah ọmọ Ṣemaiah láti Kiriati-Jearimu jẹ́ ọkùnrin mìíràn tí ó sọ àsọtẹ́lẹ̀ kan náà ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.20",
                "verseOrgIds": [
                  "JER.26.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ó sọ àsọtẹ́lẹ̀ kan náà sí ìlú náà àti ilẹ̀ yín bí Jeremiah ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọba Jehoiakimu àti gbogbo àwọn aláṣẹ gbọ́ gbogbo ọ̀rọ̀ rẹ̀, ọba ń wá láti pa á: ṣùgbọ́n Uriah gbọ́ èyí, ẹ̀rù bà á, ó sì sálọ sí Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Jehoiakimu rán Elnatani ọmọ Akbori lọ sí Ejibiti pẹ̀lú àwọn ọkùnrin mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
              "JER.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì mú Uriah láti Ejibiti lọ sí ọ̀dọ̀ ọba Jehoiakimu; ẹni tí ó fi idà pa, ó sì sọ òkú rẹ̀ sí inú isà òkú àwọn ènìyàn lásán.)",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahikamu ọmọ Ṣafani ń bẹ pẹ̀lú Jeremiah, wọn kò sì fi í lé àwọn ènìyàn lọ́wọ́ láti pa á.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.24",
            "verseOrgIds": [
              "JER.26.24"
            ]
          }
        }
      ]
    }
  ],
