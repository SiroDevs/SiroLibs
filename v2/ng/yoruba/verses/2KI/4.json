          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báwo ni èmi yóò ṣe gbé èyí ka iwájú àwọn ọgọ́rùn-ún ènìyàn?\" ìránṣẹ́ rẹ̀ béèrè.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        }
      ]
    },
