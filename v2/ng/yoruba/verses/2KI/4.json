                "verseOrgIds": [
                  "2KI.4.43"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: 'Wọn yóò jẹ yóò sì tún ṣẹ́kù.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
