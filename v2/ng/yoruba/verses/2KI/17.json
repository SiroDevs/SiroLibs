  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hosea ọba tí ó gbẹ̀yìn ní Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kejìlá ọba Ahasi ará Juda, Hosea ọmọ Ela jẹ ọba Israẹli ní Samaria, ó sì jẹ fún ọdún mẹ́sàn-án.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.2",
                "verseOrgIds": [
                  "2KI.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣùgbọ́n kì í ṣe bí i ti ọba Israẹli ẹni tí ó ti wà ṣáájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣalamaneseri ọba Asiria wá sókè láti mú Hosea, ẹni tí ó ti jẹ fún Ṣalamaneseri ó sì ti san owó òde fún un.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọba Asiria rí i wí pé Hosea jẹ́ ọlọ́tẹ̀, nítorí ó ti rán oníṣẹ́ sọ́dọ̀ ọba Ejibiti, kò sì san owó òde mọ́ fún ọba Asiria, gẹ́gẹ́ bí o ti máa ń ṣe ní ọdọọdún. Nígbà náà ọba Asiria fi agbára mú ún, ó sì fi sínú túbú.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Asiria gòkè wá sí gbogbo ibi ilé náà, ó sì lọ sí Samaria, ó sì dúró tí ì fún ọdún mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹsànán ti Hosea, ọba Asiria mú Samaria ó sì kó Israẹli lọ sí Asiria. Ó sì fi wọ́n sílẹ̀ ní Hala, ní Gosani ní etí odò Habori àti ní ìlú àwọn ará Media.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israẹli sá kúrò ní ìlú nítorí ẹ̀ṣẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo eléyìí ṣẹlẹ̀ nítorí àwọn ọmọ Israẹli ti dẹ́ṣẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.7",
                "verseOrgIds": [
                  "2KI.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn, ẹni tí ó mú wọn jáde ní Ejibiti lábẹ́ agbára Farao ọba Ejibiti. Wọ́n sin ọlọ́run mìíràn,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọn si tẹ̀lé ìwà orílẹ̀-èdè tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.8",
                "verseOrgIds": [
                  "2KI.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gbá kúrò níwájú wọn gẹ́gẹ́ bí ìwà ti ọba Israẹli tí ó ti paláṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli ṣe ohun ìríra sí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.9",
                "verseOrgIds": [
                  "2KI.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn kọ́ láti ilé ìṣọ́ sí ìlú tí a dáàbò bò, wọ́n kọ́ ilé gíga fún ara wọn ní gbogbo ìlú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì gbé àwọn òkúta tí a yà sọ́tọ̀ sókè àti ère òrìṣà Aṣerah lórí gbogbo igi tútù.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo ibi gíga, wọ́n sun tùràrí gẹ́gẹ́ bí orílẹ̀-èdè tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.11",
                "verseOrgIds": [
                  "2KI.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ti lé jáde níwájú wọn. Wọ́n ṣe ohun búburú tí ó rú ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.11",
                "verseOrgIds": [
                  "2KI.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sókè.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sìn òrìṣà, èyí tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.12",
                "verseOrgIds": [
                  "2KI.17.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ pé, \"Ẹ kò gbọdọ̀ ṣe èyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.13",
                "verseOrgIds": [
                  "2KI.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kìlọ̀ fún Israẹli àti Juda nípa gbogbo àwọn wòlíì wọn àti aríran: \"Ẹ yípadà kúrò ní ọ̀nà búburú yín. Kí ẹ ṣe òfin mi àti ìlànà mi, ní ìbámu pẹ̀lú gbogbo òfin tí Èmi paláṣẹ fún àwọn baba yín láti tẹ̀lé àti èyí tí mo rán sí i yín nípa ìránṣẹ́ àwọn wòlíì mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọn kò ní gbọ́, wọ́n sì ṣe gẹ́gẹ́ bí ọlọ́rùn líle gẹ́gẹ́ bí i ti baba wọn, ẹni tí kò gbà",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.14",
                "verseOrgIds": [
                  "2KI.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n kọ̀ ìlànà rẹ̀ àti májẹ̀mú tí ó ti ṣe pẹ̀lú baba wọn àti ìkìlọ̀ tí ó ti fi fún wọn. Wọ́n tẹ̀lé òrìṣà aláìníláárí, àwọn fún rara wọn sì jẹ́ aláìníláárí. Wọ́n tẹ̀lé orílẹ̀-èdè tí ó yí wọn ká bí ó tilẹ̀ jẹ́ pé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.15",
                "verseOrgIds": [
                  "2KI.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kìlọ̀ fún wọn pé, \"Má ṣe ṣe gẹ́gẹ́ bí wọn tí ń ṣe,\" wọ́n sì ṣe ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.15",
                "verseOrgIds": [
                  "2KI.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kà léèwọ̀ fún wọn láti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n kọ̀ gbogbo òfin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.16",
                "verseOrgIds": [
                  "2KI.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn sílẹ̀, wọ́n sì ṣe òrìṣà méjì fún ara wọn, wọ́n sì gbẹ́ ẹ ọ̀kan ní ère ẹgbọrọ màlúù, àti ọ̀kan ní ère òrìṣà Aṣerah. Wọ́n sì tẹrí wọn ba sí gbogbo ogun ọ̀run, wọ́n sì sin Baali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì fi àwọn ọmọkùnrin àti àwọn ọmọbìnrin wọn rú ẹbọ nínú iná. Wọ́n sì ń fọ àfọ̀ṣẹ, wọ́n sì ń ṣe àlúpàyídà wọ́n sì ta ara wọn láti ṣe ohun búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.17",
                "verseOrgIds": [
                  "2KI.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì mú un bínú.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.18",
                "verseOrgIds": [
                  "2KI.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bínú gidigidi pẹ̀lú Israẹli ó sì mú wọn kúrò níwájú rẹ̀. Ẹ̀yà Juda nìkan ṣoṣo ni ó kù,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti pẹ̀lú, Juda kò pa òfin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.19",
                "verseOrgIds": [
                  "2KI.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn mọ́. Wọ́n tẹ̀lé ìhùwàsí àwọn Israẹli tí wọ́n ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.20",
                "verseOrgIds": [
                  "2KI.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "kọ gbogbo àwọn ènìyàn Israẹli; ó sì jẹ wọ́n ní yà. Ó sì fi wọ́n lé ọwọ́ àwọn olè títí tí ó fi ta wọ́n nù kúrò níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó ta Israẹli kúrò láti ìdílé Dafidi, wọ́n sì mú Jeroboamu ọmọ Nebati jẹ ọba wọn. Jeroboamu sì mú kí àwọn ọmọ Israẹli yípadà kúrò ní títẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.21",
                "verseOrgIds": [
                  "2KI.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sí mú kí wọn dẹ́ṣẹ̀ ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli forítì í nínú gbogbo ẹ̀ṣẹ̀ Jeroboamu kò sì yí padà kúrò lọ́dọ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "títí tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.23",
                "verseOrgIds": [
                  "2KI.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "fi mú wọn kúrò níwájú rẹ̀, gẹ́gẹ́ bí ó ti paláṣẹ láti ọ̀dọ̀ àwọn ìránṣẹ́ wòlíì. Bẹ́ẹ̀ ni a kó gbogbo ènìyàn Israẹli kúrò ní ilẹ̀ wọn lọ sí ìgbèkùn ni Asiria, títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samaria tún fìdímúlẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Asiria mú àwọn ènìyàn láti Babeli, Kuta, Afa, Hamati àti Sefarfaimi, wọ́n sì fi wọ́n sínú ìlú Samaria láti rọ́pò àwọn ọmọ Israẹli. Wọ́n sì ń gbé ní ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n gbé bẹ̀ ní àkọ́kọ́, wọn kò sì bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.25",
                "verseOrgIds": [
                  "2KI.17.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", bẹ́ẹ̀ ni ó rán kìnnìún sí àárín wọn. Wọ́n sì pa nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì sọ fún ọba Asiria pé, \"Àwọn ènìyàn tí ìwọ lé kúrò tí o sì fi sínú ìlú Samaria kò mọ ohun tí ọlọ́run ìlú náà béèrè. Ó sì ti rán kìnnìún sí àárín wọn, tí ó sì ń pa wọ́n run, nítorí ènìyàn wọn kò mọ ohun tí ó béèrè.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ọba Asiria pàṣẹ yìí wí pé, \"Mú ọ̀kan lára àwọn àlùfáà tí ó mú láti Samaria lọ padà gbé níbẹ̀ kí ó sì kọ́ àwọn ènìyàn ní, ohun tí ọlọ́run ilẹ̀ náà béèrè.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ọ̀kan lára àwọn àlùfáà tí ó ti kúrò ní Samaria wá gbé ní Beteli ó sì kọ́ wọn bí a ti ń sin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.28",
                "verseOrgIds": [
                  "2KI.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ rí bẹ́ẹ̀, olúkúlùkù orílẹ̀-èdè ṣe òrìṣà tirẹ̀ ní gbogbo ìlú níbi tí wọ́n gbé wà, wọ́n sì gbé wọn nínú ilé òrìṣà àti àwọn ènìyàn Samaria ó sì ṣe wọ́n sí ibi gíga wọ̀n-ọn-nì.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ọkùnrin láti Babeli ṣe àgọ́ àwọn wúńdíá, àwọn ènìyàn Kuti ṣe òrìṣà Nergali, àti àwọn ènìyàn Hamati ṣe ti Aṣima;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti àwọn ará Afa ṣe Nibhasi àti Tartaki, àti àwọn ará Sefarfaimi sun àwọn ọmọ wọn níná gẹ́gẹ́ bí ẹbọ sí Adrameleki àti Anameleki, àwọn òrìṣà Sefarfaimi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.32",
                "verseOrgIds": [
                  "2KI.17.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣùgbọ́n wọ́n sì tún yan gbogbo ẹgbẹ́ tí ènìyàn wọn láti ṣe iṣẹ́ oyè fún wọn gẹ́gẹ́ bí àlùfáà ní ibi gíga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.33",
                "verseOrgIds": [
                  "2KI.17.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣùgbọ́n wọ́n sin òrìṣà wọn ní ìṣọ̀kan pẹ̀lú àṣà orílẹ̀-èdè wọn láti ibi tí wọ́n ti gbé wọn wá.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ìgbà náà wá àwọn àlùfáà wọn ṣe bí ti àtẹ̀yìnwá. Wọn kò sin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.34",
                "verseOrgIds": [
                  "2KI.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "tàbí kí wọ́n fi ara mọ́ ìlànà àti àṣẹ àti òfin tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.34",
                "verseOrgIds": [
                  "2KI.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fún ìránṣẹ́ Jakọbu, tí wọ́n pe orúkọ rẹ̀ ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.35",
                "verseOrgIds": [
                  "2KI.17.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe májẹ̀mú pẹ̀lú àwọn ọmọ Israẹli ó pàṣẹ fún wọn pé, \"Ẹ má ṣe sin òrìṣà mìíràn tàbí tẹríba fún wọn, sìn wọ́n tàbí kí ẹ rú ẹbọ sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.36",
                "verseOrgIds": [
                  "2KI.17.36"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni tí ó mú yín gòkè jáde wá láti ilẹ̀ Ejibiti pẹ̀lú agbára ńlá àti nínà apá, òun ni ẹni náà tí ó yẹ kí ẹ sìn. Òun ni ẹni tí ó yẹ kí ẹ tẹríba fún àti sí òun ni kí ẹ rú ẹbọ fún.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó yẹ kí ẹ̀yin kí ó máa kíyèsi ara yín gidigidi láti pa ìlànà àti àṣẹ, àti òfin tí ó kọ fún un yín mọ́. Ẹ má ṣe sin ọlọ́run mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe gbàgbé májẹ̀mú tí mo ti ṣe pẹ̀lú yín mọ́ àti kí ẹ má sin ọlọ́run mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kúkú sin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.39",
                "verseOrgIds": [
                  "2KI.17.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ; Òun ni ẹni náà tí yóò gbà yín kúrò lọ́wọ́ gbogbo àwọn ọ̀tá a yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò ní gbọ́, bẹ́ẹ̀ ni, wọ́n sì ń ṣe iṣẹ́ wọ́n ti àtijọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ènìyàn wọn sin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.41",
                "verseOrgIds": [
                  "2KI.17.41"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì ń sin òrìṣà wọn. Títí di ọjọ́ òní ọmọ wọn àti àwọn ọmọ ọmọ wọn sì ń ṣe bí àwọn baba wọn ti ń ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
    }
