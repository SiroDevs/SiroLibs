          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí oore rẹ̀ tí tóbi tó, ẹwà rẹ̀ sì tí pọ̀!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.17",
            "verseOrgIds": [
