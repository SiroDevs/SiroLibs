      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "bí agbo ènìyàn rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "nítorí wọn ó dàbí àwọn òkúta adé,",
