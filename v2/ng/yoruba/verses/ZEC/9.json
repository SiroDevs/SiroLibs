      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "mo sì fi Efraimu kún un,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "Èmi yóò gbé àwọn ọmọ rẹ ọkùnrin dìde, ìwọ Sioni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
