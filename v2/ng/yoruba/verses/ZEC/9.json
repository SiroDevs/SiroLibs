          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó fa Juda le bí mo ṣe fa ọrun mi le,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
