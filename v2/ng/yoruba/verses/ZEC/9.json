            "sid": "ZEC 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní tìrẹ, nítorí ẹ̀jẹ̀ májẹ̀mú mi pẹ̀lú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.11",
            "verseOrgIds": [
              "ZEC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:11"
      },
      "items": [
        {
          "text": "Èmi ó dá àwọn ìgbèkùn rẹ̀ sílẹ̀ kúrò nínú ọ̀gbun.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.11",
            "verseOrgIds": [
              "ZEC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ padà sínú odi agbára yín, ẹ̀yin òǹdè ti o ni ìrètí:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.12",
            "verseOrgIds": [
              "ZEC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:12"
      },
      "items": [
        {
          "text": "àní lónìí yìí èmi sọ pé, èmi o san án fún ọ ni ìlọ́po méjì.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.12",
            "verseOrgIds": [
              "ZEC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
