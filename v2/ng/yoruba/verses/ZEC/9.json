      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "sí àwọn ọmọ rẹ̀ ọkùnrin, ìwọ Giriki,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
