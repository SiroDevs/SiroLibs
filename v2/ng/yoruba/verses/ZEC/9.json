{
  "id": "ZEC.9",
  "number": "9",
  "bookId": "ZEC",
  "reference": "Sekariah 9",
  "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ZEC 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdájọ́ lórí àwọn ọ̀tá Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀-ìmọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kọjú ìjà sí Hadiraki,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "Damasku ni yóò sì jẹ́ ibi ìsinmi rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "nítorí ojú",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ lára ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "àti lára gbogbo ẹ̀yà Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti Hamati pẹ̀lú yóò ṣe ààlà rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:2"
      },
      "items": [
        {
          "text": "Tire àti Sidoni bí o tilẹ̀ ṣe ọlọ́gbọ́n gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tire sì mọ odi líle fún ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "ó sì kó fàdákà jọ bí eruku,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "àti wúrà dáradára bí ẹrẹ̀ ìgboro.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, Olúwa yóò kó gbogbo ohun ìní rẹ̀ lọ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "yóò sì pa agbára rẹ̀ run ní ojú Òkun,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "a ó sì fi iná jó o run.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣkeloni yóò rí í, yóò sì bẹ̀rù;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gasa pẹ̀lú yóò rí í, yóò sì káàánú gidigidi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "àti Ekroni: nítorí tí ìrètí rẹ̀ yóò ṣákì í.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gasa yóò pàdánù ọba rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Aṣkeloni yóò sì di ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ àlè yóò sì gbé inú Aṣdodu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:6"
      },
      "items": [
        {
          "text": "Èmi yóò sì gé ìgbéraga àwọn Filistini kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì mu ẹ̀jẹ̀ rẹ̀ kúrò ni ẹnu rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "àti àwọn ohun èèwọ̀ kúrò láàrín eyín rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn tó ṣẹ́kù yóò jẹ́ tí Ọlọ́run wa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "wọn yóò sì jẹ baálẹ̀ ní Juda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "àti Ekroni ni yóò rí bí Jebusi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì dó yí ilẹ̀ mi ká",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "nítorí ogun àwọn tí wọ́n ń wá ohun tí wọn yóò bàjẹ́ kiri,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "kò sí aninilára tí yóò bori wọn mọ́:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "nítorí ni ìsinsin yìí ni mo fi ojú ṣọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọba sioni ń bọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kún fún ayọ̀, ìwọ ọmọbìnrin Sioni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "hó ìhó ayọ̀, ìwọ ọmọbìnrin Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Wò ó, ọba rẹ ń bọ̀ wá sọ́dọ̀ rẹ:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "òdodo ni òun, ó sì ní ìgbàlà;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "ó ní ìrẹ̀lẹ̀, ó sì ń gun kẹ́tẹ́kẹ́tẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "àní ọmọ kẹ́tẹ́kẹ́tẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó sì gbé kẹ̀kẹ́ kúrò ni Efraimu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "àti ẹṣin ogun kúrò ni Jerusalẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "a ó sì ṣẹ́ ọrun ogun.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "Òun yóò sì kéde àlàáfíà sí àwọn kèfèrí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "Ìjọba rẹ̀ yóò sì gbilẹ̀ láti Òkun dé Òkun,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "àti láti odò títí de òpin ayé.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
