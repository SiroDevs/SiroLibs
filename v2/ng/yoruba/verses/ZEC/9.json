      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:17"
      },
      "items": [
        {
          "text": "àti ọtí wáìnì tuntun yóò mú àwọn ọ̀dọ́mọbìnrin ṣe bẹ́ẹ̀ pẹ̀lú.",
          "type": "text",
          "attrs": {
