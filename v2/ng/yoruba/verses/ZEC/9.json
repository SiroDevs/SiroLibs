      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:17"
      },
      "items": [
        {
          "text": "Ọkà yóò mú ọ̀dọ́mọkùnrin dárayá,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.17",
            "verseOrgIds": [
