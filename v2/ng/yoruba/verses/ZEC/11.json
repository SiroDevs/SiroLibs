  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ZEC 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣí àwọn ìlẹ̀kùn rẹ sílẹ̀, ìwọ Lebanoni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:1"
      },
      "items": [
        {
          "text": "kí iná bá lè jẹ igi kedari rẹ run.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hu, igi junifa; nítorí igi kedari ṣubú,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "nítorí tí a ba àwọn igi tí o lógo jẹ́:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "hu, ẹ̀yin igi óákù tí Baṣani,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "nítorí gé igbó àjàrà lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ ohun igbe àwọn olùṣọ́-àgùntàn;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "ògo wọn bàjẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "gbọ́ ohùn bíbú àwọn ọmọ kìnnìún",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "nítorí ògo Jordani bàjẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olùṣọ́-àgùntàn méjì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.4",
                "verseOrgIds": [
                  "ZEC.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi wí: \"Bọ́ ọ̀wọ́ ẹran àbọ́pa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí àwọn olúwa wọn ń pa wọ́n, tí wọn kò sì ka ara wọn sí pé wọn jẹ̀bi: àti àwọn tí ń tà wọ́n wí pé, 'Ìbùkún ni fún",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.5",
                "verseOrgIds": [
                  "ZEC.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí tí mo dí ọlọ́rọ̀!' Àwọn olùṣọ́-àgùntàn wọn kò sì ṣàánú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi kì yóò ṣàánú fún àwọn ara ilẹ̀ náà mọ́,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.6",
                "verseOrgIds": [
                  "ZEC.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, \"Ṣí kíyèsi í, èmi yóò fi olúkúlùkù ènìyàn lé aládùúgbò rẹ̀ lọ́wọ́, àti lé ọwọ́ ọba rẹ̀, wọn yóò sì fọ́ ilẹ̀ náà, èmi kì yóò sì gbà wọ́n lọ́wọ́ wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì bọ́ ẹran àbọ́pa, àní ẹ̀yin òtòṣì nínú ọ̀wọ́ ẹran. Mo sì mu ọ̀pá méjì sọ́dọ̀; mo pè ọ̀kan ni Oore-ọ̀fẹ́, mo pè èkejì ni Àmùrè; mo sì bọ́ ọ̀wọ́ ẹran náà.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùṣọ́-àgùntàn mẹ́ta ni mo sì gé kúrò ní oṣù kan.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 11:8"
      },
      "items": [
        {
          "text": "Ọkàn mi sì kórìíra wọn, ọkàn wọn pẹ̀lú sì kórìíra mi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì wí pé, \"Èmi kì yóò bọ́ yin: èyí ti ń ku lọ, jẹ́ kí òkú o kú; èyí tí a o ba sì gé kúrò, jẹ́ kí a gé e kúrò; ki olúkúlùkù nínú àwọn ìyókù jẹ́ ẹran-ara ẹnìkejì rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì mu ọ̀pá mi, ti a ń pè ní Oore-ọ̀fẹ́, mo ṣẹ́ si méjì, ki èmi bá lè da májẹ̀mú mi tí mo tí bá gbogbo àwọn ènìyàn náà dá.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dá ni ọjọ́ náà, bẹ́ẹ̀ ni àwọn òtòṣì nínú ọ̀wọ́ ẹran náà tí ó dúró tì mí mọ̀ pé, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.11",
                "verseOrgIds": [
                  "ZEC.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì wí fún wọn pé, \"Bí ó bá dára ní ojú yin, ẹ fún mi ni owó ọ̀yà mi; bí bẹ́ẹ̀ kọ́, ẹ mú un lọ́wọ́.\" Bẹ́ẹ̀ ni wọ́n wọn ọgbọ̀n owó fàdákà fún iye owó ọ̀yà mi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.13",
                "verseOrgIds": [
                  "ZEC.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún mi pé, \"Sọ ọ sí amọ̀kòkò.\" Iye dáradára náà, tí wọn yọ owó mi sí. Mo sì mu ọgbọ̀n owó fàdákà náà, mo sì sọ wọ́n sí àpótí ìṣúra ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.13",
                "verseOrgIds": [
                  "ZEC.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì ṣẹ́ ọ̀pá mi kejì, àní Àmùrè, sí méjì, kí èmi lè ya ìbátan tí ó wà láàrín Juda àti láàrín Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.15",
                "verseOrgIds": [
                  "ZEC.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún mi pé, \"Tún mú ohun èlò aṣiwèrè olùṣọ́-àgùntàn kan sọ́dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Èmi o gbé Olùṣọ́-àgùntàn kan dìde ni ilẹ̀ náà, tí kí yóò bẹ àwọn tí ó ṣègbé wò, ti kì yóò sì wá èyí tí ó yapa; tí kì yóò ṣe ìtọ́jú èyí tí a pa lára tàbí kí ó bọ́ àwọn tí ara wọn dá pépé: Ṣùgbọ́n òun yóò jẹ ẹran èyí tí ó ni ọ̀rá, àwọn èyí tiwọn fi èékánná wọn ya ara wọn pẹ́rẹpẹ̀rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        }
      ]
    },
    {
