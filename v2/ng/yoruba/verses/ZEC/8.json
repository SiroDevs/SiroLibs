          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.19",
                "verseOrgIds": [
                  "ZEC.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí pé: \"Àwẹ̀ oṣù kẹrin, karùn-ún, keje, àti tí ẹ̀kẹwàá, yóò jẹ́ ayọ̀ àti dídùn inú, àti àpéjọ àríyá fún ilé Juda; nítorí náà, ẹ fẹ́ òtítọ́ àti àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        }
      ]
