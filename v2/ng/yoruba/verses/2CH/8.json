  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2CH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn iṣẹ́ Solomoni mìíràn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ogún ọdún lásìkò ìgbà tí Solomoni kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.1",
                "verseOrgIds": [
                  "2CH.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ilé òun fúnra rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni tún ìlú tí Hiramu ti fi fún un kọ́, ó sì kó àwọn ọmọ Israẹli jọ níbẹ̀ kí wọn kí ó lè máa gbé nínú ibẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Solomoni lọ sí Hamati-Ṣoba ó sì borí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún kọ́ Tadmori ní aginjù àti gbogbo ìlú ìṣúra tí ó ti kọ́ ní Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún kọ́ òkè Beti-Horoni àti ìsàlẹ̀ Beti-Horoni gẹ́gẹ́ bí ìlú olódi, pẹ̀lú ògiri àti pẹ̀lú ìlẹ̀kùn àti ọ̀pá ìdábùú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti gẹ́gẹ́ bí Baalati àti gbogbo ìlú ìṣúra tí Solomoni ní, àti gbogbo ìlú fún kẹ̀kẹ́ rẹ̀ àti fún àwọn ẹṣin rẹ̀ ohunkóhun tí ó bá yẹ ní kókó ní Jerusalẹmu, ní Lebanoni àti ní gbogbo àyíká agbègbè tí ó ń darí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn tí ó kúrò láti ara àwọn ará Hiti, ará Amori, ará Peresi, ará Hifi àti ará Jebusi àwọn ènìyàn wọ̀nyí wọn kì í ṣe àwọn ará Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "èyí ni wí pé, àwọn ọmọ wọn tí ó kù sílé ní ilẹ̀ náà, tí àwọn ọmọ Israẹli kò parun àwọn ni Solomoni bu iṣẹ́ ìrú fún títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Solomoni kò mú ọmọ ọ̀dọ̀ lára àwọn ọmọ Israẹli, wọn jẹ́ ọ̀gágun rẹ̀, olùdarí àwọn oníkẹ̀kẹ́ àti olùdarí kẹ̀kẹ́ àti àwọn ẹlẹ́ṣin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún jẹ́ olórí aláṣẹ fún ọba Solomoni, àádọ́ta ó lé nígba (250) àwọn alákòóso lórí àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni gbé ọmọbìnrin Farao sókè láti ìlú Dafidi lọ sí ibi tí ó ti kọ́ fún un, nítorí ó wí pé, \"Aya mi kò gbọdọ̀ gbé nínú ilé Dafidi ọba Israẹli nítorí ibi tí àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.11",
                "verseOrgIds": [
                  "2CH.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bá tí wọ̀, ibi mímọ́ ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lórí pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.12",
                "verseOrgIds": [
                  "2CH.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó ti kọ́ níwájú ìloro náà, Solomoni sì rú ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.12",
                "verseOrgIds": [
                  "2CH.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nípa ìlànà ojoojúmọ́ fún ẹbọ rírú tí a pàṣẹ láti ọ̀dọ̀ Mose wá fún ọjọ́ ìsinmi, oṣù tuntun àti lẹ́rìn mẹ́ta lọ́dún, ní àjọ àìwúkàrà, ní àjọ ọ̀sẹ̀ méje àti àjọ àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní pípamọ́ pẹ̀lú ìlànà baba rẹ̀ Dafidi, ó sì yan ipa àwọn àlùfáà fún iṣẹ́ wọn àti àwọn ọmọ Lefi láti jẹ́ adarí láti máa yin àti láti máa ṣe ìránṣẹ́ àwọn àlùfáà gẹ́gẹ́ bí ìlànà ojoojúmọ́. Ó sì tún yàn àwọn olùṣọ́nà nípa pípín sí olúkúlùkù ẹnu-ọ̀nà, nítorí èyí ni Dafidi ènìyàn Ọlọ́run ti paláṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò sì yà kúrò nínú àṣẹ ọba sí àwọn àlùfáà tàbí sí àwọn ọmọ Lefi, nínú ohunkóhun, àti pẹ̀lú ti ìṣúra.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo iṣẹ́ Solomoni ni a gbé jáde láti ọjọ́ ìfi ìpìlẹ̀ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.16",
                "verseOrgIds": [
                  "2CH.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "lélẹ̀ títí ó fi di ọjọ́ ìparí. Bẹ́ẹ̀ ni ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.16",
                "verseOrgIds": [
                  "2CH.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì parí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Solomoni lọ sí Esioni-Geberi àti Elati ní Edomu létí òkun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu sì fi ọ̀kọ̀ ránṣẹ́ sì i nípa àwọn ìránṣẹ́ rẹ̀, àwọn ọkùnrin tí ó mòye Òkun. Èyí pẹ̀lú àwọn ènìyàn Solomoni, lọ sí Ofiri wọ́n sì gbé àádọ́ta lé ní irinwó (450) tálẹ́ǹtì wúrà wá, padà èyí tí wọ́n sì mú tọ ọba Solomoni wá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
  ],
