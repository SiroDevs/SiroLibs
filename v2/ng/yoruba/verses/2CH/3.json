        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni kọ́ ilé",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Solomoni bẹ̀rẹ̀ sí ní kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.1",
                "verseOrgIds": [
                  "2CH.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ní Jerusalẹmu lórí òkè Moria, níbi tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.1",
                "verseOrgIds": [
                  "2CH.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti farahan baba a rẹ̀ Dafidi. Ní orí ilẹ̀ ìpakà Arauna ará Jebusi, ibi tí Dafidi pèsè.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó bẹ̀rẹ̀ sí kíkọ́ rẹ̀ ní ọjọ́ kejì oṣù kejì ní ọdún kẹrin ìjọba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìpìlẹ̀ tí Solomoni gbé kalẹ̀ fún kíkọ́ ilé Ọlọ́run jẹ́ ọgọ́ta gígùn ìgbọ̀nwọ́ àti ogún fífẹ̀ ìgbọ̀nwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìloro tí ó wà níwájú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.4",
                "verseOrgIds": [
                  "2CH.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "náà jẹ́ ogún ìgbọ̀nwọ́ ní gígùn rékọjá fífẹ̀ ilé náà àti gíga rẹ̀ jẹ́ ogún ìgbọ̀nwọ́ ní gígùn rékọjá fífẹ̀ ilé náà àti gíga rẹ̀ jẹ́ ogún ìgbọ̀nwọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 3:4"
      },
      "items": [
        {
          "text": "Ó tẹ́ inú rẹ̀ pẹ̀lú kìkì wúrà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi igi firi bo ilé yàrá ńlá náà ó sì bò ó pẹ̀lú kìkì wúrà, ó sì ṣe é lọ́ṣọ̀ọ́ pẹ̀lú igi ọ̀pẹ àti àwòrán ẹ̀wọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.6",
                "verseOrgIds": [
                  "2CH.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "náà lọ́ṣọ̀ọ́ pẹ̀lú òkúta iyebíye. Wúrà tí ó lò jẹ́ wúrà parifaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó tẹ́ àjà ilé náà pẹ̀lú ìtí igi àti ìlẹ̀kùn ògiri àti àwọn ìlẹ̀kùn ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.7",
                "verseOrgIds": [
                  "2CH.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú wúrà, ó sì gbẹ́ àwòrán kérúbù sára ògiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó kọ́ Ibi Mímọ́ Jùlọ, gígùn rẹ̀ bá fífẹ̀ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.8",
                "verseOrgIds": [
                  "2CH.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mu, ogún ìgbọ̀nwọ́ fún gígùn, fífẹ̀ rẹ̀ sì jẹ́ ogún ìgbọ̀nwọ́, ó tẹ́ inú rẹ̀ pẹ̀lú ẹgbẹ̀ta (600) tálẹ́ǹtì ti wúrà dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ̀n àwọn ìṣó náà jẹ́ àádọ́ta ṣékélì. Ó tẹ́ àwọn apẹ òkè pẹ̀lú wúrà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Ibi Mímọ́ Jùlọ, ó gbẹ́ àwòrán igi kérúbù kan, ó sì tẹ́ wọn pẹ̀lú wúrà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ìyẹ́ apá ìbú àtẹ́lẹwọ́ lápapọ̀ ní ti kérúbù, jẹ́ ogún ìgbọ̀nwọ́ ọ̀kan nínú ìyẹ́ apá ti kérúbù àkọ́kọ́ jẹ́ ìgbọ̀nwọ́ márùn-ún ní gígùn, ó sì farakan ògiri ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.11",
                "verseOrgIds": [
                  "2CH.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nígbà tí ìyẹ́ apá kejì jẹ́ ìgbọ̀nwọ́ márùn-ún ní gígùn ó sì, farakan ìyẹ́ apá kérúbù mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìjọra, ìyẹ́ apá kan ti kérúbù kejì jẹ́ ìgbọ̀nwọ́ márùn-ún ní gígùn, ó sì farakan ògiri ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.12",
                "verseOrgIds": [
                  "2CH.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "mìíràn; ìyẹ́ apá rẹ̀ mìíràn sì jẹ́ ìgbọ̀nwọ́ márùn ní gígùn pẹ̀lú tí ó farakan ìyẹ́ apá kérúbù àkọ́kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyẹ́ apá àwọn kérúbù wọ̀nyí gbà tó ogún ìgbọ̀nwọ́. Wọ́n dúró ní ẹsẹ̀ wọn, wọ́n kọjú sí yàrá pàtàkì ńlá náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe aṣọ títa ní àwọ̀ ojú ọ̀run, àwọ̀ àlùkò àti àwọ̀ pupa fòò àti aṣọ ọ̀gbọ̀ pẹ̀lú kérúbù tí a ṣe sórí i rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwájú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.15",
                "verseOrgIds": [
                  "2CH.3.15"
                ]
              }
            }
          ]
        },
        {
          "text": "náà ó ṣe òpó méjì tí lápapọ̀ jẹ́ márùn-ún dín lógójì ìgbọ̀nwọ́ ní gígùn, olúkúlùkù pẹ̀lú olórí lórí rẹ̀ tí o ń wọn ìgbọ̀nwọ́ márùn-ún.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe ẹ̀wọ̀n tí a hun wọ inú ara wọn, ó gbé wọn ká orí òpó náà. Ó ṣe ọgọ́rùn-ún pomegiranate (orúkọ èso igi) ó sì so wọ́n mọ́ àwọn ẹ̀wọ̀n náà",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó gbe òpó náà dúró níwájú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.17",
                "verseOrgIds": [
                  "2CH.3.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ̀kan sí gúúsù, pẹ̀lú ọ̀kan sí àríwá. Èyí ti gúúsù, ó sọ ní Jakini àti èyí ti àríwá, ó sọ ní Boasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
    }
  ],
