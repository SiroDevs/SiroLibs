  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "2CH 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahasiah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn Jerusalẹmu mú Ahasiah, ọmọ Jehoramu tí ó kéré jùlọ, jẹ ọba ní ipò rẹ̀, láti ìgbà tí àwọn onísùnmọ̀mí, tí ó wá pẹ̀lú àwọn ará Arabia sínú ibùdó, tí wọn sì ti pa àwọn ọmọkùnrin àgbà. Bẹ́ẹ̀ ni Ahasiah ọmọ Jehoramu ọba Juda bẹ̀rẹ̀ sí ní jẹ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasiah jẹ́ ẹni ọdún méjìlélógún nígbà tí ó di ọba. Ó sì jẹ ọba ní Jerusalẹmu fún ọdún kan. Orúkọ ìyá rẹ̀ a máa jẹ́ Ataliah, ọmọ ọmọbìnrin Omri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú ìrìn ní ọ̀nà ilé Ahabu. Nítorí tí ìyá rẹ̀ kì í láyà nínú ṣíṣe búburú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.4",
                "verseOrgIds": [
                  "2CH.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", gẹ́gẹ́ bí ilé Ahabu ti ṣe, nítorí lẹ́yìn ikú baba a rẹ̀, wọ́n di olùgbani nímọ̀ràn rẹ̀ sí ṣíṣe rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó tẹ̀lé ìgbìmọ̀ wọn nígbà tí ó lọ pẹ̀lú Joramu ọmọ Ahabu ọba Israẹli láti gbógun ti Hasaeli ọba Aramu ní Ramoti Gileadi. Àwọn ará Aramu ṣá Joramu ní ọgbẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bẹ́ẹ̀ ni ó padà sí Jesreeli láti wo ọgbẹ́ rẹ̀ sàn tí wọ́n ti dá sí i lára ní Rama ní ojú ogun rẹ̀ pẹ̀lú Hasaeli ọba Siria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 22:6"
      },
      "items": [
        {
          "text": "Nígbà náà, Ahasiah, ọmọ Jehoramu ọba Juda lọ sí Jesreeli láti lọ rí Joramu ọmọ Ahabu nítorí a ti ṣá a lọ́gbẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo ìgbà ìbẹ̀wò Ahasiah sí Joramu, Ọlọ́run mú ìṣubú Ahasiah wá. Nígbà tí Ahasiah dé, ó jáde lọ pẹ̀lú Jehoramu láti lọ bá Jehu ọmọ Nimṣi, ẹni tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.7",
                "verseOrgIds": [
                  "2CH.22.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi àmì òróró yàn láti pa ìdílé Ahabu run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jehu ń ṣe ìdájọ́ lórí ilé Ahabu, ó rí àwọn ọmọbìnrin ọba ti Juda àti àwọn ọmọkùnrin ìbátan Ahasi, tí ó ń tọ́jú Ahasiah, ó sì pa wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó lọ láti wá Ahasiah, àti àwọn ọkùnrin rẹ̀. Àwọn arákùnrin rẹ̀ ṣẹ́gun rẹ̀ nígbà tí ó sá pamọ́ ní Samaria. A gbé e wá sí ọ̀dọ̀ Jehu, a sì pa á. Wọ́n sin ín nítorí wọ́n wí pé, \"Ọmọkùnrin Jehoṣafati ni, ẹni tí ó wá",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.9",
                "verseOrgIds": [
                  "2CH.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú gbogbo ọkàn rẹ̀.\" Bẹ́ẹ̀ ni kò sí ẹnìkan ní ilé Ahasiah tí ó lágbára láti gbé ìjọba náà dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ataliah àti Joaṣi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Ataliah ìyá Ahasiah rí i wí pé ọmọkùnrin rẹ̀ ti kú, ó tẹ̀síwájú láti pa gbogbo ìdílé ọba ti ilẹ̀ Juda run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoṣeba ọmọbìnrin ọba Jehoramu mú Joaṣi, ọmọkùnrin Ahasiah ó sì jí gbé lọ kúrò láàrín àwọn ọmọbìnrin ọba, àwọn tí ó kù díẹ̀ kí wọn pa. Wọn gbé òun àti olùtọ́jú rẹ̀ sínú ìyẹ̀wù. Nítorí Jehoṣeba ọmọbìnrin ọba Jehoramu àti ìyàwó àlùfáà Jehoiada jẹ́ arábìnrin Ahasiah. Ó fi ọmọ náà pamọ́ kúrò fún Ataliah, kí ó má ba à pa á.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wà ní ìpamọ́ pẹ̀lú wọn ni ilé Ọlọ́run fún ọdún mẹ́fà nígbà tí Ataliah ṣàkóso ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
    }
  ],
