  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2CH 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún keje, Jehoiada fi agbára rẹ̀ hàn. O dá májẹ̀mú pẹ̀lú àwọn alákòóso ọ̀rọ̀ọ̀rún kan, Asariah ọmọ Jerohamu, Iṣmaeli ọmọ Jehohanani Asariah ọmọ Obedi, Maaseiah ọmọ Adaiah àti Elisafati ọmọ Sikri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n lọ sí gbogbo Juda, wọ́n sì pe àwọn ará Lefi àti àwọn olórí àwọn ìdílé àwọn ará Israẹli láti gbogbo àwọn ìlú jọ. Nígbà tí wọ́n wá sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìpéjọ náà dá májẹ̀mú pẹ̀lú ọba ní ilé Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 23:3"
      },
      "items": [
        {
          "text": "Jehoiada wí fún wọn pé, \"Ọmọkùnrin ọba yóò jẹ ọba, bí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.3",
                "verseOrgIds": [
                  "2CH.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ṣèlérí nípa àwọn ìran Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí èyí ni ohun tí ó yẹ kí ó ṣe, ìdámẹ́ta àlùfáà yín àti àwọn ará Lefi tí ó ń lọ fún iṣẹ́ ìsìn ní ọjọ́ ìsinmi ni kí ó bojútó àwọn ìlẹ̀kùn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdámẹ́ta yín níbi ààfin ọba àti ìdámẹ́ta níbi ẹnu odi ìdásílẹ̀ àti gbogbo ọkùnrin mìíràn ni kí ó wà ní àgbàlá ààfin ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.5",
                "verseOrgIds": [
                  "2CH.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹnìkan tí ó gbọdọ̀ wọ inú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.6",
                "verseOrgIds": [
                  "2CH.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "yàtọ̀ sí àwọn àlùfáà àti àwọn ará Lefi tí a rán ní iṣẹ́ ìsìn. Wọ́n lè wọlé nítorí tí a ti yà wọ́n sọ́tọ̀, ṣùgbọ́n gbogbo ọkùnrin mìíràn ni kí wọn ó sọ ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.6",
                "verseOrgIds": [
                  "2CH.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti yàn fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Lefi gbọdọ̀ wà ní ìdúró ṣinṣin yí ọba ká. Olúkúlùkù pẹ̀lú àwọn nǹkan ìjà ní ọwọ́ rẹ̀. Ẹnikẹ́ni tí ó bá wọ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.7",
                "verseOrgIds": [
                  "2CH.23.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kí ẹ pa. Ẹ dúró ti ọba níbikíbi tí ó bá lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Lefi àti gbogbo ọkùnrin Juda ṣe gẹ́gẹ́ bí Jehoiada àlùfáà ti paláṣẹ. Olúkúlùkù mú àwọn ọkùnrin rẹ̀, àwọn tí wọ́n lọ fún iṣẹ́ ìsìn ní ọjọ́ ìsinmi àti àwọn tí wọ́n ń kúrò ní ibi iṣẹ́. Nítorí Jehoiada àlùfáà kò ì tí tú ìpín kankan sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.8",
            "verseOrgIds": [
              "2CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada àlùfáà, sì fi ọ̀kọ̀ àti asà, àti àpáta wọ̀n-ọn-nì, tí ó jẹ́ ti ọba Dafidi tí wọn wà ní ilé Ọlọ́run, fún àwọn balógun ọ̀rọ̀ọ̀rún.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì to gbogbo àwọn ènìyàn ti ọba káàkiri, olúkúlùkù pẹ̀lú ohun ìjà rẹ̀ ní ọwọ́ rẹ̀, láti apá ọ̀tún ilé náà títí dé apá òsì ilé náà, lẹ́bàá pẹpẹ àti lẹ́bàá ilé náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada àti àwọn ọmọkùnrin rẹ̀ mú ọmọkùnrin ọba jáde wá wọ́n sì gbé adé sórí rẹ̀; wọ́n mú ẹ̀dà májẹ̀mú kan fún un. Wọ́n sì kéde rẹ̀ lọ́ba. Wọ́n fi àmì òróró yàn án, wọ́n sì kígbe pé, \"Kí ọba kí ó pẹ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Ataliah gbọ́ igbe àwọn ènìyàn tí wọ́n ń sáré tí wọ́n ń kígbe ọba, ó lọ sí ọ̀dọ̀ wọn ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.12",
                "verseOrgIds": [
                  "2CH.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wò, sì kíyèsi, ọba dúró ní ibùdó rẹ̀ ní ẹ̀bá ẹnu-ọ̀nà, àti àwọn balógun àti àwọn afùnpè lọ́dọ̀ ọba, gbogbo àwọn ènìyàn ilẹ̀ náà sì yọ̀, wọ́n sì fọn ìpè, àti àwọn akọrin pẹ̀lú ohun èlò ìyìn. Nígbà náà ni Ataliah fa aṣọ rẹ̀ ya, ó sì kégbe wí pé, \"Ọ̀tẹ̀! Ọ̀tẹ̀!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.13",
            "verseOrgIds": [
              "2CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada àlùfáà mú àwọn alákòóso ọ̀rọ̀ọ̀rún, tí ó wà ní àbojútó àwọn ọ̀wọ́ ogun, ó sì wá wí fún wọn pé, \"Mú un jáde wá láàrín àwọn ọgbà, kí a sì fi idà pa ẹnikẹ́ni tí ó bá tẹ̀lé.\" Nítorí tí àlùfáà ti wí pé, \"Má ṣe pa á nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.14",
                "verseOrgIds": [
                  "2CH.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n fi ipá mú un kí ó tó dé ẹnu-ọ̀nà àbáwọlé ẹṣin ti ilé ọba, wọ́n sì ti pa á níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jehoiada, dá májẹ̀mú pé òun àti àwọn ènìyàn àti ọba yóò jẹ́ ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.16",
                "verseOrgIds": [
                  "2CH.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ènìyàn lọ sí ilé Baali, wọ́n sì fà á ya lulẹ̀. Wọ́n fọ́ àwọn pẹpẹ àti àwọn òrìṣà, wọ́n sì pa Mattani àlùfáà Baali níwájú àwọn pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Jehoiada tẹ àwòrán ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.18",
                "verseOrgIds": [
