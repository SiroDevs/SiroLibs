          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Ussiah sì ní ẹ̀tẹ̀ títí di ọjọ́ ikú rẹ̀. Ó sì gbé ní ilé àwọn adẹ́tẹ̀, a sì ké e kúrò ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.21",
                "verseOrgIds": [
                  "2CH.26.21"
                ]
              }
            }
          ]
        },
        {
          "text": ". Jotamu ọmọ rẹ̀ sì gba ipò rẹ̀, ó sì ń ṣe ìdájọ́ lórí àwọn ènìyàn ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
