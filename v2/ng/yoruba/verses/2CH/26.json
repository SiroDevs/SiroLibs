  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "2CH 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ussiah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà gbogbo ènìyàn Juda mú Ussiah, ẹni tí ó jẹ́ ẹni ọdún mẹ́rìndínlógún wọ́n sì fi jẹ ọba ní ipò baba rẹ̀ Amasiah.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ẹni náà tí ó tún Elati kọ́, ó sì mú padà sí Juda lẹ́yìn ìgbà tí Amasiah ọba ti sùn pẹ̀lú àwọn baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ussiah sì jẹ́ ẹni ọdún mẹ́rìndínlógún nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún méjìléláàádọ́ta. Orúkọ ìyá rẹ̀ sì ni Jekoliah; ó sì wá láti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ohun tí ó tọ́ ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.4",
                "verseOrgIds": [
                  "2CH.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", gẹ́gẹ́ bi baba rẹ̀ Amasiah ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wá",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.5",
                "verseOrgIds": [
                  "2CH.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ọjọ́ Sekariah, ẹni tí ó ní òye nínú ìran Ọlọ́run. Níwọ́n ọjọ́ tí ó wá ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.5",
                "verseOrgIds": [
                  "2CH.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run fún un ní ohun rere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lọ sí ogun pẹ̀lú Filistini ó sì wó odi Gati lulẹ̀, Jabne àti Aṣdodu. Ó sì kó ìlú rẹ̀ tí ó wà ní ẹ̀gbẹ́ Aṣdodu àti níbìkan láàrín àwọn ará Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì ràn án lọ́wọ́ lórí àwọn ará Filistini àti Arabia tí ń gbé ní Gur-baali àti lórí àwọn ará Mehuni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.7",
            "verseOrgIds": [
              "2CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Ammoni gbé ẹ̀bùn wá fún Ussiah, orúkọ rẹ̀ sì tàn káàkiri títí ó fi dé àtiwọ Ejibiti, nítorí ó ti di alágbára ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ussiah sì kọ́ ilé ìṣọ́ ní Jerusalẹmu níbi ẹnu-bodè igun, àti níbi ẹnu-bodè àfonífojì àti níbi ìṣẹ́po odi ó sì mú wọn le",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún ilé ìṣọ́ aginjù kọ́, ó sì gbẹ́ kànga púpọ̀, nítorí ó ni ẹran ọ̀sìn púpọ̀ ní ilẹ̀ ìsàlẹ̀ àti ní pẹ̀tẹ́lẹ̀. Ó sì ní àwọn ènìyàn tí ń ṣiṣẹ́ ní pápá àti ọgbà àjàrà ní orí òkè ní ilẹ̀ ọlọ́ràá, nítorí ó fẹ́ràn àgbẹ̀ ṣíṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ussiah sì ní àwọn ẹgbẹ́ ogun tí wọ́n kọ́ dáradára, wọ́n múra tán láti lọ pẹ̀lú ẹgbẹgbẹ́ gẹ́gẹ́ bí iye kíkà wọn gẹ́gẹ́ bí ọwọ́ Jeieli akọ̀wé àti Maaseiah ìjòyè lábẹ́ ọwọ́ Hananiah, ọ̀kan lára àwọn olórí ogun ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àpapọ̀ iye olórí àwọn alágbára akọni ogun jẹ́ ẹgbẹ̀tàlá (2,600).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lábẹ́ olórí àti olùdarí wọn, wọ́n sì jẹ́ alágbára akọni ogun ọ̀kẹ́ mẹ́ẹ̀ẹ́dógún ó lé ẹ̀ẹ́dẹ́gbàárin (307,500), tí ó ti múra fún ogun ńlá náà, àti alágbára ńlá jagunjagun kan láti ran ọba lọ́wọ́ sí ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ussiah sì pèsè ọ̀kọ̀, asà, akọ́rọ́, àti ohun èlò ìhámọ́ra ọrun títí dé òkúta kànnàkànnà fún ọwọ́ àwọn ọmọ-ogun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Jerusalẹmu ó sì ṣe ohun ẹ̀rọ ìjagun, iṣẹ́ ọwọ́ ọlọ́gbọ́n ènìyàn, láti wà lórí ilé ìṣọ́ àti lórí igun odi láti fi tafà àti láti fi sọ òkúta ńlá. Orúkọ rẹ̀ sì tàn káàkiri, nítorí a ṣe ìrànlọ́wọ́ ìyanu fún un títí ó fi di alágbára.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n lẹ́yìn ìgbà tí Ussiah jẹ́ alágbára tán, ìgbéraga rẹ̀ sì gbé e ṣubú. Ó sì di aláìṣòótọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.16",
                "verseOrgIds": [
                  "2CH.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀. Ó sì wọ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.16",
                "verseOrgIds": [
                  "2CH.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "láti sun tùràrí lórí pẹpẹ tùràrí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asariah àlùfáà pẹ̀lú àwọn ọgọ́rin alágbára àlùfáà",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.17",
                "verseOrgIds": [
                  "2CH.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "mìíràn sì tẹ̀lé e.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì takò ọba Ussiah, wọn sì wí pé, \"Kò dára fún ọ, Ussiah, láti sun tùràrí sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.18",
                "verseOrgIds": [
                  "2CH.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". Èyí fún àwọn àlùfáà, àwọn ọmọ Aaroni, ẹni tí ó ti yà sí mímọ́ láti sun tùràrí. Fi ibi mímọ́ sílẹ̀, nítorí tí ìwọ ti jẹ́ aláìṣòótọ́, ìwọ kò sì ní jẹ́ ẹni ọlá láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.18",
                "verseOrgIds": [
                  "2CH.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ussiah, ẹni tí ó ní àwo tùràrí ní ọwọ́ rẹ̀ tó ṣetán láti sun tùràrí sì bínú. Nígbà tí ó sì ń bínú sí àwọn àlùfáà níwájú wọn, níwájú pẹpẹ tùràrí ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.19",
                "verseOrgIds": [
                  "2CH.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ̀tẹ̀ sì yọ jáde ní iwájú orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Asariah olórí àlùfáà àti gbogbo àwọn àlùfáà yòókù sì wò ó, wọ́n sì rí i wí pé ó ní ẹ̀tẹ̀ níwájú orí rẹ̀, bẹ́ẹ̀ ni wọ́n sì sáré gbé e jáde pẹ̀lúpẹ̀lú, òun tìkára rẹ̀ ti fẹ́ láti jáde, nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.20",
                "verseOrgIds": [
                  "2CH.26.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kọlù ú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        }
