  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "2CH 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josiah gbógun ti ìwà ìbọ̀rìṣà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josiah sì jẹ́ ẹni ọdún mẹ́jọ nígbà tí ó jẹ ọba, ó sì dí ọba ní Jerusalẹmu fún ọdún mọ́kànlélọ́gbọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ohun tí ó dára ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.2",
                "verseOrgIds": [
                  "2CH.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì rìn ọ̀nà baba rẹ̀ Dafidi, kò sì yà sí ọwọ́ ọ̀tún tàbí òsì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹjọ ìjọba rẹ̀, nígbà tí ó sì wà ní ọ̀dọ́mọdé, ó sì bẹ̀rẹ̀ sí í wá ojú Ọlọ́run baba Dafidi. Ní ọdún kejìlá. Ó sì bẹ̀rẹ̀ sí fọ Juda àti Jerusalẹmu mọ́ kúrò ní ibi gíga rẹ̀, ère òrìṣà Aṣerah, àti ère yíyá àti ère dídà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lábẹ́ àpẹẹrẹ àwọn pẹpẹ Baali ni a yí lulẹ̀, ó sì fọ́ àwọn ère sí wẹ́wẹ́, ó run àwọn pẹpẹ tí ó wà lórí rẹ̀, wọ́n sì fọ́ túútúú, àwọn ère Aṣerah àti àwọn òrìṣà. Èyí tí ó fọ́ wọn sì lúúlúú, ó sì gbọ̀n wọ́n sí orí isà òkú àti àwọn tí ó ń rú ẹbọ sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sun àwọn egungun àwọn àlùfáà lórí pẹpẹ wọn, bẹ́ẹ̀ sì ni ó sì wẹ Juda àti Jerusalẹmu mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìlú Manase, Efraimu àti Simeoni, àní títí ó fi dé Naftali, àti nínú àwọn, ó tú ilé wọn yíkákiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wó pẹpẹ àti ère Aṣerah lulẹ̀ àti àwọn ère yíyá àti àwọn òrìṣà, ó sì gùn ó sì ti ké gbogbo àwọn ère orí pẹpẹ lulẹ̀ ní gbogbo àyíká Israẹli. Lẹ́yìn náà ó padà sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kejìdínlógún ìjọba Josiah ni a ti wẹ ilẹ̀ náà mọ́ àti ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.8",
                "verseOrgIds": [
                  "2CH.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì rán Ṣafani ọmọ Asalia àti Maaseiah olórí ìlú náà, pẹ̀lú Joah, ọmọ Joahasi, akọ̀wé, láti tún ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.8",
                "verseOrgIds": [
                  "2CH.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì lọ sí ọ̀dọ̀ Hilkiah olórí àlùfáà, ó sì fún un ní owó náà tí ó mú wá sí inú ilé Ọlọ́run, ti àwọn ọmọ Lefi ẹni tí ó jẹ́ aṣọ́bodè ti gbà láti ọ̀dọ̀ àwọn ènìyàn Manase Efraimu àti láti ọ̀dọ̀ àwọn ìyókù Israẹli àti ọ̀dọ̀ gbogbo ènìyàn Juda àti Benjamini wọ́n sì padà sí Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọn sì fi le àwọn tí ń ṣiṣẹ́ ilé lọ́wọ́, àwọn tí ń ṣe alábojútó iṣẹ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.10",
                "verseOrgIds": [
                  "2CH.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Àwọn ọkùnrin yìí sì san owó fún àwọn òṣìṣẹ́ tí ó ń túnṣe, tí wọ́n sì ń ṣiṣẹ́ ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.10",
                "verseOrgIds": [
                  "2CH.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún fi owó fún àwọn oníṣọ̀nà àti àwọn olùkọ́lé láti ra òkúta gbígbẹ́ àti ìtì igi fún ìsopọ̀ àti igi rírẹ́ fún ìkọ́lé tí ọba Juda ti gbà láti túnṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin náà ṣe iṣẹ́ náà pẹ̀lú òtítọ́, láti darí wọn ní Jahati àti Obadiah, àwọn ọmọ Lefi láti Merari, àti Sekariah àti Meṣullamu, sọ̀kalẹ̀ láti Kohati àwọn ọmọ Lefi gbogbo tí ó ní ọgbọ̀n ohun èlò orin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ní olórí àwọn aláàárù àti àwọn alábojútó gbogbo àwọn òṣìṣẹ́ láti ibi iṣẹ́ sí ibi iṣẹ́, díẹ̀ nínú àwọn ọmọ Lefi sì ní akọ̀wé, olùtọ́jú àti olùṣọ́nà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A rí ìwé òfin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n mú owó náà tí wọ́n mú wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Hilkiah àlùfáà sì rí ìwé òfin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": "tí a ti fi fún un láti ọwọ́ Mose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkiah sì wí fún Ṣafani akọ̀wé pé, \"Èmi ti rí ìwé òfin nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.15",
                "verseOrgIds": [
                  "2CH.34.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Ó sì fi fún Ṣafani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Ṣafani sì mú ìwé náà lọ sí ọ̀dọ̀ ọba ó sì ròyìn fún un. \"Àwọn ìjòyè rẹ̀ ń ṣe gbogbo nǹkan tí a ti fi lé wọn lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ti san owó náà tí ó wà nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.17",
                "verseOrgIds": [
                  "2CH.34.17"
                ]
              }
            }
          ]
        },
        {
          "text": "wọ́n sì ti fi lé àwọn alábojútó lọ́wọ́ àti àwọn òṣìṣẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Ṣafani akọ̀wé sì sọ fún ọba, \"Hilkiah àlùfáà ti fún mi ní ìwé.\" Ṣafani sì kà níwájú ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọba sì gbọ́ ọ̀rọ̀ òfin, ó sì fa aṣọ rẹ̀ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pa àṣẹ yìí fún Hilkiah, Ahikamu ọmọ Ṣafani, Abdoni ọmọ Mika, Ṣafani akọ̀wé àti Asaiah ìránṣẹ́ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ lọ kí ẹ lọ béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "fún mi nípa àwọn ìyókù Israẹli àti Juda nípa ohun tí wọ́n kọ sínú ìwé yìí tí a ti rí. Títóbi ni ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó ti jáde sí orí wa nítorí àwọn baba wa kò ti pa ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́, wọn kò sì tí ì ṣe gẹ́gẹ́ bí i gbogbo èyí tí a kọ sínú ìwé yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkiah àti àwọn ènìyàn tí ọba yàn tọ Hulda wòlíì obìnrin láti ba sọ̀rọ̀, ẹni tí ó jẹ́ aya Ṣallumu ọmọ Tokhati tí a tún ń pè ní Tikfa, ọmọ Harhasi, olùtọ́jú ibi ìkáṣọsí. Ó sì ń gbé ní Jerusalẹmu, ní ìhà kejì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.23",
                "verseOrgIds": [
                  "2CH.34.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli ti sọ, sọ fún àwọn ọkùnrin tí ó rán ọ sí mi pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.24",
                "verseOrgIds": [
                  "2CH.34.24"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, \"Èmi yóò sì mú ibi wá sí ìhín yìí àti àwọn ènìyàn rẹ̀ gbogbo àní ègún tí a kọ sínú ìwé tí wọ́n ti kà níwájú ọba Juda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí wọ́n ti kọ̀ mí sílẹ̀ wọ́n sì ti sun tùràrí sí ọlọ́run mìíràn wọ́n sì ti mú mi bínú pẹ̀lú gbogbo ohun tí wọ́n ti fi ọwọ́ wọn ṣe, ìbínú yóò tú jáde wá sórí ibí yìí, a kì yóò sì paná rẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún ọba Juda, ẹni tí ó rán yín láti béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.26",
                "verseOrgIds": [
                  "2CH.34.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.26",
                "verseOrgIds": [
                  "2CH.34.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ, Ọlọ́run Israẹli, sọ nípa ọ̀rọ̀ wọ́n nì tí ìwọ gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọkàn rẹ̀ dúró, ìwọ sì rẹ ara rẹ sílẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.27",
                "verseOrgIds": [
                  "2CH.34.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nígbà tí ó gbọ́ ohun tí ó sọ lórí ibí yìí àti ènìyàn rẹ, nítorí ìwọ rẹ ara rẹ sílẹ̀ níwájú mi tí o sì fa aṣọ rẹ ya, tí o sì lọ níwájú mi. Èmi ti gbọ́ tìrẹ ni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.27",
                "verseOrgIds": [
                  "2CH.34.27"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, Èmi ó kó ọ jọ pọ̀ sọ́dọ̀ àwọn baba rẹ, a ó sì sin ọ́ ní àlàáfíà. Ojú rẹ kò sì ní rí gbogbo ibi tí èmi ó mú wá sórí ibí yìí àti lórí àwọn tí ń gbé ibẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 34:28"
      },
      "items": [
        {
          "text": "Bẹ́ẹ̀ ni wọ́n mú ìdáhùn rẹ̀ padà sí ọ̀dọ̀ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba sì pe gbogbo àwọn àgbàgbà Juda jọ àti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó gòkè lọ sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú àwọn ọkùnrin Juda, àwọn ènìyàn Jerusalẹmu, àwọn àlùfáà àti àwọn Lefi—gbogbo àwọn ènìyàn láti ibi kéékèèké sí ńlá. Ó kà á sí etí ìgbọ́ ọ wọn, gbogbo ọ̀rọ̀ tí ó wà nínú ìwé májẹ̀mú, tí a ti rí nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì dúró ní ipò rẹ̀ ó sì tún májẹ̀mú dá níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", láti tẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": "àti láti pa òfin rẹ̀ mọ́, àti ẹ̀rí rẹ̀ àti àṣẹ rẹ̀ pẹ̀lú gbogbo ọkàn rẹ̀ àti gbogbo àyà rẹ̀ àti láti pa ọ̀rọ̀ májẹ̀mú tí a kọ sí inú ìwé yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ó sì mú kí gbogbo ènìyàn ní Jerusalẹmu àti Benjamini dúró nínú ẹ̀rí fún ara wọn, àwọn ènìyàn Jerusalẹmu ṣe èyí gẹ́gẹ́ bi májẹ̀mú Ọlọ́run, Ọlọ́run baba ńlá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josiah sì kó gbogbo ohun ìríra kúrò nínú gbogbo ìlú tí ń ṣe ti àwọn tí ó wà ní Israẹli, ó sì mú kí gbogbo àwọn tí ó wà ní Israẹli sin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn gẹ́gẹ́ bí ó ti ṣe wà láyè wọn, kò yà kúrò láti máa tọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
