  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "SNG 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní orí ibùsùn mi ní òru",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "mo wá ẹni tí ọkàn mí fẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "mo wá a, ṣùgbọ́n èmi kò rí i.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò dìde nísinsin yìí, èmi yóò sì rìn lọ káàkiri ìlú,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "ní àwọn òpópónà àti ní àwọn gbangba òde;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "èmi yóò wá ẹni tí ọkàn mi fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "Bẹ́ẹ̀ ni mo wá a ṣùgbọ́n èmi kò rí i.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọdẹ tí ń ṣọ́ ìlú rí mi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "bí wọ́n ṣe ń rìn yíká ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "\"Ǹjẹ́ ìwọ ti rí ẹni tí ọkàn mi fẹ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́rẹ́ tí mo fi wọ́n sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "ni mo rí ẹni tí ọkàn mi fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "Mo dìímú, èmi kò sì jẹ́ kí ó lọ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "títí tí mo fi mú u wá sílé ìyá mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "sínú yàrá ẹni tí ó lóyún mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ọmọbìnrin Jerusalẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "mo fi àwọn abo egbin àti abo àgbọ̀nrín igbó fi yín bú",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "kí ẹ má ṣe rú olùfẹ́ mi sókè",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "kí ẹ má sì ṣe jí i títí yóò fi wù ú.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ẹni tí ń ti ijù jáde wá",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "bí ọ̀wọ̀n èéfín",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "tí a ti fi òjìá àti tùràrí kùn lára",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "pẹ̀lú gbogbo ìpara olóòórùn oníṣòwò?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò ó! Àkéte rẹ̀ tí í ṣe ti Solomoni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "àwọn akọni ọgọ́ta ni ó wà yí i ká,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "àwọn akọni Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo wọn ni ó mú idà lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "gbogbo wọn ní ìmọ̀ nínú ogun,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "idà oníkálùkù wà ní ẹ̀gbẹ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "wọ́n múra sílẹ̀ fún ìdágìrì òru",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ọba ṣe àkéte fún ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:9"
      },
      "items": [
        {
          "text": "o fi igi Lebanoni ṣe é.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi fàdákà ṣe òpó rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "o fi wúrà ṣe ibi ẹ̀yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "Ó fi elése àlùkò ṣe ibùjókòó rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "inú rẹ̀ ni ó ko àwọn ọ̀rọ̀ ìfẹ́ wọ̀nyí sí.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "\"Pẹ̀lú ìfẹ́ láti ọ̀dọ̀ àwọn ọmọbìnrin Jerusalẹmu.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jáde wá, ẹ̀yin ọmọbìnrin Sioni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "kí ẹ sì wo ọba Solomoni tí ó dé adé,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
