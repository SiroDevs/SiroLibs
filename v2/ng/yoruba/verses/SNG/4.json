  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "SNG 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni ìwọ ti lẹ́wà tó olólùfẹ́ mi!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Háà, ìwọ jẹ́ arẹwà!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Ìwọ ní ojú àdàbà lábẹ́ ìbòjú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "irun rẹ bò ọ́ lójú bí ọ̀wọ́ ewúrẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Tí ó sọ̀kalẹ̀ lórí òkè Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyín rẹ̀ funfun bí i irun àgbò",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "tí ó gòkè wá láti ibi ìwẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "olúkúlùkù wọn bí èjìrẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "kò sí ọ̀kan nínú wọn tí ó da dúró.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ètè rẹ dàbí òwú òdòdó;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "ẹnu rẹ̀ dùn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "Ẹ̀rẹ̀kẹ́ rẹ dàbí ẹ̀là pomegiranate",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "lábẹ́ ìbòjú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrùn rẹ dàbí ilé ìṣọ́ Dafidi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "tí a kọ́ pẹ̀lú ìhámọ́ra;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "lórí rẹ̀ ni a fi ẹgbẹ̀rún (1,000) àpáta kọ́,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "gbogbo wọn jẹ́ àṣà àwọn alágbára.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmú rẹ̀ méjèèjì dàbí abo egbin méjì",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "tí wọ́n jẹ́ ìbejì",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "tí ń jẹ láàrín ìtànná ewéko lílì.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Títí ọjọ́ yóò fi rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "tí òjìji yóò fi fò lọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "èmi yóò lọ sí orí òkè ńlá òjìá",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "àti sí òkè kékeré tùràrí.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ara rẹ jẹ́ kìkì ẹwà, olólùfẹ́ mi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:7"
      },
      "items": [
        {
          "text": "kò sì ṣí àbàwọ́n lára rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a lọ kúrò ní Lebanoni, ìyàwó mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "ki a lọ kúrò ní Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "Àwa wò láti orí òkè Amana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "láti orí òkè ti Seniri, àti téńté Hermoni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "láti ibi ihò àwọn kìnnìún,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "láti orí òkè ńlá àwọn ẹkùn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti gba ọkàn mi, arábìnrin mi, ìyàwó mi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "ìwọ ti gba ọkàn mi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "pẹ̀lú ìwò ẹ̀ẹ̀kan ojú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "pẹ̀lú ọ̀kan nínú ìlẹ̀kẹ̀ ọrùn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìfẹ́ rẹ ti dùn tó, arábìnrin mi, ìyàwó mi!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "Ìfẹ́ rẹ tu ni lára ju ọtí wáìnì lọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "òórùn ìkunra rẹ sì ju òórùn gbogbo tùràrí lọ!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
