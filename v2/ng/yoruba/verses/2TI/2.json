  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2TI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ìwọ ọmọ mi, jẹ́ alágbára nínú oore-ọ̀fẹ́ ti ń bẹ nínú Kristi Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.1",
            "verseOrgIds": [
              "2TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ohun ti ìwọ ti gbọ́ lọ́dọ̀ mi níwájú ẹlẹ́rìí púpọ̀, àwọn náà ni kí ìwọ fi lé àwọn olóòtítọ́ ènìyàn lọ́wọ́, àwọn ti yóò lè máa kọ́ àwọn ẹlòmíràn pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe alábápín pẹ̀lú mi nínú ìpọ́njú, bí ọmọ-ogun rere Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.3",
            "verseOrgIds": [
              "2TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹni tí ń jagun ti ń fi ohun ayé yìí dí ara rẹ̀ lọ́wọ́, kí ó lè mú inú ẹni tí ó yàn ni ọmọ-ogun dùn.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.4",
            "verseOrgIds": [
              "2TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọ̀nà kan náà, bí ẹnikẹ́ni bá sì ń díje bí olùdíje, a kì í dé e ládé, bí kò ṣe bí ó bá parí rẹ̀ gẹ́gẹ́ bí ìlànà",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.5",
            "verseOrgIds": [
              "2TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àgbẹ̀ ti ó ń ṣe làálàá ni ó yẹ láti kọ́kọ́ mu nínú àwọn èso.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ronú lórí ohun ti èmi ń sọ; nítorí Olúwa yóò fún ọ lóye nínú ohun gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rántí Jesu Kristi, ti ó jíǹde kúrò nínú òkú, láti inú irú-ọmọ Dafidi gẹ́gẹ́ bí ìyìnrere mi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú èyí tí èmi ń rí ìpọ́njú títí dé inú ìdè bí arúfin; ṣùgbọ́n a kò de ọ̀rọ̀ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà mo ń faradà ohun gbogbo nítorí àwọn àyànfẹ́; kí àwọn náà pẹ̀lú lè ní ìgbàlà tí ń bẹ nínú Kristi Jesu pẹ̀lú ògo ayérayé.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òtítọ́ ni ọ̀rọ̀ náà,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2TI 2:11"
      },
      "items": [
        {
          "text": "bi àwa bá bá a kú,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2TI 2:11"
      },
      "items": [
        {
          "text": "àwa yóò yè pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá faradà,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.12",
            "verseOrgIds": [
              "2TI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2TI 2:12"
      },
      "items": [
        {
          "text": "àwa ó sì bá a jẹ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.12",
            "verseOrgIds": [
              "2TI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2TI 2:12"
      },
      "items": [
        {
          "text": "Bí àwa bá sẹ́ ẹ,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.12",
            "verseOrgIds": [
              "2TI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2TI 2:12"
      },
      "items": [
        {
          "text": "òun náà yóò sì sẹ́ wa.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.12",
            "verseOrgIds": [
              "2TI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa kò bá gbàgbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2TI 2:13"
      },
      "items": [
        {
          "text": "òun dúró ni olóòtítọ́,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2TI 2:13"
      },
      "items": [
        {
          "text": "nítorí òun kò lè sẹ́ ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òṣìṣẹ́ tí Ọlọ́run yàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nǹkan wọ̀nyí ni ki ó máa rán wọn létí. Máa kìlọ̀ fún wọn níwájú Olúwa pé, ki wọn ó yẹra kúrò nínú jíjiyàn ọ̀rọ̀ tí kò léèrè, bí kò ṣe ìparun fún àwọn tí ń gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣaápọn láti fi ara rẹ̀ hàn níwájú Ọlọ́run bi ẹni tí ó yege àti òṣìṣẹ́ tí kò ní láti tijú, tí ó ń pín ọ̀rọ̀ òtítọ́ bí ó ti yẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yà kúrò nínú ọ̀rọ̀ asán, nítorí tiwọn máa síwájú nínú àìwà-bí-Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ wọn yóò sì máa fẹ́ bí egbò kíkẹ̀; nínú àwọn ẹni tí Himeneu àti Filetu wà;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
            "verseOrgIds": [
              "2TI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ẹni tí ó ti ṣìnà kúrò nínú òtítọ́, tí ń wí pé àjíǹde ti kọjá ná; tí wọ́n sì ń bi ìgbàgbọ́ àwọn mìíràn ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.18",
            "verseOrgIds": [
              "2TI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìpìlẹ̀ Ọlọ́run tí ó dájú dúró ṣinṣin, ó ní èdìdì yìí, pé, \"Olúwa mọ àwọn tí í ṣe tirẹ̀.\" Àti pẹ̀lú, \"Kí olúkúlùkù ẹni tí ń pé orúkọ Olúwa kúrò nínú àìṣòdodo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nínú ilé ńlá, kì í ṣe kìkì ohun èlò wúrà àti ti fàdákà nìkan ni ń bẹ, ṣùgbọ́n ti igi àti amọ̀ pẹ̀lú; àti òmíràn sí ọlá, àti òmíràn sí àìlọ́lá.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.20",
            "verseOrgIds": [
              "2TI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá wẹ ara rẹ̀ mọ́ kúrò nínú ìwọ̀nyí, òun yóò jẹ́ ohun èlò sí ọlá, tí a yà sọ́tọ̀, tí ó sì yẹ fún ìlò baálé, tí a sì ti pèsè sílẹ̀ fún iṣẹ́ rere gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Máa sá fún ìfẹ́kúfẹ̀ẹ́ èwe, sì máa lépa òdodo, ìgbàgbọ́, ìfẹ́, àlàáfíà, pẹ̀lú àwọn tí ń ké pe Olúwa láti inú ọkàn funfun wá.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2TI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbéèrè òmùgọ̀ àti aláìní ẹ̀kọ́ nínú ni kí o kọ̀, bí o ti mọ̀ pe wọn máa dá ìjà sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2TI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
