  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JON 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àdúrà Jona",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jona gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.1",
                "verseOrgIds": [
                  "JON.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀ láti inú ẹja náà wá,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "\"Nínú ìpọ́njú mi ni mo kígbe sí",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.2",
                "verseOrgIds": [
                  "JON.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "òun sì gbọ́ ohùn mi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "Mo kígbe láti inú ipò òkú, mo pè fún ìrànwọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "ìwọ sì gbọ́ ohùn mi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ìwọ ti sọ mí sínú ibú,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "ní àárín Òkun,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "ìṣàn omi sì yí mi káàkiri;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "gbogbo bíbì omi àti rírú omi",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "rékọjá lórí mi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "'A ta mí nù kúrò níwájú rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n síbẹ̀ èmi yóò tún",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "máa wo ìhà tẹmpili mímọ́ rẹ.'",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi yí mi káàkiri, àní títí dé ọkàn;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:5"
      },
      "items": [
        {
          "text": "ibú yí mi káàkiri,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:5"
      },
      "items": [
        {
          "text": "a fi koríko odò wé mi lórí.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sọ̀kalẹ̀ lọ sí ìsàlẹ̀ àwọn òkè ńlá;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "ilẹ̀ ayé pẹ̀lú ìdènà rẹ̀ yí mi ká títí:",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìwọ ti mú ẹ̀mí mi wá sókè láti inú ibú wá,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.6",
                "verseOrgIds": [
                  "JON.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ó rẹ ọkàn mi nínú mi,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:7"
      },
      "items": [
        {
          "text": "èmi rántí rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.7",
                "verseOrgIds": [
                  "JON.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:7"
      },
      "items": [
        {
          "text": "àdúrà mi sì wá sí ọ̀dọ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:7"
      },
      "items": [
        {
          "text": "nínú tẹmpili mímọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn tí ń fàmọ́ òrìṣà èké",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:8"
      },
      "items": [
        {
          "text": "kọ àánú ara wọn sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi yóò fi orin ọpẹ́, rú ẹbọ sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:9"
      },
      "items": [
        {
          "text": "Èmi yóò san ẹ̀jẹ́ tí mo ti jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:9"
      },
      "items": [
        {
          "text": "'Ìgbàlà wá láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.9",
                "verseOrgIds": [
                  "JON.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.10",
                "verseOrgIds": [
                  "JON.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sì pàṣẹ fún ẹja náà, ó sì pọ Jona sí orí ilẹ̀ gbígbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
    }
  ],
