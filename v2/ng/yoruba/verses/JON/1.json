  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JON 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jona sá ní iwájú",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.1",
                "verseOrgIds": [
                  "JON.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Jona ọmọ Amittai wá, wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dìde lọ sí ìlú ńlá Ninefe kí o sì wàásù sí i, nítorí ìwà búburú rẹ̀ gòkè wá iwájú mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jona dìde kúrò láti sálọ sí Tarṣiṣi kúrò níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.3",
                "verseOrgIds": [
                  "JON.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì sọ̀kalẹ̀ lọ sí Joppa, ìbí ti ó tí rí ọkọ̀ kan tí ń lọ sí Tarṣiṣi: lẹ́yìn ti ó sanwó ọkọ̀, ó wọlé sínú rẹ̀, láti bá wọn lọ sí Tarṣiṣi kúrò níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.3",
                "verseOrgIds": [
                  "JON.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.4",
                "verseOrgIds": [
                  "JON.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "rán ìjì ńlá jáde sí ojú Òkun, ìjì líle sì wà nínú Òkun tó bẹ́ẹ̀ tí ọkọ̀ náà dàbí ẹni pé yóò fọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn atukọ̀ bẹ̀rù, olúkúlùkù sì ń kígbe sí ọlọ́run rẹ̀, wọ́n kó ẹrù tí ó wà nínú ọkọ̀ dà sínú Òkun, kí ó bá à lè fúyẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JON 1:5"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n Jona sọ̀kalẹ̀ lọ sí ìsàlẹ̀ ọkọ̀ ó sì dùbúlẹ̀, ó sùn wọra.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni olórí ọkọ̀ tọ̀ ọ́ wá, ó sì wí fún un pé, \"Èéṣe tí ìwọ fi sùn, ìwọ olóòórùn? Dìde kí o ké pe Ọlọ́run rẹ! Bóyá yóò ro tiwa, kí àwa má ba à ṣègbé.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn atukọ̀ sọ fún ara wọn pé, \"Wá, ẹ jẹ́ kí a sẹ́ kèké, kí àwa kí o le mọ̀ nítorí ta ni búburú yìí ṣe wá sórí wa.\" Wọ́n ṣẹ́ kèké, kèké sì mú Jona.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọn wí fún un pé, \"Sọ fún wa, àwa bẹ̀ ọ́, nítorí ta ni búburú yìí ṣe wá sórí wa? Kí ni iṣẹ́ rẹ? Níbo ni ìwọ ti wá? Kí ni orúkọ ìlú rẹ? Ẹ̀yà orílẹ̀-èdè wo sì ni ìwọ sì í ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì dá wọn lóhùn pé, \"Heberu ni èmi, mo sì bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.9",
                "verseOrgIds": [
                  "JON.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run ọ̀run ẹni tí ó dá Òkun àti ìyàngbẹ ilẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ọkùnrin náà bẹ̀rù gidigidi, wọn sì wí fún un pé, \"Èéṣe tí ìwọ fi ṣe èyí?\" (Nítorí àwọn ọkùnrin náà mọ̀ pé ó ń sá kúrò ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.10",
                "verseOrgIds": [
                  "JON.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni, nítorí òun ti sọ fun wọn bẹ́ẹ̀).",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n wí fún un pé, \"Kí ni kí àwa ó ṣe sí ọ kí Òkun lè dákẹ́ fún wa?\" Nítorí Òkun ru, ó sì ja ẹ̀fúùfù líle.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì wí fún wọn pé, \"Ẹ gbé mi, kí ẹ sì sọ mi sínú Òkun, bẹ́ẹ̀ ni okun yóò sì dákẹ́ fún un yin. Nítorí èmi mọ̀ pé, nítorí mi ni ẹ̀fúùfù líle yìí ṣe dé bá a yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ọkùnrin náà gbìyànjú gidigidi láti mú ọkọ̀ wà sí ilẹ̀, ṣùgbọ́n wọn kò lè ṣe é: nítorí tí Òkun túbọ̀ ru sí i, ó sì ja ẹ̀fúùfù líle sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà wọ́n kígbe sí",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.14",
                "verseOrgIds": [
                  "JON.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.14",
                "verseOrgIds": [
                  "JON.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "àwa bẹ̀ ọ́, má ṣe jẹ́ kí àwa ṣègbé nítorí ẹ̀mí ọkùnrin yìí. Má sì ka ẹ̀jẹ̀ aláìṣẹ̀ sí wa ní ọrùn, nítorí ìwọ,",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.14",
                "verseOrgIds": [
                  "JON.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ti ṣe bí ó ti wù ọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n gbé Jona, tí wọ́n sì sọ ọ́ sínú Òkun, Òkun sì dẹ́kun ríru rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ọkùnrin náà bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.16",
                "verseOrgIds": [
                  "JON.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "gidigidi, wọn si rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JON.1.16",
                "verseOrgIds": [
                  "JON.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì jẹ́ ẹ̀jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
