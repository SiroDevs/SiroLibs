  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ECC 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó dàbí ọlọ́gbọ́n ènìyàn?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Ta ni ó mọ ìtumọ̀ ohun gbogbo?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Ọgbọ́n a máa mú ojú ènìyàn dán",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "ó sì máa ń pààrọ̀ ìrínisí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pa òfin ọba mọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sọ wí pé, pa òfin ọba mọ́, nítorí pé, ìwọ ti ṣe ìbúra níwájú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí ojú kán ọ láti kúrò ní iwájú ọba, má ṣe dúró nínú ohun búburú, nítorí yóò ṣe ohunkóhun tí ó bá tẹ́ ẹ lọ́rùn.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.3",
            "verseOrgIds": [
              "ECC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí ọ̀rọ̀ ọba ni àṣẹ, ta ni ó le è sọ fún un wí pé, \"Kí ni ìwọ ń ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.4",
            "verseOrgIds": [
              "ECC.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá pa àṣẹ rẹ̀ mọ́, kò ní wá sí ìpalára kankan,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:5"
      },
      "items": [
        {
          "text": "àyà ọlọ́gbọ́n ènìyàn yóò sì mọ àsìkò tí ó tọ́ àti ọ̀nà tí yóò gbà ṣe é.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun gbogbo ni ó ní àsìkò àti ọ̀nà tí ó tọ́ láti ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n, òsì ènìyàn pọ̀ sí orí ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí kò sí ẹni tí ó mọ ọjọ́-ọ̀lá,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:7"
      },
      "items": [
        {
          "text": "ta ni ó le è sọ fún un ohun tí ó ń bọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹni tí ó lágbára lórí afẹ́fẹ́ láti gbà á dúró,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "nítorí náà, kò sí ẹni tí ó ní agbára lórí ọjọ́ ikú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "Bí ó ti jẹ́ wí pé kò sí ẹni tí a dá sílẹ̀ nígbà ogun,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ náà ni ìkà kò ní fi àwọn tí ó ń ṣe é sílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "bí ó ti jẹ́ wí pé kò sí ẹni tí a dá sílẹ̀ nígbà ogun,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ náà ni ìwà búburú kò le gba àwọn tí ó ń ṣe é sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo nǹkan wọ̀nyí ni mo ti rí, tí mo sì ń múlò ní ọkàn mi sí gbogbo iṣẹ́ tí a ti ṣe lábẹ́ oòrùn. Ìgbà kan wà tí ẹnìkan ń ṣe olórí àwọn tókù fún ìpalára rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo tún rí ìsìnkú ènìyàn búburú—àwọn tí wọ́n máa ń wá tí wọ́n sì ń lọ láti ibi mímọ́ kí wọn sì gba ìyìn ní ìlú tàbí tí wọ́n ti ṣe èyí. Eléyìí pẹ̀lú kò ní ìtumọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.10",
            "verseOrgIds": [
              "ECC.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a kò bá tètè ṣe ìdájọ́ fún ẹlẹ́ṣẹ̀ kíákíá, ọkàn àwọn ènìyàn a máa kún fún ọ̀pọ̀lọpọ̀ ìmọ̀ láti ṣe ibi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.11",
            "verseOrgIds": [
              "ECC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ènìyàn búburú tó dẹ́ṣẹ̀ nígbà ọgọ́rùn-ún tilẹ̀ wà láààyè fún ìgbà pípẹ́, mo mọ̀ wí pé yóò dára fún ẹni tí ó bẹ̀rù Ọlọ́run, tí ó bẹ̀rù níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kì yóò dára fún ènìyàn búburú, bẹ́ẹ̀ ni kì yóò fa ọjọ́ rẹ̀ gún tí ó dà bí òjìji, nítorí tí kò bẹ̀rù níwájú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun mìíràn tún wà tí kò ní ìtumọ̀, tí ó ń ṣẹlẹ̀ láyé olódodo tí ó ń gba ohun tí ó tọ́ sí òṣìkà àti ènìyàn búburú tí ó ń gba ohun tí ó tọ́ sí olódodo. Mo sọ wí pé eléyìí gan an kò ní ìtumọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.14",
            "verseOrgIds": [
              "ECC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà mo kan sáárá sí ìgbádùn ayé, nítorí pé kò sí ohun tí ó dára fún ènìyàn ní abẹ́ oòrùn ju pé kí ó jẹ, kí ó mu, kí inú rẹ̀ sì dùn lọ. Nígbà náà ni ìdùnnú yóò bá a rìn nínú iṣẹ́ ẹ rẹ̀, ní gbogbo ọjọ́ ayé ti Ọlọ́run tí fi fún un lábẹ́ oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo lo ọkàn mi láti mọ ọgbọ́n àti láti wo wàhálà ènìyàn ní ayé.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.16",
            "verseOrgIds": [
              "ECC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo rí gbogbo ohun tí Ọlọ́run tí ṣe, kò sí ẹnìkan tí ó le è mòye ohun tí ó ń lọ lábẹ́ oòrùn. Láìbìkítà gbogbo ìyànjú rẹ̀ láti wá rí jáde, ènìyàn kò le è mọ ìtumọ̀ rẹ̀, kódà bí ọlọ́gbọ́n ènìyàn rò wí pé òun mọ̀ ọ́n, kò le è ní òye rẹ̀ ní pàtó.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.17",
            "verseOrgIds": [
              "ECC.8.17"
            ]
          }
        }
      ]
    }
  ],
