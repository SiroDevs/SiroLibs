              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń jẹ nínú òkùnkùn ní gbogbo ọjọ́ ọ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
