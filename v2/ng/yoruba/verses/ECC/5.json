        "style": "q2",
        "vid": "ECC 5:17"
      },
      "items": [
        {
          "text": "pẹ̀lú iyè ríra tí ó ga, ìnira àti ìbínú.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        }
