        "style": "s1"
      },
      "items": [
        {
          "text": "Asán ni ipò gíga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òtòṣì ìpẹ́ẹ̀rẹ̀ tí ó ṣe ọlọ́gbọ́n, ó sàn ju arúgbó àti aṣiwèrè ọba lọ tí kò mọ bí yóò ti ṣe gba ìmọ̀ràn.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé láti inú túbú ni ó ti jáde láti jẹ ọba, bí a tilẹ̀ bí i ní tálákà ní ìjọba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo rí gbogbo alààyè tí ń rìn lábẹ́ oòrùn, pẹ̀lú ìpẹ́ẹ̀rẹ̀ kejì tí yóò gba ipò ọba yìí.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn tí ó wà níwájú wọn kò sì lópin, ọ̀gọ̀ọ̀rọ̀ àwọn ènìyàn ní ó jẹ ọba lé lórí, ẹni tí ó wà ní ipò yìí kò dùn mọ́ àwọn tí ó tẹ̀lé wọn nínú. Asán ni eléyìí pẹ̀lú jẹ́, ó dàbí ẹni ń gbìyànjú àti mú afẹ́fẹ́ ni.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
      ]
    }
