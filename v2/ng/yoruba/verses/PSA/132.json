                "verseId": "PSA.132.1",
                "verseOrgIds": [
                  "PSA.132.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", rántí Dafidi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
