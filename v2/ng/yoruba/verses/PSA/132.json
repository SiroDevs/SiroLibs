      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:1"
      },
      "items": [
        {
          "text": "nínú gbogbo ìpọ́njú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
