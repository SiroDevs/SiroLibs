  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "72",
        "style": "c",
        "sid": "PSA 72"
      },
      "items": [
        {
          "text": "72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ti Solomoni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 72:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ìdájọ́ fún àwọn ọba, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:1"
      },
      "items": [
        {
          "text": "ọmọ-aládé ni ìwọ fi òdodo rẹ fún.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 72:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò ṣe ìdájọ́ àwọn ènìyàn rẹ̀ pẹ̀lú òdodo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:2"
      },
      "items": [
        {
          "text": "yóò sì máa fi ẹ̀tọ́ ṣe ìdájọ́ àwọn tálákà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 72:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn òkè ńlá yóò máa mú àlàáfíà fún àwọn ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:3"
      },
      "items": [
        {
          "text": "àti òkè kéékèèké nípa òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 72:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò dáàbò bo àwọn tí a pọ́n lójú láàrín àwọn ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "yóò gba àwọn ọmọ aláìní;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "yóò sì fa àwọn aninilára ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 72:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn òtòṣì àti aláìní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:5"
      },
      "items": [
        {
          "text": "yóò máa fi ọ̀wọ̀ ńlá fún ọ nígbà gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:5"
      },
      "items": [
        {
          "text": "níwọ̀n ìgbà tí oòrùn àti òṣùpá bá ń ràn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:5"
      },
      "items": [
        {
          "text": "yóò ti pẹ́ tó, láti ìrandíran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 72:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò dàbí òjò tí ó ń rọ̀ sórí pápá ìrẹ́mọ́lẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:6"
      },
      "items": [
        {
          "text": "bí ọwọ́ òjò tó ń rin ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 72:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olódodo yóò gbilẹ̀ ni ọjọ́ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:7"
      },
      "items": [
        {
          "text": "ọ̀pọ̀lọpọ̀ àlàáfíà yóò sì wà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:7"
      },
      "items": [
        {
          "text": "títí tí òṣùpá kò fi ní sí mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 72:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò máa jẹ ọba láti òkun dé òkun",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:8"
      },
      "items": [
        {
          "text": "àti láti odò Eufurate títí dé òpin ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 72:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó wà ní aginjù yóò tẹríba fún un",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:9"
      },
      "items": [
        {
          "text": "àwọn ọ̀tá rẹ̀ yóò máa lá erùpẹ̀ ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 72:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọba Tarṣiṣi àti ti erékùṣù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "wọn yóò mú ọrẹ wá fún un;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "àwọn ọba Ṣeba àti Seba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "wọn ó mú ẹ̀bùn wá fún un.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 72:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọba yóò tẹríba fún un",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:11"
      },
      "items": [
        {
          "text": "àti gbogbo orílẹ̀-èdè yóò sìn ín.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 72:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí yóò gba àwọn aláìní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "nígbà tí ó bá ń ké,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "tálákà àti ẹni tí kò ní olùrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 72:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò káàánú àwọn aláìlera àti aláìní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:13"
      },
      "items": [
        {
          "text": "yóò pa aláìní mọ́ kúrò nínú ikú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 72:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò ra ọkàn wọn padà lọ́wọ́ ẹ̀tàn àti ipá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:14"
      },
      "items": [
        {
          "text": "nítorí ẹ̀jẹ̀ wọn ṣọ̀wọ́n níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
