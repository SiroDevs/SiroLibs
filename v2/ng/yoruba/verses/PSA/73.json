      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 73",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Saamu ti Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 73:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ Ọlọ́run dára fún Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:1"
      },
      "items": [
        {
          "text": "fún àwọn ọlọ́kàn funfun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 73:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ó ṣe ti èmi, ẹsẹ̀ mi ti yẹ̀ tán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:2"
      },
      "items": [
        {
          "text": "ìrìn mi fẹ́rẹ̀ yọ̀ tán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 73:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi ń ṣe ìlara àwọn tó ń ṣe féfé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:3"
      },
      "items": [
        {
          "text": "nígbà tí mo bá rí àlàáfíà àwọn ènìyàn búburú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 73:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò ṣe wàhálà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:4"
      },
      "items": [
        {
          "text": "ara wọn mókun wọn sì lágbára.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 73:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kò ní ìpín nínú àjàgà tó ń ṣẹlẹ̀ sí ènìyàn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:5"
      },
      "items": [
        {
          "text": "a kò pọ́n wọn lójú nípa ẹlòmíràn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 73:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbéraga ni ọ̀ṣọ́ ọrùn wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:6"
      },
      "items": [
        {
          "text": "ìwà ipá bò wọ́n mọ́lẹ̀ bí aṣọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 73:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti inú ọkàn àrékérekè ni àìṣòdodo ti wá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:7"
      },
      "items": [
        {
          "text": "ẹ̀rí ọkàn búburú wọn kò ní òdínwọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 73:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ń ṣẹ̀sín, wọn sì ń sọ̀rọ̀-òdì ní ti ìnilára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:8"
      },
      "items": [
        {
          "text": "wọ́n ń sọ̀rọ̀ láti ibi gíga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 73:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ń gbé ẹ̀mí wọn lé ọ̀run",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:9"
      },
      "items": [
        {
          "text": "ahọ́n wọn gba ipò ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 73:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà àwọn ènìyàn wọn yípadà sí wọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:10"
      },
      "items": [
        {
          "text": "wọ́n sì mu omi ní ọ̀pọ̀lọpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 73:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wí pé, \"Báwo ni Ọlọ́run yóò ṣe mọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:11"
      },
      "items": [
        {
          "text": "Ọ̀gá-ògo ha ní ìmọ̀ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 73:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ènìyàn búburú ṣe rí nìyí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:12"
      },
      "items": [
        {
          "text": "ènìyàn asán, wọ́n ń pọ̀ ní ọrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 73:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ nínú asán ni mo pa ọkàn mi mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:13"
      },
      "items": [
        {
          "text": "nínú asán ni mo wẹ ọwọ́ mi ní àìlẹ́ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 73:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní gbogbo ọjọ́ ni a ń yọ mí lẹ́nu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:14"
      },
      "items": [
        {
          "text": "a sì ń jẹ mí ní yà ní gbogbo òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 73:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá wí pé, \"Èmi ó wí báyìí,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:15"
      },
      "items": [
        {
          "text": "èmi ó ṣẹ̀ sí ìran àwọn ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 73:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo gbìyànjú láti mọ èyí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:16"
      },
      "items": [
        {
          "text": "Ó jẹ́ ìnilára fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
