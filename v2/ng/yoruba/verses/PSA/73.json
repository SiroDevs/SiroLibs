      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "ÌWÉ KẸTA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
