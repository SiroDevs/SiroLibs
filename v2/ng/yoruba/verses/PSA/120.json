    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Orin fún ìgòkè.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 120:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ké pe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.120.1",
                "verseOrgIds": [
                  "PSA.120.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nínú ìpọ́njú mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:1"
      },
      "items": [
        {
          "text": "ó sì dá mi lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 120:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbà mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.120.2",
                "verseOrgIds": [
                  "PSA.120.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", kúrò lọ́wọ́ ètè èké",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:2"
      },
      "items": [
        {
          "text": "àti lọ́wọ́ ahọ́n ẹ̀tàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 120:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni kí a fi fún ọ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:3"
      },
      "items": [
        {
          "text": "Àti kí ni kí a túnṣe fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:3"
      },
      "items": [
        {
          "text": "ìwọ ahọ́n ẹ̀tàn?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 120:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò bá ọ wí pẹ̀lú ọfà mímú ológun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:4"
      },
      "items": [
        {
          "text": "pẹ̀lú ẹ̀yín iná igi ìgbálẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 120:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ni fún mi tí èmi ṣe àtìpó ní Meṣeki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:5"
      },
      "items": [
        {
          "text": "nítorí èmi gbé nínú àgọ́ ìlú Kedari!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 120:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti pẹ́ tí èmi ti ń gbé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:6"
      },
      "items": [
        {
          "text": "láàrín àwọn tí ó kórìíra àlàáfíà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 120:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn àlàáfíà ni mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n nígbà tí mo bá sọ̀rọ̀, ogun ni dúró fun wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    }
  ],
