  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PSA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Saamu. Orin. Fún ìyàsímímọ́ Tẹmpili. Ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò kókìkí i rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.1",
                "verseOrgIds": [
                  "PSA.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:1"
      },
      "items": [
        {
          "text": "nítorí ìwọ ni ó gbé mi lékè",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:1"
      },
      "items": [
        {
          "text": "tí ìwọ kò sì jẹ́ kí àwọn ọ̀tá mi kí ó yọ̀ mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.2",
                "verseOrgIds": [
                  "PSA.30.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, èmi ké pè ọ́ fún ìrànlọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:2"
      },
      "items": [
        {
          "text": "ìwọ sì ti wò mí sàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.3",
                "verseOrgIds": [
                  "PSA.30.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ ti yọ ọkàn mi jáde kúrò nínú isà òkú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:3"
      },
      "items": [
        {
          "text": "mú mi padà bọ̀ sípò alààyè kí èmi má ba à lọ sínú ihò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ orin ìyìn sí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.4",
                "verseOrgIds": [
                  "PSA.30.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ̀yin olódodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:4"
      },
      "items": [
        {
          "text": "kí ẹ sì fi ọpẹ́ fún orúkọ rẹ̀ mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìbínú rẹ̀ wà fún ìgbà díẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "ojúrere rẹ̀ wà títí ayérayé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "ẹkún lè pẹ́ títí di alẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ayọ̀ yóò wá ní òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà ayé mi, mo wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:6"
      },
      "items": [
        {
          "text": "\"a kì yóò ṣí mi ní ipò padà.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ojúrere rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.7",
                "verseOrgIds": [
                  "PSA.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "ìwọ ti gbé mi kalẹ̀ bí òkè tí ó ní agbára;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "ìwọ pa ojú rẹ mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "àyà sì fò mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí ọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.8",
                "verseOrgIds": [
                  "PSA.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ni mo ké pè é;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:8"
      },
      "items": [
        {
          "text": "àti sí Olúwa ni mo sọkún fún àánú:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èrè kí ni ó wà nínú ikú ìparun mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "nínú lílọ sí ihò mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "Eruku yóò a yìn ọ́ bí?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "Ǹjẹ́ yóò sọ nípa òdodo rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.10",
                "verseOrgIds": [
                  "PSA.30.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí o sì ṣàánú fún mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:10"
      },
      "items": [
        {
          "text": "ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.30.10",
                "verseOrgIds": [
                  "PSA.30.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", jẹ́ olùrànlọ́wọ́ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti yí ìkáàánú mi di ijó fún mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:11"
      },
      "items": [
        {
          "text": "ìwọ sì ti bọ́ aṣọ ọ̀fọ̀ mi, o sì fi aṣọ ayọ̀ wọ̀ mí,",
