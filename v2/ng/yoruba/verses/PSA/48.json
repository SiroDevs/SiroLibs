  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "PSA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Orin. Saamu ti àwọn ọmọ Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni ńlá ní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.1",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", tí ó sì yẹ láti máa yìn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:1"
      },
      "items": [
        {
          "text": "ní ìlú Ọlọ́run wa, lórí òkè mímọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dára nínú ipò ìtẹ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "ayọ̀ gbogbo ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "òkè Sioni, ní ìhà àríwá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "ní ìlú ọba ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run wà nínú ààbò ààfin rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:3"
      },
      "items": [
        {
          "text": "ó fi ara rẹ̀ hàn láti jẹ́ odi alágbára.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọba kógun jọ pọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:4"
      },
      "items": [
        {
          "text": "wọ́n jùmọ̀ ń kọjá lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn rí i, bẹ́ẹ̀ ni ẹnu sì yà wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:5"
      },
      "items": [
        {
          "text": "a yọ wọ́n lẹ́nu, wọ́n yára lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀rù sì bà wọ́n níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:6"
      },
      "items": [
        {
          "text": "ìrora gẹ́gẹ́ bí obìnrin tí ó wà nínú ìrọbí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ bà wọ́n jẹ́ gẹ́gẹ́ bí ọkọ̀ orí omi Tarṣiṣi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:7"
      },
      "items": [
        {
          "text": "wọ́n fọ́nká láti ọwọ́ ìjì ìlà-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí a ṣe gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwa rí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "ní inú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.8",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "ní ìlú Ọlọ́run wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "Ọlọ́run jẹ́ kí ó wà ní abẹ́ ààbò títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.8",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láàrín tẹmpili rẹ, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:9"
      },
      "items": [
        {
          "text": "àwa ti ń sọ ti ìṣeun ìfẹ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí orúkọ rẹ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:10"
      },
      "items": [
        {
          "text": "ìyìn rẹ̀ dé òpin ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:10"
      },
      "items": [
        {
          "text": "ọwọ́ ọ̀tún rẹ kún fún òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí òkè Sioni kí ó yọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:11"
      },
      "items": [
        {
          "text": "kí inú àwọn ọmọbìnrin Juda kí ó dùn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:11"
      },
      "items": [
        {
          "text": "nítorí ìdájọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rìn Sioni kiri lọ yíká rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:12"
      },
      "items": [
        {
          "text": "ka ilé ìṣọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi odi rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:13"
      },
      "items": [
        {
          "text": "kíyèsi àwọn ààfin rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
