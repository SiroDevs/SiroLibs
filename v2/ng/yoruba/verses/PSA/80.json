        "vid": "PSA 80:16"
      },
      "items": [
        {
          "text": "ní ìfibú, àwọn ènìyàn rẹ̀ ń ṣègbé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.16",
            "verseOrgIds": [
