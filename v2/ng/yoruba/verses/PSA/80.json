  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "80",
        "style": "c",
        "sid": "PSA 80"
      },
      "items": [
        {
          "text": "80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Tí ohùn \"Lílì Ti Májẹ̀mú.\" Ti Safu. Saamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 80:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ tiwa, ìwọ olùṣọ́-àgùntàn Israẹli;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "ìwọ tí ó darí Josẹfu bí ọ̀wọ́ ẹran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "Ìwọ tí o jókòó lórí ìtẹ́ láàrín Kérúbù,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "tàn jáde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 80:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "níwájú Efraimu, Benjamini àti Manase.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "Ru agbára rẹ̀ sókè;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "wá fún ìgbàlà wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 80:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú wa padà bọ̀ sípò, ìwọ Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "jẹ́ kí ojú rẹ kí ó tan ìmọ́lẹ̀ sí wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "kí a bá à lè gbà wá là.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 80:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.80.4",
                "verseOrgIds": [
                  "PSA.80.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run alágbára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "ìbínú rẹ̀ yóò ti pẹ́ tó",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "sí àdúrà àwọn ènìyàn rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 80:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti fi oúnjẹ bọ́ wọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:5"
      },
      "items": [
        {
          "text": "ìwọ ti mú wọn wa ẹkún mu ní ẹ̀kúnrẹ́rẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 80:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sọ wá di ẹlẹ́yà fún àwọn aládùúgbò wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:6"
      },
      "items": [
        {
          "text": "àwọn ọ̀tá wa sì ń yọ̀ wá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 80:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tún wa yípadà, ìwọ, Ọlọ́run alágbára;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "jẹ́ kí ojú rẹ tàn sí wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "kí a ba à lè gbà wá là.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 80:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mú àjàrà jáde láti Ejibiti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:8"
      },
      "items": [
        {
          "text": "ìwọ lé àwọn kèfèrí jáde, o sì gbìn ín.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 80:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ṣí ààyè sílẹ̀ fún un,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:9"
      },
      "items": [
        {
          "text": "ìwọ sì mu ta gbòǹgbò jinlẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:9"
      },
      "items": [
        {
          "text": "ó sì kún ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 80:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bò àwọn òkè mọ́lẹ̀ òkè pẹ̀lú òjìji rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:10"
      },
      "items": [
        {
          "text": "ẹ̀ka rẹ̀ dàbí kedari Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 80:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O yọ ẹ̀ka rẹ̀ sínú Òkun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:11"
      },
      "items": [
        {
          "text": "ọwọ́ rẹ̀ sí odò ńlá nì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 80:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí ìwọ fi wó odi rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:12"
      },
      "items": [
        {
          "text": "tí àwọn ènìyàn tí ó ń kọjá fi ń ṣa èso rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 80:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìmàdò láti inú igbó ń bá a jẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:13"
      },
      "items": [
        {
          "text": "àti ẹranko igbó ń jẹ ẹ́ run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 80:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yípadà sí wa, àwa ń bẹ̀ ọ́, Ọlọ́run alágbára!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Bojú wolẹ̀ láti ọ̀run kí o sì wò ó!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
