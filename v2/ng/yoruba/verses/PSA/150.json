      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:2"
      },
      "items": [
        {
          "text": "Ẹ yìn ín fún títóbi rẹ̀ tí ó tayọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
