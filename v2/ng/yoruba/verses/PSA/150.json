      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "ẹ yìn ín nínú agbára ọ̀run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
