      "attrs": {
        "style": "q2",
        "vid": "PSA 25:1"
      },
      "items": [
        {
          "text": "ìwọ ni mo gbé ọkàn mi sókè sí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.1",
            "verseOrgIds": [
              "PSA.25.1"
            ]
