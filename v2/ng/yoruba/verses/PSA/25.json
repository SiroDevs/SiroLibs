      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run, èmi gbẹ́kẹ̀lé ọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "má ṣe jẹ́ kí ojú ó tì mí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "má ṣe jẹ́ kí àwọn ọ̀tá mi ó yọ̀ mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó dúró tì ọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "ojú kì yóò tì í,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "àwọn tí ń ṣẹ̀ láìnídìí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "ni kí ojú kí ó tì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ọ̀nà rẹ hàn mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.4",
                "verseOrgIds": [
                  "PSA.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:4"
      },
      "items": [
        {
          "text": "kọ mi ní ipa tìrẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣe amọ̀nà mi nínú òtítọ́ ọ̀ rẹ, kí o sì kọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "nítorí ìwọ ni Ọlọ́run ìgbàlà mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "ìwọ ni mo dúró tì ní gbogbo ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rántí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.6",
                "verseOrgIds": [
                  "PSA.25.6"
                ]
              }
            }
          ]
        },
        {
          "text": "àánú àti ìfẹ́ ẹ̀ rẹ̀ ńlá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:6"
      },
      "items": [
        {
          "text": "torí pé wọ́n ti wà ní ìgbà àtijọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe rántí àwọn ẹ̀ṣẹ̀ ìgbà èwe mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "tàbí ìrékọjá mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí i ìfẹ́ ẹ rẹ̀ rántí mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "nítorí tí ìwọ dára, Ìwọ!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.7",
                "verseOrgIds": [
                  "PSA.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rere àti ẹni ìdúró ṣinṣin ní",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.8",
                "verseOrgIds": [
                  "PSA.25.8"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:8"
      },
      "items": [
        {
          "text": "nítorí náà, ó kọ́ àwọn ẹlẹ́ṣẹ̀ ni ọ̀nà náà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe amọ̀nà àwọn onírẹ̀lẹ̀ ni ohun tí ó dára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:9"
      },
      "items": [
        {
          "text": "ó sì kọ́ àwọn onírẹ̀lẹ̀ ní ọ̀nà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ipa ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.10",
                "verseOrgIds": [
                  "PSA.25.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ìfẹ́ àti òdodo tí ó dúró ṣinṣin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:10"
      },
      "items": [
        {
          "text": "fún àwọn tí ó pa májẹ̀mú àti ẹ̀rí rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí orúkọ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.11",
                "verseOrgIds": [
                  "PSA.25.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:11"
      },
      "items": [
        {
          "text": "dárí ẹ̀bi ẹ̀ṣẹ̀ mi jì mí, nítorí tí ó tóbi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn wo ni ó bẹ̀rù",
