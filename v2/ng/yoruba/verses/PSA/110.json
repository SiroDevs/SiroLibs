        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.110.1",
                "verseOrgIds": [
                  "PSA.110.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Olúwa mi pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 110:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "\"Ìwọ jókòó ní ọwọ́ ọ̀tún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "títí èmi yóò fi sọ àwọn ọ̀tá rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:1"
      },
      "items": [
        {
          "text": "di àpótí ìtìsẹ̀ rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 110:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.110.2",
                "verseOrgIds": [
                  "PSA.110.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò na ọ̀pá agbára rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:2"
      },
      "items": [
        {
          "text": "láti Sioni wá, ìwọ jẹ ọba láàrín àwọn ọ̀tá rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 110:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn rẹ jẹ́ ọ̀rẹ́ àtinúwá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "ní ọjọ́ ìjáde ogun rẹ, nínú ẹwà mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "láti inú òwúrọ̀ wá ìwọ ni ìrì ẹwà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 110:4"
          },
          "items": [
