    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 103:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.1",
                "verseOrgIds": [
                  "PSA.103.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ ọkàn mi; àti gbogbo ohun tí ó wà nínú mi, yín orúkọ rẹ̀ mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 103:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.2",
                "verseOrgIds": [
                  "PSA.103.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ ọkàn mi, kí o má ṣe gbàgbé gbogbo oore rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 103:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí ó dárí gbogbo ẹ̀ṣẹ̀ rẹ̀ jì ọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:3"
      },
      "items": [
        {
          "text": "tí ó sì wo gbogbo ààrùn rẹ̀ sàn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 103:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí ó ra ẹ̀mí rẹ padà kúrò nínú kòtò ikú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:4"
      },
      "items": [
        {
          "text": "ẹni tí ó fi ìṣeun ìfẹ́ àti ìyọ́nú dé ọ ní adé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 103:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí ó fi ohun dídára tẹ́ ọ lọ́rùn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:5"
      },
      "items": [
        {
          "text": "kí ìgbà èwe rẹ̀ lè di ọ̀tún bí ti ẹyẹ idì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 103:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.6",
                "verseOrgIds": [
                  "PSA.103.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ń ṣe òdodo àti ìdájọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:6"
      },
      "items": [
        {
          "text": "gbogbo àwọn tí a ni lára.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 103:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi ọ̀nà rẹ̀ hàn fún Mose, iṣẹ́ rẹ̀ fun àwọn ọmọ Israẹli;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 103:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.8",
                "verseOrgIds": [
                  "PSA.103.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni aláàánú àti olóore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:8"
      },
      "items": [
        {
          "text": "ó lọ́ra láti bínú, ó sì pọ̀ ní ìfẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 103:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kì í bá ni wí ní ìgbà gbogbo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:9"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni kì í pa ìbínú rẹ mọ́ láéláé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 103:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kì í ṣe sí wa gẹ́gẹ́ bí ẹ̀ṣẹ̀ wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:10"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni kì í san án fún wa gẹ́gẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 103:10"
      },
      "items": [
        {
          "text": "bí àìṣedéédéé wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 103:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí ọ̀run ṣe ga sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:11"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ìfẹ́ rẹ̀ tóbi sí àwọn tí ó bẹ̀rù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 103:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìlà-oòrùn ti jìnnà sí ìwọ̀-oòrùn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:12"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ó ṣe mú ìrékọjá wá jìnnà sí wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 103:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí baba ti ń ṣe ìyọ́nú sí àwọn ọmọ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:13"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.13",
                "verseOrgIds": [
                  "PSA.103.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ń ṣe ìyọ́nú sí àwọn tí ó bẹ̀rù rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 103:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí tí ó mọ dídá wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:14"
      },
      "items": [
        {
          "text": "ó rántí pé erùpẹ̀ ni wá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 103:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ṣe ti ènìyàn ni, ọjọ́ rẹ̀ dàbí koríko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:15"
      },
      "items": [
        {
          "text": "ó gbilẹ̀ bí ìtànná ewéko igbó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 103:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "afẹ́fẹ́ fẹ́ kọjá lọ lórí rẹ̀,",
          "type": "text",
          "attrs": {
