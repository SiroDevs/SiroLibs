  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PSA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.1",
                "verseOrgIds": [
                  "PSA.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mo ti rí ààbò;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:1"
      },
      "items": [
        {
          "text": "má ṣe jẹ́ kí ojú kí ó tì mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:1"
      },
      "items": [
        {
          "text": "gbà mí nínú òdodo rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tẹ́ etí rẹ sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "gbà mí kíákíá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "jẹ́ àpáta ààbò mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "jẹ́ odi alágbára láti gbà mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ pàápàá ni àpáta àti ààbò mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:3"
      },
      "items": [
        {
          "text": "nítorí orúkọ rẹ, máa ṣe olùtọ́ mi, kí o sì ṣe amọ̀nà mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yọ mí jáde kúrò nínú àwọ̀n tí wọ́n dẹ pamọ́ fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:4"
      },
      "items": [
        {
          "text": "nítorí ìwọ ni ìsádi mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọwọ́ rẹ ni mo fi ẹ̀mí mi lé;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:5"
      },
      "items": [
        {
          "text": "ìwọ ni o ti rà mí padà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.5",
                "verseOrgIds": [
                  "PSA.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti kórìíra àwọn ẹni tí ń fiyèsí òrìṣà tí kò níye lórí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n èmi gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.6",
                "verseOrgIds": [
                  "PSA.31.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò yọ̀, inú mi yóò dùn nínú ìfẹ́ ńlá rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "nítorí ìwọ ti rí ìbìnújẹ́ mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "ìwọ ti mọ̀ ọkàn mi nínú ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú, ìwọ kò sì fà mi lé àwọn ọ̀tá lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:8"
      },
      "items": [
        {
          "text": "ìwọ ti fi ẹsẹ̀ mi lé ibi ààyè ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣàánú fún mi, ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.9",
                "verseOrgIds": [
                  "PSA.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí mo wà nínú ìpọ́njú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "ojú mi fi ìbìnújẹ́ sùn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "ọkàn àti ara mi pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi fi ìbànújẹ́ lo ọjọ́ mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "àti àwọn ọdún mi pẹ̀lú ìmí ẹ̀dùn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "agbára mi ti kùnà nítorí òsì mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "egungun mi sì ti rún dànù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi di ẹni ẹ̀gàn láàrín àwọn ọ̀tá mi gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "pẹ̀lúpẹ̀lú láàrín àwọn aládùúgbò mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "mo sì di ẹ̀rù fún àwọn ojúlùmọ̀ mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "àwọn tí ó rí mi ní òde ń yẹra fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti di ẹni ìgbàgbé kúrò ní ọkàn gẹ́gẹ́ bí ẹni tí ó ti kú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
