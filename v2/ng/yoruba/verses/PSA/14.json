        "sid": "PSA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣiwèrè wí nínú ọkàn rẹ̀ pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "\"Ko sí Ọlọ́run.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "Wọ́n díbàjẹ́, iṣẹ́ wọn sì burú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "kò sí ẹnìkan tí yóò ṣe rere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.14.2",
                "verseOrgIds": [
                  "PSA.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bojú wolẹ̀ láti ọ̀run wá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "lórí àwọn ọmọ ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "bóyá ó le rí ẹni tí òye yé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "ẹnikẹ́ni tó ń wá Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wọn sì ti yípadà, gbogbo wọn sì ti díbàjẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "kò sì ṣí ẹni tí ó ń ṣe rere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "kò sí ẹnìkan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ olùṣe búburú kò ha ní ìmọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 14:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "Àwọn tí ó ń pa ènìyàn mi jẹ bí ẹní jẹun;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "wọn kò sì ké pe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.14.4",
                "verseOrgIds": [
                  "PSA.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wà níbẹ̀, tí a bò mọ́lẹ̀ pẹ̀lú ẹ̀rù,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:5"
      },
      "items": [
        {
          "text": "nítorí Ọlọ́run wà ní àwùjọ àwọn olódodo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin olùṣe búburú da èrò àwọn tálákà rú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.14.6",
                "verseOrgIds": [
                  "PSA.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ààbò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbàlà àwọn Israẹli yóò ti Sioni wá!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.14.7",
                "verseOrgIds": [
                  "PSA.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bá mú ìkólọ àwọn ènìyàn rẹ̀ padà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "jẹ́ kí Jakọbu kí ó yọ̀, kí inú Israẹli kí ó dùn!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    }
  ],
