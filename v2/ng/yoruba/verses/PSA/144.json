      },
      "items": [
        {
          "text": "144",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 144",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 144:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyìn sí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.1",
                "verseOrgIds": [
                  "PSA.144.1"
                ]
              }
            }
          ]
        },
        {
          "text": "àpáta mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "ẹni tí ó kọ́ ọwọ́ mi fún ogun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "àti ìka mi fún ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 144:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni Ọlọ́run ìfẹ́ mi àti odi alágbára mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "ibi gíga mi àti olùgbàlà mi, asà mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "ẹni tí èmi gbẹ́kẹ̀lé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "ẹni tí ó tẹrí àwọn ènìyàn ba lábẹ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 144:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.3",
                "verseOrgIds": [
                  "PSA.144.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ni ènìyàn tí ìwọ fi ń ṣàníyàn fún un,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:3"
      },
      "items": [
        {
          "text": "tàbí ọmọ ènìyàn tí ìwọ fi ń ronú nípa rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 144:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn rí bí èmi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:4"
      },
      "items": [
        {
          "text": "ọjọ́ rẹ̀ rí bí òjìji tí ń kọjá lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 144:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tẹ ọ̀run rẹ ba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.5",
                "verseOrgIds": [
                  "PSA.144.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí o sì sọ̀kalẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:5"
      },
      "items": [
        {
          "text": "tọ́ àwọn òkè ńlá wọn yóò sí rú èéfín.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 144:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rán mọ̀nàmọ́ná kí ó sì fọ́n àwọn ọ̀tá ká;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:6"
      },
      "items": [
        {
          "text": "ta ọfà rẹ kí ó sì dà wọ́n rú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 144:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ọwọ́ rẹ sílẹ̀ láti ibi gíga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "gbà mí kí o sì yọ mí nínú ewu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "kúrò nínú omi ńlá:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "kúrò lọ́wọ́ àwọn ọmọ àjèjì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 144:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnu ẹni tí ó kún fún èké",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:8"
      },
      "items": [
        {
          "text": "ẹni tí ọwọ́ ọ̀tún rẹ̀ jẹ́ ìrẹ́jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 144:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò kọ orin tuntun sí ọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:9"
      },
      "items": [
        {
          "text": "Ọlọ́run; lára ohun èlò orin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:9"
      },
      "items": [
        {
          "text": "olókùn mẹ́wàá èmi yóò",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:9"
      },
      "items": [
        {
          "text": "kọ orin sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 144:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ó fi ìgbàlà fún àwọn ọba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "ẹni tí ó gba Dafidi ìránṣẹ́ rẹ̀ lọ́wọ́ idà ìpanilára.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 144:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "Lọ́wọ́ pípanirun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 144:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbà mí kí o sì yọ mí nínú ewu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "kúrò lọ́wọ́ àwọn ọmọ àjèjì",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "tí ẹnu wọn kún fún èké,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "tí ọwọ́ ọ̀tún wọn jẹ́ ọwọ́ ọ̀tún èké.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 144:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí àwọn ọmọkùnrin wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "kí ó dàbí igi gbígbìn tí ó dàgbà ni ìgbà èwe wọn,",
          "type": "text",
