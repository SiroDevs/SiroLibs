  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PSA 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Fún ohun èlò orin fífọn. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi etí sí ọ̀rọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.1",
                "verseOrgIds": [
                  "PSA.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:1"
      },
      "items": [
        {
          "text": "kíyèsi àròyé mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi etí sílẹ̀ sí igbe mi fún ìrànlọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "ọba mi àti Ọlọ́run mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "nítorí ìwọ ni mo gba àdúrà sí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òwúrọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.3",
                "verseOrgIds": [
                  "PSA.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ yóò gbọ́ ohùn mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "ní òwúrọ̀, èmi yóò gbé ẹ̀bẹ̀ mi sí iwájú rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "èmi yóò sì dúró ní ìrètí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ kì í ṣe Ọlọ́run tí ó ní inú dídùn sí búburú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:4"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ẹni ibi kò le è bá ọ gbé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn agbéraga kò le è dúró",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:5"
      },
      "items": [
        {
          "text": "níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:5"
      },
      "items": [
        {
          "text": "Ìwọ kórìíra gbogbo àwọn aṣebi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìwọ yóò pa àwọn tí ń ṣe èké run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "Apani àti ẹni ẹ̀tàn ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.6",
                "verseOrgIds": [
                  "PSA.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò kórìíra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi, nípa títóbi àánú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "èmi yóò wá sínú ilé rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "ní tọ̀wọ̀tọ̀wọ̀ ni èmi yóò tẹríba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "sí ìhà tẹmpili mímọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.8",
                "verseOrgIds": [
                  "PSA.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", nínú òdodo rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "nítorí àwọn ọ̀tá mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "mú ọ̀nà rẹ tọ́ níwájú mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ọ̀rọ̀ kan ní ẹnu wọn tí a lè gbàgbọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "ọkàn wọn kún fún ìparun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "Ọ̀nà ọ̀fun wọn ni isà òkú tí ó ṣí sílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "pẹ̀lú ahọ́n wọn ni wọ́n ń sọ ẹ̀tàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dá wọn lẹ́bi Ọlọ́run!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Jẹ́ kí rìkíṣí wọn jẹ́ ìṣubú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Lé wọn jáde nítorí ọ̀pọ̀lọpọ̀ ẹ̀ṣẹ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "nítorí wọ́n ti ṣọ̀tẹ̀ sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, jẹ́ kí gbogbo àwọn tí ó sádi ọ́ kí ó yọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "jẹ kí wọn máa kọrin fún ayọ̀ títí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
