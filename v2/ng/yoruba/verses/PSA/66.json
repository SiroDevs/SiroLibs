  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "66",
        "style": "c",
        "sid": "PSA 66"
      },
      "items": [
        {
          "text": "66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Orin. Saamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ hó ìhó ayọ̀ sí Ọlọ́run, ẹ̀yin ilẹ̀ gbogbo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kọrin ọlá orúkọ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:2"
      },
      "items": [
        {
          "text": "ẹ kọrin ìyìnsí i.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wí fún Ọlọ́run pé, \"Ìwọ ti ní ẹ̀rù tó nínú iṣẹ́ rẹ!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "Nípa ọ̀pọ̀ agbára rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "ni àwọn ọ̀tá rẹ yóò fi sìn ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ayé ń wólẹ̀ fún ọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "wọn ń kọrin ìyìn sí ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "wọ́n ń kọrin ìyìn sí orúkọ rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.4",
                "verseOrgIds": [
                  "PSA.66.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wá wo ohun tí Ọlọ́run ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:5"
      },
      "items": [
        {
          "text": "iṣẹ́ rẹ̀ ti ní ẹ̀rù tó sí àwọn ọmọ ènìyàn!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó yí òkun padà sí ilẹ̀ gbígbẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "wọ́n fi ẹsẹ̀ rin inú omi kọjá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "níbẹ̀ ni àwa yọ̀ nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń jẹ ọba títí láé nípa agbára rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "ojú rẹ̀ ń wo orílẹ̀-èdè",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "kí àwọn ọlọ̀tẹ̀ má ṣe gbé ara wọn ga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.7",
                "verseOrgIds": [
                  "PSA.66.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ yin Ọlọ́run wa, ẹ̀yin ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:8"
      },
      "items": [
        {
          "text": "jẹ́ kí a mú ni gbọ́ ohùn ìyìn rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti dá ààbò bo ẹ̀mí wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:9"
      },
      "items": [
        {
          "text": "kò sì jẹ́ kí ẹsẹ̀ wa kí ó yẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ, Ọlọ́run, dán wa wò;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:10"
      },
      "items": [
        {
          "text": "ìwọ dán wa bí a tí ń dán fàdákà wò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mú wa wá sínú ẹ̀wọ̀n",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:11"
      },
      "items": [
        {
          "text": "o sì di ẹrù lé ẹ̀yìn wa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mú àwọn ènìyàn gún wá ní orí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "àwa la iná àti omi kọjá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìwọ mú wa dé ibi ọ̀pọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó wá sí tẹmpili rẹ pẹ̀lú ọrẹ ẹbọ sísun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:13"
      },
      "items": [
        {
          "text": "kí n sì mú ẹ̀jẹ́ mi ṣẹ sí ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹ̀jẹ́ tí ètè mi jẹ́, tí ẹnu mi sì sọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:14"
      },
      "items": [
        {
          "text": "nígbà tí mo wà nínú ìṣòro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó rú ẹbọ sísun ọlọ́ràá sí ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:15"
      },
      "items": [
        {
          "text": "àti ẹbọ ọ̀rá àgbò;",
          "type": "text",
          "attrs": {
