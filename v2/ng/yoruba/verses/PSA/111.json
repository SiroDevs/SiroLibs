              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa yin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.1",
                "verseOrgIds": [
                  "PSA.111.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 111:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "Èmi yóò máa yin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.1",
                "verseOrgIds": [
                  "PSA.111.1"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú gbogbo ọkàn mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "ní àwùjọ àwọn olóòtítọ́, àti ní ìjọ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 111:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.2",
                "verseOrgIds": [
                  "PSA.111.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tóbi, àwọn tí ó ní inú dídùn, ń ṣe àṣàrò nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 111:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣẹ́ rẹ̀ ni ọláńlá àti ògo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:3"
      },
      "items": [
        {
          "text": "àti òdodo rẹ̀ dúró láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 111:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti ṣe iṣẹ́ ìyanu rẹ̀, láti máa rántí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.4",
                "verseOrgIds": [
                  "PSA.111.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ni olóore-ọ̀fẹ́ àti pé ó kún fún àánú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 111:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti fi oúnjẹ fún àwọn tí ó bẹ̀rù rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:5"
      },
      "items": [
        {
          "text": "òun ń rántí májẹ̀mú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 111:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ti fihan àwọn ènìyàn rẹ̀ agbára iṣẹ́ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:6"
      },
      "items": [
        {
          "text": "láti fún wọn ní ilẹ̀ ìlérí ní ìní.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 111:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iṣẹ́ ọwọ́ rẹ̀ jẹ́ òtítọ́ àti ìdájọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:7"
      },
      "items": [
        {
          "text": "gbogbo òfin rẹ̀ sì dájú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 111:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dúró láé àti láé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:8"
      },
      "items": [
        {
          "text": "ní òtítọ́ àti òdodo ni a ṣe wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 111:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rán ìràpadà sí àwọn ènìyàn rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "ó pàṣẹ májẹ̀mú rẹ̀ títí láé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "mímọ́ àti ọ̀wọ̀ ni orúkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 111:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.10",
                "verseOrgIds": [
                  "PSA.111.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ìpilẹ̀ṣẹ̀ ọgbọ́n:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "òye dáradára ni yóò máa ṣe òfin rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "ìyìn rẹ̀ dúró láé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    }
