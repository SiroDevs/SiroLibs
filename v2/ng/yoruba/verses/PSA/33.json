          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ yọ̀ nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.1",
                "verseOrgIds": [
                  "PSA.33.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ̀yin olódodo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:1"
      },
      "items": [
        {
          "text": "ìyìn si yẹ fún ẹni dídúró ṣinṣin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ yin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.2",
                "verseOrgIds": [
                  "PSA.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú dùùrù;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:2"
      },
      "items": [
        {
          "text": "ẹ máa fi ohun èlò olókùn mẹ́wàá kọrin sí i.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kọ orin tuntun sí i;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:3"
      },
      "items": [
        {
          "text": "ẹ máa fi ọgbọọgbọ́n lu ohun èlò orin sí i, pẹ̀lú ariwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.4",
                "verseOrgIds": [
                  "PSA.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dúró ṣinṣin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:4"
      },
      "items": [
        {
          "text": "gbogbo iṣẹ́ rẹ̀ ni à ń ṣe nínú òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fẹ́ òtítọ́ àti ìdájọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:5"
      },
      "items": [
        {
          "text": "ilé ayé kún fún ìdúró ṣinṣin àti àánú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.5",
                "verseOrgIds": [
                  "PSA.33.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípasẹ̀ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.6",
                "verseOrgIds": [
                  "PSA.33.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ni a ṣe dá àwọn ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:6"
      },
      "items": [
        {
          "text": "àti gbogbo àwọn ẹgbẹ́ ogun wọn nípa ìmísí ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó kó àwọn omi òkun jọ gẹ́gẹ́ bí èyí tí ó wà nínú ìgò;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:7"
      },
      "items": [
        {
          "text": "ó sì fi ibú ṣe ilé ìṣúra gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí gbogbo ayé kí ó bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.8",
                "verseOrgIds": [
                  "PSA.33.8"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:8"
      },
      "items": [
        {
          "text": "jẹ́ kí gbogbo àwọn olùgbé ayé kí ó wà nínú ìbẹ̀rù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ó sọ̀rọ̀, ó sì ti rí bẹ́ẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:9"
      },
      "items": [
        {
          "text": "ó pàṣẹ ó sì dúró ṣinṣin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.10",
                "verseOrgIds": [
                  "PSA.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti mú ìmọ̀ràn àwọn orílẹ̀-èdè wá sí asán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:10"
      },
      "items": [
        {
          "text": "ó sì mú àrékérekè àwọn ènìyàn di ṣíṣákì í.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbìmọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.11",
                "verseOrgIds": [
                  "PSA.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dúró títí ayérayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:11"
      },
      "items": [
        {
          "text": "àní ìrò inú rẹ̀ láti ìrandíran ni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbùkún ni fún orílẹ̀-èdè náà, Ọlọ́run ẹni tí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.12",
                "verseOrgIds": [
                  "PSA.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ tirẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:12"
      },
      "items": [
        {
          "text": "àti àwọn ènìyàn náà tí ó ti yàn ṣe ìní rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.13",
                "verseOrgIds": [
                  "PSA.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wò láti ọ̀run wá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
