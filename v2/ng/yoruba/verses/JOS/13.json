    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ogún tí Mose fi fún wọn nígbà tí ó wà ní pẹ̀tẹ́lẹ̀ Moabu ní ìhà kejì Jordani ní ìlà-oòrùn Jeriko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n fún ẹ̀yà Lefi, Mose kò fi ogún fún un;",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, ní ogún wọn, gẹ́gẹ́ bí ó ti ṣe ìlérí fún wọn.",
          "type": "text"
        }
      ]
    }
