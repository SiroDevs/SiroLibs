        "vid": "PRO 14:31"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹnikẹ́ni tí ó ṣoore fún aláìní bu ọlá fún Ọlọ́run.",
          "type": "text",
          "attrs": {
