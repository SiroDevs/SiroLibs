  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "PRO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́gbọ́n obìnrin kọ́ ilé e rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:1"
      },
      "items": [
        {
          "text": "ṣùgbọ́n aṣiwèrè obìnrin fi ọwọ́ ara rẹ̀ fà á lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ń rìn déédé bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.2",
                "verseOrgIds": [
                  "PRO.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:2"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹni tí ọ̀nà rẹ̀ kò tọ́ kẹ́gàn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.2",
                "verseOrgIds": [
                  "PRO.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ aṣiwèrè a máa ṣokùnfà pàṣán fún ẹ̀yìn rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:3"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ọ̀rọ̀ ètè ọlọ́gbọ́n a máa dáàbò bò ó.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbi tí kò sí ẹran, ibùjẹ ẹran a máa mọ́ tónítóní,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n, nípa agbára akọ màlúù ni ọ̀pọ̀ ìkórè ti ń wá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹlẹ́rìí tí ń ṣọ òtítọ́ kì í tan ni",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹlẹ́rìí èké a máa tú irọ́ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹlẹ́gàn ń wá ọgbọ́n kò sì rí rárá,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìmọ̀ máa ń wà fún olóye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe súnmọ́ aláìgbọ́n ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:7"
      },
      "items": [
        {
          "text": "nítorí ìwọ kì yóò rí ìmọ̀ ní ètè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbọ́n olóye ni láti ronú jinlẹ̀ nípa ọ̀nà wọn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:8"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìwà òmùgọ̀ aṣiwèrè ni ìtànjẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aláìgbọ́n ń dẹ́ṣẹ̀ nígbà tí ó yẹ kí ó ṣe àtúnṣe ẹ̀ṣẹ̀ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:9"
      },
      "items": [
        {
          "text": "ṣùgbọ́n láàrín àwọn olódodo ni a ti rí ojúrere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn kọ̀ọ̀kan ló mọ ẹ̀dùn ọkàn tirẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:10"
      },
      "items": [
        {
          "text": "kò sì ṣí ẹnìkan tó le è bá ọkàn mìíràn pín ayọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó pa ilé ènìyàn búburú run,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:11"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àgọ́ olódodo yóò máa gbèrú sí i.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀nà kan wà tí ó dàbí i pé ó dára lójú ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ní ìgbẹ̀yìn gbẹ́yín, a máa jásí ikú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kódà nígbà tí a ń rẹ́rìn-ín, ọkàn le è máa kérora;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:13"
      },
      "items": [
        {
          "text": "ayọ̀ sì le è yọrí sí ìbànújẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó san án lẹ́kùnrẹ́rẹ́ fún aláìgbàgbọ́ gẹ́gẹ́ bí ọ̀nà rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:14"
      },
      "items": [
        {
          "text": "ènìyàn rere yóò sì gba èrè fún tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òpè ènìyàn gba ohun gbogbo gbọ́",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:15"
      },
      "items": [
        {
