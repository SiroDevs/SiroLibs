  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PRO 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹlẹ́yà ni ọtí wáìnì, aláriwo sì ní ọtí líle;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:1"
      },
      "items": [
        {
          "text": "ẹnikẹ́ni tí ó bá fi tànjẹ kò gbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbẹ̀rù ọba dàbí kíké e kìnnìún;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:2"
      },
      "items": [
        {
          "text": "ẹnikẹ́ni tí ó bá mú un bínú ba ayé ara rẹ̀ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyì ni ó jẹ́ fún ènìyàn láti sá fún ìjà,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:3"
      },
      "items": [
        {
          "text": "ṣùgbọ́n gbogbo aláìgbọ́n a máa tètè wá ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀lẹ kì í ṣiṣẹ́ oko nígbà tí ó yẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:4"
      },
      "items": [
        {
          "text": "nítorí náà ní àsìkò ìkórè, yóò wá kò sì ní rì nǹkan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ète ọkàn ènìyàn dàbí omi jíjìn;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ènìyàn olóye á wá wọn jáde.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀lọpọ̀ ènìyàn ni wọ́n máa ń sọ pe àwọn ní ìfẹ́ àìṣẹ̀tàn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n kò rọrùn láti rí ènìyàn olóòtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódodo ènìyàn a máa gbé ìgbé ayé àìlábùkù",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:7"
      },
      "items": [
        {
          "text": "ìbùkún ni fún àwọn ọmọ rẹ̀ lẹ́yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọba bá jókòó sórí ìtẹ́ rẹ̀ láti ṣe ìdájọ́",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:8"
      },
      "items": [
        {
          "text": "yóò fẹ́ gbogbo ibi dànù pẹ̀lú ojú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó le è wí pé, \"Mo ti ṣe ọkàn mi ní mímọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:9"
      },
      "items": [
        {
          "text": "mo mọ́, n kò sì lẹ́ṣẹ̀\"?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ̀n èké àti òsùwọ̀n ìrẹ́jẹ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.20.10",
                "verseOrgIds": [
                  "PRO.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kórìíra méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kódà a mọ ọmọdé nípa iṣẹ́ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:11"
      },
      "items": [
        {
          "text": "nípa pe bóyá iṣẹ́ rẹ mọ́ tàbí pé ó tọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etí tí ó ń gbọ́ àti ojú tí ó ń ríran",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.20.12",
                "verseOrgIds": [
                  "PRO.20.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó dá méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe fẹ́ràn oorun, àìṣe bẹ́ẹ̀ ìwọ yóò di tálákà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:13"
      },
      "items": [
        {
          "text": "Ma ṣe sùn ìwọ yóò sì ní oúnjẹ láti tún fi tọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kò dára, kò dára!\" ní ẹni tó ra ọjà máa ń wí;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:14"
      },
      "items": [
        {
          "text": "nígbà tí ó bá kúrò níbẹ̀ tán,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:14"
      },
      "items": [
        {
          "text": "yóò máa yangàn bí òun tí ṣe rí rà sí.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wúrà wà, iyùn sì wà rẹpẹtẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:15"
      },
      "items": [
        {
          "text": "ṣùgbọ́n, ahọ́n tí ń sọ ìmọ̀ gan an ni ọ̀ṣọ́ iyebíye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
