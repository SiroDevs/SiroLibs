  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PRO 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó fẹ́ ẹ̀kọ́ fẹ́ ìmọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:1"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹnikẹ́ni tí ó kórìíra ìbáwí jẹ́ aláìgbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn rere gba ojúrere lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.2",
                "verseOrgIds": [
                  "PRO.12.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:2"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ènìyàn ètè búburú ni yóò dá lẹ́bi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kò lè fi ẹsẹ̀ ènìyàn múlẹ̀ nípa ìwà búburú",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:3"
      },
      "items": [
        {
          "text": "ṣùgbọ́n a kò le è fa olódodo tu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya oníwà rere ni adé ọkọ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n aya adójútini dàbí inú egungun rẹ̀ jẹrà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èrò àwọn olódodo tọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìgbìmọ̀ ènìyàn búburú jẹ́ ẹ̀tàn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ ènìyàn búburú lúgọ de ẹ̀jẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ọ̀rọ̀ àwọn olódodo gbà wọ́n là.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ṣí àwọn ènìyàn búburú ní ìdí, wọn kò sì sí mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ilé olódodo dúró ṣinṣin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ń yín ènìyàn gẹ́gẹ́ bí ìwọ̀n ọgbọ́n rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:8"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn ènìyàn ọlọ́pọlọ wúruwùru ni a kẹ́gàn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sàn kí a má jẹ́ ènìyàn pàtàkì kí a sì ní ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:9"
      },
      "items": [
        {
          "text": "ju kí a díbọ́n pé a jẹ́ ẹni pàtàkì láìní oúnjẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódodo ènìyàn ń ṣe aájò ohun tí àwọn ohun ọ̀sìn rẹ̀ nílò,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:10"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìyọ́nú àwọn ènìyàn búburú, ìkà ni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó bá dá oko yóò ní ọ̀pọ̀lọpọ̀ oúnjẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:11"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹni tí ń lépa òjìji lásán làsàn kò gbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn búburú ń fẹ́ ìkógun àwọn ènìyàn ìkà",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n gbòǹgbò olódodo ń gbilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mú ènìyàn búburú nípasẹ̀ ọ̀rọ̀ ẹ̀ṣẹ̀ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:13"
      },
      "items": [
        {
          "text": "ṣùgbọ́n olódodo bọ́ kúrò lọ́wọ́ ìdààmú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti inú èso rẹ̀, ènìyàn kún fún onírúurú ohun rere",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:14"
      },
      "items": [
        {
          "text": "bí iṣẹ́ ọwọ́ rẹ̀ ti ń pín in lérè dájúdájú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀nà aláìgbọ́n dára lójú ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 12:15"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ọlọ́gbọ́n ènìyàn a máa gba ìmọ̀ràn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
