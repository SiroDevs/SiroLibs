    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀ Ìyè",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí tí ó wà láti àtètèkọ́ṣe, tí àwa ti gbọ́, tí àwa ti fi ojú wa rí, tí àwa sì ti tẹjúmọ́, tí ọwọ́ wa sì ti dì mú; èyí tí a kéde; ní ti ọ̀rọ̀ ìyè;",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyè náà sì ti farahàn, àwa sì ti rí i, àwa sì ń jẹ́rìí, àwa sì ń sọ ti ìyè àìnípẹ̀kun náà fún yín, tí ó ti ń bẹ lọ́dọ̀ Baba, tí ó sì farahàn fún wa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa ń sọ fún yín, èyí tí àwa ti rí, tí àwa sì ti gbọ́, kí ẹ̀yin pẹ̀lú kí ó lè ní ìdàpọ̀ pẹ̀lú wa. Nítòótọ́ ìdàpọ̀ wa sì ń bẹ pẹ̀lú Baba àti pẹ̀lú ọmọ rẹ̀, Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa sì kọ̀wé nǹkan wọ̀nyí sí yín, kí ayọ̀ yín kí ó lè di kíkún.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rírìn nínú ìmọ́lẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí sì ni iṣẹ́ tí àwa ti gbọ́ lẹ́nu rẹ̀, tí àwa sì ń jẹ́ fún yín pé, ìmọ́lẹ̀ ni Ọlọ́run; ní ọ̀dọ̀ rẹ̀ kò sì òkùnkùn rárá.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá wí pé àwa ní ìdàpọ̀ pẹ̀lú rẹ̀, tí àwa sì ń rìn nínú òkùnkùn, àwa ń ṣèké, àwa kò sì gbé nínú òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí àwa bá ń rìn nínú ìmọ́lẹ̀, gẹ́gẹ́ bí òun ti ń wà nínú ìmọ́lẹ̀, àwa ní ìdàpọ̀ pẹ̀lú ara wa, àti pé ẹ̀jẹ̀ Jesu Kristi, Ọmọ rẹ̀, wẹ̀ wá nù kúrò nínú ẹ̀ṣẹ̀ gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá wí pé àwa kò ní ẹ̀ṣẹ̀, àwa ń tan ara wa jẹ, òtítọ́ kan kò sì ṣí nínú wa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.8",
            "verseOrgIds": [
              "1JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá jẹ́wọ́ ẹ̀ṣẹ̀ wa, olóòtítọ́ àti olódodo ni òun láti dárí ẹ̀ṣẹ̀ wa jì wá, àti láti wẹ̀ wá nù kúrò nínú àìṣòdodo gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.9",
            "verseOrgIds": [
              "1JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá wí pé àwa kò dẹ́ṣẹ̀, àwa mú un ní èké, ọ̀rọ̀ rẹ̀ kò sì ṣí nínú wa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.10",
            "verseOrgIds": [
              "1JN.1.10"
            ]
          }
        }
      ]
    }
  ],
