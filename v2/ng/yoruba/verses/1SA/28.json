                "verseId": "1SA.28.17",
                "verseOrgIds": [
                  "1SA.28.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ṣe fún ara rẹ̀ gẹ́gẹ́ bí ó ti ti ipa ọwọ́ mi sọ:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.17",
                "verseOrgIds": [
                  "1SA.28.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sì yá ìjọba náà kúrò ní ọwọ́ rẹ̀, ó sì fi fún aládùúgbò rẹ́, àní Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìwọ kò gbọ́ ohùn",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.18",
                "verseOrgIds": [
                  "1SA.28.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ìwọ kò sì ṣe iṣẹ́ ìbínú rẹ̀ sí Amaleki nítorí náà ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.18",
                "verseOrgIds": [
                  "1SA.28.18"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ṣe nǹkan yìí sí ọ lónìí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
