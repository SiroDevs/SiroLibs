  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1SA 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulu tọ Abókùúsọ̀rọ̀ lọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àwọn ọjọ́ wọ̀nyí, àwọn Filistini sì kó àwọn ogun wọn jọ, láti bá Israẹli jà. Akiṣi sì wí fún Dafidi pé, \"Mọ̀ dájúdájú pé, ìwọ yóò bá mi jáde lọ sí ibi ìjà, ìwọ àti àwọn ọmọkùnrin rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún Akiṣi pé, \"Nítòótọ́ ìwọ ó sì mọ ohun tí ìránṣẹ́ rẹ lè ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:2"
      },
      "items": [
        {
          "text": "Akiṣi sì wí fún Dafidi pé, \"Nítorí náà ni èmi ó ṣe fi ìwọ ṣe olùṣọ́ orí mi ni gbogbo ọjọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulu àti Abókùúsọ̀rọ̀ Endori",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì ti kú, gbogbo Israẹli sì sọkún rẹ̀, wọ́n sì sin ín ní Rama ní ìlú rẹ̀. Saulu sì ti mú àwọn abókùúsọ̀rọ̀ ọkùnrin, àti àwọn abókùúsọ̀rọ̀ obìnrin kúrò ní ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Filistini sì kó ara wọn jọ, wọ́n wá, wọ́n sì dó sí Ṣunemu: Saulu sì kó gbogbo Israẹli jọ, wọ́n sì tẹ̀dó ní Gilboa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Saulu sì rí ogun àwọn Filistini náà òun sì bẹ̀rù, àyà rẹ̀ sì wárìrì gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Saulu sì béèrè lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.6",
                "verseOrgIds": [
                  "1SA.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.6",
                "verseOrgIds": [
                  "1SA.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kò dá a lóhùn nípa àlá, nípa Urimu tàbí nípa àwọn wòlíì.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì wí fún àwọn ìránṣẹ́ rẹ̀ pé, \"Ẹ bá mi wá obìnrin kan tí ó ní ẹ̀mí abókùúsọ̀rọ̀ èmi yóò sì tọ̀ ọ́ lọ, èmi yóò béèrè lọ́wọ́ rẹ̀!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:7"
      },
      "items": [
        {
          "text": "Àwọn ìránṣẹ́ rẹ̀ sì wí fún un pé, \"Wò ó, obìnrin kan wà ní Endori tí ó ní ẹ̀mí abókùúsọ̀rọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì pa ara dà, ó sì mú aṣọ mìíràn wọ̀, ó sì lọ, àwọn ọmọkùnrin méjì sì pẹ̀lú rẹ̀, wọ́n sì wá sí ọ̀dọ̀ obìnrin náà lóru: òun sì wí pé, \"Èmi bẹ̀ ọ́, fi ẹ̀mí abókùúsọ̀rọ̀ wo nǹkan fún mi, kí o sì mú ẹni tí èmí ó dárúkọ rẹ̀ fún ọ wá sókè fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà sì dá a lóhùn pé, \"Wò ó, ìwọ sá à mọ ohun tí Saulu ṣe, bí òun ti gé àwọn abókùúsọ̀rọ̀ obìnrin, àti àwọn abókùúsọ̀rọ̀ ọkùnrin kúrò ní ilẹ̀ náà; ǹjẹ́ èéha ṣe tí ìwọ dẹkùn fún ẹ̀mí mi, láti mú kí wọ́n pa mí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulu sì búra fún un nípa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.10",
                "verseOrgIds": [
                  "1SA.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Bí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.10",
                "verseOrgIds": [
                  "1SA.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ń bẹ láààyè, ìyà kan kì yóò jẹ́ ọ́ nítorí nǹkan yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà sì bi í pé, \"Ta ni ẹ̀mí ó mú wá sókè fún ọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:11"
      },
      "items": [
        {
          "text": "Òun sì wí pé, \"Mú Samuẹli gòkè wá fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí obìnrin náà sì rí Samuẹli, ó kígbe lóhùn rara: obìnrin náà sì bá Saulu sọ̀rọ̀ pè, \"Èéṣe tí ìwọ fi tàn mí jẹ? Nítorí pé Saulu ni ìwọ jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún un pé, \"Má ṣe bẹ̀rù; kín ni ìwọ rí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:13"
      },
      "items": [
        {
          "text": "Obìnrin náà sì wí fún Saulu pé, \"Èmi rí ọlọ́run kan tí ń ti ilẹ̀ wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì bi í pé, \"Báwo ni ó ti rí i sí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:14"
      },
      "items": [
        {
          "text": "Ó sì wí pé, \"Ọkùnrin arúgbó kan ni ó ń bọ; ó sì fi agbádá bora.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:14"
      },
      "items": [
        {
          "text": "Saulu sì mọ̀ pé, Samuẹli ni; ó sì tẹríba, ó sì wólẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì i wí fún Saulu pé, \"Èéṣe tí ìwọ fi ń yọ mí lẹ́nu láti mú mi wá sókè?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:15"
      },
      "items": [
        {
          "text": "Saulu sì dáhùn ó sì wí pé, \"Ìpọ́njú ńlá bá mi; nítorí tí àwọn Filistini ń bá mi jagun, Ọlọ́run sì kọ̀ mí sílẹ̀, kò sì dá mi lóhùn mọ́, nípa ọwọ́ àwọn wòlíì, tàbí nípa àlá; nítorí náà ni èmi ṣe pè ọ́, kí ìwọ lè fi ohun tí èmi yóò ṣe hàn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sì wí pé, \"Ó ti ṣe ń bi mí léèrè nígbà tí ó jẹ́ pé,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.16",
                "verseOrgIds": [
                  "1SA.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kọ̀ ọ́ sílẹ̀, o sì di ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
