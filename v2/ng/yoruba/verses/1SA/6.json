              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run kọlu díẹ̀ lára àwọn ọkùnrin Beti-Ṣemeṣi, ó pa àádọ́rin wọn, nítorí wọ́n ti wo inú àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.19",
                "verseOrgIds": [
                  "1SA.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". Àwọn ènìyàn ṣọ̀fọ̀ nítorí àjálù ńlá tí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.19",
                "verseOrgIds": [
                  "1SA.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "fi bá ọ̀pọ̀ wọn jà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin ará Beti-Ṣemeṣi béèrè pé, \"Ta ni ó le è dúró ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.20",
            "verseOrgIds": [
              "1SA.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.20",
                "verseOrgIds": [
                  "1SA.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mímọ́ yìí? Ọ̀dọ̀ ta ni àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.20",
            "verseOrgIds": [
              "1SA.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.20",
                "verseOrgIds": [
                  "1SA.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gbà gòkè lọ láti ibí yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.20",
            "verseOrgIds": [
              "1SA.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
