          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.16",
                "verseOrgIds": [
                  "JDG.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì gbé àwọn onídàájọ́ dìde tí ó gbà wọ́n sílẹ̀ lọ́wọ́ àwọn tí ń kó wọn lẹ́rú.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.16",
            "verseOrgIds": [
              "JDG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀ wọn kò fi etí sí ti àwọn onídàájọ́ wọn, ṣùgbọ́n wọ́n ṣe àgbèrè, wọ́n ń sin òrìṣà. Wọn kò dàbí àwọn baba wọn, kíákíá ni wọ́n yípadà kúrò lọ́nà tí àwọn baba wọ́n ń tọ̀, ọ̀nà ìgbọ́ràn sí àwọn òfin",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.17",
                "verseOrgIds": [
                  "JDG.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà kí ìgbà tí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.18",
                "verseOrgIds": [
                  "JDG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "bá gbé onídàájọ́ dìde fún wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.18",
                "verseOrgIds": [
                  "JDG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "máa ń wà pẹ̀lú onídàájọ́ náà, a sì gbà wọ́n kúrò ní ọwọ́ àwọn ọ̀tá wọn ní ìwọ̀n ìgbà tí onídàájọ́ náà bá wà láààyè nítorí àánú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.18",
                "verseOrgIds": [
                  "JDG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "wà ní ara wọn, nígbà tí wọ́n bá ké ìrora lábẹ́ àwọn tí ń tẹrí wọn ba, tí sì ń fi ìyà jẹ wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní kété tí onídàájọ́ bá ti kú, àwọn ènìyàn náà a sì tún padà sí ọ̀nà ìbàjẹ́ àní ju ti àwọn baba wọn lọ, wọn a tẹ̀lé òrìṣà, wọ́n ń sìn wọ́n, wọn a sì foríbalẹ̀ fún wọn, wọ́n kọ̀ láti yàgò kúrò ní ọ̀nà ibi wọn àti agídí ọkàn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.19",
            "verseOrgIds": [
              "JDG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
