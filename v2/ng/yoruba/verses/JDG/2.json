          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.20",
            "verseOrgIds": [
              "JDG.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.20",
                "verseOrgIds": [
                  "JDG.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì tún ru sí Israẹli a sì wí pé, \"Nítorí tí orílẹ̀-èdè yìí ti yẹ májẹ̀mú tí mo fi lélẹ̀ fún àwọn baba ńlá wọn, tí wọn kò sì fetí sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.20",
            "verseOrgIds": [
              "JDG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kì yóò lé ọ̀kankan nínú àwọn orílẹ̀-èdè tí Joṣua fi sílẹ̀ nígbà tí ó kú jáde.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.21",
            "verseOrgIds": [
              "JDG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n dípò bẹ́ẹ̀ èmi yóò lo àwọn orílẹ̀-èdè yìí láti fi dán Israẹli wò, láti mọ̀ bóyá wọ́n yóò pa ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.22",
                "verseOrgIds": [
                  "JDG.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́ àti pé bóyá wọn ó rìn nínú rẹ̀ bí àwọn baba ńlá wọn ti rìn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.23",
            "verseOrgIds": [
              "JDG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.23",
                "verseOrgIds": [
                  "JDG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "fi àwọn orílẹ̀-èdè náà sílẹ̀ ní ilẹ̀ náà kò sì lé wọn jáde, tàbí kí ó jẹ́ kí àwọn Israẹli pa wọ́n run, bẹ́ẹ̀ kò sì fi wọ́n lé Joṣua lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.23",
            "verseOrgIds": [
              "JDG.2.23"
            ]
          }
        }
      ]
