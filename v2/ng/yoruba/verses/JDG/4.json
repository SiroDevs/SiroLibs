          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Debora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ikú Ehudu, àwọn ènìyàn Israẹli sì tún ṣẹ̀, wọ́n ṣe ohun tí ó burú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.1",
            "verseOrgIds": [
              "JDG.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.1",
                "verseOrgIds": [
                  "JDG.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.1",
            "verseOrgIds": [
              "JDG.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.2",
            "verseOrgIds": [
              "JDG.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.2",
                "verseOrgIds": [
                  "JDG.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ kí Jabini, ọba àwọn Kenaani, ẹni tí ó jẹ ọba ní Hasori, ṣẹ́gun wọn. Orúkọ olórí ogun rẹ̀ ni Sisera ẹni tí ń gbé Haroseti-Hagoyimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.2",
            "verseOrgIds": [
              "JDG.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ó ní ẹ̀ẹ́dẹ́gbẹ̀rún (900) kẹ̀kẹ́ ogun irin, ó sì ń pọ́n Israẹli lójú gidigidi fún ogún ọdún, Israẹli ké pe",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.3",
            "verseOrgIds": [
              "JDG.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.3",
                "verseOrgIds": [
                  "JDG.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ìrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.3",
            "verseOrgIds": [
              "JDG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debora, wòlíì obìnrin, aya Lapidoti ni olórí àti aṣíwájú àwọn ará Israẹli ní àsìkò náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.4",
            "verseOrgIds": [
              "JDG.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun a máa jókòó ṣe ìdájọ́ ní abẹ́ igi ọ̀pẹ tí a sọ orúkọ rẹ̀ ní ọ̀pẹ Debora láàrín Rama àti Beteli ní ilẹ̀ òkè Efraimu, àwọn ará Israẹli a sì máa wá sí ọ̀dọ̀ rẹ̀ láti yanjú èdè-àìyedè tí wọ́n bá ní sí ara wọn, tàbí láti gbọ́ ohùn",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.5",
            "verseOrgIds": [
              "JDG.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.5",
                "verseOrgIds": [
                  "JDG.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.5",
            "verseOrgIds": [
              "JDG.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kan, ó ránṣẹ́ pe Baraki ọmọ Abinoamu, ẹni tí ń gbé ní Kedeṣi ní ilẹ̀ Naftali, ó sì wí fún un pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.6",
                "verseOrgIds": [
                  "JDG.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli pa á ní àṣẹ fún un pé, 'Kí ó kó ẹgbẹ̀rún mẹ́wàá (10,000) àwọn akọni ọkùnrin jọ láti ẹ̀yà Naftali àti ẹ̀yà Sebuluni bí ẹgbẹ́ ogun, kí o sì síwájú wọn lọ sí òkè Tabori.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fa Sisera olórí ogun Jabini, pẹ̀lú kẹ̀kẹ́ ogun rẹ àti àwọn ogun rẹ, sí odò Kiṣoni èmi yóò sì fi lé ọ lọ́wọ́ ìwọ yóò sì ṣẹ́gun wọn níbẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.7",
            "verseOrgIds": [
              "JDG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki sì dá a lóhùn pé, \"Èmi yóò lọ tí ìwọ ó bá bá mi lọ, ṣùgbọ́n tí ìwọ kì yóò bá bá mi lọ, èmi kì yóò lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.8",
            "verseOrgIds": [
              "JDG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debora dá a lóhùn pé, \"ó dára, èmi yóò bá ọ lọ. Ṣùgbọ́n ọlá ìṣẹ́gun tí o ń lọ yìí kò ní jẹ́ tìrẹ, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.9",
            "verseOrgIds": [
              "JDG.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.9",
                "verseOrgIds": [
                  "JDG.4.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi Sisera lé obìnrin lọ́wọ́,\" báyìí Debora bá Baraki lọ sí Kedeṣi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.9",
            "verseOrgIds": [
              "JDG.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Baraki pe ẹ̀yà Sebuluni àti ẹ̀yà Naftali sí Kedeṣi ẹgbẹ̀rún mẹ́wàá (10,000) akíkanjú ọkùnrin ogun tẹ̀lé e, Debora pẹ̀lú bá wọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.10",
            "verseOrgIds": [
              "JDG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ Heberi ọmọ Keni, ti ya ara rẹ́ kúrò lọ́dọ̀ àwọn ọmọ Keni, àní àwọn ọmọ Hobabu, àna Mose, ó sì pa àgọ́ rẹ̀ títí dé ibi igi óákù Saananimu, tí ó wà ni agbègbè Kedeṣi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.11",
            "verseOrgIds": [
              "JDG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a sọ fún Sisera pé Baraki ọmọ Abinoamu ti kó ogun jọ sí òkè Tabori,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.12",
            "verseOrgIds": [
              "JDG.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisera kó gbogbo kẹ̀kẹ́ ogun irin rẹ̀ tí ṣe ẹ̀ẹ́dẹ́gbẹ̀rún (900) àti gbogbo àwọn ọmọ-ogun tí ó wà pẹ̀lú rẹ̀, láti Haroseti tí àwọn orílẹ̀-èdè wá sí odò Kiṣoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.13",
            "verseOrgIds": [
              "JDG.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debora sì wí fún Baraki pé, \"Lọ! Lónìí ni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.14",
            "verseOrgIds": [
              "JDG.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.14",
                "verseOrgIds": [
                  "JDG.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "fi Sisera lé ọ lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.14",
            "verseOrgIds": [
              "JDG.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.14",
                "verseOrgIds": [
                  "JDG.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ti lọ síwájú rẹ.\" Baraki sì síwájú, àwọn ọmọ-ogun rẹ̀ ẹgbẹ̀rún mẹ́wàá (10,000) sì tẹ̀lé e lẹ́yìn, wọ́n sì kọjá sí òkè Tabori.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.14",
            "verseOrgIds": [
              "JDG.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.15",
                "verseOrgIds": [
                  "JDG.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sì mú ìdàrúdàpọ̀ wá sí àárín ogun Sisera,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.15",
            "verseOrgIds": [
              "JDG.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.15",
                "verseOrgIds": [
                  "JDG.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi ojú idà ṣẹ́gun Sisera àti àwọn oníkẹ̀kẹ́ ogun àti ọmọ-ogun orí ilẹ̀ ní iwájú Baraki. Sisera sì sọ̀kalẹ̀ lórí kẹ̀kẹ́-ẹṣin rẹ̀ ó sì fi ẹsẹ̀ sálọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.15",
            "verseOrgIds": [
              "JDG.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki àti àwọn ogun rẹ̀ sì lé àwọn ọ̀tá náà, àwọn ọmọ-ogun orílẹ̀ àti àwọn kẹ̀kẹ́ ogun wọn títí dé Haroseti ti àwọn orílẹ̀-èdè, gbogbo ogun Sisera sì ti ojú idà ṣubú, kò sí ọ̀kan tí ó lè sálà tàbí tí ó wà láààyè.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.16",
            "verseOrgIds": [
              "JDG.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Sisera ti fi ẹsẹ̀ sálọ sí àgọ́ Jaeli aya Heberi ẹ̀yà Keni: nítorí ìbá dá ọ̀rẹ́ àlàáfíà wà láàrín Jabini ọba Hasori àti ìdílé Heberi ti ẹ̀yà Keni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.17",
            "verseOrgIds": [
              "JDG.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaeli sì jáde síta láti pàdé Sisera, ó sì wí fún un pé, \"Wọlé sínú àgọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.18",
            "verseOrgIds": [
              "JDG.4.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.4.18",
                "verseOrgIds": [
                  "JDG.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "mi, wọlé wá má ṣe bẹ̀rù nítorí pé ààbò ń bẹ fún ọ.\" Ó sì yà sínú àgọ́ rẹ̀, ó sì fi aṣọ bò ó.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.18",
            "verseOrgIds": [
              "JDG.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisera wí pé, \"Òrùngbẹ ń gbẹ́ mí, jọ̀wọ́ fún mi ní omi mu.\" Ó sì ṣí awọ wàrà kan, ó sì fún un mu ó sì tún daṣọ bò ó padà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.19",
            "verseOrgIds": [
              "JDG.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisera sọ fún Jaeli pé, \"Kí ó dúró ní ẹnu-ọ̀nà àgọ́, àti pé bí ẹnikẹ́ni bá béèrè bóyá òun wà níbẹ̀ kí ó sọ pé, 'Kò sí ẹnìkankan ní ibẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.20",
            "verseOrgIds": [
              "JDG.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jaeli ìyàwó Heberi mú ìṣó àgọ́ tí ó mú àti òòlù ní ọwọ́ rẹ̀, ó sì yọ́ wọ inú ibi tí ó sùn, nígbà tí ó ti sùn fọnfọn, nígbà náà ni ó kan ìṣó náà mọ́ òkè ìpéǹpéjú rẹ̀, ó sì wọlé ṣinṣin, ó sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.21",
            "verseOrgIds": [
              "JDG.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Baraki dé bí ó ti ń lépa Sisera, Jaeli láti pàdé rẹ̀, wá, èmi yóò fi ẹni tí ìwọ ń wá hàn ọ́, báyìí ni ó tẹ̀lé e wọ inú àgọ́ lọ, kíyèsi Sisera dùbúlẹ̀ síbẹ̀ pẹ̀lú ìṣó àgọ́ ní agbárí rẹ̀ tí a ti kàn mọ́lẹ̀ ṣinṣin tí ó sì ti kú.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.22",
            "verseOrgIds": [
              "JDG.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni Ọlọ́run ṣẹ́gun Jabini ọba àwọn ará Kenaani ní iwájú àwọn ẹ̀yà Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
            "verseOrgIds": [
              "JDG.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọwọ́ àwọn ọmọ Israẹli sì le, ó sì ń lágbára síwájú àti síwájú sí i lára Jabini ọba Kenaani, títí wọ́n fi run òun àti àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.24",
            "verseOrgIds": [
              "JDG.4.24"
            ]
          }
        }
      ]
    }
