    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "\"Ní ìsinsin yìí ni a ó gbé mi ga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "ní ìsinsin yìí ni a ó gbé mi sókè.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ lóyún ìyàngbò,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:11"
      },
      "items": [
        {
          "text": "o sì bí koríko;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:11"
      },
      "items": [
        {
          "text": "èémí yín bí iná tí yóò jẹ yín run.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó jó àwọn ènìyàn run bí eérú;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:12"
      },
      "items": [
        {
          "text": "bí igbó ẹ̀gún tí a gé la ó dáná sí wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ tí ó wà lọ́nà jíjìn, gbọ́ ohun tí mo ti ṣe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.13",
            "verseOrgIds": [
              "ISA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:13"
      },
      "items": [
        {
          "text": "ìwọ tí ò ń bẹ nítòsí, jẹ́rìí agbára mi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.13",
            "verseOrgIds": [
              "ISA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀rù ba àwọn ẹlẹ́ṣẹ̀ ní Sioni;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:14"
      },
      "items": [
        {
          "text": "ìwárìrì bá àwọn tí kò gba Ọlọ́run gbọ́:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:14"
      },
      "items": [
        {
          "text": "\"Ta ni nínú wa lólè gbé pẹ̀lú iná ajónirun?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:14"
      },
      "items": [
        {
          "text": "Ta ni nínú wa lólè gbé pẹ̀lú iná àìnípẹ̀kun?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ń rìn lódodo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "tí ó ń sọ ohun tí ó tọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "tí ó kọ èrè tí ó ti ibi ìlọ́nilọ́wọ́gbà wá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "tí ó sì pa ọwọ́ rẹ̀ mọ́ kúrò nínú gbígba àbẹ̀tẹ́lẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "tí ó di etí rẹ̀ sí ọ̀tẹ̀ láti pànìyàn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "tí ó sì di ojú rẹ̀ sí à ti pète ibi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun náà yóò gbé ní ibi gíga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:16"
      },
      "items": [
        {
          "text": "ibi ààbò rẹ̀ yóò jẹ́ òkè ńlá olódi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:16"
      },
      "items": [
        {
          "text": "A ó mú oúnjẹ fún un,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:16"
      },
      "items": [
        {
          "text": "omi rẹ̀ yóò sì dájú.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú rẹ yóò rí ọba nínú ẹwà rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.17",
            "verseOrgIds": [
              "ISA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:17"
      },
      "items": [
        {
          "text": "yóò sì rí ilẹ̀ kan tí ó tẹ́ lọ rẹrẹẹrẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.17",
            "verseOrgIds": [
              "ISA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú èrò rẹ ìwọ yóò rántí ẹ̀rù rẹ àtẹ̀yìnwá:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "\"Níbo ni ọ̀gá àgbà náà wà?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "Níbo ni ẹni tí ń gba owó òde wà?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "Níbo ni òṣìṣẹ́ ti ó ń mójútó ilé ìṣọ́ wà?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kì yóò rí àwọn agbéraga ènìyàn mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.19",
            "verseOrgIds": [
              "ISA.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:19"
      },
      "items": [
        {
          "text": "àwọn ènìyàn tí èdè wọn fi ara sin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.19",
            "verseOrgIds": [
              "ISA.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:19"
      },
      "items": [
        {
          "text": "pẹ̀lú ahọ́n tí ó ṣàjèjì tí kò sì yé ni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.19",
            "verseOrgIds": [
              "ISA.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbójú sókè sí Sioni, ìlú àjọ̀dún wa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.20",
            "verseOrgIds": [
              "ISA.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:20"
      },
      "items": [
        {
          "text": "ojú rẹ yóò rí Jerusalẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.20",
            "verseOrgIds": [
              "ISA.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:20"
      },
      "items": [
        {
          "text": "ibùgbé àlàáfíà n nì, àgọ́ tí a kò ní yí padà;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.20",
            "verseOrgIds": [
              "ISA.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:20"
      },
      "items": [
        {
          "text": "àwọn òpó rẹ̀ ni a kì yóò fàtu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.20",
            "verseOrgIds": [
              "ISA.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:20"
      },
      "items": [
        {
          "text": "tàbí èyíkéyìí nínú okùn rẹ̀ kí já.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.20",
            "verseOrgIds": [
              "ISA.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.21",
            "verseOrgIds": [
              "ISA.33.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.33.21",
                "verseOrgIds": [
                  "ISA.33.21"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ti jẹ́ alágbára kan fún wa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.21",
            "verseOrgIds": [
              "ISA.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:21"
      },
      "items": [
        {
          "text": "Yóò sì dàbí ibi àwọn odò ńlá ńlá àti odò kéékèèké.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.21",
            "verseOrgIds": [
              "ISA.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:21"
      },
      "items": [
        {
          "text": "Kì yóò sí ọkọ̀ ojú omi pẹ̀lú tí yóò kọjá lórí i wọn,",
