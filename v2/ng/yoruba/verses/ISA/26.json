      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orin ìyìn kan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni a ó kọ orin yìí ní ilẹ̀ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Àwa ní ìlú alágbára kan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Ọlọ́run fi ìgbàlà ṣe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "ògiri àti ààbò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣí àwọn ìlẹ̀kùn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "kí àwọn olódodo orílẹ̀-èdè kí ó lè wọlé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "orílẹ̀-èdè tí ó pa ìgbàgbọ́ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò pa á mọ́ ní àlàáfíà pípé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "ọkàn ẹni tí ó dúró ṣinṣin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "nítorí ó gbẹ́kẹ̀lé ọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.4",
                "verseOrgIds": [
                  "ISA.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "títí láé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:4"
      },
      "items": [
        {
          "text": "nítorí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.4",
                "verseOrgIds": [
                  "ISA.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.4",
                "verseOrgIds": [
                  "ISA.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ni àpáta ayérayé náà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sọ àwọn tí ó ń gbé ní òkè di onírẹ̀lẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "ó rẹ ìlú agbéraga náà nílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "ó sọ ọ́ di ilẹ̀ pẹrẹsẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "ó sì sọ ọ́ sílẹ̀ nínú erùpẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹsẹ̀ tẹ̀ ẹ́ mọ́lẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "ẹsẹ̀ aninilára n nì,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "ipasẹ̀ àwọn òtòṣì.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipa ọ̀nà àwọn olódodo tẹ́jú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:7"
      },
      "items": [
        {
          "text": "ìwọ tó dúró ṣinṣin, ìwọ mú ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:7"
      },
      "items": [
        {
          "text": "àwọn olódodo ṣe geere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.8",
                "verseOrgIds": [
                  "ISA.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", rírìn ní ọ̀nà òfin rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "àwa dúró dè ọ́;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "orúkọ rẹ àti òkìkí rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "àwọn ni ohun tí ọkàn wa ń fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn mi ń pòùngbẹẹ̀ rẹ ní ọ̀gànjọ́ òru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "ní òwúrọ̀ ni ẹ̀mí mi ń ṣàfẹ́rí rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "Nígbà tí ìdájọ́ rẹ bá sọ̀kalẹ̀ sórí ayé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "àwọn ènìyàn yóò kọ́ ìṣòdodo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé a fi oore-ọ̀fẹ́ hàn sí àwọn ìkà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "wọn kò kọ́ láti sọ òdodo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "kódà ní ilẹ̀ àwọn tí ó dúró ṣinṣin wọ́n",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "tẹ̀síwájú láti máa ṣe ibi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "wọn kò sì ka ọláńlá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
