          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi, àní Èmi ló ti sọ̀rọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
