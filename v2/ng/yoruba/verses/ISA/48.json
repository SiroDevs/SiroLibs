      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni, mo ti pè é.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "Èmi yóò mú un wá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "òun yóò sì ṣe àṣeyọrí nínú ìrìnàjò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ súnmọ́ ọ̀dọ̀ mi kí ẹ sì dẹtí sí èyí:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "\"Láti ìgbà ìkéde àkọ́kọ́ èmi kò sọ̀rọ̀ ní ìkọ̀kọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "ní àsìkò tí ó sì ṣẹlẹ̀, Èmi wà níbẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "Àti ní àkókò yìí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.16",
                "verseOrgIds": [
                  "ISA.48.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè ni ó ti rán mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "pẹ̀lú ẹ̀mí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.17",
                "verseOrgIds": [
                  "ISA.48.17"
                ]
              }
            }
          ]
        },
        {
          "text": "wí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "Olùdáǹdè rẹ, Ẹni Mímọ́ Israẹli:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "\"Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.17",
                "verseOrgIds": [
                  "ISA.48.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "tí ó kọ́ ọ ní ohun tí ó dára fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "tí ó tọ́ ọ ṣọ́nà tí ó yẹ kí o máa rìn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣe pé ìwọ bá ti tẹ́tí sílẹ̀ sí àṣẹ mi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:18"
      },
      "items": [
        {
          "text": "àlàáfíà rẹ kì bá ti dàbí ì ti odò,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:18"
      },
      "items": [
        {
          "text": "àti òdodo rẹ bí ìgbì Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ rẹ ìbá ti dàbí iyanrìn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:19"
      },
      "items": [
        {
          "text": "àwọn ọmọ yín bí i hóró ọkà tí a kò lè kà tán;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
