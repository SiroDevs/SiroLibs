          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo yẹtí, ẹ̀gbà ọwọ́ àti ìbòjú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
