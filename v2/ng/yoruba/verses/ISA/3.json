          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo gèlè, ẹ̀gbà ọrùn, ẹsẹ̀ àti àyà, àwọn ìgò tùràrí àti òògùn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
