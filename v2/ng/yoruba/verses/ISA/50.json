      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Gbogbo wọn yóò gbó bí aṣọ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
