      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Ta ni ẹni náà tí yóò dá mi lẹ́bi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
