  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "53",
        "style": "c",
        "sid": "ISA 53"
      },
      "items": [
        {
          "text": "53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó ti gba ìròyìn in wa gbọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:1"
      },
      "items": [
        {
          "text": "àti ta ni a ti fi apá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.1",
                "verseOrgIds": [
                  "ISA.53.1"
                ]
              }
            }
          ]
        },
        {
          "text": "hàn fún?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun dàgbàsókè níwájú rẹ̀ gẹ́gẹ́ bí àṣẹ̀ṣẹ̀yọ irúgbìn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "àti gẹ́gẹ́ bí i gbòǹgbò tí ó jáde láti inú ìyàngbẹ ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "Òun kò ní ẹwà tàbí ògo láti fà wá sọ́dọ̀ ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "kò sí ohun kankan nínú àbùdá rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "tí ó fi yẹ kí a ṣàfẹ́rí i rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kẹ́gàn rẹ̀ àwọn ènìyàn sì kọ̀ ọ́ sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "ẹni ìbànújẹ́, tí ó sì mọ bí ìpọ́njú ti rí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí ẹnìkan tí àwọn ènìyàn ń fojú pamọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "a kẹ́gàn rẹ, a kò sì bu ọlá fún un rárá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòtítọ́ ó ti ru àìlera wa lọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "ó sì ti ru ìbànújẹ́ wa pẹ̀lú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "síbẹ̀ a kà á sí ẹni tí Ọlọ́run lù,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "tí ó lù, tí a sì pọ́n lójú.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n a sá a lọ́gbẹ́ nítorí àìṣedéédéé wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "a pa á lára nítorí àìṣòdodo wa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "ìjìyà tí ó mú àlàáfíà wá fún wa wà lórí i rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "àti nípa ọgbẹ́ rẹ̀ ni a fi mú wa láradá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo wa bí àgùntàn, ti ṣìnà lọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "ẹnìkọ̀ọ̀kan wa ti yà sí ọ̀nà ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.6",
                "verseOrgIds": [
                  "ISA.53.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ti gbé e ka orí ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "gbogbo àìṣedéédéé wa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 53:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A jẹ ẹ́ ní yà, a sì pọ́n ọn lójú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "síbẹ̀ kò ya ẹnu rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "a mú un wá gẹ́gẹ́ bí ọ̀dọ́-àgùntàn sọ́dọ̀ alápatà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "àti gẹ́gẹ́ bí àgùntàn tí ó dákẹ́ níwájú olùrẹ́run rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "síbẹ̀ kò ya ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 53:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ìpọ́nlójú àti ìdánilẹ́jọ́ ni a mú un jáde lọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "ta ni ó sì le sọ nípa ìrànlọ́wọ́ rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "Nítorí a ké e kúrò ní ilẹ̀ àwọn alààyè;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "nítorí àìṣedéédéé àwọn ènìyàn mi ni a ṣe lù ú.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 53:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A fún un ní ibojì pẹ̀lú àwọn ìkà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "àti pẹ̀lú àwọn ọlọ́rọ̀ ní ikú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "bí ó tilẹ̀ jẹ́ pé kò hùwà jàgídíjàgan kan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "tàbí kí a rí ẹ̀tàn kan ní ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 53:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀, ó wu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
