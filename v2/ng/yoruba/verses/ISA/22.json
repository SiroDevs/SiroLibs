      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ọjọ́ náà. Èmi yóò ké sí ọmọ ọ̀dọ̀ mi, Eliakimu ọmọ Hilkiah.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fi aṣọ rẹ wọ̀ ọ́, n ó sì so ẹ̀wọ̀n rẹ mọ́ ọn ní ọrùn, èmi ó sì gbé àṣẹ rẹ lé e lọ́wọ́. Òun yó sì jẹ́ baba fún gbogbo olùgbé e Jerusalẹmu àti fún ilé e Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fi kọ́kọ́rọ́ ilé e Dafidi lé e ní èjìká; ohunkóhun tí ó bá ṣí, ẹnikẹ́ni kì yóò lè ti, ohunkóhun tí ó bá sì tì, ẹnikẹ́ni kì yóò le è ṣí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
