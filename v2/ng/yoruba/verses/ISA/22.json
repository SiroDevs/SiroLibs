      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "àti níbẹ̀ pẹ̀lú ni àwọn kẹ̀kẹ́ ogun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
