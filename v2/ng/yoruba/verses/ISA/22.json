      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "àràmọ̀ǹdà rẹ yóò wà—",
          "type": "text",
          "attrs": {
