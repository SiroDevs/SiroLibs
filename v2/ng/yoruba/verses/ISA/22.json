                "verseOrgIds": [
                  "ISA.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun ti sọ èyí di mí mọ̀ létí ì mi: \"Títí di ọjọ́ ikú yín a kò ní ṣe ètùtù fún ẹ̀ṣẹ̀ yìí,\" ni Olúwa wí, àní",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
