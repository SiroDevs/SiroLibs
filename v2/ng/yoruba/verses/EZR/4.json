            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣọ́ra kí ẹ má ṣe àìkọbi-ara sí ọ̀rọ̀ yìí. Èéṣe tí ìbàjẹ́ yóò fi pọ̀ sí i, sí ìpalára àwọn ọba?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
