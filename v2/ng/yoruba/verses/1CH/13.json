  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1CH 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gbígbé padà àpótí ẹ̀rí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì gbèrò pẹ̀lú olúkúlùkù àwọn ìjòyè rẹ̀, àwọn aláṣẹ ẹgbẹẹgbẹ̀rún àti àwọn aláṣẹ ọgọ́rùn-ún",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún gbogbo àwọn ìjọ Israẹli pé, tí ó bá dára lójú yín àti tí ó bá ṣe jẹ́ àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.2",
                "verseOrgIds": [
                  "1CH.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa, jẹ́ kí a ránṣẹ́ sí ọ̀nà jíjìn àti gbígbòòrò sí àwọn arákùnrin wa tókù ní gbogbo àwọn agbègbè ìlú Israẹli àti pẹ̀lú àwọn àlùfáà àti àwọn ará Lefi àwọn tí ó wà pẹ̀lú wọn nínú ìlú wọn àti pápá oko tútù, láti wá kó ara wọn jọ pọ̀ sọ́dọ̀ wa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí a gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.3",
                "verseOrgIds": [
                  "1CH.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "padà sọ́dọ̀ wa, nítorí wí pé àwa kò ṣe ìwádìí nípa rẹ̀ ní àsìkò ìjọba Saulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìjọ náà sì gbà láti ṣe èyí nítorí ó dàbí wí pé ó tọ lójú gbogbo àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Dafidi pe gbogbo àwọn ọmọ Israẹli jọ, láti ọ̀dọ̀ Ṣihori ní Ejibiti lọ sí Lebo ní ọ̀nà à bá wọ Hamati, láti gbé àpótí ẹ̀rí Ọlọ́run padà láti Kiriati-Jearimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti gbogbo àwọn ọmọ Israẹli pẹ̀lú rẹ̀ lọ sí Baalahi ti Juda (Kiriati-Jearimu) láti gbé àpótí ẹ̀rí Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.6",
                "verseOrgIds": [
                  "1CH.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "tí a fi orúkọ rẹ̀ pè, tí ó jókòó láàrín kérúbù gòkè wá.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì gbé àpótí ẹ̀rí Ọlọ́run láti ilé Abinadabu lórí kẹ̀kẹ́ tuntun, Ussa àti Ahio ń ṣọ́ ọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi àti gbogbo àwọn ọmọ Israẹli ni wọ́n ṣe àjọyọ̀ pẹ̀lú gbogbo agbára wọn níwájú Ọlọ́run, pẹ̀lú orin àti pẹ̀lú dùùrù, ohun èlò orin olókùn, tambori, kimbali pẹ̀lú ìpè.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n dé sí ilẹ̀ ìpakà Kidoni, Ussa sì na ọwọ́ rẹ̀ síta láti di àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.9",
                "verseOrgIds": [
                  "1CH.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "mú, nítorí màlúù kọsẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.10",
                "verseOrgIds": [
                  "1CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", sì ru sí Ussa, ó sì lù ú bolẹ̀ nítorí o ti fi ọwọ́ rẹ̀ lórí àpótí ẹ̀rí. Bẹ́ẹ̀ ni ó sì kú síbẹ̀ níwájú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Dafidi sì bínú nítorí ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.11",
                "verseOrgIds": [
                  "1CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ké jáde lórí Ussa, àti títí di òní, wọ́n sì ń pe ibẹ̀ ní Peresi-Usa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì bẹ̀rù Ọlọ́run ní ọjọ́ náà, ó sì béèrè pé, báwo ni èmi náà ó ṣe gbé àpótí ẹ̀rí Ọlọ́run sí ọ̀dọ̀ mi?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò gbé àpótí ẹ̀rí náà wá sí ọ̀dọ̀ ará rẹ̀ ní ìlú ti Dafidi dípò èyí, ó sì gbé e yà sí ilé Obedi-Edomu ará Gitti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.14",
                "verseOrgIds": [
                  "1CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wà lọ́dọ̀ àwọn ará ilé Obedi-Edomu ní ilé rẹ̀ fún oṣù mẹ́ta,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1CH.13.14",
                "verseOrgIds": [
                  "1CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bùkún agbo ilé àti gbogbo ohun tí ó ní.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.14",
    "number": "14",
