  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulu, ẹni ti a pé láti jẹ́ aposteli Kristi Jesu nípa ìfẹ́ Ọlọ́run àti Sostene arákùnrin wa,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí ìjọ ènìyàn Ọlọ́run ni Kọrinti, sí àwọn ti a sọ di mímọ́ nínú Kristi Jesu àti àwọn ti a pè láti jẹ́ mímọ́ pẹ̀lú gbogbo ènìyàn ni ibikíbi ti ń pe orúkọ Olúwa wa Jesu Kristi ẹni ti ń ṣe Olúwa tiwọn àti ti àwa náà:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oore-ọ̀fẹ́ àti àlàáfíà fún yín láti ọ̀dọ̀ Ọlọ́run Baba wa àti Olúwa wa tí í ṣe Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdúpẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà gbogbo ni mo ń dúpẹ́ lọ́wọ́ Ọlọ́run fún oore-ọ̀fẹ́ rẹ̀ tó fi fún un yín nínú Kristi Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí nínú rẹ̀ ni a ti sọ yín di ọlọ́rọ̀ nínú ọ̀rọ̀ sísọ yín gbogbo àti nínú ìmọ̀ yín gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀rí wa nínú Kristi ni a ti fi ìdí rẹ̀ múlẹ̀ nínú yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ẹ̀yin kò ṣe aláìní nínú èyíkéyìí ẹ̀bùn ẹ̀mí, bí ẹ̀yin ṣe ń retí ìfarahàn Olúwa wa Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò sì mú yín dúró títí dé òpin, kí ẹ̀yin kí ó lè jẹ́ aláìlábùkù ní ọjọ́ Olúwa wa Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run, nípasẹ̀ ẹni ti a pè yín sínú ìdàpọ̀ pẹ̀lú Ọmọ rẹ̀ Jesu Kristi Olúwa wa, jẹ́ Olóòtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìyapa nínú ìjọ Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo bẹ̀ yín ẹ̀yin ara, ní orúkọ Olúwa wa Jesu Kristi, pé kí gbogbo yín fohùn ṣọ̀kan kí ó máa ṣe sí ìyapa láàrín yín, àti pé kí a lè ṣe yín pé ní inú àti ìmọ̀ kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin ará mi, àwọn kan láti ilé Kloe sọ di mí mọ̀ fún mi pé ìjà ń bẹ́ láàrín yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun tí mo ń sọ ní pé, olúkúlùkù yín ń wí pé, \"Èmí tẹ̀lé Paulu\"; \"Èmi tẹ̀lé Apollo\"; òmíràn wí pé, \"Èmi tẹ̀lé Kefa, Peteru\"; àti ẹlòmíràn wí pé, \"Èmi tẹ̀lé Kristi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ a ha pín Kristi bí? Ṣé a kan Paulu mọ́ àgbélébùú fún un yín bí? Ǹjẹ́ a tẹ̀ yín bọ omi ní orúkọ Paulu bí?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú mi dún púpọ̀ pé èmi kò tẹ ẹnikẹ́ni nínú yín bọ omi yàtọ̀ sí Krisipu àti Gaiusi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà kò sí ẹni tí ó lè sọ pé òun ṣe ìtẹ̀bọmi ní orúkọ èmi fúnra ara mi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Bẹ́ẹ̀ ni, mo tún tẹ ìdílé Stefana bọ omi; lẹ́yìn èyí, èmí kò rántí pé mo tẹ ẹnikẹ́ni bọ omi mọ́ níbikíbi).",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Kristi kò rán mi láti máa ṣe ìtẹ̀bọmi, ṣùgbọ́n ó rán mi láti máa wàásù ìyìnrere: kì í ṣe nípa ọgbọ́n ènìyàn, kí a máa ṣe sọ àgbélébùú Kristi dí aláìlágbára.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristi ní ọgbọ́n àti agbára Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé òmùgọ̀ ni ọ̀rọ̀ àgbélébùú jẹ́ sí àwọn tí ń ṣègbé, ṣùgbọ́n fún àwa tí a ń gbàlà ó jẹ́ agbára Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí a tí kọ ọ́ pé:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 1:19"
      },
      "items": [
        {
          "text": "\"Èmi yóò pa ọgbọ́n àwọn ọlọ́gbọ́n run,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 1:19"
      },
      "items": [
        {
          "text": "òye àwọn olóye ni Èmi yóò sọ di asán.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọlọ́gbọ́n náà ha dá? Àwọn akọ̀wé náà ha dà? Àwọn onímọ̀ ìjìnlẹ̀ ayé yìí ha dà? Ọlọ́run kò ha ti sọ ọgbọ́n ayé yìí di aṣiwèrè?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé, nínú ọgbọ́n Ọlọ́run, ayé kò le mọ̀ òun nípa ọgbọ́n àti ìṣeféfé wọn. Ó sì gba gbogbo àwọn tí ó gbàgbọ́ là nípa ìwàásù tí àwọn aráyé pè ní òmùgọ̀ àti ọ̀rọ̀ ọ yẹ̀yẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé àwọn Júù ń béèrè àmì, àwọn Helleni sí ń ṣàfẹ́rí ọgbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.22",
            "verseOrgIds": [
              "1CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n àwa ń wàásù Kristi ti a kàn mọ́ àgbélébùú, òkúta ìkọ̀sẹ̀ àwọn Júù àti òmùgọ̀ fún àwọn kèfèrí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n sí àwọn tí Ọlọ́run tí pè, àti àwọn Júù àti àwọn Giriki, Kristi ni agbára Ọlọ́run, àti ọgbọ́n Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.24",
            "verseOrgIds": [
              "1CO.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé òmùgọ̀ Ọlọ́run jù ọgbọ́n ènìyàn lọ; àti aláìlera Ọlọ́run ni agbára jù ìlera ènìyàn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará, ẹ kíyèsi ohun tí ẹ jẹ́ nígbà tí a pè yín. Kì í ṣe ọ̀pọ̀ yín jẹ ọlọ́gbọ́n nípa àgbékalẹ̀ ti ènìyàn, tàbí ọ̀pọ̀ nínú yín jẹ́ ènìyàn pàtàkì, bẹ́ẹ̀ ni kì í ṣe ọ̀pọ̀ nínú yín jẹ́ ọlọ́lá nípa ibi tí a gbé bí i.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run tí yàn àwọn òmùgọ̀ ayé láti fi dààmú àwọn ọlọ́gbọ́n; Ọlọ́run sì ti yàn àwọn ohun aláìlera ayé láti fi dààmú àwọn ohun tí ó ni agbára.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti àwọn ohun tí ayé tí kò ní ìyìn, àti àwọn ohun tí a kẹ́gàn, ni Ọlọ́run sì ti yàn, àní àwọn ohun tí kò sí, láti sọ àwọn ohun tí ó wà di asán.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kí ó má ba à sí ẹnìkan tí yóò ṣògo níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí rẹ̀ ni ẹ̀yin ṣe wà nínú Kristi Jesu ẹni ti ó jásí ọgbọ́n fún wa láti ọ̀dọ̀ Ọlọ́run—èyí ń ni, òdodo, ìwà mímọ́ àti ìràpadà wa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.30",
            "verseOrgIds": [
              "1CO.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, bí a ti kọ ọ́ pé, \"Ẹni ti ó bá ń ṣògo kí ó máa ṣògo nínú Olúwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
            ]
          }
        }
      ]
