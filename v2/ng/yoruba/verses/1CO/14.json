  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀bùn ìsọtẹ́lẹ̀ àti ìfèdèfọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa lépa ìfẹ́, ki ẹ sí máa fi ìtara ṣàfẹ́rí ẹ̀bùn tí í ṣe ti Ẹ̀mí, ṣùgbọ́n ki ẹ kúkú lé máa sọtẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹni tí ń sọ̀rọ̀ ní èdè àìmọ̀, kò bá ènìyàn sọ̀rọ̀ bì ko ṣe Ọlọ́run: nítorí kó sí ẹni tí ó gbọ́; ṣùgbọ́n nípá ti Ẹ̀mí ó ń sọ ohun ìjìnlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹni tí ń sọtẹ́lẹ̀ ń ba àwọn ènìyàn sọ̀rọ̀ fún ìmúdúró, àti ìgbaniníyànjú, àti ìtùnú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ń sọ̀rọ̀ ni èdè àìmọ̀ ń fi ẹsẹ̀ ara rẹ̀ mulẹ̀; ṣùgbọ́n ẹni ti ń sọtẹ́lẹ̀ ń fi ẹsẹ̀ ìjọ múlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìbá wù mí ki gbogbo yín lè máa sọ onírúurú èdè, ṣùgbọ́n kí ẹ kúkú máa sọtẹ́lẹ̀, ẹni tí ń sọtẹ́lẹ̀ pọ̀ jú ẹni ti ń fèdèfọ̀ lọ, bi kọ ṣe pé ó bá ń ṣe ìtumọ̀, kí ìjọ bá à lè kọ́ ẹ̀kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí, ará, bí mo bá wá sí àárín yín, tí mo sì ń sọ̀rọ̀ ní èdè àìmọ̀, èrè kín ni èmi yóò jẹ́ fún yin, bi ko ṣe pé mo bá ń bá yín sọ̀rọ̀, yálà nípa ìṣípayá, tàbí ìmọ̀ tàbí nípá ìsọtẹ́lẹ̀, tàbí nípa ẹ̀kọ́?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ní pẹ̀lú àwọn nǹkan tí kò ní ẹ̀mí tí ń dún, ìbá à ṣe fèrè tàbí dùùrù bí kò ṣe pé ìyàtọ̀ bá wà nínú wọn, a ó tí ṣe mọ ohùn tí fèrè tàbí tí dùùrù ń wí?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé bi ohùn ìpè kò bá dájú, ta ni yóò múra fún ogun?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ sí ni ẹ̀yin, bí kò ṣe pé ẹ̀yin bá ń fi ahọ́n yín sọ̀rọ̀ tí ó yé ni, a ó ti ṣe mọ ohun ti ẹ ń wí? Nítorí pé ẹ̀yin yóò kàn máa sọ̀rọ̀ si afẹ́fẹ́ lásán.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó lé jẹ́ pé onírúurú ohùn èdè ní ń bẹ ní ayé, kò sí ọ̀kan tí kò ní ìtumọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí èmí kò mọ ìtumọ̀ ohùn èdè náà, èmí ó jásí aláìgbédè sí ẹni tí ń sọ̀rọ̀, ẹni tí ń sọ̀rọ̀ yóò sí jásí aláìgbédè sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ sì ní ẹ̀yin, bí ẹ̀yin ti ní ìtara fún ẹ̀bùn Ẹ̀mí, ẹ máa ṣe àfẹ́rí àti máa pọ̀ sí i fún ìdàgbàsókè ìjọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà jẹ́ ki ẹni tí ń sọ̀rọ̀ ni èdè àìmọ̀ gbàdúrà ki ó lè máa ṣe ìtumọ̀ ohun tí ó sọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí èmi bá ń gbàdúrà ní èdè àìmọ̀, ẹ̀mí mi ni ń gbàdúrà, ṣùgbọ́n ọkàn mi jẹ́ aláìléso.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ kín ni èmi yóò ṣe? Èmi yóò fi ẹ̀mí mi gbàdúrà, èmi yóò sí fi òye mi gbàdúrà pẹ̀lú; Èmi yóò fi ẹ̀mí mi kọrin, èmi yóò sí fi òye mi kọrin pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí bẹ́ẹ̀ kọ́, bí ìwọ bá yin Ọlọ́run nípa ẹ̀mí, báwo ni ẹni tí ń bẹ ni ipò òpè yóò ṣe ṣe \"Àmín\" si ìdúpẹ́ rẹ, nígbà tí kò mọ ohun tí ìwọ wí?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ dúpẹ́ gidigidi nítòótọ́, ṣùgbọ́n a kó fi ẹsẹ̀ ẹnìkejì rẹ múlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mó dúpẹ́ lọ́wọ́ Ọlọ́run tí èmi ń fọ onírúurú èdè ju gbogbo yín lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mo fẹ́ kí n kúkú fi ọkàn mi sọ ọ̀rọ̀ márùn-ún ni inú ìjọ, kí n lè kọ́ àwọn ẹlòmíràn ju ẹgbẹ̀rún mẹ́wàá (10,000) ọ̀rọ̀ ni èdè àìmọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará, ẹ má ṣe jẹ ọmọdé ni òye, ṣùgbọ́n ẹ jẹ́ ọmọdé ní àrankàn, ṣùgbọ́n ni òye ẹ jẹ́ àgbà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tí kọ ọ́ nínú òfin pé,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "\"Nípa àwọn aláhọ́n mìíràn",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "àti elétè àjèjì",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "ní èmi ó fi ba àwọn ènìyàn yìí sọ̀rọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "síbẹ̀ wọn kì yóò gbọ́ tèmi,\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qr",
        "vid": "1CO 14:21"
      },
      "items": [
        {
          "text": "ni Olúwa wí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà àwọn ahọ́n jásí àmì kan, kì í ṣe fún àwọn tí ó gbàgbọ́, bí kò ṣe fún àwọn aláìgbàgbọ́: ṣùgbọ́n ìsọtẹ́lẹ̀ kì í ṣe fún àwọn tí kò gbàgbọ́ bí kò ṣe fún àwọn tí ó gbàgbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí gbogbo ìjọ bá péjọ sí ibi kan, tí gbogbo wọn sí ń fi èdè fọ̀, bí àwọn tí ó jẹ́ aláìlẹ́kọ̀ọ́ àti aláìgbàgbọ́ bá wọlé wá, wọn kí yóò ha wí pé ẹ̀yin ń ṣe òmùgọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí gbogbo yín bá ń sọtẹ́lẹ̀, ti ẹnìkan tí kò gbàgbọ́ tàbí tí ko ni ẹ̀kọ́ bá wọlé wá, gbogbo yin ní yóò fi òye ẹ̀ṣẹ̀ yé e, gbogbo yin ní yóò wádìí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ní a ó sì fi àṣírí ọkàn rẹ̀ hàn; bẹ́ẹ̀ ni òun ó sì dojúbolẹ̀, yóò sí sin Ọlọ́run yóò sì sọ pé, \"Nítòótọ́ Ọlọ́run ń bẹ láàrín yín!\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ètò ìsìn lẹ́sẹẹsẹ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ èéha ti ṣe, kín ni àwa yóò sọ ẹ̀yin ará? Nígbà tí ẹ̀yin péjọpọ̀, tí olúkúlùkù yín ni Saamu kan tàbí ẹ̀kọ́ kan, èdè kan, ìfihàn kan àti ìtumọ̀ kan. Ẹ máa ṣe ohun gbogbo láti gbé ìjọ ró.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnìkan bá fi èdè fọ̀, kí ó jẹ ènìyàn méjì, tàbí bí ó pọ̀ tán, kí ó jẹ́ mẹ́ta, kí ó sọ̀rọ̀ ní ọ̀kọ̀ọ̀kan, kí ẹnìkan sì túmọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
              "1CO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí kò bá sí ògbufọ̀, kí ó pa ẹnu rẹ̀ mọ́ nínú ìjọ; sì jẹ́ kí ó máa bá ara rẹ̀ àti Ọlọ́run sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.28",
            "verseOrgIds": [
              "1CO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí àwọn wòlíì méjì tàbí mẹ́ta sọ̀rọ̀, ki àwọn ìyókù sì wòye ìtumọ̀ ohun tí a sọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí a bá sì fi ohunkóhun hàn ẹni tí ó jókòó níbẹ̀, jẹ́ kí ẹni tí ó kọ́ sọ̀rọ̀ ṣáájú dákẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí gbogbo yín lè sọtẹ́lẹ̀ ni ọ̀kọ̀ọ̀kan, kí gbogbo yín lè kọ́ ẹ̀kọ́, kí a lè tu gbogbo yín nínú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí àwọn wòlíì a sí máa tẹríba fún àwọn wòlíì.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Ọlọ́run kì í ṣe Ọlọ́run ohun rúdurùdu, ṣùgbọ́n ti àlàáfíà. Gẹ́gẹ́ bí ó ti jẹ́ nínú gbogbo ìjọ ènìyàn mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ ki àwọn obìnrin yín dákẹ́ nínú ìjọ, nítorí a kò fi fún wọn láti sọ̀rọ̀, ṣùgbọ́n jẹ́ kí wọn wà lábẹ́ ìtẹríba, gẹ́gẹ́ bí òfin pẹ̀lú ti wí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n bá sì fẹ́ mọ̀ nípa ohunkóhun, kí wọn béèrè lọ́wọ́ ọkọ wọn ní ilé; nítorí ohun ìtìjú ni fún àwọn obìnrin láti máa sọ̀rọ̀ nínú ìjọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kín ni? Ṣe lọ́dọ̀ yín ní ọ̀rọ̀ Ọlọ́run ti jáde ni, tàbí ẹ̀yin nìkan ni o tọ̀ wá?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹnikẹ́ni bá ró ará rẹ̀ pé òun jẹ́ wòlíì, tàbí òun jẹ́ ẹni tí ó ní ẹ̀bùn ẹ̀mí, jẹ́ kí nǹkan wọ̀nyí ti mo kọ sí yin yé e dájú pé òfin Olúwa ni wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹnìkan bá fi ojú fo èyí dá, òun fúnra rẹ̀ ní a ó fi ojú fò dá.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ará, ẹ máa fi ìtara ṣàfẹ́rí láti sọtẹ́lẹ̀, kí ẹ má sì ṣe dánilẹ́kun láti fi èdè fọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa ṣe ohun gbogbo tẹ̀yẹtẹ̀yẹ àti lẹ́sẹẹsẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
      ]
    }
  ],
