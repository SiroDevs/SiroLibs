  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa tẹ̀lé àpẹẹrẹ mi, gẹ́gẹ́ bí èmi náà ti ń tẹ̀lé àpẹẹrẹ Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbámu nínú ìsìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmí yìn yín fún rírántí mi nínú ohun gbogbo àti fún dídi gbogbo ẹ̀kọ́ tí mo kọ́ ọ yín mú ṣinṣin gẹ́gẹ́ bí mo ṣe fi lélẹ̀ fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mo fẹ́ kí ẹ̀yin mọ̀ pé, Kristi ni orí olúkúlùkù ọkùnrin, orí obìnrin sì ni ọkọ rẹ̀ àti orí Kristi sì ní Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọkùnrin tó bá borí rẹ̀ nígbà tó bá ń gbàdúrà tàbí sọtẹ́lẹ̀ kò bọ̀wọ̀ fún orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ náà ni obìnrin tí ó bá ń gbàdúrà tàbí tí ó bá ń sọtẹ́lẹ̀ láìbo orí rẹ̀, kò bu ọlá fún orí ara rẹ̀ nítorí ọ̀kan náà ni pẹ̀lú ẹni tí ó fárí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí obìnrin bá kọ̀ láti bo orí rẹ̀, ẹ jẹ́ kí ó gé irun rẹ̀. Bí ó bá sì jẹ́ nǹkan ìtìjú fún un láti gé irun orí rẹ́, nígbà náà kí ó fi gèlè bo orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọkùnrin kò ní láti fi nǹkan bo orí rẹ́ nígbà tí ó bá ń sìn, nítorí àwòrán àti ògo Ọlọ́run ni òun í ṣe, ṣùgbọ́n ògo ọkùnrin ni obìnrin í ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin kò ti inú obìnrin wá, ṣùgbọ́n a yọ obìnrin jáde lára ọkùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bẹ́ẹ̀ ni a kò dá ọkùnrin fún àǹfààní obìnrin ṣùgbọ́n a da obìnrin fún ọkùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìdí èyí àti nítorí àwọn angẹli, ni obìnrin ṣe gbọdọ̀ ní àmì àṣẹ rẹ̀ ní orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rántí pé, nínú ètò Ọlọ́run obìnrin kò lè wà láìsí ọkùnrin, bẹ́ẹ̀ ni ọkùnrin kò lè wà láàsí obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòtítọ́ láti ara ọkùnrin ni a ti yọ obìnrin jáde bẹ́ẹ̀ sì ni ọkùnrin tipasẹ̀ obìnrin wa. Ṣùgbọ́n láti ọ̀dọ̀ Ọlọ́run ni ohun gbogbo ti wà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni ẹ̀yìn fúnra yín rò lórí ọ̀rọ̀ yìí? Ǹjẹ́ ó tọ̀nà fún obìnrin láti máa gbàdúrà Ọlọ́run ní gbangba láìbo orí rẹ̀ bí?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ìwà abínibí yín kò ha kọ́ yín pé, bí ọkùnrin bá ní irun gígùn, àbùkù ni ó jẹ́ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí obìnrin bá ní irun gígùn, ògo ni ó jẹ́ fún un nítorí irun gígùn tí a fi fún un jẹ́ ìbòrí fún un.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ẹnikẹ́ni bá fẹ́ jiyàn lórí ọ̀rọ̀ yìí, ohun kan tí mo lè sọ sí gbogbo rẹ̀ ni pé, a kò ní ìlànà tí ó yàtọ̀ sí èyí tí mo ti sọ, pé obìnrin gbọdọ̀ fi gèlè bo orí rẹ̀ nígbà tí ó bá ń sọtẹ́lẹ̀ tàbí tí ó bá ń gbàdúrà láàrín ìjọ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oúnjẹ alẹ́ Olúwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú àwọn àlàkalẹ̀ èmi ko ni yìn yín nítorí pé bí ẹ bá péjọ kì í ṣe fún rere bí ko ṣe fún búburú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ́nà kìn-ín-ní, mo gbọ́ pe ìyapa máa ń wà láàrín yín ní ìgbà tí ẹ bá péjọpọ̀ gẹ́gẹ́ bí ìjọ, mo sì gba èyí gbọ́ dé ààyè ibìkan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí àní àní, ìyàtọ̀ gbọdọ̀ wa láàrín yín, kí àwọn tí ó ṣe ìtẹ́wọ́gbà lọ́dọ̀ Ọlọ́run láàrín yín le farahàn kedere.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ bá pàdé láti jẹun, kì í ṣe oúnjẹ alẹ́ Olúwa ni ẹ máa ń jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ara yín, nígbà tí ẹ bá fẹ́ jẹun, olúkúlùkù yín a máa sáré jẹ oúnjẹ rẹ̀ láìdúró de ẹnìkejì rẹ̀. Ebi a sì máa pa wọ́n, ẹlòmíràn wọ́n sì ń mu àmuyó àti àmupara.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé ẹ̀yin kò ní ilé tí ẹ ti lè jẹ, tí ẹ sì ti lè mu ni? Tàbí ẹ̀yin ń gan ìjọ Ọlọ́run ni? Ẹ̀yin sì ń dójútì àwọn aláìní? Kín ni kí èmi ó wí fún un yín? Èmi yóò ha yìn yín nítorí èyí? A! Rárá o. Èmi kọ́, n kò ní yìn yín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí tí èmi gbà lọ́wọ́ Olúwa ni mo ti fi fún un yin. Ní alẹ́ ọjọ́ tí Judasi fihàn, Olúwa Jesu Kristi mú àkàrà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí ó ti dúpẹ́ lọ́wọ́ Ọlọ́run fún àkàrà náà tan, ó bù ú, ó fi fún àwọn ọmọ-ẹ̀yìn rẹ̀, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ gbà kí ẹ sì jẹ, èyí ní ara mi tí a fi fún un yín. Ẹ máa ṣe eléyìí ni rántí mi.\"",
              "type": "text",
              "attrs": {
                "verseId": "1CO.11.24",
                "verseOrgIds": [
                  "1CO.11.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ gẹ́gẹ́ lẹ́yìn oúnjẹ alẹ́, ó sì mú ago wáìnì, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ago yìí ni májẹ̀mú tuntun nínú ẹ̀jẹ̀ mi, ẹ máa ṣe èyí, nígbàkígbà ti ẹ̀yìn bá ń mu ú, ní ìrántí mi.\"",
              "type": "text",
              "attrs": {
                "verseId": "1CO.11.25",
                "verseOrgIds": [
                  "1CO.11.25"
                ]
              }
            }
