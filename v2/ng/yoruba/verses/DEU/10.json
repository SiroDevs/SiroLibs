  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "DEU 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wàláà òfin bí i ti ìṣáájú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.1",
                "verseOrgIds": [
                  "DEU.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún mi pé, \"Gbé wàláà òkúta méjì bí i ti àkọ́kọ́ kí o sì gòkè tọ̀ mí wá. Kí o sì tún fi igi kan àpótí kan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì kọ ọ̀rọ̀ tí ó wà lára wàláà àkọ́kọ́ tí ìwọ fọ́, sára wàláà wọ̀nyí. Ìwọ yóò sì fi wọ́n sínú àpótí náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì kan àpótí náà pẹ̀lú igi kasia, mo sì gbẹ́ wàláà òkúta méjì náà jáde bí i ti ìṣáájú. Mo sì gòkè lọ pẹ̀lú wàláà méjèèjì lọ́wọ́ mí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.3",
            "verseOrgIds": [
              "DEU.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.4",
                "verseOrgIds": [
                  "DEU.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tún ohun tí ó ti kọ tẹ́lẹ̀ kọ sórí wàláà wọ̀nyí. Àwọn òfin mẹ́wẹ̀ẹ̀wá tí ó ti sọ fún un yín lórí òkè, láàrín iná, ní ọjọ́ ìpéjọpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.4",
                "verseOrgIds": [
                  "DEU.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi wọ́n fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì sọ̀kalẹ̀ láti orí òkè náà, mo sì ki àwọn wàláà òkúta náà sínú àpótí tí mo ti kàn, bí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.5",
                "verseOrgIds": [
                  "DEU.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún mi, wọ́n sì wà níbẹ̀ di ìsinsin yìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Àwọn ará Israẹli sì gbéra láti kànga àwọn ará Jaakani dé Mosera. Níbí ni Aaroni kú sí, tí a sì sin ín, Eleasari ọmọ rẹ̀ sì rọ́pò rẹ̀ bí i àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibẹ̀ ni wọ́n ti rìn lọ sí Gudgoda, títí dé Jotbata, ilẹ̀ tí o kún fún odò tí ó ń sàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà yìí ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "yan àwọn ẹ̀yà Lefi láti máa ru àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", láti máa dúró níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ṣe iṣẹ́ ìránṣẹ́, àti láti fi orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "súre bí wọ́n ti ń ṣe títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdí nìyí tí àwọn ẹ̀yà Lefi kò fi ní ìpín tàbí ogún kan láàrín àwọn arákùnrin wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ogún wọn gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run ti sọ fún un yín.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo tún dúró ní orí òkè náà fún ogójì ọ̀sán àti ogójì òru, bí mo ti ṣe ní ìgbà àkọ́kọ́,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.10",
                "verseOrgIds": [
                  "DEU.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sì gbọ́ tèmi ní àkókò yìí bákan náà. Kì í ṣe ìfẹ́ rẹ̀ láti run yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.11",
                "verseOrgIds": [
                  "DEU.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún mi pé, \"Lọ darí àwọn ènìyàn wọ̀nyí ní ọ̀nà wọn, kí wọn bá à lè wọ ilẹ̀ náà, kí wọn sì gba ilẹ̀ tí mo ti búra fún àwọn baba wọn láti fún wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ bẹ̀rù",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ìwọ Israẹli, kín ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.12",
                "verseOrgIds": [
                  "DEU.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ béèrè lọ́wọ́ rẹ? Bí kò ṣe kí ìwọ bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.12",
                "verseOrgIds": [
                  "DEU.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ àti láti máa rìn ní gbogbo ọ̀nà rẹ̀, láti fẹ́ràn rẹ̀, láti fi gbogbo ọkàn rẹ sin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.12",
                "verseOrgIds": [
                  "DEU.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ọkàn àti àyà rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti láti máa kíyèsi àṣẹ àti ìlànà",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.13",
            "verseOrgIds": [
              "DEU.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.13",
                "verseOrgIds": [
                  "DEU.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "tí mo ń fún ọ lónìí, fún ìre ara à rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.13",
            "verseOrgIds": [
              "DEU.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ wí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
              "DEU.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.14",
                "verseOrgIds": [
                  "DEU.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ni ó ni ọ̀run àní àwọn ọ̀run tó ga ju ayé àti ohun gbogbo tí ó wà nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
              "DEU.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.15",
                "verseOrgIds": [
                  "DEU.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tún fi ìfẹ́ rẹ̀ hàn fún àwọn baba ńlá a yín, Ó sì fẹ́ wọn Ó sì yan ẹ̀yin ọmọ wọn láti borí gbogbo orílẹ̀-èdè títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kọ ọkàn yín ní ilà, kí ẹ má sì ṣe jẹ́ olórí kunkun mọ́ láti òní lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.16",
            "verseOrgIds": [
              "DEU.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.17",
                "verseOrgIds": [
                  "DEU.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, ni Ọlọ́run àwọn ọlọ́run àti Olúwa àwọn olúwa. Ọlọ́run alágbára, tí ó tóbi tí ó sì lẹ́rù, tí kì í ṣe ojúsàájú kì í sì í gba àbẹ̀tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó máa ń gbẹjọ́ aláìní baba àti opó rò, Ó fẹ́ràn àjèjì, Òun fi aṣọ àti oúnjẹ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ fẹ́ràn àwọn àjèjì, torí pé ẹ̀yin pẹ̀lú ti jẹ́ àjèjì rí ní Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.20",
                "verseOrgIds": [
                  "DEU.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, ẹ sì máa sìn ín. Ẹ dìímú ṣinṣin, kí ẹ sì búra ní orúkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ìyìn in yín, Òun sì ni Ọlọ́run yín, tí ó ṣe àwọn iṣẹ́ ìyanu ńlá àti ohun ẹ̀rù, tí ẹ fojú ara yín rí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àádọ́rin péré ni àwọn baba ńlá a yín tí ó sọ̀kalẹ̀ lọ sí Ejibiti, ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
            "verseOrgIds": [
              "DEU.10.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.22",
                "verseOrgIds": [
                  "DEU.10.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ti mú un yín pọ̀ sí i ní iye bí àwọn ìràwọ̀ ojú ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
            "verseOrgIds": [
              "DEU.10.22"
            ]
          }
        }
      ]
    }
