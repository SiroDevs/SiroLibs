  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "DEU 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjọ ìrékọjá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kíyèsi oṣù Abibu, kí ẹ sì máa ṣe àjọ̀dún ìrékọjá ti",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.1",
                "verseOrgIds": [
                  "DEU.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, nítorí pé ní oṣù Abibu yìí ni ó mú un yín jáde ní Ejibiti lóru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ fi ẹran kan rú ẹbọ bí ìrékọjá sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.2",
                "verseOrgIds": [
                  "DEU.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín láti inú ọ̀wọ́ ẹran tàbí agbo màlúù yín ní ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.2",
                "verseOrgIds": [
                  "DEU.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò yàn bí ibùgbé fún orúkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe jẹ ẹ́ pẹ̀lú u àkàrà tí a fi ìwúkàrà ṣe, ṣùgbọ́n ọjọ́ méje ni kí ẹ fi jẹ àkàrà tí kò ní ìwúkàrà, àkàrà ìpọ́njú, nítorí pé pẹ̀lú ìkánjú ni ẹ kúrò ní Ejibiti: kí ẹ bá à lè rántí ìgbà tí ẹ kúrò ní Ejibiti ní gbogbo ọjọ́ ayé yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a má sì ṣe rí àkàrà wíwú ní ọ̀dọ̀ rẹ nínú ilẹ̀ rẹ ní ijọ́ méje. Kí ìwọ má ṣe jẹ́ kí nǹkan kan ṣẹ́kù nínú ẹran tí ìwọ ó fi rú ẹbọ ní ìrọ̀lẹ́ ọjọ́ kìn-ín-ní di àárọ̀ ọjọ́ kejì.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ ṣe ìrékọjá náà ní ìlúkílùú kankan, tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.5",
                "verseOrgIds": [
                  "DEU.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín fi fún un yín",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí kò ṣe ibi tí yóò yàn gẹ́gẹ́ bí ibùgbé fún orúkọ rẹ̀, níbẹ̀ ni ki ẹ ti ṣe ìrúbọ ìrékọjá náà ní ìrọ̀lẹ́ nígbà tí oòrùn bá ń wọ̀ gẹ́gẹ́ bí ìrántí ìgbà tí ẹ kúrò ní ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ sun ún kí ẹ sì jẹ ẹ́ ní ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.7",
                "verseOrgIds": [
                  "DEU.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò yàn. Ní àárọ̀, kí ẹ padà sí àgọ́ ọ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ mẹ́fà ní kí ẹ fi jẹ àkàrà aláìwú, ní ọjọ́ keje, ẹ pe àjọ kan fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.8",
                "verseOrgIds": [
                  "DEU.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, kí ẹ má sì ṣe iṣẹ́ kankan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayẹyẹ àwọn ọ̀sẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ̀sẹ̀ méje láti ìgbà tí ẹ bá ti bẹ̀rẹ̀ sí fi dòjé ṣe ìkórè ọkà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni kí ẹ ṣe àjọ ọ̀sẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.10",
                "verseOrgIds": [
                  "DEU.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, nípa pípèsè ọrẹ àtinúwá, gẹ́gẹ́ bí ìbùkún tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.10",
                "verseOrgIds": [
                  "DEU.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ sì máa yọ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.11",
                "verseOrgIds": [
                  "DEU.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ní ibi tí yóò yàn ní ibùgbé fún orúkọ rẹ̀: ẹ̀yin, àwọn ọmọ yín ọkùnrin àti àwọn ọmọ yín obìnrin, àwọn ẹrú yín ọkùnrin àti àwọn ẹrú yín obìnrin, àwọn Lefi tí ó wà ní ìlú yín, àti àwọn àjèjì, àwọn aláìní baba, àti àwọn opó tí ń gbé àárín yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rántí pé, ẹ ti jẹ́ ẹrú ní Ejibiti rí, nítorí náà ẹ tẹ̀lé àwọn ìlànà wọ̀nyí dáradára.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayẹyẹ àgọ́ ìpàdé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣe ayẹyẹ àgọ́ ìpàdé fún ọjọ́ méje lẹ́yìn ìgbà tí ẹ bá ti kórè oko yín tí ẹ ti pakà tí ẹ sì ti fún ọtí tán.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ máa yọ̀ ní àkókò àjọ̀dún un yín, ẹ̀yin, àwọn ọmọ yín ọkùnrin àti obìnrin, àwọn ẹrúkùnrin àti ẹrúbìnrin yín, àti àwọn Lefi, àwọn àjèjì, àwọn aláìní baba àti àwọn opó tí ń gbé ní àwọn ìlú u yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọjọ́ méje ni kí ẹ̀yin kí ó fi ṣe ayẹyẹ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ní ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yàn. Nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò bùkún un yín ní gbogbo ìkórè e yín, àti ní gbogbo iṣẹ́ ọwọ́ yín, ayọ̀ ọ yín yóò sì kún.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ẹ̀ẹ̀mẹ́ta lọ́dún ni kí gbogbo àwọn ọkùnrin rẹ kí ó farahàn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.16",
                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀, ní ibi tí yóò yàn. Níbi àjọ àkàrà àìwú, níbi àjọ ọ̀sẹ̀, àti àjọ àgọ́ ìpàdé. Ẹnikẹ́ni kò gbọdọ̀ wá sí iwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.16",
                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ọwọ́ òfo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí olúkúlùkù ó mú ọrẹ wá bí agbára rẹ̀ ti tó, gẹ́gẹ́ bí ìbùkún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.17",
                "verseOrgIds": [
                  "DEU.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ tí ó fi fún un ọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn adájọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ yan àwọn adájọ́ àti àwọn olóyè fún ẹ̀yà a yín kọ̀ọ̀kan, ní gbogbo ìlú tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.18",
                "verseOrgIds": [
                  "DEU.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò fún un yín, wọ́n sì gbọdọ̀ máa fi òtítọ́ ṣe ìdájọ́ àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ yí ìdájọ́ po, ìwọ kò gbọdọ̀ ṣe ojúsàájú ènìyàn. Ìwọ kò gbọdọ̀ gba àbẹ̀tẹ́lẹ̀ nítorí pé àbẹ̀tẹ́lẹ̀ ń fọ́ ojú ọlọ́gbọ́n, ó sì ń ba ọ̀rọ̀ olódodo jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ tẹ̀lé ìdájọ́ òtítọ́ àní ìdájọ́ òtítọ́ nìkan, kí ẹ bá à lè gbé kí ẹ sì gba ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.20",
                "verseOrgIds": [
                  "DEU.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ń fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sí sin ọlọ́run mìíràn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe ri ère òrìṣà Aṣerah sí ẹ̀gbẹ́ pẹpẹ tí ẹ ti mọ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.21",
            "verseOrgIds": [
              "DEU.16.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.21",
                "verseOrgIds": [
                  "DEU.16.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.21",
            "verseOrgIds": [
              "DEU.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ gbé òkúta òrìṣà gbígbẹ́ kan kalẹ̀ fún ara yín, nítorí èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.22",
            "verseOrgIds": [
              "DEU.16.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.22",
                "verseOrgIds": [
                  "DEU.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín kórìíra.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.22",
            "verseOrgIds": [
              "DEU.16.22"
            ]
          }
        }
