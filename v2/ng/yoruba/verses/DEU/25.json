  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "DEU 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ènìyàn méjì bá ń jà, kí wọn kó ẹjọ́ lọ sí ilé ìdájọ́, kí àwọn onídàájọ́ dá ẹjọ́ náà, kí wọn dá àre fún aláre àti ẹ̀bi fún ẹlẹ́bi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá tọ́ láti na ẹlẹ́bi, kí onídàájọ́ dá a dọ̀bálẹ̀ kí a sì nà án ní ojú u rẹ̀ ní iye pàṣán tí ó tọ́ sí ẹ̀ṣẹ̀ tí ó sẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kò gbọdọ̀ fún un ju ogójì pàṣán lọ. Bí ó bá nà án ju bẹ́ẹ̀ lọ, arákùnrin rẹ̀ yóò di ẹni ìrẹ̀sílẹ̀ ní ojú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ kò gbọdọ̀ di màlúù ti ń tẹ ọkà lẹ́nu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn arákùnrin bá ń gbé pọ̀, tí ọ̀kan nínú wọn bá sì kú, tí kò sí ní ọmọkùnrin, kí aya òkú má ṣe ní àlejò ará òde ní ọkọ rẹ̀. Arákùnrin ọkọ rẹ̀ ni kí ó wọlé tọ̀ ọ́, kí ó fi ṣe aya, kí ó sì ṣe iṣẹ́ arákùnrin ọkọ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọkùnrin tí ó bá kọ́ bí ni yóò máa jẹ́ orúkọ arákùnrin rẹ̀ tí ó kú náà, kí orúkọ rẹ̀ má ba á parẹ́ ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ọkùnrin náà kò bá fẹ́ fi aya arákùnrin rẹ̀ ṣe aya rẹ̀, obìnrin náà yóò lọ sí ọ̀dọ̀ àwọn àgbàgbà ní ẹnu-bodè ìlú láti sọ pé, \"Arákùnrin ọkọ ọ̀ mi kọ̀ láti gbé orúkọ arákùnrin rẹ̀ ró ní Israẹli. Kò ní ṣe ojúṣe rẹ̀ bí arákùnrin ọkọ mi sí mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn àgbàgbà ìlú rẹ̀ yóò pè é, wọn yóò sì bá sọ̀rọ̀. Bí ó bá sì kọ̀ jálẹ̀ tí ó bá sọ pé, \"Èmi kò fẹ́ láti fẹ́ ẹ,\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "opó arákùnrin rẹ̀ yìí yóò lọ sọ́dọ̀ rẹ̀ ní ojú àwọn àgbàgbà ìlú rẹ̀, yóò yọ bàtà ẹsẹ̀ rẹ̀ kan, yóò sì tu itọ́ sí ọkùnrin náà lójú, yóò sì wí pé, \"Èyí ni ohun tí a ṣe sí ọkùnrin tí kò jẹ́ kí ìdílé arákùnrin rẹ̀ wà títí ayé.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ó sì mọ ìdílé arákùnrin yìí ní Israẹli gẹ́gẹ́ bí \"Ìdílé tí a yọ bàtà rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin méjì bá ń jà, tí ìyàwó ọ̀kan nínú wọn bá sì wá láti gbèjà ọkọ rẹ̀ kúrò lọ́wọ́ ọkùnrin tí ń lù ú, tí ó sì nawọ́ di nǹkan ọkùnrin abẹ́ ẹ rẹ̀ mú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò gé ọwọ́ rẹ̀ náà kúrò. Má ṣe ṣàánú fún un.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe ní oríṣìí ìtẹ̀wọ̀n méjì tó yàtọ̀ sí ara wọn nínú àpò rẹ, ọ̀kan wúwo àti ọ̀kan fífúyẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe ní oríṣìí ìwọ̀n méjì tí ó yàtọ̀ sí ara wọn ní ilé è rẹ: ọ̀kan fífẹ̀, ọ̀kan kékeré.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O gbọdọ̀ ní ìtẹ̀wọ̀n àti òsùwọ̀n pípé àti ti òtítọ́ nítorí náà kí ìwọ kí ó lè pẹ́ ní ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.25.15",
                "verseOrgIds": [
                  "DEU.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.25.16",
                "verseOrgIds": [
                  "DEU.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run kórìíra ẹnikẹ́ni tí ó bá ṣe nǹkan wọ̀nyí, àní ẹnikẹ́ni tí ń ṣe àìṣòdodo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rántí ohun tí àwọn ará Amaleki ṣe sí i yín ní ọ̀nà nígbà tí ẹ̀ ń jáde láti ilẹ̀ Ejibiti wá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àárẹ̀ mú un yín tí agara sì dá a yín, wọ́n pàdé e yín ní ọ̀nà àjò o yín, wọ́n gé àwọn tí ó rẹ̀yìn kúrò, wọn kò ní ìbẹ̀rù Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.25.19",
                "verseOrgIds": [
                  "DEU.25.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín bá fún un yín ní ìsinmi lọ́wọ́ gbogbo àwọn ọ̀tá yín tí ó yí i yín ká ní ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.25.19",
                "verseOrgIds": [
                  "DEU.25.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run ń fi fún yín láti ni ní ìní, ẹ̀yin yóò sì pa ìrántí Amaleki rẹ́ kúrò lábẹ́ ọ̀run. Má ṣe gbàgbé.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    }
  ],
