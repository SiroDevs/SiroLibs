  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "DEU 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joṣua rọ́pò Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose jáde tí ó sì sọ àwọn ọ̀rọ̀ wọ̀nyí sí gbogbo Israẹli pé,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.1",
            "verseOrgIds": [
              "DEU.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mo jẹ́ ọmọ ọgọ́fà ọdún báyìí àti pé èmi kò ni lè darí i yín mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.2",
                "verseOrgIds": [
                  "DEU.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ fún mi pé, 'Ìwọ kò ní kọjá Jordani.'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.3",
                "verseOrgIds": [
                  "DEU.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ fúnra rẹ̀ ni yóò rékọjá fún ọ. Yóò pa àwọn orílẹ̀-èdè yìí run níwájú rẹ, ìwọ yóò sì mú ìní ilẹ̀ wọn, Joṣua náà yóò rékọjá fún ọ, bí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.3",
                "verseOrgIds": [
                  "DEU.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.4",
                "verseOrgIds": [
                  "DEU.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì ṣe fún wọn ohun tí ó ti ṣe sí Sihoni àti sí Ogu ọba Amori, tí ó parun pẹ̀lú ilẹ̀ ẹ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.4",
            "verseOrgIds": [
              "DEU.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.5",
                "verseOrgIds": [
                  "DEU.31.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi wọ́n fún ọ, kí o sì ṣe sí wọn gbogbo èyí tí mo ti pàṣẹ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.5",
            "verseOrgIds": [
              "DEU.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ alágbára kí o sì ní ìgboyà. Má ṣe bẹ̀rù tàbí jáyà nítorí i wọn, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.6",
                "verseOrgIds": [
                  "DEU.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ń lọ pẹ̀lú rẹ, Òun kò ní fi ọ́ sílẹ̀ tàbí kọ̀ ọ́ sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose pe Joṣua ó sì wí fún un níwájú gbogbo Israẹli pé, \"Jẹ́ alágbára àti onígboyà, nítorí o ní láti lọ pẹ̀lú àwọn ènìyàn wọ̀nyí sí ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.7",
                "verseOrgIds": [
                  "DEU.31.7"
                ]
              }
            }
          ]
        },
        {
          "text": "búra fún àwọn baba ńlá a wọn láti fún wọn, kí o sì pín ilẹ̀ náà láàrín wọn bí ogún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.8",
                "verseOrgIds": [
                  "DEU.31.8"
                ]
              }
            }
          ]
        },
        {
          "text": "fúnra rẹ̀ ń lọ níwájú rẹ yóò sì wà pẹ̀lú rẹ; kò ní fi ọ́ sílẹ̀ tàbí kọ̀ ọ́ sílẹ̀. Má ṣe bẹ̀rù má sì ṣe fòyà.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kíka òfin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose kọ òfin yìí kalẹ̀ ó sì fi fún àwọn àlùfáà, àwọn ọmọ Lefi, tí ń gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.9",
                "verseOrgIds": [
                  "DEU.31.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", àti fún gbogbo àwọn àgbàgbà ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose pàṣẹ fún wọn, \"Ní òpin ọdún méje méje, ní àkókò ọdún ìdásílẹ̀, nígbà àjọ àwọn àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.10",
            "verseOrgIds": [
              "DEU.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo Israẹli bá wá láti fi ara hàn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.11",
                "verseOrgIds": [
                  "DEU.31.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa ní ibi tí yóò yàn, ìwọ yóò ka òfin yìí níwájú wọn sí etí ìgbọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe àwọn ènìyàn jọ àwọn ọkùnrin, àwọn obìnrin àti àwọn àjèjì tí ń gbé àwọn ìlú u yín kí wọn lè fetí sí i kí wọn sì lè kọ́ láti bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.12",
                "verseOrgIds": [
                  "DEU.31.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ kí wọn sì rọra tẹ̀lé gbogbo ọ̀rọ̀ òfin yìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ wọn tí wọn kò mọ òfin yìí, gbọdọ̀ gbọ́ kí wọn sì kọ́ láti bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.13",
                "verseOrgIds": [
                  "DEU.31.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ níwọ̀n ìgbà tí o tí ń gbé ní ilẹ̀ tí ò ń kọjá la Jordani lọ láti ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìsọtẹ́lẹ̀ Israẹli ọlọ̀tẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.14",
                "verseOrgIds": [
                  "DEU.31.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Ọjọ́ ikú rẹ ti súnmọ́ etílé báyìí. Pe Joṣua kí ẹ sì fi ara yín hàn nínú àgọ́ àjọ, níbi tí èmi yóò ti fi àṣẹ fún un.\" Nígbà náà ni Mose àti Joṣua wá, wọ́n sì fi ara wọn hàn níbi àgọ́ àjọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.15",
                "verseOrgIds": [
                  "DEU.31.15"
                ]
              }
            }
          ]
        },
        {
          "text": "farahàn níbi àgọ́ ní ọ̀wọ́ àwọsánmọ̀, àwọsánmọ̀ náà sì dúró sókè ẹnu-ọ̀nà àgọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.16",
                "verseOrgIds": [
                  "DEU.31.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Mose pé, \"Ìwọ ń lọ sinmi pẹ̀lú àwọn baba à rẹ, àwọn wọ̀nyí yóò sì ṣe àgbèrè ara wọn sí ọlọ́run àjèjì ilẹ̀ tí wọn ń wọ̀ lọ láìpẹ́. Wọn yóò kọ̀ mí sílẹ̀ wọn yóò sì da májẹ̀mú tí mo bá wọn dá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.16",
            "verseOrgIds": [
              "DEU.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà ni èmi yóò bínú sí wọn èmi yóò sì kọ̀ wọ́n sílẹ̀; èmi yóò pa ojú mi mọ́ kúrò fún wọn, wọn yóò sì parun. Ọ̀pọ̀lọpọ̀ àjálù àti ìṣòro yóò wá sórí wọn, àti ní ọjọ́ náà ni wọn yóò béèrè pé, 'Ǹjẹ́ ìpọ́njú wọ̀nyí kò wá sórí i wa nítorí Ọlọ́run wa kò sí pẹ̀lú u wa?'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.17",
            "verseOrgIds": [
              "DEU.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì pa ojú mi mọ́ dájúdájú ní ọjọ́ náà nítorí i gbogbo ìwà búburú wọn ní yíyípadà sí ọlọ́run mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní báyìí kọ ọ́ kalẹ̀ fúnra à rẹ orin yìí kí o sì kọ ọ́ sí Israẹli kí o sì jẹ́ kí wọn kọ ọ́ kí ó lè jẹ́ ẹ̀rí ì mi sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo ti mú wọn wá sí ilẹ̀ tí ń sàn fún wàrà àti fún oyin, ilẹ̀ tí mo ti ṣe ìlérí ní ìbúra fún àwọn baba ńlá wọn, àti nígbà tí wọ́n bá jẹ, tí ó sì tẹ́ wọn lọ́rùn, tí wọ́n sì gbilẹ̀, wọn yóò yí padà sí ọlọ́run mìíràn wọn yóò sì sìn wọ́n, wọn yóò kọ̀ mí sílẹ̀, wọn yóò sì da májẹ̀mú mi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti nígbà tí ọ̀pọ̀lọpọ̀ ìpọ́njú àti ìṣòro bá wá sórí i wọn, orin yìí yóò jẹ́ ẹ̀rí sí wọn, nítorí kò ní di ìgbàgbé fún àwọn ọmọ wọn. Mo mọ̀ ohun tí wọ́n ní inú dídùn sí láti ṣe, pàápàá kí èmi tó mú wọn wá sí ilẹ̀ tí mo ṣe ìlérí fún wọn lórí ìbúra.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose kọ orin yìí kalẹ̀ ní ọjọ́ náà ó sì kọ ọ́ sí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.23",
                "verseOrgIds": [
                  "DEU.31.23"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fún Joṣua ọmọ Nuni ní àṣẹ yìí: \"Jẹ́ alágbára àti onígboyà, nítorí ìwọ yóò mú Israẹli wá sí ilẹ̀ tí mo ṣèlérí fún wọn lórí ìbúra, èmi fúnra à mi yóò sì wà pẹ̀lú rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí Mose ti parí i kíkọ ọ̀rọ̀ òfin yìí sínú ìwé láti ìbẹ̀rẹ̀ dé òpin,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì fi àṣẹ yìí fún àwọn ọmọ Lefi tí wọ́n ń gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.25",
                "verseOrgIds": [
                  "DEU.31.25"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gba ìwé òfin yìí kí o sì fi sí ẹ̀gbẹ́ àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.26",
                "verseOrgIds": [
                  "DEU.31.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ. Níbẹ̀ ni yóò wà bí ẹ̀rí sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí mo mọ irú ọlọ̀tẹ̀ àti ọlọ́rùn líle tí ẹ jẹ́. Bí o bá ṣe ọlọ̀tẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.27",
                "verseOrgIds": [
                  "DEU.31.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nígbà tí mo pàpà wà láyé pẹ̀lú yín, báwo ní ẹ ó ti ṣe ọlọ̀tẹ̀ tó nígbà tí mo bá kú tán!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ péjọpọ̀ síwájú mi gbogbo àgbà ẹ̀yà yín àti àwọn aláṣẹ yín, kí èmi lè sọ àwọn ọ̀rọ̀ wọ̀nyí sí etí ìgbọ́ ọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí mo mọ̀ pé lẹ́yìn ikú mi, ó dájú pé ìwọ yóò padà di ìbàjẹ́ pátápátá, ẹ ó sì yípadà kúrò ní ọ̀nà tí mo ti pàṣẹ fún un yín. Ní ọjọ́ tó ń bọ̀, ìpọ́njú yóò sọ̀kalẹ̀ sórí i yín nítorí ẹ̀yin yóò ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.29",
                "verseOrgIds": [
                  "DEU.31.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ẹ ó sì mú u bínú nípa ohun tí ọwọ́ yín ti ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orin Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì ka ọ̀rọ̀ inú orin yìí láti ìbẹ̀rẹ̀ títí dé òpin sí etí ìgbọ́ ọ gbogbo ìjọ Israẹli:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
            "verseOrgIds": [
              "DEU.31.30"
            ]
          }
        }
      ]
    }
  ],
