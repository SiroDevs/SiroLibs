  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "DEU 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àlàáfíà lẹ́yìn ìyípadà sí Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo ìbùkún àti ègún wọ̀nyí tí mo ti gbé kalẹ̀ síwájú u yín bá wá sórí i yín àti tí o bá mú wọn sí àyà rẹ níbikíbi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.1",
                "verseOrgIds": [
                  "DEU.30.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ bá tú ọ ká sí láàrín àwọn orílẹ̀-èdè,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti nígbà tí ìwọ àti àwọn ọmọ rẹ bá yípadà sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.2",
                "verseOrgIds": [
                  "DEU.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ tí o sì gbọ́rọ̀ sí pẹ̀lú gbogbo àyà rẹ àti gbogbo ọkàn rẹ gẹ́gẹ́ bí gbogbo ohun tí mo ti paláṣẹ fún un yín lónìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.3",
                "verseOrgIds": [
                  "DEU.30.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò mú ohun ìní rẹ bọ̀ sípò yóò sì ṣàánú fún ọ, yóò sì tún ṣà yín jọ láti gbogbo orílẹ̀-èdè níbi tí ó ti fọ́n yín ká sí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé ó ti lé ẹni rẹ kan sí ilẹ̀ tí ó jìnnà jù lábẹ́ ọ̀run, láti ibẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.4",
                "verseOrgIds": [
                  "DEU.30.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò ṣà yín jọ yóò sì tún mú u yín padà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò mú ọ wá sí ilẹ̀ tí ó jẹ́ ti àwọn baba yín, ìwọ yóò sì mú ìní níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.5",
                "verseOrgIds": [
                  "DEU.30.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò mú ọ wà ní àlàáfíà kíkún, yóò mú ọ pọ̀ sí i ju àwọn baba yín lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.6",
                "verseOrgIds": [
                  "DEU.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò kọ ọkàn rẹ ní ilà àti ọkàn àwọn ọmọ yín, nítorí kí o lè fẹ́ ẹ pẹ̀lú gbogbo àyà rẹ pẹ̀lú gbogbo ọkàn rẹ, àti ayé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.7",
                "verseOrgIds": [
                  "DEU.30.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò mú gbogbo ègún yín wá sórí àwọn ọ̀tá à rẹ tí wọ́n kórìíra àti tí wọ́n ṣe inúnibíni rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò tún gbọ́rọ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.8",
                "verseOrgIds": [
                  "DEU.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "àti tẹ̀lé gbogbo àṣẹ rẹ̀ tí mò ń fún ọ lónìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.9",
                "verseOrgIds": [
                  "DEU.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò mú ọ ṣe rere nínú gbogbo iṣẹ́ ọwọ́ ọ̀ rẹ, àti nínú gbogbo ọmọ inú rẹ, agbo ẹran ọ̀sìn rẹ àti èso ilẹ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.9",
                "verseOrgIds": [
                  "DEU.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò tún mú inú dídùn sínú rẹ yóò sì mú ọ ṣe déédé, gẹ́gẹ́ bí ó ti fi inú dídùn sínú àwọn baba rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o bá gbọ́ ti",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.10",
                "verseOrgIds": [
                  "DEU.30.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ tí o sì pa òfin rẹ̀ mọ́ àti àṣẹ tí a kọ sínú ìwé òfin yìí kí o sì yípadà sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.10",
                "verseOrgIds": [
                  "DEU.30.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ pẹ̀lú gbogbo àyà rẹ àti pẹ̀lú gbogbo ọkàn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìfifún ìyè tàbí ikú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àṣẹ yìí tí mo pa fún ọ lónìí, kò ṣòro jù fún ọ, bẹ́ẹ̀ ni kò kọjá agbára rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ní ọ̀run, tí ìwọ kò bá fi wí pé, \"Ta ni yóò gòkè lọ sí ọ̀run fún wa, tí yóò sì mú wa fún wa, kí àwa lè gbọ́, kí a sì le ṣe é?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kò sí ní ìhà kejì Òkun, tí ìwọ ìbá fi wí pé, \"Ta ni yóò rékọjá òkun lọ fún wa, tí yóò sì mú un wá fún wa, kí àwa lè gbọ́ ọ, kí a si le ṣe é?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kì í ṣe bẹ́ẹ̀, ọ̀rọ̀ náà súnmọ́ tòsí rẹ, ó wà ní ẹnu rẹ àti ní ọkàn rẹ kí ìwọ lè máa ṣe é.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò ó mo gbé kalẹ̀ síwájú u yín lónìí, ìyè àti àlàáfíà, ikú àti ìparun.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní èyí tí mo pàṣẹ fún ọ ní òní láti máa fẹ́",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.16",
                "verseOrgIds": [
                  "DEU.30.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ, láti máa rìn ní ọ̀nà rẹ̀ àti láti máa pa àṣẹ rẹ̀, àti ìlànà rẹ̀, àti ìdájọ́ rẹ̀ mọ́, kí ìwọ kí ó lè yè, kí ó sì máa bí sí i, kí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.16",
                "verseOrgIds": [
                  "DEU.30.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run lè bù si fún ọ ní ilẹ̀ náà, ní ibi tí ìwọ ń lọ láti gbà á.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        }
      ]
    },
