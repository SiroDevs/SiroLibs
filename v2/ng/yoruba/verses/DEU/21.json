  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "DEU 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdáríjì ìpànìyàn láìnítumọ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí a bá rí ọkùnrin tí a pa, ní ìdùbúlẹ̀ ní pápá nínú ilẹ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.21.1",
                "verseOrgIds": [
                  "DEU.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ń fún ọ láti jogún, tí a kò sì mọ ẹni tí ó pa á,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn àgbàgbà yín yóò jáde lọ láti wọn jíjìnnà ibi òkú sí ìlú tí ó wà nítòsí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn àgbàgbà ìlú tí ó wà nítòsí òkú yóò mú ẹgbọrọ abo màlúù tí kò ì ṣiṣẹ́ rí àti tí kò sì fà nínú àjàgà rí,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí àwọn àgbàgbà ìlú náà kí wọn mú ẹgbọrọ abo màlúù náà sọ̀kalẹ̀ wá sí àfonífojì tí ó ní omi ṣíṣàn kan, tí a kò ro, tí a kò sì gbìn, kí wọn kí ó sì ṣẹ́ ọrùn ẹgbọrọ màlúù náà níbẹ̀ ní àfonífojì náà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà, ọmọ Lefi yóò wá síwájú, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.21.5",
                "verseOrgIds": [
                  "DEU.21.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ti yàn wọ́n láti ṣe ìránṣẹ́ fún un àti láti bùkún ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.21.5",
                "verseOrgIds": [
                  "DEU.21.5"
                ]
              }
            }
          ]
        },
        {
          "text": "àti láti parí gbogbo ẹjọ́ àríyànjiyàn àti ọ̀rọ̀ ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni gbogbo àwọn àgbàgbà ìlú tí ó wà nítòsí yóò wẹ ọwọ́ wọn lórí ẹgbọrọ abo màlúù tí a ti kan ọrùn rẹ̀ ní àfonífojì,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọn yóò sì sọ pé, \"Ọwọ́ wa kò ta ẹ̀jẹ̀ yìí sílẹ̀, tàbí kí ojú wa rí i ní títa sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
            "verseOrgIds": [
              "DEU.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dáríjì,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.21.8",
                "verseOrgIds": [
                  "DEU.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", àwọn ènìyàn rẹ ni Israẹli, tí ìwọ ti dá sílẹ̀, àti kí ìwọ má ṣe gba ẹ̀bi ẹ̀jẹ̀ aláìṣẹ̀ ní àárín àwọn ènìyàn rẹ ní Israẹli. Ṣùgbọ́n kí a dárí ẹ̀bi ẹ̀ṣẹ̀ yìí jì.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìwọ wẹ̀ kúrò láàrín rẹ ẹ̀bi títa ẹ̀jẹ̀ aláìṣẹ̀ sílẹ̀, níwọ̀n ìgbà tí o ti ṣe èyí tí ó tọ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.21.9",
                "verseOrgIds": [
                  "DEU.21.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fífẹ́ obìnrin ìgbèkùn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí o bá lọ sí ogun sí àwọn ọ̀tá rẹ tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.21.10",
                "verseOrgIds": [
                  "DEU.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ sì fi wọ́n lé ọ lọ́wọ́ tí o sì mú àwọn ìgbèkùn,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí o sì rí obìnrin tí ó dára lára àwọn ìgbèkùn, tí o sì ní ìfẹ́ sí i, o lè mu u gẹ́gẹ́ bí aya à rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.11",
            "verseOrgIds": [
              "DEU.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú u wá sí ilé e rẹ kí o sì jẹ́ kí ó fá irun orí rẹ̀, gé èékánná an rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí o sì mú aṣọ tí ó wọ̀ nígbà tí ó di ìgbèkùn sí ẹ̀gbẹ́ kan. Lẹ́yìn ìgbà tí ó ti ń gbé ilé rẹ tí ó sì ti ṣọ̀fọ̀ baba àti ìyá rẹ̀ fún odidi oṣù kan, nígbà náà ni o lè tọ̀ ọ́ lọ kí o sì ṣe ọkọ rẹ̀ kí ó jẹ́ aya rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí inú rẹ̀ kò bá sì dùn sí i, jẹ́ kí ó lọ sí ibikíbi tí ó bá fẹ́. O kò gbọdọ̀ tà á tàbí lò ó bí ẹrú, lẹ́yìn ìgbà tí o ti dójútì í.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀tọ́ àkọ́bí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin kan bá ní ìyàwó méjì, tí ó sì fẹ́ ọ̀kan ṣùgbọ́n tí kò fẹ́ èkejì, tí àwọn méjèèjì sì bí àwọn ọmọkùnrin fún un ṣùgbọ́n tí àkọ́bí jẹ́ ọmọ ìyàwó rẹ̀ tí kò fẹ́ràn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó bá ń pín ohun ìní rẹ̀ fún àwọn ọmọ rẹ̀, kò gbọdọ̀ fi ẹ̀tọ́ àkọ́bí fún ọmọ ìyàwó tí kò fẹ́ràn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ní láti fi ipò ọmọ ìyàwó rẹ̀ tí kò fẹ́ràn fun un gẹ́gẹ́ bí àkọ́bí i rẹ̀ nípa fífún un ní ìlọ́po ìpín gbogbo ohun tí ó ní. Ọmọ yẹn ni àmì àkọ́kọ́ agbára baba rẹ̀. Ẹ̀tọ́ àkọ́bí jẹ́ tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlọ̀tẹ̀ ọmọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọkùnrin kan bá ní aláìgbọ́ràn tàbí ọlọ̀tẹ̀ ọmọ tí kò gbọ́rọ̀ sí baba àti ìyá rẹ̀ tí kò sì ní í gbà tí wọ́n bá ń bá a wí,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "baba àti ìyá rẹ̀ yóò gbá a mú, wọn yóò mu wá fún àwọn àgbàgbà ní ẹnu-bodè ìlú u rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì wí fún àwọn àgbàgbà pé, \"Ọmọ wa yìí jẹ́ aláìgbọ́ràn àti ọlọ̀tẹ̀. Kò ní gbọ́rọ̀ sí wa lẹ́nu. Ọ̀jẹun àti ọ̀mùtípara ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni gbogbo ọkùnrin ìlú rẹ̀ yóò sọ ọ́ ní òkúta pa. Ìwọ yóò sì mú ìwà ibi kúrò láàrín yín, gbogbo Israẹli yóò gbọ́, ẹ̀rù yóò sì bà wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        }
