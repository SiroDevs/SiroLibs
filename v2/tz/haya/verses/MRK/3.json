          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena akora ekyo Tata alikwenda n'iwe murumuna wange, n'iwe munyanyazi, n'iwe mawe.”",
          "type": "text",
          "attrs": {
