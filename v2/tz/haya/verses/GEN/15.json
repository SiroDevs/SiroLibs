{
  "id": "GEN.15",
  "number": "15",
  "bookId": "GEN",
  "reference": "Embandizo 15",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "GEN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo kabyahoire, Omukama agambira Aburamu omu kubonekerwa ati, “Aburamu otatina, inye ndi ngabo yawe; emperwa yawe eliba nyingi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Aburamu amubaza ati, “Waitu Mukama Ruhanga orantungaki? Kuba naikara ntaina mwana, omusika omwange ni Elieza owa Damasiko.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.2",
            "verseOrgIds": [
              "GEN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati, “Tiwantungire ruzaro. Omusika wange mwiru ayazaliirwe omwange.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.3",
            "verseOrgIds": [
              "GEN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Omukama amugambira ati, “Ogu talikusikira. Mutabani wawe ow'oyezaliire niwe aliba musika wawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuturukya aheru amugambira ati, “Raramira eiguru, obare enyanyinyi k'oraba noshobora kuzibara.” Amara amugambira ati, “Nikwo na baijukuru bawe baliba bangi batyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.5",
            "verseOrgIds": [
              "GEN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu ayesiga Omukama. Omukama nawe ashemelerwa Aburamu, amusiima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi amugambira ati, “N'inye Omukama ayakwihire Uri ey'Abakalidayo, ensi egi kugikuha obutaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Aburamu amubaza ati, “Waitu Mukama Ruhanga, ndamanya ntai okwo ndigitwara?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga amugambira ati, “Ndetera enyana y'emyaka eshatu, emburabuzi y'emyaka eshatu, empaya y'entaama y'emyaka eshatu, ekiba n'entungurumaiba nto.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi byona abimuletera. Ruhanga abyasamu kabili, buli rubaju arubyamika arulebeshainyie n'orundi, kyonkai ebinyonyi tiyabyasize kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo ebihungu byatonyire aha mitumbi, Aburamu abibinga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'eizoba lyatobeire Aburamu akwatwa oturo tw'amani n'obutini bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Omukama amugambira ati, “Omanyire kimoi okwo baijukuru bawe balifurukira omu nsi etali yabo, mara baliba bairu, kandi baligingizibwa emyaka bikumi binai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe eihanga lilibahindura bairu ndilibonabonyia. Ahanyuma orwo baliruga omu nsi egyo balija n'eitunga lingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iwe wenene olifa omu milembe, olizikwa orujwi rwasindikire orundi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru bawe ab'omuzarwa gwa kanai nibo baligaruka munu, enshonga Abaamori tinkababingiremu, orwo batakafakaire muno nkagoba aha kubabonabonyia.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizoba kalyabaire lyatobeire n'omwilima gwakwasire, leba orushwa rulikuchunka omwika, n'orumuli rulikurabagira bija biraba omugati y'ebichweka ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kir'ekyo Omukama akora endagano na Aburamu nagamba ati, “Baijukuru bawe ndibaha ensi egi kwema aha Mwiga gwa Misiri kuhika aha Mwiga oguhango ogwa Efurati, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ensi y'Abakeni, Abakenizi, Abakadamoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.19",
            "verseOrgIds": [
              "GEN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahiti, Abaperizi, Abarefai, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.20",
            "verseOrgIds": [
              "GEN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamori, Abakanaani, Abagirigashi n'Abayebusi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.21",
            "verseOrgIds": [
              "GEN.15.21"
            ]
          }
        }
      ]
    }
  ],
