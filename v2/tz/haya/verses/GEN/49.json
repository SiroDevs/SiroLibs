              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi zona nizo nganda ikumi na ibili za Isiraeli; mara ebyo nibyo ishebo yabagambire orwo yabaire nabaha omugisha; buli omoi namuha omugisha ogumusaine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
