              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ayeta abatabani agamba ati, “Muhikane mbagambaire ebilibaho ebiro ebilija:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
