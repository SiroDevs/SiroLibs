  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "GEN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga aha Noa n'abatabani omugisha, abagambira ati, “Muzarangane, mukanye, mwijuze ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli nyamaishwa, na buli kinyonyi, na buli kimoi ekyekurura, n'enfuru zona, nabibaha; bibatine, bibahulire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kyekurura ekina oburora, kibe kyakulya kyanyu; nk'okwo nabahaire ebimera, nimbaha buli kantu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiliho, otalilya nyama einamu burora, nikwo kugir'oti ekyaina bwamba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alita omuntu ndimwehora. Enyamaishwa elita omuntu ndigyehora, kandi n'alita omuntu mutahiwe ndimwehora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikaita omuntu alitwa omundi ondijo, kuba Ruhanga akatonda omuntu omu mishusireye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe muzare, mukanye omu nsi mugijure yona.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Ruhanga agambira Noa n'abatabani ati, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.8",
            "verseOrgIds": [
              "GEN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Leba nakora endagano na inywe na baijukuru banyu abalibahondera ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
              "GEN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na buli kirora kyona ekyo mwinakyo: Ebinyonyi, ebitunganwa na buli nyamaishwa na byona ebyarugire omu bwato. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninkora endagano yange na inywe okwo buli kyona ekina oburora kitalitwa mutunga rundi, kandi n'omutunga gwonene tiguligaruka mu nsi kugita.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba agamba ati, “Aka niko kabonero k'endagano eyo ndikukora na inywe na buli kirora kyona ekyo mwinakyo aha rw'emizarwa yona ey'eirai lyona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nata omuhangazima gwange omu bichwi, gurabaga kabonero k'endagano yange n'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo ndaletaga ebichwi eiguru n'omuhangazima gukaboneka omu bichwi ebyo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndaijukaga endagano yange na inywe, na buli kitondwa kyona ekina oburora. Talibaho mutunga gwa maizi na kake rundi kwita bitondwa ebina oburora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.15",
            "verseOrgIds": [
              "GEN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo omuhangazima gurabaga omu bichwi, ndagulebaga nyijuke endagano y'eirai lyona eyo nakora n'ebitondwa byona omu nsi ebina oburora.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.16",
            "verseOrgIds": [
              "GEN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amara agambira Noa ati, “Aka niko kabonero konakora n'ebitondwa byona omu nsi ebina oburora.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
            "verseOrgIds": [
              "GEN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
            "verseOrgIds": [
              "GEN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Noa abarugire omu bwato ni: Shemu, Hamu na Yafeti. Hamu niwe ishe Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.18",
            "verseOrgIds": [
              "GEN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bonshatu nibo batabani ba Noa, abatabukirweho abantu b'ensi yona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa niwe mulimi wa mbere. Akalima endimiro y'emizabibu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.20",
            "verseOrgIds": [
              "GEN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yanywa edivai yatamira, yabyama omw'ihemalye ali bushai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.21",
            "verseOrgIds": [
              "GEN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamu ishe Kanaani, abona okwo ishe ali bushai, akigambira abarumuna bombili aheru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.22",
            "verseOrgIds": [
              "GEN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Shemu na Yafeti bakwata ekijwaro, bakita aha mabega gabo, bagenza ekinyiainyiainyio, bashweka ishebo bamuteire enkinya, tibamulebire kwo ali bushai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Noa yatamurugukire akamanya eky'omutabani omuto yamukolera, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.24",
            "verseOrgIds": [
              "GEN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "agamba ati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.27",
            "verseOrgIds": [
              "GEN.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutunga kagwahoire Noa akashuba yarora emyaka endijo bikumi bishatu na makumi gatanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.28",
            "verseOrgIds": [
              "GEN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro bya Noa byona hamoi myaka rwendai na makumi gatanu; aho afa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.29",
            "verseOrgIds": [
              "GEN.9.29"
            ]
          }
        }
      ]
    }
  ],
