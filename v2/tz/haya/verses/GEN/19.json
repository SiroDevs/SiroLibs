      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamalaika bombili bagoba Sodoma bwaigoro; Loti akaba ashuntamire aha kihigi ky'ekigo. Loti orwo yababoine aimuka kubakiilira, abandama ainama obuso bukanga aha itaka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.1",
            "verseOrgIds": [
              "GEN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "agamba ati, “Bakama bange, nimbatagiliza murabe omw'omwiru wanyu, munabe amaguru, muraremu, mwije mwimuke karai mugendelere n'orugendo rwanyu.” Bagamba bati, “Chei, turarara aheru.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Loti abazigilira n'amani, aho bataha omwe, abakolera obugenyi. Achumba omukate ogutainamu itumbyo, balya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.3",
            "verseOrgIds": [
              "GEN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai kababaire batakabyamire, abanyakigo bona, abantu ba Sodoma, abato n'abakuru, baruga embaju zona, bazingora enju; taliho yasigaireyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.4",
            "verseOrgIds": [
              "GEN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beta Loti, bamubaza bati, “Abashaija abaija omwawe omu kiro balihai? Batuletere aheru tubamanye.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.5",
            "verseOrgIds": [
              "GEN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti aturuka nagaruramu orwigi, agenda ayolekeire ekihigi nabatahamu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.6",
            "verseOrgIds": [
              "GEN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "agamba ati, “Barumuna bange nimbatagiliza mutakora kubi mutyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.7",
            "verseOrgIds": [
              "GEN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leba, nyina bahara bange babili abatakamanyire mushaija, kambabaletere aheru mubakore okwo murayenda, ekiliho abashaija aba mutabakora kyona kyona aha rw'okuba bashura omwange.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.8",
            "verseOrgIds": [
              "GEN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai abanyakigo bagamba bati, “Rugamu kuli.” Bashuba bati, “Omushaija ogu akaija ali mufuruki, mbwenu nayenda kwekora muramuzi! Mbwenu turakukora kubi kushaga bonene.” Aho bamiga muno Loti baralira n'agahenda orwigi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.9",
            "verseOrgIds": [
              "GEN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai abagenyi ba Loti baturukya emikono, bamutahya omu nju, bakinga orwigi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.10",
            "verseOrgIds": [
              "GEN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bahumisa amaisho g'abantu boa ababaire bali aheru aha rwigi, abajege n'abahango, bahigahiga orwigi balemesibwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho abashaija ababili babaza Loti bati, “Oina ow'oinawe wena wena munu? Abakoi, batabani bawe, bahara bawe anga ow'oinawe wea wea omu kigo, obashohoze obaihye omu kigo omu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.12",
            "verseOrgIds": [
              "GEN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'okuba tuli haihi kukisilikya, aha rw'enshonga orujojobo aha bantu bakyo rwakanya omu maisho g'Omukama, mara Omukama yatutweka kukisilikya.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Loti kushohora akagambira abakoi, ababaire nibaija kushwera abahara ati, “Imuka, mushohore muruge munu; aha rw'okuba Omukama ali haihi kusilikya ekigo.” Kyonkai abakoi baboneka oti nabashanzira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwire kabwakeire abamalaika bakaka Loti nibagamba bati, “Imuka otware mukazi wawe na bahara bawe bombili abali aha, otaija okasilikirana omu kibonabonyio ky'ekigo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.15",
            "verseOrgIds": [
              "GEN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai wenene azengelera. Aho bamukwata omukono, wene na mukaziwe n'abahara bombili, aha rw'Omukama kumuganyira. Bamuturukya bamutwara enjai y'ekigo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo babaire babaturukize bagamba bati, “Iruka ohunge, otaleba nyuma kandi otayemelera hona hona mu ruhanga. Irukira omu mabanga otaija okasilika.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.17",
            "verseOrgIds": [
              "GEN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti abagambira ati, “Waitu chei, bakama bange. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.18",
            "verseOrgIds": [
              "GEN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwiru wanyu mwamusingira mwamukolera eky'amani mwamukiza. Kyonkai tinakwirukira mu mabanga, akabi kataija kakanshangayo nkagwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea, Ekigo kike kilinya nimukibona? Kili haihi bwoli. Kike, kambe nimwo mpungira, mara aho ndarokoka!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama amuhorora ati, “Nikwo n'aha nakwikiliza. Ekigo kike ekyo wagamba tinkisilikye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanguha obe niyo ohungira; aha rw'okuba tinshobora kukora kantu kuhika orwo oragobayo.” Enshonga ekigo ekyo Loti akagamba okwo kili kike, nikyo bakyeteire Zoari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizoba likaba lyashabukire aha iguru orwo Loti yagobire Zoari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Omukama ayema omw'iguru asheshera Sodoma na Gomora obuganga n'omuliro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asosotora ebigo bilinya n'oruhanga rwona n'abatuzi b'ebigo ebyo n'ebyabaire bimezire aha itaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai muka Loti akaba ali enyuma ya mushaijawe, akebuka, ahinduka nyomyo y'omwonyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu agenda bwankya karai mbali yabaire ayemeleire omu maisho g'Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleba obugyaifo, niyo Sodoma na Gomora n'oruhanga rwona, abona ensi nechunka omwika nk'ekikomi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo byabaire bityo orwo Ruhanga yasosotoire ebigo by'omu ruhanga. Ruhanga aijuka Aburahamu, aihya Loti omu kibundo, orwo yasosotoire ebigo ebyo yaturagamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Loti aruga Zoari, atura omu mabanga omu mpako hamoi n'abahara bombili, ahakuba akaba natina kutura Zoari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzigaijo agambira omuto ati, “Tataichwe mugurusi, n'omu nsi talimu mushaija wa kugenda na ichwe nk'okwo emigilire y'ensi yona eli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ija tumunyoise edivai mara tubyame nawe, tushobore kumuzaraho abaana.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho balenga omu kiro omwo banyoisa ishebo edivai. Omuzigaijo atahamu abyama na ishe. Loti tiyamumanyire mibyamireye anga mimukireye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeire omuzigaijo agambira omuto ati, “Omu kiro mbyamire na tata, mbwenu na kir'eki tushube tumunyoise edivai, aho otahemu obyame nawe tumuzareho abaana.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho omu kiro ekyo bashuba bamunyoisa edivai; omuto aimuka abyama nawe; Loti tiyamumanyire mibyamireye anga mimukireye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Loti kutweka abahara bombili enda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzigaijo azara omwana w'obwojo, eibara amweta Moabu; niwe ishenkuru Abamoabu kugoba kir'eki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omuto azara omwana w'omwojo, eibara amweta Benami, niwe ishenkuru Abaamoni kugoba kir'eki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    }
