  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "GEN 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka ebili yona kayabaire yahingwire, Farao arota ayemeleire aha Mwiga gwa Naili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.1",
            "verseOrgIds": [
              "GEN.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abona ente mushanju zirungi mara zigomokire, niziruga omuli Naili, zilya ebibimbili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.2",
            "verseOrgIds": [
              "GEN.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ashuba abona ente ezindi mushanju zitebire zihoire aha magufa, ziruga omuli Naili zizemeleraho aha rukunguru rw'omwiga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.3",
            "verseOrgIds": [
              "GEN.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente ezitebire zihoire aha magufa ziliira kimoi omushanju ezirungi ezigomokire. Aho Farao aita eisisimuka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.4",
            "verseOrgIds": [
              "GEN.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba anagira, arota omurundi gwa kabili. Abona ebikumba mushanju bihulingiliire mara birungi bimezire aha kiti kimoi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.5",
            "verseOrgIds": [
              "GEN.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba abona ebikumba mushanju, bitutura bishoroimire, bihotoirwe omuyaga gw'eirungu ly'oburugaizoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.6",
            "verseOrgIds": [
              "GEN.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikumba ebishoroimire bimilira kimoi ebikumba mushanju ebihulingiliire mara ebijwire enjuma. Farao aita eisisimuka, abona okwo yaba ali omu kiroto. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.7",
            "verseOrgIds": [
              "GEN.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho bwankya ahwahwana omwoyo; ayeta abafumu bona ba Misiri n'abamanyi bayo bona, abarotorolera ekirotokye, kyonkai tiyazokire muntu wa kushobora kukimwitoitorolera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma omukwasi mukuru w'enkorogo amugambira ati, “Kir'eki naijuka okwo nashobize. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.9",
            "verseOrgIds": [
              "GEN.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Farao yabaire anigaliire abairube, inye n'omuyondo mukuru w'emikate akatufunga jela omw'omukuru w'abalinzi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.10",
            "verseOrgIds": [
              "GEN.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "tukarota omu kiro kimoi, inye na wenene. Buli omoi aina ekiroto ekye n'enshonga yakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.11",
            "verseOrgIds": [
              "GEN.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukaba twinamu omusigazi Omuheburania, ali mwiru w'omukuru w'abalinzi. Katwamugambire atwitoitorolera ebiroto byaitu; aitoitorolera buli muntu kuhonderana n'ekirotokye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.12",
            "verseOrgIds": [
              "GEN.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara okwo yatwitoitoroleire nikwo byabaire. Inye bakangarura aha muruka gwange, omuyondo w'emikate bamuhanika.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Farao atumaho Yozefu, bamwihya jela bwangu bwangu. Kayabaire yamoisize yahindwire n'emyendoye, aija omu mabona ga Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.14",
            "verseOrgIds": [
              "GEN.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao amugambira ati, “Ndosire, mara taliho n'omoi ayakukitoitora. Inye nahulira nibakugamba ngu k'ohulira ekiroto oshobora kukitoitora.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.15",
            "verseOrgIds": [
              "GEN.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yozefu amuhorora ati, “Waitu inye tindikushobora, shana Ruhanga niwe arashobora kukikwitoitorolerage.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.16",
            "verseOrgIds": [
              "GEN.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Farao amugambira ati, “Ndosire nyemeleire aha rukunguru rwa Naili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.17",
            "verseOrgIds": [
              "GEN.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente mushanju zirungi zigomokire ziruga omuli Naili zilya ebibimbili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.18",
            "verseOrgIds": [
              "GEN.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezindi mushanju zibi zija, mara zitebire muno zihoire aha magufa ezo ntakabonaga mu nsi ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.19",
            "verseOrgIds": [
              "GEN.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente ezo ezitebire zihoire aha magufa ziliira kimoi omushanju eza mbere ezigomokire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.20",
            "verseOrgIds": [
              "GEN.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai orwo zibaire zaziliire taliho yakumanyire okwo zazilya aha rw'okuba zibaire zihoire aha magufa nk'aha mbandizo. Aho nyita eisisimuka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.21",
            "verseOrgIds": [
              "GEN.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nshubire narota ebikumba mushanju bimezire aha kiti kimoi, birungi bijwire enjuma; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.22",
            "verseOrgIds": [
              "GEN.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebikumba ebindi mushanju bihotokire, bishoroimire, bihotoirwe omuyaga gw'eirungu ly'oburugaizoba, bitutura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.23",
            "verseOrgIds": [
              "GEN.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebishoroimire bimilira kimoi omushanju ebirungi. Ekiroto nakigambira abafumu, kyonkai taliho yashobora kukinshoborora.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yozefu agambira Farao ati, “Ekiroto kyawe rugaba, kili kimoi. Ruhanga yakushurulira ekyo alikwija kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.25",
            "verseOrgIds": [
              "GEN.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente mushanju ezirungi nizo myaka mushanju; n'ebikumba mushanju ebirungi niyo myaka mushanju, ekiroto kili kimoi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.26",
            "verseOrgIds": [
              "GEN.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente mushanju ezishoroimire, ezitebire zihoire aha magufa, ezizirugire enyuma niyo myaka mushanju, kandi ebikumba mushanju ebili bushai bihotoirwe omuyaga gw'eirungu ly'oburugaizoba, egyo myaka mushanju y'eifa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.27",
            "verseOrgIds": [
              "GEN.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kili nk'okwo nakugambira rugaba, Ruhanga yakwoleka ekyo alikwija kukora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.28",
            "verseOrgIds": [
              "GEN.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harabaho emyaka mushanju y'omwero gungi omu nsi yona ya Misiri; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.29",
            "verseOrgIds": [
              "GEN.41.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyonkai egyo erahonderwa emyaka mushanju y'eifa, n'omwero gwebeke omuli Misiri. Eifa lilimaraho ensi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.30",
            "verseOrgIds": [
              "GEN.41.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'omwero tigulimanyika mu nsi aha rw'enshonga y'eifa elyo elilihonderaho aha rw'okuba liliba lingi muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.31",
            "verseOrgIds": [
              "GEN.41.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okurota kabili kwa Farao nikwoleka okwo ekigambo ekyo kitairweho Ruhanga, mara naija kukigobesheleza bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu aha rw'ekyo rugaba, oronde omuntu enyegendeleza mara omugezi, omuhe kugelera ensi ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.33",
            "verseOrgIds": [
              "GEN.41.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oshube oteho abalebelezi omu nsi, mara okwate ekichweka kya katanu ky'ebirata nibyera omuli Misiri omu myaka egyo mushanju y'omwero. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.34",
            "verseOrgIds": [
              "GEN.41.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 41:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashombokye ebyakulya byona by'emyaka emirungi elikwija, babibiike omu bigo omu bushobora bwa Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.35",
            "verseOrgIds": [
              "GEN.41.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyakulya ekyo kiliba mpanika y'ensi omu myaka mushanju y'eifa elilitera Misiri, litaija likagisilikya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 41:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo eki kishemelera Farao n'abaramatabe bona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.37",
            "verseOrgIds": [
              "GEN.41.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 41:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababaza ati, “Twakuzora omuntu nk'ogu aina Mwoyo wa Ruhanga?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.38",
            "verseOrgIds": [
              "GEN.41.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 41:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho agambira Yozefu ati, “Orwo Ruhanga yakwoleka ebi byona, taliho n'omoi enyegendeleza mara omugezi nka iwe okw'oli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.39",
            "verseOrgIds": [
              "GEN.41.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 41:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe oragelera eka yange, n'abantu bange bona bakore nk'okwo orabaragira. Shana okuba mukama nikwo ndakushagyaho kwonkai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 41:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba amugambira ati, “Leba, nakuhindura mugelezi wa Misiri yona.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.41",
            "verseOrgIds": [
              "GEN.41.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 41:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aihya empetaye y'omuhuri aha mukono agiteka aha mukono gwa Yozefu, amujweka emyendo ya kitani nungi n'omukofu gw'ezahabu omu ngoto; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.42",
            "verseOrgIds": [
              "GEN.41.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 41:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "amukuubisa omu galiye eya kabili. Abamwebembeire bagenda nibagamba bati, “Muteke amajwi!” Nikwo yamuhindiwre mugelezi w'ensi yona ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.43",
            "verseOrgIds": [
              "GEN.41.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 41:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara amugambira ati, “Inye ndi Farao. Kyonkai iwe eky'otaikiliize taliho muntu araimukya mukono anga kuguru omuli Misiri yona.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.44",
            "verseOrgIds": [
              "GEN.41.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao ayeta Yozefu eibara Safenatipanea; kandi amusiigira Asenati muhara wa Potifera omukuhani wa Oni. Aho Yozefu agya kurambura ensi yona ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 41:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yozefu akaba aina emyaka makumi gashatu orwo yabandize kukolera Farao omukama wa Misiri. Aruga omu kikaare kya Farao agya kurambura ensi yona ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.46",
            "verseOrgIds": [
              "GEN.41.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 41:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu myaka mushanju y'omwero ensi ekeza muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.47",
            "verseOrgIds": [
              "GEN.41.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 41:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yozefu ashombokya ekyakulya kyona ky'emyaka mushanju orwo habaire haliho omwero omuli Misiri. Abika ebyakulya omu bigo. Buli kigo yakibikagamu ebyakulya ebyarugaga omu misiri eyabaga ekyataine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.48",
            "verseOrgIds": [
              "GEN.41.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabika emyaka nyingi muno nk'omushenye gw'enyanja alemwa alekera kugipima aha rw'okuba ekagoba aha kutapimwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 41:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka y'eifa etakagobire Yozefu akazara abaana b'abojo babili ahali mukaziwe Asenati muhara wa Potifera omukuhani wa Oni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.50",
            "verseOrgIds": [
              "GEN.41.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 41:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzigaijogwe akamweta Manase, nagamba ati, “Ruhanga anyebesize enaku zange zona n'ab'omwaitu bona.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.51",
            "verseOrgIds": [
              "GEN.41.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owa kabili akamweta Efuraimu, nagamba ati, “Ruhanga ampaire oruzaro omu nsi eyo naboneiremu enaku.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 41:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka mushanju y'omwero ogwabaireho omuli Misiri ehwa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 41:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'emyaka mushanju ey'eifa ebanza, nk'okwo Yozefu yabaire agambaire. Eifa likaba lili omu nsi zona, kyonkai Misiri ekaba eina ebyakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 41:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo eifa lyayemire kubi ensi yona ya Misiri, abantu batakira Farao kubaha ebyakulya. Farao agambira Abamisiri bona ati, “Mugende ahali Yozefu, ekyo arabagambira mukore.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.55",
            "verseOrgIds": [
              "GEN.41.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "GEN 41:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eifa libamba ensi yona, liba lingi muno omuli Misiri. Aho Yozefu akingura amahanika gona aguza Abamisiri ebyakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.56",
            "verseOrgIds": [
              "GEN.41.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "GEN 41:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara kandi ensi zona zaijaga Misiri ahali Yozefu kugura ebyakulya ebyo, enshonga eifa likaba lili lingi muno buli hantu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.57",
            "verseOrgIds": [
              "GEN.41.57"
            ]
          }
        }
      ]
    }
  ],
