          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau kayabaire aina emyaka makumi ganai, ashwera Yuditi muhara wa Beri Omuhiti, na Basemati muhara wa Eloni Omuhiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
