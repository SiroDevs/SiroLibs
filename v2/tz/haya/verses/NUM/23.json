{
  "id": "NUM.23",
  "number": "23",
  "bookId": "NUM",
  "reference": "Orubara 23",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "NUM 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu agambira Balaki ati, “Onyombekere aha ealutare mushanju, mara ompe enumi mushanju n'empaya z'entaama mushanju.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki akora okwo Balaamu yagamba. Buli ealutare bombili bagitambiraho enumi emoi n'empaya y'entaama emoi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu agambira Balaki ati, “Yemelera aha rubaju rw'ekitambo kyawe ekyokize, inye ngende, rundi Omukama yakwija kumbona. Ekyo aranyoleka kyona kyona ndakikugambira.” Aho atemba aha ibanga eiguru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu agya abonangana na Ruhanga amugambira ati, “Natekateka ealutare mushanju, buli emoi nagitambiraho enumi n'empaya y'entaama.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama atuma Balaamu ati, “Oshube ahali Balaki omugambire oti n'oti.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu agaruka ahali Balaki, amushanga ayemeleire aha rubaju rw'ekitambokye ekyokize hamoi n'abatwazi bona ba Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu wenene abanza kugamba ati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki abaza Balaamu ati, “Wankoleraki? Nkulesire kundaamira ababisha bange, mbwenu leba toina kyo wakora shana okubaha omugisha!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu amuhorora ati, “Inye nsige kugamba ebyo Omukama alikundagira kugamba?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki agambira Balaamu ati, “Ija tugende ahandi mbali orashobora kubabonera. Orabona abailiire haihi, tolikwija kubabona bona. Aho obe niho oyema kubandamira.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amutwara omu kangaratete ka Zofimu, aha mutwe gw'Eibanga lya Pisiga. Ayombekayo ealutare mushanju, buli emoi yagitambiraho enumi n'empaya y'entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu agambira Balaki ati, “Yemelera aha rubaju rw'ekitambo kyawe ekyokize, ngye kulinya mbonangane n'Omukama.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama abonangana na Balaamu, amugambira ebyo aragamba, ati, “Ogaruke ahali Balaki, oku obe nikwo omugambira.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu aija ahali Balaki, amushanga akyayemeleire aha kitambokye ekyokize, aina abatwazi ba Moabu. Balaki amubaza ati, “Omukama yakugambiraki?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Balaamu ahorora ati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki agambira Balaamu ati, “Orwo wayanga kubaraama, n'omugisha otagubaha n'akati!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Balaamu ahorora Balaki ati, “Tinkugambiire nti, ‘Byona ebyo Omukama aragamba nibyo ndaragirwa kukora?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki agambira Balaamu ati, “Mbwenu oije nkutware ahandi, rundi Ruhanga yakukunda oyemayo obandaamira.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo amutwara aha katwetwe k'Eibanga lya Peori elyolekeraine n'Eirungu lya Yeshimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu agambira Balaki ati, “Onyombekere hanu aha ealutare mushanju, mara ompe enumi mushanju n'empaya z'entaama mushanju.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki akora okwo Balaamu yagamba. Buli ealutare agitambiraho enumi n'empaya y'entaama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.30",
            "verseOrgIds": [
              "NUM.23.30"
            ]
          }
        }
      ]
    }
  ],
