        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abamerari nabo obabare kuhonderana n'amahiga gabo n'ebika byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obare kwema ab'emyaka 30 kugoba aha myaka buli omoi alikushobora kukora emilimo omw'Ihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eikora lyabo lyona hamoi omw'Ihema ly'Omuterano ni kushutura ebintu: Efuremu z'ekiikaro n'emihingo yakyo, enyomyo n'amaguru gazo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
