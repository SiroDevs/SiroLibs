  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "NUM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akagambira Musa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oheshe amakondere gabili g'efeza. Orata kugatera kuhuruza enteko, n'okubamanyisa kukambura orusisira bakagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo gombili garaterwa, Abaisiraeli bahurure bakugobe aha kishasi ky'Eihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai orwo lyaterwa eikondere limoi ely'okutatira, aho abebembezi, abakuru b'enganda za Isiraeli babe nibo bahurura bakakugoba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo oratera eikondere ly'okutatira, ensisira ezili obugwaizoba zibandure. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo oratera eikondere ly'okutatira omurundi gwa kabili, ensisira ezili kasi zibandure. Eikondere ly'okutatira literwe kubamanyisa kababandura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo eihanga lili ly'okuhurura, eikondere literwe kyonkai litaterwa ikondere lya okutatira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani batabani ba Aroni batere amakondere ago kibe kiragoro ky'ebiro byona ahali inywe, amakiro gona kutera amakondere. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamulirwana endashana omu nsi yanyu, kutera omubisha alikubema kubi, mutere enzamba kutatira abantu. Aho inye Omukama Ruhanga wanyu ndibajuna, mbakize aha babisha banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakwo n'omu mashemelerwa: Aha biro bikuru byanyu ebiragiirwe n'aha kwema kw'okwezi, mutere amakondere orwo mulikutamba ebihongo by'okwokibwa n'ebihongo by'emilembe. Ebyo bilinsindika kubajuna. Inye ndi Mukama Ruhanga wanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya makumi gabili omu mwezi gwa kabili, guli mwaka gwa kabili Abaisiraeli barugire Misiri, ekichwi kiimuka aha kiikaro ekyo Omukama yabaire asingiiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Abaisiraeli babanza kuruga mpora mpora omw'Irungu lya Sinai. Ekichwi kyemelera omw'Irungu lya Parani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo limukya lyabo lya mbere orwo Omukama yahangiire atyo Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebendera y'orusisira rw'oruganda rwa Yuda niyo yaimukize mbere nk'okwo emitwe yabo yabaire eli. Eihe lyabo likaba nilikulirwa Nashoni eya Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ly'oruganda rwa Isakari likaba nilikulirwa Netaneli eya Zuari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ly'oruganda rwa Zabuloni likaba nilikulirwa Eliabu eya Heloni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo bamazire kusimbura ekiikaro, Abagerishoni n'Abamerari abakyetwekaga baimukya orugendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ahonderwaho ebendera y'oruganda rwa Rubeni. Bakasimbura kuhonderana n'emitwe yabo. Eihe lyabo likaba nilikulirwa Elizuri eya Shedeuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.18",
            "verseOrgIds": [
              "NUM.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eihe ly'oruganda rwa Simeoni likaba nilikulirwa Shelumieli eya Zurishadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.19",
            "verseOrgIds": [
              "NUM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ely'oruganda rwa Gadi likaba nilikulirwa Eliasafu eya Deweli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho nirwo Abakohati bahondeireho, bashutwire ebintu ebitakatifu. Batakagobire, ekiikaro kikaba kyasimbirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebendera y'eihe ly'oruganda rwa Efuraimu eimukya kuhonderana n'emitwe yabo. Ayabaire nakulira eihe elyo ni Elishama eya Amihudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ly'oruganda rwa Manase likaba nilikulirwa Gamalieli eya Pedazuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ly'oruganda rwa Benjamini likaba nilikulirwa Abidani eya Gideoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma ahonderwaho eihe ly'oruganda rwa Dani. Eihe eli nilyo lyagendaga enyuma y'amahe agandi gona niligalinda. Likaba nilikulirwa Ahiezeri eya Amishadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ly'oruganda rwa Asheri likaba nilikulirwa Pagieli eya Okarani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihe ely'oruganda rwa Nafutali likaba nilikulirwa Ahira eya Enani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Abaisiraeli baimukyaga kugenda, emigendere yabo ekaba nebaho kuhonderana n'amahe gabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa agambira ishezara, Hobabu eya Reweli Omumidiani ati, “Nitwimukya kugenda omu nsi eyo Omukama yagambiire ati, ‘Ndigibaha.’ Mbwenu oije tugende hamoi; turakukolerage. Omukama akaraganisa Isiraeli ebirungi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Hobabu ashubamu Musa ati, “Chei, inye tindikwija kugyayo okwo. Ndagaruka owaitu omu banyaruganda bange.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
            "verseOrgIds": [
              "NUM.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa amugira ati, “Ninkutagiliza otatusigaho. Nomanya okwo tulikwija kugenda nitusisira omw'irungu; mbwenu iwe twakugenzire notulebelera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katuragenda hamoi naiwe, kyona kyona ekyo Omukama aratukolera, kyonene kyonene ekyo nikyo na ichwe turakolera iwe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Abaisiraeli baruga Sinai, bagenda orugendo rw'ebiro bishatu, bebembeirwe Esanduku y'Omukama y'Endagano, nibahiga ensi y'okuturamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli orwo bafururaga orusisira bwamushana bayebemberwaga ekichwi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli orwo Esanduku yaturukaga kugenda, Musa yagambaga ati, “Waitu Mukama osingire, imuka, ababisha behigire bugyo; abakunoba bairuke.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Esanduku yagyaga ahansi, agamba ati, “Waitu Mukama osingire, garukira embaga yawe enkuyanja ya Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        }
      ]
