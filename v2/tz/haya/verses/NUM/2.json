          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho Eihema ly'Omuterano libandure, kandi orusisira rw'Abalevita rwimukye nk'ensisira ezindi. Okwo balikusisira babe nikwo baimukya, buli rusisira omu mwanya gwarwo, nk'okwo ebendera zilikuhonderangana.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
