          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarasisira bataine Ahiezeri b'oruganda rwa Asheri. Omukuru w'oruganda abe Pagieli eya Okarani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
