            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akagambira Musa na Aroni ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaisiraeli bona basisiire mbali ebendera zabo zili, mara buli omoi abe aina akabonero k'orugandarwe. Hona mbali baraba bali basisiire balebire Eihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'okusisira rubaju orw'oburugaizoba, balebire mbali eizoba lishabukira, ni balinya abaina ebendera y'orusisira rw'oruganda rwa Yuda, nk'okwo emitwe yabo eli. Mukuru w'oruganda ni Nashoni eya Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihelye okwo libazirwe lina abantu 74,600. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Yuda batanwe ab'oruganda rwa Isakari. Mukuru wabo ni Netaneli eya Zuari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihelye okwo libazirwe lina abantu 54,400. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
            "verseOrgIds": [
              "NUM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Zabuloni bahondereho. Mukuru wabo ni Eliabu eya Heloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eihelye okwo libazirwe lina abantu 57,400. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubara rwona rw'abali omu rusisira rw'oruganda rwa Yuda, nk'okwo emitwe yabo eli, bantu 186,400. Omu kwimukya bate nibo baba nibebembera.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
      ]
    },
    {
