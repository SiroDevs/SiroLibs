      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akagambira Musa Omw'Irungu lya Sinai, omw'Ihema ly'Omuterano, aha kiro kya mbere ky'omwezi gwa kabili, omu mwaka gwa kabili kwema barugire Misiri, ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mubare eihanga lyona ly'Abaisiraeli kuhonderana n'enganda zabo n'ebika byabo. Mubare buli muntu ibaralye, araba ali mushaija wena; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwema aha myaka 20 kutemba, buli Mwisiraeli alikushobora kutabara. Iwe na Aroni mubabare nk'okwo amahe gabo gali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mweme n'omuntu omoi kuruga buli ruganda, mara abe ali mukuru w'oruganda orwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga nigo mabara g'abantu abo murayema nabo. Omu ruganda rwa Rubeni: Elizuri eya Shedeuri; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu ruganda rwa Simeoni: Shelumieli eya Zurishadai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.6",
            "verseOrgIds": [
              "NUM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu ruganda rwa Yuda: Nashoni eya Aminadabu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.7",
            "verseOrgIds": [
              "NUM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu ruganda rwa Isakari: Natanaeli eya Zuari; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.8",
            "verseOrgIds": [
              "NUM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu ruganda rwa Zabuloni: Eliabu eya Heloni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.9",
            "verseOrgIds": [
              "NUM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu ba Yozefu, omu ruganda rwa Efuraimu: Elishama eya Amihudi; n'omu rwa Manase: Gamalieli eya Pedazuri; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu rwa Benjamini: Abidani eya Gideoni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.11",
            "verseOrgIds": [
              "NUM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu rwa Dani: Ahiezeri eya Amishadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.12",
            "verseOrgIds": [
              "NUM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu rwa Asheri: Pagieli eya Okarani; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.13",
            "verseOrgIds": [
              "NUM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu rwa Gadi: Eliasafu eya Deweli; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.14",
            "verseOrgIds": [
              "NUM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omu rwa Nafutali: Ahira eya Enani.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo bakuru b'enganda za Isiraeli abaronzirwe omw'ihanga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        }
      ]
