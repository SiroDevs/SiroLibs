          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo babazirwe. Nibo Musa na Aroni babazire nibajunwa abebembezi ikumi na babili ba Isiraeli buli omoi omw'ibara ly'orugandarwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
