          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oruganda rwa Rubeni, omuzigaijo gwa Isiraeli, kuhonderana n'ebika byabo n'amahiga gabo buli muntu na ibara, kaishe mushaija kwema ow'emyaka 20 kutemba, bona ababaire nibashobora kutabara omu ndashana: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Rubeni bakaba bali 46,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
