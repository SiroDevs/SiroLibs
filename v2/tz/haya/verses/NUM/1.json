          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo orubara rwona rw'Abaisiraeli, kuhonderana n'enganda zabo, kwema aha myaka makumi gabili kutemba, buli mushaija ayabaire nashobora kutabara: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
