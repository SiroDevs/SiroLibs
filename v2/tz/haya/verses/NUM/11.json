{
  "id": "NUM.11",
  "number": "11",
  "bookId": "NUM",
  "reference": "Orubara 11",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NUM 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma abantu babanza kweboroboitera Omukama aha rw'amatangwa agabagwireho. K'Omukama yahuliire okwo bamweboroboitera yabanigalira muno. Nirwo yasindikire omuliro gukokya empelero z'orusisira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aho abantu bonene batakira Musa. Musa ashaba aha Mukama, omuliro gwarara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo omwanya ogwo gwayeteirwe Tabera aha rw'enshonga y'omuliro ogwarugire aha Mukama gukokya omu nsisira zabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Baisiraeli abo hakaba halimu abagendaga nabo, baija bagira orwoyoyo rungi muno orw'enyama. Abaisiraeli nabo babanza kushuba kujojoba nibagira bati, “Katwakuboine enyama tukagilya! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.4",
            "verseOrgIds": [
              "NUM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitwijuka enfuru ezo twalyaga bushai tuli Misiri, amatango, emyongo, emikubi elikushusha ebitunguru, ebitunguru byonene n'ebitungurusumu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.5",
            "verseOrgIds": [
              "NUM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe mbwenu amani gatuhwa, mara taliho kantu kona kona shana manu egi eyo tulebire kushai!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manu egyo yashushaga enjuma z'omugusha, kandi rubaju orundi eteleramu nk'oruzinga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bagendaga bagikumakuma bagisa aha mbengo anga bagitwanga omu bitwangiro. Bakaba nibagichumba omu nyungu nibagihamu ekeki. Eminulire yayo ekaba neshusha ekeki ezo batairemu amajuta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orume karwagwaga omu nsisira omu kiro, manu nayo eizirana n'orume orwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ahulira okwo abantu omu maka balikweboroboita, buli muntu ayemire aha Ihemalye aha mulyango najojoba. Aho Omukama anigara muno na Musa atamwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa abaza Omukama ati, “Waitu nk'omwiru wawe wamukora kubi? Kiki kutanganyira, kunsebeka embaga egi yona? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye abantu bona nkabazara? Nkabaihya Misiri k'oija kungambira oti, ‘Obakikire omu kifuba nk'okwo omulezi akikira enkelemeke kubatwara omu nsi eyo wanahilire baish'enkurubo okwo oligibaha bonene aba?’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.12",
            "verseOrgIds": [
              "NUM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye enyama y'okuha abantu aba bona ngihe nkahai. Aha rw'okuba nibanjojobera bati, ‘Otuhe enyama y'okulya.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.13",
            "verseOrgIds": [
              "NUM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindikushobora kutwara mbaga egi yona nyenkai, nensikilira muno. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.14",
            "verseOrgIds": [
              "NUM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'oraba noyenda kungira otyo, onyite aho n'aho, nawe k'oraba nonganyira, ntabona naku ezo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama ahorora Musa ati, “Onshombokeze abantu nshanju omu bakuru b'Abaisiraeli, ab'olikumanya okwo baina obukuru mara bebembezi omu mbaga. Obalete aha Ihema ly'Omuterano oyemelere nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye ndasongoka nfumore naiwe honene aho. Ndabaha obushobora nk'obwawe, baije bakukwase kutwara embaga, oleke kugitwara iwe wenkai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.17",
            "verseOrgIds": [
              "NUM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogambire abantu oti, ‘Mweyeze kuba nyenkya nimwija kulya enyama. Mweboroboisire Omukama yahulira.’ Mugizire muti, ‘N'ohai aratuha enyama tukalya? Orwo twabaire tuli Misiri tukaba tulige.’ ” Aha rw'ekyo Omukama naija kubaha enyama mulye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara timulikwija kugilya kiro kimoi anga bibili anga bitanu anga ikumi, nangu n'amakumi gabili, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.19",
            "verseOrgIds": [
              "NUM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "muragilya omwezi gwona, elemwe ebanukire kubi, ebatame. Manya n'inywe mushengire Omukama asingiire omuli inywe, mwamujojobera nimugira muti, “Ekyatwihire Misiri kiki?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa agamba ati, “Leba, nyina abantu elaki mukaga omu rugendo; washuba waitu wagamba oti, ‘Ndabaha enyama y'okulya omwezi gwona!’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.21",
            "verseOrgIds": [
              "NUM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenusi aho babaitire amahyo g'entaama n'ag'ente, enyama kwija kubamara? Anga babajubire enfuru zona omu nyanja, nizo zirabagoba?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama abahorora ati, “Obushobora obwange tibulengwa. Mbwenu orabona okwo ekyo nagamba kirabakwo anga chei.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Musa aruga omw'Ihema ly'Omuterano, agambira abantu ebyo Omukama yagamba. Ashombokya abantu 70 omu bakuru b'Abaisiraeli, abazingoza Eihema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Omukama asongoka omu kichwi afumora na Musa; amara aha abakuru abo nshanju obushobora nk'obwa Musa. Orwo bagizire obushobora babanza kuranga. Kyonkai bakaranga elyo lyonkai, tibagendeleire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu omu rusisira bhakaba hasigairwemu abantu babili: Elidadi na Medadi. Na bonene bagobwa obushobora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo omusigazi omoi kwiruka akagambira Musa ati, “Elidadi na Medadi bali omu rusisira nibaranga.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua eya Nuni, omuhwezi wa Musa, omoiho omu ndonkwaze, agira ati, “Rugaba rwange Musa, obatange.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Musa amubaza ati, “Wachuba, wabona bankira? Hakili nangu eihanga lyona ly'Omukama bakubaire barangi, hakabaha obushobora!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'abakuru bona b'Abaisiraeli bashuba omu nsisira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama asindika omuyaga, gwihya gwemire omu nyanja, guleta endahi, guzigobya bwatana aha nsisira, orugendo rw'ekiro kimoi kwema aha nsisira ezo buli bwolekera. Zonene zikaba niziharara nk'emita emoi kwema ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushana ogwa kir'ekyo gwona kukeisa n'obwire, n'ekiro ekyahondeireho kyona, abantu bagenda kukwata endahi ezo. Ayakwete zike akakwata ehomeri ikumi. Bamara kuzita bazanika buli hantu obuzingora bw'ensisira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo babaire babanza kukanjura, Omukama abanigalira, abateza ekibundo kihango muno. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo halinya haketwa Kiburoti Hatava",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:34",
              "type": "text"
            },
            {
              "text": "Hatava",
              "type": "text"
            },
            {
              "text": "Kiburoti Hatava, nyanga z'orwoyoyo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " orwo baziikiremu abantu abaisiibwe orwoyoyo rw'enyama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'abantu barugire Kiburoti Hatava bagya Hazeroti, niyo baikaire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
