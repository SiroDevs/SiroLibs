          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo mulikubiika mwakubiliira hona hona hamoi n'emitungo yanyu, kuba niyo mperwa yanyu aha rw'eikora lyanyu ly'omw'Ihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
