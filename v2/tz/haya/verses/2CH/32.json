              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu ebindi ebyo Hezekia yakozire, ebikorwabye ebirungi, bihandikirwe omu by'Omurangi Isaya eya Amozi yabonekeirwe, omu Kitabo ky'Abakama ba Yuda na Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
