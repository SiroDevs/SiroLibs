        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye Paulo omufungwa wa Yesu Kirisito ninturwa inywe, Banyamahanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindenga nti mwahuliire okwo ndi musigire w'ekisha kya Ruhanga aha bwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.2",
            "verseOrgIds": [
              "EPH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwo ekyebisho nakimanyiire omu kushurulirwa, nk'okwo nabandize kubahandikira omu bigambo bike. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamurashoma ebi muramanya emishobokelerwe eyo ndikushobokerwa ekyebisho kya Kirisito ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "eky'abantu batamanyisiibwe mu mizarwa endijo nk'okwo bir'ebi kishuruliirwe entumwaze ezitakatifu n'abarangi omu mani ga Mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.5",
            "verseOrgIds": [
              "EPH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo kugir'oti Abanyamahanga basika batahi baitu, ngingo z'omubili gwonene gwonene, kandi nabo aha rw'okurangirwa evangeli, ebyo Ruhanga yaragaine nibabitungwa omu mani ga Yesu Kirisito.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhondera amatungwa g'ekisha kya Ruhanga ekyo natungirwe omu mani g'obushoborabwe, leba nkahinduka murangi w'evangeli egi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.7",
            "verseOrgIds": [
              "EPH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'orwo omu bakirisito ndi muke kushaaga bona, nkatungwa omugisha ogu: Kurangira Abanyamahanga eitunga lya Kirisito elitalengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.8",
            "verseOrgIds": [
              "EPH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'okumanyisa abantu bona, bakashobokerwa ekyebisho ekyakashelekirwe akarai kona omuli Ruhanga ayatonzire ebintu byona. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.9",
            "verseOrgIds": [
              "EPH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara omu kaanya aka mbwenu, omw'ikora ly'enteko, abakuru n'abatwazi b'omw'iguru bashobore kumanya obumanyi bwa Ruhanga obw'engeli zingi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga akakora ekigambo ekyo kuhondera entegeka ya wenene ey'eirai lyona eyo agobesheleize omuli Yesu Kirisito Omukama waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.11",
            "verseOrgIds": [
              "EPH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo twamazire kujwangana na Kirisito aha rw'owikiliza twina obumanzi n'obwesige kugoba ahali Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.12",
            "verseOrgIds": [
              "EPH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo nimbashaba mutashuburugukwa aha rw'enshonga y'obushasi obwo ndikubona aha rwanyu; kanshashe mubone kugasirwa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyo nshonga nimbandama omu mabona ga Isheichwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.14",
            "verseOrgIds": [
              "EPH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "entabuko ya buli ka omw'iguru n'omu nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.15",
            "verseOrgIds": [
              "EPH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintaka ahali Ruhanga, nk'okwo ekitinwakye kili kingi, omu mani ga Mwoyo we asinge abatunge amagara omu myoyo yanyu mube manzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.16",
            "verseOrgIds": [
              "EPH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na Kirisito aikare asingiire omu mitima yanyu aha rw'okwesiga kwanyu. Alikasinga inye nimushaba mugire emizi mara mugume omu ngonzi ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.17",
            "verseOrgIds": [
              "EPH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mushobore kushobokerwa hamoi n'abakirisito abandi bona obukiika n'oburaiburai, n'obwemi n'oburaiburai bw'okuzimu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.18",
            "verseOrgIds": [
              "EPH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumanye n'engonzi za Kirisito ezishaaga obumanyi bwona, mushobore kwijurwa Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga omu bushoborabwe obulikukora omuli ichwe, alikushobora kukora buli kantu akashaaga ebyo tushaba n'ebyo tutekeleza, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahabwe ekitinwa omu nteeko n'omuli Yesu Kirisito amakiro gona, eirai lyona. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
  ],
