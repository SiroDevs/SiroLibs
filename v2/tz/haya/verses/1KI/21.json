            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama agambira Eliya owa Tishibi ati, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Waboine okwo Ahabu yanyetohyaho? Orwo yanyetohyaho aho omu makiroge tinteze kaye naku, shana omu makiro g'omutabani.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
