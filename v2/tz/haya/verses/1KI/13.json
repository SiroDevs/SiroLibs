          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'orwo byabaire bityo Yeroboamu tiyalekeire mizeye. Akazigilira, yaronda abakuhani abatali Balevita ab'okumanya obuju bw'amabanga. Ayakendaga kuba mukuhani amutendeka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigiro eki niyo ntambara eyasilikize eka ya Yeroboamu ekachweka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
