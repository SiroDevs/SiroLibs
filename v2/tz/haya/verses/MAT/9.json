          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kababaire nibarugayo bamuletera omutita akwetwe sitani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu kayamazire kubinga sitani ogwo, omutita agamba. Embaga etangara negamba eti, “Ekyab'eki tikikabonekaga muli Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Abafarisayo bagira bati, “Amasitani nagabingisa amani ga mukama wago.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        }
      ]
