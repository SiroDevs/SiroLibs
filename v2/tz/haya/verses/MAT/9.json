          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu araba omu bigo byona n'omu byaro nayegesa omu sinagogi zabo naranga evangeli y'obukama bw'omw'iguru, nakiza buli ndwara na buli bulema. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
