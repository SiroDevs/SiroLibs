          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yerusalemu, Yerusalemu! Iwe aita abarangi n'entumwa ezo bakutumaho okaziteza amabare! Mirundi nyingi etai eyo nakugondize iwe n'abaana bawe kubateka hamoi nk'okwo enkoko eteka hamoi obwana bwayo omu mapapa gaayo, kyonkai iwe tiwakukunda! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leba enju yawe yaba kifurukwa, yanuka omushaka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kankugambire amazima, tokimbona rundi kuhika orwo oligamba oti, ‘Ni kilimugisha ogwo alikwija omw'ibara ly'Omukama.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
            "verseOrgIds": [
              "MAT.23.39"
            ]
          }
        }
      ]
