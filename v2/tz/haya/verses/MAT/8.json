            "sid": "MAT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigo kyona kija kubonangana na Yesu. Kabamuboine bamutagiliza k'abarugira omu nsi yabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.34",
