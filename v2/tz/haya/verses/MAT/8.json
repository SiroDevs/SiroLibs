              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agagambira ati, “Mugende.” Gabarugamu gataha omu mpunu. Obuhyo bwona buligita buchulenguka aha bulengo bugwa omu nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashumba bairuka bataha omu kigo nibabarura buli kantu, babarura n'ebyabaire aha babaire bakwetwe amasitani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.33",
            "verseOrgIds": [
              "MAT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
