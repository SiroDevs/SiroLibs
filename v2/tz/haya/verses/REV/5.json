      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngya mbona abandaire aha nketo omu mukonogwe gwa bulyo akwete ekitabo kihandikire omunda, kimaamirwe emihuri mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona omumalaika w'amani nagamba n'eiraka lihango ati, “Nohai asaine kukingura ekitabo eki, akahenda n'emihuri yakyo mushanju?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taliho n'omoi mw'iguru anga mu nsi anga kuzimu ayashoboire kukingura kitabo ekyo nangu n'okukilebamu kwonkai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye aho ndira muno kubona hataliyo asaine kushurura kitabo ekyo nangu n'okukilebamu kwonkai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirwo omugurusi omoi yangambire ati, “Oleke kulira. Leba entare ya Yuda, Mwijukuru wa Daudi asingire endashana, kityo nashobora kushurura ekitabo ekyo n'okuhenda emihuri yakyo mushanju.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugati y'enketo n'ebitondwa binai eby'oburora n'omu bagurusi mbonamu Kataama ayemeleire, oti bamwisire, aina amahembe mushanju n'amaisho mushanju, nibo bamalaika mushanju ba Ruhanga abo atumire omu nsi yona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kataama ogwo agenda aihyaho ekitabo omu mukono gwa bulyo gw'ogwo abandaire aha nketo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayabaire yatwete ekitabo ekyo, ebitondwa binai eby'oburora n'abagurusi 24 babandamira Kataama, buli omoi akwete enanga n'epakuli z'ezahabu zijwire obunuma, obunuma obwo nizo nshara z'abakirisito; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bahoya oruhoya ruhya bati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    }
  ],
