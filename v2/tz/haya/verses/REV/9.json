{
  "id": "REV.9",
  "number": "9",
  "bookId": "REV",
  "reference": "Okushurulirwa 9",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "REV 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumalaika wa katanu atera enzamba. Mbona okwo enyanyinyi yaruga omw'iguru ekagwa ahansi. Aho bamuha orufunguruzo rw'ekina ekitaina bugarukiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akingura ekiina ekyo ekitaina bugarukiro, kirugwamu omwika nk'ogw'ekyokezo kihango. Omwika gwarugire omu kiina ekyo gubunda eanga n'eizoba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu mwika harugwamu enzige, zija omu nsi, ziina amani nk'obumiina. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzige ezo tizajubwirwe kulya bunyasi, anga ekimera kyona kyona, anga omuti gwona gwona, shana zikajuburwa kulya abantu abashangirwe bataina mihuri ya Ruhanga aha buso. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.4",
            "verseOrgIds": [
              "REV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzige ezo zijuburwa kubashasa muno omwanya gw'emyezi etanu. Zibashasa nk'obumiina kyonkai tizajubwirwe kubaita, shana okubatera embuli kushai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.5",
            "verseOrgIds": [
              "REV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo abantu barahiiga orufu kyonkai tibarubone. Barayegomba kufa, orufu rubairuke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzige ezo emishusire yazo zikaba nizishusha efarasi ezitekatekeirwe endashana. Aha mitwe zikaba nizishusha oti ziinaho enkinga z'ezahabu. Aha maisho zikaba nizishusha abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwoya bwazo oti ishoke ly'abakazi, amaino gazo oti maino g'entare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bifuba zikaba ziina engabo nk'ez'ekyoma, amapapa gazo okuhilira wakumanyire magali agali gangi agalikusikwa efarasi ziligisire zigiire omu ndashana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikaba ziina emikira nk'ey'obumiina, zagira embuli, obushagwa bwazo obwo zahutaize abantu emyezi etanu bukaba buli omu mikira yazo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumalaika ayarugire omu kiina kitaina bugarukiro n'iwe yabaire ali mukama wazo. Omu Ruyahudi nayetwa Abadoni, kandi omu Rugiriki nayetwa Apolioni: Nikwo kugamba: Omusiliikya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibonabonyio ekya mbere kyahingura. Ebindi bibili bikyahonderaho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho omumalaika wa mukaaga atera enzamba. Mpulira eiraka niliruga aha mahembe agana aga alutare y'ezahabu omu mabona ga Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
            "verseOrgIds": [
              "REV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "niligambira omumalaika ogu ayabaire aina enzamba liti, “Abamalaika abana ababohirwe aha Mwiga Guhango ogwa Efurati obataishure.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo abamalaika abanai bataishurwa. Abamalaika abo bakaba batekatekeirwe esaa, ekiro, omwezi n'omwaka mbali baraitira etheluti y'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubara rw'ab'efarasi bakaba bali 200,000,000. Orubara rwabo orwo nkaruhulira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo mibonere eyo naboine efarasi omu kubonekerwa kwange. Ab'efarasi omu bifuba bakaba bajwete engabo z'ekyoma ezilikushusha omuliro n'omurutu n'obuganga. Emitwe y'efarasi ekaba neshusha emitwe y'entare, omukanwa nizirugwamu omuliro, omwika n'obuganga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.17",
            "verseOrgIds": [
              "REV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibundo ebi byonshatu bikaita etheluti y'abantu bona. Bakaitwa omuliro n'omwika n'obuganga ebyarugaga omu kanwa k'efarasi ezo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.18",
            "verseOrgIds": [
              "REV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amani g'efarasi kanwa kazo n'emikira yazo. Emikira yazo emishusire njoka, mara emikira egyo eina emitwe, kandi emitwe egyo niyo zilikurumisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.19",
            "verseOrgIds": [
              "REV.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.19",
            "verseOrgIds": [
              "REV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abandi abahonokire aha bibundo ebi tibayechulize bishushani ebyo bakozire. Bagendelera kufukamira amasitani n'ebihuuku by'ezahabu, n'eby'efeza, n'eby'omulinga, n'eby'amabare, n'eby'ebiti ebitabona anga kuhulira anga kutambuka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu n'okwita okwo baitaga abantu, okuroga okwo barogaga, n'obusiyani n'obushuma, byona ebi taliho kyobayechulize.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.21",
            "verseOrgIds": [
              "REV.9.21"
            ]
          }
        }
      ]
    }
  ],
