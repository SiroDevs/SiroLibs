    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka gwa mushanju Yehu atwete nirwo Yehoashi yabandize kutwara. Yehoashi ogu akatwara emyaka 40 ayemire Yerusalemu. Nyina eibaralye ni Zibia owa Beerisheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebirobye byona Yehoashi akashemeleza Omukama, aha rw'okuba Yehoyada omukuhani akamwegesa kurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkasi obuju bw'aha mabanga tibwarugireho. Abantu bakagendelera kubutambiramu ebitambo n'okwoteramu obunuma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoashi agambira abakuhani ati, “Empiya zona ez'okukoza ebitakatifu, ezo balikuleta Rwensinga y'Omukama, empiya ezo buli muntu ashaliirwe, kandi n'empiya ez'omuntu arayeyendera kuleta Rwensinga, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakuhani bazibiike nk'okwo buli omoi arakazitora ahali balinya ab'alikukolera. Bazikoze kushubamu Rwensinga orwo eikora elyo lirayetagwa kubaho.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai kwija kugoba aha mwaka gwa 23 Omukama Yoashi atwete engoma, abakuhani tibaina mbali babaire bashubiremu Rwensinga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo Omukama Yehoashi ayeta Yehoyada omukuhani n'abakuhani abandi, ababaza ati, “Kubaki Rwensinga mutagishubiremu? Kityonu abo mulikukolera mutabenza mpiya rundi kakutali kuziheleza zili za kushubamu Rwensinga.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani baikiliza kutagendelera kwenza bantu mpiya zindi. N'omulimo gw'okushubamu Rwensinga bagwejura.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yehoyada omukuhani akwata esanduku, agiiguliramu ekihuru omu mufuniko, agiteka bwatana ealutare rubaju orwa bulyo mbali omuntu alikutahiramu Rwensinga. Nimwo abakuhani abalindaga ekishasi batekaga empiya zona ez'abantu baletaga Rwensinga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kababonaga okwo empiya zakanyamu, omuhandiki w'omukama hamoi n'omukuhani mukuru baija bazibara, zona ezashangwaga Rwensinga bazikoma emitwaro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho empiya ezo bashangwaga babazire bazikwasa abakozi abalebeleraga Rwensinga y'Omukama; abo nibo bashashuraga abaseremara n'abombeki ba Rwensinga, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abombeki b'amabaare n'abatezi bago. Bashuba bagakoza kugura emiti n'amabare agashokorano eby'okushubisamu Rwensinga, hamoi n'ebintu ebindi ebyakwetagirwe aha ikora nk'elyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai aha mpiya ezo ezaletwaga Rwensinga tibakozireho beseni za feza, makasi, epakuli, amakondere anga bikwato bya zahabu anga feza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazihaga abakozi ba Rwensinga abagishubagamu, nobona nizo bakozaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bonene abo, abo babaire bakwese empiya ezo kuta nibashashura abakozi, tibabazaga migendere yazo, aha rw'okuba bakoraga n'obwesigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empiya ezarugaga aha bihongo by'endihi n'aha bihongo by'enyatano y'obufu tibazitahyaga Rwensinga, ezo zabaga z'abakuhani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu makiro ago Hazaeli omukama wa Siria atabalira ekigo kya gati akitera, akitwara; kyonkai orwo yaramwire kutera na Yerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.17",
            "verseOrgIds": [
              "2KI.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoashi omukama wa Yuda akwata ebihongo byona ebyo baishe, abhalimu Yehoshafati, Yehoramu na Ahazia abakama ba Yuda babaire bahongire, agelekaho n'ebihongo ebye nyabwe, n'ezahabu yona eyashangirwe buhanika za Rwensinga y'Omukama n'eza nyaruju, abitwekera omukama wa Siria. Aho Hazaeli Yerusalemu agirugaho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindi byona ebyo Yehoashi yakozire, bihandikirwe omu Kitabo ky'Amakuru g'Abakama ba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaramatabe bamunamira, bamubanja, bamwitira omu nju ya Milo, aha muhanda ogusoka Sila. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwisire ni Yozakari eya Shimeati na Yehozabadi eya Shomeri, abaramatabe; bamutera bamwita. Bamubyalira omu magashani ga baishe omu Kigo kya Daudi. Omutabani Amazia alya engoma, amusikira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.21",
            "verseOrgIds": [
              "2KI.12.21"
            ]
          }
        }
      ]
    }
  ],
