{
  "id": "1CO.12",
  "number": "12",
  "bookId": "1CO",
  "reference": "1 Abakorinto 12",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1CO 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumuna bange, aha bikwete aha matungwa g'omwoyo ningonza mubimanye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya okwo orwo mwabaire muli batakansi mwahabaga mugya aha bihuuku ebitita, nk'okwo mwahabaga rwona rwona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo ningonza mushobokerwe okwo hatabayo muntu agamba mu bushobora bwa Mwoyo wa Ruhanga aziza kugamba ati, “Yesu n'akaraamwe!” Kandi taliho yakugamba ati, “Yesu aba Mukama” shana abe ayemirwemu Mwoyo Mutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatungwa gali hangi, kyonkai Mwoyo ali omoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eikora lili hangi, kyonkai Omukama omoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emilimo nayo eina engeli zingi, kyonkai yona Ruhanga n'iwe wenene wenene alikugikyanulira abantu bona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muntu ashurulirwa amatungwa ga Mwoyo kugasira abantu bona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haliho owo Mwoyo alikutunga eby'okugamba obumanyi; ondijo namutunga okugamba eby'amagezi omu bushobora bwa Mwoyo wenene wenene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondijo Mwoyo wenene namutunga okwesiga, ondijo namutunga amatungwa g'okukiza, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ondijo namutunga okukora ebitangazo, ondijo namutunga oburangi, ondijo namutunga okwahurana amatungwa agalikuruga ahali Mwoyo n'agatalikwo, ondijo namutunga okumanya endimi za nyakalimi, ondijo namutunga okushoboorora endimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi byona nibabikyanulirwa Mwoyo wenene ogwo omoi, n'iwe agabira buli muntu nk'okwo ayenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'okwo omubili guli gumoi kyonkai engingo zagwo zili zingi, n'engingo zona z'omubili, n'orwo zili zingi, zili mubili gumoi, nikwo na Kirisito ali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mani ga Mwoyo omoi ichwena nitubatizibwa kuba mubili gumoi: Tube Bayahudi anga abatali Bayahudi, tube bairu anga begeleere, ichwena tukahabwa Mwoyo omoi n'iwe tunywaho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubili tigugira rugingo rumoi, gugira engingo zingi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.14",
            "verseOrgIds": [
              "1CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'ekilenge kyakugizire kiti, “Orwo inye ntali kiganja tindi wa mubili,” ekyo tikyakukihindwire kutaba rugingo rwa mubili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.15",
            "verseOrgIds": [
              "1CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okutwi kakwakugambire kuti, “Orwo ntali liisho tindi wa mubili,” ekyo tikyakukihindwire kutaba rugingo rwa mubili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.16",
            "verseOrgIds": [
              "1CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'omubili gwona gwakubaire liisho, aho omubili gwakuhuliire gutai? K'omubili gwona gwakubaire kutwi, aho omubili gwakunukiirwe gutai? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.17",
            "verseOrgIds": [
              "1CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiliho, Ruhanga akata engingo omu mubili, buli rugingo nk'okwo araba yayenzire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.18",
            "verseOrgIds": [
              "1CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'engingo zona zakubaire rugingo rumoi, aho omubili gwakugiire nkahai? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.19",
            "verseOrgIds": [
              "1CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'okwo kili engingo zili zingi kyonkai omubili gumoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.20",
            "verseOrgIds": [
              "1CO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliisho tilyakugambira kiganja liti, “Iwe, inye tindikukwetaga,” handiki omutwe kugambira kilenge guti, “Iwe, inye tindikukwetaga.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.21",
            "verseOrgIds": [
              "1CO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu kandi engingo z'omubili eziboneka kugira amani gake bwoli nizo zetaagwa muno, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.22",
            "verseOrgIds": [
              "1CO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi engingo ez'omubili ezo tugayamu nizo tukunira kushaaga, kandi engingo zaitu ez'enshoni nizo tujwekage kushaagaho, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.23",
            "verseOrgIds": [
              "1CO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyonkai ezitali za nshoni tizetaaga kujwekwa zityo. Ruhanga akateranisa engingo omu mubili gumoi, orugingo orutaina kitinwa yaba nirwo aha ekitiinwa ekishagireho, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.24",
            "verseOrgIds": [
              "1CO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu mubili hataija hakabamu ndwano, engingo zona zishobokerwangane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.25",
            "verseOrgIds": [
              "1CO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'orugingo rumoi rushasha, engingo zona zishasha hamoi. K'orugingo rumoi ruhaabwa ekitiinwa, engingo zona zishanduka hamoi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu inywe muli mubili gwa Kirisito, mara buli omoi rugingo rw'omubili ogwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo na Ruhanga omu nteko yatairemu entumwa, abo ba mbere; aba kabili barangi, aba kashatu begesa, aho ahonderwaho abakozi b'ebitangazo, abatambi, abahwezi, abatwazi n'ababuya b'endimi zitali zimoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona ntumwa? Bona barangi? Bona begesa? Bona nibakora ebitangazo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona baina amatungwa g'okutamba? Bona nibagamba endimi? Isi bona nibashoborora endimi ezo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiliho mwitanire amatungwa agalikukira muno oburungi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        }
      ]
