          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
            "verseOrgIds": [
              "EXO.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba akora amajuta gatakatifu ag'okusiiga, n'obunuma nyakabara obulikutamirana oti bukozirwe omubuya w'amarasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.29",
            "verseOrgIds": [
              "EXO.37.29"
            ]
          }
        }
      ]
    }
  ],
