              "EXO.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okunire sho na nyoko, nirwo olirora ebiro birai omu nsi ey'Omukama Ruhanga wawe alikukuha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
    },
