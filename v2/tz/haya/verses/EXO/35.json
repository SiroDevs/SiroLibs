          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi amukyanwire kwegesa banu, bombili, wenene na Oholiabu eya Ahisamaki ow'oruganda rwa Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
