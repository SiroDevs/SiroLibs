              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli nilyo iteka ly'ekihongo ky'okwokibwa, eky'emyaka, ekihongo ky'enyatano y'obufu, ekihongo ky'enyatano y'entambara, eky'eitendeka, n'ebihongo by'emilembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
