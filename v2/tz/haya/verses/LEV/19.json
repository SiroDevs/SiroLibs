          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kamurabonaga omugurusi mwemelere, mukunire obugurusibwe, mara otinega Ruhanga wawe: N'inye Omukama.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
