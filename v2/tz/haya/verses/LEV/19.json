          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otalihagaza muhara wawe kumuteza bumalaya, ensi etaija ekatera bumalaya kandi ekaijurwa amafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekomye Sabato zange mara mukunire ahatakatifu hange: N'inye Omukama.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutaligya aha batungamiirwe bazimu anga barogi; mutalibagyaho bakabahagaza: N'inye Omukama Ruhanga wanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
