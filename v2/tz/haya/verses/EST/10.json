              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Ahasuero ensi n'ez'emyaro azitaho omushoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikorwabye byona eby'obushobora n'amani, n'amakuru gona g'obukuru obwo yahaire Moridekai, bihandikirwe omu Kitabo ky'Amakuru ag'eirai ag'abakama ba Media na Perisia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba Moridekai Omuyahudi akaba ali wa kabili aha mukama Ahasuero omu ngoma. Akaba ali muntu mukuru omu Bayahudi, yaranganwa omu banyarugandabe, kuba akababonera obuge, yayendera abantube bona emilembe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
