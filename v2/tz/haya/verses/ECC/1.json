            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo by'Omwegesa, mutabani wa Daudi, omukama wa Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye Omwegesa nkaba ndi mukama wa Isiraeli omuli Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkataho amani kuhigisa obumanyi n'okuhenjuza byona ebikorwa omu nsi. Eli ikora ly'enaku elyo Ruhanga yahaire abantu kabakora. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboine byona ebikorwa omu nsi, leba byona ni bushai mara ni kusa amani. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekilemaire tikishobora kugororwa, kandi ekitaliho tikishobora kubarwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkatekeleza aha mutima nti. Ngizire obumanyi bungi kushaga bona abanyebembeire kutwara omuli Yerusalemu, omutima gwange gukagira obumanyi bungi n'amagezi gangi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkataho amani kumanya obumanyi n'okumanya eiramu n'obufera. Nkabona oku okwo kuli kusa amani.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
    }
  ],
