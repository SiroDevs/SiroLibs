              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'orwo eby'okukuhandikira nyina bingi, tinakugondize kukoza karatasi na bwino. Shana ninshubira kwija kukubona, tukabonangana omu maisho tukafumora, ebyera bibone kugobeelera.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        }
      ]
    },
