        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Yabini omukama wa Hazori yahuliire ebyo, atuma ahali Yobabu omukama wa Madoni, n'aha mukama wa Shimuroni, n'aha mukama wa Akishafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.1",
            "verseOrgIds": [
              "JOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'aha bakama ababaire bali bikara omu nsi z'amabanga, n'omuli Araba orubaju rwa kasi rwa Kinereti, n'omu nsi y'omuteleka, n'omuli Dori obugwaizoba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.2",
            "verseOrgIds": [
              "JOS.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'omu Bakanaani oburugaizoba n'obugwaizoba, Abaamori, Abahiti, Abaperizi n'Abayebusi n'omu nsi z'amabanga n'Abahivi omu kibazi ky'Eibanga lya Herimoni omu nsi ya Mizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.3",
            "verseOrgIds": [
              "JOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabara n'amahe gabo gona. Abantu obungi nk'omushenye gw'omwaro, baina n'efarasi zingi n'amagali gangi muno. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakama abo bona bateranisa amahe gabo, baija basisira hamoi aha Kaiga ka Meromu kurashana na Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama agambira Yoshua ati, “Otabatina, aha rw'okuba nyenkya akanya nk'aka ndabakuheleza bona bafire, aha rwa Isiraeli. Olemaze efarasi zabo, amagali gabo ogokye n'omuliro.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.6",
            "verseOrgIds": [
              "JOS.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Yoshua n'abaisherukarebe babagwamu kibandagara aha Kaiga ka Meromu, bababunda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.7",
            "verseOrgIds": [
              "JOS.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama abanaga omu mikono y'Abaisiraeli, babaita, abandi bababinga kuhika Sidoni Engundu na Misirefotimaimu, n'oburugaizoba babagobya omu Ruhanga rwa Mizipa; babaita, tibasigireho n'omoi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.8",
            "verseOrgIds": [
              "JOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akora nk'okwo Omukama yamugambiire, alemaza efarasi zabo, ayokya amagali gabo n'omuliro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho agaruka akwata Hazori, omukama wamwo amwisa embanda. Orwa mbere Hazori ekaba nekiza amani ebigo by'abakama balinya bona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaturagamu bona babaisa embanda. Babasilikiza kimoi, thalimu yasigairemu n'omoi, n'ekigo akitaho omuliro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigo byona by'abakama abo n'abakama babyo, Yoshua abakwata abaisa embanda. Abasilikiza kimoi nk'okwo Musa omwiru w'Omukama yaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Abaisiraeli tibayokize bigo byona byona ebyabaire bili aha tubanga shana Hazori yonkai niyo Yoshua yayokize. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu by'ebigo ebyo n'ebitunganwa Abaisiraeli babinyaga, kyonkai abantu bhakabaisa embanda babasilikya. Tibasigireho n'omoi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'okwo Omukama yabaire ahangiire omwiruwe Musa, nikwo na Musa wenene yaragiire Yoshua, Yoshua nawe nikwo yakozire. Eby'Omukama yabaire ahangiire Musa, Yoshua akabikora byona.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akwata ensi egyo yona, ey'amabanga na Negebu yona, eya Gosheni n'ensi y'omuteleka na Araba n'ensi y'amabanga ga Isiraeli n'omuteleka gwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.16",
            "verseOrgIds": [
              "JOS.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayema aha Ibanga lya Halaki elilebangaine na Seiri agoba Baaligadi omu Ruhanga rwa Lebanoni omu kibazi ky'Eibanga lya Herimoni. Akwata abakama bamwo bona, abatera abaita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.17",
            "verseOrgIds": [
              "JOS.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai akarashana nabo ebiro bingi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.18",
            "verseOrgIds": [
              "JOS.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taliho kigo kyagizire mirembe n'Abaisiraeli, kwihyaho Abahivi, abanyansi ba Gibeoni. Abasigaire bhakabakwata bona omu ndashana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.19",
            "verseOrgIds": [
              "JOS.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama hakabagumanganisa emitima akigendeleire, barashane n'Abaisiraeli. Abaisiraeli tibabagiliire buganyizi. Bakabasilikya nk'okwo Omukama yabaire ahangiire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo Yoshua agya asilikya Abaanaki b'omu mabanga, n'aba Heburoni, Debiri na Anabu n'omu mabanga ga Yuda n'omu mabanga gona ga Isiraeli. Yoshua abasilikiza kimoi n'ebigo byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taliho Muanaki n'omoi yasigaire mu nsi y'Abaisiraeli shana omuli Gaza mwonkai, n'omuli Gati na Ashidodi nimwo basigaire bake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi agikwata yona nk'okwo Omukama yabaire agambiire Musa. Yoshua agiha Isiraeli obusika bwabo kuhonderana n'enganda zabo. Aho ensi echulera eba etakiina ndashana.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    }
  ],
