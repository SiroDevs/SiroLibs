            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enusu y'oruganda rwa Manase nabo Musa hakaba abahaire obusika kuhonderana n'amahiga gabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
