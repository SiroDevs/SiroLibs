      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli bakasinga ensi y'oburugaizoba bwa Yorudani bagituramu, kwema omu Ruhanga rwa Arinoni kutembera kimoi n'Oruhanga rwa Yorudani kugoba aha Ibanga lya Herimoni. Bakasinga abakama babili, nib'aba: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoni omukama w'Abaamori ayaturaga Heshiboni natwara kwema Aroeri aha rukunakune rw'Oruhanga rwa Arinoni, kandi kwema omugati y'oruhanga, kugoba Omwiga gwa Yaboki, orubibi rw'Abaamoni niyo nusu ya Gileadi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okwema Araba kugoba aha Nyanja ya Kinereti oburugaizoba obwolekera bwa Betiyeshimoti aha Nyanja ya Araba, Enyanja y'Omwonyu, kwolekera kasi; kugoba aha kibazi ky'Eibanga lya Pisiga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basinga na Ogi omukama wa Bashani ayasigaireho omu Barefai, ayaturaga Ashitaloti na Edirei. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu yatwaraga kwema omw'Ibanga lya Herimoni na Saleka, na Bashani yona, kugoba orubibi rw'Abageshuri n'Abamaaka, n'enusu ya Gileadi kugoba orubibi rwa Sihoni omukama wa Heshiboni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakama aba bombili bakaterwa Musa omwiru w'Omukama n'Abaisiraeli. Ensi egyo Musa akagigabira Abarubeni n'Abagadi n'enusu y'oruganda rwa Manase, yagibaha obusika.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo bakama abo Yoshua n'Abaisiraeli basingiire rubaju orw'obugwaizoba buseli bwa Yorudani, kwema Baaligadi omu Ruhanga rwa Lebanoni kugoba aha Ibanga lya Halaki elyolekeire Seiri. Ensi ezo Yoshua akazishondera enganda za Isiraeli, yazibahera kimoi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwo halimu ensi z'amabanga, ez'empanga, eza Araba, ez'omu busoka, ez'eirungu, n'eza Negebu, ensi z'Abahiti, Abaamori, Abakanaani, Abaperizi, Abahivi n'Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakama abo nib'aba: Omukama wa Yeriko, omoi; omukama wa Ai eyataine Beteli, omoi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
