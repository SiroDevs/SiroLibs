            "number": "10",
            "style": "v",
            "sid": "JOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukama wa Yerusalemu, omoi; omukama wa Heburoni, omoi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
              "JOS.12.10"
            ]
          }
