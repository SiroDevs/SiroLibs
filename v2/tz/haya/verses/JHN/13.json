          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero amugambira ati, “Mukama, kubaki ntakuhondera? Ndakufera.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        },
