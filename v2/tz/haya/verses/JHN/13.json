              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kugonzangana kwanyu, nimwo abantu bona balimanyira okwo muli begesibwa bange.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
