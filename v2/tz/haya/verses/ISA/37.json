            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ISA 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumalaika w'Omukama agya omu rusisira rw'Abaasiria aitamu abaisherukare 185,000. Bukeire bunu omu mambya bakaba bafire bona! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirwo Senakeribu omukama wa Asiria yashubire omuka, akatura Ninive. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kimoi aliho nafukamira ruhangawe Nisiroki omuli Rwensinga, abatabani babili, atulimu Adarameleki na Sharezeri bamwisa embanda bashuba bairukira omu nsi ya Ararati. Omutabani, ondijo eibaralye Esarihadoni n'iwe yaliire engoma, akamusikira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
            ]
          }
        }
      ]
    }
