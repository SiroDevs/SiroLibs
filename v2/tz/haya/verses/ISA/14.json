      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
              "ISA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entumwa z'Abafilisiti omuntu azihorore atai? Turabagira tuti, “Omukama n'iwe yahangwire Sioni. Kandi omuli Sioni omwo nimwo abantube atulikwitwa kubi tulihungira.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.32",
            "verseOrgIds": [
              "ISA.14.32"
            ]
          }
        }
      ]
    }
