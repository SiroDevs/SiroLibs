          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo batabani ba Isiraeli: Rubeni, Simeoni, Levi, Yuda, Isakari, Zebuluni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.1",
            "verseOrgIds": [
              "1CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dani, Yozefu, Benjamini, Nafutali, Gadi na Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yuda ni Eri, Omani na Shela; abo bonshatu akabazara ahali Batishua Omukanaanikazi. Eli omuzigaijo gwa Yuda akatamisa Omukama, Omukama yamwita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.3",
            "verseOrgIds": [
              "1CH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, omukamwana, Tamari nawe kwakwo yamuzaraho Peresi na Zera. Abatabani bali batanu bona hamoi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Peresi ni Hezironi na Hamuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.5",
            "verseOrgIds": [
              "1CH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Zera ni Zabudi, Etani, Hemani, Kalikoli na Dara; bona hamoi batanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.6",
            "verseOrgIds": [
              "1CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Karimi ni Akari ayaisire kubi Isiraeli, akahagaza ebitakatifu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.7",
            "verseOrgIds": [
              "1CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mutabani wa Etani akaba ali Azaria.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Hezironi ni Yerameeli, Ramu na Kelubai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ramu nazara Aminadabu, kandi Aminadabu nazara Nashoni omutwazi w'oruganda rwa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.10",
            "verseOrgIds": [
              "1CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashoni nazara Saluma, Saluma nazara Boazi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.11",
            "verseOrgIds": [
              "1CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boazi nazara Obedi, Obedi nazara Yese. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yese nazara Eliabu omuzigaijogwe, Abinadabu niwe mushubiro, owa kashatu ni Shimea; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.13",
            "verseOrgIds": [
              "1CH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kanai ni Netaneli, owa katanu ni Radai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.14",
            "verseOrgIds": [
              "1CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa mukaga ni Ozemu, Daudi wa mushanju; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.15",
            "verseOrgIds": [
              "1CH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "banyanyabo ni Zeruya na Abigaili. Batabani ba Zeruya bali bashatu: Abishai, Yoabu na Asaheli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigaili azara Amasa. Ishe Amasa akaba ali Yetheri, Omuishimaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu eya Hezironi akazara abana ahali mukaziwe Hazuba, Yerioti (omuhara), kandi abatabani ni Yesheri, Shobabu na Aridoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.18",
            "verseOrgIds": [
              "1CH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azuba kayafire, Kalebu yashwera Efurati yamuzaraho Uri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.19",
            "verseOrgIds": [
              "1CH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huri nazara Huri, kandi Uri nazara Bezaleli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma Hezironi kayabaire aina emyaka nkaga atahilira muhara wa Makiri anga munyanya Gileadi, amuzaraho Segubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.21",
            "verseOrgIds": [
              "1CH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Segubu nazara Yairi ayabaire aina ebigo makumi 23 omu nsi ya Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.22",
            "verseOrgIds": [
              "1CH.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Geshuri na Aramu omu bigo ebyo banyagamu Havotiyairi, Kenati n'ebyaro byayo, ebigo 60, Bona aba bakaba bali baijukuru ba Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.23",
            "verseOrgIds": [
              "1CH.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Hezironi yabaire yafire, Kalebu agya amanya Efurati, muka ishe, Hezironi amuzaraho Ashuri, ishe Tekoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerameeli, omuzigaijo gwa Hezironi, abatabani ni Ramu, (omuzigaijogwe), Buna, Oreni, Ozemu na Ahiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.25",
            "verseOrgIds": [
              "1CH.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yerameeli akaba aina omukazi ondijo, eibaralye Atara. Ogu niwe nyina Onamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.26",
            "verseOrgIds": [
              "1CH.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Ramu omuzigaijo gwa Yerameeli ni Maazi, Yamini na Ekeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.27",
            "verseOrgIds": [
              "1CH.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Onamu ni Shamai na Yada. Batabani ba Shamai ni Nadabu na Abishuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muka Abishuri eibaralye akaba ali Abihaili, amuzalira Abani na Molidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.29",
            "verseOrgIds": [
              "1CH.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Nadabu ni Seledi na Apaimu; Seledi akafa buchweke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.30",
            "verseOrgIds": [
              "1CH.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Apaimu ni Ishi. Mutabani wa Ishi ni Sheshani. Mutabani wa Sheshani ni Alai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yada murumuna Shamai ni Yetheri na Yonatani. Yetheri nawe akafa buchweke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.32",
            "verseOrgIds": [
              "1CH.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yonatani ni Peleti na Zaza. Aba bona bakatabuka ahali Yerameeli, ni baijukurube. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheshani akaba ataina bana bojo shana abana bahara; kyonkai akaba aina omwiru Omumisri eibara nayetwa Yariha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.34",
            "verseOrgIds": [
              "1CH.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Sheshani akwata omuhara amusiigira Yariha omwiruwe, amuzaraho Atai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.35",
            "verseOrgIds": [
              "1CH.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atai nazara Natani, na Natani nazara Zabadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.36",
            "verseOrgIds": [
              "1CH.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zabadi nazara Efilali kandi Efilali nazara Obedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.37",
            "verseOrgIds": [
              "1CH.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedi nazara Yehu, kandi Yehu nazara Azaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.38",
            "verseOrgIds": [
              "1CH.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria nazara Helesi, kandi Helesi nazara Eleasa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.39",
            "verseOrgIds": [
              "1CH.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasa nazara Sisimai, kandi Sisimai nazara Shalumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.40",
            "verseOrgIds": [
              "1CH.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu nazara Yekamia, kandi Yekamia nazara Elishama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzigaijo gwa Kalebu murumuna Yerameeli ni Maresha. Maresha nazara Zifu. Zifu nazara Maresha, kandi Maresha ogu nazara Heburoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.42",
            "verseOrgIds": [
              "1CH.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Heburoni ni Kora, Tapua, Rekemu na Shema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.43",
            "verseOrgIds": [
              "1CH.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shema nazara Rahamu, Rahamu ishe Yorikeamu; kandi Rekemu nazara Shamai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.44",
            "verseOrgIds": [
              "1CH.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Shamai ni Maoni, kandi Maoni nazara Betizuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.45",
            "verseOrgIds": [
              "1CH.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu akaba aina ensholeke nayetwa Efa, akagizaraho Harani, Moza na Gazezi. Harani nazara Gazezi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yadai ni Regemu, Yotamu, Geshani, Peleti, Efa na Shaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaka, ensholeke ya Kalebu nagizaraho Sheberi na Tirihana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.48",
            "verseOrgIds": [
              "1CH.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba amuzaraho Shaafu ishe Madimana, na Sheva ishe Kakibena na Gibea. Kalebu akaba aina omuhara nayetwa Akisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba abalikuhonderaho nibatabuka ahali Kalebu:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzigaijogwe Huri namuzigaija ahali Efurati. Huri nazara Shobali, Shobali nazara Kiriatiyearimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saluma ishe Betelehemu na Harefu ishe Batigaderi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.51",
            "verseOrgIds": [
              "1CH.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shobali ishe Kiriatiyearimu akaba aina abatabani abandi, nka Haroe n'enusu y'abantu ba Menuhoti nibatabuka ahali wenene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.52",
            "verseOrgIds": [
              "1CH.2.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 2:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahiga agalikutabuka ahali Kiriatiyearimu nibo Abaitiri, Abaputi, Abashumati n'Abamishirai. Omuli aba nihatabukwamu Abazorati n'Abaeshitaoli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.53",
            "verseOrgIds": [
              "1CH.2.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Saluma ni Betelehemu, Abanetofati, Atirotibetiyoabu n'enusu y'Abamanahati nibo Bazori. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.54",
            "verseOrgIds": [
              "1CH.2.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CH 2:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakwo amahiga g'abahandiki abaturaga Yabezi nibo Abatirati, Abashimeati n'Abasukati. Abo nibo Abakeni abatabukire ahali Hamati omugurusi w'eihiga lya Rekabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.55",
            "verseOrgIds": [
              "1CH.2.55"
            ]
          }
        }
      ]
    }
  ],
