          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adina eya Shiza Omurubeni, rugambwa akaba aina abaisherukare 30 abe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani eya Maaka, Yoshafati owa Mitini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.43",
            "verseOrgIds": [
              "1CH.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia owa Ashitera, Shama na Yeieli batabani ba Hotamu owa Aroeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yadiaeli na Yoha batabani ba Shimuri owa Tizi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.45",
            "verseOrgIds": [
              "1CH.11.45"
            ]
          }
        },
