          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira, Garebu aba Yatiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
