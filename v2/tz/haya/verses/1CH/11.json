            "number": "39",
            "style": "v",
            "sid": "1CH 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeleki owa Amoni, Naharai owa Beroti, omutwazi w'ebikwato bya Yoabu eya Seruya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
