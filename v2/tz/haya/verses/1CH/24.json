{
  "id": "1CH.24",
  "number": "24",
  "bookId": "1CH",
  "reference": "1 Amakuru 24",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "1CH 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Aroni bakaba bali omu bichweka ebi: Batabani ba Aroni ni Nadabu, Abihu, Eleazari na Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Nadabu na Abihu bakafera ishebo mbere, tibasigire bana; aha rw'ekyo Eleazari na Itamari nibo babaire bakuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akateka baijukuru ba Aroni omu bichweka bitali bimoi kuhonderana n'emyoga yabo. Omu kubateka atyo akahwerwa Zadoki eya Eleazari, na Ahimeleki mwijukuru wa Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Eleazari bakatekwa omu bihya 16, kandi baijukuru ba Itamari batekwa omu bihya munana. Okukora batyo enshonga omuli baijukuru ba Eleazari akaba alimu abakuru b'amahiga kushaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakababeganisa omu kurosha enshoga, bona omu migilire emoi aha rw'okuba hakaba halimu abakuru b'ahatakatifu n'abaheleza ba Ruhanga omuli baijukuru ba Eleazari na baijukuru ba Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omuhandiki Shemaya eya Natanaeli, mara akashangwa ali Mulevita, abahandikira omu maisho g'Omukama, n'omu maisho g'abakuru, na Zadoki omukuhani, na Abimeleki eya Abiatari, n'abakuru b'amahiga g'abakuhani n'ag'Abalevita. Eihiga limoi lyarondwa lili lya Eleazari n'elindi lili lya Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayarasiirwe enshoga ali wa mbere ni Yehoyaribu; owa kabili ni Yedaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.7",
            "verseOrgIds": [
              "1CH.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kashatu ni Harimu; owa kanai ni Seorimu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.8",
            "verseOrgIds": [
              "1CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa katanu ni Malakiya; owa mukaga ni Miyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.9",
            "verseOrgIds": [
              "1CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa mushanju ni Hakosi; owa munana ni Abiya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.10",
            "verseOrgIds": [
              "1CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa mwendai ni Yeshua; owa ikumi ni Shekania; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.11",
            "verseOrgIds": [
              "1CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa ikumi n'omoi ni Eliashibu; owa ikumi na babili ni Yakimu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.12",
            "verseOrgIds": [
              "1CH.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa ikumi na bashatu ni Hupa; owa ikumi na banai ni Yeshebeabu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.13",
            "verseOrgIds": [
              "1CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa ikumi na batanu ni Biliga; owa ikumi na mukaga ni Imeri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.14",
            "verseOrgIds": [
              "1CH.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa ikumi na mushanju ni Hezili; owa ikumi na munana ni Hapizezi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.15",
            "verseOrgIds": [
              "1CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa ikumi na mwenda ni Petania; owa makumi gabili ni Yehezkeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.16",
            "verseOrgIds": [
              "1CH.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa makumi gabili n'omoi ni Yakini; owa makumi gabili na babili ni Gamuli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.17",
            "verseOrgIds": [
              "1CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa makumi gabili na bashatu ni Delaya; owa makumi gabili na banai ni Maazia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.18",
            "verseOrgIds": [
              "1CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba baijaga aha zamu zabo z'eikora omuli Rwensinga y'Omukama kuhonderana n'entwaza eyo babaire bateleirweho ish'enkurubo Aroni, nk'okwo Omukama Ruhanga wa Isiraeli yabaire amuragiire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Levi abasigaire nib'aba: Omuli baijukuru ba Amuramu ni Shubaeli; omuli baijukuru ba Shubaeli ni Yehedeya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Rehabia: Omuli baijukuru ba Rehabia ni Ishia ayabaire ali mukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Baizihari ni Shelemoti; omuli baijukuru ba Shelemoti ni Yahati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.22",
            "verseOrgIds": [
              "1CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Heburoni, Yeria niwe yabaire ali mukuru, Amaria ali wa kabili, Yahazieli ali wa kashatu, Yekameamu ali wa kanai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Uzieli ni Mika; omuli baijukuru ba Mika ni Shamiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murumuna Mika ni Ishia; omuli baijukuru ba Ishia ni Zekaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Merari ni Mahuli na Mushi; omuli baijukuru ba Yaazia ni Beno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli baijukuru ba Merari ni batabani ba Yaazia abalimu Beno, Shohamu, Zakuri na Ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli baijukuru ba Mahuli ni Eleazari ayabaire ataina bana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
              "1CH.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi akaba aina omwana omoi, Yerameeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
              "1CH.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Mushi ni Mahuli, Ederi na Yeremoti. Aba bakaba bali baijukuru b'Abalevita kuhonderana n'amahiga gabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo aba bakuru b'amahiga, omukuru wa buli ihiga hamoi n'omurumuna, bakateka enshoga nk'okwo baijukuru ba Aroni batekire enshoga omu maisho g'Omukama Daudi, na Zadoki, na Ahimeleki, kandi omu maisho g'abakuru b'amahiga g'abakuhani n'Abalevita.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
    }
  ],
