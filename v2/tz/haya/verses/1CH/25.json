            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekura ya mbere egwera Yozefu ow'eihiga lya Asafu. Ekura ya kabili egwera Gedalia n'abarumuna n'abatabani; bona hamoi bantu 12. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
