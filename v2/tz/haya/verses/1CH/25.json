      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi n'abakuru b'Abalevita, bashuba omuli baijukuru ba Asafu, n'aba Hemani, n'aba Yeduthuni, bagira abo bashororamu kuta nibabasha nibatera enanga, eningili n'enkunturo. Amabara g'ababaire nibakora emyoga egyo nig'aga: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli batabani ba Asafu ni Zakuri, Yozefu, Netania na Asharela. Bakulirwaga Asafu ow'Omukama yabandaga akabasha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeduthuni n'abatabani mukaga, abalimu Gedalia, Zeri, Yeshaya, Shimei, Hashabia na Matitia. Bakulirwaga Yeduthuni ishebo ayabashaga natera enanga, nasiima n'okuhaisiliza Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hemani n'abatabani: Bukia, Matania, Uzieli, Shebweli na Yerimoti, Hanania, Hanani, Eliata, Gedaliti na Romamitiezeri, Yokibekasha, Maloti, Hotiri na Mahazioti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bona bakaba bali batabani ba Hemani, kaboni w'omukama kuhonderana n'okwo Ruhanga yabaire aragaine kumukuza. Ruhanga akaba atungire Hemani abaana b'abojo ikumi na banai n'abaisiki bashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona bakaba nibaragirwa ishebo aha bikwete eby'omuziiki omuli Rwensinga y'Omukama, nibatera enkunturo, enanga n'eningili orwo babaga bali aha myoga yabo omuli Rwensinga. Asafu, Yeduthuni na Hemani bakoraga nk'okwo Omukama Daudi yabaragiraga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubara rwabo na barumuna babo babulimu ababaire begesibwe kuhoyera Omukama, ababuya bona hamoi bakaba bali 288. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batekaga enshoga kumanya ezamu zabo, omuke n'omuhango, omwegesa n'omwegesibwa kumoi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    },
    {
