              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatwara Isiraeli emyaka 40. Emyaka mushanju akagitwalira Heburoni, kandi emyaka 33 yagitwalira Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
