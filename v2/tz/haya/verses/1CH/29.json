            "number": "30",
            "style": "v",
            "sid": "1CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakuru nigabarura emitwalireye yona, obushoborabwe na byona ebyo yaboine na Isiraeli n'engoma zona z'ensi ezibataine.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.30",
