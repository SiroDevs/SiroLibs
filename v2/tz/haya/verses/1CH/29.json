          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho atahya ali mugurusi engundu, aina eitunga n'ekitinwa. Omutabani Solomoni amusikira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eby'Omukama Daudi yakozire kwema aha mbandizo kugoba aha nzindo bihandikirwe omu Makuru ga Samweli kaboni, n'omu makuru ga Natani omurangi, n'omu makuru ga Gadi kaboni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
