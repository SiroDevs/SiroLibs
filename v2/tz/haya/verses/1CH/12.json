            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bona, abaisherukare emanzi, baija Heburoni bamalize kuteka Daudi aha ngoma kuba mukama wa Isiraeli; kutyo n'AbaIsiraeli abasigaire bona bakaba bali ba Daudi kumuteka aha ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamarayo ebiro bishatu baina Daudi, nibalya, nibanywa, kuba barumuna babo bakaba bababisire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumoi n'ababaire babali haihi kwema Isakari kuturuka Zebuluni na Nafutali bakabaletera ebyakulya babitwekire endogobe, engamia, enyumbu n'ente, eby'okulya ebitali bya kugambwa: Ensano, emikate y'etini, engoobe z'ezabibu zomire, edivai n'amajuta, ente n'entaama, kuba Isiraeli ekaba eijwire ebyera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
