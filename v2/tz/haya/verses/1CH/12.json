{
  "id": "1CH.12",
  "number": "12",
  "bookId": "1CH",
  "reference": "1 Amakuru 12",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1CH 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo bashangire Daudi Zikilagi orwo yabaire nayesheleka Sauli eya Kishi aha rw'okumutina. Bakaba bali omu manzi 30 abamwemagamu omu ndashana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba nibamanya kurashanisa amata, kurasha emyambi n'okurasha amabare omu kihubeezo nibakoza omukono gwa bulyo anga ogwa bumosho. Bakaba bali Babenjamini abanyaruganda ba Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuru wabo akaba ali Ahiezeri, nahonderwa Yoashi, bombili batabani ba Shema owa Gibea; kwakwo na Yezieli na Peleti batabani ba Azimaweti; Beraka, Yehu owa Anatoti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaya owa Gibeoni, omwisherukale emanzi omu makumi gashatu ayayebemberaga; Yeremia, Yahazieli, Yohanani, Yozabadi owa Gedera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eluzai, Yeremoti, Bearia, Shemaria, Shefasia owa Harufi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elikana, Ishia, Azareli, Yoezeri na Yashobeamu ow'oruganda rwa Kora, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoela na Zebadia batabani ba Yerohamu owa Gedori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Bagadi harugwamu emanzi abamanyaga endashana, babuya omu mikwatire y'engabo n'amachumu, aha maisho nibashusha entare, emyanguhire nk'enjaza aha mabanga, bashanga Daudi omu kigo ky'omw'irungu omu boma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonene abo omukuru ni Ezeri, owa kabili ni Obadia, Eliabu wa kashatu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa kanai ni Mishimana, owa katanu ni Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atai wa mukaga, Elieli wa mushanju, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanani wa munana, Elizabadi wa mwendai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia wa ikumi, Makabanai wa ikumi n'omoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagadi aba bakaba bali bakuru b'eihe, ayatwaraga bake, 100; n'ayatwaraga bangi, 1,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo bashabukire Yordani omu mwezi gwa mbere, orwo amaizi gayasire gakashaga aha nkunguru zayo zona n'abaturaga omu ruhanga gakabaatamu, gayemalira oburugaizoba n'obugwaizoba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamoiho omu Babenjamini n'Abayuda baija, bashanga Daudi omu boma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ashohora kubakiilira, abagambira ati, “Kamuraba mwampondera aha rw'obutahi kunjuna, turanywana; kyonkai kakuraba kuli kumbanja aha babisha bange, n'orwo ntaina kabi ako nkozire, Ruhanga wa baisheichwe abone, ababonabonyie.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirwo Mwoyo yatungamiire Amasai, omukuru w'amakumi gashatu akagamba ati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamoiho omu ruganda rwa Manase bayehongera Daudi orwo yatabaire n'Abafilisiti kurashanisa Sauli. Kyonkai Abafilisiti tiyabajunire, kuba abatwazi babo bakaramura kumubinga, nibagamba bati, “Naija kwehongera mukamawe Sauli atunage omu kabi atwise.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi kayabaire nagya Zikilagi, abantu aba ab'oruganda rwa Manase bamwehongera. Nibo Adina, Yozabadi, Yadiaeli, Mikaili, Yozabadi, Elihu na Zeleati, abakuru b'enkumi omu ruganda rwa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahwera Daudi bamujuna abanyagi, kuba bona bakaba bali bashaija b'amani emanzi, kandi bashangwa bali bakuru b'eihe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kiro obutosha abantu baikaraga nibaija ahali Daudi kumwemamu, eihe lyalemwa lyaba lihango, nk'eihe lya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oru nirwo rubara rw'abaisherukare ababaire bekomire bahondeire Daudi Heburoni, kwihya Sauli aha ngoma kugiha Daudi nk'okwo Omukama yabaire agambire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda ab'engabo n'amachumu bakaba bali baisherukale 6,800. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasimeoni, abashaija b'amani emanzi z'endashana, bakaba bali 7,100. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalevita 4,600. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada omukuru w'eihiga lya Aroni akaba aina 3,700; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Zadoki, omusigazi w'amani emanzi, ogwo akaba aina abakuru b'eihe 22 kuruga omw'ihigalye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Babenjamini, abanyaruganda ba Sauli 3,000; kuba kulemwa kugoba omu bir'ebyo Ababenjamini abali bangi bakaba bagumire ahali Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Baefuraimu 20,800 abanyamani, emanzi, ab'eiranga omu mahiga gabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'omu nusu y'oruganda rwa Manase 18,000 abatonzirwe butondwa amabara kwija kuta Daudi aha ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu b'oruganda rwa Isakari, abashaija abamanyaga eby'amakiro n'emichwo y'AbaIsiraeli, bagurusi 200 n'abanyaruganda babo bona okwo babaire nibabagelera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Zebuluni 50,000 abegesiibwe geigeigei endashana, betekatekeire endashana, baina ebikwato byona by'endashana kuhwera Daudi obuzira kabajoka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'oruganda rwa Nafutali, abagabe 1,000 hamoi n'abaisherukare 37,000 abakwete engabo n'amachumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Badani baisherukale 28,000 abetekatekeire eby'endashana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ruganda rwa Asheri abaisherukare ababuya 40,000 abetekatekeire endashana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Abagadi n'omu nusu y'Abamanase abarugire buseli bwa Yordani, 120,000 ababaire baina ebikwato byona by'endashana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        }
      ]
    },
    {
