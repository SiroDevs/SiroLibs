{
  "id": "DEU.21",
  "number": "21",
  "bookId": "DEU",
  "reference": "Obwijukiro 21",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "DEU 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu nsi ey'Omukama Ruhanga wanyu alikubaha kulya, kabalishanga omuntu aisirwe, abyamire omw'ishwa, mara amwisire atalikumanyika, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho abagurusi banyu n'abaramuzi, bagende batere ebita kuruga ahali ogwo aisirwe kugya aha bigo ebimwataine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagurusi b'ekigo ekili haihi muno n'omuntu aisirwe bakwate enyana y'enkiraiziba etakakozibwaga mulimo mara etakakururaga nkomo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagisongore omu ruhanga rw'amaizi galikugera, orutalimirwe mara orutabyairwemu. Omu ruhanga orwo babe nimwo bahendera enyana egyo y'enkiraiziba ebikya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani Abalevita nabo bagyeyo aha rw'okuba Omukama Ruhanga wanyu akabaronda kabamukolera n'okuha abantu omugisha omw'ibaralye. Okwo baliramura nikwo, aho empaka n'endwano bihwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abagurusi bona b'ekigo ekili haihi muno n'omuntu aisirwe banabire emikono yabo aha nyana eyahendwa ebikya omu ruhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "bajulire bati, ‘Omuntu ogu titumwisire, kandi n'amwisire titumuboine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
            "verseOrgIds": [
              "DEU.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waitu Mukama baganyire abantu bawe Abaisiraeli abo wachungwire, otabakwata ntambara y'okwitwa kwa nyakatetere.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo orwo mulikora eby'Omukama alikuragira, timulikwatwa mushango gwa bwitamuntu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kamulitabalira ababisha banyu, mara Omukama Ruhanga wanyu akababanaga omu mikono mukabatwara endore, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu ndore okabonamu omukazi murungi, okamwenda kumushwera, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.11",
            "verseOrgIds": [
              "DEU.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "sho omulete omuka omwawe, amoise omutwegwe mara achwije n'empamboze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajure ekijwaro ky'endore; aikare omwawe achulire ishe na nyinai omwezi gumoi. Ebyo kabilihwa wakumugoba oba mushaijawe, na wenene aba mukazi wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'oliba otamushemeleirwe omutaishure agende mbali arayenda; kyonkai otalimuguza, mara orwo wamuhemwire otalimuhindura muzana.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“K'omushaija aliba aina abakazi babili, omoi nagonzibwa ondijo nanobwa, mara bombili bamuzaliire abana, k'omwojo omuzigaijo aliba ali wa kinobwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiro ekyo alisikisa abatabani eitungalye, ataligilira kigonzi mwana w'omugonzibwa kumuhindura muzigaijo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aikilize omuzigaijo omwana owa kinobwa, amuhe omushondo gw'enyaibili gw'eby'ainabyo byona; ahakuba niwe kiraba kya mbere ky'amanige; ehaki y'omuzigajo y'omuzigaijo.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“K'omuntu aliba aina omutabani enyeleme mara omushengi, atalikuhulira ebyo ishe anga nyina balikumugambira, n'orwo bamuha ekibonabonyio akanga kubahulira, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho ishe na nyina bamukwate bamuletere abagurusi aha kihigi ky'ekigo ekyo balikuturamu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagambire abagurusi abo bati, ‘Mutabani waitu nyeleme mara mushengi, talikutuhulira; muntu w'omururu mara ntamiizi,’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho abantu bona b'ekigo bamuteze amabare, afe; nikwo mulichwa mutyo omuze omuli inywe. Isiraeli yona ehulire etine.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi omuntu alikora entambara esanire ekibonabonyio ky'orufu mara akaitwa, kamulimuhanika aha muti, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
            "verseOrgIds": [
              "DEU.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "omubiligwe gutaliraraho kiro kyona. Mumuziike kiro kyonene aha rw'okuba omuntu ahanikirwe aha muti aba araamirwe Ruhanga. Mutalihagaza nsi yanyu ey'Omukama Ruhanga wanyu alikubaha obusika.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        }
      ]
    }
  ],
