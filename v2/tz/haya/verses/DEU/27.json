  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "DEU 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Musa n'abagurusi ba Isiraeli baragira abantu bati, “Mukwate emihango yona eyo ndikubaragira kir'eki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.1",
            "verseOrgIds": [
              "DEU.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kir'ekyo mulishabuka Yorudani kutaha omu nsi ey'Omukama Ruhanga wanyu alikubaha, musimbe amabare gahango mugasilibe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.2",
            "verseOrgIds": [
              "DEU.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mara mugahandikeho ebigambo byona eby'amateka aga, orwo muliba muli omu nsi elikusheshekana amata n'obwoki, nk'okwo Omukama Ruhanga wa baisheinywe yabaraganisize. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.3",
            "verseOrgIds": [
              "DEU.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamuliba mwashabukire Yorudani musimbe amabare aga, gakwete aha byondikubaragira kir'eki aha Ibanga lya Ebali mara mugasilibe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.4",
            "verseOrgIds": [
              "DEU.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulinya mwombekereyo Omukama Ruhanga wanyu ealutare y'amabare; mutaligateza kikwato kya kyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.5",
            "verseOrgIds": [
              "DEU.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwombekere Omukama Ruhanga wanyu ealutare y'amabare agatabaizirwe, mugimutambilireho ebihongo by'okwokibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.6",
            "verseOrgIds": [
              "DEU.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutambe n'ebitambo by'emilembe, mulye mushanduke omu maisho g'Omukama Ruhanga wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muhandike geigeigei aha mabare ebigambo byona eby'amateka aga galikugamba.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'abakuhani b'ekilevita bagambira Isiraeli yona bati, “Isiraeli, oyesize mara ohulire. Kir'eki waba ihanga ly'Omukama Ruhanga wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo orahulira ebyo alikukugambira, okwate emihangoye n'ebiragirobye ebyo ndikukuragira kir'eki.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro kyonene kyonene Musa aragira abantu ati, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kamuliba mwashabukire Yorudani, aba bemelere aha Ibanga lya Gerizimu kuha abantu omugisha: Simeoni, Levi, Yuda, Isakari, Yozefu na Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aba bemelere aha Ibanga lya Gerizimu kuraama: Rubeni, Gadi, Asheri, Zabuloni, Dani na Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abalevita baligambira Abaisiraeli bona n'eiraka lihango bati, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe omuntu abaija ekishushani anga akakijuguta: Ekinyamununge aha Mukama, ekikozirwe omubuya mara akakyemeleza ayeshelekire.’ Abantu bona bahorore bati, ‘Amina.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“N'akaraamwe alikunukuruza ishe anga nyinai. Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akaraamwe alisimbura ekihanyia kya mwataniwe. Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akaraamwe alihabisa empume omu muhanda. Abantu bona bagambe bati, ‘Amina.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“N'akaraamwe aligobeza omufuruki, enfuuzi n'entumbwakazi. Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe alijura mukaishe akabyama nawe.’ Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe alihamba ekigunju kyona kyona.’ Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe alibyama na munyanya, owa ishe anga owa nyina.’ Abantu bona bagambe bati, ‘Amina.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“N'akaraamwe alibyama na nyinaizara. Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe aliita mutahiwe bwesheleke.’ Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.24",
            "verseOrgIds": [
              "DEU.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe alitora rushwa kwita omuntu ataina ntambara.’ Abantu bona bagambe bati, ‘Amina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.25",
            "verseOrgIds": [
              "DEU.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘N'akaraamwe aliba atekomize bigambo bya Mateka aga akabihikya.’ Abantu bona bagambe bati, ‘Amina.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.26",
            "verseOrgIds": [
              "DEU.27.26"
            ]
          }
        }
      ]
