    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai iwe ogume, oyegese eby'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.1",
            "verseOrgIds": [
              "TIT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogambire abagurusi bamanye okwebalira, bagire obwelinzi, bakoze amagezi, bagume omu kwesiga n'omu ngonzi, mara batahindukana. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakaikuru nabo kutyo, obagambire bekunire omu migilire, baleke okugonza enkuru n'etamiiro. Begese ebintu birungi, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mara begese abakazi bato kugonza baibabo n'abaana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.4",
            "verseOrgIds": [
              "TIT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babe bantu b'amagezi, bagire obwera bw'omwoyo, bamanye amaka gabo, babe bafura, kandi bagire omuhuliro ahali bashaija babo, ekigambo kya Ruhanga kitaija kikagaywa. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyo ogambire abasigazi bate nibefutatira. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.6",
            "verseOrgIds": [
              "TIT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na iwe omuli buli kantu obe bulebero burungi, omu kwegesa kwawe ozoke okwo olikwegesa eby'amazima, n'okwo otalikuzana, abantu batakwetwaliliza. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu fumoro yawe batakumoga, nirwo omubisha arashonara akaburwa ekyo aratuneenaho. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abairu obagambire okugira omuhuliro ahali bakama babo, mara buli kantu bakakore kurungi. Baleke kushenga bakama babo, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okwiba obuntu obuke buke chei, bagire obwesigwa nyakabara, bakore kurungi buli kantu baihwe ahali bonene bashemelerwe ebyo balikwegesibwa ahali Ruhanga Omurokozi waitu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobona Ruhanga akagilira abantu bona ekishakye kabarokoka. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.11",
            "verseOrgIds": [
              "TIT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekisha ekyo akatujuna twamanya Ruhanga, twayejuma amairu g'ensi, twashobora kurora tuchuleire, tuli bagorogoki, twarora oburora obutakatifu omu nsi egi, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tulindiliire eshuubi yaitu enungi, nikwo kugaruka kwa Ruhanga waitu Nyamukuru mara Omurokozi waitu Yesu Kirisito omu kitinwa, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayatwehaire kutuchungura omu ntambara zona n'okweyeleza abantu abe abalikwitanira ebigiro birungi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo ebi obigambe. Kandi ohane abantu n'okubatera aha mutwe, okoze obushobora bwona. Omuntu n'omoi atalikugaya.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
        }
      ]
    }
  ],
