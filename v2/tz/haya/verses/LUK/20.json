          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agambira abegesibwabe, abantu bona nibahulira ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.45",
            "verseOrgIds": [
              "LUK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Murayelinda abeegesa b'Amateka abagenda bajwete ekanzu zirai zirai, bagonza n'okuramibwa omu katare, omu sinagogi baagonza okushuntamira entebe ezirungi muno, n'aha magenyi bashuntama omu myanya y'ekitinwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalyomejanyia amaju g'entumbwa oku nibezora kushoma enshara ezirai zirai. Balibona ekibonabonyio ekishagireho.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.47",
            "verseOrgIds": [
              "LUK.20.47"
            ]
          }
        }
