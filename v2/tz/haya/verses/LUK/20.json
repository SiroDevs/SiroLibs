            "sid": "LUK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegesa b'Amateka abo Yesu ababaza ati, “Bakugamba batai okwo Yesu aba mwana wa Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu Kitabo ky'Ezaburi, Daudi wenene nagamba ati,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
      ]
    },
    {
