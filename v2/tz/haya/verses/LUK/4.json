        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aijwire Mwoyo Mutakatifu aihurura kuruga Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
            "verseOrgIds": [
              "LUK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo amutwara omw'irungu amarayo ebiro 40 nalengesibwa Sitani. Omu biro ebyo tiyaliire kantu. Kabyahoire aliibwa enjara. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.2",
            "verseOrgIds": [
              "LUK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitani amugambira ati, “K'oraba oli Mwana wa Ruhanga, hanga eibare eli lihinduke mukate.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.3",
            "verseOrgIds": [
              "LUK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amuhorora ati, “Kikahandikwa okwo omuntu tatungwa mukate gwonkai.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.4",
            "verseOrgIds": [
              "LUK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitani aho amushutura amutwara eiguru, omw'ipokya n'omw'ibuurura akaba yamwolekire engoma zona z'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.5",
            "verseOrgIds": [
              "LUK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amugambira ati, “Ndakuha engoma ezi zona n'ekitinwa kyazo, aha rw'okuba nkazihabwa, mara nakuziha owo nayenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.6",
            "verseOrgIds": [
              "LUK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu iwe aho kawakunfukamira, ziba zawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.7",
            "verseOrgIds": [
              "LUK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amuhorora ati, “Kikahandikwa kiti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.8",
            "verseOrgIds": [
              "LUK.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agaruka Galilaya omu mani ga Mwoyo. Ensi zona ezataine Galilaya zihulira eirangalye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayegesa omu sinagogi zabo, buli muntu amutenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aija Nazareti mbali yalereirwe. Ataaha omu sinagogi nk'okwo yakagiraga, ekaba eli Sabato. Ayemelera kushoma Ebihandiko bitakatifu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.16",
            "verseOrgIds": [
              "LUK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamuha ekitabo ky'Omurangi Isaya. Ashurura ekitabo, agwamu mbali habaire ahandikire ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
            "verseOrgIds": [
              "LUK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwoyo wa Mukama anyemiremu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agya Kaperinaumu omu kigo kya Galilaya. Ashangwa nabegesa kili kiro kya Sabato; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.31",
            "verseOrgIds": [
              "LUK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "batangazibwa emyegeshezeye. Aha rw'okuba yagambisaga obushobora. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.32",
            "verseOrgIds": [
              "LUK.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu sinagogi hakaba halimu omuntu akwetwe eisitani, ataaga n'eiraka lihango ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.33",
            "verseOrgIds": [
              "LUK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otuleke! Notwenzaki iwe Yesu owa Nazareti? Ninkumanya iwe, Omutakatifu wa Ruhanga!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.34",
            "verseOrgIds": [
              "LUK.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Yesu akabukira eisitani elyo ati, “Silikwa, mara omurugemu!” Eisitani kalyamazire kukuntura omuntu ogwo omugati, limurugamu litamuhutaize. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.35",
            "verseOrgIds": [
              "LUK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batangara bona, omuntu nagambira ondijo ati, “Kigamboki eki? Enshonga amasitani nagabingisa obushobora n'amani mara nigagenda!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.36",
            "verseOrgIds": [
              "LUK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eirangalye ligenda buli hantu omu nsi egyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanduka aruga omu sinagogi, agya omwa Simoni. Simoni omwe akaba ainamu nyinazara, omushwago gumuli kubi. Bamutagiliza k'amukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amwemelera aha mutwe akabukira omushwago, gumurugaho. Niho honkai omukazi aimuka abanyegeza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo eizoba lyatobeire, abantu bona ababaire baina abarwaire aba kaishe ndwara babamuletera. Bona abataho emikono abakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amasitani garuga omuli bangi nigakunga gati, “Iwe oli Mwana wa Ruhanga!” Kyonkai agakabukira tiyagajubwire kugamba, enshonga gakaba nigamumanya okwo ali Kirisito.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwire kabwakeire, aruga omu kigo ekyo, agya aheheleire. Abantu bamuhiga balemwa bamugwamu, banga n'okumurugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenene abagambira ati, “Evangeli y'obukama bwa Ruhanga ndagiirwe kugiranga n'omu bigo ebindi, ahakuba nkatumwa kukora ekyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarangaga omu sinagogi za Buyahudi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.44",
            "verseOrgIds": [
              "LUK.4.44"
            ]
          }
        }
      ]
    }
  ],
