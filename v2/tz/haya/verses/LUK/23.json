{
  "id": "LUK.23",
  "number": "23",
  "bookId": "LUK",
  "reference": "Luka 23",
  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LUK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embaga yona eimuka etwara Yesu owa Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.1",
            "verseOrgIds": [
              "LUK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babanza kumutoijera bati, “Omuntu ogu tumushangire nashengesa eihanga, kandi natutanga kusholera Kaisari omushoro. Nayeyeta Kirisito Omukama.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.2",
            "verseOrgIds": [
              "LUK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato amubaza ati, “N'iwe Mukama w'Abayahudi?” Yesu amuhorora ati, “Wakigamba.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato agambira abakuhani bakuru n'embaga ati, “Tindikumubonaho ntambara.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.4",
            "verseOrgIds": [
              "LUK.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai bonene bakaliliza bati, “Nayohya abantu, nayegesa omuli Buyahudi yona, kubandiza Galilaya kuturuka Yerusalemu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato kuhulira atyo, abaza nka Yesu ogu ali Munyagalilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.6",
            "verseOrgIds": [
              "LUK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo yamanyire okwo ali omu butwazi bwa Herode, aba n'iwe amutwekera, nobona omu kaanya ako Herode akashangwa ali Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode kayamuboine ashemelerwa muno, ahakuba yayegombaga kumubona aha rw'okushangwa yamuhuliize, kandi yashubiraga k'amubona nakora ekitangazo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.8",
            "verseOrgIds": [
              "LUK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo amubaza ebigambo bingi, kyonkai Yesu tiyahoroire kantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.9",
            "verseOrgIds": [
              "LUK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani bakuru n'abeegesa b'Amateka bakaba baliho, nibamutoijera nibasinsimuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.10",
            "verseOrgIds": [
              "LUK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode hamoi n'abaisherukarebe bamujangura, bamujamya. Kabamazire kumujweka ebijwaro birungi, amugarura owa Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.11",
            "verseOrgIds": [
              "LUK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro kyonene ekyo Herode na Pilato banywana, aha rw'okuba kwema enyuma bakaba nibanobangana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato ayeta abakuhani bakuru n'abatwazi b'embaga, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.13",
            "verseOrgIds": [
              "LUK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abagambira ati, “Omuntu ogu mwamuleta nimugamba okwo alikushengesa eihanga. Kanamara kumumanyuruza kurungi nainywe muliho, tinamubonaho ntambara yona yona aha byo mulikumutoijera. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.14",
            "verseOrgIds": [
              "LUK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu na Herode taina kyoyamubonaho; kandi nka yamungarulira! Taliho ky'akozire eky'okumwisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.15",
            "verseOrgIds": [
              "LUK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo kamutere, nshube mutaishure.” [ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.16",
            "verseOrgIds": [
              "LUK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kikuru Pilato yaragirwaga kutaishulira embaga omufungwa omoi.]",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.17",
            "verseOrgIds": [
              "LUK.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.17",
            "verseOrgIds": [
              "LUK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bona baashana bakwese “Ihyamu omuntu ogwo, otutaishulire Baraba.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.18",
            "verseOrgIds": [
              "LUK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraba ogwo akaba aimukize orushengo omu kigo kandi aisire n'omuntu; nikyo babaire bamufungiire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato ashuba abagambira ebigambo byonene, agondize kutaishura Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.20",
            "verseOrgIds": [
              "LUK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai bashuba baashana bati, “Omubambe! Omubambe!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.21",
            "verseOrgIds": [
              "LUK.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato amubaza omurundi gwa kashatu ati, “Ahakubaki! Akozire kabiki? Inye tinamubonaho ntambara esaine kumwisa. Ndamutera kushai nshube mutaishure.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bombera kimoi bakaliliza k'amubamba. Eyombo yabo ekiza Pilato amani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.23",
            "verseOrgIds": [
              "LUK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Pilato kuramura ekyo balikwenda kikaba nikyo kikorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.24",
            "verseOrgIds": [
              "LUK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yataishura Baraba owo bamushabire, ayabaire afungirwe aha rw'okwimukya orushengo omu kigo n'okwita omuntu. Yabataishulira Yesu bamukore okwo balikwenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bamukurukumbya bamutwara. Batanganwa Simoni owa Kirene naruga omu kyaro naija Yerusalemu, bamukwata, bamutweka omusaraba kugutwara ahondeire Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bangi muno, n'abakazi ababaire nibamuchulira bahonderaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.27",
            "verseOrgIds": [
              "LUK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ahindukira abakazi abo ati, “Inywe bakazi ba Yerusalemu, muleke kunchulira. Mwechulire inywe nywenene, muchulire n'abaana banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muraleba, ebiro biliija orwo baligamba bati, ‘Baberwa abagumba, gaberwa amabere agatakazaraga baana, nangu amabunda gatakonkyaga baana gaberwa!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.29",
            "verseOrgIds": [
              "LUK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashube bagambire amabanga bati, ‘Mutukumbire;’ bagambire n'enshozi bati, ‘Mutubunde.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaraba bagira bati omuti ogubisi, lero aho ogwomire baligugira batai?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hakaba haliho abashuga abandi babili, abatwetwe kwitwa hamoi nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabagobire mbali halikwetwa Kaluvari, baba niho bamubambira, hamoi n'abashuga, omoi aha mukono gwa bulyo n'ondijo aha mukono gwa bumosho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.33",
            "verseOrgIds": [
              "LUK.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agamba ati, “Tata, singa obagarulire; aha rw'enshonga bakora ekyo batalikumanya.” Ebijwarobye babitekera enshoga kubibegana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bemelera haihi bahangire Yesu amaisho. Kyonkai abatwazi bamushekelera, bakwese, “Akarokora banu; mbwenu nayerokore k'araba ali Kirisito wa Ruhanga, endonkwa!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.35",
            "verseOrgIds": [
              "LUK.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisherukare nabo bamushekelera, bamuletera edivai y'enshalizi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.36",
            "verseOrgIds": [
              "LUK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibagamba bati, “K'oraba oli Mukama w'Abayahudi oyerokore!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha mutwegwe hakaba haliho n'ekihandiiko omu Rugiriki n'omu Rulatini n'omu Ruyahudi, nikigamba kiti, “Ogu n'iwe Mukama w'Abayahudi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoi omu bashuga bombili ababaire babambirwe nawe, ajuma Yesu ati, “Manya iwe oba Kirisito! Oyerokore naichwe oturokore!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.39",
            "verseOrgIds": [
              "LUK.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai omushuga asigaire akabukira mutahiwe ati, “Iwe totiina Ruhanga? Manya naiwe oli aha kibonabonyio kyonene kyonene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.40",
            "verseOrgIds": [
              "LUK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichwe turagiirwe kufa; twabona emperwa etusaine aha rw'ebigiro byaitu. Kyonkai omushaija ogu akozire ntambaraki?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.41",
            "verseOrgIds": [
              "LUK.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amara agambira Yesu ati, “Waitu Yesu oranyijuka k'oraba wagobire omu bukama bwawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.42",
            "verseOrgIds": [
              "LUK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ahorora omushaija ogwo ati, “Nkugambire amazima, kir'eki oraba oli hamoi nanye omuli Paradiso.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaa kazabaire zili nka mukaga, ensi yona ebundwa omwilima kuhika esaa mwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizoba likwatangana n'okwezi; orutimbe rwa Rwensinga rutaagukamu kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yesu agamba n'eiraka lihango ati, “Tata, ninkukwasa omwoyo gwange omu miikono yawe!” Kayamazire kugamba atyo omwoyo guhwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho omukuru w'abaisherukare kayaboine ebyabaho, yasingiza Ruhanga ati, “Mazima omushaija ogu yaba ataina ntambara.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abantu abasigaire bona ababaire bahurwire kutangalira ekyo, kabaaboine ebyabaho bashuba omuka nibeetera aha bifuba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bataahi ba Yesu bona n'abakazi ba Galilaya ababaire bamuhondeire, bemelera haraimu kake, babona ebyabaireho byona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba aliho omushaija nayetwa Yozefu, naruga omu kigo kimoiho ky'Abayahudi ekyayetwaga Arimatea. Akaba ali mugurusi omu rukiko, muntu murungi mara mugorogoki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ntegeka z'abagurusi b'orukiko, n'eki ekyo bakozire, wenene akaba atabulimu. Kandi yategelezaga Obukama bwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogu akwata omuhanda agya owa Pilato amushaba omubili gwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agubamburura aha musaraba, aguzinga omu kirago kya kitaani, aguhumuza omu nyanga y'orwazi, mbali omuntu n'omoi yabaire atakaziikwaga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro ekyo kikaba kili kiro ky'Okwetekateka, kandi Sabato nirwo yabaire nebanza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 23:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi ababaire barugire Galilaya na Yesu nabo bahonderaho, babona enyanga, n'okwo omubili gwahumuzibwa omu nyanga egyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
            "verseOrgIds": [
              "LUK.23.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirwo bagarukire omuka, bakatekateka omugaju n'amajuta g'okwija kusiga omubili gwa Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya Sabato bahumura, nk'okwo omuhango gwabaire niguragira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    }
  ],
