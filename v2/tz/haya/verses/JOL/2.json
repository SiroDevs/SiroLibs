          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndyoleka eby'okutangaza aha iguru n'omu nsi. Halibaho okwitangana, n'omuliro n'omwika gulikuchunka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.30",
            "verseOrgIds": [
              "JOL.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOL 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eizoba lilihinduka mwilima, n'okwezi kuliba bwamba; ebyo nibyo bilyebembera ekiro ky'amani eky'Omukama eky'kitininwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.31",
            "verseOrgIds": [
              "JOL.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOL 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai bona abashaba Omukama k'abajuna balirokoka; kuba aha Ibanga lya Sioni n'omuli Yerusalemu halibamu ab'okuhunga nk'okwo nagambire, kandi abalihonoka nibo ndigira abo narondamu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.32",
            "verseOrgIds": [
              "JOL.2.32"
            ]
          }
        }
      ]
