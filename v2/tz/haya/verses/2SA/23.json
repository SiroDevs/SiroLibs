        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nibyo bigambo bya Daudi eby'enzindo. Ebigambo bya Daudi mutabani wa Yese, ebigambo by'omushaija ayatungikirwe, enkorwa majuta ya Ruhanga wa Yakobo, omuhoyi w'empoya zinura eza Isiraeli:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga nigo mabara g'abaisherukare emanzi abo Daudi yabaire ainabo: Yoshebashebeti owa Takemoni; hakaba ali mukuru w'abashatu. Akakwata eichumulye yarashanisa abantu 800, yabaita omu kanya kamoi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikumuhondera omu baisherukare abashatu emanzi hakaba ali Eleazari eya Dodo, ow'oruganda rwa Ahohi. Akaba ali hamoi na Daudi orwo bakooleize Abafilisiti ababaire batabaire, Abaisiraeli bakairuka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenene akaimuka yatera Abafilisiti kuhika orwo omukonogwe gwalemirwe gukomera aha mbanda; Omukama akakora obujuni bungi kir'ekyo. Abantu bakagaruka kunyaga abaisirwe kwonkai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikuhondera Eleazari hakaba ali Shama eya Age owa Arari. Abafilisiti bakaba bateraniire Lehi mbali habaire hali omusiri gwijwire enkore; abantu bakabairuka, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyonkai wenene yayemelera omugati y'omusiri yagulinda, yaita n'Abafilisiti. Omukama akakora obujuni bungi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haihi n'eigesha abashatu omu bebembezi 30 bagya ahali Daudi aha Nyanja ya Adulamu orwo omutwe gw'Abafilisiti gusisiire omu Ruhanga rwa Refaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kanya ako Daudi hakaba ali omu boma, kandi orusisira rw'Abafilisiti rukaba ruli Betelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aija agira eiliho, agamba ati, “K'omuntu yakunyihiire amaizi g'okunywa aha iziba lya Betelehemu bwatana aha kihigi nkaganywa!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho abashaija bashatu emanzi baraba omu rusisira rw'Abafilisiti, bataha amaizi aha iziba lya Betelehemu bwatana aha kihigi, baija bagamuletera. Kyonkai ayanga kuganywa shana agashesha nk'ekihongo ky'okunywa, agahongera Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agamba ati, “Nikikabure, waitu Mukama, kunywa amaizi aga! Manya nakushusha ayanywa obwamba bw'abashaija aba abehoiremu bakagenda kugahiiga.” Aha rw'ekyo ayanga kuganywa. Ebi nibyo abashaija bonshatu emanzi bakozire.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishai murumuna Yoabu (nyinabo hakaba ali Zeruya) niwe yabaire ali mukuru wa balinya 30. Akakwata eichumulye yarashana n'abantu 30 yabaita, nikwo kugira eibara omu 30 ago. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu 30 niwe yaranganwaga muno, yaba mukuru wabo; kyonkai tiyagobire ahali balinya abashatu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya eya Yehoyada, omushaija emanzi ya Kabuzeeli ayakozire eby'amaani bingi, nangu yaita n'emanzi z'amani ibili eza Moabu. Ashuba asongoka aitira entare omu kiina omu bukiro bw'eseluji. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita Omumisiri, omushaija ekishoka. Omumisiri hakaba akwete eichumu, kyonkai Benaya yamugendera n'enkoni, yamwaka eichumu elye yaba nilyo amwisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.21",
            "verseOrgIds": [
              "2SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo nibyo Benaya eya Yehoyada yakozire akabona eibara omu baisherukare 30 emanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
            "verseOrgIds": [
              "2SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba ainakwo eiranga omu 30, kyonkai tiyagobire ahali balinya abashatu. Daudi amuronka amuhindura mukuru w'abalinzibe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaheli murumuna Yoabu hakaba ali omu 30; Elihanani eya Dodo owa Betelehemu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shema owa Harodi, Elika owa Harodi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.25",
            "verseOrgIds": [
              "2SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helesi Omupeleti, Ira eya Ikeshi owa Tekoa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.26",
            "verseOrgIds": [
              "2SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiezeri owa Anatoti, Mebuni Omuhushati, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.27",
            "verseOrgIds": [
              "2SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumoni Omuhohi, Maharai owa Netofa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.28",
            "verseOrgIds": [
              "2SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helebu eya Baana owa Netofa, Itai eya Ribai owa Gibea ey'Ababenjamini, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.29",
            "verseOrgIds": [
              "2SA.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya owa Piratoni, Hidai ow'obugera bwa Gaashi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.30",
            "verseOrgIds": [
              "2SA.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abialiboni Omwarubati, Azimaweti owa Bahurimu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.31",
            "verseOrgIds": [
              "2SA.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliaba owa Shaalaboni, batabani ba Yasheni, Yonatani, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shama Omuharari, Ahiamu eya Sharari Omuharari, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
