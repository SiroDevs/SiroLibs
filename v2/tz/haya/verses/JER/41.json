    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwezi gwa mushanju Ishimaeli mutabani wa Netania eya Elishama, ow'oruganda rw'abakama, omoiho omu baofisa bakuru b'omukama, aija Mizipa n'abantu ikumi, agobera Gedalia eya Ahikamu. Kababaire bali omwo omuli Mizipa nibalya ekyakulya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaeli n'abashaija ikumi abo yabaire ainabo, baimuka batema Gedalia, ow'omukama wa Babiloni yabaire ataireho kuba gavana akatwara ensi. Bakamutemesa embanda bamwita. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaeli ashuba aita Abayahudi bona ababaire bali Mizipa, abaikaraga na Gedalia, aita n'Abakalidayo abashangirweyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya kanai Gedalia aisirwe, kyonkai omuntu n'omoi atakakimanyire, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "haija abashaija kinana nibaruga Shekemu na Shilo na Samaria, bamoisize ebileju, bajwete emyendo etagwire, kandi besharashazire, balesire ebihongo by'emyaka n'obunuma, kubihonga omuli Rwensinga y'Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaeli aruga Mizipa nalira aija kubachwekera. Kayabagobire yabagira ati, “Mwije mulebe Gedalia eya Ahikamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo batahire omu kigo Ishimaeli n'abashaija eikumi abo yabaire ainabo, babaita, babaanaga omw'iziba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai omuli bonene abo harugwamu abashaija ikumi bagira Ishimaeli bati, “Otatwita, kuba twina empanika y'engano, eshayiri, amajuta n'obwoki, tubishelekire omw'ishwa.” Aba nikwo aleka atyo kubaita bonene na batahi babo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiziba elyo Ishimaeli yanagiiremu emitumbi yona ey'abashaija abo yaisire likaba lili iziba lihango ely'omukama Asa yabaire alimire orwo Baasha omukama wa Isiraeli yabaire amutabaliire. Eiziba elyo Ishimaeli akalijuza abo yaisire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba akwata abasigaire bona omuli Mizipa, abambeija n'abantu bona ababaire basigaire Mizipa, abo Nebuzaradani omukuru w'abalinzi yabaire akwasize Gedalia, yabatwara endore, yaimukya yaraba omuhanda ogulikugya omu Baamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Yohanani eya Karea n'abakuru bona b'abaisherukare abo yabaire ainabo bahulire ebigene ebyo Ishimaeli eya Netania yakozire, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakwata abashaija babo bamutabalira. Bakamushanga Gibeoni aha kitunga ekihango. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bona abo Ishimaeli yabaire ainabo kabaaboine Yohanani eya Karea n'abakuru bona b'eihe, bashemelerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyo n'abantu bona abo Ishimaeli yabaire akwete endore, abaihire Mizipa, bakubuka bagaruka owa Yohanani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaeli airuka Yohanani, asingwa n'abashaija munana, agya omu Baamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma Yohanani n'abakuru b'eihe bona bakwata abantu abandi bona abasigaire, abo Ishimaeli yabaire aihire Mizipa akabatwara endore yamazire kwita Gedalia, babagarura, babaihya Gibeoni. Bonene abo bakaba bali baisherukare, bakazi, baana n'abakobe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenda baikara Geruti Kimamu bwatana Betelehemu, bakwatilire kugya Misiri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "aha rw'enshonga y'okutina Abakalidayo, aha rwa Ishimaeli kwita Gedalia owo omukama wa Babiloni yabaire ahaire obugavana kutwara ensi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
