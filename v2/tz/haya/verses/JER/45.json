            }
          ]
        },
        {
          "text": "Omu mwaka gwa kanai Yehoyakimu eya Yosia omukama wa Yuda alire engoma, nirwo Baruku yahandikiire ebyo namugambire. Nkamugambira ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwo Omukama Ruhanga wa Isiraeli yagambire ati, “Baruku ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nogamba oti, ‘Nalemesibwa, kuba Omukama yanyongera obushasi. Nataga nagoba aha kanya, tinyina milembe!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
    {
