        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Naomi yagarukire atyo, na Ruti, Omumoabukazi, omukamwana, nibaruga omu nsi ya Moabu. Bakagoba Betelehemu omu mbandizo y'eigesha ly'eshayiri.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.22",
            "verseOrgIds": [
              "RUT.1.22"
            ]
          }
        }
      ]
