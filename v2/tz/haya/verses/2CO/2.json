          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo mboine ntaija okwo rundi kubashasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.1",
            "verseOrgIds": [
              "2CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'okuba kandabashasa, arampa ebyera n'ohai k'atali ogwo owo nashasa? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyo nshonga nkabahandikira ebarua elinya. Nkabona ntaija wanyu abakumpaire ebyera bakaba nibo banshasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabahandikira obujune bundi kubi, nindira ningashaima. Tindikugendelera kubashasa, shana ningonza kubamanyisa obungi bw'engonzi ezo ndikubagonza.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'omuntu araba akozire eky'okushasa banu, tashasize inye nyenkai. Ntatairemu gungi nakugamba nti na inywe abashasize inywena. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.5",
            "verseOrgIds": [
              "2CO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu nk'ogwo ekibonabonyio eky'abangi bamuhaire nikimumara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.6",
            "verseOrgIds": [
              "2CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo mugwelere mumuganyire mara mumumaramare, kitali kityo obujune bwakushagulirana bumukiza amani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.7",
            "verseOrgIds": [
              "2CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbatagiliza mumwoleke okwo inywe mulikumugonza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.8",
            "verseOrgIds": [
              "2CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo nabahandikiire ebarua elinya, nkaba ningonza kubalenga kumanya nk'ebyo ndikubaragira byona nimumpulira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.9",
            "verseOrgIds": [
              "2CO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena wena owo mulikugarulira, nanye kwakwo nimugarulira. Ebyo ngarulire, kaharaba haliyo ekyo ngarulire kyona kyona, mbilekire aha rwanyu omu mabona ga Kirisito ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.10",
            "verseOrgIds": [
              "2CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutanga Sitani ataija akatwihyaho magoba, ahakuba emitegoye nitugimanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
            "verseOrgIds": [
              "2CO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
            "verseOrgIds": [
              "2CO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo nagobire Toroasi kuranga evangeli ya Kirisito, Omukama yantunga akashango; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyonkai omwoyo gumbarabata aha rw'okutashangayo murumuna wange Tito. Kityo aho nirwo nabasigireho nkegendera Masedonia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Ruhanga nakasinge. Tujwangaine na Kirisito n'iwe atuha amani g'okusinga endashana. Atuha okurandisiliza Kirisito buli hantu okw'obona akataachu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobona ichwe nitushusha obunuma obulikununukage obwo Kirisito ahongera Ruhanga bukagoba abalikwesiga n'abalikwanga kwikiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalikwanga kwikiliza nibaitwa ekijunde ekilikunuka chuchuchu; kyonkai abalikwesiga, akataachu niko kalikubaha oburora. Mbwenu aho n'ohai alikwemera omwoga nk'ogu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Titulikushusha bantu bandi abali bangi, abalikutundurana ekigambo kya Ruhanga. Ruhanga ayatutumire n'iwe mujulizi waitu okwo tuli bairu ba Kirisito abalikugamba amazima.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
      ]
    }
  ],
