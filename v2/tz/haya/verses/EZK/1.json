{
  "id": "EZK.1",
  "number": "1",
  "bookId": "EZK",
  "reference": "Ezekieli 1",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
