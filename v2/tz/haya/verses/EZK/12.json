            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama shuba angambira ati, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w'omuntu, leba ab'eihanga lya Isiraeli nibagamba bati, ‘Okubonekerwa ti kwa juba, n'okurangakwe kwa irai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orw'ekyo obagambire oti, Omukama Ruhanga nagamba ati: Ebyo ndikugamba taliho kirashuba kukelererwa. Ekyo ndikugamba kirabahokwo. Alikugamba n'inye Omukama.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.28",
            "verseOrgIds": [
              "EZK.12.28"
            ]
          }
        }
      ]
    }
  ],
