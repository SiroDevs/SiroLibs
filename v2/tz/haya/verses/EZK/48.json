              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "habeyo ebihigi bishatu: Ekihigi kya Rubeni, ekihigi kya Yuda, n'ekihigi ekya Levi. Ebihigi by'ekigo byetwe amabara g'enganda za Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
