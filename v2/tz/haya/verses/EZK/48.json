              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi aga nigo galiba malembo g'ekigo: Rubaju orwa bikara, orulikuragirwa kugira emikono 4,500, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
