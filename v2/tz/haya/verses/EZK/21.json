              "EZK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akangambira ati, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w'omuntu, orange nogamba oti, Omukama ati:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.13",
            "verseOrgIds": [
              "EZK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aha rw'ekyo mwana w'omuntu, orange. Otere enganja, ab'embanda eraita ebaite, eteme kabili anga kashatu. Embanda egi neija kwita abantu ekabamara aha buka, ebatange embaju zona, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "batine muno, bangi bagwe aha bihigi byabo. Nataho embanda elikumyansa; ego, esingirwe nk'orurabyo; esingire kwita abantu ekabamara aha buka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temera kimoi ogiire obulyo anga obumosho mbali obwogi buraba bwolekeire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanye kwakwo ninyija kusharura oruganja, nyemaremu ekiniga. Ayagamba n'inye Omukama.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akashuba yangambira ati, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w'omuntu, yoleka emihanda ebili ey'embanda y'omukama wa Babiloni elikwija kuletwamu. Emihanda yombili ebe neruga omu nsi emoi. Otekeho ekibaho; okiteke mbali nyarulembo elikutandikira egiire omu kigo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyoleke omuhanda ogwo embanda erarabamu egiire Raba ey'Abaamoni, na Yuda, na Yerusalemu ekigo kina eboma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba omukama wa Babiloni ayemeleire aha iteraniro ly'emihanda yombili elikuteranira, kuraguza. Nachundachunda emyambi, naraguza aha bihuuku, naleba n'eine ly'ekitunganwa ekyatambwa ekitambo kumanya atwarwe muhandaki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mukonogwe gwa bulyo endagu nekwata Yerusalemu, abantu kubaita kayaba nibatera orusharo, ebihigi by'ekigo kubitumaho eby'okubitemberaho, kutera ensinde, n'okwombeka eminara y'okwemamu kubunda ekigo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai aba Yerusalemu endagu egi nibaija kubona etaina mazima, aha rw'enshonga y'emikataba eyo bakozire. Nawe endagu egyo y'okubaijukya entambara zabo, n'okubatatira okwo balikwija kukwatwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orw'ekyo Omukama Ruhanga nagamba ati, “Orwo mwaikara nimunyijukya entambara zanyu, amafu ganyu mwagateka aha mushana, buli omoi akamanya okwo mulikufakara, ebyo mulikukora byona mafu gashai, mbwenunu aho nabaijuka, muragagwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu iwe mutwazi wa Isiraeli omugoke omubi, ekiro kyawe kyagoba, akanya kawe kahika ak'okubona ekibonabonyio eky'amaheleruka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Ruhanga niwe alikugamba: Ojure ekilemba n'orukinga orwihye aha mutwe. Ebintu tibilikwija kwikara kwo bitura. Abagaywa nibo baija kutungikwa, kandi ab'ekitinwa bagarurwe ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatongo! Amatongo! Ekigo ninyija kukihindura matongo. Tikilimanyika mbali kyaturaga kuhika orwo mukama wakyo alija; mara ogwo ndikimuha.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe mwana w'omuntu, orange oti: Omukama Ruhanga, Abaamoni abalikujuma Abaisiraeli nabagambaho ati: Embanda! Embanda yarugire omu kiraro abantu kubaita kayaba. Bagisingire, nemyansa, nerabarabya nk'orurabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamanya ngu tolikubonekerwa kwo kwo kwo; nibalenga bati noragura ebishuba. Kyonkai byonene ebyo nibija kukomwa omu bikya by'abagoke ababi. Mara ekiro kyabo kigobire, akanya niko babone ekibonabonyio eky'amaheleruka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu garura embanda omu kiraro kyayo. Mbali watondeirwe, ensi ey'entabuko yawe nimwo ndakuramulira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.30",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyija kukumaliraho ekiniga, nkunigalire obone enaku ezitakabonekaga, mare nkunage omu mikono y'abantu abakatili abalikumanya kusilikya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oraba nkwi z'okuhemba; bakwitire omu nsi yawe, tolijukwa rundi, kuba alikugamba n'inye Omukama.”",
          "type": "text",
