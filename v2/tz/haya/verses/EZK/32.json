          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okwo niyo na Edomu eli, n'abakama bayo n'abatwazi bayo. N'orwo babaire baina amani baziikirwe omu baisirwe embanda. Baziikirwe omu batatahiriirwe; abasongoka omu nsi y'abafu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        }
