          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okwo niyo abatwazi bona ba bikara bali, n'Abasidoni bona, ababoine ekibonabonyio n'abaisirwe, aha rw'okuba bagiraga amani batinisa abantu. Mbwenu baziikirwe batatahiriirwe omu baisirwe embanda. Ekibonabonyio baboine eky'abagya omu nsi y'abafu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
