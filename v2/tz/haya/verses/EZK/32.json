          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Farao k'alibabona alyebwa enaku zamuteire afeleirwe abantube, n'eihelye lyona elyaisirwe embanda. Alikugamba n'inye Ruhanga Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
