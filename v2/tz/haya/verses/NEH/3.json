        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahonderwaho aba Tekoa, bashemeza ekika ekindi ekilebangaine n'omunara guhango ogulinda Rwensinga kulemwa kugoba aha boma ya Ofeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiguru y'Ekihigi ky'Efarasi abakuhani bahashemeza, buli omoi yashemeza ahalebangaine n'enjuye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahonderwa Zadoki eya Imeri, ashemeza omu maisho g'enjuye. Hahonderwaho Shemaya eya Shekania, omulinzi w'Ekihigi ky'Oburugaizoba. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahonderwaho Hanania eya Shelemia, na Hanuni eya Salafu (akaba ali mwanawe owa mukaga); bashemeza ekika ekindi. Hahonderwaho Meshulamu eya Berekia, ashemeza omu maisho g'ekiyumbakye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahonderwaho Malakiya, omoiho omu bahesi b'ezahabu, ashemeza kulemwa kugoba aha nju y'abalinzi ba Rwensinga n'ey'abatunzi omu maisho g'Ekihigi ky'Eiteraniro kugoba ekiyumba ky'eiguru eky'omu kekubo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugati y'ekiyumba ky'eiguru eky'omu kekubo n'Ekihigi ky'Entaama hakashemezibwa abahesi b'ezahabu n'abatunzi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
        }
      ]
    }
