            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi twayeteraho omuku buli mwaka kugira ekichweka kya kashatu ky'eshekeli aha rw'eikora lya Rwensinga Ruhanga ya Ruhanga waitu: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugura omukate gw'obusinge, ekihongo kya buli kiro ky'emyaka, ekihongo ky'okwokya ekya buli biro bya Sabato, eby'okwezi kwemire, ebintu ebitakatifu n'ebihongo by'enyatano kwatilira Isiraeli n'okukoza emiruka yona ya Rwensinga ya Ruhanga waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichwena embaga: Abakuhani n'Abalevita turata kuteka enshoga buli mwaka kumanya abaragira enkwi n'okuzileta Rwensinga ya Ruhanga waitu ez'okwokya ebitambo ebihongeirwe Omukama Ruhanga waitu nk'okwo Amateka galikuragira. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
