  "reference": "Abaroma 15",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ROM 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichwe abagumire nituragirwa kwemera obutamosho bw'abalikuyuga, tuteshemeleza ichwe chwenane. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichwena tushemeleze bataahi baitu aha rw'obuge bwabo kubombeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.2",
            "verseOrgIds": [
              "ROM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba Kirisito tiyayeshemeleize. Ekiliho nk'okwo kyahandikirwe, “Ebijumi by'abakujumire byabendabendera inye.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobona ebyakahandikirwe obwa karai bikahandikwa kwegesa ichwe tubone kugira eshubi aha rw'enshonga y'Ebihandiko Bitakatifu kutugumisa n'okututamu ekihika. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga atugumisize mara akatutamu ekihika abatunge omuturanwa gw'emilembe omuli Kirisito Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mubone kwema hamoi omw'iraka limoi kusingiza Ruhanga mara Ishe Omukama waitu Yesu Kirisito.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo mukundangane nk'okwo yakunzire inywe, aha rw'ekitinwa kya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbagambira okwo Kirisito yabaire mukozi w'abatahiriirwe kuhamisa ebyo batat'enkurw'ichwe baraganisiibwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Abanyamahanga babone kusingiza Ruhanga aha rw'obuganyizibwe. Nk'okwo kyahandikirwe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga, entabuko y'eshubi akanyise ebyera n'emilembe omuli inywe inywena aha rw'okwesiga kwanyu, mubone kugira eshubi nyingi omu mani ga Mwoyo Mutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumuna bange, inye nimanyira kimoi okwo muli bantu barungi bwoli, nimumanya buli kantu mara nimushobokerwa kwegesangana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai aha bigambo ebindi mbahandikiire n'amani gangi kubaijukya, aha rw'ekisha ekyo Ruhanga yangiliire, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba mukozi wa Yesu Kirisito omu Banyamahanga. Nindanga evangeli ya Ruhanga nk'omukuhani, ekihongo ky'Abanyamahanga, nibo Banyamahanga bonene abo Mwoyo Mutakatifu ahindwire batakatifu, kibone kwikilizibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho nyina enshonga y'okwebuga omulimo gwange ogwo ndikukolera Ruhanga omu mani ga Kirisito Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.17",
            "verseOrgIds": [
              "ROM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'okuba tindikwija kuziza kugamba kyona kyona shana ebyo Kirisito alikugamba omu kanwa kange, abone kushoboza Abanyamahanga kumuhulira omu bigambo n'omu bikorwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.18",
            "verseOrgIds": [
              "ROM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu mani g'obubonero n'ebitangazo, omu mani ga Mwoyo Mutakatifu. Nzingoire kwema Yerusalemu nagoba Iliriko, nindanga kabutekire evangeli ya Kirisito. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.19",
            "verseOrgIds": [
              "ROM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nyitanira obutosha kuba kuranga evangeli mbali Kirisito atakahulirwaga, ntaija nkombeka aha musingi gw'ondijo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'okwo kyahandikirwe kiti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo nshonga eikara nentanga kubagobaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai mbwenu orwo namazire omulimo gwange omu mikoa egi, mara n'okwo emyaka nyingi ntura n'inyegomba kubagobaho, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninshubira kubabona orwo ndaba ningya Hisipania, ninshubira n'okwo muranshagarayo, kyonkai mbanze mbakyalire buzima akaanya kake. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai aha rwa mbwenu aha ningya Yerusalemu kutwalira abakirisito bataahi baitu eshumbusho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masedonia na Akaya bategekire kugira ebyo babonera abakirisito bataahi baitu abetaage ba Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.26",
            "verseOrgIds": [
              "ROM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitegekire, mara mazima baragiirwe, aha rw'okuba k'Abanyamahanga baraba bakunzire ebirungi byabo by'omwoyo, na bonene kwakwo baragiirwe baheho Abayahudi ebyo bainabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo orwo ndaba namazire ekigambo ekyo, nkamara kuheleza ebigizirwe, ndabaletwaho orwo ndaba ningya Hisipania. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara nimanya okwo orwo ndaija okwo ndaija n'emigisha ya Kirisito ekinje. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumuna bange nimbatagiliza mbataireho Omukama waitu Yesu Kirisito n'engonzi ezilikutabuka ahali Mwoyo, tweme hamoi kushoma enshara n'amani, munshabire ahali Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbone kukira aha bataikiliza ba Buyahudi, n'eikora lyange aha bakirisito bataahi baitu aba Yerusalemu libone kubashemelera. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga k'arayenda ndashemelerwa kubagobaho mara mbaikareho nyikyemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga entabuko y'emilembe abe nainywe inywena. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
          }
        }
      ]
    }
  ],
