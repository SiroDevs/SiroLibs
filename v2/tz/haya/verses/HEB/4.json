      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Ruhanga akyatushuubiza okwo tulihumulira omuli wenene, twelinde omuntu n'omoi omuli inywe atalija akagwerwa mushango akalemwa kuhumulira omuli Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba evangeli eyo twarangiirwe niyo yonene yonene eyo barangiirwe. Kyonkai ebyo bahuliire tibyabagasire kantu, nobona bakabihulira kushai, tibabikiliize. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulibona obuhumuro obwo ichwe abaikiliize nk'okwo Ruhanga wenene yagambire ati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonu tutemu amani kutaaha omu buhumuliro obwo tukaikya, omuntu n'omoi atalija akagwerwa mushango aha rw'okutahulira nk'okwo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba ekigambo kya Ruhanga kiina oburora n'amani, nikishara kushaaga embanda y'amogi gabili. Nikichumita nikigoba mbali omwoyo n'amagezi biteranira, mbali engingo ziteranira n'eminoita, kimanya eby'omutima gulikutekeleza n'ebyo gulikugendelera. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitondwa ekyo Ruhanga atabona tikibayo. Byona nabibona geigeigei, kabutekire. Tulimwetondera obusigire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu orwo twagizire Omukuhani Nyamukuru ayagiire omw'iguru, n'iwe Yesu Omwana wa Ruhanga, tugume muno omu kwesiga kwaitu okwo twebuga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twina Omukuhani Nyamukuru alikutumanya obujege bwaitu, akalengesibwa omu ngeli zona nka ichwe, kyonkai tiyakozire bufu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tugiire nu obwesige, tugye aha nketo ya Ruhanga mbali ekisha kisingiire, tugende atuganyire, atugilire n'ekisha ky'okutujuna omu bwetage bwaitu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
