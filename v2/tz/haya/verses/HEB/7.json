          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhango ogwa karai nigurugaho aha rw'obujege bwagwo n'okutagira mugasho ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.18",
            "verseOrgIds": [
              "HEB.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(kuba Amateka tigahindura muntu kuba muhikiilire); aha rw'okuba eshubi enungi kushaaga ey'okututwara ahali Ruhanga twagiboine.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
