            "sid": "EZR 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee hhay Binui a tí: Shimei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.38",
            "verseOrgIds": [
              "EZR.10.38"
            ]
          }
