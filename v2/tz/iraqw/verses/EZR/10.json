          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Maknadebai, nee Shashai, nee Sharai, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.40",
            "verseOrgIds": [
              "EZR.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
