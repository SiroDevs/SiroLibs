          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Benaya, nee Bedeya, nee Keluhi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.35",
            "verseOrgIds": [
              "EZR.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Wania, nee Meremoti, nee Eliashibu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.36",
            "verseOrgIds": [
              "EZR.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
