          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee hhay Nebo a tí: Yeieli, nee Matitia, nee Sabadi, nee Sebina, nee Yadai, nee Yoeli, nee Benaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.43",
            "verseOrgIds": [
              "EZR.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
