          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Asareli, nee Shelemia, nee Shemaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.41",
            "verseOrgIds": [
              "EZR.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZR 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Shalumu, nee Amaria, nee Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.42",
            "verseOrgIds": [
              "EZR.10.42"
            ]
          }
        },
        {
          "name": "verse",
