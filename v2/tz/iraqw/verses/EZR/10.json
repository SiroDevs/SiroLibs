          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Shelemia, nee Natani, nee Adaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.39",
            "verseOrgIds": [
              "EZR.10.39"
            ]
          }
        },
