            "sid": "EZR 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Matania, nee Matenai, nee Ya'asu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.37",
            "verseOrgIds": [
              "EZR.10.37"
            ]
          }
        },
