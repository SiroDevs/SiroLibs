          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Gawaá adoorihe, adoorí dír kuúnguú waawutmoowo bir qoón, didá' muruú inslaslángw wa hariím oo waawutmo kway babatsi baraá gixsár Babuloniro kingi leeleehhi nee ka ari, áx waawutmo Koreshi tlehhmuuwú doó Mungú gwaa oói. Nee waawutmo adór i slai ngi ooi daanduú kaangwihe.»",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.17",
            "verseOrgIds": [
              "EZR.5.17"
            ]
          }
        }
      ]
    }
