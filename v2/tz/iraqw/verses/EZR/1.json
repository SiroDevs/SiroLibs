              "type": "text"
            }
          ]
        },
        {
          "text": "Kurkú geera oo waawuti'iimár Koreshi, waawutmoó yaamaá Persia, as axweesantadá' AAKOÓ MUNGÚ aa oó' ar afkú aarusmo Yeremia iwa bo/, AAKOÓ MUNGÚ muunuú waawutmo Koreshi oo Persia guri gwarangwaár, inós afo gari ilahaniís baraá waawuti'iimarós sleémeero, sleeme gay gooín, iwa kaahi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
