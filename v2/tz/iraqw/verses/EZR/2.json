            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "70",
            "style": "v",
            "sid": "EZR 2:70"
          },
          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy kaahamuuse nee múk tlahhoó Laáwi, tana hoót baraá gixsár Yerusalemúr wa ale. Ala daauuse nee xuumuuseero nee sagadiyuusér Doó Munguhe tana hoót baraá gixsaduín wa alé, nee tam múk Israeli sleémeero ina hoót baraá gixsaduín wa alé.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.70",
            "verseOrgIds": [
              "EZR.2.70"
            ]
          }
        }
      ]
