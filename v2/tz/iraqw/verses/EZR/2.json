          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagadiyuusér doó Mungú dinkwa nee na/aá sagadiyuusér Solomonuwo a tsiire tám mibeeri gwaleél nee tsár.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.58",
            "verseOrgIds": [
              "EZR.2.58"
            ]
          }
        }
      ]
    },
