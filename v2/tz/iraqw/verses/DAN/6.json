              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Aníng kuungá' nu wayduú úr i slaá'. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
