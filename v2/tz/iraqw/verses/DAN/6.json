              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo waawutmo Dario barwiito'o gari gooín amór tlahh'aá muu sleémeero nee xoordu nee tsifri sleémeero,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
