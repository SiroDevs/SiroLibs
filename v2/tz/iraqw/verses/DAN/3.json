              "DAN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo Nebukadnesa iri waa/oó/, iri sihhiít ar gaanslaay, mukós kudá' gu gurbu'uúm guri báy, «Xaysé' mukdá' taa kwahhaán a tameekáhe oo taa tsegiít?»",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari oó', «Eeit waawutámo, a ló'.»",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
