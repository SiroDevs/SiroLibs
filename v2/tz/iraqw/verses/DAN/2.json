              "DAN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli iri daqáy dír Arioko, kudaádá' taa qaás nee waawutmo as múk sageeloén oo yaamaá Babuloni nguwa tsu/i, guri báy, «Múk sageeloén oo Babuloni mu tsu/aar, án dahaasáng ay amór waawutmo, daqaní aníng tlataá waawutmo i waagweér.»",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.24",
            "verseOrgIds": [
              "DAN.2.24"
            ]
          }
        }
      ]
    },
