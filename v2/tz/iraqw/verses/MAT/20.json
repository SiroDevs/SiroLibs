        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár tawa Yerikór wa tláy, Yesu kuri eehár nee boo/oó úr. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naxés mukko tsár oo taampu aa iwiít afaá loohi. Inooín ngiwa axaasiyé' Yesu in waaraahh, tari tseé' ar afór ur, tari oó', «Aáko, Garmoó Daudi, atén ti gurtleer.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
