            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu guruuwós iri tláy, ilaaín giri kwatiít. Siiwadár kilae ilaaín niri qaytsitiyé', Yesu kuri eehár.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
