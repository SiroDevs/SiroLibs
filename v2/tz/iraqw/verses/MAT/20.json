              "MAT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu iri sihhiít, mukduú taampu guri ateét, giri báy, «Adór ta sla'a' ar nu laaq a adoomá?»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        }
      ]
    },
    {
