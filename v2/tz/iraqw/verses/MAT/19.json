          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masoomoodá' /aymuudá' nguwa axaás, iri quútl ar gurhaami, asma inós a ló'wa daqaarmo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
