              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeharuuse adoodá' ngiwa axás, iri waa/ó/ ló'wa ale, iri ó', «Barqo adoosíng ala heé ba/ám a heemá?»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu eeharuuse gari i qaytsiít gari báy, «Dír muko adoosíng i ya/aandaaká, ala dír Munguhe umuúqo gaaro i ya/aán.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro iri oó', «Qaytsiít, xáy atén mura' sleémeero ugwa geexawaán, kuúng uri eeharaán, gár atén ta slawaan a milá?»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu giri báy, «Án a kah, kuungaásingá' aníng iga eehade', baraá yaamuudá' /aben, kudá' Garmoó Hee iwa iwiiti gawaá kitangwduú xirfuuwós, kuungá' sleeme a iwitá' baraá kiteeriidá' mibaá nee tsár, tlahhi'iidá' mibaá nee tsár awa múk Israeli kiri sakwasleemutá'. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Slám malé alé umuúqo heewo oo do'ós gwa geexay, laqaá qaymo, laqaá hhiya', laqaá hho'o, laqaá baabá, laqaá aayo, laqaá na/ii, as aníng, muruuwí sleémeero gu sagaáwa tsiiru wa ilaoh, nee slafíngw alhhe'eesay wásl guri aal. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala baraá kudá' geeraá hara'a, awa yaariir i alií ki/iyá', nee kudá' alaá hará', ta geerií waaraahh.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
            ]
          }
