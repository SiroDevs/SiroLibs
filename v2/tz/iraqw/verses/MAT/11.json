          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma taaqwante'eé' i natsaatsá' nee huwar'eé' ka inslaahh.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.30",
