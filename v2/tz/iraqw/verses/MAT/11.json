          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Qwalaasé' amor'eé' kuungá' sleémeero awa daawiimitá' nee awa huwa aa al iiloouúr, án kuungá' nu hungu/uús. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        },
        {
          "name": "verse",
