            "number": "29",
            "style": "v",
            "sid": "MAT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taqwante'eé' gawaá sum'iihúngií qaasaak, dir'eé' wa intsatsaahhaak. Asma aníng ti tsatsaa'aár, nee muunaáeé' ku gurhhoó'. Daqaní kuungá' amohhooa a sleerá' baraá munerhunge. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
