        },
        {
          "text": "Qoomaadae Yesu iri axweés iri oó', «Aníng kuúng u sluufiís, Baabá, Aakoó doori nee yaamu, asma muruuwí ugwa lú/ dír múk sagalooár kooma nee fuquraangw, kuri laqaán dír na/aá ninakw. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeít, Baabá, asma adoorí an adoodá' kuúng kara slá'.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
          }
        }
      ]
