              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma kuungá' sleémeero a na/aá Mungú asma Yesu Kristo ugwa haratlintié'. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
          "name": "verse",
