          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma kuungaásingá' sleémeero awa taa haragaás nee Kristo ar loohír baatiísmo, kuungá' Kristo ugwa tsité' adór inqwaarír wa ale. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
