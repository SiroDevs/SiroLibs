            "sid": "GAL 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hám daxta, kuungá' hhaee'eé', kuungá' a adór Isaka, asma kuungá' a na/aá Mungú as al'axweesantós tidá' aa geerií oó'. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.28",
            "verseOrgIds": [
              "GAL.4.28"
            ]
          }
        },
        {
          "name": "verse",
