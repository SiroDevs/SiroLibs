              "type": "text"
            }
          ]
        },
        {
          "text": "Kuká' an geeraharuusér guruú doó múk Hori: Lotani, nee Shobali, nee Sibeoni nee Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
