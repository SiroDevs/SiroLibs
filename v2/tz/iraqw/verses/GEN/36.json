              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Dishoni, nee Eseri nee Dishani. Kuká' an geeraharuusér guruú doó Hori baraá yaamaá Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
