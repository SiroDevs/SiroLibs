            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barnaxes awa kooán naa /aaruyé' baraá kudá' mibeeri kooán awa hota ganaa'a'a, xáy, gixsa sleémeero an qwaarésa as kudá' kooán naa /aaruye'?»",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
