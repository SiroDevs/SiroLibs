              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu iri ilawaáts, iri oó', «Aga qo qiítl nee Aako tawa axweesaan, aníng aqo adór teeri nee da/ara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
