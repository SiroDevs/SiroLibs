              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ iri oó', «Baraakaá gixsár Sodomaro múk mibeeri kooán oo hota ganaá' bura ár, umuúqo diiro an máw as inooín.»",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
