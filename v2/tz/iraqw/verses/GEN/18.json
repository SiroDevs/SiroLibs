              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ iri oó', «A qwaareesaaká baraakae awa mibeeri tsiyáhh nee kooán bir dayá'.»",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
