            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baldár kilae Isaka sagadiyuuseerós guna i hardát, ngway kángw hhalangwdá' bayé', kudá' naa fooliyé', tawa kaahi, «Ma'aay iga slawaán.» ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka hhalangwdá' guri báy Shiba, gawaá adoorihe umuú gixsadá' a Be'er-sheba",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:33",
              "type": "text"
            },
            {
              "text": "Be'er-sheba:",
              "type": "text"
            },
            {
              "text": "Gídaabá hhalángw lo'o laqaá hhalángw múk faanqw.",
              "type": "text"
            }
          ]
        },
        {
          "text": " tam ay laarí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
    },
