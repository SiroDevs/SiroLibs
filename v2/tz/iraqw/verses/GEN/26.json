          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau kureeriiwós tawa mibeeri tsiyáhh, /ameenár tsár gana duxuút ar tlahhoó Hiti, Yuditi dasír Be'eri, nee Basemati dasír Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ameenaarí hotángw Isaka nee oo Rebeka guri tli/ís.",
          "type": "text",
