          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka a aakoó aa uray, diimay gway daáhh, kuri foól nee daaqaywós Esau nee Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
            "verseOrgIds": [
              "GEN.35.29"
