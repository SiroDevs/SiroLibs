          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo Penieliro iwa waraahhi looa naa qaroó tsiiríhh, inós i soopín asma kutl/umoodá'. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
