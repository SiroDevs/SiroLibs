          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo umuú didá' guri báy Penieli, i kaahi, «Nee Mungú taa araán ila nee tí, ala aníng a slaáf.» ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
