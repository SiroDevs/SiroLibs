            "number": "25",
            "style": "v",
            "sid": "JHN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inós lamabu'úngw heé i slai i kaahh daanduú heewo. Asma tidá' baraá muunuú heé i dirii' inós gaa qaroó xuú'.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
