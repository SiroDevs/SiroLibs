              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro iri alií warqáy, eeharusmoodá' Yesu aa slaá' guri ár, naxés aa eeharín. (Inós an kudá' aa tlintii' gawaá da/eewaá Yesu qoomár muruú /aymár tsiindoowo. An kudá' aa oo', «Aáko, a heemá heedaádá' kuúng u sakií/?») ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
            "verseOrgIds": [
              "JHN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro eeharusmoowí nguwa ár, Yesu guri báy, «Aáko, kwí a adoomá?»",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        }
      ]
    },
