      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu iri oó', «Daxta iga haratlintí' asma iga aán. Múk amohhoó' a kudá' ga haratlintatií' tam iga ariikahe.»",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        }
      ]
    },
