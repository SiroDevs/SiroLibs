              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy waawutmo Hesekia iri warqáy amór koo/i, AAKOÓ MUNGÚ guri firín, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "iri oó', «Aá AAKOÓ MUNGÚ, án kuúng u harhheehhe'eés, na'amaamís, adoodá' aníng kuúng ura sagadiyumaamiís ar inkihhimu inslaweek, slám ar muunaáeé' sleémeero, nee muruú qoóm una tlehhahhiít dír geeraawoge.» Hesekia Mungú guri ló'wa ii /aa/amín.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
