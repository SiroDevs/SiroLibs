              "ISA.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee múk doó baabuúwós nee xwaylarose inós kuri harahhiif, adór xooslár hutli'i nee slooqi'i awa ta tarereé' gawaá mogoolmo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.24",
            "verseOrgIds": [
              "ISA.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Baalaadae kiki'idá' ta slaáhh dír kawa saxmaár bira tununu/út, geeraharu'uumarós aqo kan hingees, nee huwaadár gawaawós aqo kan amór saáwí kwaahh, asma anuú AAKOÓ MUNGÚ tí gaa oó'.› »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
      ]
