          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Bu'úngw hhó' oo geera oo balaangw baraá yaamuuhunge un hubá' baraá doó AAKOÓ MUNGÚ Munguúhúng.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
