              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Tseerér gár taa ilahhooar'eé' wa gaás mingi hanisara' dinkwa nee mikaátér taa sluuftís, nee sleeme ilahhooadár gár taa gaás ar deelór Pasaáka ma meetisaara' ay matlaatle.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        }
