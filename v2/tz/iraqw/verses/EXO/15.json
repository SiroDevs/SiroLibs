              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Mose nee xoorór Israeli AAKOÓ MUNGÚ kuri daa'angwí daá',",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
