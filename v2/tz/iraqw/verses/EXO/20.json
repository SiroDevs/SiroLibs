              "EXO.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Umuú AAKOÓ MUNGÚ, Munguúwók, mu tawo axweesaar, asma AAKOÓ MUNGÚ heé umuuwós gu tawo axweés gu gan'amií harafaariiká.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 20:7"
