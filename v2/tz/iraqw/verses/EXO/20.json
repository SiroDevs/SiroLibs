          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Baabuúwók nee aayoorók ilaiwawa/eek as slafíngw kureeraá yaariir kuwa sleer baraá yaamuudá' AAKOÓ MUNGÚ Munguúwók ni kuúngí haniisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
    },
    {
