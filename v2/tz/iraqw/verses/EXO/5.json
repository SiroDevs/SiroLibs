              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.21",
            "verseOrgIds": [
              "EXO.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose iri kií/ amór AAKOÓ MUNGÚ iri oó', «Aá AAKOÓ MUNGÚ, ahaá waáy mukwí musa kaangwí tlákwií tléhh? Gár aníng isa ya/áp? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.22",
            "verseOrgIds": [
              "EXO.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
