          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kitaáni nee angaánoó shayiíriro tluwaydá' gaa ló'wa hhitín, asma qoomaadae angaánoó shayiíri aa hamaár nee kitaáni i baraá /ayór i dirí'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
