          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala angaáno nee daa'awtá hatlae naa hhitiruti'iiká asma ki ninakw.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
