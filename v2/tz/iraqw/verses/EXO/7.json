              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ Mose guri báy, «Aroni ku beer, ‹Hhartók taatahheek, gáwtí tleeseek gawaá ma'aá yaamaá Misri, gawaá ya'aá Misri nee mapeero, nee tlahheeso, nee tlahheesooín sleémeero awa taa tlehhiiti, sleémeero niri tseerdu tleehhitiyá' baraá yaamaá Misri sleémeero, tam kudaá baraá xooslaá xaai nee awa tlaa/eewo.› »",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose nee Aroni adoodá' AAKOÓ MUNGÚ aa oó' kari tleéhh. Hhartós gari gáwtí tleés, ma'aá yaaeedá' giri slaáhh dír geeraá Farao nee geeraharuuseerós wa ale, ma'aydaá baraá yaae niri tseere tleehhitiyé'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyó baraá yaaeedá' iri qaátl, yaaeedá' iri díx. Múk Misri ma'aydá' giri harslaaqaát wahaango, nee tseereedá' yaamaá Misri giri aleetsát. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.21",
            "verseOrgIds": [
              "EXO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala qwaslaarér yaamaá Misri adoodár kilá' gana tléhh ar miislay'ín. Naagáy muunuú Farao iri gawdúy, tam inooín gaa iiárií qaasiiká, adoodá' AAKOÓ MUNGÚ ngira oó'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao iri warqáy iri waátl amór do'ós, tam tí sleeme gaa gaárí xuiiká. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk Misri sleémeero afaá yaaér Nili kiri qorqorín as ma'aá wahaangw kiwa slay, asma ma'aá yaaér Nili waha ngiwa ya/ana'aaká.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        }
      ]
    },
