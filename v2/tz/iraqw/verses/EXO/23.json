        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Tseerér makiito'ór tinda ilahhooar'eé' wa gaás mingi mukatmoó taa sluuftís alhanisara', nee slám di/tadá' tinda haniís as deelor'ee' ar ur miwa mét ay matlaatle.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
