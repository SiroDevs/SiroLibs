          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Deelór ur ar balangwhúng",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:16",
              "type": "text"
            },
            {
              "text": "Balangwhúng:",
              "type": "text"
            },
            {
              "text": "Laqaá Isleeri",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuwa burumburiinda' an tlehhá' umuú kurko, qoomár bar bu'úngw gadiyérhúng burumburiindá'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki/ima tám baraá kurko hhawaate ni dír geeraá Aakoó Munguúwók i hardarahiye'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
