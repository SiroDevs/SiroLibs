          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Tam deelmoó niiná oo du'uúm mu humiimara' baraá ilwaá aayorós. »",
          "type": "text",
          "attrs": {
