          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Mamaá geera awa baraá qamuuhúng dahhá' huwaare' baraá doó AAKOÓ MUNGÚ Munguúhúng.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
