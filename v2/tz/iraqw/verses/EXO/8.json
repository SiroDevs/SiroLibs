              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Mose iri dír Farao wa tláy, AAKOÓ MUNGÚ guri firín. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
