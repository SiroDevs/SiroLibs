        },
        {
          "text": "Naagáy Farao Mose nee Aroni giri ateét, giri báy, «Tlawsé', Mungú ilahhooárí hanisaak baraá yaamuuká' kilá' wa ale.»",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
