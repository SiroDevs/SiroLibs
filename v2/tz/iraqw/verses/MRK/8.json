          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri báy, «A faanqw.»",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.20",
            "verseOrgIds": [
              "MRK.8.20"
            ]
          }
        }
