          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Hobabu Mose guri báy, «Aasla'áy, aníng nee kuungá' ti alkoomanaaká, ala aqo an kií/ baraá yaamuueé' nee amór hhaee'eé'.»",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
            "verseOrgIds": [
              "NUM.10.30"
            ]
          }
        }
      ]
    },
    {
