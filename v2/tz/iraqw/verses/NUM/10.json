          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoorí an digir wakeetíngw taa eehár nee múk Israeli ar adoodá' bohhuuín i dirii'iya', umuú daqto bar ta xafay'ín fe/iit, bar ta lolohín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
            ]
          }
        }
      ]
    },
    {
