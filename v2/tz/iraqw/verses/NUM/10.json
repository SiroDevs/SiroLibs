              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy tari tláy didár tloomár AAKOÓ MUNGÚ wa ale, deelo tám ta baraá aai, sandakmoó alqadór AAKOÓ MUNGÚ ku geeraaín wa loohiis deelo tám as dír xafay'ín kuy tleehhi kawa laqan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
