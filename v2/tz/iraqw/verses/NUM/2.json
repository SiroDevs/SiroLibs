          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy tlahhoó aluudá' gi haár a Benyamini. Geeraharusmoó tlahhoó Benyamini a Abidani garmoó Gideoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boohharós adoodá' kara faari a hhawaate kume mibeeri tám nee kooán, nee tsiire tsiyáhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
