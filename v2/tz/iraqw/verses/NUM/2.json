            }
          ]
        },
        {
          "text": "Boohharós adoodá' kara faari a hhawaate kume mibeeri kooán nee tám, nee tsiire tsiyáhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
