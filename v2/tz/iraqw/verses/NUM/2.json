            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ Mose nee Aroni gina i axweés, giri báy, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Múk Israeli xafay'ín ngu tleehhiye', umuú hee i hooti didá' bendeérarós kay sihhtís tawa layár tlahhay'ín, xafay'ín ngu tleehhiye' as heémár Mungú ngiwa harweeriya'.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
    {
