          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boohharós adoodá' kara faari a hhawaate kume mibeeri tsiyáhh nee tsiire kooán. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
