          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy, tlahhoó aluudá' gi haár tay oo Naftali. Geeraharusmoó tlahhoó Naftali a Ahira garmoó Enani. ",
          "type": "text",
          "attrs": {
