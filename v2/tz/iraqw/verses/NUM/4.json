              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faaror'ín ar adoodá' gur'ér maray'ín i diria a muu kume tsár nee tsiire faanqw nee mibeeri kooán. ",
          "type": "text",
          "attrs": {
