            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hhawaate sleémeero faareek iimír awa kureeri mibeeri tám wa oohang nee ay awa kureeri mibeeri kooán, kudá' hariimá' baraá gadiyeérír heémár Munguhe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
          "name": "verse",
