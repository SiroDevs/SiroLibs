              "type": "text"
            }
          ]
        },
        {
          "text": "«Múk guruú doó Merari faareek sleeme ar adór gur'ér maraá baabi'ii'ín i diri'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
