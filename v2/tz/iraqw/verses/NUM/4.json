            "number": "31",
            "style": "v",
            "sid": "NUM 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadiyér'ín sleémeero a tí: Nahhtá heémár Mungú ngin loohisiyá', nee waqasuuwo, nee uheemiiwo, nee yukmáy'ine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
