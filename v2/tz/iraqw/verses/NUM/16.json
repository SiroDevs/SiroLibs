          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.21",
            "verseOrgIds": [
              "NUM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Mose nee Aroni tari gur'ér qaqtín tawa kaahi, «Aá AAKOÓ MUNGÚ Kudaádá' oo slafíngw muu sleémeero, xáy heé wák bira dakuús, aqo xooro sleémeero an i búhha?»",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        }
      ]
    },
    {
