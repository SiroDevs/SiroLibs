      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ ina axweés dír Mose, iwa kaahi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.23",
            "verseOrgIds": [
              "NUM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Muu ádbawaak, ta suruuki dír heémár Korawo, nee ar Dataniwo nee ar Abiramuwo.»",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        }
      ]
    },
