            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaangwí an kaahidá' AAKOÓ MUNGÚ aa hara'ayín dír Mose daanduú hhawaata nee hareerós, nee baabá nee dasiirós qoomár kawa niiná iwa doó baabuúwós i kahh.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
