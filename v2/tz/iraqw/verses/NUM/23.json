              "NUM.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo Balaki iri oó' dír Bala'amu, «Qwaláng, u huúw amór hatlá', dooqa Mungú i ya/án amoodae mukwí ku lu'ús as daanduueé'.» ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy, Balaki Bala'amu guri ar tláy ay gawaá ságw tloomár Peori, tidá' nee xaanxaay ti ga/aawá'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bala'amu iri oó' dír Balaki, «Kiteeraá faanqw awa ilahhooa tleehheek, nee awér faanqw ka amohhe'és, nee gwaandaawér faanqwe as aníng.» ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki adoodá' kwaa báy nee Bala'amu gari tleéhh, awu nee gwaanduwo giri haniís umuúqo dír kitángw ilahhooaro.",
          "type": "text",
          "attrs": {
