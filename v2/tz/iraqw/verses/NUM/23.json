            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bala'amu iri oó' dír Balaki, «Kuúng meét dír ilahhooarók tír da/a, aníng an tláw amór gayuuqá' as nee AAKOÓ MUNGÚ tiwa doogaan.»",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        }
