        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
