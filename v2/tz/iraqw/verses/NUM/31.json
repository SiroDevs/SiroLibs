              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tlaqtá boohhadá' taa haniís dír múk Israeli, tidá' Mose aa paraátl dír tooaáng taa slaqwaruuseérí haniisi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
            "verseOrgIds": [
              "NUM.31.42"
            ]
          }
        },
        {
          "name": "verse",
