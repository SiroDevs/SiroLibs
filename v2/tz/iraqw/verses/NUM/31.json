          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee dasuudá' nee hhawaate taa alqatiiká a kume mibaá nee lahhoó'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraá qoomayduú tlaqi oo taa múk Israélírí haniisi, Mose baraá haasaánguú hikwaá mibeeraá kooane, nee baraá haasaánguú múk mibeeraá kooane, ar wák gana haniís dír tlahhoó Laáwi, kudá' gadiyumaamisá' baraá heémár Mungú wa ale, adoodá' AAKOÓ MUNGÚ ngira hara'ayín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
