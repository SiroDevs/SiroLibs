          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ ina axweés dír Mose, iwa kaahi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Aroni nee daaqaywós ki beer, ‹Adoorí an adór múk Israeli kur tsuuquunda'!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
