{
  "id": "EPH.2",
  "number": "2",
  "bookId": "EPH",
  "reference": "Efeso 2",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
