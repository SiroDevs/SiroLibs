          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aníng iri mu/aywaáts, iri báy, «Hám aqo xu'ukáhe.»",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        }
      ]
    },
