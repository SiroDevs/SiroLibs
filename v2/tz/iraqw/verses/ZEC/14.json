            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalaadae gawaá mitingaroó farsuuwo /aymi'iiká' kin gooín, i kaahiya', «Kaa hhoohhoeés as AAKOÓ MUNGÚ.» Hutli'idaá baraá doó AAKOÓ MUNGÚ tay adór slooqi'idaá gawaá kitangwduú ilahhooa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuúqo hutlaywo baraá Yerusalemuro, nee baraá Yudawo kuri hhohhoees as AAKOÓ MUNGÚ Aleesleemusmo, gawaá adoorihe, heedaádá' ilahhooár muruú ta tsu/i ga hanmiís niri hardah, hutli'iidá' giri taataahh giri fu'uunaá ilahhooár muruú ta tsú/ír humín. Qoomaadae heé halaanu'uumár tleéhh baraá Doó AAKOÓ MUNGÚ Aleesleemusmo wa alé i kaahh.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.21",
            "verseOrgIds": [
              "ZEC.14.21"
            ]
          }
        }
      ]
    }
