              "type": "text"
            }
          ]
        },
        {
          "text": "Mose tlaqtá tlahhoó Manase sleeme gana yaamaá aalírí sláy ar adoodá' múk dooín i dirii'i. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
