          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Shimron-meroni, nee oo Akshafi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.20",
            "verseOrgIds": [
              "JOS.12.20"
            ]
