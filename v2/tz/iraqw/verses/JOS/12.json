          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Libna, nee oo Adulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.15",
            "verseOrgIds": [
              "JOS.12.15"
            ]
          }
        },
