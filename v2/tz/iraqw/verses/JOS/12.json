          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Egloni, nee oo Geseri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.12",
            "verseOrgIds": [
              "JOS.12.12"
            ]
          }
        },
