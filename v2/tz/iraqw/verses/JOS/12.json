          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Dori oo baraá yaamaá Nafot-dori, waawutmoó gixsár Goi'imu oo amór Gilgali, ",
          "type": "text",
          "attrs": {
