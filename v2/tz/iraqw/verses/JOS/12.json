          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Ta'anaki, nee oo Megido, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
