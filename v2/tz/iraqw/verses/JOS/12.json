          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Horma, nee oo Aradi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.14",
            "verseOrgIds": [
              "JOS.12.14"
            ]
          }
        },
