            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose nee múk Israeli, waawitaáwí tsár kuri baál, sagadiyusmoó AAKOÓ MUNGÚ, Mose yaamu giri qasiís dír tlahhoó Reubeni, nee bahh'ale dír tlahhoó Gadi, bahh'alé dír tlaqtá tlahhoó Manase, yaamuudá' tari kooín.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
