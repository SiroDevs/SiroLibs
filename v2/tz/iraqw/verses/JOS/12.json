          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmoó gixsár Kedeshi, nee oo Yokneamu, gixsár geetuú tloomár Karmeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
