            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár maamáy tuuadá' taa daá/ birngi tse/aá i duux, heé aa baraá qul/ír dóií nahhaat bir deer, barngwa báy, «Heé aa meet i deéro?»",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
