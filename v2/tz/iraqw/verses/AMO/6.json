              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala bar múk mibaangw aa meét baraá doó wake, inooín sleémeero aqo nin qatliyá'. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
