              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aníng gwareesi ngiri ár ar tlatlaw baraá tla/ángw doorír alé, ngiri axaás i tseeamiín ar afór ur, i kat, «Múk baraá yaamuú wa hoót, a tsaxwaaín, a tsaxwaaín, a tsaxwaaín, qoomár malaykeedá' tám aa meti tarumbeetaduuín binga ufáhh. Asma malaykeedá' taa amohhe'és kiwa ufaahhi.»",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
      ]
    }
