              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Heé iaá koóm, axweesantí ngi axaasi, tí Qeeru i kaahi dír múk kríshaanáy.»",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Kaangwí gooiimeek amór malaykamooduú múk kríshaanáy oo baraá Filadelfiár i dirií',",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Axweesantí dír i dahh a dír kudá' Hhoohhoó', kudá' looeemaá axweés, kudá' gweermór Daudi ga koóm. Inós afkú do' bar ngwa gweér, heé tseegaro gu aleesláw i kaahh. Nee inós bar ngwa tseék, heé gweermooro gu aleesláw i kaahh. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aníng kángw tlehhemi'iiwók u xuú'. Qaytsiít, aníng afkú do' oo taa gweér ngwa qaás dír geeraawók i alé, ala heé tseegamooro gu aleesláw i kaahh. Aníng a xuú' kuúng /uuruú niiná u koón, nee slám kuúng axweesante'eé' aga ót, nee aníng iga si'iká. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.8",
            "verseOrgIds": [
              "REV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga/aaweek, mukko i deer oo Neetlángw eeharahár. Inooín ta kaahi atén a múk Yahudi, ala laatí a loeká, ala inooín a lamuuse. Aníng mukwí ngu /uurutís as iwa amoorók i hardihi, nee iwa tumbarara'aati dír geeraawók i alé, as inooín ngiwa tsaahhiya' adór aníng kuúng ur slaá'. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.9",
            "verseOrgIds": [
              "REV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuúng axweesante'eé' tidá' daanduú qiqtliingw aga ót. Gawaá adoorihe aníng kuúng u xuúm qoomaadár iiara'aduuwo, tidá' hardah baraá yaamu sleémeerowo, as muu sleémeero oo baraaká' yaamu kuwa iiari. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.10",
            "verseOrgIds": [
              "REV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aníng ni hardáh ar gaanslaay. Tidá' ta koon ooha hhe'eeseek, as kahhó' hee slamaangók munguwa hayóh. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.11",
            "verseOrgIds": [
              "REV.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heedaádá' arba/ati gaa slay, aníng inós un uhumoó Doó Munguúeé' tleéhh, nee baraadaádae iri ti'iitiiká baloó ale. Nee gawaawose aníng umuú Munguúeé' un gooiím, nee umuú gixsár Munguúeé', Yerusalemudá' /aben, tidá' awdiit gawaá dooriiwo amór Munguúeé' wa ale. Nee slám aníng umuueé' kudá' /abén u gooiím.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.12",
            "verseOrgIds": [
              "REV.3.12"
            ]
          }
        }
      ]
    },
