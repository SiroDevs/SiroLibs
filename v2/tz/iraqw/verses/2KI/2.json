          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeharuusér aaruuse tidá' Beteli i dirii' Elisha guri i daqeér, guri beér, «Xáy, kuúng hamí laarí a xúa AAKOÓ MUNGÚ aakoowók nguwa ar tlay?»",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
