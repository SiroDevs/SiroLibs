              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha giri báy, «Diwi qaasare' baraá qwaree/amoó /abén, daqaní ngi amor'eé' hubá'.» Inooín ngay huwiyé'. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha iri tláy, ay didá' tsiinqár ma'aay i diri', diwtidá' gari kwaáhh baraá ma'áy ale, iri oó', «AAKOÓ MUNGÚ i kaahi, ‹Ma'ayká' iga tsuu'uús, iimír hamí gwa'ara ngi baloó huwiaaká, laqaá /ameena gur'e ga kwakwahhaká.› » ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
