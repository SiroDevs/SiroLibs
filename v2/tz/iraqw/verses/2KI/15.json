              "type": "text"
            }
          ]
        },
        {
          "text": "Kurkú tsár oo waawuti'iimár Peka garmoó Remalia oo Israeliro Yotam garmoó Usia waawutmoó Yuda waawuti'iima gana iimu/ún baraá Yudawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
