          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár waawuti'iimár Yotamwo, AAKOÓ MUNGÚ waawutmo Resini oo Aramu nee Peka waawutmoó Israeli gina /agís as tawa haraatlay baraá yaamaá Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
