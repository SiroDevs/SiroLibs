              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawuti'iima ngiwa iimu/ún kureeriiwós a mibeeri tsár nee kooán. Inós baraá waawuti'iimaro kureeri ngaa /aáy mibaá nee lahhoó', baraá gixsár Yerusalemuro. Umuú aayoorós a Yerusha dasír Sadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
