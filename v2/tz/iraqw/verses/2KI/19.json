          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy waawutmo Senakeribu oo Ashuru iri tláy, iri waátl amór do', iri hotaá áy Ninewi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        },
        {
