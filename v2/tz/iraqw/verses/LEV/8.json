          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Mose di/tá iimbalaxaangw nee tseerero giri taataáhh gawaá kitángw ilahhooaro, giri hikimiís gawaá Aroni nee daaqaywós nee gawaá tsitay'ín. Gawaá adoorihe Mose Aroni nee daaqaywós nee tsitay'ine giri paraátl.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
