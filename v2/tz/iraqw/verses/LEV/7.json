              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe, gaarí an dabér ilahhooár da/a, nee ar ilahhooár balaangw, nee ar ilahhooár tlakweema hingeesa, nee ar ilahhooár dakuús hingeesa, nee dabér paraatla, nee ar ilahhooár wayda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ Mose guna hara'ayaárí haniís gawaá tloomár Sinaír wa ale, baalaadá' Mungú xoorór Israeli ngiwa ádbáy ilahhooar'ín ngiwa huwiya' baraá xaanxoó Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
