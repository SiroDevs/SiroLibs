        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Bar bu'uún baraá qaymooroge, ma baloó bu'uumaar ay alhhe'eesoó qaymoorók, laqaá ma alií ki/aar as buruurú kuwa sleemis, un meér as dahaayér waaraahh nee narkuute. Aníng an AAKOÓ MUNGÚ, Munguúwók.»",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
    {
