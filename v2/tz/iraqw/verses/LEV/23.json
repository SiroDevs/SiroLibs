          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose xoorór Israeli gari xu'utís deelór uren ar AAKOÓ MUNGÚ ar taa qoomeesi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
