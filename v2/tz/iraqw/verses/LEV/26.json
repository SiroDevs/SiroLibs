              "LEV.26.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaarí an dabe nee kaahi nee hara'ayár AAKOÓ MUNGÚ aa haniís dír múk Israeli gawaá tloomár Sinai wa ale ar dákw Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
      ]
