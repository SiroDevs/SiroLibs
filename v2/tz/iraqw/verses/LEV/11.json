          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaarí an hara'ayár makaay nee tsir/o, nee umuúqo gár slafa ar baraá ma'aay nee yaamaá kaahaar, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "as kahhó' gár qoom /aymaro nee ar ta waki kawa tsahha', ar hariim /aymaro nee ar harimaaká /aymaro kawa tsahha'.",
          "type": "text",
          "attrs": {
