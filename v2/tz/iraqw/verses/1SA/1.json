          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inooín AAKOÓ MUNGÚ nguri amoodá' wa sluufmiisiyé'.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        }
      ]
