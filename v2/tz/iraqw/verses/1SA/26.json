              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi Saulo guri báy, «Aá waawutámo, qayteek lawaalarók i diirí, garmaawók oo wák ya/aawang ngi leehhi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
