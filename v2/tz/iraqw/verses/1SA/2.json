            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Munguú hatlá' oo hhoohhoó' adór AAKOÓ MUNGÚ wa alé i kaahh.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
