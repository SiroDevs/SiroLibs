        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaá tihe Samueli iri tláy ay Rama, nee Saulo iri waatláy amór do'ós baraá Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli nee Saulo tay baloó ari'iiká ay gwa'ararós, ala Samueli Saulo guna ale/aa/amaamín. AAKOÓ MUNGÚ iri gwadidín, asma adoodá' Saulo nguwa waawutmoó múk Israeli wa qaás.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        }
