              "1SA.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo iri male oó', «Aga tlakweés, ala hamí u firiím, ilaiwa/áng geeraá bariiseedár muk'eene nee dír geeraá múk Israeliro ya/aamáng, nee kuúng niwa alki/aan, as AAKOÓ MUNGÚ, Munguúwók nguwa sluufiis.» ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Samueli nee Saulo tari alkií/ ay Gilgali. Saulo AAKOÓ MUNGÚ guri sluufmiís.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        }
      ]
    },
