          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár Samueli iwa warqáy as iwa tlay, Saulo guna pasltá inqwaari óh, iri feehhít. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli guri báy, «Laarí AAKOÓ MUNGÚ waawuti'iimarók dír múk Israeliro gaa feehhamiís, gari haniís dír inslaawmoowók, kudá' hhoó' ta kuunge. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Slám Munguúduú xirfuú Israeli, lama ga ooiiká, tam i gwadidinká asma inós a heewooká.»",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
