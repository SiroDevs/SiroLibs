          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli Saulo guri báy, «Án nee kuúng a baloó alki/anaaká, asma axweesantá AAKOÓ MUNGÚ aga sí', AAKOÓ MUNGÚ kuúng ugwa sií' tawa waawutmoó múk Israeli.»",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
