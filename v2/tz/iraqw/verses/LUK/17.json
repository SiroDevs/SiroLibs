              "LUK.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari oó', «A diimá wa ale, Aáko?»",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giri báy, «Dír tuua i diri' an didár gwares i burumburiimiti.»",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
