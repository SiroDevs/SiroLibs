          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu iwa tseewúy Yerikór i alé, heeko wák oo taampa aa iwiít afaá loohi, i múk firiirín. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.35",
            "verseOrgIds": [
              "LUK.18.35"
            ]
          }
        },
