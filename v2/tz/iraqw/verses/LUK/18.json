          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka inslaahh angamía iwa waarahh ar baraá fooxár laqwa, ta daqaarmo iwa baraá waawuti'iimár Mungú i dahi.»",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
            "verseOrgIds": [
