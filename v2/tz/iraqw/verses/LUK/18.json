          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukdá' aa giirin kuri iigahhaát as iwa xasliiti, ala inós tseeooro iri buúhh, «Garmoó Daudi, án gurtlawáng.»",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        }
