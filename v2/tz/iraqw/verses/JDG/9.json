              "JDG.9.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JDG 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoorí an adór Mungú Abimeleki ngura slahh'eés as dakuúsár na/aá baabuúwós awa mibeeri faanqw ngiwa tsuú/. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.56",
            "verseOrgIds": [
              "JDG.9.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JDG 9:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungú mukdá' tlákw oo Shekemu guna slahh'eemiís sleeme as slasla/aruú naa tleehhiyé'. Gawaá adoorihe lo'ór Yotam garmoó Gideoni giri /ák.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.57",
            "verseOrgIds": [
              "JDG.9.57"
            ]
          }
        }
      ]
    }
