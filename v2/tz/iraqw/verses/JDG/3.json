              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalaadae hhawaataá kume mibaangw awa Moabu kina tsuú/, slám sleémeero a tlaa/aá tawo, tam panmo aa meetiiká. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
