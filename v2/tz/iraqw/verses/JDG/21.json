            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.24",
            "verseOrgIds": [
              "JDG.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
