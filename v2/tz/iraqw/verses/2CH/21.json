            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu waawuti'iima ngiwa iimu/ún kureewós a mibeeri tám nee tsár, inós ina baraá Yerusalemúr wa waawuti'ín kureeri dakaát. Qoomár iwa gwaá', heé gwa ale/aa/ i kaahh. Inós kuri foól baraá gixsár Daudi, ala baraá /aantaa waawitaheeká.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
