              "2CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tlehhma'aá waawutmo Solomon iimír iimu/uungw ay alhhe'eesaay kaa gooín baraá kitaábuú «Alki/ituú aarusmo Natani», nee kitaábuú, «Aaru'uumár Ahiya oo Shilo», nee baraá kitaábuú «Iigu'uutuú Ido», handá' sleeme daanduú Yeroboamu garmoó Nebati kwaa baraadá' i gooín. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon ina waawuti'ín baraá yaamaá múk Israeli kureeri mibeeri tsiyáhh. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alhhe'eesaywo Solomon iri gwaá' kway foól baraá gixsár baabuúwós Daudi, garmaawós Rehoboamu kitaangós gway óh.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
      ]
