              "2CH.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo Yehoshafati nee slaqwaruuseerós nay tlayé', haasaánguú hikwaá yaariir nee daqaari'iima, nee tlabá', nee muruú hatlá' oo tlaxo gawdén, kuri ar tláy. Muruuwí kuna loohiís ar har afiqoomár deelo tám, sleeme kwaa faakiká asma ku ló'wa yaariír. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.25",
            "verseOrgIds": [
              "2CH.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bál tsiyahhe tari burumburiít baraá xatstá ta bay Beraka,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:26",
              "type": "text"
            },
            {
              "text": "Beraka:",
              "type": "text"
            },
            {
              "text": "Gídaabárós a xatstá xirfayeemis.",
              "type": "text"
            }
          ]
        },
        {
          "text": " AAKOÓ MUNGÚ ngway didá' wa sluufisiyé', didá' kari báy xatstá Beraka tam ay laarí. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy muu sleémeero oo Yuda nee oo Yerusalemuro, dinkwa nee waawutmooín Yehoshafati, tay kií/ Yerusalemu ar qwala/, asma AAKOÓ MUNGÚ inooín gina aleesleemuú i haniís oo tawa qwalaala/i daanduú wakuuser'ine. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tawa hardáh Yerusalemu tana huuwísh baraá Doó AAKOÓ MUNGÚ, tay daá' ar mariímba nee ar gidaandori nee ar tarumbeetadu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawituú xoordaá hatlá' kaangwí kuwa axaás, oo AAKOÓ MUNGÚ wakuusér múk Israeli ngiwa baál, inooín Mungú nguri da'ayuutiyé'. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluudae waawutmo Yehoshafati iri waawuti'ín ar wayda, asma Mungú wayda guna haniís bihhe sleémeero.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
