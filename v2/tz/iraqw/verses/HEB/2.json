          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma inósuú kilá' kwaa slahh'eemiís nee kuri iiara'ár. Gawaá adoorihe inós kudá' sleémeero ta iiara'ari gi aleesláy alee/iisaro.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
