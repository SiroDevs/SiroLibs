              "ROM.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe Mungú inooín giri máy, as ilatleerir'ín ar mure wasl kawa eehari. Tam /ameena tlehhmuuín kudá' hariím, tawa alhooti nee hhawaate, guri warqés. /Ameena iri fuqús nee /ameena. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hhawaate sleeme tlehhmuuín kudá' hariím, tawa alhooti nee hare, kuri máy, tiri kilooín ló'wa ilatleeruusiyé'. Hhawaata iri hhawaatuú hatlá' ló'wa ilatleeruús. Hhawaata tlehhma'aá hariima'aaká, awa murér koomá', giri tlehhiít dír hhawaatuú hatlá'. Bu'utuudá' inooín wa hariím as tlehhmuuín kuduú qwanaay, kuri gawaá slaqooín wa sláy.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
