          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "uduú qwaslaarmo iri oó', «Án aleefiriimaaré' dír Aakoowo as muruusíng sleémeero naa aníng i katé' iwa pa/i.»",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        }
      ]
