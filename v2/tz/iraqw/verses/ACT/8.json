        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
            "verseOrgIds": [
              "ACT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
