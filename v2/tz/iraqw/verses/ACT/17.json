          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
