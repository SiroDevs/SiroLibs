          ]
        },
        {
          "text": "Aá AAKOÓ MUNGÚ Aleesleemusámo, Munguú múk Israeli, asma kuúng kaangwí ngwa geehhooés dír anuú lawaalmoowók, tari ó', ‹Án kuúng un dó' i tleéhh,› as adoorí an piíhh firor'eé' ngiwa oo' dír geeraawók.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        }
      ]
