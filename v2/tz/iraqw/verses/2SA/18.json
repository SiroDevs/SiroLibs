          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahima'asi guri báy, «A gaarooká, aníng a ta'aaím.»",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
