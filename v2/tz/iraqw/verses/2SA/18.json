        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heedaáduú Kushi nari hardáh, iri oó', «Kángw hhó' ngwa huúw amoorók, aakooeé' waawutámo! Asma AAKOÓ MUNGÚ kuúng laarír kilá' ugwa tuú/ dír /uuruduú mukdá' daber'ín gaa tleesi gawaá kuúng.»",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        }
      ]
