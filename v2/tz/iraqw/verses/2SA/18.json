    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heedaáduú Kushi iri oó', «Aakooeé' waawutámo, wakuuseerók dinkwa nee sleémeero kudá' naa daanduuwók wa sihhitiyé' as tuwa gár tlaákwi slai, alók masók an adór garmaawí ta bay Absalomu.»",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
