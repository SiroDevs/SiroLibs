              "type": "text"
            }
          ]
        },
        {
          "text": "Ki/imaá tsare, múk Filisti nina kií/ male ale, tana tsiyayaxaát baraá xatstá Refaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
