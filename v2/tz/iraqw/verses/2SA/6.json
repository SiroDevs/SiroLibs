        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Mikali dasír Saulo na/aay gwa sleeriiká garwa gwá'.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.23",
            "verseOrgIds": [
              "2SA.6.23"
            ]
          }
        }
