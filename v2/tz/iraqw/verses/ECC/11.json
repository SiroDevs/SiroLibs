        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hee kureeraá yaariir birnga hoót, ngi saqwalaa/i, ala masók in inslawín adór deelór slahh'amaaye kar úr. Muruú aluú wa hi'iít sleémeero a tawo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
