              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwa/aateema i ló'wa tsuuiyá', slám tsee/amá i ilaá sla'atimis. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
