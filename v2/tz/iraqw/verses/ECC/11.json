          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma baraá muunaáwók i gurhamuutaar, ti ila/, nee slaqwtók ma slahh'eemisaar, asma masoombi'iima a tawo nee tla/aa tsaraaro.",
          "type": "text",
          "attrs": {
