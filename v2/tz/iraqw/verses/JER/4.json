              "type": "text"
            }
          ]
        },
        {
          "text": "Kaangw ooaak baraá Yudawo. Afo ilahanisaak amooqár Yerusalemuro tawa oa',",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.5",
