          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy aníng niri oó', «Aá Aakoó MUNGÚ, ar ló' kuúng muu ugwa al/ák nee gixsár Yerusalemu. Ina beér, Kuungá' a hotá' ar amohhooa, laatí hamí slafiingw in baraá tsaxwa.»",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
