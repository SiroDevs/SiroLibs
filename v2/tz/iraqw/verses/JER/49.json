          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Axweesantí an tidá' aa oó' daanduú Damaskoro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.23",
            "verseOrgIds": [
              "JER.49.23"
            ]
          }
        }
