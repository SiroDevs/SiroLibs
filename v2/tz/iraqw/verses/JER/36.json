        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo wawutmoodá' Yerame'eli garmoó waawutmo, nee Seraya garmoó Asrieli, nee Shelemia garmoó Abdeli, giri ya/aáw as goousmo Baruku nee aarusmo Yeremiawo kiwa ohin, ala AAKOÓ MUNGÚ inooín gina luú/.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
