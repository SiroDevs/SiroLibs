          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungá', múk Israéli, iia ló'wa qaasaak,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    }
