              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "«AAKOÓ MUNGÚ, Munguú Israeli kuúng Baruku un babay, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "‹Kuúng a kat, tsaxwaaeé', asma AAKOÓ MUNGÚ gurhaami ngaa doók gawaá daanduú slahh'amuueé'. Aníng gurhaami iga slaaqatís tam dír amohhoo' a slaslawaaká'.›",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
