        },
        {
          "text": "Aarusmo Yeremia axweesantá AAKOÓ MUNGÚ gana axaás daanduú xoorduuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Axweesantí a tidá' aa oó' daanduú múk Misriro, nee slaqwaruusér Farao Neko waawutmoó Misri, slaqwaruusedár baraá Karkemishi bihhaá yaaér Eufrate. Nebukadnesa waawutmoó Babuloni slaqwaruuseedá' ngaa baál qoomár kurkú tsiyáhh oo waawuti'iimár Yehoyakimu, garmoó Yosia waawutmoó Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
