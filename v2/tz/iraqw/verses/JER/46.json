              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaangwí an axweesantá AAKOÓ MUNGÚ aa oó' dír aarusmo Yeremia, daanduú Nebukadnesa waawutmoó Babuloni iwa haratlay yaamaá Misri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
      ]
