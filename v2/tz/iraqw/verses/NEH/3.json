            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bihhikariya' Meremoti garmoó Uria, garmoó Hakosi gina /abeés tlehhmuuwo, nee bihhikariya' Meshulamu garmoó Berekia garmoó Meshesabeli gina /abeés. Dír hatlá' a Sadoki garmoó Ba'ana gana /abeés tlehhmuuwo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        }
      ]
    },
    {
