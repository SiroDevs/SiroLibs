          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bihhikariya' kina tleéhh nee múk Tekoár daáhh ala geeraharuusér gixsa gadiyér daba' tlehhtuuwo ina sí', tidá' taa oó' nee sagesihhtuuser'ín.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
      ]
    },
    {
