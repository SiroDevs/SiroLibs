            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hhay Hasena Afkuduú Siyó guna /abés tlehhmuuwo, inooín nahhtós kari sihhtís afeerós kari qaás, nee muqsladá' afkú do' kway tseegi nee muqslaadá' kur tsegiiti sleeme.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        }
      ]
    },
    {
