          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee bartaka múk Yeriko gana /abeés tlehhmuuwo, aluuine Sakuri garmoó Imri koo/i gari tleéhh.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
