          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk aluudá' gaa haar tlehhmuuwo a Melatia heé Gibeonír daáhh, nee Yadoni heé Meronotír daáhh dinkwa nee múk gixsár Gibeoni nee oo Misparo, mukwí kuna geerahaár nee ga/aawusmoó yaamaá yaaér Eufratero gayuú /uwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        }
      ]
