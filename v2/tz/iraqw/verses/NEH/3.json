            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dír aluudá' kana /abeés tlehhmuuwo nee Refaya garmoó Huri, kudá' úr oo tlaqtá yaamaá Yerusalemu ga ga/áw.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
