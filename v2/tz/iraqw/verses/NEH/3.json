          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yedaya garmoó Harumafu dír aluudá' gana tleéhh tidá' nee do'ós ti ga/aawá'. Dír aluudá' kana /abeés tlehhtuwo nee Hatushi garmoó Hashabneya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
