            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwí ina hoót qoomaadár Yoyakimu garmoó Yeshua, garmoó Yosadaki, nee qoomár Nehemia tawa ga/aawusmo, nee Esra tawa kaahamusmoó Mungú nee goousmo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár koo/ír Yerusalemu kawa paraatlár wa slai múk tlahhoó Laáwi kuna leelehhiít umuúqo dír i diri'iia, as niwa hardihiya' Yerusalemu deelór ur ar koo/i kawa paraatli as Mungú kawa sluufmiisi, nee tawa daai ar mitingiraay nee ar mariímba nee ar gindaandoori. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xwaylár daauuse ina dinkwárií burumburít iimír ayeemaá Yerusalemu ngaa harweeriye', nee ayeemaá múk Netofati. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahh'ale ni Bet-gilgali dahhiyá' nee ayeemaá Geba, nee Asmaweti, asma daauuse maray'ín gina tléhh ayeemaá Yerusalemu ngaa harweeriye'. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaahamuusér Mungú nee múk tlahhoó Laáwi tina hhoohhooeesiyé' nee muko, nee afér do' nee koo/iro.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharuuse sleémeero ar Yuda ana burumbuúr dír koo/i, ngiri tsaát baraá daqooráy tsár oo daá' nee oo sluufmiís inooín bara/ ngwa duuruxiyé'.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daqtá wák ina bihhaá /iyáy xú' ay amór Afkuduú Xwaansláy. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daauuseerí kana alu haár nee Hoshaya ta dinkwa nee tlaqtá geeraharuusér Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk nee inós taa kone' a: Asariya, nee Esra, nee Meshulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Yuda, nee Benyamini, nee Shemaya nee Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xwaylár kaahamuuse bahh'ale in tarumbeétadaá koná', inooín an ín, Sekaria garmoó Yonatan, garmoó Shemaya kuduú garmoó Matania, garmoó Mikaya, garmoó Sakuri, garmoó Asafu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hhaeewós bahh'ale nina daaiyé' ar xooslaá daa'aangw awa waawutmo Daudi, heé Mungú. Inooín a ín Shemaya, nee Asareli, nee Milalai, nee Gilalai, nee Ma'ai, nee Netaneli, nee Yuda nee Hanani, kina geerahaár nee goousmo Esra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dír Afkuduú Tsiinqaro nina gáwtí tsa/ané' ay amór gixsár Daudi, tana waaraáhh ar dír doó Daudi, alaá koo/i kana xuú' ay Afkuduú Ma'aay bihhaá da/aáw awa gixsa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daqtá hatlá' ar Munguú sluufmiis tana bihhaá doó basáy xuú', aníng nee inooín tina koomaán dinkwa nee tlaqtá muu tari amór koo/ír xuú' ay amór /Aampaadár Asltá gufteeri ay amór Koo/idár Daqa Ur. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tawa didá' wa tlawaán ana waarahhaán ar Afkuduú Efraimu nee Afkuduú Yeshana ay amór Afkuduú Siyó tay kumitaán ay /Ampadár Hananeli ay amór /Ampadár Tsiiru ay Afkuduú Doó Bee/aangw. Hi'itanoorén kay alhhe'eesaán dír Afkú Doó Tseegmo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe, daqooráywí tsaraawo ta daa'ángw ilahhooár daa' taa sihhiít baraá doó Mungú, dinkwa nee aninge nee tlaqtá geeraharuuse. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaahamuusér Mungú ar tarumbeétadaá koom, a Eliakimu, nee Ma'aseya, nee Miniamini, nee Mikaya, nee Eliehoenai, nee Sekaria nee Hanania, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Ma'aseya, nee Shemaya, nee Eleasari, nee Usi, nee Yehohanani, nee Malkiya, nee Elamu nee Eseri. Daauuse iwa da' kina geerahaár nee Yesrahia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalaarihe inooín ilahhooár muruú ta tsu/i kana haniís tari ló'wa qwalaá/. Asma Mungú gina ló'wa qwal/aás ar qwal/uú úr, /ameena nee na/iiwo sleeme tari qwalaá/. Bar/uú qwala/ oo baraá Yerusalemu kuri amór saáw wa axamiís.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomaarihe muu kuna tsawaár oo kutuwoó kuuntáy gu amohhe'eemiís kudá' ta ilahhooárí qamin, ilahhooár bu'úngw geera nee gár wák baraá muruú mibaango, nee muruú tinda baraá qamaá gixsár wa burumburín as kaahamuuse nee múk tlahhoó Laáwi ar adoodá' dabe i kat. Asma múk Yuda kaahamuusér Mungú nee múk tlahhoó Laáwi kudá' gadiyuusa' kiri sa qwalalaá/. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inooín adór Munguúín kur sluufmiisi kana qoomeés, nee adór tir hhohhoeemisiya' ar adoodá' daauuse nee xuumuusér afér do'o taa tleéhh, ar adoodá' waawutmo Daudi ngira oó' nee garmaawós Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimír qoomár waawutmo Daudi nee Asafuwo geeraharusmoó daauuse aqo in daadeer nee daa'ángw xirif nee oo Mungú sluufmiisuuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk Israeli sleémeero, iimír qoomár Serubabeli nee Nehemiawo umuú baalaaro ilahhooa kana hanmiís as daauuse nee xuumuusér afkú do'. Múk Israeli tooka ngina partlitiyé' as múk tlahhoó Laáwi, múk tlahhoó Laáwi tooka ngina paraatliyé' as xwaylár Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
    }
  ],
