          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sleémeero tari oó', «Gár ló' aga ó'.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
