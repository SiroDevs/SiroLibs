              "1KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya aaruusér Ba'ali gari báy, «Kuungá' tundu yaariír, gimsé' giirimaaré' awuuhúng tsawaraak, ku amohhe'esá', Munguúhúng ku firiindá', ala asla ma oohisaara'.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
