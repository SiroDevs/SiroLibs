          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo Solomon Shimei guri male báy, «Tlakweemaá baraá muunaáwók i insleéra kudá' taa tléhh dír baabuúeé' Daudi, gawaá adoorihe AAKOÓ MUNGÚ tlakweemaadá' ngi gawaawók i buu'. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
