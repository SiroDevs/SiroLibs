          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inós iri ó', «Gár ni slaa' a Adonia hhiyaawók un duuxutís Abishagi ar yaamaá Shunamiro.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.21",
            "verseOrgIds": [
              "1KI.2.21"
            ]
          }
        }
