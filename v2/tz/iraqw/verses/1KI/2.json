              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaangwí iri hardáh dír Yoabu, asma Yoabu aáng Adonia guna aleekalaá/, tam Absalomu gwaa eehariikahe. Yoabu iri goów baraá Heémár AAKOÓ MUNGÚ, xareemiidá' kitángw ilahhooa giri óh. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo Solomon kuri báy, «Yoabu aa goów amór Heémár AAKOÓ MUNGÚ nee aa sihhiít dír kitángw ilahhooa.» Solomon Benaya garmoó Yehoyada guri ya/aáw, guri báy, «Tláw, slahheek.» ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Benaya iri tláy, iri hardáh baraá Heémár AAKOÓ MUNGÚ, Yoabu guri báy, «Ti'iitáng, waawutmo u ateetín.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inós iri oó', «Aasla'áy, aqo an diirír kilá' gwaá'.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
