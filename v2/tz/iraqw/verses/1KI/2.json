            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei waawutmo guri báy, «/Aymuusíng ku hhoó', adór aakooeé' waawutmo ngira oó' an adór anuú lawaalmoowók ngir tleehh.» Shimei deelór yaariire iri baraá Yerusalemúr wa hoót.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kureeraá tám niwa waaraahhiyé', lawaalér tsár ar Shimei ina diyaa/át, iri tleér amór Akishi garmoó Ma'aka, waawutmoó Gati. Shemei kaangwí nguwa axaás tawa baraá Gatiri dirii'i, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "inós daqwaywós guri i tsa/án, iri tláy ay Gati amór Akishi, as lawaaleerós ngiwa leeleehhi. Shimei lawaaleerós gari Gatír wa sláy, ngari ar waátl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaangwí Shimei iwa ti'iít baraá Yerusalemuro iri Gatír káy niri waátl, waawutmo Solomon nguwa axaás, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "waawutmo muu guri ya/aáw Shimei kuwa ateeti, guri báy, «A milá, ahaá ugwa lo'ór /aymisiikáhe ar umuú AAKOÓ MUNGÚ, slamí ugwa bawikáhe, baraá ti'ít aqo an gwá'? Kuúng tari ó', ‹/Aymuusíng naa axaás ku hhoó', aníng u iialooeés.› ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baré ala lo'oodá' taa /ák ar umuú AAKOÓ MUNGÚ aga gaárií xu'uká, dinkwa nee hara'ayaadá' naa kuúngií ooi.» ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
