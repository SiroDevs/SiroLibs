            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo muu guri ya/aáw Shimei kuwa ateeti, guri báy, «Do'ók tleehheek baraakaá Yerusalemu, ta baraadá' wa hót, ló' ma baloó ti'iitaar tawa amór hatlá' keer tam amoomá. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma bál bara ti'ít yaaér Kidroni kay waaráhh, ka xú' a gwá', nee dakuusasíng a tók.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        }
      ]
    },
    {
