          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár Ba'asha Nadabu nguwa gaás, Asa waawutmoó Yuda kureeri ngaa /aáy a tám baraá waawuti'iimaro. Ba'asha iri waawuti'iín kitángw Nadabu wa ale. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
