          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba'asha waawuti'iima ngiwa sangw sláy, múk doó Yeroboamu sleémeero guna tsuú/, tam panmo gwaa geexayká, ar adoodá' AAKOÓ MUNGÚ aa oó' ar loohír sagadiyusmoowós Ahiya kuduú Shilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
