          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwí urén oo geeraharuuse oo Solomon aa qaás gadiyeérós kawa sagesihhimiiti a tsiire kooán nee mibeeri kooán, kudá' hara'ayár gadiyeé ga oiím.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluudae dasír Farao iri lót amór gixsár Daudi wa ale ay amór do'ós kudá' Solomon aa tleéhh, Solomon koo/ír gawit ar Milo gari tleéhh.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon do' tlehhmuuwo nguwa hhe'eés, umuú kurko ilahhooár da/a gan hamaamiis sagaáwa tám, nee ilahhooár wayduuwo, gawaá kitangw ilahhooa, kudá' inós aa tleéhh as AAKOÓ MUNGÚ. Ilahhooa gari daá/ gawaá kitangwdá' dír geeraá AAKOÓ MUNGÚ i dirií'.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        }
      ]
    },
