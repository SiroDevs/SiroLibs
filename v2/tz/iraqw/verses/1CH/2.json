            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efa harér quturmo wasl ar Kalebu daaqoó aa laqwál a kwí: Harani, nee Mosa nee Gasesi. Harani ina laqwaál Gasesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        }
      ]
