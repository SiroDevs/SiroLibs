            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó Yadai a kwí: Regemu, nee Yotam nee Geshani, nee Peleti, nee Efa, nee Sha'afu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        }
      ]
    },
    {
