          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraá daaqoó Ishariwo Kenania nee daaqaywós kina geeraharuusér wa qaás nee har'ohuusér múk Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
