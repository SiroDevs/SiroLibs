              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó Seiri a kwí: Lotani, nee Shobali, nee Sibeoni, nee Ana, nee Dishoni, nee Eseri nee Dishani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
