          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó Shobali a kwí: Alfani nee Manahati, nee Ebali, nee Shefi, nee Onamu. Daaqoó Sibeoni a kwí: Aya nee Ana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
