              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi iri gwaá'. Múk uren oo Edomu a kwí: Timna, nee Aliya nee Yeteti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
