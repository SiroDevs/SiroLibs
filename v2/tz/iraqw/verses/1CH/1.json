          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Kenasi, nee Temani, nee Mibsari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.53",
            "verseOrgIds": [
              "1CH.1.53"
            ]
          }
        },
