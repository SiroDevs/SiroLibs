          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garmoó Ana a kwí: Dishoni, daaqoó Dishoni a kwí: Hamrani, nee Eshbani, nee Itrani, nee Kerani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
