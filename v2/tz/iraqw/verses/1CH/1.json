          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Magdieli, nee Iramu. Mukwí an múk urén oo tlahhoó Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.54",
