            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó Lotani a kwí: Hori, nee Homamu, nee Timna hho'ór Lotani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
