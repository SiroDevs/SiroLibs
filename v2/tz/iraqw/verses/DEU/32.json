              "type": "text"
            }
          ]
        },
        {
          "text": "«Aá doóri, kuungá' iia qaasaak, aníng a axweés.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.1",
            "verseOrgIds": [
              "DEU.32.1"
            ]
