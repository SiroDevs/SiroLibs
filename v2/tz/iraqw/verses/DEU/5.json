            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Umuú AAKOÓ MUNGÚ, Munguúwók mu tawo axweesaar, asma AAKOÓ MUNGÚ, heé umuuwós gu tawo axweés, gu gana'amií harafaariiká.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Deelór Sabaáto harmagaahheek, ka hhoohhooés, adoodá' AAKOÓ MUNGÚ, Munguúwók ngira oó'. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deelo lahhooe gadiyuús, gadiyeerók sleémeero tleehheek, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ala deelór faanqw a deelór Sabaáto ar AAKOÓ MUNGÚ Munguúwók. Baalaadae kuúng ma gadiyusaar, laqaá tam garmaawók, laqaá dasiirók, laqaá lawaalmoowók, laqaá lawaalo'oorók, laqaá tam sleerók, laqaá daqwaywók, laqaá tam umuúqo makiito'ooro, laqaá tam hoomoó dír do'ók, as kahhó' lawaalmoowók, laqaá lawaalo'oorók, iwa adór kuúng wá hungu/uusi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala kuúng ma gunqarutaar adór kuúng aáng tar lawaalmo baraá yaamaá Misriro, anuú AAKOÓ MUNGÚ, Munguúwók uri baraadá' wa duúx ar /uuruueé' nee ar dakw'eé' kudá' naa gáwtí tleés. Gawaá adoorihe anuú AAKOÓ MUNGÚ, Munguúwók un babaw, deelór Sabaáto harmagahheek kawa ot.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
