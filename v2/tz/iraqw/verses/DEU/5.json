        },
        {
          "text": "«Harér inslaawmoowók ma ilatleerusaar, laqaá doó inslaawmoowók mu ilatleerusaar, laqaá qaymoorós, laqaá lawaalmoowós, laqaá lawaalo'oorós, laqaá sleerós, laqaá daqwaywós, laqaá umuúqo gár inslaawmoowók i kona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
