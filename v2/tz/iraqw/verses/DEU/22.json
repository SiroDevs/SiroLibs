              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Barnaxes dasír ta lehhiiti nee hhawaata ta doogiyé' baraá gixsa, tari alqaát, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
