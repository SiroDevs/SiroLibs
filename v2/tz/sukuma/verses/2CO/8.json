  "reference": "2 Bakolinto 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
