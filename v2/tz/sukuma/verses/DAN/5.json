              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alilūūlū, ū wandīke ūbo wandīkilwe būūbū, MENE, MENE, TEKELI, PELESI.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
