              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Belishaza ūlagīja, ū Danyeli ūzwalīkījiwa shizwalo sh'ikūjo sha nzulunge, ūtūūlīlwa na ngufu gwa zahabu ū mu nhingo yakwe; na a banhū būkumūkījiwa gīkī ū mu būsugi bo sī obizaga wa kadatū ū mu būtaale. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu būjikū wa lūshikū lwenūlo ū Belishaza, ntemi wa Bakalidayo",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:30",
              "type": "text"
            },
            {
              "text": "Bakalidayo:",
              "type": "text"
            },
            {
              "text": "Nūūlū, bana Babuloni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ūbūlagwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dalio muna Būmeedi ūbūdima ū būtemi, walī na myaka makūmi atandatū n'ībīlī.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
