              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.25",
            "verseOrgIds": [
              "DAN.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntemi ūmūja ū Danyeli (lina līngī Belitishaza), “Ūdūgije kūniwīla īsho naalī naabonile mu shilooti shane, nū kūshomeleja ūshishomeleja?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Danyeli ūshosha, “Baba ntemi, atīho nchūja nūūlū mfumu, nūūlū moni ose ose ūyo adūgije kūnsomboolela ū ntemi ī mihayo ya mbisīla īyo akwībūūgīlījaga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.27",
            "verseOrgIds": [
              "DAN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo alīho Mulungu ū ng'wigūlū, ūyo akafuboolaga mbisīla; wang'olekejaga ū Ntemi Nebukadineza īyo īkwilonga kū shikū ja kū būtongi. Ī shilooti shako nī shakoolechiwa īsho shalūbītaga ū mu maganiko gako aho ūlaalile mu būlīīlī wako shaalī īshi:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baba ntemi, aho ūlaalile ū mu maganiko gako īkabīta mihayo ya kū shikū ja kū būtongi; ū Nfubooji wa mihayo ya mbisīla wakoolekegije īyo īkūbiza ho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.29",
            "verseOrgIds": [
              "DAN.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo ūlū ū nene, nane noolekejiwe dūhū ī mbisīla jenīji, ītī gīkī nalī na masala no kūbaheeba pye a banhū a bapanga; alīyo kūlwa gīkī ū bebe baba ntemi ūmane a makūlū gayo, na gīkī wīyitegeleje īyo yalī yabītile ū mu maganiko gako.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baba ntemi, aho ūlolile ūkabona shiikolile shitaale shīmīīlaga ū kū būtongi wako; shaali gītī munhū, shitaale no, hangī shiteemagīzu na sha magaka ū mo jaali jīlī. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.31",
            "verseOrgIds": [
              "DAN.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntwe gwa shiikolile shenīsho gwalī gwa zahabu yawiza, ī shikuba na a makono gaalī ga feza; ū kwandīja ha sīlīlī ya shikuba kwika kūshisha mu matango yaalī shaba, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.32",
            "verseOrgIds": [
              "DAN.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "a magūlū gaalī ga chūma, ī mhambala mapande gamò shalī chūma, mapande gangī ibūmba. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.33",
            "verseOrgIds": [
              "DAN.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ūtaalī ūlolile ūbona'iwe līgūūnagūlile chiza chiza lyūlenganījiwa na kūsheeshiwa no no no, gwike ītī na makono ga banhū. Līkashitūla ī shiikolile shenīsho ū kū mhambala jasho ja chūma na mabūmba, lyūjiseesagūla. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.34",
            "verseOrgIds": [
              "DAN.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī likanza lyenīlo pyī ī shose shūbelagūka, ī chūma, na a mabūmba nī shaba, nī feza, nī zahabu; shūseesagūka gītī meela ha lūbūūga lwa kūtūlīla būsīga ng'wikanza lya chū. Nyaga gūūgaheheeja gīnga ho, hūbiza gītī shalī shitīho shose shose. Alīyo ī liwe īlo līkashitūla ī shiikolile shenīsho lyūbiza lūgūlū lūtaale lwīmalamala pyī ī sī.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“H'ūmo shalī ī shilooti shako, leka tūnshomelegeje lūūlū ū ntemi na a makūlū gasho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.36",
            "verseOrgIds": [
              "DAN.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba ntemi, ū bebe ūlī ntemi wa batemi. Ū Mulungu wa ng'wigūlū wakwinha būsugi na būdūla na nguzu n'ikūjo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.37",
            "verseOrgIds": [
              "DAN.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "A banhū abatūūlile mu makono gako būlī kwene ūko balī; nī ndimu",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:38",
              "type": "text"
            },
            {
              "text": "Ndimu:",
              "type": "text"
            },
            {
              "text": "Nī shiinu jilīmo ū mu lina lyenīlī.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ja mu matogolo, nī noni ja kūlala. Hose hose ūko shilī, wakwīta kūbiza nsugi washo pyī ī shose. Ū bebe h'ūlī ntwe ū gwa zahabu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ūlū ūbīta ū bebe būkwīmīīla būsugi būngī, gwike būtūbiza na nguzu gītī ū wako. Hanuma būsugi bo kadatū, bo shaba, būkwīsuga pyī ī sī. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.39",
            "verseOrgIds": [
              "DAN.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuma ya henaho būkwilonga būsugi bo kanè, ū wene būlī na nguzu gītī chūma, nguno ī chūma shikabīnzagūlaga na kūpondagūla būlī shikolo; nīyo ūmo chūma shikabīnzagūlīlaga būlī shikolo shabelagūka, nū būsugi wenūbo h'ūmo būkūbūtobagūlīla pyī ū būsugi ū būngī. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.40",
            "verseOrgIds": [
              "DAN.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike ūmo wabonelile gīkī ī mhambala nī nzwala jaho mapande gamò shalī chūma, mapande gangī ibūmba, ū wenūbo būkūbiza būsugi būgabanhīkile, alīyo nī nguzu ja chūma jikūbiza mo, gīt'ūmo ūkabonela ī chūma shisanganīkile nī libūmba. Ī mhambala mapande shalī chūma, mapande gang'ibūmba. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.41",
            "verseOrgIds": [
              "DAN.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama ī nzwala ja kū mhambala ūmo jalī ja chūma mapande gamò na mapande gangī ibūmba, nū būsugi wenūbo būkūbiza mapande gamò būdaamu, mapande gangī wangū kūmenyuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.42",
            "verseOrgIds": [
              "DAN.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nīyo ūmo ūkabonela gīkī ī chūma shalī shiisangīlīgije n'ibūmba, na a banhū bakwisanja gīko, alīyo batūdūla ū kūdimana mu būsangī būmò, gīt'ūmò chūma shitadūgije kūdimana n'ibūmba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.43",
            "verseOrgIds": [
              "DAN.2.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.43",
            "verseOrgIds": [
              "DAN.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ū mu shikū ja batemi benabo, ū Mulungu wa ng'wigūlū akūtūūla ho būtemi ūbo būtūkenaagūlwa, na būtūlekelwa banhū bangī. Būkūgatobagūla pye a mabūsugi a gangī na kūgamala gete; alīyo ū boi būkūshinga ho welelo na welelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.44",
            "verseOrgIds": [
              "DAN.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "A genaya h'a makūlū ga shakoolechiwa sh'iwe lya kūfuma mu lūgūlū, īlo līgūūnagūlile chiza chiza lyūlenganījiwa na kūsheeshiwa, gwike ītī na makono ga banhū; ī liwe īlo līkashiseesagūla ī chūma, nī shaba, na a mabūmba, nī feza nī zahabu shūbiza gītī meela.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ū Mulungu ntaale wang'olekejaga ū ntemi īyo īkwilonga ū kū shikū ja kū būtongi. Ī shilooti shenīsho sha ng'hana, nū būshomeleja washo shiigelile būsanyiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
