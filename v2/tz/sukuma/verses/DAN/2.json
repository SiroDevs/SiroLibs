              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.16",
            "verseOrgIds": [
              "DAN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Danyeli ūshoka kū ng'wakwe, ūūkabawīla a banwani biye ū mhayo gwenūyo; a ba Hanania, Mishaeli nū Azalia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.17",
            "verseOrgIds": [
              "DAN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūbakomeleja balombe mu kwikūmbīja, ū Mulungu wa ng'wigūlū abachīle shigongo, aboolekeje ī mbisīla yenīyo; ū wei ū Danyeli na a banwani biye batizūbūlagwa hamò nī ligelè lya banhū ba bamasala ba mu Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.18",
            "verseOrgIds": [
              "DAN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu makanza ga būjikū akafuboolelwa ū Danyeli ī mbisīla yenīyo mu shakoolechiwa. Ū Danyeli ūnkumīlīja Mulungu wa ng'wigūlū ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.19",
            "verseOrgIds": [
              "DAN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ūhaya:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
