          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Ntemi akayega no, ūlagīja wīnjiwa ū Danyeli ū ng'wipilinga. Aho wafunyiwa ū Danyeli ū ng'wipilinga kaalī katīho nūūlū ka būchūūbūke kado ū kū mīlī gwakwe, nguno walī ansanije ū Mulungu wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        }
      ]
