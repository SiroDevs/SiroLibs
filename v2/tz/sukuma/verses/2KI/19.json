            "number": "36",
            "style": "v",
            "sid": "2KI 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lūūlū ū Senakelibu, ū ntemi wa Ashulu ūsambaagūla ī ng'hambī yakwe, ūshoka kaya Ninawi, ūūkikala kwenūko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
