            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūkūbeeja itundubaali lya būlūba bo langi ya būlulu na ya nzulunge na yaza, na kitaani īdosile chiza, na makelubi gasumīīlilwe mo ū ng'witundubaali lyenīlo, gabeejiwe na koolī wa nīmo gwenūyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna līkūningelejiwa na malobò ga zahabu ha ng'hīngī inè ja ntī gwa ng'wininga, najo jibilwe zahabu; jīmīīle ha shidako sha chūma sha feza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī litundubaali lyenīlo ūkūlīningeleja na madimījo, hūna ī lisandīko lya būkaanīji ūkūlītūūla ū kū mpīndo y'itundubaali lyenīlo, ī litundubaali lyenīlo līkūlekanya a ha gatī y'ipandī Lyeela, nī lipandī Lyeela no no no. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī Lisumbī lya shigongo ūkūlītūūla ng'wipandī Lyeela no no no, a higūlya y'isandīko lya būkaanīji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī meza yene ūkwītūūla hanze y'isenge, lwandī lwa sukuma, ū ng'wipandī lya kwikala; hūna ī likīndīkīlo lya talà ūlītūūla ha dakama yaho, shiihela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū nyango gwa kwingīlīla ū ng'wiheema, ūkūgūbeegeja itundubaali lya būlūba bo langi ya būlulu na ya nzulunge na yaza, na kitaani īshibanyiwe chiza mu būgaliili būtaale; gūbize nīmo go ng'wa koolī ntaale. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī litundubaali lyenīlo ūkūlībeegeja ng'hīngī itanò ja ntī gwa ng'wininga jilī na malobò ga zahabu, najo ūkūjibila zahabu. Hanuma ūjibeegeja shidako shitanò sh shaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
              "EXO.26.37"
            ]
          }
        }
