          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nang'hwe ū SEEBA ūnshokeja ū Musa, “Alilūūlū ī haha ūkūbona ūmo nalang'wītīle ū Falao; akūbalekela baje kūlwa nguno ya būdūla wa nkono gwane; nīyo akūbapeeja ū mu sī yakwe kūlwa nguno ya būdūla wa nkono gwane.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Mulungu ongeja ū kūng'wīla ū Musa, “Ū nene nalī SEEBA, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakang'wilongela ū Abulahamu nū Isaka, nū Yakobo; nūboolekeja gīkī nalī Mulungu Ndūji wa shose",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:3",
              "type": "text"
            },
            {
              "text": "Ndūji wa shose:",
              "type": "text"
            },
            {
              "text": "Shihebulania, Eli Shadai.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Alīyo natimanīkije ū kūbo ū mu lina lyane, ī lya gīkī nalī SEEBA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hangī nakabeeja ilagane lyane nabo kūlwa kūbinha ī sī ya Kanaani, ūmo bikalaga gītī balobeji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A higūlya ya yenīyo, naakwigwile ū kūlīla kwa Baisilaeli, ūmo Bamisili bakūbatūmamījaga mu būsese; nī lilagane lyane naalizūkilwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna lūūlū bawīlage a Baisilaeli gīkī, ‘Ū nene nalī SEEBA; managi gīkī nakūng'wīnja ū mu būdito bo miligo ya Bamisili, nang'wīnje ū mu būsese wa kūbatūmamīla boi. Nakūgūgoloola ū nkono gwane kūlwa kūmukomoola, nīīte shītīle shitaale sha kūbagwisīja nsango. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakūmusola nang'wīte mubize banhū bane, nū nene nabize Mulungu wing'we. A henaho hū mukūdeeba gīkī ū nene nalī SEEBA Mulungu wing'we; ūyo alīng'wīnja mu būsese wa kūbatūmamīla Bamisili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lūūlū nakūng'wenha ū kū sī īyo nakabūūcha nkono nūng'wilahīlīla Abulahamu na Isaka na Yakobo, gīkī nakūng'winha bing'we ībize ying'we ya wikomangīle, ū nene nalī SEEBA.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Musa ūbawīla ī mihayo yenīyo a Baisilaeli, alīyo batandegelekile, nguno ū būsese walī wabaminya no, kūshisha baalī baagwa ng'holò. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū SEEBA ūng'wīla ū Musa gīkī, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.10",
            "verseOrgIds": [
              "EXO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jaga ū kūlī Falao, ū ntemi wa Misili; ūkang'wīle abalekele a Baisilaeli bīnge ū mu sī yakwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
            "verseOrgIds": [
              "EXO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo ū Musa ūnshokeja ū SEEBA alīhaya, “A Baisilaeli benekīlī baalemile ū kūnidegeleka, sumva na Falao! Akwandya kinehe ū kūnidegeleka ū nene wa nomo gūtigeleelilwe kūlūngalūnga?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA ūlūngalūnga nabo hangī a ba Musa nū Alooni, ūbinha mihayo ya kūbatwalīla a Baisilaeli, nī ya kūntwalīla ū Falao, ū ntemi wa Misili; gīkī ībigeleelile babafunye a Baisilaeli ū mu sī ya Misili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shibyalīlwe sha Balawī",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A banhū aba hū baalī batongeeji ba kaya ja ng'wabo: A bitūnja ba ng'wa Lubeni, ū tangī o ng'wa Isilaeli, baalī, Hanoki na Palu, Hezilomu na Kalīmi, ī jenīji h'ī kaya ja mu lūganda lwa Lubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Simioni baalī, Yemūli, Yamini, Ohadi, Yakini, Zohali, na Shauli; ū ng'wene walī wa kūfuma mulī nkīma w'ihanga lya Bakanaani, ī jenīji h'ī kaya ja mu lūganda lwa Simioni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mina aya gene gaalī ga bitūnja ba ng'wa Lawī, gīt'ūmo shalī shibyalīlwe shabo, Gelishomu, Kohati, na Melali. Ū Lawī akashisha būlamu wa myaka igana na makūmi adatū na mpungatī. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Gelishomu baalī ba Libīni, na Shimei; h'ī kaya jabo ī jenījo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
            "verseOrgIds": [
              "EXO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Kohati baalī ba Amulamu, Izihali, Hebuloni na Uzieli. Ū Kohati akashisha būlamu bo myaka igana na makūmi adatū n'idatū. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
              "EXO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Melali baalī ba Mahili na Mushi, ī jenīji h'ījo jalī kaya ja mu lūganda lwa Lawī; h'ūmo shalī ī shibyalīlwe shabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Amulamu akantoola sengiye, Yokebedi ūmyalīla ba Alooni na Musa; ū Amulamu ng'wenūyo ūbiza na būlamu bo myaka igana na makūmi adatū na mpungatī. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.20",
            "verseOrgIds": [
              "EXO.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Izihali baalī ba Koola, Nefegi na Zikili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.21",
            "verseOrgIds": [
              "EXO.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Uzieli baalī ba Mishaeli, Elizafani na Sitili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū nke o ng'wa Alooni walī Elisheba, nshīke o ng'wa Aminadabu, n'ilūmbūye o ng'wa Naashoni. Akabyala nang'hwe ba Nadabu, Abihu, Eleazali na Itamaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Koola baalī ba Asili, Elikana na Abiasafu. A benaba hū baalī ba kūfuma mu kaya ya ng'wa Koola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Eleazali ū ng'witūnja o ng'wa Alooni akantoola ūmò wa bashīke ba ng'wa Putieli, ūmyalīla ng'witūnja lina lyakwe Finehasi. A benaba hū baalī ba lūganda lwa Lawī; būlī kaya yene yene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama ū ng'wenūyū h'ū Alooni ūyo walī hamò na Musa; banhū abo SEEBA akabawīla, “Bīnjagi a Baisilaeli ū mu Misili, gafume mo pye a mabità gabo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A benaba hū bene a ba Musa nū Alooni, abo bakang'wīla ū Falao, ū ntemi wa Misili mihayo ya kūbafunya a Baisilaeli ū mu sī yakwe ya Misili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
              "EXO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alooni kūyomba ha ng'wanya go ng'wa Musa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
              "EXO.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna lūūlū ū Musa aho alī mu sī ya Misili, ū ng'wikanza lyenīlo h'aho ū SEEBA akalūngalūnga nang'hwe ūng'wīla gīkī, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        },
        {
          "name": "verse",
