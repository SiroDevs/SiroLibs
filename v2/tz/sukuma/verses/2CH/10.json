  "reference": "2 Mihayo Ya Shikū 10",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
