              "2CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Balawī ūbatūūla mu hekalu ya ng'wa SEEBA hamò na nzege, ndono, na malimba jabo gīt'ūmo Daūdi alagīlile, nū mumo ahayīlile ū Gaadi ū moni wa ntemi, hamò nū ng'hangi Nasani. Ū mhayo gwenūyū gwalī gwalagīlwa na SEEBA mu nzīla ya bahangi bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lūūlū a Balawī bīmīīla bamalīīlile balī nī shikolo sha kwīmbīla shenīsho ī sha ng'wa Daūdi; na a bagabīji na mhembe jabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Hezekia ūlagīla shūfunyiwa ī shitambò sha kūpemvwa a ha ng'walīlo. Aho shandya kūfunyiwa ī shitambò, wandya nū wīmbi kūlwa kūng'wīmbīla ū SEEBA; kūnū jikūlīlaga ī mhembe nī shikolo ī sha ng'wa Daūdi ū ntemi wa Isilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pyī ī libità lya banhū abo baalī bibilinga binama kūlamya, kūnū a bīmbī bakwīmbaga, nī mhembe jikūng'ang'aalaga. Ī yenīyī yūja gīko kūshisha ū nīmo gwa kūfunya shitambò sha kūpemvwa gūshila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū nīmo gwa kūshifunya ī shakwinha aho gwashila, ū ntemi na a bose abo baalīho hoi būtuja mazwi kūlamya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntemi Hezekia na a batūmami bakwe būbalagīla a Balawī kū nkumīlīja ū SEEBA mu kūtūmamīla mīmbo ga ng'wa Daūdi na ga moni Asafu. Na lūūlū bīmba bakūkumīlījaga na būyegi būtaale; hūna binamya ī mitwe yabo kūlamya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shitambò sha mu hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Hezekia ūhaya, “Na lūūlū ī haha īkī ng'wamala ū kwiyeeja kūlwa ng'wa SEEBA, nzūgi ū mu hekalu ya ng'wa SEEBA mufunye shitambò nī shakwinha sha kūlūmba.” Na ng'hana a banhū abo baalī bibilinga, benha ī shitambò nī shakwinha sha kūlūmba; bose pye abo ng'holò jabo jalī jitogilwe benha shitambò sha kūpemvwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī lisaabu lya shitambò sha kūpemvwa īsho shikafunyiwa na a banhū abo baalī bibilinga, jalī nzagamba makūmi mpungatī, ng'ondi nhaale igana, na ng'ondi songi magana abīlī; ī jose jenīji jūfunyiwa kūlwa shitambò sha kūpemvwa nguno ya ng'wa SEEBA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī mitugo ījo jalī jeejiwa kūlwa kūfunyiwa kūbiza shitambò jalī nzagamba magana atandatū, ī ng'holo nī mbūli jalī shihūmbī shidatū. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike a bagabīji ba kūgwīta ū nīmo gwa kūjibaaga ī mitugo ja shitambò sha kūpemvwa, baalī bageehu no. Aho bagabīji bangī bataalī ū kwiyeeja, a badūgū babo a Balawī būbagunanha, kūshisha gūshila ū nīmo; nguno a Balawī baalī bachagūku ū mu kwiyeeja, kūtinda a bagabīji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalī shitambò sha kūpemvwa shingī no, hamò na a masazu ga shakwinha sha būsangī, nī shakwinha sha kūng'wiwa īsho shajaga hamò nī shitambò sha kūpemvwa. Na lūūlū ū būlamya wa mu hekalu ya ng'wa SEEBA būbiza wandyiwa hangī. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Hezekia na a banhū a bose būyega no kūlwa yose īyo akīyīta ū Mulungu kūlwa banhū bakwe, nguno īkaja wangū no.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
