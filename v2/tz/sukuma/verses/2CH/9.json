          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nīyo ū ntemi walī wajikwīja no ī feza ū mu Yelusalemu, jaali gītī mawe dūhū, nī mbaawa ja mitī ya mibanga jalī ningī no gītī mipumbula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:27",
              "type": "text"
            },
            {
              "text": "Mipumbula:",
              "type": "text"
            },
            {
              "text": "Lola 1:15.",
              "type": "text"
            }
          ]
        },
        {
          "text": " īyo īkazwaga mu matūmbī. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī falasa ja ng'wa Solomoni jalagījiagwa kūfuma Misili na kūfuma kū sī jingī jose pye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
