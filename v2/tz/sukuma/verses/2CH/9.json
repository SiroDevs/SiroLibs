          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "A batemi ba mu sī ja kwīngīīla kū Mongo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:26",
              "type": "text"
            },
            {
              "text": "Mongo:",
              "type": "text"
            },
            {
              "text": "Hū kūhaya mongo gwa Flati.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kūshisha kū sī ya Bafilisiti, na kūshisha kū lūbīmbī lwa Misili baalī ha sīlīlī ya būsugi wakwe pye a bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
