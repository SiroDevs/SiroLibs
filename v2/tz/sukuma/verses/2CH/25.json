          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike ū Amazia ng'witūnja o ng'wa Yoashi ū ntemi wa Yuda akikala alīho mpanga kūshisha ikanza lya myaka ikūmi n'ītanò, a ha numa ya kūcha kwa ng'wa Yehoashi ū ng'witūnja o ng'wa Yehoahazi ntemi wa Isilaeli. ",
          "type": "text",
