              "1SA.17.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1SA 17:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Daūdi ūgūsola ū ntwe gwa Mfilisiti ūja nago Yelusalemu; lelo ī shilanga sha Mfilisiti ng'wenūyo ūūkashitūūla ū Daūdi ng'wiheema lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "A hikanza lya kūjūūtobana nū Mfilisiti ū Daūdi, ū Saulo akang'witana ū Abuneeli, ū ntaale wa mabità ga bashilikale; ūmūūja, “Bebe Abuneeli, ū nsūmba ng'wenūyo ni ng'witūnja o ng'wa nani?” Ū Abuneeli ūshosha alīhaya, “Nalilahīla kū būtongi wako baba ntemi, natamanile gete.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntemi ūhaya, “Būūgīlījaga ūdeebe ū nsūmba ng'wenūyū ng'witūnja o ng'wa nani!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Daūdi aho wafuma dūhū ū kūlībūlaga ī Līfilisiti, ū Abuneeli ūnsola ūntwala kūlī Saulo, ū Daūdi ataalī agūbūūkije mu nkono ū ntwe gwa Mfilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Saulo ūmūūja, “Bebe nsūmba, ūlī ng'witūnja o ng'wa nani ī gete?” Daūdi nang'hwe ūshosha ūhaya, “Nalī ng'witūnja wa nsese wako Yese muna Betelehemu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
