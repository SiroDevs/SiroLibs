  "reference": "1 Sang'Weli 22",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
