            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wa Yafeti baalī:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        }
      ]
