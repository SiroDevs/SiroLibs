            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Īyī yene mihayo ya bitūnja ba ng'wa Noa, aba Shemu, Hamu na Yafeti; aho lyabīta ī lihūūma nabo bakabyala bitūnja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shibyalīlwe sha ng'wa Yafeti",
          "type": "text"
        }
      ]
    },
    {
