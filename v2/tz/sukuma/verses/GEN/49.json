          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ū Nafutali ng'wene mhala",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.21",
            "verseOrgIds": [
              "GEN.49.21"
            ]
          }
        }
