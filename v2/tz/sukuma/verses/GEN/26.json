          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Esau aho washisha myaka makūmi anè akantoola Yudisi, nshīke wa Ng'hītī witanagwa Beeli; na Basemati, nang'hwe nshīke wa Ng'hītī witanagwa Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bakīma benabo bakenha būpīna no ū kū ba Isaka nū Lebbeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
        }
      ]
    }
