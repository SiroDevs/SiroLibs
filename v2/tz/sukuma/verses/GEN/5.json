            "sid": "GEN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Seti aho washisha myaka igana n'ītanò (105), ūmyala Enoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
