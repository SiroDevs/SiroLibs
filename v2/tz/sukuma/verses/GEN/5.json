            "sid": "GEN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Matusela aho washisha myaka igana na makūmi anaane na mpungatī (187), ūmyala Lameki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.25",
            "verseOrgIds": [
              "GEN.5.25"
            ]
          }
        },
        {
