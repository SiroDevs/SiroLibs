          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kūfuma a ha kūbyalwa kwa ng'wa Enoshi, ū Seti akikala ho myaka magana anaane na mpungatī (807). Ūbyala na bitūnja bangī, hamò na bashīke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
