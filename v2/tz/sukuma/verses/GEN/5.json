          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī myaka ya būlamu bo ng'wa Matusela ī yose yalī magana kenda na makūmi atandatū na kenda (969), hūna ūcha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
            ]
          }
        },
        {
