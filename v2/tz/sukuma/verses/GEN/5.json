              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Enoka aho washisha myaka makūmi atandatū n'ītanò (65), ūmyala Matusela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.21",
            "verseOrgIds": [
              "GEN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kūfuma a ha kūbyalwa kwa ng'wa Matusela, ū Enoka ūmala myaka magana adatū (300) akūshimīzaga hamò na",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:22",
              "type": "text"
            },
            {
              "text": "Hamò na Mulungu:",
              "type": "text"
            },
            {
              "text": "Nūūlū, mu kūng'wigwa Mulungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mulungu. Ūbyala na baana bangī bagosha na bakīma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī myaka ya būlamu bo ng'wa Enoka īkabiza magana adatū na makūmi atandatū n'ītanò (365). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.23",
            "verseOrgIds": [
              "GEN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu shimīzīle yakwe ū Enoka wikalaga hamò na Mulungu, hūna kwimanīla oya ū kwilonga, nguno ū Mulungu akansola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.24",
            "verseOrgIds": [
              "GEN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
