          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Lameki aho washisha myaka igana na makūmi anaane n'ībīlī (182), akabyala ng'wana ngosha; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.28",
            "verseOrgIds": [
              "GEN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūng'wilīka ī lina lyakwe Noa; ūhaya gīkī, “Akūtūlūngūja ū mu katūmamīle kise nū būdito wa milīmo ya makono gise, īyo tūlī nayo kūlwa makoye ga sī īyo SEEBA wīzuma.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
