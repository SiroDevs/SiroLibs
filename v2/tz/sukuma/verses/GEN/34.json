              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Būgaswaga pye a madaale ga mitugo jabo, ng'holo, ng'ombe, nī nzobe; būlī shikolo īsho shaalī ū mu nzengo nī sha kū malaale, būsola būtwala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pyī ī sabo jabo būjisola, pye na a bakīma na a baana babo; pyī nī shikolo sha mu kaya būshisola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Yakobo ūbawīla a ba Simioni nū Lawī gīkī, “A bing'we ng'wanenhelaga iyanga ī lyenīlī, nguno ng'wanibilaga inyīma ū kū benīkīlī sī īyī, a Bakanaani na a Bapelizi, a bazengi ba ng'wenūmu. A bise tūlī bagehu no; a boi ūlū bisangīja hamò hūna būnidumīla, bakūnikenaagūla kamò na kamò ū nene nī kaya yane.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.30",
            "verseOrgIds": [
              "GEN.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo būnshokeja ū saabo balīhaya gīkī, “Nibūlī walī wangemile ū ilūmbū lise kūbiza malahya?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.31",
            "verseOrgIds": [
              "GEN.34.31"
            ]
          }
        }
