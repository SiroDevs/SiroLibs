            "number": "26",
            "style": "v",
            "sid": "GEN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Mulungu ūhaya gīkī, “Tūbeeje na munhū mu suso yise, abize wa kūtwikola. Bajisuge ī ndīlo ja mu nyanza, nī noni ja higūlya, pyī nī ndimu; babize basugi bayo ī sī, nī shiinū ja kwigweesa ha sī pyī ī jose.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        }
      ]
