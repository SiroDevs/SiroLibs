              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama hangī ū mu lūshikū lwenūlo, ū Nzwano go ng'wa SEEBA gūkūbeelela no, na gūkūbiza n'ikūjo itaale. Hūna a matwajo ga sī gakūbiza shingilima n'ikūjo ū kū Baisilaeli abo bakūpūlūgūka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Būlī ng'wene ūyo ūlekeelwa ī Sayuni, ūyo wikala mu Yelusalemu, akwitanwa ng'wela, ose ose ūyo andīkilwe kūpīla ū mu Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA akūbīngīja ū būsoso wabo a bakīma ba Sayūni; akwīyeeja ī Yelusalemu mu kūtūmamīla Moyo wa būlamuji na Moyo wa moto, īkwela pe yīnge ū mu būsoso wa mininga gayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna a higūlya ya bose abo bakwibilinga ha lūgūlū lwa Sayūni ū lose, ū SEEBA akūbeeja ilunde lya lyochi kūlwa kūbalang'hana ng'wikanza lya līīmi, na moto gwa kwenha būpe kūlwa makanza ga būjikū; a higūlya y'ikūjo ī lyose līkwīma ho ifīkījo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Līkūbiza lya kūtūūla mbeho ng'wikanza lya līīmi isebu, na būpīlīlo mu makanza ga mbula na ga nyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    }
  ],
