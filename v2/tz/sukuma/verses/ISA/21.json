          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū būshiigo wa balasi, a bashilikale ba Kedaali, būkūbiza būgehu no.” Alīhaya SEEBA Mulungu wa Isilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
            "verseOrgIds": [
              "ISA.21.17"
            ]
