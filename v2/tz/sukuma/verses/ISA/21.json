              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguno ū Seeba waniwīlile, “Ng'wikanza lya ng'waka gūmò, gīt'ūmo ng'witūmamīja wa mheela akabalīlaga ikanza lyakwe, pyī ū wikumīlīja wa Kedaali būkūshila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
              "ISA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
