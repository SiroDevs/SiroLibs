      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Būhangi kūlwa Edomu na Alabia",
          "type": "text"
        }
      ]
    },
