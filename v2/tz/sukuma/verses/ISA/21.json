              "type": "text"
            }
          ]
        },
        {
          "text": "Mhayo kūlwa nsango kū sī y'itogolo, itogolo ikalamuku lya kū ng'hilimvwa na nyanza:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
