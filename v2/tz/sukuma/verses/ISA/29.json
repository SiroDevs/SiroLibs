            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangī nūūlū winhwa munhū atamanile kūsoma ūwīlwa, “Alishisomage īshi!” Akūshosha ahaye, “Natūdūla nguno natamanile ū kūsoma.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
