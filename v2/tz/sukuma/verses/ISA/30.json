              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana balemile kūhang'wa balī",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.1",
            "verseOrgIds": [
              "ISA.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "SEEBA kūbisagīja abo bakūgalūka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
