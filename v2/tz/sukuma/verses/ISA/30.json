          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Līlīho ipandī lya Tofezi lībeejiwe ng'hana ng'hana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
              "ISA.30.33"
            ]
          }
        }
      ]
