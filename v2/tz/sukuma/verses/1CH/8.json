              "type": "text"
            }
          ]
        },
        {
          "text": "A bitūnja ba ng'wana wa ng'wawe ū Esheki baalī: Ulamu, myalwa wakwe wa kwandya, Yeushi wa kabīlī na Elifeleti wa kadatū. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
