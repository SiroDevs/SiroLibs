      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguno nani amanile yawiza kūlwa ng'wa munhū aho ataalī mu shikū jakwe ī ngehu ī ja būpanga būtī na solobo, ūmo akūbītaga gītī ng'wengeeji? Hangī nani ūyo adūgīje kūūmanīīkīja ū munhū mihayo īyo īkwilonga a ha sīlīlī ya līīmi ūlū lyūbīta ī likanza lyakwe?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
        }
      ]
