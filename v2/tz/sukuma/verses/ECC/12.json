              "ECC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nīyo ū Nomeeji walī atagelelile kūbiza na masala dūhū, alīyo na a banhū wabalangaga na kūbinha būmani; walī ng'wideedeng'hanya na mani wa kūgīsīlīja mihayo, nose walī wandīka sumo ningī, ūjihela mu būgaliili būtaale. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Nomeeji wīkulaga mu būgoogo ī mihayo apandīke īyo yigeleelilwe; hūna lūūlū īyo wīyandīka ītūngīlīgije hangī ya ng'hana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī mihayo ya banhū ba masala ītikīlile na someke, ī sumo jabo bakajipandīkaga kūfuma kūlī Ndīīmi ūmò; jibange gītī mizumali īkomilwe hanhū yūdaama. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alilūūlū ng'wanone, ilang'hanage nayo ī mihayo ya kūkīla ho a henaho. Nguno ū wandīki wa shitabo būtī na būkalīkīle, hama nī lisoma līkagūnojaga ū mīlī.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    }
