  "reference": "Kūkundūlīlwa 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
