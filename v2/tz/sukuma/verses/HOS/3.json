              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguno a Baisilaeli bakwikala shikū ningī batī na Ntemi nūūlū nsugi, nūūlū shitambò yaya, biya nūūlū mawe ga kwilamīlīgīja, ndūhū nūūlū nīmo gwa nyagabīji nūūlū shiikolile sha kūlamiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuma a Baisilaeli bakūshoka kūnkooba ū SEEBA Mulungu wabo nū Daūdi ū ntemi wabo. Ū kū shikū ja būkalīkījo bakwiza mu kūdetema balīnkooba ū SEEBA wabo nī jakwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
    }
