              "text": "2:23",
              "type": "text"
            },
            {
              "text": "Batī banhū bane:",
              "type": "text"
            },
            {
              "text": "Shihebulania, Lo-Ami.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akūbawīla, “Mulī banhū bane,” nabo bakūhaya, “Ūlī Mulungu wane.”",
          "type": "text",
          "attrs": {
