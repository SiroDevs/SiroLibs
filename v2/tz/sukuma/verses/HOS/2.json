        },
        {
          "text": "A baana ba ng'wing'we a bagosha bawīlage, “Banhū bane,” na a baana ba ng'wing'we a bakīma bawīlage, “Batogwa bane.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isilaeli kwinhwa nsango na kūshoshiwa būpya hangī",
          "type": "text"
        }
      ]
    },
