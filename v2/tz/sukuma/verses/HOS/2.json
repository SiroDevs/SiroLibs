              "text": "2:23",
              "type": "text"
            },
            {
              "text": "Atī ntogwa wane:",
              "type": "text"
            },
            {
              "text": "Shihebulania, Lo-Luhama.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abo bakūhayiagwa gīkī, “Batī banhū bane,”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.23",
            "verseOrgIds": [
              "HOS.2.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
