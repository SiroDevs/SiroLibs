          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūkwikala ūkūhayaga, “Nalī Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
