          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mhayo go ng'wa Seeba gūnizīīla hangī: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.11",
            "verseOrgIds": [
              "EZK.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'wana wa munhū, tūlaga ng'hūngū kūlwa ntemi wa Tulo ūng'wīle, Ū Seeba MULUNGU alīhaya gīkī,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walī mu ngūnda gwa Edeni, ngūnda go ng'wa Mulungu; būl'iwe lya mpango lyalīho kūlwa būlenji wako; jalīmo lubi, topazio, alimasi, kilisolito, oniki, yasipi, safilo, takwiyo, na belilo. Ū nsingi gwa milīmo yako yalī zahabu, pyī ī shenīshi shalī shatūūlwa ho kūlwa nguno yako kūfuma lūshikū lwa kūbūmvwa kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.13",
            "verseOrgIds": [
              "EZK.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū bebe walī Ikelubi lībilile maguta",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.14",
            "verseOrgIds": [
              "EZK.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Būhangi kūlwa sī ya Sidoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
