              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū kū lwande lo dakama ū lūbīmbī lūkūfuma Tamali lūūkashika kū minzī ga Meliba-kadeshi, hūna lūsīngīja longa lo Misili kūjīlīīla kū Nyanza Nhaale. Ū lwenūlū hū lūkūbiza lūbīmbī lo dakama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
