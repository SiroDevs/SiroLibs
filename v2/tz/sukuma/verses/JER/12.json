              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA alīhaya, “Pye a bazenganwa bichane a babūbi, abo bakūdaatyaga wingīji bone ūbo naabinha banhū bane a Baisilaeli, nakūbadubbūla nabīnje ū mu sī jabo; nī numba ya Yuda nakwīdubbūla yīnge ū mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike ūlū nūmala ū kūbadubbūla, a hanuma yaho nakūbachīla shigongo; būlī ng'wene nanshoshe hangī mu wingīji bokwe, mu sī ya ng'wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nīyo ūlū būjiilanga mu būkalalwa ī nzīla ja banhū bane, nū kwilahīla būyilahīla mu lina lyane, gīkī, ‘Ūmo SEEBA alī mpanga,’ gīt'ūmo baalī babalangīla a banhū bane kwilahīla mu lina lya ng'wa Baalī, a henaho nabo bakūzengwa babize hamò na a banhū bane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo ūlū ihanga lyose lyose lyūlema ū kwigwa, nakūlīdubbūla nalyīnje nalīkenaagūle gete.” Alīhaya SEEBA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
