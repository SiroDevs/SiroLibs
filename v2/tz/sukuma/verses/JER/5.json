              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike nahene nūūlū ū mu shikū jenījo. Alīhaya SEEBA, natūmukenaagūla mushile pye gete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
