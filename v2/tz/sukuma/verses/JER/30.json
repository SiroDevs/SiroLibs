        "style": "s1"
      },
      "items": [
        {
          "text": "Isilaeli kwisagījiwa būpya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
