              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī shibi sha banhū ba Yuda",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ī sabato shiigelile īkūjiwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA akaniwīla, “Jaga ūkīmīīle a ha mità gwa kūbītīla banhū, aho batemi ba Yuda bakabītīlaga ūlū balingīla na kūfumīla, na a ha mibità ī yīngī ī ya Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūbawile gīkī, Gwigwagi ū mhayo go ng'wa SEEBA bīng'we batemi ba Yuda, na banhū bose pye ba mu Yuda, na a bazengi ba Yelusalemu pye abo mukabītīlaga a ha mibità īyī. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA alīhaya gīkī, Ilang'hanagi, yaya kūbūūcha nigo gose gose mu lūshikū lwa sabato; yaya nūūlū kūgūbītya a ha mibità kwingīla nago mu nzengo gwa Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaya nū kūfunya nigo mu numba jing'we, nūūlū kūtūmama nīmo gose gose mu lūshikū lwa sabato. Alīyo lūlang'hanagi ū lūshikū lwa sabato lwikale lwela, gīt'ūmo nakabalagīīlīla bakūlūgenji bing'we. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike batadegelekile nūūlū kūdīlīla batadīlīlile; baalī na mitwe midaamu no, batadegelekile nūūlū batawanukūlile ū būhūgūji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo ū SEEBA alīhaya gīkī, ūlū ng'ūbiza belwa ng'holò ū kūniigwa, ng'ūlūlang'hana ū lūshikū lwa sabato lwikale lwela, ng'ūleka kūbītya nigo gose gose a ha mibità ya nzengo gwenūyū ū mu lūshikū lwa sabato, ng'ūleka nūūlū kūtūmama nīmo gose gose ū mu lūshikū lwenūlū, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ū mu gīko a batemi abo bakigashaga h'isumbī lya būtemi lya ng'wa Daūdi bakwingīla kūbītīla a ha mibità ya nzengo gwenūyū, balī hamò na a bataale ba būsugi wabo. A boi na a basugi ba ha sīlīlī yabo bakwingīla balī mu magogoteni ga būlūgū, na badamhīlile falasa. Na a banhū ba Yuda na a bikaji ba mu Yelusalemu bakūbiza hamò nabo; hūna ū nzengo gwenūyo gūkūbiza na banhū shikū jose ilalī. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.25",
            "verseOrgIds": [
              "JER.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banhū bakwiza kūfuma mu mizengo ya Yuda, nū mu magūngūli ga hihī hihī na Yelusalemu, bangī bakūfuma na kū sī ya Benjamini; na kū mbūga ja ng'weli, na kū sī ja magūlya, na Negevu. Pye a benaba bakwenha shakwinha ū mu numba ya ng'wa SEEBA; bakwiza na shitambò sha kūpemvwa, na shitambò, na shitambò sha būsu na būbbani; hamò na shakwinha sha kūlūmba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo ūlū mutūniigwa ū mu mhayo gwa kūlweja ū lūshikū lwa sabato, gīkī ū mu lūshikū lwa sabato mutizūbīta a ha mibità ya Yelusalemu mubūkije miligo, ū nene nakūbacha moto gūtī na būjimīje a ha mibità yenīyo, gūjinogoteje pyī ī numba j'ikūlū ū mu Yelusalemu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.27",
            "verseOrgIds": [
              "JER.17.27"
            ]
          }
        }
      ]
    }
  ],
