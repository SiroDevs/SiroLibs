              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntwe gwane ūyū, gīt'ūlū ni",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
