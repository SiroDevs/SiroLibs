          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.30",
            "verseOrgIds": [
              "JER.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA alīhaya gīkī,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alīyo ū SEEBA alīhaya gīkī,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.33",
            "verseOrgIds": [
              "JER.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.37",
            "verseOrgIds": [
              "JER.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū SEEBA alīhaya, “Jikūshika ī shikū, ū nzengo gwenūyū gūkūzengwa būpya kūlwa nguno yane, kwīngīīla kū numba ndīhu ya ng'wa Hananeli kūshisha kū mita gwa kū Kuluba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.38",
            "verseOrgIds": [
              "JER.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū lūgoye lwa kūpimīla lūkwandīja henaho lūūgoloola lūjile lūūkakandya kū kalūgūlū ka ng'wa Galebu, lūūnyamukīla kū kuluba ya Goa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.39",
            "verseOrgIds": [
              "JER.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ī lipandī ū kwandīja mu longa pyī ū lose ūmo īkaponejiagwa mibimba na mabu, nī lilago kūlola kīya kūja mu longa lo Kiduloni, na kūja kū kuluba ya kū mita gwa Falasa, ī lipandī lyenīlo līkūbiza lyela kūlwa ng'wa SEEBA. Ū nzengo gwenūyo gūtaladubbūlwa hangī, yaya nūūlū kūsambaagūlwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.40",
            "verseOrgIds": [
              "JER.31.40"
            ]
          }
        }
      ]
    }
  ],
