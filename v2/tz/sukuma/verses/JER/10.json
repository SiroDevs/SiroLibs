          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Alilūūlū bawīlage gīkī, ‘A bamulungu abo batalīsūmbile ī ligūlū nī sī, bakūyagaala bashile ū mu sī, batūbiza ho a ha sīlīlī y'igūlū.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
            "verseOrgIds": [
              "JER.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Būkwiza būkenaagūji būtaale",
          "type": "text"
        }
      ]
    },
