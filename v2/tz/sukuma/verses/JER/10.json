              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bing'we numba ya Isilaeli, gwigwagi ū mhayo ūyo alīmuwīla ū SEEBA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
