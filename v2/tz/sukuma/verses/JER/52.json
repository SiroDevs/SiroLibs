            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntemi wa Yuda ū Yehoyachini aho washisha myaka makūmi adatū na mpungatī alī mu būtungwa, Evi-melodaki ūbiza ntemi wa Babuloni. Mu lūshikū lwa makūmi abīlī n'itanò ng'weji gw'ikūmi n'ībīlī, ū ntemi ng'wenūyo ūntaligūlīla ū Yehoyachini ū ntemi wa Yuda, ūng'wīnja ū mu jeela ūng'winha wiyaabī. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūyūlūngalūnga nang'hwe nhambū jawiza; ūngūngūhya, nī lisumbī lya kwigaasīja ūng'winha ly'ikūjo kūtinda a batemi a bangī abo baalī baatungwa Babuloni hamò nang'hwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kūfuma ikanza lyenīlo ū Yehoyachini ūlekana nasho ī shizwalo sha nyatungwa; nīyo ī shilīwa ūyūlīīla ha meza ya ntemi būlī lūshikū pyī ī shikū ja būpanga bokwe ūbo būkasaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntemi wa Babuloni ūlagīja gīkī ū Yehoyachini ayūpandīka shiigunaanīlo būlī lūshikū, ū mu shikū jose ja būlamu bokwe, kūshisha lūshikū lwa kūcha kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
