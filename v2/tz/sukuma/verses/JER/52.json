        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntaale wa balang'hani ba ntemi akajūmponya mu jeela ū Selaya ūyo walī ntaale wa bagabīji, nū Sefania ūyo walī ngabīji wa kabīlī ū mu būtaale; na balang'hani badatū ba milyango. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu banhū abo baalīmo ū mu nzengo akansola ū ntaale wa bashilikale ba būlūgū, na banhū mpungatī abo baalī bagunanhi ba ntemi mu mihayo ya būsugi. Na kalaani ntaale ūnjaana, ūyo nīmo gwakwe gwalī kūbahelela milīmo yabo a banhū ū mu sī, akanjaana hamò na banhū bakwe makūmi adatū, abo bakasangīlwa ū mu nzengo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Nebuzaladani ū ntaale wa balang'hani akabatwala kūlī ntemi wa Babuloni pye a banhū benaba, walī Libuna. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū ntemi ūlagīja būbūlagīlwa Libuna kwenūko, mu sī ya Hamasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
