          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu ng'waka gwakwe gwa makūmi abīlī n'idatū, ū Nebuzaladani ū ntaale wa balang'hani ba ntemi akabasaamya Bayudaya maagana mpungatī na makūmi anè na batanò, ūbatwala mu būding'wa. A banhū a bose abo bakasaamiwa baalī shihūmbī shinè na magana atandatū.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyachini kwinhwa wiyaabī",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
