              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū Yelemia ūsola shitabo shingī, ūng'winha ū Baluki ū ng'wandīki, ū ng'witūnja o ng'wa Nelia. Wandya kwīhaya ū Yelemia ī mihayo īyo yalī ū mu shitabo īsho Yehoyakimu ntemi wa Yuda akashipemba mu moto, kūnū ū Baluki akwīyandīkaga ū mu shitabo. Na mihayo yīngī mingī ya mbika yenīyo yongejiwa a higūlya yaho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
