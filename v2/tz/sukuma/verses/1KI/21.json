            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Ahabu aho wigwa ī mihayo yenīyī, ūtandūla ī shizwalo shakwe; ūzwala magūnīla; ūfunga na kūfunga. Nū kūlaala ūyūlaala ha magūnila, hangī ūbiza ng'widoohya nū mu kashimīzīle. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hūna ū mhayo go ng'wa SEEBA gūng'wizīīla ū Eliya ū muna Tishibe gūlīhaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wamonile ū Ahabu ūmo widoohegije ū kū būtongi wane? Na lūūlū īkī widoohije gīko, natūwenha ū būbi wenūbū ū mu shikū jakwe, alīyo nakwīyenhela ī kaya yakwe mu shikū ja ng'witūnja wakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
