          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguno pyī ī mihayo yenīyī yītagwa na a mahanga ayo gikalaga ū mu sī yenīyo aho mutaalī a bing'we ū kūja kwikala mo, h'ī chene ī sī īkasosohala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na a bing'we ūlū muyīsosohaje ī sī yenīyo, īkūmuswa gīt'ūmo yabaswīīla a banhū ba mahanga ayo gikalaga mo aho mutaalī kwingīla mo a bing'we.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        }
      ]
