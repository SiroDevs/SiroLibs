              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūlū yūbiza ītaalī ko myaka mingī, ī sabo īyo alafunye kūlwa kwikomoola kwakwe īkūbiza nhaale, kūlenganīla nī mheela ya kwinhwa ng'witūmamīja ng'wikanza lya myaka gītī yenīyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51",
            "verseOrgIds": [
              "LEV.25.51"
            ]
          }
        },
        {
          "name": "verse",
