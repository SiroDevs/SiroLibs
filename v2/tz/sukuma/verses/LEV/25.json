              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiigelile abalwe gītī ng'witūmamīja ūyo mheela yakwe akalīpagwa būlī ng'waka; nīyo yaya ū kūng'wiloleela dūhū kūnū akūluhiagwa nū munhū ūyo wangūla.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        }
