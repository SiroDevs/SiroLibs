              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kūlwa ibimbà, nūūlū būhele, nūūlū ibalà ibalalūku, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
