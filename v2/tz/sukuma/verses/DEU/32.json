              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bing'we mapandī ga ng'wgūlū,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.1",
            "verseOrgIds": [
              "DEU.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mulungu kūbinha nsango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
