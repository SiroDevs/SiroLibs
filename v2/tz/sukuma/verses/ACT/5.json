  "bookId": "ACT",
  "reference": "Shītwa Sha Batūng'Wa 5",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
