              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu shikū jenījo nī likanza",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
