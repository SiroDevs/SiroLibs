              "JHN.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūyo afumile kwigūlya alī higūlya ya yose; nū wa mu sī nang'hwe wa mu sī dūhū, nī yīyo akalūngalūngaga nayo ya mu sī. Ūyo afumile ng'wigūlū alī higūlya ya yose; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
              "JHN.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Īyo ayībonile nī yīyo akwīyigwaga hū yene akwīkaanīlaga, alīyo atīho ūyo akūwanukūlaga ū būkaanīji bokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
              "JHN.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūyo ūwanukūla ū būkaanīji bokwe, akūbiza wazunyaga gīkī, ū Mulungu alī wa ng'hana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.33",
            "verseOrgIds": [
              "JHN.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguno ūyo atūmilwe na Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:34",
              "type": "text"
            },
            {
              "text": "Mulungu:",
              "type": "text"
            },
            {
              "text": "Nūūlū, Sīswe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akahayaga mihayo ya ng'wa Mulungu, īkī ū Mulungu atinhaga ū Moyo Ng'wela mu kūgemeela. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū Baba antogilwe no ū Ng'wana wakwe, na lūūlū pyī ī shikolo ashitūūlile mu nkono gokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūyo ūnzunya ū Ng'wana alī na būpanga butashilaga, lelo ūyo atūnzunya ū Ng'wana, atūbūbona ū būpanga, alīyo ū būpelanu bo ng'wa Mulungu būng'wikalīlile!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
      ]
    }
