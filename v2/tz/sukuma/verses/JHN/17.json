{
  "id": "JHN.17",
  "number": "17",
  "bookId": "JHN",
  "reference": "Yohana 17",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
