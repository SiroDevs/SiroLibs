          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ū mu sī ya wingīji wabo baalī na mizengo īyī, Zola, Eshitaoli, Ili-shemeshi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
