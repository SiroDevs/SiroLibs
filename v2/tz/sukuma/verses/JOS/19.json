          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehudi, Bene-belaki, Gati-limoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me-yakoni, na Lakoni, nī lipandī īlo lyaalī lyilolile na Yopa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwike a banhū ba lūganda lwa ng'wa Dani bakalemeelwa ū kwīlang'hana ī sī yabo, yūja na banishi; nabo būūkagūdumīla nzengo gwa Leshemu, būgūdima, būbabūlaga pye a banhū na ng'wene, gūbiza gwabo boi. Aho balenda ū mu nzengo gwa Leshemu, būgūgalūcha ī lina būgwitana Dani, kūlwa kūng'wizūkwa saabo nkūlū Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
