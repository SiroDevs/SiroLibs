          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Alifakisadi aho wafikyaga musimo gwa myaka maku'mi adatu' na itano, wapandi'kaga mwana lina Sela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku'fuma aho wav'yalagwa Sela, Alifakisadi wikalaga myaka magana ane na idatu'. Mugati' na myaka zyeni'zyo wapandi'kaga hangi' v'ana v'a ki'gosya na v'a ki'ki'ma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
