          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Naholi aho wafikyaga musimo gwa myaka maku'mi av'i'li' na kenda, wapandi'kaga mwana lina Tela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.24",
            "verseOrgIds": [
              "GEN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku'fuma aho wav'yalagwa Tela, Naholi wikalaga myaka igana li'mo na iku'mi na kenda. Mugati' na myaka zyeni'zyo wapandi'kaga hangi' v'ana v'a ki'gosya na v'a ki'ki'ma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
            "verseOrgIds": [
              "GEN.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
