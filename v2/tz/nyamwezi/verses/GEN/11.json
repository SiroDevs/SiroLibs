            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyafikaga itungo Tela wamusolaga Abulamu, haki'mo na muki' wamwa Abulamu, Salai, na mwizu'ku'lu' wakwe Loto u'yo wav'age mwana wa mwana wakwe Halani, v'awu'kaga v'ose ku'fuma ku' kaya ya Ulu ku' lwandi' lwa V'akalidayo. V'alomaga ku'ya ku' nsi' ya Kanaani, ali'vi aho v'afikaga ku' kaya ya Halani v'ikalaga kwenu'ko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tela wagulalaga kwenu'ko ku' Halani, na wasangwa ali' na musimo gwa myaka magana av'i'li' na itano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
