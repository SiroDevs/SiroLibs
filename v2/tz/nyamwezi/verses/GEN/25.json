              "GEN.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yav'aga aho zyagelani'laga nsiku' zyakwe zya kwipeku'la, lingaga! Lebeka wipeku'laga mav'asa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa kwandya kwipeku'la, muv'i'li' gwakwe gose wav'age wazaa, na wu'yenze muv'i'li' gose. Yeni'yo hu' nguno v'amupaga lina Esau",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:25",
              "type": "text"
            },
            {
              "text": "Lina “Esau” ku' Ki'ebulania nguno yayo “wa wu'yenze.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu itungo lyeni'lo, mwana wa wu'v'i'li' wav'yalagwa u'ku' amudimile kasinsila mudu'gu'ye Esau. Yeni'yo hu' nguno v'amupaga lina Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:26",
              "type": "text"
            },
            {
              "text": "Lina “Yakobo” ku' Ki'ebulania likolile na mihayo “kasinsila” ninga “wu'yengani.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Itungo lya ku'v'yalwa Esau na Yakobo sav'o Isaka wasangwa wafikyaga musimo gwa myaka maku'mi mukaga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esau ali'gu'zya lwandi' lwa lole yakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho v'ana v'enav'a v'aku'laga, Esau wav'age muhi'gi musoga, amani'lile ku'ya mu masenga. Sumbwa Yakobo wav'age mutekanu wa kwikala ha lu'go. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene Isaka wamutogagwa Esau, ku'nguno wav'age atogilwe ku'lya nyama zya mu isenga, sumbwa Lebeka wav'age amutogilwe Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu'siku' lu'mo, Yakobo watekaga ki'liwa cha dengu, nawe Esau wasu'v'aga ku'fuma ku' ihi'ga, ku'no azov'ile muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau wamuwi'laga Yakobo, “Nu'ku'lomba, u'mpe ki'liwa cheni'cho chazaa nchoyangi'zye, ku'nguno ni'na nzala ndaki muno.” Yeni'yo hu' nguno v'amupaga lina Edomu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:30",
              "type": "text"
            },
            {
              "text": "Lina “Edomu” ku' Ki'ebulania nguno yayo “wazaa”.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo nawe wasu'v'yaga ati', “Ngu'zi'zye mbela lwandi' lwa lole yako ya wu'v'yalwa wa mbele.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Esau wayombaga, “Lingaga, ene ni' bi'hi' ku'fwa! Yi'ku'ngwasya ki' ku'v'a na lole ya wu'v'yalwa wa mbele?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
              "GEN.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo wamuwi'laga, “Lahi'la mbela.” Haho Esau walahi'laga, na ku'mugu'zi'zya lwandi' lwa lole yakwe ya wu'v'yalwa wa mbele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Yakobo wamupaga Esau mugate na ki'liwa cha dengu. Nawe Esau walyaga, wanywaga, na wawu'kaga henanho. I'vi hu' vyene Esau wanyataga lwandi' lwa lole ya wu'v'yalwa wa mbele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
              "GEN.25.34"
            ]
          }
        }
      ]
    }
