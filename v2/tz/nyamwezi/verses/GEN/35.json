              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo wasu'v'aga ku' Mamule ku'mwa ise Isaka, bi'hi' na Kiliati-aliba, lina li'ngi' Hebuloni, u'ko v'av'age v'ikalile Abalahamu na Isaka ki'ti' v'ageni v'izi'li'zi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikalo wakwe wose mu welelo Isaka wikalaga myaka igana li'mo na maku'mi munane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe wagulalaga, ali' na wu'kiku'lu' wu'soga wa lu'v'ango, walondaga nzi'la ya v'antu' v'akwe av'o v'amalile ku'tongela, na v'ana v'akwe Esau na Yakobo v'amuzyi'kaga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
            "verseOrgIds": [
              "GEN.35.29"
            ]
          }
        }
      ]
