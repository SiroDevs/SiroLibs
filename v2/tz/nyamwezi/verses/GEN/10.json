          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wikalo wav'o wav'age ku'fuma ku' lwandi' lwa Mesha mpaka ku' Sefali ku' ngu'lu' zya mu ki'ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
