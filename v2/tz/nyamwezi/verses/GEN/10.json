              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofili, Havila na Yobabu. V'enav'o v'ose v'av'age v'ana v'amwa Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.29",
            "verseOrgIds": [
