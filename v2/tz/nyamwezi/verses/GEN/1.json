            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Mulungu wayombaga, “Nsi' yi'v'yale vitundwa vya myu'ye ya wu'panga ku' wu'tundwa wavyo, ndimu zya mu ipolu na zya ku'sav'a, na vitundwa vingi' vya ku'yu'mba ha igu'lya na nsi' ku' wu'tundwa wavyo,” na yav'aga vyeni'vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho watundaga ndimu zya mu ipolu na zya ku'sav'a na vitundwa vingi' vyose vya ku'yu'mba ha igu'lya na nsi' ku' wu'tundwa wavyo, nawe wawonaga ku'v'a yi'li' visoga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
