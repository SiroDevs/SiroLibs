            }
          ]
        },
        {
          "text": "Hangi' Mulungu wayombaga, “Gi'si' ku'tunde",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:26",
              "type": "text"
            },
            {
              "text": "Ku' ki'tabu cha Mbu'ki' Gu'ku' Mulungu aho ali'wiyombela mu moyo gwakwe ali'tu'mi'la mihayo zya lu'sangi' ninga i'vi ali' inene. V'antu' v'angi' v'ali'wiganika ku'v'a hamo ku'nguno ya Wu'datu' wu'sondo ninga wu'temi wakwe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " v'antu' ku' wikole wiswe, v'ikole niswe, ki'gele v'akateme nsonvi zya mu minzi', nnoni zya mu chelela, visawa vyose na vitundwa vyose vya ku'yu'mba ha igu'lya na nsi' mu welelo yose.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        }
      ]
