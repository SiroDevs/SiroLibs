              "LEV.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' mugosya amele wanga, mwenu'yo ali' musoso. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninga u'lu' muntu' apenyuke nyele zyakwe ku' lwandi' lwa ku' mbele ninga lwa ku' nnuma lwa mutwe gwakwe, sanga wanga du'. Mwenu'yo ali' musoso. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi u'lu' ku' mutwe gwa muntu' wa wanga ku'v'e na wu'vimbe wa langi yape ya wazaa, wenu'wo wu'li' wu'lwile wa ndi'li' u'wo wu'li'fumi'i'la ku' wanga wakwe wa ku' mbele ninga wa ku' nnuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho muhozya alamwikomye. U'lu' awone wu'vimbe wu'li' na wape wa wazaa ku' wanga wakwe, na wu'li'wigela ki'ti' wu'lwile wa ndi'li', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "sanga muntu' mwenu'yo alwalile, na ali' na zoma. Haho muhozya alamutangazye muntu' mwenu'yo ku'v'a ali' na zoma ku'nguno ya wu'vimbe ku' mutwe gwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
    },
