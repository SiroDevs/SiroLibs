          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ki'la muntu' u'yo alav'e na mabado gape ha igu'lya na ndi'li' yakwe, av'e mugosya ninga muki'ma, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "muhozya alamwikomye muntu' mwenu'yo. U'lu' amuwone ku'v'a mabado genago gali' na wilawu'zu hadoo, sanga wenu'wo wu'li' wu'landi u'wo wu'kav'ile na wu'v'i ku' ndi'li'. Muntu' mwenu'yo ali' musoso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
