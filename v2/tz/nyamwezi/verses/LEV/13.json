          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeni'yi' hu' nhama ku'nguno ya wule u'wo wu'fumi'i'lile ku' myenda zya wu'zi wa wu'yenze ninga wa katani, i'zyo zya wu'fuumwe wa ki'la mukoli, ninga ki'ntu' cha ndi'li'. Ku' nzi'la yeni'yi' mulakowole ku'mani'cha mugati' na myenda misoso na zya zoma.",
          "type": "text",
