            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ki'la mulwile wa ndi'li' u'yo ali' na wu'vimbe yi'lamudime azwale vizwalo vya wu'zemuke, na nyele zyakwe alazisalambanie, na mulomo gwakwe alagu'fumbati'zye na ku'liinia muzwi na ku'yomba, ‘Ene ni'na zoma! Ene ni'na zoma!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugati' na nsiku' zyose i'zyo alav'e na wu'lwile wenu'wo mwenu'yo alendeleye ku'v'a na zoma, nawe alikale ku' ku'komwa av'e ha mpelo na nkambi'.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhama ku'nguno ya wule ku' vizwalo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' ku'li' na mwenda u'go gwakikuumya na wule, gu'v'e gwa wu'zi wa wu'yenze ninga wa katani, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninga gu'v'e gwa wu'fuumwe wa ki'la mukoli ku' katani ninga wu'yenze, ninga gu'v'e gwa ndi'li', ninga ki'v'e ki'ntu' i'cho ki'v'eziv'ilwe ku' ndi'li', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "na u'lu' wule wenu'wo wu'li' na langi ya lu'du'tu' ninga yazaa ku' mwenda gwenu'go ninga ku' ki'ntu' cha ndi'li', wenu'wo wu'li' wule wu'v'i, na yi'li'koov'iwa ku'lagi'lwa muhozya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho muhozya alawikomye wule wenu'wo na ku'gu'koma mwenda ninga ki'ntu' cheni'cho ha mpelo ku' itungo lya nsiku' mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu lu'siku' lwa mupungati' alawikomye, na u'lu' awone wule wenu'wo wu'landalile ku' mwenda ninga ki'ntu' cheni'cho, sanga ki'li' na wule wu'v'i. Ku'nguno yeni'yo ki'ntu' cheni'cho ki'li' na zoma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene muhozya yi'lamudime agu'time moto mwenda ninga ki'ntu' cheni'cho, ku'nguno ki'li' na wule wu'v'i u'wo wu'kakowoleka ku'hangwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
    {
