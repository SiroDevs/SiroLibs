              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Gu'ku' Mulungu wamuwi'laga Mose ati', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ku'lamuli'la lu'siku' lwa ku'v'ilwa maguta kwamwa Aloni na v'ana v'akwe ku'nguno ya wu'hozya, yi'lav'adime ku'mufumi'zya Gu'ku' Mulungu kilo yi'mo ya wu'fuma wu'nelezu ku'v'a kalu'mbi'lo ka mbutoo ku' ki'la lu'siku'. Nusu ya wu'fuma wenu'wo alawu'fumye ndiyu' na nusu yi'ngi' mpi'ndi'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wu'fuma wenu'wo wu'laseleganiwe na maguta ga muzeituni na ku'komelwa mu ki'kalango, hangi' wu'laletwe ku'no wu'li' na mav'ale mav'ale na ku'mufumi'zya Gu'ku' Mulungu ku'v'a kalu'mbi'lo ka mbutoo, kav'e na wu'motu wa ku'mutogezya Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki'la muhozya u'yo alav'ilwe maguta na kwikali'la isumbi' lyamwa Aloni mugati' na wu'v'yalwa wakwe, hu' mwene alakegezye. Li'li' ifungu lya nhananhana ku'mwa Gu'ku' Mulungu. Kalu'mbi'lo kose kalazigiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki'la kalu'mbi'lo ka mbutoo ka muhozya kalazigiwe kose. Nhanayene kakasye kaliwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
