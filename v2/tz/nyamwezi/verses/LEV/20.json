          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' muntu' alale na muki'ma u'yo ali' ku' nsiku' zyakwe, v'ose v'av'i'li' v'alav'e v'av'isu'la magazi ga ku' nsiku' zyakwe. V'ose yi'lav'adime v'akomwe na iv'ilingano lya V'aizilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
