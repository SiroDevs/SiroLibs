        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' muntu' atoole mwaniki' haki'mo na nnina, lyeni'lo li'li' ihu'v'yo. V'ose v'adatu' yi'lav'adime v'atimwe moto, ki'gele ku'du' ku'v'e na wu'kenagu'zi mugati' na inywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
