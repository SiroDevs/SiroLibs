            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' muki'ma ifile ha mbele na ndimu ki'gele alale nayo, yi'lamudime awu'lagwe, hangi' na ndimu yeni'yo yi'lawu'lagwe, na magazi gav'o galav'e ha igu'lya yav'o.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
    },
