              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Aloni wasi'nzaga ng'ombe na ng'ondi ku'v'a ki'taambo cha kwiswanania ku'nguno ya v'antu'. V'ana v'akwe v'amupaga magazi gazyo, nawe waganyanyagi'laga ku' ki'la lwandi' lwa ihozezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi maguta ga i'yo ng'ombe na ng'ondi, muki'la na maguta gago, lu'sasa, nfigo na lwandi' lu'soga lwa iti'ma, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "vyeni'vi vyose v'avitu'u'laga ha igu'lya na vidali, nawe Aloni wagazigyaga maguta ha igu'lya na ihozezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni waviwu'syaga i'vyo vidali haki'mo na matango ga mulyi'la ha mbele yamwa Gu'ku' Mulungu, ku'v'a lu'manyi'lo lwa kalu'mbi'lo, ki'ti' i'vyo Mose walagi'li'zizye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Aloni aho wamali'laga ku'fumya ki'taambo cha ku'sini'zya wu'kenagu'zi, ki'taambo cha ku'zigya, na ki'taambo cha kwiswanania, wawu'syaga makono gakwe ku' ku'v'alola v'antu' na ku'v'adosya, haho wasookaga ku'fuma ku' ihozezyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Mose na Aloni v'ingi'laga mu Ihema lya Ku'sangi'zya. Aho v'afumaga ha ibala v'av'adosyaga v'antu', nalo lu'kumo lwamwa Gu'ku' Mulungu lwav'ifumi'i'laga v'antu' v'ose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto gwafumi'i'laga ha mbele yamwa Gu'ku' Mulungu, gwaki'zigyaga ki'taambo cha ku'zigya, haki'mo na maguta ago gav'age ha igu'lya na ihozezyo. V'antu' v'ose aho v'awonaga igambo lyeni'li', v'abu'bu'zyaga ku' wu'togwe, v'asukambaga na ku'ku'v'i'i'la.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
