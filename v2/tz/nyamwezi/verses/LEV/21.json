        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhama ku'nguno ya wu'sondo wa v'ahozya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gu'ku' Mulungu wamuwi'laga Mose ati', “U'v'awi'le v'ahozya, v'ana v'amwa Aloni v'a ki'gosya ati', ‘Muhozya ninga yu'mo ku'du' ize itu'u'li'le zoma ku' ku'kuumya mulambo gwa muntu' mugati' na v'a igongo lyakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.1",
            "verseOrgIds": [
              "LEV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "sumbwa u'lu' gu'li' mulambo gwa mudu'gu'ye wa bi'hi' ki'ti' i'vi ise ninga nnina, mwana wakwe, ninga mudu'gu'ye wa ki'gosya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.2",
            "verseOrgIds": [
              "LEV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninga mudu'gu'ye wa ki'ki'ma musimbe. Ku'nguno ali' wu'du'hu' mugosya wa ku'muzyi'ka, akowolile kwitu'u'li'la zoma ku'nguno yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.3",
            "verseOrgIds": [
              "LEV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhozya ku'du' ize itu'u'li'le zoma mweni'ki'li' ku'nguno ya v'antu' av'o ali' bi'hi' nav'o ku' kwitoolela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘V'ahozya ku'du' v'amoge ki'pala ninga ku'moga mu mpelo ya ndezu zyav'o, ninga ku'sala nsale mu miv'i'li' zyav'o ku'nguno ya v'afwile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.5",
            "verseOrgIds": [
              "LEV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi'li'v'adima v'ahozya ku'v'a v'asondo ku'mwa Mulungu wav'o. V'aleke ku'li'yagazya lina lyamwa Mulungu wav'o, ku'nguno hu' v'ene v'ali'fumyaga kalu'mbi'lo ka ku'zigya ku'mwa Gu'ku' Mulungu, yaani kalu'mbi'lo ka viliwa ku'mwa Mulungu wav'o. Ku'nguno yeni'yo yi'li'v'adima ku'v'a v'asondo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' v'atoole muki'ma wa zoma ya wu'lav'a, ninga u'yo walekilwe na mugosi, ku'nguno v'ahozya v'ali' v'asondo ku'mwa Mulungu wav'o. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muv'awone v'ahozya ku'v'a v'ali' v'asondo, ku'nguno hu' v'ene v'ali'fumyaga kalu'mbi'lo ka viliwa ku'mwa Mulungu winywe. V'alav'e v'asondo ku' winywe, ku'nguno ene, Gu'ku' Mulungu u'yo nu'musondohya inywe, ni' musondo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' mwana wa ki'ki'ma wamwa muhozya av'ezye zoma ya wu'lav'a, sanga ali'mupondansoni ise. Yi'li'mudima atimwe mu moto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Muhozya muhanya mugati' na v'adu'gu'ye, u'yo wav'ililwe maguta ku' mutwe gwakwe na ku'simi'kwa ki'gele azwale vizwalo visondo, ku'du' azisalambanie nyele zyakwe ninga ku'zemula myenda zyakwe ku'nguno ya v'afwile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.10",
            "verseOrgIds": [
              "LEV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku'du' ingi'le u'mo gu'li'mo mulambo, na kwitu'u'li'la zoma ku'nguno yamwa ise ninga nnina. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.11",
            "verseOrgIds": [
              "LEV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku'du' ize ahafume hantu' hasondo hamwa Mulungu wakwe, na ku'hatu'u'li'la zoma ku'nguno ya v'afwile, ku'nguno wasondohilwe ku' ku'v'ilwa maguta masondo gamwa Mulungu wakwe. Ene hu' ni' Gu'ku' Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Muhozya muhanya ali'koov'iwa ku'toola muki'ma u'yo akaali' ku'manya mugosya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.13",
            "verseOrgIds": [
              "LEV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku'du' ize atoole muki'ma u'yo afwi'lilwe mugosi, ninga wa ku'lekwa na mugosi, ninga mulav'a. Alatoole du' u'yo akaali' ku'manya mugosya na av'e wa ku'fuma mugati' na v'antu' v'a igongo lyakwe lya ki'hozya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.14",
            "verseOrgIds": [
              "LEV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki'gele ku'du' ize av'atu'u'li'le zoma v'ana v'akwe mugati' na v'antu' v'a igongo lyakwe. Ene hu' ni' Gu'ku' Mulungu wa ku'musondohya.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gu'ku' Mulungu wamuwi'laga Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.16",
            "verseOrgIds": [
              "LEV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'muwi'le Aloni ati', ‘Ku' wu'v'yalwa u'wo wizile, muv'yalwa wako u'yo alav'e na wu'lema akasye egele ha ihozezyo ku'fumya kalu'mbi'lo ka viliwa ku'mwa Mulungu wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.17",
            "verseOrgIds": [
              "LEV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu' ninga yu'mo wa wu'lema ku'du' egele: muhofu, wa ki'tewe, u'yo av'ipile wu'syu' ninga viv'alango vyakwe vikagelani'lile, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "u'yo avuni'kile mugu'lu' ninga mukono, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninga wa igonde, ninga u'yo akonile, ninga wa iv'elav'ela, ninga wa lu'kalawo ninga wu'lema wu'ngi' wa ndi'li', ninga u'yo avulali'kile mpese zya ki'gosya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muv'yalwa wa muhozya Aloni u'yo ali' na wu'lema ninga wu'mo ku'du' ize egele ku'fumya kalu'mbi'lo ka ku'zigya ku'mwa Gu'ku' Mulungu, yaani kalu'mbi'lo ka mbutoo ku'mwa Mulungu wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu' mwenu'yo akowolile ku'lya ki'liwa ki'sondo chamwa Mulungu wakwe, na i'cho ki'li' ki'sondo muno, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
              "LEV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ali'vi ku'nguno ya wu'lema wakwe, ku'du' ize egele bi'hi' na muki'ngo gwa mugati' ninga ku'lyegela ihozezyo. Ku'du' ize ahav'ezezye zoma hantu' hasondo ha wanne. Ene hu' ni' Gu'ku' Mulungu, wa ku'v'asondohya v'ahozya.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
