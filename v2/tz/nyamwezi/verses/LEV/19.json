            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Yi'li'mudima muzidime nzi'la zyanne zyose na nhama zyanne zyose, na ku'zilonda. Ene hu' ni' Gu'ku' Mulungu.’ ”",
          "type": "text",
