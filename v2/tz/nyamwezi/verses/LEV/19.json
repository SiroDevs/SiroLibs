              "LEV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'nyonganie lole aho u'li'fumya wu'yangu'. Ku'du' u'v'ezye wu'hegela ku' mupi'na ninga ku'muku'zya muntu' muhanya. Ali'vi u'v'ezye wu'yangu' wa lole ku' mwiyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'sambazye mihayo ya wu'songania mugati' na v'antu' v'ako. Ku'du' u'yombe muhayo ninga gu'mo ha iv'anza u'go gu'kowolile ku'mulengela lu'fu muntu' wa lole. Ene hu' ni' Gu'ku' Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'mutu'u'li'le nsika mwiyo mu moyo gwako. Ali'vi yi'li'ku'dima u'muhame ku' katwipandu' ki'gele u'leke ku'v'a mu wu'kenagu'zi wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' wili'pi'ki'zye ninga ku'tu'u'la igundo ku' yu'mo mugati' na v'antu' v'ako, sumbwa yi'li'ku'dima u'mutogwe u'yo ali' bi'hi' nanho ki'ti' i'vyo witogilwe ev'e mweni'ki'li'. Ene hu' ni' Gu'ku' Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        }
      ]
    },
