            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Yi'kazumi'ziwa muntu' ku'ki'sondohya ki'v'yalwa cha mbele cha ndimu, ku'nguno ndimu yeni'yo yi'li' yamwa Gu'ku' Mulungu, yi'v'e ng'ombe ninga nkolo. Yeni'yo yi'li' nsawo yamwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' ndimu yi'li' zoma, musav'a ndimu alayi'komole ku'londana na mupango u'go gu'tu'u'lilwe na kongezya lwandi' lwa wu'tano lwa mupango gwayo. U'lu' aleke ku'yi'komola, hohene muhozya alayi'gu'zye ku'londana na mupango u'go gwatu'u'lilwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ali'vi ki'la ki'ntu' i'cho chasondohiwa nhananhana ku'mwa Gu'ku' Mulungu, av'e muntu', ninga yi'v'e ndimu, ninga gu'v'e mugu'nda gwa ku'saala, ki'kasye ki'gu'ziwe ninga ku'komolwa. Ki'la ki'ntu' i'cho chasondohiwa nhananhana ki'li' ki'sondo muno ku'mwa Gu'ku' Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Muntu' u'yo wasondohiwa nhananhana ku'mwa Gu'ku' Mulungu ki'gele azimangu'ziwe, akasye akomolwe, sumbwa yi'li'mudima awu'lagwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Hangi' lwandi' lwa iku'mi lwa ki'la ki'ntu' ku'fuma ha nsi', viv'e mbutoo ku'fuma ku' migu'nda ninga visumo ku'fuma ku' miti', vyose vili' nsawo yamwa Gu'ku' Mulungu. Lwenu'lo lu'li' lwandi' lu'sondo ku'mwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' muntu' ali'koov'a ku'komola ki'ntu' ninga ki'mo cha kalu'mbi'lo kakwe ka lwandi' lwa iku'mi, yi'lamudime ongezye ku'li'pa lwandi' lwa wu'tano lwa mupango gwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku' lwandi' lwa ndimu, ng'ombe, mbu'li ninga nkolo, aho zilav'e zili'v'aziwa ku' mulanga gwa mudi'mi, i'yo yi'lav'e ya iku'mi hu' yene yi'lav'e nsondo ku'mwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimu ya iku'mi yi'kasye yi'sogolwe ku'nguno ya wu'soga wayo ninga wu'v'i, nayo yi'kasye yi'kaav'iwe na yi'ngi'. U'lu' yize yi'kaav'iwe ku' yi'ngi', hohene ndimu i'yo ya mbele na i'yo yakaav'iv'agwa, zyose zilav'e nsondo. Ndimu yeni'yo yi'kasye yi'komolwe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zyeni'zyo hu' nhama i'zyo Gu'ku' Mulungu ndi' wamupa Mose ku' lu'gu'lu' lwa Sinai av'awi'le V'aizilaeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        }
      ]
    }
