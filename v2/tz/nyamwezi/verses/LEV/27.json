    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalu'mbi'lo ka ki'lu'mbo na ku'komolwa kwako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gu'ku' Mulungu wamuwi'laga Mose ati', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'v'awi'le V'aizilaeli, ‘Muntu' u'lu' atu'u'le ki'lu'mbo cha ku'mufumya muntu' ku' mili'mo zyamwa Gu'ku' Mulungu, muntu' mwenu'yo akowolile ku'komolwa ku' ku'li'pa lu'v'alo ku'londana na i'vyo yi'li'koov'iwa: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupango gwa ku'mukomola mugosya wa musimo gwa myaka maku'mi av'i'li' mpaka maku'mi mukaga, vilav'e vipande maku'mi atano vya feza ku'londana na vipimo i'vyo vitu'u'lilwe ha hantu' hasondo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' av'e muki'ma mupango gwa ku'mukomola gu'lav'e vipande maku'mi adatu' vya feza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' muntu' mwenu'yo ali' na musimo gwa myaka itano mpaka maku'mi av'i'li' mupango gwakwe gu'lav'e vipande maku'mi av'i'li' vya feza ku' mugosya, na ku' muki'ma vipande iku'mi vya feza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' muntu' mwenu'yo ali' na musimo gwa mwezi gu'mo mpaka myaka itano, mupango gwa ku'mukomola gu'lav'e vipande vitano vya feza ku' mugosya, na ku' muki'ma vipande vidatu' vya feza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' muntu' mwenu'yo ali' na musimo u'go gu'ki'lile myaka maku'mi mukaga, mupango gwakwe gu'lav'e vipande iku'mi na itano vya feza ku' mugosya, na ku' muki'ma vipande iku'mi vya feza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi muntu' u'lu' ali' mupi'na na akakowola ku'li'pa mupango u'go gu'tu'u'lilwe, hohene muntu' wa ku'fumiwa alafilwe ku' muhozya, nawe muhozya alatu'u'le mupango ku'londana na wu'pi'na wa u'yo wa ku'mufumya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' muntu' watu'u'la ki'lu'mbo cha ku'fumya ndimu i'yo yi'zumi'ziv'ilwe ku'v'a ki'taambo ku'mwa Gu'ku' Mulungu, ndimu yeni'yo yi'li' nsondo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu' ku'du' ayi'kaav'e ndimu yeni'yo, yi'v'e ku' ndimu nsoga ninga mbi. U'lu' ayi'kaav'e ku' yi'ngi', haho ndimu yeni'yo na i'yo yakaav'iv'agwa zyose iv'i'li' zilav'e nsondo ku'mwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' ki'lu'mbo ki'li' cha ndimu ya zoma, i'yo yi'kaaniziv'ilwe ku'mufumi'zya ki'taambo Gu'ku' Mulungu, hohene ndimu yeni'yo yi'laletwe ha mbele ya muhozya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe muhozya alayangu'le mupango gwa ndimu yeni'yo, ku'londana na wu'soga ninga wu'v'i wayo. Mupango u'go alayangu'le muhozya hu' vyene gu'lav'e. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' musav'a ndimu ali'koov'a ku'yi'komola ndimu yeni'yo, yi'lamudime kongezya lwandi' lwa wu'tano lwa mupango gwayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Muntu' u'lu' ayi'sondohye nnumba yakwe ku'v'a ki'ntu' ki'sondo ku'mwa Gu'ku' Mulungu, muhozya alayangu'le mupango gwa nnumba yeni'yo, ku'londana na wu'soga ninga wu'v'i wayo. Mupango u'go alayangu'le muhozya hu' vyene gu'lav'e. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' muntu' mwenu'yo u'yo wayi'fumyaga nnumba yeni'yo ali'koov'a ku'yi'komola, yi'lamudime kongezya lwandi' lwa wu'tano lwa mupango gwayo, nayo yi'lav'e nsawo yakwe hangi'.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Hangi' u'lu' muntu' alu'sondohye lwandi' lwa mugu'nda gwakwe, u'go gu'li' isaalo lyakwe, ku'v'a musondo ku'mwa Gu'ku' Mulungu, hohene mupango gwago gu'lapimwe ku'londana na mbiyu' i'zyo zilav'i'v'we mu mugu'nda gwenu'go. Ku' madebe iku'mi ga mpese zya shayili mupango gwago gu'lav'e vipande maku'mi atano vya feza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' agu'sondohye mugu'nda gwakwe ku'v'a musondo mugati' na mwaka gwa Mwanya gwa Wiyagalu'le gwa myaka maku'mi atano, mupango gwago gu'lav'e gwenegu'go. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi u'lu' gwav'i'ta mwaka gwa Mwanya gwa Wiyagalu'le hu' agu'sondohye mugu'nda gwakwe, hohene muhozya alayangu'le mupango ku'londana na myaka i'zyo zyasigali'lile ku'gu'fiki'i'la mwaka gwa Mwanya gwa Wiyagalu'le gwa myaka maku'mi atano, na mupango gwago gu'lapu'ngu'ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lu' muntu' mweni'ki'li' u'yo wagu'sondohizye mugu'nda gwakwe nawe akoov'e ku'gu'komola, yi'lamudime kongezya lwandi' lwa wu'tano lwa mupango gwago, na mugu'nda gu'lav'e nsawo yakwe hangi'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi u'lu' aleke ku'gu'komola ninga u'lu' amugu'zi'zye muntu' yu'ngi', hohene mugu'nda gwenu'go gu'kasye gu'komolwe hangi'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugu'nda gwenu'go gu'lav'e musondo ku'mwa Gu'ku' Mulungu aho gu'lav'e gwaleku'li'lwa mu mwaka gwa Mwanya gwa Wiyagalu'le, ku'v'a musondo nhananhana, nago gu'lav'e nsawo ya muhozya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' muntu' agu'sondohye mugu'nda ku'mwa Gu'ku' Mulungu u'go wagu'lile, yaani u'go gu'kav'ile gwa isaalo lyakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "muhozya alayangu'le mupango gwa mugu'nda gwenu'go ku' ku'londana na myaka i'zyo zyasigali'lile ku'fiki'i'la mwaka gwa Mwanya gwa Wiyagalu'le gwa myaka maku'mi atano, na muntu' mwenu'yo yi'lamudime ku'li'pa mupango gwago ku'v'a ki'ntu' ki'sondo ku'mwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi mwaka gwenu'go gwa Mwanya gwa Wiyagalu'le, mugu'nda gwenu'go gu'lasu'v'iwe ku' musav'a u'yo ndi' wagu'gu'zya, u'yo li'li' isaalo lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki'la mupango gu'lapimwe ku'londana na vipimo vya hantu' hasondo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:25",
              "type": "text"
            },
            {
              "text": "Ki'ebulania ki'li'yomba gela maku'mi av'i'li' zigelani'lile na shekeli yi'mo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
