          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene Mose wahafumaga hamwa Falao na wamulombaga Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Gu'ku' Mulungu wav'ezyaga ki'ti' i'vyo Mose walombaga. Madale ga nsasi gasini'kaga ku'mwa Falao, v'akumba v'akwe na v'antu' v'akwe, lu'kasigalile ninga lu'mo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi hangi' Falao wendeleyaga ku'v'a na moyo mulambu. Akav'aleku'li'lile V'aizilaeli v'awu'ke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.32"
            ]
          }
        }
