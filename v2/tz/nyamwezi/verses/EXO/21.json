            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' v'antu' v'ikenia, na yu'mo wamugu'ma mwiye na iwe ninga lwa ngumi yakwe, ali'vi akamuwu'lagile, sumbwa wamuv'ezyaga alwali'le na ku'lala ha wu'li'li' wakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "u'lu' wawu'ka hangi' na ku'lamula ku'yu'mba lwa mulanga, haho u'yo wamugu'mile alaleku'li'lwe na ku'tondolwa. Ali'vi yi'lamudime amuli'pe ndi'pi ku'nguno ya itungo i'lo alav'e wamutagi'lile ku' ku'lala ha wu'li'li', na alamulwazye mpaka api'le gi'li'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' muntu' wamugu'ma musese wakwe, wa ki'gosya ninga wa ki'ki'ma, lwa mulanga nawe afwe hene haho, yi'lamudime apiwe lu'duko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi musese mwenu'yo u'lu' akafwile mugati' na lu'siku' lu'mo ninga iv'i'li', gu'ku' wakwe mwenu'yo akasye apiwe lu'duko, ku'nguno mwenu'yo wali' ali' nsawo yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' v'agosya v'av'i'li' v'igu'me na ku'muvulazya muki'ma wa mwitungo nawe av'ipye mwitungo gwakwe, ali'vi aleke ku'v'a na wu'vulaziwe wu'ngi', u'yo alav'e wamuvulazyaga yi'lamudime ku'li'pa ndi'pi ya ku'gelani'la ki'ti' i'vyo alav'e wakoov'aga mugosi lya muki'ma mwenu'yo, haki'mo na v'ayangu' i'vyo v'alav'e v'ayangu'la. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi u'lu' wu'v'e wu'li'ho wu'vulaziwe wu'ngi', yi'lamudime ali'pe wu'panga ku' wu'panga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
