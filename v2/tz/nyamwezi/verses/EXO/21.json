          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'yo alamugu'me muntu' na ku'muwu'laga, yi'lamudime ku'wu'lagwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ali'vi u'lu' akamuwu'lagile ku' mpaka, sumbwa Mulungu waleku'li'laga awu'lagwe, hohene muwu'lagi mwenu'yo akowolile ku'peelela u'ko ndamusogolele kwa ku'peelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sumbwa u'lu' muntu' walomaga ku'mugwi'li'la na ku'muwu'laga mwiye ku' mpaka, mwenu'yo ninga mbe apeelele ha ihozezyo lyanne, u'lamufumye na ku'muwu'laga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
    {
