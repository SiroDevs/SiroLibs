          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' muntu' wamugu'ma ku' linso musese wakwe, wa ki'gosya ninga wa ki'ki'ma, na ku'li'v'ipya, yi'lamudime amuleku'li'le iyagalu'le musese mwenu'yo ku'nguno ya linso lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
