          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'yo alamusampe muntu' na ku'mugu'zya, ninga u'lu' asangwe mu makono gakwe, yi'lamudime ku'wu'lagwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
