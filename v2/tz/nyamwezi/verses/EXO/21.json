          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lu' muntu' afundu'ku'le liina, ninga asi'mbe liina aleke ku'li'fundi'ki'zya, na ng'ombe ninga mpunda yi'gwi'le mwenu'mo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "musav'a liina lyeni'lo yi'lamudime afumye ndi'pi. Amuli'pe hela u'yo musav'a mutugo, na mutugo u'go gu'lav'e gwafwaga gu'lav'e gwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
