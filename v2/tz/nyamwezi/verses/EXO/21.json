          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ng'ombe ya muntu' u'lu' yi'yi'vulazye ng'ombe ya muntu' yu'ngi' na ku'yi'wu'laga, hohene v'antu' v'enav'a v'av'i'li' v'alayi'gu'zye yeni'yo ng'ombe mpanga na ku'gav'ana mupango gwayo. Vyene vivyo v'alagav'ane na i'yo ya wu'fwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi u'lu' yi'manyi'i'ke ku'v'a ng'ombe yeni'yo yi'mani'lile ku'pama ng'ombe ziye, na musav'a ng'ombe akayi'tungile, yi'lamudime musav'a ng'ombe yeni'yo ali'pe ng'ombe ku' ng'ombe, na ng'ombe i'yo ya wu'fwe yi'lav'e yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
