        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "I'vi hu' vyene Gu'ku' Mulungu ndi' wav'api'zya V'aizilaeli ku'fuma mu makono ga V'amisili, nav'o V'aizilaeli ndi' v'aziwona milambo zya V'amisili mu ngiligili ya nyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yav'aga V'aizilaeli aho v'awonaga igambo lya mukono gwa nguzu, i'lo Gu'ku' Mulungu wali'v'ezyaga ha igu'lya na V'amisili, v'amogohaga Gu'ku' Mulungu na v'atu'u'laga isani'zyo ku' wakwe na ku'mwa Mose mukumba wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        }
