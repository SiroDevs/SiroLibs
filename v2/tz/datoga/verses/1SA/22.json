{
  "id": "1SA.22",
  "number": "22",
  "bookId": "1SA",
  "reference": "1 Samweli 22",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1SA 22"
      },
      "items": [
        {
          "text": "22",
