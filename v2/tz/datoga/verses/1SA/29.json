    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuga Filisti gafool Dawdi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu ghabwada geat fuga Filisti lugweega nyaawa aba Afeki; nea nisin fuga Israeli museasooda aba gheanyanga eeniga mida Yesreeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda ng'ataawa fuga hees bea Filisti nea gabeewa bughalajeega ea sagalamnyoojiga gamaseaw Dawdi ea fugaaschi ak ghang'ata nea gahuuydean niny ea Akishi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gwayi shirikareeda hees bea fuga Filisti, “Gwasin naaha fiisu bea Ebraniyahiin aba hiji?” Ak gwayeesha Akishi shirikareeda hees bea Filisti, “Neada siisi ea mii Dawdihi, was siida gadiyeeda Saulihi was sugoocheanda Israeli, eandeaydooscheewi eawooji ea gweanyeeka, damanda nung'usiinanean heeda ak ea mii daadaw munyinda ea ghoah askweareani.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gwanyareeksa shirikareeda hees bea Filisti niny, ak gwayeesha shirikareeda hees bea Filisti niny, “Adealda siida gabiikta heeda igasayi goobiida niny, majeeteayeewana ng'ucheeda, aba gideaba gajiidu ghoah washteanya. Neada siisi gaygooduupcheataan geaw sea ng'utamiidaanyi? Neada ea maygwasin aba iheengeaba fiisu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada ea mii Dawdeeda ghayi sarmana buuneeda badaydaanyi nea ghang'wasi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    }
  ],
