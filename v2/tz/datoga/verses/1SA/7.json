            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada damanda wusa sandakwajeanda neajeeda aba Giriyat-yearimu, hean ghang'ata damanda geaw, was gweanyeew diktam, ak gooyeawusa fuga sean bea Israeli NG'UTAMIIDA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Samweli fuga sean bea Israeli, “Iyoobiigu heeda NG'UTAMIIDA aba gurooruunatkeagwa sean, abeeda ghoanung'wi heeda aseecheeka rabasta ea Ashtaroti mida jeedeang'wa, ak ghoatawji gurooruunatkeagwa NG'UTAMIIDA, ak googadiyeesi niny ak ghwahit, ak gaygwalealnaneegwa geatinga fuga Filisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwanung'usa heeda fuga Israeli Baali ea Ashtaroti, ak gagadiiyeesa NG'UTAMIIDA ak ghwahit.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayi Samweli, “Abwadana geat fuga sean bea Israeli aba Mispa, ak gaydamwaash NG'UTAMIIDA aba badahuukeagwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghabwat geat aba Mispa, ak gwaramu beega ak ghoahiida aba madeeda NG'UTAMIIDA, ak gooluulda geat eaweedida, nea gwayi, “Aseasa sisinyi riing'eeda aba madeeda NG'UTAMIIDA.” Ak goorooroochi Samweli fuga Israeli aba Mispa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ghwayiiy fuga Filisti gideaba nibwat geat fuga Israeli aba Mispa, hean ghoang'eat ng'utamoojiga Filisti ng'ucheeda sea fuga Israeli. Iidu nea ghwayiiy fuga Israeli iidi ghabeal aba badahuuka fuga Filisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha fuga Israeli Samweli, “Adinung'waadi giiyeawusiinda NG'UTAMIIDA was ASEETEANYA aba badahuukaasa, ak abeeda ghoaghuuheasa aba geatinda fuga Filisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu Samweli dayeenda reer bea gisilleanda ak ghoadayda ghoah haleanjeeda ghadooweeda sighwarda bea NG'UTAMIIDA; ak gooyeawusa Samweli NG'UTAMIIDA aba badayda fuga Israeli, ak ghamwas NG'UTAMIIDA gidamwaash. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda adaydaawa Samweli haleanjeeda ghadooweeda sighwardaan, gwaneekiit fuga Filisti gang'uchi Israeli; hean ghwanya ghuuta NG'UTAMIIDA nea ghwanyaashta gighweendandeeda haw eaweedida aba badahuuka fuga Filisti ak ghwanung' ea mwayiinya iiteaba geat; ak gamng'aw aba madeeda Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwariteawa fuga Israeli ng'eanyiida Mispa ak gamaseaw fuga Filisti, ak ghabwar, ea ghwahita Bet-kari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu Samweli lagheaneeda ak ghamiinda aba dageascheeda Mispa ea dea Yeshana, ak gaguura gheawungaaschi Ebeneseri; aba gideaba gwayi, “Ea ghoah ghamneawa NG'UTAMIIDA niweadeasa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geajoar fuga Filisti ak ea mudu gaweay jeeda ng'eanyiida Israeli. Ak goobiida geatinda NG'UTAMIIDA geeshta fuga Filisti damanyoojiga sean mideewa Samweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea mujiinajeega ghayi ang'waay fuga Filisti aba heeda Israeli gabiiksa Israeli, ghang'eada Ekroni ea ghwahita Gati; ak ghwanyas Israeli ng'eanyiida nyaawa geandeawa geatinga fuga Filisti. Ak ghoah hoyyoo aba dageascheeda Israeli ea fuga Amori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoahaaghwa Samweli Israeli askwearjoojiga sean bea eaweagaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaweay nea gwaneaweesa geat gilakweay ea ghwahita Beteli, ea Gilgali, ea Mispa; ak ghoahaaghwa Israeli aba darooraksu seaniin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak iissa gabiikiida Rama, aba gideaba gwanda gheanyi hoowa, ak eara aba hoowa iissa ghoahaaghwiida fuga Israeli doobiiwnata. Ak gwadeeksa NG'UTAMIIDA heeda wagiida aba hoowa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
