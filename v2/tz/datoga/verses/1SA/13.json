{
  "id": "1SA.13",
  "number": "13",
  "bookId": "1SA",
  "reference": "1 Samweli 13",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'ucheeda sea fuga Filisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawli abeeda gheareemaneeda gil, damanda miighoaweewa sugoocheanda; ak goombal Israeli gweanyeew iyeenya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwaloat Sawli fih sagalamnyooji samwagu bea Israeli; ak gwandeawa Sawli fih sagalamnyooji iyeenya aba Mikmashi ea aba jeeda ng'eanyiida heayeeniga bea Beteli, nea gwandeawa Yonatan fih sagalamnyeanjagi aba Gibeya mida dooshta Benjamini; ak ghwanung' Sawli gabiikta ghoah fuga abit. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwajoar Yonatan lugooda Filisti aba Geba; ak ghwayiiy fuga Filisti iita. Hean ghaghuut Sawli durumbeati aba jeeda ng'eanyiisean, nea gwayi, “Ayiing'sheena fuga Ebraniya.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwayiiy fuga sean bea Israeli gideaba Sawli nijoar lugooda Filisti, ea gideaba niimealu fuga Israeli aba heeda fuga Filisti. Ak geeguursa buuneeda ghapka heeda Sawli aba Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghabwat geat fuga Filisti gang'uchi sea Israeli, nea gwandeawa mutukwaji sagalamnyooji diktam ea damanamughuush, ea fuga faraasajeega sagalamnyooji lah, ea lugooda deena iseaskweanda ghuuta basooda aba seang'ayda; ghapka ak gooduuw aba Mikmashi, ea ghwahita gayeewda Bet-afeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah fuga Israeli gideaba geesawan (aba gideaba buuneeda geaminighis), ghafuy geat buuneeda aba jeesinga gwaleadinga ea jeesinga shoomeanga ea jeesinga lagheanga hees ea jeesinga bung'eadinga ea jeesinga healatka, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea ghoaghaawa ghushuutka Yordani ak ghwahita ng'eanyiida Gadi ea Gileyadi, abeeda Sawli gudugwanda Gilgali ak ghwaat geeshta buuneesean nea ghaboadanaada.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak goomeas askwearjooji ispwa, damanda ghayi rukuta Samweli; nea Samweli ea mawa ng'eanyiida Gilgali, hean gwanung'usa buuneeda niny heeda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayi Sawli, “Ayeani heedeanyu haleanjeeda ghadooweeda sighwarda, ea haleanjeeda ghadooweeda bea hoyyoo.” Ak ghoadayda haleanjeeda ghadooweeda sighwarda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ning'ata giidaydeayda adayda haleanjeeda ghadooweeda sighwarda, ging'ulayi, ghwahidu Samweli; ak gwarita Sawli jarooda ak gawa roonyeadaanyi ak googeachi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha Samweli, “Ang'iing'i nisini naaha?” Ghwalamda Sawli ak gwayeesha, “Iyaadaayi nea ghwadardaawa buuneeda heedeanyu, ea gideaba miihini askwearjoojiga hit ghayi irugu, ea gideaba ghabwat geat fuga Filisti aba Mikmashi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "geayi, ‘Asi ghamneawa gayghwahidu fuga Filisti gwararang'eesean aba Gilgali, nea mii dagasa dea duukusa geaw NG'UTAMIIDA’; ak ghaadaayi gideaba ghwahit giidaydeayda haleanjeeda ghadooweeda sighwarda.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Samweli Sawli, “Ang'iing'i gisini leendeeda; ang'iing'i miing'waanyi diigheanda NG'UTAMIIDA was ASEATAANG'U, ghayi rukuneey; aba gideaba gwachi gaygwasinyi NG'UTAMIIDA huwa sugoocheanda Israeli damanda manda muudeanooda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghamneawa sugoocheanduumeadaang'u ea nimuudean; aba gideaba niloat NG'UTAMIIDA siida gasa gurooroadaanyi; ak ea nigeanu NG'UTAMIIDA siida jea ghoah sugoocheanda jea goombal fugaaschi, aba gideaba miing'waanyi ng'asheega rukuneey NG'UTAMIIDA.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'eat Samweli, ak ghwascheang'da ghabeawa Gilgali ea ghwahita Gibeya mida ng'eanyiida Benjamini. Ak gwayiida Sawli fuga mideawa, ak ghwahita fih bughalaji lah. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goobiida Sawli sea orjeedaanyi was Yonatan, sea fuga mideawa ak goobiida Geba mida Benjamini; nea fuga Filisti gooduuw aba Mikmashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghapka mareanghooga leabu museasooda Filisti nea sibwaashaada geenga ghoah samwagu; ak ghwayam geat geahagi gagal Ofra, ak gaweay ng'eanyiida Shuali, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghwayam geat geeda niirja ak gagal Bet-horoni, ak ghwayam geat geeda niirja ak gagal moonghooda ng'utiida ng'eanyi moangoachiyda Seboimu duukusa dareapcheeda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ea manda gidang'oocheanda jeeda ng'eanyiisean bea Israeli; aba gideaba gwayi fuga Filisti, “Adiidu gwasissa geat fuga Ebraniya ng'utkeaka ghana ng'utkeaka”; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak iissa fuga Israeli gaba siisi rarang'aada gawa heeda Filisti ghwashit mageemng'eandaanyi, ea gharinyeandaanyi, ea joomoadaanyi, ghana bardaanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea mooneeda sishitiida ea heelajeanda gil aba shidooda mageemng'eanda ea aba gharinyeanda, ea gidamwahita shekeeli aba shidooda joomajeega ea gharinga sifooriida. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean aba eaweeda ng'ucheeda ea manda ng'uta ghana ng'uta jea eanyasa geatinda siida wassean aba fuga mideayi sea Sawli ea Yonatan; nea Sawli ea orjeedaanyi was Yonatan gwandeawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.22",
            "verseOrgIds": [
              "1SA.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaweay lugooda Filisti ea gwasik seawadeeda Mikmashi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.23",
            "verseOrgIds": [
              "1SA.13.23"
            ]
          }
        }
      ]
    }
  ],
