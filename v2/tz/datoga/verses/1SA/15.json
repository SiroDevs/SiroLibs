            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayi Samweli, “Eani hiji Agagi sugoocheanda Amaleki.” Hean ghwaan Agagi nea ghaboadan. Gwayi Agagi, “Aba huumwa ng'weaninda miyeeda ning'ata.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayi Samweli, “Gawuurji ng'utaang'u ninung' ea mwanyasa gadeemga diibiga, ak eara geamadu ea mayghwanyas baleanda aba jeeda gadeemga.” Ak ghwalajaada Samweli Agagi ea goomaneanyi aba madeeda NG'UTAMIIDA aba Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
    {
