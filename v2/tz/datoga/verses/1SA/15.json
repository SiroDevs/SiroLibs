          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchu gawa Samweli ng'eanyiida Rama; nea ghwascheang'da Sawli gawa gheanyi mida Gibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea mudu gabiikta Samweli ghwadaah Sawli ea ghwahita eaweeda miyeadaanyi, ak gagiisan Samweli aba badayda Sawli. Ak gwaduukuuna NG'UTAMIIDA aba gideaba ninung' ghoah Sawli sugoocheanda ambal Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        }
