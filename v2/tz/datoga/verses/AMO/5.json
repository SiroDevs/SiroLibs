          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gajageanda Sakuti was sugoocheandeang'wa, ea Gaiwani miing'weanda was aseeteang'wa, ghayi oosisi geat; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
