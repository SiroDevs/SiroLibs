              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayi Sulemani,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        }
