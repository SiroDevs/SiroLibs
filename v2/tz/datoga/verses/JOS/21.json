          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga abit bea dooshta Lawi bea jeeda gheeh Merari, geataw heeda eemeeda Sabuloni, nea Yoknemu gil sea ng'eanyiida haghweadaanyi, Garta sea ng'eanyiida haghweadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.34",
            "verseOrgIds": [
              "JOS.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimna sea ng'eanyiida haghweadaanyi, Nahalali sea ng'eanyiida haghweadaanyi mujiinajeega ea ang'wan; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
              "JOS.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak eemeeda Rubeni geataw Beseri sea ng'eanyiida haghweadaanyi, Yahasi sea ng'eanyiida haghweadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedemoti sea ng'eanyiida haghweadaanyi, ea Mefati sea ng'eanyiida haghweadaanyi mujiinajeega ea ang'wan; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak eemeeda Gadi, geataw Ramoti mida Gileyadi sea ng'eanyiida haghweeda nyaawa ea mujiineeda simng'awiisa aba siida bwar siida, Mahanaimu sea ng'eanyiida haghweadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshboni sea ng'eanyiida haghweadaanyi, Yaseri sea ng'eanyiida haghweadaanyi mujiinajeega sean ea ang'wan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujiinajeega siitaw fuga Merari bea jeeda Lawi, ghayi siloosa saawa mujiinajeega ea damaniyeenya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        }
      ]
    },
