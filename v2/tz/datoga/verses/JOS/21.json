          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujiinajeega abit bea fuga gheeh Gohati ea damanamughuush sean sea ng'eanyiida haghweeda nyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        }
