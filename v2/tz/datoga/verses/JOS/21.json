          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghoadaw NG'UTAMIIDA fuga Israeli ng'eanyiida sean, gawuurji gida ghayi aksiinda ghweaniga nyaawa habeawooda, hean goombal ak goobiida hoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghwanung' NG'UTAMIIDA ghwanyas miyeenooda aba meadajeega sean gawuurji gida ghayi aksiinda habeawooda ghweaniga nyaawa; ak ea manda eara weajoocheanjagi miinaada aba madeanyaawa, aba gideaba NG'UTAMIIDA ghwayiin weajoodiga nyaawa sean geatinga nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea manda eara ng'asheanjagi miy rugu NG'UTAMIIDA nea gwaheeleesa ak ea mii gwasin aba gheeh Israeli, gwasa ng'asheega sean.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
    }
