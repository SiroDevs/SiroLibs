      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Simeoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looteaba iyeenya geesin aba badayda Simeoni aba gideaba eemeeda Simeoni, sea fugeaba gheanyi; nea abeeda hearaniischooda nyaawa gwanda bugusta hearaniischooda eemeeda Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.1",
            "verseOrgIds": [
              "JOS.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujiinajeagaaschi hearan Beer-sheba gil, ea Sheba, ea Molada, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.2",
            "verseOrgIds": [
              "JOS.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasar-shuali ea Bala, ea Esemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.3",
            "verseOrgIds": [
              "JOS.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eltoladi, ea Betuli, ea Horma, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.4",
            "verseOrgIds": [
              "JOS.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siklagi, ea Bet-markaboti, ea Hasar-susa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.5",
            "verseOrgIds": [
              "JOS.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bet-lebaoti, ea Sharuheni mujiinaji damasamwagu ea gharang'weakaaschi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.6",
            "verseOrgIds": [
              "JOS.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En-rimoni, ea Eteri, ea Ashani mujiinaji ang'wan sea gharang'weaka nyaawa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.7",
            "verseOrgIds": [
              "JOS.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gharang'weaka sean neaweesa mujiinajeesu meadajeega sean ea ghwahita Baalat-beeri, ea Rameeda Negebu. Suh abeeda gageanda eemeeda Simeoni sea fugeaba gheanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.8",
            "verseOrgIds": [
              "JOS.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heeda hearan fuga Simeoni ng'eanyiida silaksa fuga Yuda gil, aba gideaba heeda silaksa fuga Yuda abeeda aahaw muuchi aba saawa, ak eemeeda Simeoni gwahearan aba bugusta nyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Sabuloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looteaba samwagu geesin aba badayda Sabuloni, ea fugeaba gheanyi. Ak moonghooda ng'eanyiida hearan gawa ea ghwahita Saridi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.10",
            "verseOrgIds": [
              "JOS.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gawa moonghoadaanyi ghwascheang'da gwarakta ea ghwahita Mareali, ak gagul Dabesheti, hean ea ghwahita gheang'deenda mida gayeewda Yoknemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.11",
            "verseOrgIds": [
              "JOS.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghang'eada Saridi ea gawa meatkweeda niirja heeda ghayeawa arearuuna aseeta ea ghwahita moonghooda Gisilot-tabori; ak gawa ea ghwahita Daberati, hean ghwascheang'da ea ghwahita Yafiya; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.12",
            "verseOrgIds": [
              "JOS.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'eada hoowa ghang'ata nea ghoadoas arearuuna aseeta ea ghwahita Gati-heferi, ea ghwahita Eti-gasini, ak gawa gwarina Rimoni ak ghwahita Nea; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.13",
            "verseOrgIds": [
              "JOS.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gwaneaweesa moonghooda wiilooda ng'eanyiida ghayeawa ea ghwahita Hanatoni, ak gamuudeana moangoachiyda Iftaheli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.14",
            "verseOrgIds": [
              "JOS.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatati, ea Nahalali, ea Shimroni, ea Idala, ea Betlehemu mujiinaji damaniyeenya sea gharang'weaka nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh gea hearan eemeeda Sebuluni gil, sea fugeaba gheanyi mujiinajeesu ea gharang'weakaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Isakari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looteaba ang'wan geesin aba badayda Isakari, aba eemeeda Isakari, sea fugeaba gheanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.17",
            "verseOrgIds": [
              "JOS.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'eanyiida nyaawa ghwahita Yesreeli, ea Gesuloti, Shunemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.18",
            "verseOrgIds": [
              "JOS.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafarayimu, ea Shioni, ea Anaharati, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.19",
            "verseOrgIds": [
              "JOS.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabiti, ea Gishoni, ea Ebesi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.20",
            "verseOrgIds": [
              "JOS.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remeti, ea Enganimu, ea En-hada, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.21",
            "verseOrgIds": [
              "JOS.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gawa moonghooda ea gagul Dabori, ea Shahasuma, ea Bet-shemeshi, ak moonghoadaanyi gamuudeana Yordani mujiinaji damwalah gil ea gharang'weakaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh gea hearan eemeeda Isakari gil, sea fugeaba gheanyi mujiinajeega gharang'weakaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Asheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looteaba muut geesin aba badayda eemeeda Asheri sea fugeaba gheanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.24",
            "verseOrgIds": [
              "JOS.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'eanyiida nyaawa ea Helkati gil ea Hali, ea Beteni, ea Akshafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alameleki, ea Amadi, ea Mishali, gawa nea aba heeda biyeara ghwahita Garmeli ea Shihori-libinati, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gwayamna geaw heeda ghayeawa, ak gawa ea ghwahita Bet-dagoni, ak gagul Sebuluni, ea moangoachiyda Iftaheli mida wiilooda ng'eanyiida ghayeawa ea ghwahita Bet-emeki ea Neieli; hean gawa nea gagal wiilooda ng'eanyiida ghayeawa ea ghwahita Gabuli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebroni, ea Rehobu, ea Hamoni, ea Gana, ak gawa ea ghwahita Sidoneeda haw; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gwayamu geaw moonghooda ak gawa ea ghwahita Rama, ak gawa ea ghwahita hilgweanda mujiineeda Diro, ak gwayamu geaw moonghooda ea ghwahidu Hosa, ak gamuudeana basooda; neekeewa Mahalabu, ea Akisibu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ea Afeki ea Rehobu mujiinaji diktam ea iyeenya ea gharang'weakaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh gea hearan eemeeda Asheri gil sea fugeaba gheanyi, mujiinajeesu ea gharang'weakaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Naftali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looteaba lah geesin aba badayda eemeeda Naftali, aba gideaba geesissa eemeeda Naftali ea fugeaba gheanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.32",
            "verseOrgIds": [
              "JOS.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak moonghoadaanyi ghang'eada Helefu, ak ghang'eada Sabiida mida Saananimu, ea Adami-nekebu, ea Yabneeli, ak gawa ea ghwahita Lakumu ak gamuudeana Yordani; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "hean gwayamna geaw moonghooda heeda biyeara ea ghwahita Asinot-tabori, ak ghang'eada hoowa ak gawa ea ghwahita Hukoki, ak gawa ea gagul Sebuluni mida wiilooda ng'eanyiida biyeara, ea Asheri mida heeda biyeara, ea Yuda mida giigheawda bea Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak mujiinajeega sineaweesa hilgweanda ea Sidimu gil ea Seri, ea Hamati, ea Rakati, ea Ginereti, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Adama, ea Rama, ea Hasori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.36",
            "verseOrgIds": [
              "JOS.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedeshi, ea Edreyi, ea Enhasori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.37",
            "verseOrgIds": [
              "JOS.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yironi, ea Migdaleli, ea Horemu, ea Betanati, ea Bet-shemeshi, mujiinaji damashageash sea gharang'weakaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh geahearan eemeeda Naftali gil sea fugeaba gheanyi, mujiinajeega gil sea gharang'weakaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
              "JOS.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida silaksa Dani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
              "JOS.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looteaba ispwa geesin aba badayda eemeeda Dani, sea fugeaba gheanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'eanyiidaanyi geanda ea Sora gil, ea Eshtaoli, ea Ir-shemeshi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaalabini, ea Aiyaloni, ea Itila, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloni ea Dimna, ea Ekroni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliteke, ea Gibetoni, ea Baalati, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehudi ea Bene-beraki, ea Gat-rimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Mejarkoni, ea Rakoni sea ng'eanyiida duukusa Yopa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gaburdeawa moonghooda nyaawa dea Dani, hean ghwascheang'da Dani ak gawa gang'uchi Leshemu ak ghabwar aba ng'uta ak ghoang'waay hoorgeeda ak goopteadawa, ak gaguura Leshemu, Dani nea gheawunga ghweanda nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gidahearan eemeeda Dani gil sea fuga gheanyaawa mujiinajeesu sea gharang'weaka nyaawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lakiisiinda huuydean bea ng'eanyiida",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea siihiit lakiisiinda ng'eanyiida jea gwahearan, hean ghoadaw fuga Israeli hearanda Yoshuwa was orjeeda Nuni aba bugusta nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawuurji gidarukuteayda NG'UTAMIIDA hean geataw niny mujiineeda gasa, nea Dimnat-sera gil mida jeeda ng'eanyiida heayeeniga bea Efraimu; ak ghwadeas mujiini, ak goobiida jeeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh darooraka hearan Eleasari gil was ashoohoocheanda ea Yoshuwa orjeeda Nuni ea fuga hees bea ghweaniga gealga eemeeda fuga Israeli geelaja aba loota ghoah hearanda aba Shilo, aba madeeda NG'UTAMIIDA, mida gidaghuuta maheemajeanda siroondooscheesa. Hean geahiit lachooda ng'eanyiida.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
      ]
    }
