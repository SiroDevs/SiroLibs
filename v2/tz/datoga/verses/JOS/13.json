              "type": "text"
            }
          ]
        },
        {
          "text": "Suh hearaniischooda ghayi lajaada Musa aba mooheeda Moabu, bea giigheawda Yordani mida gayeewda Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
