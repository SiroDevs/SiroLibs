              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoadaw Musa hearaniischooda eemeeda silach bugusta bea Manase; ak geelaksa fuga mwaatkwa bea gheeh Manase aba giteena fugeaba gheanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'eanyiida nyaawa ghang'eada Mahanaimu, ea ghoah Bashaneesean, ea sugoocheanduumeesean bea Ogu was sugoocheanda Bashani, ea mujiineesean bea Yairi, mida jeeda Bashani, mujiinajeega ea laadam, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea Gileyadeeda silach bugusta nibiyeenya, ea Ashtaroti, ea Edreyi, mujiinajeega sugoocheanduumeeda Ogu mida Bashani; suh gealoat aba fuga Makiri was orjeeda Manase aba gideaba fuga Makiri gealach bugusta nibiyeenya aba giteena fugeaba gheanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
