          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga Israeli gagadiiyeesa NG'UTAMIIDA askwearjoojiga sean bea Yoshuwa, ea askwearjoojiga sean bea gweargwa, abiida hiji iimea Yoshuwa ghayi nal gadiyeeda sean sin NG'UTAMIIDA aba badayda fuga Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
