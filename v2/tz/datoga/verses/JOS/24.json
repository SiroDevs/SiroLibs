          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'ata ng'asheesu ghami Yoshuwa was orjeeda Nuni, siida gadiyeeda NG'UTAMIIDA, nea abeeda gaba gweanyeew bughala ea damanamughuush. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geebung'sa ng'eanyiidaanyi mida Dimnat-sera mida ng'eanyiida heayeeniga Efraimu, mida wiilooda ng'eanyiida ghayeawa bea giijeeda Gashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
      ]
