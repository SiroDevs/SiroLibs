          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli, ea Ginetoni, ea Baruki, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.6",
            "verseOrgIds": [
              "NEH.10.6"
            ]
          }
        },
        {
