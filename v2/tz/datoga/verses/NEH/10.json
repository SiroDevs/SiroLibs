          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajeeyeana dearangaasa bea madeeda, ea haleanjeedeanya sisapi geadi, ea haghweega gilinyoo ea geeta gil, ea difaayi ea nagheeda, ashoohoodiga mida ghushuutka gheeda ASEETEANYA; ak gajeatawa fuga Lawi gilagi aba jeeda gilatamanamughuush bea ng'eanyiideanya, aba gideaba fuga Lawi ghoawaam gilagi aba jeeda gilatamanamughuush aba jeeda mujiinajeagaasa sean. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
