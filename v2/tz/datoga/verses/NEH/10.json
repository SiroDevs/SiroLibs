          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajeeyeana gicha gheeda ASEETEANYA, heeda ashoohoodiga gadiiyi aba gheeda ASEETEANYA, duweachajeega orjoagaasa ea gea dugwaasa, gawuurji gidaghayi sing'waarda aba jeeda deaweeda, dayeega noagaasa ea gisilgaasa; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
