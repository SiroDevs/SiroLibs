            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea fuga abit, ea ashoohoodiga, ea fuga Lawi, ea fuga fur dooshta, ea fuga sarmani, ea fuga gadiyeeda gheeda sibata ASEETA, ea gea ang'aamwa geat fuga ng'eanyiida aba deaweedeeda ASEETA, gadeemga nyaawa, ea orjooga nyaawa, ea haweega nyaawa, ea gea mideawa fughareenga sean, ea nalooda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaguuyi sea fuga nyaawa duupchi, ea fuga nyaawa hees, ak gaweay jeeda mooshta ea habeawooda nea gwaneayeewa jeeda deaweedeeda ASEETA, ghayi siitaw Musa was siida gadiyeeda ASEETA, ak ghoang'waay nea gwasin digheanyeeka sean bea NG'UTAMIIDA was Ng'utamiideanya ea deaweedajeagaaschi ea diigheanyeekaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea majeatawa haweagaasa fuga ng'eanyiida nea maygageena orjoagaasa haweega nyaawa; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama inyas ghoaghaas haleanjeeda nyaawa fuga ng'eanyiida, ghana ghwashaayda booga wassean eaweeda sabaato; majeeshaaha aba heeda nyaawa eaweeda sabaato, ghana eaweeda ghaydit; ea gideaba gweaydeaba ispwa adeayaachi geeshta gilinyoo ea siileeda gil.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
