        },
        {
          "text": "Fuga iin giirooraneeda suh gil, Nehemiyeeda was sugoocheanda haw, was orjeeda Hakaliya, ea Sedekiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
