            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluki, ea Harimu, ea Baana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
