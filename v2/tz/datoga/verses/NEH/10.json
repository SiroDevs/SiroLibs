              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geesisi geat geatinda jea eabwata gideaba aba jeeda gilakweay aba jeemba shiliingaji samwagu, akaleala gajeatayda gaba gadiyeeda gheeda ASEETA; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea mukaateeyda giihiimnooda, ea booga sisabwa geadi bea ghadooweeda bea galeagasean, ea haleanjeeda sisabwa geadi bea ghadooweeda sighwarda bea galeagasean, ea sabaato ea ng'ushiinda sheega, ea gea ghweelmoojiga, ea haleanjeeda ghaydidi, ea haleanjeeda sisapa geadi aba riing'eeda jea eesina giiduupcheeda fuga Israeli, ea aba gadiyeeda sean bea gheeda ASEETEANYA. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseasa ea ashoohoodiga, ea fuga Lawi, ea buuneeda, inyeesa gilakweay gealoachi fuga jea gweadu ghweenga ghadooweeda bea gheeda ASEETEANYA, gawuurji gidanyaashta naweeda gealga ghweanigaasa, aba damanda sirugu, aba gideaba gajeaghwarda aba heeda wagiida bea NG'UTAMIIDA was ASEETEANYA, gawuurji gida ghayi sing'waarda aba jeeda deaweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
