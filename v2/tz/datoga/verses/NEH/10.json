            "number": "18",
            "style": "v",
            "sid": "NEH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodiya, Hashumu, Besayi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.18",
            "verseOrgIds": [
              "NEH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
