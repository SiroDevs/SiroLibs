          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshulamu, ea Abiya, ea Miyamini, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.7",
            "verseOrgIds": [
              "NEH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
