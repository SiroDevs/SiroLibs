          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea haleanjeeda sisabwa geadi bea ghweenga, aba damanda sirukuna, ea haghweega madeeda. Apkaadaan, ea ASEETEANYU, aba ng'asheega miyaas.",
          "type": "text",
