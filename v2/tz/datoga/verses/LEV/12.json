        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eeshiina fuga Israeli, iigweayiit gatmooda ak gwaji baleanda, abeeda gaygaba ririnnyaan eawooji ispwa; gawuurji eaweeda neaweesiina eaghwada, gaygaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hita eaweeteaba sis geeyiil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanu askwearjooji diktam ea damasamwagu bea foojeanda simiina; mayghoang'waay gida wasean ghaydit, ghana gawa heeda ghaydit, ea goosha askwearjoojigaaschi bea giimiinnooda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama jih huda, abeeda gaygaba ririnnyaan askwearjooji damanang'wan, gawuurji damandida neaweesiina eaghwadean; ak gaygoobiida jeeda foojeandaanyi simiina askwearjooji laadam ea lah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iimuchu nea niisha askwearjoojigaaschi bea giimiinnooda, adagaba orjeeda ghanea huda gil, gaygweadu heeda ashoohoocheanda aba ghuuta maheemajeanda siroondooscheesa dayeenda gisilleanda bea gwanyagi ghoah haleanjeeda ghadooweeda sighwarda, ea dayeenda ghariibajeanda ghana ea ghariibajeanda haw ghoah haleanjeeda sighadoawanda aba badayda riing'eeda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghoadayda aba madeeda NG'UTAMIIDA, ak geamiidu, ak abeeda gayghamiidu aba giireemda foojeandaanyi. Nih deaweeda gil aba headaanyi ninyeeda jih baleanda, ea orjeeda gil ghanea huda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadeepa ea mwoamu dayeenda gisilleanda, abeeda gaygageanu ghariibajeesu hees iyeenya ghanea ghariibaji iyeenya manang'i, agi gayghoah haleanjeeda ghadooweeda sighwarda nea niirja geaghadoawanda aba badayda riing'eeda; ak gaygwasin ashoohoocheanda giiduupcheeda aba badaydeaba niny, ak gayghamiidu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
        }
      ]
    }
