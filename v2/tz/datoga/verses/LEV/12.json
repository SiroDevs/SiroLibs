        "style": "s1"
      },
      "items": [
        {
          "text": "Giimiinnooda gadeemga iing'ata jeata baleanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
