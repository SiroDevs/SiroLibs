    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giimiinooda iing'ata geeyooda mughoowooda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha NG'UTAMIIDA Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nih gayghoah deaweedeeda siida bearji udamusuura eaweeda jea eamiina. Gajeeyeadu heeda ashoohoocheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwariteawa ashoohoocheanda jeeda maheemajeanda, ak gaygwasikteawa ashoohoocheanda. Ng'ata, iinihaabwa siida bearji geeyooda udamusuureadaanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda gaygwarukuta ashoohoocheanda gideaba ayaada aba badayda siida jea eamiidu dariidaw iyeenya miyaasiin ea ghweenga gubooyeanda ea weasta oomu ea bileangida hisoopo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwarukuta ashoohoocheanda gideaba anuusa dariideanjagi aba jeeda dahuuda aba badayda beega gulda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gayghwaat dariideanda majeek sea ghweenga gubooyeanda sea weasta oomu ea bileangida hisoopo, ak ghang'uda haleanjeeni ea dariideanda majeegiin jeeda foojeandeaba dariideandida sinuuksa badayda beega guldean; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygoohiisa niba ispwa uhuudeaba siidida jea eamiina udamusuuraan; ak abeeda gaygwargu gideaba niimmiidu, ak gaygwasiksa dariideanda majeek gawa dareabeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida jea eamiidu gaygoohuun hang'weakaaschi, ak ghwareakghu buudeagaaschi sean, ak goohuushi aba jeeda beega, ak gayghamiidu; ama ng'ata gaygawa heeda maheemajeanda, ak goobiida murdeeda maheemajeandaanyi eawooji ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama eaweeteaba ispwa gayghwareakghu buudeagaaschi sean bea uhuudaanyi; ak gayghwareakghu deamuukaaschi ea buudeega gheanyangaaschi, ea buudeagaaschi sean. Ak gaygoohuun hang'weakaaschi, nea goohuun saseadaanyi aba jeeda beega, ak gayghamiidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama eaweeteaba sis gaygageanu dayi iyeenya bea gisilga was lagweendiga manda sirjeeda, ea ijoanagi bea gisilleanda bea gwanyagi manda sirjeeda, ea dearanga ghadooweeda sigeanu heedeaba samwagu aba jeeda damanamughuush was dearanga miyaasiin siikuuyi sea nagheeda, ea gideeshteayda ramagu ghwanyiit. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygageanu ashoohoocheanda jea ghoamiidu niny ak ghwayiin siida jea eamiidu sea haleanjeedida seaniin madeeda NG'UTAMIIDA, aba gidaghuuta maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaygageanda dayeeneanjagi was lagweenda, ak ghoadayda ghoah haleanjeeda ghadooweeda bea giidiinyeanda, sea gideeshteayda nagheeda, ak gagatkat googeal humng'eeda ghoah haleanjeeda ghadooweeda sigatgat siikeal humng'eeda aba madeeda NG'UTAMIIDA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwanuus dayeenda aba heeda sinuuksa haleanjeeda sighadoawanda aba badayda riing'eeda sea haleanjeeda ghadooweeda sighwarda, aba heeda ghaydit; was haleanjeeda sighadoawanda aba badayda giidiinyeanda, gawuurji haleanjeeda sighadoawanda aba badayda riing'eeda, bea ashoohoocheanda; aba gideaba ea ghaydit muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaygageanu ashoohoocheanda foojeanda mwaatkwa bea gida sighadoawanda aba badayda giidiinyeanda, hean gaygageanu ashoohoocheanda ak ghwayeasha madeeda iita geatindaanyi bea dugwa bea siida jea eamiidu, ea uhuuda mooneadaanyi haw bea geatinda dugwa, ea uhuuda mooneadaanyi haw bea geeshtaanyi bea geatinda dugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaygageanu ashoohoocheanda nagheeda mwaatkwa, ak gwayamsa baneaktaanyi bea geatindaanyi ghaadaam, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghang'uda mooneadaanyi bea geatinda dugwa jeeda nagheeda mida geatindaanyi ghaadaam, ak goohiisa nagheeda mwaatkwa aba mooneadaanyi niba ispwa madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea nagheedida abit aba geatindaanyiin gaygageanda ashoohoocheanda ak ghwayeasha madeeda iita geatinda dugwa bea siida jea eamiidu, ea uhuuda mooneeda haw bea geatindaanyi bea dugwa, ea uhuuda mooneeda haw bea geeshta geatinda dugwa, was badayda foojeanda gidasighadoawanda aba badayda giidiinyeanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea nagheedida abit mida geatinda ashoohoocheandean gayghwayiin uhuudeaba siidida jea eamiiduun. Ak abeeda gaygwasin ashoohoocheanda giiduupcheeda aba badaydaanyi aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghoadayda ashoohoocheanda haleanjeeda sighadoawanda aba badayda riing'eeda, ak gwasin giiduupcheeda aba badayda siida jea eamiidu gwaheeli ririnnyeanda. Hean iidu gaygwanuus gidasighwarda jea eaghadoawanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghoadayda ashoohoocheanda haleanjeeda ghadooweeda sighwarda sea dearanga sighadoawanda heeda wagiida. Ak gaygwasin ashoohoocheanda giiduupcheeda aba badayda siida, ak gayghamiidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama deepa ea bwarbwar ak ea mwoamu ghoadayda haleanjeeda deenu, abeeda gaygageanu dayeenda gisilleanda was lagweenda ghoah haleanjeeda ghadooweeda bea badayda giidiinyeanda jea eegatkat eekeal humng'eeda, ak gwasin giiduupcheeda aba badayda siida, nea gideaba damanamughuush bea dearanga eefa miyaasiin siikuuyi sea nagheeda was dearanga sighadoawanda, sea gideeshteayda nagheeda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak eara ghariibaji iyeenya hees ghana ea dayi iyeenya bea ghariibajeanda, gwadeena gidammu ghoadayda; agi gajeaghadoawanda aba badayda riing'eeda nea niirja gayghoah haleanjeeda ghadooweeda sighwarda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea eaweeteaba sis gaygweadu haleanjeeni heeda ashoohoocheanda aba badayda giimiinoadaanyi, aba gidaghuuta maheemajeanda siroondooscheesa, aba madeeda NG'UTAMIIDA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygageanda ashoohoocheanda dayeenda gisilleanda was haleanjeeda sighadoawanda aba badayda giidiinyeanda, nea gideeshteayda nagheeda, ak gaygagatkat ashoohoocheanda googeal humng'eeda ghoah haleanjeeda sighadoawanda sigatgat eekeal humng'eeda aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaygwanuus dayeenda gisilleanda sighadoawanda aba badayda giidiinyeanda; ak gaygageanu ashoohoocheanda foojeanda mwaatkwa bea gidasighadoawanda aba badayda giidiinyeanda, ak ghwayiin madeeda iita geatinda dugwa bea siida jea eamiidu, ea uhuuda mooneeda siida bea geatinda dugwa, ea uhuuda mooneeda haw bea geeshta geatinda dugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaygoohiisa ashoohoocheanda nagheeda mwaatkwa baneaktaanyi bea geatinda ghaadaam, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasaksa aba mooneadaanyi bea geatinda dugwa nagheeda mwaatkwa mida geatindaanyi ghaadaam niba ispwa aba madeeda NG'UTAMIIDA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ata gayghwayiin ashoohoocheanda nagheeda mwaatkwa mida geatindaanyi madeeda iita geatinda dugwa bea siidida jea eemiiduun, ea uhuuda mooneadaanyi bea geatinda dugwa, ea uhuuda mooneeda haw bea geeshtaanyi bea geatinda dugwa, was heeda siyiin foojeanda gidasighadoowanda aba badayda giidiinyeanda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea nagheedida abit mida geatinda ashoohoocheandean gayghwayiin uhuudeaba siidida jea eamiiduun, ak gwasin giiduupcheeda aba badaydeaba siidida aba madeeda NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghoadayda, aba jeeda ghariibajeega hees ghana dayeega ghariibajeega gawuurji gidammu ghoadayda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaleala gayghoah gidasighadoawanda aba badayda riing'eeda nea niirja gayghoah haleanjeeda ghadooweeda sighwarda, nea ghwanung' goodeayi sea dearanga ghadooweeda, ak gaygwasin ashoohoocheanda giiduupcheeda aba madeeda NG'UTAMIIDA aba badayda siida siimiidu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih deaweeda gil aba siida bearji geeyooda udamusuura, mwoamu ghoadayda haleanjeeda ghadooweeda aba giimiinoadaanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuga garbapi aba jeeda gheeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwalamda NG'UTAMIIDA ak gwayeesha Musa ea Haruni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eaweeda ihitaawi ng'eanyiida Ganaani, eagoonyeegwa ghoah deang'wa, gaydayiin geeyooda udamusuura jeeda ng'eanyiida jea ghoah deang'wa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda siida bea gheeda gayghoan ak gwarukusa ashoohoocheanda gideaba, ‘Aba aniini iyeang'ulayi gilimida jeedeaba gheenyu geeyooda.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gaygwarukusa ashoohoocheanda gideaba ooruuta dabita aba jeeda gheeda heeda miighwahina ashoohoocheanda gah ghwadaah gheeda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwasikteawa geeyooda; ama mida geeyooda ghamarda gheeda nea ghoahiimu nyawiishnata ghana areernata, ak ghoahiimu gideaba ghaghurghura ea ea mawuurji heeda simuuw, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda gaygwariteawa ashoohoocheanda jeeda gheeda ak gawa gidaghuuta was gidaghuuta gheeda, ak ghwarat gheeda eawooji ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygabiigu ashoohoocheanda gicha eaweeteaba ispwa, ak gwasikteawa; ama nighayda geeyooda aba ghamarda gheeda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwarukuta ashoohoocheanda gideaba oogeanda lagheanga mideawa geeyooda ak gwahisa heeda mida ririnnyeanda mida riteayda mujiini; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghwanung' eafwaar jeeda gheesean, nea sheang'weeda sifwaar gaygwahisa heeda mida ririnnyeanda mida riteayda mujiini; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ata gaygageanu lagheanga suuk ak ghwayiin hoorgeedeaba lagheangiga, ak gaygageanu sheang'weeda nuut ak ghamuuw gheeda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amadeepa ghaghayda geeyooda gicha aba jeeda gheeda, iing'ata geandeayda lagheanga ea foorda gheeda ea muuwda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ata gaygawa ashoohoocheanda ak goong'weersa; amadeepa ea nighayda geeyooda aba jeeda gheeda, abeeda ea udamusuureeda muy gil aba jeeda gheeda; abeeda gheawi gaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwanyarja gheeda, lagheangaaschi sea ng'udanga sea sheang'weeda sean simuuwa gheeda; ak gayghwasar gooruuteawa riteayda mujiini was heeda ririnnyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida jea gawa jeeda gheeda nea sijap gaygaba ririnnyaan ea ghoah shing'ada; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea siida lil aba jeeda gheeda gaygoohuun hang'weakaaschi; nea siida agiischi aba jeeda gheeda gaygoohuun hang'weakaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nea iiwuh ashoohoocheanda ak gwasikteawa ak ea mii ghaghayda geeyooda aba jeeda gheeda iing'ata muuwda gheeda, abeeda gaygwargu ashoohoocheanda gideaba gheeda maba ririnnyaan, aba gideaba gheeda siihaap. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba giimiinnooda gheeda gaygageanu dariidaw iyeenya manang'i, sea ghweendooda gubooyeanda ea bileangida oomu sea hisoopo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwanuus dariideanjagi aba jeeda dahuuda aba badayda beega gulda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ata gaygageanu ghweendooda gubooyeanda sea hisoopo ea bileangida oomu, sea dariideanda majeek, ak ghang'uda jeeda foojeanda dariideanda sinuus aba badayda beega gulda, ak gwasaksa gheeda niba ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ata ghoamiidu gheeda aba foojeanda dariideanda, ea beega gulda, ea aba dariideanda majeek, ea ghweendooda gubooyeanda ea hisoopo ea bileangida oomu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaygwasiksa dariideanda majeek ghabeawa jeeda mujiini gawa dareabeeta, ak gaygwasin giiduupcheeda aba badayda gheeda, ak gayghamiidu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
