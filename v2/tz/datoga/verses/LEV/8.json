          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu Musa nagheeda giimeardeayda sea foojeandida mida heeda wagiidean, ak goohiisa uhuuda Haruni ea hang'weakaaschi, ea iheenga orjoagaaschi ea hang'weaka orjoagaaschi, sea hang'weaka orjoagaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
