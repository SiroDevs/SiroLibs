              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayeesha Musa Haruni sea orjoagaaschi, “Oawaala banyeega aba ghuuta maheemajeanda siroondooscheesa, ak gooyeaksi hoowa sea mukaateeyda mida jeeda sooscheanda siiroor bea haleanjeeda ghadooweeda, gawuurji gidearukuteaydi, nea geayi, ‘Gayghwaak Haruni sea orjoagaaschi’; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea banyeega abit ea mukaate gayghwarda aba beasta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea majariteawana gidaghuuta maheemajeanda siroondooscheesa eawooji ispwa, ea ghwahita damanda ea goosha eawoojiga siimbiidaneey, aba gideaba gayghwahita eawooji ispwa giimbiitaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawuurji gidasisinda askweareani, gwarugu NG'UTAMIIDA gideaba gaygwasin giiduupcheeda aba badahuukeagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gidaghuuta maheemajeanda siroondooscheesa gajoopiidana askweari ea eawa ea ghwahita askwearjooji ispwa, nea gwasin gidarukusa NG'UTAMIIDA, amasa gajameawa; aba gideaba nih gidasirukuneani.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwasin Haruni sea orjoagaaschi ng'asheega sean rukusa NG'UTAMIIDA Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
            "verseOrgIds": [
              "LEV.8.36"
            ]
          }
        }
