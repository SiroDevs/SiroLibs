              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih deaweedeeda hit aba diyeanga gil ea dariidaka sea gida wasean mideawa eaweega badiini aba jeeda sea gida wasean badiina ng'eanyi aba badayda ng'eanyiida, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
