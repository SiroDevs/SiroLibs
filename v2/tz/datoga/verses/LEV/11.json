        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.19",
            "verseOrgIds": [
              "LEV.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Diyeanga sean mideawa meang'eega badiina ng'eanyi ea munyas aba heedeang'wa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.20",
            "verseOrgIds": [
              "LEV.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba jeeda diyeanga mideawa meang'eega badiina ng'eanyi ghoamuuschi ayaaga gea mideawa geeshanga nea gwadeambiiri, aba badayda ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.21",
            "verseOrgIds": [
              "LEV.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh ghoamuuschi ayaaga: deashamnyeanda aba heeluutkaaschi, ea deashamnyeanda haw aba heeluutkaaschi, ea deashamnyeanda nyawiish aba heeluutkaaschi, ea dakajeanda aba heeluutkaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.22",
            "verseOrgIds": [
              "LEV.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea diyeanga sean mideawa meang'eega mideawa geeshan ang'wan ea munyas aba heedeang'wa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
