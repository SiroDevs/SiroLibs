          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ama deepa ghami diyeayda wassean oamuuschi ayaaga, siida jea ghwasat mustaanyi gaygaba ririnnyaan ea ghwahita shing'ada, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
