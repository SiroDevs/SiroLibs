          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nea aba suh gajanyasa ririnnyeanda; siida wassean waas muscheeka nyaawa gayghwanyas ririnnyeanda ea ghwahita shing'ada, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24",
            "verseOrgIds": [
              "LEV.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "siida wassean jea ghwasar heeda wassean aba muscheeka nyaawa gaygoohuun hang'weakaaschi ak gaygaba ririnnyaan ea ghoah shing'ada. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.25",
            "verseOrgIds": [
              "LEV.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilinyoo ea diyeayda gil mideawa budilga ak ea mii bwaasha budil ghana ea meadeeluuna nyoodeeda ea muy aba heedeang'wa; siida wassean jea ghwasat gaygaba ririnnyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.26",
            "verseOrgIds": [
              "LEV.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea giika aleapiida baneaguuka nyaawaan, aba jeedeaba diyeangiga badiina geeshan ang'waniin, ea munyas aba heedeang'wa; siida wassean jea ghawaas muscheeka nyaawa gaygaba ririnnyaan ea ghwahita shing'ada, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.27",
            "verseOrgIds": [
              "LEV.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea siida wassean jea ghwasar muscheeka nyaawa gaygoohuun hang'weakaaschi ak gaygaba ririnnyaan ea ghwahita shing'ada; mii miyaasiin aba heedeang'wa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        }
      ]
    },
