          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea siida ak mustaanyi gaygoohuun hang'weakaaschi ak gaygaba ririnnyaan ea ghwahita shing'ada; nea siida jea ghwasar musta gaygoohuun hang'weakaaschi ak gaygaba ririnnyaan ea ghwahita shing'ada.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
    {
