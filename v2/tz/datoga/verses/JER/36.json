        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu Yeremiya gitaabwajeanda nuut ak ghoadaw Baruku orjeeda Neriya was ng'oorshoocheanda, ak ghang'oar ng'asheega sean leabu ghuuta Yeremiya was gea ghayi ghwarda aba beasta Yehoyakimu was sugoocheanda Yuda, ak geahaat ng'asheega saang'a uurji gea ghayi bea mwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
