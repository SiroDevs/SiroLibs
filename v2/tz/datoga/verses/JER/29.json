            }
          ]
        },
        {
          "text": "Ng'ata ghoasoamwa barawajeanji ashoohoocheanda siguura Sefaniya aba madeeda Yeremiyaheeda was sibaneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
