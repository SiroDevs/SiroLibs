              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.23",
            "verseOrgIds": [
              "JER.51.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak gaydaadaw Babeli ea fuga sean bea Galdayo nea goong'ulayi agooga aba gheanyangeagwa aba badayda munyasnacheeka sean ghayi sin aba Sayuni, gwarugu NG'UTAMIIDA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "NG'UTAMIIDA gayghaweat Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gichea gabussa Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giijasta ASEETA weah heeda Israeli aba Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyariida nuut bea Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giijasta Yeremiya geayaat Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JER 51:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.58",
            "verseOrgIds": [
              "JER.51.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JER 51:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheanda Yeremiya was sibaneeda rukusa Seraya was orjeeda Neriya, orjeeda Maaseya, damanda adeayeewa Sedekiya was sugoocheanda Yuda ea ghwahita Babeli, aba gweaydeaba ang'wan bea sugoocheanduumeadaanyi. Nea abeeda Seraya ea siida haw ahaaghwa gheeda sugoocheanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.59",
            "verseOrgIds": [
              "JER.51.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JER 51:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gang'oorsa Yeremiya jeeda gitaabu ng'asheega sean munyas jea ghwahidu badayda Babeli, ng'asheesu sean sing'waariin gaba badayda Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.60",
            "verseOrgIds": [
              "JER.51.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JER 51:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha Yeremiya Seraya: “Damanda jea wunana Babeli, sikteawana gideaba giisoami ng'asheesu seaniin, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.61",
            "verseOrgIds": [
              "JER.51.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JER 51:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak giyeeni ‘Ea NG'UTAMIIDA, ang'iing'i girgu aba badaydeaba ng'eanyiini gideaba gaynyarja, ak ea manda gichea goobiida jeeda, adea siida gil ghana ea diyeayda, ak gayghoah raghoonyeanda damanda manda muudeanooda.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.62",
            "verseOrgIds": [
              "JER.51.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JER 51:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak iihiidi giisoomandeaba gitaaboani, girasi badayda lagheaneeda, ak gijaksi bugusta eenda Furati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea giyeeni, ‘Nih gichea ghwaakta Babeli eenda gil, ak ea maygudu gabiikta gwascheeng'u, aba badayda ng'asheega munyas jea deadu badaydaanyi’.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheega Yeremiya gaweay ea ghwahita hiji.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    }
