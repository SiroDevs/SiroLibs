          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak hean geatinga Ahikamu orjeeda Shafani ghoahaaghwa Yeremiya ea meahaaga geatinga fuga munyas ea meenuusa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.24",
            "verseOrgIds": [
              "JER.26.24"
            ]
          }
        }
      ]
