              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi NG'UTAMIIDA, “Aba damandida, geaka sugoodiga Yuda, ea gea fuga nyaawa hees, ea gea ashoohoodiga, ea gea sibanga, ea gea fuga abiita Yerusalemu gajeeruuna jeeda bung'eadinga nyaawa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gajeetearsa madeeda aseeta ea sheeda ea madeeda lugweega humng'eeda, ghayi bwariiy nea gagadiiydooscheesa, ghayi wadiini heanyaawa, ak gwarukwiida ng'asheega nea gabada; ak ea majeamughuush nea majeebuy, gaygawuurji fiyeega dugwa aba badayda ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi NG'UTAMIIDA bea lugweega, fiisu was easangean bea gealga munyasiin aba heeda eadearsi gaygwayi ghang'wana miyeeda mwasamwa giibinda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riing'eeda ea ghoorjooda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giiseaneega Yeremiya aba badayda fugaaschi",
          "type": "text"
        }
      ]
    }
