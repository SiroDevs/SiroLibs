          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba damandida fiisu ea mujiineeda Yerusalemu gajeeyeesha, “Jeameeda geayda ng'waan leabu iheenga heayeeniga balang'da gaygaweesa fugeasu, ak ghoaleal ghana gwasisin, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
