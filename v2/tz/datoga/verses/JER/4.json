              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'asheesu gwarukusa NG'UTAMIIDA fuga Yuda ea gea abiita Yerusalemu gideaba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
