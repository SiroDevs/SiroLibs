              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih ng'asheanda ghayi rugu NG'UTAMIIDA gil aba badayda Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
