              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ISA 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gawa malaykajeanda NG'UTAMIIDA ak ghabwar fih sagalamnyooji bughala ea seedam ea muut, aba heeda mida fuga Ashuru; ghang'eat ng'eat buuneeda nea gudea sakteayda duu gil, geadaah muscheeka sean bea buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'eat gawa Senakeribu was sugoocheanda Ashuru, ak gabiikta Ninawi ak goobiida hoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eaweecha nea ghamwaash ASEATAANYI aba gheeda aseeta siguura Nisroki, hean gawa Adrameleki ea Sharesa was orjoagaaschi ghabwar ghwaan aba ng'uta, amang'ata gwasalda gaweay ng'eanyiida Ararati, ak gawa hoorgeadaanyi Esar-hadoni was orjeedaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
            ]
          }
        }
