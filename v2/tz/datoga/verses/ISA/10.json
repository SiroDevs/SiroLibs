        "style": "s1"
      },
      "items": [
        {
          "text": "Sugoocheanda Ashuru gawuurji dabicheanda ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
