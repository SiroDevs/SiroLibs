          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eamuy daang'u mujiineeda Yerusalemu, heeda wagiida bea ASEETA, mujiineeda deeksa Dawdi hoorgeadaanyi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Washtaanyi dea heawa miinda gheang'da",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gilisiihiimu aba badaydeaba ng'asheesu seaniin gawuurji giijasta sing'oorsa jeeda gitaabooda sirat aba giirooraneeda. Ama iyeasi siida was sean nal giisoomanda ak giyeeshi, “Asoamwana gitaabwajeanji,” gaygwayi, “Maydaamu daasoamwa aba gideaba sirat aba giirooraneeda.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ng'ata geataw gitaabwajeandida siida mwanala giisoomanda ak geeyeesha, “Asoamwana gitaabwajeanji,” ak gwayeesha, “Maydaamu daasoamwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rarooda eaweeda jea ghwahidu",
          "type": "text"
        }
      ]
    }
  ],
