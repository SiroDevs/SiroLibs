              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eaweedida NG'UTAMIIDA gaygageanu ng'utaanyi ng'waan, majeek, haw ak ghwalas uhuudeaba ichiboodida deambiiri siguura Lewiatani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:1",
              "type": "text"
            },
            {
              "text": "Lewiatani: Gheawunga diyeayda haw gil siruku, abiita jeeda beega. Nea hich geeguura ichibooda haw.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ak gayghabwar Lewiatani ichiboodida hala geaw abiita jeeda basoodean.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
