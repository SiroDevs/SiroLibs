{
  "id": "1KI.17",
  "number": "17",
  "bookId": "1KI",
  "reference": "1 Sugoodiga 17",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
