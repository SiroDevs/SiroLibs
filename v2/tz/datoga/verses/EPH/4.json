{
  "id": "EPH.4",
  "number": "4",
  "bookId": "EPH",
  "reference": "Efeso 4",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
