        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gidaguuyeata saseeda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aniini, geawooschi siida ghealooniga aba badayda Ng'utamiida, geamuscheegwa gideaba oatoabiiwa eaweega deaschi sea guurnooda ghayi siguurneegwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea gooyeadayi geat ng'eanyi ak goowooschi garbapi, nea ghoahang'waanyi nea goomilikideaysi geat aba bariinyeega, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "agassa gideaba gajaguuyeena aba Guroorooda nea gearadaneegwa hoyyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
              "EPH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saseeda ea agi, ea Gurooroanagi, gidaghayi siguursiindaneegwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'utamiinagi, masaweega ea agi, giibaatiisanda ea agi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASEETA ea agi was Ghweandeanya eesa sean, ak ghang'ataawa sean ak gagadiiy aba jeedeaba sean ak gwanda jeeda buuneesean. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea dagheerjeanduumeeda gaba siisi siitaw aba aseasa aba giteena gidaguh Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geeyi,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giibindeesh aba jeeda Gristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.16",
            "verseOrgIds": [
              "EPH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi gearukuneegwa ng'asheanji, aba badayda Ng'utamiida, gideaba adoapiideati gidabiideata fuga Eemoojiga, saawa gooteemsheesa ng'asheega mwadaagha mwahida; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.17",
            "verseOrgIds": [
              "EPH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak fughareenga nyaawa ea sinung' gamisaniidi, ak ea siheeli sea eaweega ASEETA, aba leendeeda mida jeenyaawa nea gwasin hang'ooynacheeka jeesinga nyaawa; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.18",
            "verseOrgIds": [
              "EPH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea nideang'suusi ghoabuuta geat jeeda ririnnyeanda ak abeeda gwasin gilinyoo ea ng'asheega munyas gil. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak agooga ea mii gissiinaaldaneegwa aba badayda Gristohi!– ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.20",
            "verseOrgIds": [
              "EPH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda ghayi iyoayiinyi ak ghaanaaleegwa aba badaydaanyi, huumeanda mida jeeda Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oapuuda searoojigeagwa bea garayi bea giibinda biissa eamuy aba haleanjeeda sigaseadayi reengani fih, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "asina geat gaweeriidi gurooruunatkeagwa ea giiteemshoodeang'wa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.23",
            "verseOrgIds": [
              "EPH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak daba siisi mideawa gurooroodeesh, sisin gawuurji ASEETA aba doobiiwnata huumwa ea ghaydidanda.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi anung'waada ng'uyeega, daba siisi abaloola giischeewoocheandaanyi huumeanda, aba gideaba aseasa geewooschi fuga weechi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyareasa ak ea adiidu goosinyi riing'eeda; ak ea adagamikta nea gudawoosa nyareeseadi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ea adoatawji meang'nyeandeenda gheata. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.27",
            "verseOrgIds": [
              "EPH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mareanghweanda danung'waada gwadishta, dang'eada ghuuta gadiyeeda miy aba geatingaaschi, ak ghwanyas gichea ghoadaw fugiga gassean. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.28",
            "verseOrgIds": [
              "EPH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adagwarina ghuusigeagwa ng'asheega munyas, inyeessa goobalooli gea miyaasiin jea ghaweat gilinyoo ea siida gil, ak ghoadaw dagheerjeanduumeeda fuga aleeyseegwa iit. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.29",
            "verseOrgIds": [
              "EPH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea adoang'udi gurmeahiida Guroorooda Ghaydit bea ASEETA, aba headaanyi siirooreegwa aba eaweeda ghuhooda. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.30",
            "verseOrgIds": [
              "EPH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ageandeawana geat ng'asheega sean ng'weani was mukunooda ea nyarasta ea giijuureanda ea napooda ng'uyeega nea goosheagiidi geat gea munyas sean, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.31",
            "verseOrgIds": [
              "EPH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi awoosa inyeani jeesin aba heeda buuneeda suurja, bayiida buuneeda, samiisa geat, gawuurji gidasamsiindaneegwa ASEETA aba jeeda Gristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.32",
            "verseOrgIds": [
              "EPH.4.32"
            ]
          }
        }
      ]
    }
  ],
