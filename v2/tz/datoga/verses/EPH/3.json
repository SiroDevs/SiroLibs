            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aba ninyeeda mideawa uurda gadiiyi aba jeesingaasa ghoamu gwasin ng'asheega saang'a ea ghang'al haleanjeeda simuschi ea gea siipkaachi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "daba niny giigheambiita aba jeeda ganiisa aba jeeda Gristo Yesu ea ghoah jeacheenga sean ea ghoah damanda manda muudeanooda. Amin.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
