{
  "id": "MAT.21",
  "number": "21",
  "bookId": "MAT",
  "reference": "Matayo 21",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "MAT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hooseaneega aba hiteayda Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gwaneekiisa Yerusalemu ghwahita Betfage, mida giijeeda saytuunajeega, hean goojeakta Yesu giinealan iyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea gwayeesha, “Aweayeena ea ahita gharang'da mida madeadeang'wa, deagheata gajadaaha digeeda sirat ea gureandaanyi; gootinyi ak gooyeanean. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama rukuneegwa siida ng'asheanda, gooyeeshi, ‘Gagasa Ng'utamiida,’ ak gaygwasikseegwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh seaniin geesindunu gwadeaschi sea ng'asheanda ghayi rugu sibaneeda nea gwayi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu gawa jeeda gheeda sibata ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawa Yesu jeeda gheeda sibata ASEETA, hita ghahoan fuga shaayda haleanjeeda ea gea shaah aba jeeda gheeda sibata ASEETA, ak goobimbiineada measajeega fuga nyarja lapiya, ea hoorgajeega fuga shaayda ghariibajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha saawa, “Geang'waar gideaba, ‘Gheenyu gajeeguura gheeda simoora ghawooda’; amadu ghoanung' agooga ghoah gwaleeda funya geat mareanghooga.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay headaanyi fuga badoojiga ea gea ng'oowi ak ghwanyasa jeeda gheeda sibata ASEETA, ak ghoahaap. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah ashoohoodiga hees ea ng'oorshoodiga ng'asheega deamdeameadi sin, ea ghuusiga diibiga ajuur aba jeeda gheeda sibata ASEETA nea gwayi, “Hoosaana Orjeeda Dawdi!” Gwanyareesi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "geeyeesha niny, “Heapi niyiinyi gida nyaah fiisu?” Gwayeesha Yesu saawa, “Ea huumwa ghayi, miyoasoamwana gideaba,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ghamwaashta shaboogheecheanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakteayda nea gagal mujiini, ghwayeat jih. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwadaa shaboogheecheanda mida ghuuta naweeda, ak gaweesa, ama hita heeda ghwadaah mandeawana haghweega geaghus seenga ak ghwahit. Ng'ata gwayeesha geeta, “Adagudijiili haghweega ea ghoah gweanyeeka manda muudeanooda!” Ghaghajaamiit geetida aba geeshangiga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daah giinealanga, ghahamng'eanyi nea gwayi, “Ghwasaan anda geedi gabay ghaghajaamiit?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha Yesu nea gwayeesha saawa, “Aba huumwa geayeeshiineegwa, iyoondeawi masaweega nea manda jeesingeagwa machmajeega, ghoamuuschi nea majeaghus nih bea shaboogheecheandean ak ghwahit, gajoamuusa eara gideaba gajayeeshiina giijeeni, ‘Loadaada ak geejakseey jeeda basooda,’ ak gaygwasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadu iyoondeawi masaweega, ak goomuschi nea ghoamwaashchi ghawooda gajanyasa haleanjeeda sean oogasayi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Geannyaash Yesu heeda nyasa gheambalmeadaanyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gawa Yesu jeeda gheeda sibata ASEETA goonealshi, damani anealsheewean gaweay heeda ashoohoodiga hees ea gweargwa ak geannyaash, “Ng'asheesu deenuun gisini aba gheambalmeedeabeang'a, gagoonyi ng'eaha gheambalmeani?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.23",
            "verseOrgIds": [
              "MAT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha Yesu nea gwayeesha, “Eara aniini gaydaanyaasheagwa ng'asheanjagi; ama oashaayi abeeda eara aniini gaydarukuneegwa gheambalmeani easini ng'asheesuun headaanyasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.24",
            "verseOrgIds": [
              "MAT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giibaatiisanda Yohana gwaleabu yeenu? Gwaleabu humng'eeda ghana leabu heeda buuneeda?” Hean goonyeari geat saawa gideaba, “Iisiyeeshi, ‘Gwaleabu humng'eeda,’ abeeda gaygwayeeshiineasa, ‘Abeeda ghwasaan anda moamwasi?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama siyeeshi, ‘Gwaleabu heeda buuneeda,’ earada geawali eemeeda; aba gideaba ghwanal buuneassean gideaba Yohana sibaneeda.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.26",
            "verseOrgIds": [
              "MAT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwasha ghuuta Yesu nea gwayeesha, “Meanali.” Gwayeesha niny saawa, “Eara aniini abeeda ea maydarukuneegwa heeda aanyasi gheambalmeani easini ng'asheesu seaniin.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala orju iyeenya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Heapi ghoadaaktiin? Gwandeawa siyagi orju iyeenya; gaweesa dea madeeda ak gwayeesha, ‘Orjeeda, askweareani una ak gisini gadiyeeda aba jeeda madamnyeanda sabiibu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.28",
            "verseOrgIds": [
              "MAT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha nea gwayeesha, ‘Maydawa.’ Iidu gwaduukuuna ak gawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.29",
            "verseOrgIds": [
              "MAT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweesa siidida bea iyeenyean ak gwarukuteayda gidagwachi; ghwasha nea gwayeesha, ‘Gaydawa, Siida mureeda,’ ak ea mawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.30",
            "verseOrgIds": [
              "MAT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heapi! Aba jeedeaba fiisu asiyeenyean gwasin aneeda gidagasa ghwaan?” Gwayeesha saawa, “Diita bea madeedean.” Ng'ata gwayeesha Yesu saawa, “Aba huumwa, geayeeshiineegwa, fuga ang'oonyi gwaadi ea fuga hiseada gaygoosheedeaweegwa beata jeeda sugoocheanduumeeda ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba Yohana ghayi ghwaan heedeang'wa aba naweeda doabiiwaat ak ea moamwasi agooga, amadu ghamwas fuga ang'oonyi gwaadi ea fuga hiseada. Earapeadi noadaayi haleanjeeni seaniin ghanyea mii aduukuunana ghana amwasa niny.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala fuga aragaan madamnyeanda sabiibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ooleeysiiniit gideagali nuut. Ghayi gwanda siisi bea gheeda ak gwandeawa madamnyeanda sabiibu ak gooneaweesa hilgweanda ak gwasin heeda jea eesisa difaayi aba jeeda ak ghwadeas eara madalooda, ak ghoadaw fuga jea gooragan, ak ghang'eat gawa bareanyeeka aba ng'eanyi nuut. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neekiit damanda haghweega goojeakta soomjoagaaschi heedeaba fugiga aragan madamnyeandean gaweay gweadu haghweagaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.34",
            "verseOrgIds": [
              "MAT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gageanu fuga ghayi ragan madamnyeandean ak ghoang'waay soomjoogiga siicheaktean ak geabwar akaleala, nea niirja geenuus, nea niirja geefuta lagheanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.35",
            "verseOrgIds": [
              "MAT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta goojeakta soomjooga suuk saang'a naawa gea madeeda; gabiikta gicha gwasima fiisu gidida. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.36",
            "verseOrgIds": [
              "MAT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba huuydeanda goojeakta orjeedaanyi nea gwayi, ‘Gayghoawal gheang'da orjeedeanyu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.37",
            "verseOrgIds": [
              "MAT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah fugiga ghayi aragan madamnyeandean orjeedida gabaloola saawa nea gaba geat gideaba, ‘Nih siichea gwahearaniischi gil, eabwara ghami ak geegeandi hearaniischoadaanyi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.38",
            "verseOrgIds": [
              "MAT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geang'waay ak geeruuteawa madamnyeandida bea misabiibuun ak geenuus. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda iihidu siidida bea madamnyeanda misabiibuun gaygwahindaan fugiga ghayi aragan madamnyeandean?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeyeesha niny, “Gayghwalas uhuudeaba fugiga munyasiin, ak ghoadaw madamnyeandida fih suuk jea gooragan ak geataw haghweega aba damandaanyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Yesu, “Heapi miyoasoamwana iiteaba ng'asheanji aba jeeda Ng'ooruutka?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean iiy Ashoohoodiga hees ea Farisaayajeega ng'asheagaaschi galageadiini, gwajeeng'u gideaba gabaloola saawa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geebiisa eegasa gichea eang'waayda, amadu geawal buuneeda aba gideaba ghwadaah gideaba sibaneeda gil.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
    }
