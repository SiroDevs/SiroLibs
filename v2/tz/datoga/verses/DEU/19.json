{
  "id": "DEU.19",
  "number": "19",
  "bookId": "DEU",
  "reference": "Giipkeata Diigheanda 19",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
