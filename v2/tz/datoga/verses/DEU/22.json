              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba gwaluudayi aba jarooda, earapeadi aguul huda nea gagasa weetean ghanyea manda siida hidu ghaweat.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
