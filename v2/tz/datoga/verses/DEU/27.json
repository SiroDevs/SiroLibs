          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Gajeamwaashta siida nyooh gageanda giirooraneeda moonghooda giischeewoocheandaanyi.’ Ak gwayi buuneesean, ‘Amin.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
