          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Gajeamwaashta siida nyooh ghaghwan naweeda siida ng'oaw.’ Ak gaygwayi buuneesean, ‘Amin.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
