          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Gajeamwaashta siida nyooh gwaluudayi huda geenyaawa, ghana huda ghwaan, ghana huda ghaamwat.’ Ak gaygwayi buuneesean, ‘Amin.’",
          "type": "text",
          "attrs": {
