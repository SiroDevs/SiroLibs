  "reference": "Giipkeata Diigheanda 13",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "DEU 13"
      },
      "items": [
        {
          "text": "13",
