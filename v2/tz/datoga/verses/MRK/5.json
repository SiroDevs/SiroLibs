{
  "id": "MRK.5",
  "number": "5",
  "bookId": "MRK",
  "reference": "Marko 5",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MRK 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ghoahaap siida bearji meangeenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchu ghwahita giigheawda basooda ng'eanyiida Gerasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.1",
            "verseOrgIds": [
              "MRK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deagheata nea gwarina Yesu jeeda maleambooda geadaah siisi mideawa meangeenda nea gwaleabu heeda sibunyiisa buuneeda ak gwaroonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.2",
            "verseOrgIds": [
              "MRK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siisi eawoojisu goobiita hoowa sibunyiisa buuneedean nea ghanyea manda siisi ammu ghwarat aba munyaloalajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.3",
            "verseOrgIds": [
              "MRK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea eara iisirata munyaloalajeega ghana biingu inyeesa gang'acheaweada sean nea ghanyea moamu sih ghwajoar. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.4",
            "verseOrgIds": [
              "MRK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyeesa Goojuureadayi eawa ea askweari nea gahoona geaw hoowa sibunyiisa buuneedean ea jeesinga beareega nea inyeesa ghabwaashaadawa geaw lagheanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah Yesu nea gudeasheagi Ghafwach ama hita heeda ghwahiiy geaw aba mureeda aba madeeda Yesu ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.6",
            "verseOrgIds": [
              "MRK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak goojuur nea gwayeesha, “Geendeayeesi naaha Yesu sea ang'iing'i, Orjeeda ASEETA haw? Geamuscheey aba gheawunga ASEETA adisawanyean!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.7",
            "verseOrgIds": [
              "MRK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba niyeesha niny, “Riteaysiina siisi!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghoanyaash Yesu nea gwayeesha, “Gheawungaagu ng'eaha?” Gwayeesha siidida, “Gheawungeasu geeguura Lugooda, aba gideaba aseasa geewooschi saang'a.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamearmearani Yesu nea gwayeesha, eaniyean adigutidaneasa aba ng'eang'i. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gwanda hoowa hawanda ukurmajeega siihaaghwa aba geeshta heayeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.11",
            "verseOrgIds": [
              "MRK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamearmearani, Meangeenda Yesu nea gwayeesha, “Nung' eeweaya jeedeaba ukurmajeegiga.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.12",
            "verseOrgIds": [
              "MRK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwasiksa Yesu lugoodida bea meangeendean, ak gwariteaysa siidida ak ghoabita jeeda ukurmajeega. Abeeda ukurmajeega gwariiksa sagalamnyooji iyeenya. Gamng'aw ukurmajeega ak ghoabuutaawa geat mareecheanda ak ghwaak basooda sean. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwasalda fuga gwachi ahaaghwa ukurmajeega ak gaweay ea ghwahita mujiini ea heeda mawoosa mujiini. Ghapka buuneeda ghwadaah ng'asheega bunu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.14",
            "verseOrgIds": [
              "MRK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay ama hita hoowa mida Yesuun ghwadaah siidida eawoojisu ng'utooschi lugooda meangeenigean nea goopteada nea gookwa hang'daanyi nea nibiiksa fughareadaanyi, ak geabeal. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.15",
            "verseOrgIds": [
              "MRK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gwarukusa fuga gwachi dea ng'asheesu buuneeda suurja iita gidabussa siidida bearji meangeendean ea iita ukurmajeega. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.16",
            "verseOrgIds": [
              "MRK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geebiisa eemus Yesu gideaba ng'amwana ng'eang'deanya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daah Siidida nea gawa Yesu jeeda maleambooda gamus goodeayi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.18",
            "verseOrgIds": [
              "MRK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaheawa Yesu goodeayi siidida. Ghoadeal nea gwayeesha, “Una ghoah ak girukusi ng'asheega sean fuga ghaheang'wa ea gida niweataneey Ng'utamiida ea gida nibwaydaaydaneey.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.19",
            "verseOrgIds": [
              "MRK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawa Siidida ak gwarukwiida alooheeda ng'asheega miyaasiin sissa Yesu aba jeeda mujiinajeegiga atamanamughuushiin. Nyas buuneeda iidi bea ng'asheesuun ghahamng'eanyi sean.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giiheapta hudeaba Yayro ea gatmooda waas weeleeda hang'da Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwading'da Yesu maleambooda ghoaghaawa basooda ak gawa ama weah giigheawda gooreemsa Eemeetuw gaweay ghwanyasa hoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.21",
            "verseOrgIds": [
              "MRK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghwahidu heeda siisi siguura Yayro siisi abeeda gaba fuga hees ahaaghwa ghooriida fuga Yahudi siinealshacheewa. Hita Siisi goobeedeaysa madeeda Yesu nea gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.22",
            "verseOrgIds": [
              "MRK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jeebi iteanyu mwanang' bea haweega ghabwar miyeeda. Eaniyean beeni waasana geatingaagu ak abeeda gayghahaap.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.23",
            "verseOrgIds": [
              "MRK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eat Yesu goodeayi siidida. Ghabwaang'aada eemeetuw gamaseaw nea geasaabwan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gwanda hoowa gatmooni aream foojeanda galeagasean gweanyeew damaniyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.25",
            "verseOrgIds": [
              "MRK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatmooni abeeda niduulu haleanjeadaanyi aba beata gealga meanga nea ghanyea maloosiina eara gil gwareanyiisachi muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.26",
            "verseOrgIds": [
              "MRK.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda ninyas iita Yesu Ghwaat geeshta ak ghawaas weeleeda hang'da Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.27",
            "verseOrgIds": [
              "MRK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwasin ng'asheanji nea gwayeesha geaw, “Iyaawaaschi weeleedeaba siisi ghaanali gaydaahaap.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.28",
            "verseOrgIds": [
              "MRK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hita nea ghawaasa geaw weeleeda hang'da Yesu deagheata gageanda giireemdida bea foojeandean. Nea eara iisawsa saseadaanyi ghwadaah nimajeegiit. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.29",
            "verseOrgIds": [
              "MRK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeeng'u Yesu gidabeada nisuunya uurdaanyi gwasachsa ghaat eemeeda ak gwayeesha, “Ghawaas ng'eaha weeleeda hang'deanyu?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.30",
            "verseOrgIds": [
              "MRK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha ginealangaaschi, “Girukutaaydiin gideaba, ‘Ghawaas ng'eaha,’ nea gidaahi gidariistaneey buuneeda?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.31",
            "verseOrgIds": [
              "MRK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goong'weerng'weersa Yesu meadajeega sean ghwadaah ea jea ghwanyas siida ghwanyawa waas. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.32",
            "verseOrgIds": [
              "MRK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghwadaah gatmoodida gideaba nihaap gaweesa Yesu nea ghaboadanaada aba muuwda ama hita gwatkuy aba madeadaanyi ak ghoadayda iita sean. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.33",
            "verseOrgIds": [
              "MRK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, Yesu gatmooda, “Hudeanyu, gidahaapnyi masaweagaagu, una nea gibeahi seayu nea gagasa ea mabiikseey geeyooni.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duu goobalool Yesu gatmoodida deagheata ea siicheagu fiisu leabu gheeh Yayro ak gwayeesha, “Jeeptaang'u nimi. Ghwasaan anda giideawiidi giinealshoocheanda?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.35",
            "verseOrgIds": [
              "MRK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyas Yesu iidi ghoanaawa geaw ak gwayeesha, “Adibeali. Heapi ang'iing'i mwasa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.36",
            "verseOrgIds": [
              "MRK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ea moodeayi fih suuk geaghus Betaro, Yakobo ea Yohaneeda geenyea Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.37",
            "verseOrgIds": [
              "MRK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwahita gheeh Yayro ak ghwadaah Yesu eemeeda mwahawda heeda mwasakta dabeaka suurja gagutu heareega nea ghoahaawda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.38",
            "verseOrgIds": [
              "MRK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hita Yesu gwayeesha, “Anda agooga gooyeawdi nea mandaneegwa eara hawdaaw? Jeapaang'u eara miyeeda miighami. Gabeachi ruweanga ak ghwahit.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.39",
            "verseOrgIds": [
              "MRK.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabara reari buuneeda. Hean gooruuta buuneesean jarooda ama hit gaguursa ghweanda baleanda ea gheamata baleanda ea ginealangaaschi ghwanyawa adeana ak gaweay hoowa bea gah mida jeeptean. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.40",
            "verseOrgIds": [
              "MRK.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hita Yesu ghoang'waay geatinda baleanda nea gwayeesha, “Dalitakumi”; nea gideaba, “Huda mwanang' ng'eada!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.41",
            "verseOrgIds": [
              "MRK.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deagheata gafakna geaw ng'eanyi hudida ak ghang'eat gawa. (Jeeptida abeeda gaba gweanyeew damaniyeenya.) Ghwanung' ng'asheanji ghahamng'eanyi buuneeda muuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.42",
            "verseOrgIds": [
              "MRK.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gwayeesha Yesu buuneeda, Adiidu goorukusi gili gwachi easinyiin. Ng'ata gwayeesha oatawa huda gichea ghwaak.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.43",
            "verseOrgIds": [
              "MRK.5.43"
            ]
          }
        }
      ]
    }
