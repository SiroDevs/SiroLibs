{
  "id": "ACT.4",
  "number": "4",
  "bookId": "ACT",
  "reference": "Gadiyeeda Giijasoodiga 4",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
