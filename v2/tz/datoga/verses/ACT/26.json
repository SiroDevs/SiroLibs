{
  "id": "ACT.26",
  "number": "26",
  "bookId": "ACT",
  "reference": "Gadiyeeda Giijasoodiga 26",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
