            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghang'eat sugoocheanda haw ea sugoocheanda haw bassa ea Bernike ea buuneesean gwachi abiitpiit mideayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea ghang'eatng'eat gaweay geebalooleada nea geeyi, “Siisi mii gwasin gilimuy miisa miyeeda ghana ghealooniga.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siisi inyeeda gwachi ea mii ghoang'aata girgweageadaanyi heeda Gaysari, gwachi gajeesiksiina.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
