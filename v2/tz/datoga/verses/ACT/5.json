              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.39",
            "verseOrgIds": [
              "ACT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata geesin gidagasa, iidu nea geeguursa giijasoodiga, geabwar amahit geerukusa gideaba adagudoanali buuneeda aba gheawunga Yesu, iidu geesiksa gaweay. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.40",
            "verseOrgIds": [
              "ACT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwarita ak ghang'amwa madeeda girgweageeda, nea gahoosan aba gideaba gammiisa sawanadeeda aba gheawunga Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.41",
            "verseOrgIds": [
              "ACT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea galeagasean iissa aba jeeda gheeda sibata ASEETA ea aba ghoah ea mii ghwanung'waada giinealshooda ea rukwiideayda Yesu gideaba Gristohi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.42",
            "verseOrgIds": [
              "ACT.5.42"
            ]
          }
        }
