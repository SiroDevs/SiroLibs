              "type": "text"
            }
          ]
        },
        {
          "text": "iidu nea gabiikta ghoah; gawa goopteada aba badayda mutukoadaanyi, nea ghoasoamwa gitaabooda sibaneeda siguura Isaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.28",
            "verseOrgIds": [
