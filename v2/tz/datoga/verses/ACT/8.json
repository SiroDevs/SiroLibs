            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha Guroorooda Ghaydit Filipo, “Siyeang'da ak guwi ding'da mutukwajeandida ak giideayeewi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        },
        {
