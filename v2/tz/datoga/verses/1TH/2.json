    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gadiyeeda Bawlo aba Desalonike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba fuga eaduupcheewi ghoanali, gideaba gidasipkaandi heedeang'wa mii mwadaagha gil; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.1",
            "verseOrgIds": [
              "1TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eara gwasa ning'ata sawanadeedeanya nea geapwaaspwaseasa aba Filipi, aba gidoanaldi, hean goomajeegeasa ASEETEANYA ak gearukuneegwa giijasta miy bea ASEETA aba madeeda fuga eang'alealeewi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.2",
            "verseOrgIds": [
              "1TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba gissimuschi maleapna heeda ramaseanda ghana ririnnyeanda, ghana eesin aba milmilanda; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.3",
            "verseOrgIds": [
              "1TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "gawuurji gidaghayi goondaneasa ASEETA gheata Giijasta miy, ea gidasirukwiidi, nea meewuurjeewani fuga ahoosani buuneeda, geewooschi fuga ahoosan ASEETA nal gurooruunatkaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.4",
            "verseOrgIds": [
              "1TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba moang'wa eerukuna ng'asheega ghwaroodeaba geat, aba gidoanaldi, ghana shidoodeaba ghaang', nea ASEETA ea muushoocheanda gil; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.5",
            "verseOrgIds": [
              "1TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea ghanyea miyeegassa gharbeeda aba heeda buuneeda, ghana heedeang'wa ghana hichpa fih suuk, ghana gwadeepa ea sigasayi aba gideaba geawooschi giijasoodiga Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iissa geawooschi ng'eeni aba jeedeang'wa, gawuurji gidang'uliida gheamata diibigaaschi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwasunu eara aseasa geaghuscheegwa aba bariinyeega muuchi, ak geehoosanyi nea meakghusa goonda giijasta miy bea ASEETA ak ghwahit, geegoonyeegwa eara gurooruunatkaasa, aba gideaba noowooschi fugaasa sibwariinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoapkaachi gissiburdi ea gissisawaneati, fuga eaduupcheewi; aba gideaba iissa geegadiiyi eawa ea askweari, ak ea meesawani siida wassean aba jeedeang'wa, nea geerukuneegwa giijasta miy bea ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agooga goowooschi muushoodiga, ak gwasunu eara ASEETA, ea gidaghaydita ea gidadoabiiwaata ak gabiissa ea meeyeateena ghuut searoojigaasa aba heeda fugeagwa mideawa masaweega; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba gideaba agooga ghoanali, gawuurji ghweanda ea diibigaaschi, iissa geamiinyi gheang'ba giliwas sih nea geemajeegiideegwa nea geereekuseegwa ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghoabeadi gidahaguuwdaneegwa aba madeeda ASEETA, ghayi guurneegwa agooga ak abeeda gooweayi jeeda sugoocheanduumeadaanyi ea giigheambiitaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea iissa geebadiischeesi ASEETA galeagasean aba badaydeaba ng'asheanji, gideaba dea noang'waanyi ng'asheanda ASEETA ghayi ooyiing'si heedeanya, ea moang'waaydani ng'asheanda buuneeda ghoanung' gawuurji ng'asheanda ASEETA, biissa gagadiiy aba jeedeang'wa agoogeeda mideawa masaweega. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba agooga, fuga eaduupcheewi, ahuwa fuga jea goodeascheeweawa geat ganiisajeega ASEETA aba jeeda Gristo Yesu mida ng'eanyiida Yudeya; aba gideaba noanyaschi sawanadeeda uurji diita aba heeda fuga ng'eang'deang'wa gawuurji gidasisinda fuga Yahudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "dea ghayi nuus sean Ng'utamiida was Yesu ea sibanga, ak gooruutaneasa jarooda, ak ghoanyareas ASEETA nea ghaheawa buuneesean ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea ghoadealeasa aseasa ea meerukusiini fuga Eemoojiga gideaba gajeelealu ak gawuurji gili siinyiit giideenda riing'eega nyaawa. Iidu ea nihidu nyarasta ASEETA badahuuka nyaawa aba huuydeanda.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea geegeandeawaneasa heedeang'wa, fuga eaduupcheewi, aba gheadi nuwaas, aba saseeda nea mii aba guroorooda gil, geamilikghti nea geegasayi muuchi aba gasooda haw bea huumwa deakta gheanyangeagwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.17",
            "verseOrgIds": [
              "1TH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi geegasayi eepkaana heedeang'wa aniini Bawlo, gicha ea gicha ghoadealeasa Shataani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.18",
            "verseOrgIds": [
              "1TH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neada raroodeanya ea naaha ghana hooseaneega ghana shiipka jea daghwara geaw aba madeeda Ng'utamiideanya was Yesu aba hinoadaanyi? Neada ea mii agoogea? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.19",
            "verseOrgIds": [
              "1TH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba agooga goowooschi gharbeedeanya ea hooseaneagaasa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.20",
            "verseOrgIds": [
              "1TH.2.20"
            ]
          }
        }
      ]
    }
  ],
