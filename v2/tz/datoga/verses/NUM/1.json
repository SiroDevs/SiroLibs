          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea mooneeda buuneesean bea Israeli siyiida aba gidabeada gealga ghweaniga nyaawa, ng'eada siida bea gweanyeew diktam ghana ghwanaawa, giliwas sih ammu gawa ng'ucheeda aba Israeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
        {
          "name": "verse",
