          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba jeeda fuga Gadi, aba gidabeada jeacheenga nyaawa, ea fuga gheanyaawa, ea gealga ghweaniga nyaawa, aba giteena mooneeda gheawunga, ghang'eada siida bea gweanyeew diktam ghana ghwanaawa, was fuga sean ammu gaweay ng'ucheeda; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga siyiida bea eemeeda Gadi, buuneeda ea sagalamnyooji haradam ea muut ea bughalaji lah ea haradam ea damanamughuush.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.25",
            "verseOrgIds": [
              "NUM.1.25"
            ]
          }
        }
      ]
