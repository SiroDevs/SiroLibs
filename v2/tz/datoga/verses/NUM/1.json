          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gea orjooga Simeoni, jeacheenga nyaawa, aba gidabeada fuga gheanyaawa, ea gealga ghweaniga nyaawa, was fuga siyiida aba giteena mooneeda gheawunga nyaawa, aba giliwas sih, giliwas ng'eedeeda bea gweanyeew diktam ak gwadiyeada, was fuga ammu gaweay ng'ucheeda: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "fuga siyiida aba jeeda fuga eemeeda Simeoni, buuneeda ea sagalamnyooji haradam ea damashageash ea bughalaji samwagu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
    },
