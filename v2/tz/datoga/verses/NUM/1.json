          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga Lawi aba gidabeada fuga ghweaniga nyaawa ea meeyiiduudayi sea buuneeda suurja. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
