        "style": "s1"
      },
      "items": [
        {
          "text": "Bileangida Haruni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata goobalool NG'UTAMIIDA Musa ak gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baloola sea fuga Israeli, ak ginung' gaba siisi goonyi bileangida, bileanginagi aba giliwas gheeda, aba hichpa siisi haw aba giduurji gealga ghweaniga nyaawa, bayiiga ea damaniyeenya. Ak gaba siisi ing'oorsi gheawungaaschi badayda bileangidaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak bileangida Lawi gayng'oorsiina gheawunga Haruni; aba gideaba gaygaba siisi haw mideawa bileanginagi aba giliwas eamwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gajiina jeeda maheemajeanda siroondooscheesa aba madeeda mushoodiga, aba heeda siroonyeesi aniini ea ang'iing'i. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak abeeda bileangida siida aaloachi gayghafiirfiir; ak gaydareekusa giiniikghta fuga Israeli, aniikgh aba badahuukeagwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goobalool Musa fuga Israeli; ak ghoadaw niny fuga nyaawa hees sean bayiiga, giliwas bileangi aba siyagi haw aba gidabeada gealga ghweaniga nyaawa, bayi damaniyeenya; nea bileangida Haruni gwanda jeeda bayiiga nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwayiin Musa bayiiga madeeda NG'UTAMIIDA aba jeeda maheemajeanda muuwuunooda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu gawa Musa jeeda maheemajeanda muuwuunooda; ak ging'ulayi, bileangida Haruni bea gheeh Lawi nifiirfiir, niiruudu seenga, ak gooruudu deakghweeda; ak gwalagu haghweega hees was rabeakgha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gooruuta Musa bayiigiga seaniin aba madeeda NG'UTAMIIDA ak ghwayiin madeeda fuga sean bea Israeli; ak gang'ula, ak gaba siisi geanda bileangidaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha NG'UTAMIIDA Musa, “Adealda bileangida Haruni aba madeeda muushoodiga, ak geetiiw ghoah gwadeagooda aba badahuukeaba fiisu munyasiin ak abeeda giduulu giiniikghta nyaawa aniikseaniin, ak ea mameewa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwasin Musa ng'asheanji; gawuurji gidarukusiinda NG'UTAMIIDA, ak gwasin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gabalool fuga Israeli sea Musa, ak gwayeesha, “Ng'ula, aseasa gajeemeewa, gajeeshealana, gajeeshealana eesa sean. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giliwas sih neekiit, neekiisa maheemajeanda NG'UTAMIIDA, gayghami; gajeeshealana eesa sean?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.13"
            ]
          }
        }
      ]
    }
  ],
