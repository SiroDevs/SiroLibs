          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida haw bea jeeda gheeda ghweanda fuga Gohati ea Elisafani orjeeda Usieli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haleanjeeda jea gafur sandakwajeanda gil, ea measa, ea hoorgeeda gheaboong'nyeanda, ea heeda wagiida, sea haleanjeedida bea heeda ghaydit gadiydooscheata aba gadiyoojiga nyaawaan, ea hang'da beashooda, ea gadiyoojiga sean deaschi sea gadiyoojigaaschi sean. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Eliyasari orjeeda Haruneeda was ashoohoocheanda gayghoah siida haweewa fuga hees bea Lawi, ak gayghoah siida jea gagadiiy aba heeda ghaydidiin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
