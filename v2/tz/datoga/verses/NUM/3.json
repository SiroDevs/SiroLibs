          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwalamda NG'UTAMIIDA ak gwayeesha Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Geani buuneeda Lawi gaweay hoorgeeda duweachajeega sean bea fuga Israeli, ea dugwa Lawi gaweay hoorgeeda dugwa nyaawa; ak fiisu bea Lawiin gayghoah buuneedeanyu; aniini geawooschi NG'UTAMIIDA: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 3:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba lealnoodeaba fiisu was bughalaji iyeenya ea laadam ea damasamwagu was duweachajeega Israeli, burdeawa mooneeda fuga Lawiin, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "gaygeani shekeelaji muut aba giliwas uhuumba sih; aba shekeeleeda heeda ghaydit deenyi sea geerahaji diktam, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 3:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea lapiyeeni abit bea fuga silealuun gajadawa Haruni ea orjoagaaschi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghawal Musa lapiyeeda lealnooda, was fuga naawa mooneeda nyaawa dea fuga silealu ea fuga Lawi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gageanda lapiyeeni aba heeda duweachajeega orjooga Israeli; shekeelaji sagalama ea bughalaji samwagu ea laadam ea muut, aba shekeeleeda heeda ghaydit; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "abeeda gaygageanu Musa lapiyeeni bea lealnoodean ak ghoadaw Haruni ea orjoagaaschi, gawuurji sea ng'asheanda NG'UTAMIIDA, gawuurji gidarukusiinda NG'UTAMIIDA Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
              "NUM.3.51"
            ]
          }
        }
      ]
