          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba jeeda fuga Merari gwanda fuga Mahli sea fuga Mushi; suh fuga jih Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak buuneeda siyiitiisa gheanyaawa, aba giteena mooneeda headiga sean, ghang'eada siida sheanagi ghana ghwanaawa, ea sagalamnyooji lah ea bughalaji iyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida haw bea gheeda ghweanda fuga Merari ea Surieli orjeeda Abihaili; suh gayghamway murdeeda maheemajeanda duukusa wiilooda ng'eanyiida ghayeawa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gadiyeeda furiischooda siitaw orjooga Merari ea furooda beehajeega maheemajeanda, ea gharingaaschi, ea daranajeagaaschi, ea sindeetaanyi, ea dabitaanyi sean, ea gadiyoojigaaschi sean; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea daranajeega gireayda neaweesa, ea sindeetaanyi, ea guhuunatkaaschi, ea ghealoonigaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
      ]
