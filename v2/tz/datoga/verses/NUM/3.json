              "NUM.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak fugiga jea gooduuwsa madeeda maheemajeanda duukusa heeda ghayeawa, was madeeda maheemajeanda siroondooscheesa duukusa heeda arearuuna aseetean, gajea suh; Musa gil ea Haruni sea orjoagaaschi, ak gaygafur heeda ghaydit, ea furooda orjooga Israeli; nea rabascheanda jea gwaneekiit gajeabwar ghami. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buuneesean siyiida bea Lawi, ghayi iida Musa ea Haruni aba diigheanda NG'UTAMIIDA, aba jeacheenga nyaawa, headiga sean ng'eada sheanagi ghana ghwanaawa, ea sagalamnyooji diktam ea iyeenya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fuga Lawi gaweay hoorgeeda orjooga was duweachajeega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 3:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwalamda NG'UTAMIIDA ak gwayeesha Musa, “Iita duweachajeega sean was headiga aba jeeda fuga Israeli, ghang'eada dea bea sheanagi ea dea naawa, nyasa mooneeda ea gheawunga nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwalni fuga Lawi aba badaydeanyu aniini Aniini geawooschi NG'UTAMIIDA gaweay hoorgeeda duweachajeega sean aba jeeda fuga Israeli, ea dea dugwa fuga Lawi ak gaweay hoorgeeda duweachajeega dugwa fuga Israeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 3:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwayiida Musa gawuurji gidarukusiinda NG'UTAMIIDA, duweachajeega sean mida jeeda fuga Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duweachajeega sean was headiga aba mooneeda gheawunga nyaawa ghang'eada dea sheanagi ak ghwanaawa, aba jeedeaba fiisu siyiida aba gheanyaawaan, ea sagalamnyooji diktam ea iyeenya ea bughalaji iyeenya ea laadam ea damasamwagu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
