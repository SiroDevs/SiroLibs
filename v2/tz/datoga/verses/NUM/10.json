            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak iissa Iinyo gwarita sandakwajeanda neajeeda, gwayeesha Musa, “Ng'eada, Ea NG'UTAMIIDA, ak ginung' ghwadarda weajoodigaagu; ak ginung' gamng'aw fuga sinyi aba madeadaang'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea iifuuf, gwayi, “Biiksiina, Ea NG'UTAMIIDA, heeda fuga nyiit sagalamnyooji sagalamnyooji bea Israeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
