            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Deaweedeeda siida rat gida nea ghwaak habeawooda nihi, ak ea deaweedeeda haleanjeadaanyi bea ghadooweeda gil jea ghoadaw NG'UTAMIIDA aba giimiinoadaanyi bwaageaw, ea haleanjeeda suurja ammu ghoadaydaan; gawuurji gida rata gida aba gidabeada deaweedeeda giimiinoadaanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ghawooda ashoohoodiga",
          "type": "text"
        }
      ]
    },
