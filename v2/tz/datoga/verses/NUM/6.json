              "NUM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwalamda NG'UTAMIIDA ak goobalool Musa ak gwayeesha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaloola Haruni ea orjoagaaschi ak giyeeshi, Asi gajadawa ghawooda fuga Israeli ak giyeeshi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
