          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea ghwaranyagi, ak geesina giiduupcheeda aba badahuukeagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
