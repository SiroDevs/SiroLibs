          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi oatayda haleanjeeda ghadooweeda sighwarda, ghoah shearooda ng'andit aba heeda NG'UTAMIIDA; heewsu manang'i iyeenya, ea lagweenjeanjagi, ea dayi ispwa bea gisilga was lagweendiga bea gwanyagi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
