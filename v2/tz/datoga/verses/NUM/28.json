          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "gideaba damanamughuush aba giliwas aba giliwas dayeenda gisilleanda, was dayeegiga asispwa bea gisilgean; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
