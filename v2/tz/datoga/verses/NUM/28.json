          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea haleanjeadaanyi bea ghadooweeda was booga was dearanga miyaasiin siikuuyi nagheeda, was gideaba damanamughuushcheew samwagu bea gilo aba giliwas heeyda gideaba damanamughuushcheew iyeenya aba lagweenjeanjagi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
