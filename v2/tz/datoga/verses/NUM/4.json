          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghang'eada siida bea gweanyeew diktam ea damanamughuush ak gwadiyeada, ea ghwahita gweanyeew haradam ea damanamughuush, gajiita, giliwas sih jea gawa jeedeaba gadiyeeni, ak gwasin gadiyeeda maheemajeanda siroondooscheesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
