          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nih gadiyeeda jea gwasin jea ghoah gadiyeeda nyaawa aba jeeda maheemajeanda siroondooscheesa; daranajeega maheemajeanda, ea gharingaaschi, ea daranajeega, ea sindeetaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
