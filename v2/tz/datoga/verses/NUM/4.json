          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea daranajeega hilgweanda jea gwaneaweesa meadajeega sean, ea sindeetaanyi, ea guhuunatka, ea ghealooniga ea haleanjeadaanyi sean ea haleanjeadaanyi suurja sean, ea gadiyeadaanyi sean; ak gaylakiisiina aba gheawunga nyaawa haleanjeeda jea ghwasar. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
          "name": "verse",
