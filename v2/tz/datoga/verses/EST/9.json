              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak goojeaksa barawajeega, fuga Israeli sean mida darooraka apughala ea diktam ea ispwa bea sugoocheanduumeeda Ahasuero, bea ng'asheega hoyyoo ea huumeanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
