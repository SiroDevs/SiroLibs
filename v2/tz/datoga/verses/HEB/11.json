          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu nea nibada ASEETA gidamiy aba badahuukaasa, iidu iisiheeleewi ghanyea maygamajeekcheewiidi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
