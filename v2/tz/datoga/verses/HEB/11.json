              "HEB.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gaydargu naaha? Aba gideaba madeayi damanda aba rukunooda iita Gideoni, Baraka, Samsoni, Yefta, ea dea Dawdi ea dea Samweli ea sibanga– ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea aba naweeda masaweega ghwajoar darooraka, ak ghwanung' eesin gitoabiiw, ak ghwanyas heeleesiinda, ak ghwarat ghuusiga ng'anyeeka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.33",
            "verseOrgIds": [
              "HEB.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gwanuus beasta ng'waan, ak gamng'awa madeeda ng'uta, nea ghwanyas uurda aba jeeda ng'arng'aranda, ak gwandeawa uurda aba jeeda ng'ucheeda, ak ghwanung' gamng'aw lugooda eemoojiga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.34",
            "verseOrgIds": [
              "HEB.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwanyas gadeemga fuga nyaawa duuna miyeeda. Mwaatkwa geesawan, nea ghaheawa ghamwas siksiinda, ak abeeda gwaduutu gicha ak ghwanyas eaweega miyaas. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaatkwa gwasawana aba shikooda ea bayiiga, nea ghabwada geerata munyaloalajeega aba ghealooniga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.36",
            "verseOrgIds": [
              "HEB.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geefuta lagheanga, ak geabwaash nibiyeenya, ak geenuuseada aba ng'uta; ak gwaneayi nea gookwa eagweega gisilga ea gea nooga, ak ea barbari, nea geesawan, nea geesima ng'asheega munyas– ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.37",
            "verseOrgIds": [
              "HEB.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea ng'eanyiida ea magassa fiisu, ak gwaneayeewa eeshtearajeega ea giijeega, ea jeesinga bearuutka ea gwaleadinga jeeda ng'eanyiida.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        }
      ]
    },
