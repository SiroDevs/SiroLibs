          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea sinung' gwaheedu ea ghoadaraam malaykajeega aba gideaba gheawunga ninyas eahaweewa ea ghang'al gea nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
