              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASEETA ghayi goobalool ghweanigaasa aba ghuusiga sibanga aba naweadinga saang'a ea damanyoojiga saang'a; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amadu aba mudeanoodeaba askwearjoojisu goobalooleasa aseasa aba naweeda Orjeeda, ghayi loat ghoah siida jea gwahearan haleanjeeda sean, ak aba niny gwasin ng'eanyiida aba badaydeaba niny. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba niny ghoahiimu weeshinda giigheambiita ASEETA nea gwandeawa giirooraneeda ea seareadaanyi, ak ghwasar ng'eanyiida aba ng'asheandaanyi mideawa uurda. Iing'ata nea nisin giimiinnooda riing'eeda, hean goopteada aba meatkweeda geatinda dugwa bea ASEETA was Ng'utamiida aba hoowa bea dea daliiliin.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hawunda Orjeeda ASEETA",
          "type": "text"
        }
      ]
    },
    {
