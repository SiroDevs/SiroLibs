          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba ninyas ramaseanda aba heanyaawa aba heeda eeneewa:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
