        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gaguursa Yakobo orjoagaaschi, ak gwayeesha, “Asi aghadoawana geat, ak gearukuneegwa gichea gabusseegwa aba askwearjoojiga jea ghwahidu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh dooshin damaniyeenya bea Israeli; ak nih ea girukusa ghweanda nyaawa damanda adawa saawa ghawooda, ak gaba siisi adaw ng'asheega giighata deaschi giliwas sih.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyeeda ea bunyita Yakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghamiin gheanyanga nyaawa nea gwayeesha, “Asi aniini ghwariikghta ghwahidu miyeedeanyu dawa heeda ghweanigeasu; abung'sean heeda ghweanigeasu aba jeeda gwaleeda mida jeeda madamnyeanda Efroni ea eemeeda Hiti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "jeeda gwaleeda mida jeeda madamnyeanda mida Makpela, mida gayeewda Mamre, mida ng'eanyiida Ganaani, ghayi shaah Abrahamu sea madamnyeanda aba heeda Efroni bea eemeeda Hiti ak ghoah daanyi ak ghwanung' ghoah heeda jea eebunyiisa buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoowa geebung'sa Abrahamu ea Sara was gatmoadaanyi; hoowa geebung'sa Isaka ea Rebeka gatmoadaanyi; nea hoowa geabung'si Leya ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "madamnyeanda ea gwaleeda mida jeeda geashaaha heeda eemeeda Hiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'ata nea nimiin Yakobo gheanyanga orjoagaaschi, goodiing'da geeshangaaschi badayda bulaliida, ak ghami, ak gwandeayi sea buuneadaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
          }
        }
      ]
    }
