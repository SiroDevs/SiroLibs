              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 42:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu nea gagulgulda mushoodaka nyaawa, asi ng'ula, giliwas sih gwanda radicheanda lapiyeadaanyi jeeda mushoataanyi; hean daah saawa ea ghwaan radichoojiga lapiya, ghabeal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 42:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda ghweanda nyaawa was Yakobo ak gwayeesha, “Agooga googasayi ahuteawa diibigeasu: Yosefu niroat, ak Simeoni ea mudugwanda, ak ghamneawa gajayaada Benjamini; ak geawooschi siida jea gwasawana.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 42:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwayeesha Rubeni ghwaan, “Abeeda iimeadeelni Benjamini ginuusi orjoogeasu iyeenya; iina geatingeasu ak gaydeadeelu headaang'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 42:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, “Orjeedeanyu majadeayeewana, aba gideaba orjeeda ghaamwat nimi, ak ea sighus niny nea gabageaw. Aba gideaba gwadeepa gabussa gil aba naweeda, nea aniini ea naawaasiichi abeeda giiseaneega jea agoonean gaygwanuusan.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.38",
            "verseOrgIds": [
              "GEN.42.38"
            ]
          }
        }
      ]
