    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda ea Damari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu ghabeawa Yuda heeda orjooga ghaamwat, ak gawa gwandeayi sea siisi siguura Hira, bea mujiineeda Adulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwadaah Yuda aba ng'eanyiita midean hut bea eemeeda Ganaani siguura gheawungaaschi Shuwa; ak ghaghi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "muchu gagweayiit ak gwaji baleanda, ak gaguura gheawungaaschi Eri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gabiikta gagweayiit ak gwaji baleanda, ak gaguura gheawungaaschi Onani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gabiikta gicha gwaji baleanda, ak gaguura gheawungaaschi Shela. Abeeda gwanda ng'eanyiida Gesibu damanda jiila baleanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gageesa Yuda orjeedeanyu was duweacheeda siguura Eri gatmooda, siguura gheawungaaschi Damari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Eri duweacheeda Yuda eamuy seara aba madeeda NG'UTAMIIDA; ak ghabwar NG'UTAMIIDA ghami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Yuda Onani, “Una heeda gatmooda orjeeda geamadu, ak giighiisi hoorgeeda orjeeda geamadu ak ginyaksi orjeeda geamadu diibiga.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu gwajeeng'u Onani gideaba diibiga mayghoah gaaschi; hean iissa iiwea heeda gatmooda orjeeda ghaamwat ghwashoamwa nyasooda diibiga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'asheega sin gamunyiit aba madeeda NG'UTAMIIDA, ak ghabwar eara niny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gwayeesha Yuda Damari was gatmooda orjeeda ghaamwat, “Abiidana masinung'weanduumeeda aba ghaheang'wa, ea gwahisa heeda orjeedeanyu was Shela” aba gideaba ghoawal gideaba gajiidu ghami, gawuurji orjeeda ghaamwat. Hean ghang'eat Damari gawa goobiida gheaghwaan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu ghami gatmooda Yuda was hudeaba Shuwa; iidu nea geegeandeawa Yuda salgheang'da, gawa ng'eanyiida Dimna heeda fugaaschi lajaada buudeega gisilga, nea niny gil sea buweacheandaanyi siguura Hira bea mujiineeda Adulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.12",
            "verseOrgIds": [
              "GEN.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu geerukusa Damari gideaba “gheambasiyeadaang'u nuwa ng'eanyiida Dimna ghwalajaada buudeega gisilgaaschi,” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.13",
            "verseOrgIds": [
              "GEN.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghwayiin ng'eanyi hang'weaka masinung'weanduumeeda, ak gookwealsa uhuudaanyi weasta, ak gookwealshi, ak goopteada aba gidaghuuta naweeda weah Enaimu, mida ghuuta naweeda weah Dimna; aba gideaba Shela nihissa heeda, ak ea miyeataw gatmooda ghaghi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.14",
            "verseOrgIds": [
              "GEN.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean daah Yuda Damari ghwanung' ghoah gili hiseada, aba gideaba gwadukuta uhuudaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.15",
            "verseOrgIds": [
              "GEN.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawa heeda aba ghuuta naweeda ak gwayeesha, “Beeni, nung' doan headaang'u,” aba gideaba mwanala gideaba gatmooda orjeedaanyi. Gwayeesha, “Gaygoonean naaha, iwuni heedeanyu?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda niny ak gwayeesha, “Gaydeaneey ijooda mwanang' aba jeeda noogeasu.” Ak gwayeesha niny, “Gaygoonean gichea dandeawa, ea eani ijooda?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayeesha, “Gigasayi dagoonyi gwadeagoomba naaha?” Ghwasha niny ak gwayeesha, “Goonean ghajijeanda mida gheataang'u, ea bileangida mida geatindaang'u.” Hean ghoadaw ak gawa heeda, ak ghwarada niny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghang'eat ak gawa, ak gageanda weastaanyi akwealsa badayda hang'weakaaschi bea masinung'weanduumeadaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goojeakta Yuda buweacheandaanyi was Hira ghamwaghaada mbooyda ak ghoaghuumu haleanjeeda mideawa gatmooda, ea mwanyasana hiji gatmooda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoanyaash siispa ng'eanyiita nea gwayeesha, “Gwanda yeenu gatmoodida hiseada mida Enaimu abiita ghuuta naweedean?” Hean gwayeesha, “Manda hiji gatmooda hiseada.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gabiikta heeda Yuda ak gwayeesha, “Aniini mwaanyasi gatmooda; ak gwayi buuneedeaba ng'eanyiita, ‘Manda ng'eang'i gatmooda hiseada niibiida hiji.’” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Yuda ak gwayeesha, “Nung'waada gwandeawa gatmooni haleanjeeni ghoah gaaschi, meagassi gideaba gaygabarreeweasa reari buuneeda; ng'ula ghaadaydi mbooyda ak ea minyasani hiji.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean nea ghang'ata sheeh samwagu geeyeesha Yuda, “Damareeda was gatmooda orjeedang'u ghayi gwahiseada; ak ghamneawa ea nidurmwaniit.” Ghwalamda Yuda ak gwayeesha, “Ooruuni, ak ghoaghwardi ghami.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda siiruuna, ghwanung' eeyeasa gheambasiyeadaanyi iita gideaba, “Aniini naanyaschi gweayuumeeda aba heeda siida bea haleanjeeni.” “Geamuscheegwa ang'ula ak ghoadaayi siida bea ghuniin ea ghealooni ea bileangini.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwanal Yuda haleanjeedida ak gwayeesha, “Niny ghoadoabiiw, ghaaraanyi dasin gidamiisean gwachi gaydaadaw orjeedeanyu was Shela.” Ak ea mudu gabiikta Yuda gwandeawa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimuchu nea ghwahita damanda jeata, geejeeng'u gideaba gaygwaji saleahooga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damanda laja, gooruudu akaleala geatinda; ak gageanu deepshoocheanda ak gwarasa geatinda gulbeeda areara nea gwayi, “Nih duweacheeda.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adealda geatindaanyi bwadaw, hean geesheeda eeji orjeeda ghaamwat; ak gwayi deepshoocheanda, “Daaha gidijaati naweadaang'u!” Hean geeguura gheawungaaschi Beresi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwardu orjeeda ghaamwat nea gwanda geatinda gulbeeda areara; ak geeguura gheawungaaschi Sera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        }
      ]
    }
