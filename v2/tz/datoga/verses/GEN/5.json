              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'ata nea niibiida Seti ng'eanyiida gweanyeew bughala ea muut, gwaji Enoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
