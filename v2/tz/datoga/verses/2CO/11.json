          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak geeraraang'daawaan sooscheanda ak geesiigan seawadeeda ghamarda, ak ghaadaraamnyi geatingaaschi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
