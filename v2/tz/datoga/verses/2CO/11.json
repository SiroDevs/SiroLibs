            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimiisean ghwaroodeaba geaw, gaydaghwara geaw haleanjeeda ahiimu ng'arng'arandeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ASEETA was Bwaabeeda Ng'utamiideanya was Yesu, ninyeeda ghayi sibadiischeesa ea ghoah damanda manda muudeanooda, ghwanal gideaba mearukuni ng'uyyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda aba hoowa bea Dameskiin sugoocheanda mida hing'eadayda sugoocheanda haw bea ng'eanyiida Areta abeeda gafur mujiineeda Dameski ak abeeda ghoang'waanyan, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
