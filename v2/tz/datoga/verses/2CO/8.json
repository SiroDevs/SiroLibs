{
  "id": "2CO.8",
  "number": "8",
  "bookId": "2CO",
  "reference": "2 Gorinto 8",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2CO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inyeanda jeeda fuga Gristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga eaduupcheewi, geegasayi anala dagheerjeanduumeeda ASEETA ghayi siihiimu aba jeesinga ganiisajeega Makedoniya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea aba jeeda simsimda ng'waan ea sawanadeeda, hean aba hawunda hooseaneega nyaawa ea barbaranyeeka nyaawa raanya ea nibaruur muuchi nea goobal geat aba meatkweeda nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.2",
            "verseOrgIds": [
              "2CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoadayda aba gida amuusta, ak gaydamuuwu, ea ghwanaawda, aba gidagasiida saawa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.3",
            "verseOrgIds": [
              "2CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "gamuseasa muuchi eataw gheata jea goobareanyi gadiyeani bea weeta fuga ghaydidiin– ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.4",
            "verseOrgIds": [
              "2CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea nih ea mii gidasirardi gil, aba mwadi ghanyi ghoadaw geat Ng'utamiida ea biissa aseasa aba gidagasiida ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.5",
            "verseOrgIds": [
              "2CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu geamiinyi gheang'da Dito nea geegasayi gawuurji gidaghayi bean ghoang'eata, gagasa ghoahiit aba jeedeang'wa gadiyeeni mideawa dagheerjeanduumeedean. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.6",
            "verseOrgIds": [
              "2CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamneawa iyoang'aldi aba haleanjeeda sean aba masaweega, ea rukunooda, ea fughareeda, aba jeeda gurooroosean, ea aba jeeda bariinyeegeagwa aba heedeanya, asikteawana gideaba ghoang'aldi aba gadiyeeni bea dagheerjeanduumeedean.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi gearugu ng'asheanji nea mii gideaba geagoonyi diigheanda, geagasayi asikteawana aba dagheerjeanduumeeda buuneeda suurja ak abeeda bariinyeegeagwa earada gaygaba huumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.8",
            "verseOrgIds": [
              "2CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba noanali dagheerjeanduumeeda Ng'utamiideanya was Yesu Gristo, earapeadi baruuriin, hean ghabwarbwariit aba badahuukeagwa, ak abeeda aba barbarandaanyi ghoahuuyi baruurji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba badaydeaba ng'asheanji gaydagooneegwa badiida: ghwahit muuchi ghamneawa aba heedeang'wa giihiiteaba gidida gweayda heeta ng'ataan ak ea meakghusa sinooda gibwadi gasooda, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.10",
            "verseOrgIds": [
              "2CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi aba gidoowoosti hidaat aba gidoogasiidi gagasa gweateayi sea gidoahiiti aba jeeda haleanjeeda oondeawi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba iinyo gwanda hidooda, abeeda gajeamwas aba gidida mideawa siidean, nea mii aba gidida mandeawanean. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba mearukuni ng'asheesu ak abeeda ghwanyas fuga mwaatkwa hooseaneega nea ghoanyaschi agooga sawanadeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.13",
            "verseOrgIds": [
              "2CO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu aba ng'asheega giiyang'deayeeda aba haleanjeedeang'wa ghamneawa oondeawi saang'a gagasa ghaweat fuga gasa, ak abeeda haleanjeeda saang'a mideawa ghaweadeagwa iyoogasayi, ak abeeda gaygwanda giiyang'deayeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawuurji gissing'oarda gideaba, “Siida awaam ea ghwasaang'ayiit maburda gil, nea dea awaam gea ng'ay mwasuunyeawana gil.”",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dito sea bareandaanyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gagasa eebadiischeesa ASEETA iin jeeda Dito gassoodida eandeawi aniini aba weeteang'wean. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.16",
            "verseOrgIds": [
              "2CO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba niny makghusa ging'ooyda ng'asheandeanya, niny abeeda gagasa muuchi hinnooda heedeang'wa aba uhuudaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.17",
            "verseOrgIds": [
              "2CO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geecheagu niny sea orjeediyya nigeawiit iita aba rukwiideayda Giijasta miy aba jeesinga ganiisajeega seaniin; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.18",
            "verseOrgIds": [
              "2CO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ea meakghusa nih ak ghwahit, niny ghwaloat ganiisajeega ak geanung' eeteayeewana damanda sibeawi eesinana gadiyeedeanya bea bariinyeega, aba giigheambiita Ng'utamiida ak ghoah gwadeagooda gidida miy gasa jeesingaasaan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea meagassi gideaba gaygwarukuna sih badahuukaasa ng'asheega munyas aba badayda giimuusta sigu ak gang'ula gisilachiida haleanjeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.20",
            "verseOrgIds": [
              "2CO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea geesheedi ghanyi eapkaada ng'asheega miyaas, nea mii aba madeeda Ng'utamiida gil ak ghwahit, eara aba madeeda buuneeda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean geecheagu sea saawa orjeediyya nigeawiit eesimsim ak geadaayi gideaba ea hidaat aba haleanjeeda saang'a, ak ghamneawa ea hidaat muuchi ea ghang'alda aba badayda masaweagaaschi adareamshi aba heedeang'wa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.22",
            "verseOrgIds": [
              "2CO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aba iita Dito, niny bareanyeandeanyu ak ea siida easinuudayeewi gadiyeeda aba badahuukeagwa gil; nea gabiissa gagasa iita fuga siduupcheewi, saawa fuga ajeagu ganiisajeega, ak ea giigheambiita Gristo gil. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.23",
            "verseOrgIds": [
              "2CO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi oahiimda aba madeeda ganiisajeega, bariinyeegeagwa ea gissighwardi geat aba badahuukeagwa aba heedeaba fiisu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.24",
            "verseOrgIds": [
              "2CO.8.24"
            ]
          }
        }
      ]
    }
  ],
