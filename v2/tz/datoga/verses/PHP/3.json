{
  "id": "PHP.3",
  "number": "3",
  "bookId": "PHP",
  "reference": "Filipi 3",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
