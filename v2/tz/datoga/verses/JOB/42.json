            }
          ]
        },
        {
          "text": "Hean ghwasha Ayubu ghuuta NG'UTAMIIDA nea gwayeesha:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
