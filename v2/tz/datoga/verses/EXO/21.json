          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "siida bea shoomanda gayghoadoabiiw gayghoadaw siida bea heeyda ghana digeeda lapiya, ak heeydida meahiin gajeadaanyi gil.",
          "type": "text",
          "attrs": {
