          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghana iiloata geeshadeeda soomjeandaanyi was ng'eedeeda ghana gatmooda, abeeda gaygwasiksa soomjeanda gawa aba badayda geeshadeadaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
