              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siida inyas ghwanung'waada shoomanda ghoabwara ghuut ghana ghaghurghur shoomanda ak ea madukuta, ak ghoabita jeeda heeyda ghana digeeda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
