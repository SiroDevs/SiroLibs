        "style": "s1"
      },
      "items": [
        {
          "text": "Shamooghooda gwadukuta maheemajeanda mida madeeda NG'UTAMIIDA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
