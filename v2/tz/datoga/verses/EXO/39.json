          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea weasta miy sirasa uhuuda ea luumbayjeeka miyaas, ea gaptuulajeega miyaasiin sinap muuchi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
