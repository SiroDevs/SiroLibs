        },
        {
          "text": "Ak geesin eara gootajeega miyaasiin sinap, bea Haruni ea orjoagaaschi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
