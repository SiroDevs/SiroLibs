          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goosha gadiyoojiga sean bea maheemajeanda was maheemajeanda siroondooscheesa, ak fuga Israeli gwasinda sean gidarukusiinda NG'UTAMIIDA Musa, ak ea gidasisinda gil. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geeyeadu maheemajeanda heeda Musa, maheemajeanda ea dabitaanyi sean, gifungajeagaaschi, beehajeagaaschi, guhuunatkaaschi, daranajeagaaschi, ea hoorgajeagaaschi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea gisidukuteawa gidaghuuta was eagweega lagweendiga ea gea ghwarayga, ea hang'da beashooda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
