          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ea sandakwajeanda muuwuunooda ea geedigaaschi, ea hoorgeeda baydeayda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
