          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geerasa shiipcheandida bea oormeeda gasa gwatuuduun madeeda weastida bea uhuudean, gawuurji gidarukusiinda NG'UTAMIIDA Musa.",
          "type": "text",
