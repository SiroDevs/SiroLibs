              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Musa ak gwayeesha fuga Israeli, “Daaha NG'UTAMIIDA niguursa aba gheawungaaschi Besaleli orjeeda Uri was ghamaghwaan Huri gil, bea eemeeda Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
