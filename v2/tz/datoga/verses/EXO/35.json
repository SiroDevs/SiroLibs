          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea niidaw niny bareaynata uhuuda ghwanal duwaawi niny ea Oholiyabu orjeeda Ahisamaki bea eemeeda Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
