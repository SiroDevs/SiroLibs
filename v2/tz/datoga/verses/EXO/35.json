          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ghoamu gabeara lagheanga jea eegadiyeata, ea ng'oorda geediga, ea gadiyoojiga sean bea gearinda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
