          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ea ninyiit niny Guroorooda ASEETA, sea weaghuumeeda, ea fughareeda, ea giimuusta, ea gadiyoojiga sean bea gearinda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
