    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghwalamda NG'UTAMIIDA ak gwayeesha Musa, “Una heeda Farao ak giyeeshi niny, ‘Gwayi NG'UTAMIIDA, was ASEETA Ebraniya, “Siksiina fugeasu gaweay gagadiyeesean. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inyas giheawi siksiina saawa gaweay ak giighuumi saawa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.2",
            "verseOrgIds": [
              "EXO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'ula, geatinda NG'UTAMIIDA gaygoobisa badayda haleanjeadaang'u aba dawneeda haw, ak ghoang'waay haleanjeeda mida madamnyeanda, ea faraasajeega, ea digeeniga, ea ngamiyajeega, ea dugwa, ea hawanda nooga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak NG'UTAMIIDA gaygooheeli dugwa fuga Israeli ea dugwa fuga Misri, ak dugwa fuga Israeli ea manda dea jea ghami.”’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata ghwayiin NG'UTAMIIDA damanda, ak gwayi, “Numuji NG'UTAMIIDA gaygwasin ng'asheanji aba badayda ng'eanyiida.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama muchu gwasin NG'UTAMIIDA ng'asheanji; ak gameewa dugwa sean bea fuga Misri, nea dugwa fuga Israeli ea manda dea nimi eara akaleala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goojeakta Farao buuneeda ghoang'wearda asi ng'ula dugwa fuga Israeli manda dea nimi eara akaleala, ak gabiikta ghoahang'waay Farao gurooroadaanyi, ak ea masiksiina buuneeda gaweay.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda NG'UTAMIIDA ak gwayeesha Musa ea Haruni, “Oanyiida baneaguukeagwa deareeda duwayda, ak ea dajakta Musa nea googeal humng'eeda aba madeeda Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gayghoah birjeanda aba badayda ng'eanyiida Misri, ak gayghoah umwang'nyeeka ak ghoang'waay buuneeda ea diyeanga aba ng'eanyiisean bea Misri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.9",
            "verseOrgIds": [
              "EXO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gageanu deareeda duwayda ak geemiinaada aba madeeda Farao ak gageanu Musa gwajakta nea googeal humng'eeda, ak ghoah umwang'nyeeka ak ghoang'waay buuneeda ea diyeanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.10",
            "verseOrgIds": [
              "EXO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fugiga was meangean ea mwamiinaada aba madeeda Musa aba umwang'nyeeka, aba gideaba meanga niing'waay umwang'nyeeka sea fuga sean bea Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.11",
            "verseOrgIds": [
              "EXO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghoahang'waay NG'UTAMIIDA guroorooda Farao ak ea mooleeysiiniit saawa, gawuurji gidarukusiinda NG'UTAMIIDA Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda NG'UTAMIIDA ak gwayeesha Musa, “Ng'eada nea gudea sakteayda duw gil ak gimiinaadi aba madeeda Farao ak giyeeshi niny, ‘Gwayi NG'UTAMIIDA was ASEETA fuga Ebraniya, “Siksiina fugeasu gaweay gagadiyeesean. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba aba damani gaydeajeagu bayiigeasu sean badayda gurooroadaang'u, ea badayda fugaagu bea gadiyeeda ea buuneadaang'u, ak gaynala gideaba manda dea uurjeewanean aba badayda ng'eanyiisean. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.14",
            "verseOrgIds": [
              "EXO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ghamneawa gwachi iyeaheakseey geadi, ak ghaalascheey aba dawni, nea geang'amwaneey badayda ng'eanyiida, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.15",
            "verseOrgIds": [
              "EXO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu aba ng'asheanji ghoah gideagooni eaweega ak ghaahiimneegwa uurdeanyu, ak abeeda geerukwiida gheawungeasu aba badayda ng'eanyiisean ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghamneawa ea gudu aghaambiida geaw aba badayda fugeasu, ak ea migassi siksiina gaweay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ula, numuji damanda uurji nih gaydanung' ghwaroabwan roopta lagheanga haw muuchi manda dea uurji eara heeda ghayi aba ng'eanyiida Misri ea ghoah ghamneawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.18",
            "verseOrgIds": [
              "EXO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ajeakta, eebaru dugwaagu ghoah ea haleanjeeda indeawi sean mida jeeda dareabeeta, aba gideaba gilinyoo ea sih gil ghana haleanjeeda iinyasa roopta lagheanga jeeda dareabeeta nea miyeebaru ghoah, ada abeeda gaygameewa.”’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.19",
            "verseOrgIds": [
              "EXO.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gilinyoo ghoawal ng'asheanda NG'UTAMIIDA aba jeeda fuga gadiyeeda bea Farao hean goojeakta soomjoagaaschi goomng'eawsa dugwaaschi ghoah, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea dea mamanyeewana gil ng'asheanda NG'UTAMIIDA, ghwanung'waada soomjoagaaschi ea dugwaaschi goobiida jeeda dareabeeta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda NG'UTAMIIDA ak gwayeesha Musa, “Miinda geatindaang'u nea giigeali humng'eeda, ak gayghwahidu roopta lagheanga aba ng'eanyiisean bea Misri, ak ghabwar buuneeda ea diyeanga, ea gilinyoo gwanda jeeda madamnyeanda aba ng'eanyiida Misri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.22",
            "verseOrgIds": [
              "EXO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghamiinda Musa geatindaanyi googeal humng'eeda, ak goojeagu NG'UTAMIIDA gighweendandeeda ea roopta lagheanga, ak gwararang'eesa beasta badayda ng'eanyiida. Ak ghwanung' NG'UTAMIIDA gwaroobassa roopta lagheanga ng'eanyiisean bea Misri, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghwaroabwan roopta lagheanga, ea beasta dadamandeeda mwanaawda aba jeeda roopta ea roopta haw bea lagheanga, dea eara heeda ghayi mii ghwaroabwandunu aba ng'eanyiisean bea Misri damanda huweewa eemeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.24",
            "verseOrgIds": [
              "EXO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghabwar rooptida bea lagheangean gilinyo gwanda dareabeeta aba ng'eanyiisean bea Misri, siida ea diyeayda; ghabwar roobi bea lagheangean gilinyo ea booga mida madamnyeanda, ea gwahirjeaweada giliwas geeta mida jeeda madamnyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.25",
            "verseOrgIds": [
              "EXO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geaghus ng'eanyiida Gosheni abiita fuga Israeli miighwaroabwan roopta lagheanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goojeakta Farao buuneeda eeguursa Musa ea Haruni, ak gwayeesha, “Asi ghamneawa aniini geabeayi riing'a; NG'UTAMIIDA ea doabiiwaat, nea aniini ea fugeasu geendi jeeda giidiinyeanda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amusa NG'UTAMIIDA aba gideaba nideay giighweendandeeni ea roobi bea lagheangean, gaydasikseegwa aweayeena, majagudoopiidana hiji.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwalamda Musa ak gwayeesha niny, “Inyas geariti dawa Mujiini, gaydamiinda geatingeasu deageal heeda NG'UTAMIIDA, abeeda gayghwasiinda gighweendandeeda, ak ghwalakta eara roopta lagheanga, ak gaynala gideaba ng'eanyiida gaba NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghaanali gideaba ang'iing'i ea fugaagu bea gadiyeeda, miyoawala NG'UTAMIIDA was ASEETA.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Boosu siguura gitaani ea nganooyda siguura shayiiri, ghabwar rooptida ea gameewa aba gideaba aba damandida shayiiri niheas, nea gitaani gaba deakghweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak duuku ngaano ea booga suurja ea miyeesima gil aba gideaba gudea manang'i.) ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwariteawa Musa gheeh Farao ak gawa Mujiini ak ghamiinda geatingaaschi googeal heeda NG'UTAMIIDA, ak ghwasiinda gighweendandeeda ea rooptida bea lagheangean, ak ea mutghwaroabwan aba badayda ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daah Farao gideaba niisha roopta ea roopta lagheanga ea gighweendandeeda, gabiikta gwasin riing'eeda, ak ghoahang'waay gurooroadaanyi niny ea fugaaschi bea gadiyeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghahang'waanyiit guroorooda Farao ak ea mutgwasiksa fuga Israeli gaweay, gawuurji gidarukuteayda NG'UTAMIIDA aba ghuuta Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
      ]
    }
