          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwadukuta beehajeegiga aba dahaabu, ak gwasissa ghunoojiga nyaawa bea dahaabu ghoah heeda darearjeeka, ak gwadukuta darearjeeka aba dahaabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
