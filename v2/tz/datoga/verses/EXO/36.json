          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwasin gicha hang'da ghuuta maheemajeanda, bea oormeeda gasa gwatuudu ea dea oomu ea dea areara ea hang'da bumbuni miy nap gearnoocheanda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
