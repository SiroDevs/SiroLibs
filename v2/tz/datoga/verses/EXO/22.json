          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak duweachajeega orjoagaagu gaygoonean. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
