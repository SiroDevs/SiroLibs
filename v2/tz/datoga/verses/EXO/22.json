          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Adishing'di eanooga boagaagu bea madeeda ghana nagheeda haghweega saytuunajeega.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        }
