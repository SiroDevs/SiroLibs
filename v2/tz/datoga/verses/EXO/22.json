            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaysindunu eara aba heewgaagu ea gisilgaagu, meayda ghana dayeenda gaygwareer ghaamwat eawooji ispwa, eaweedeaba sis gaygoonean.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
