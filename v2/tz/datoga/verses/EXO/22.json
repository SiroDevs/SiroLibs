          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Siida jea ghoadaw lukghumeeda gilinyoo ea aseecheeka ak ghwanung'waada NG'UTAMIIDA gajeabwar ghami.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        }
      ]
    },
