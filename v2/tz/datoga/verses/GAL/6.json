  "reference": "Galatiya 6",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "GAL 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daba siisi sar sareemba nuut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjoogiyya, iyoadaayi siida nea niibita jeeda riing'eeda asi agoogeeni oowooschi fuga gurooroodean ooteelni siisi aba guroorooda garbabu. Fura geaw, ang'iing'i adiidu geesimnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daba siisi sar sareemba nuut, daba siisi ahiit deaweedeeda Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak siida iiyeesha geaw guwoosi gil, nea mii gili, adagwareengani geaw. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak daba siisi sawsa gadiyeadaanyi nea gabageaw, ak gayghwanyas gichea ghaghwara geaw niny aba gadiyeadaanyi, nea mii hichpa sih nuut gil. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba gaygaba siisi sar sareandaanyi nea gabageaw.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida siinaal ng'asheanda deabareanyi haleanjeeda miyaasiin sean siida anealshi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adeereenganeegwa, ASEETA meereenganna, aba gideaba siida gayghwalach gida wasean ghayi hista. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.7",
            "verseOrgIds": [
              "GAL.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba siida hista ng'asheega aba saseadaanyiin, aba jeeda saseadaanyi gayghwalach munyinda; duuku siidida histeawa gurooroodean, aba jeeda guroorooda gayghwalach eaweega manda muudeanooda. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.8",
            "verseOrgIds": [
              "GAL.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ea adeeburji aba sinooda ng'asheega miyaasiin aba gideaba gajeelaja iihita damanda ii miyeepra. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.9",
            "verseOrgIds": [
              "GAL.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak damani duu eendeawana gheatean eesisiina buuneesean ng'asheega miyaas, ak ghwaraanya fugiga mideawa masaweegean.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miinda gheang'da huuydean ea giighata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ang'ula ng'oorshooni gida aang'oardi nea geaheetu ng'ooruutka ak geang'oorneegwa aba geatindeanyu aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.11",
            "verseOrgIds": [
              "GAL.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh fugiga gasa gideaba gayghoahiimu geediin gil jea gwadiing'seegwa eata ghasmeahooda, aba gideaba ea meesawana saawa aba beehiida Gristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.12",
            "verseOrgIds": [
              "GAL.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eara gea siyaat ghasmeahooda, mwaada geeshta deaweeda, saawa gagasa gideaba gajeayaadeagwa ghasmeahooda, ak ghaghwar geat aba sasanuukeagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.13",
            "verseOrgIds": [
              "GAL.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak aniini ea adaaghwarji geaw aba gida wasean geaghus giigheambiita beehiida Ng'utamiideanya was Yesu Gristo, aba gideaba aba naweani bea beehiidean singoorsa ng'eanyiida badaydeanyu, ak aniini ea singoorsean badayda ng'eanyiida. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.14",
            "verseOrgIds": [
              "GAL.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida eayaat ghasmeahooda ghanea meayaada mii gili, ghana dea miyeayaat ghasmeahooda geegasa ghoah siideesh. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.15",
            "verseOrgIds": [
              "GAL.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoyyoo ea baydeayda gagasa ghwanyas fugiga sean ang'waay deaweedeeni, aba badayda Israeleeda ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidang'eada ghamneawa adagoodeawiidan sih; aba gideaba aniini geandeawi giirooraneeda Yesu aba saseedeanyu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dagheerjeanduumeeda Ng'utamiideanya was Yesu Gristo gagasa goobiida jeeda gurooruunatkeagwa, orjoogiyya. Amin.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
            "verseOrgIds": [
              "GAL.6.18"
            ]
          }
        }
      ]
    }
  ],
