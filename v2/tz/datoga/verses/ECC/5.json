          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adiirabwaasi heeleesiinda ng'asheega.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fura geeshtaang'u iigali gheeda ASEETA; Aba gideaba ghang'wana gineekiidi ak giyiing'shi ghang'al giidaydeayda lukghumeeda leekghleega; mwanala gideaba gwasin ng'asheega munyas. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adirugu ng'asheega leendeeda aba ghuutaang'u, nea gurooroadaang'u ea adaghwalamwach gabalool aba madeeda ASEETA; aba gideaba, ASEETA gwanda humng'eeda, ak gindi ang'iing'i ng'eanyi, asi nung' gang'ayiit ng'asheagaagu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba giirgweatka gweatu gadiyoojiga saang'a; nea nyeashta siitasha gweadu seang'ayda ng'asheega.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ang'iing'i irasi ASEETA gida, ea adiishiing'di giidaydeayda; aba gideaba niny mayghamwas fuga dasheahi; asi, adayda gida iradi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.4",
            "verseOrgIds": [
              "ECC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'wana gideaba miradi gida, mwasamwa gideaba giradi gida ak ea miidaydani. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
              "ECC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adinung'waadi ghuutaang'u ghwanung' goodiiy saseadaang'u; nea adiyeeni aba madeedeaba malaykeeni gideaba gili gwalamseey; aba gideaba ghwasaan inyas gayghwanyareas ASEETA aba nyeashtaang'u, ak ghwadatas gadiyeeda geatingaagu?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba iyahaada giirgweatka, hean ghwasaang'ayiit ng'asheega mwadaagha: Nea ng'asheanda majeek ea gideaba gibwadi ASEETA gil.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eaweega marachi gil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea idaahi nea geesawan siida bwarbwar aba jeeda ng'eanyiida ak geegeanda girgweageeda ea doobiiwnata aba ghwarjeeda aba jeeda ng'eanyiida, adaghahamnyi ng'eanyi aba badaydeaba ng'asheanji; aba gideaba siida haweewa fuga hees ghoang'wearu; ak gwanda fuga hees ea ghang'al saawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba haleanjeeda sean iissa ghwanung' sugoocheanda ghwanyagaada ng'eanyiida sibwar madameega.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida bwariiy lapiya maygwalang'uuda lapiya; ghana siida bwariiy baruureega, ea giiheata haleanjeeda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haleanjeeda iyahaada, ghoahaada eara fuga jea ghwaak; nea seabwa gayghwanyas naaha, majeaghus gideaba gang'ula ghaang' ak ghwahidi?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruweanga siida gadiyeeda aainya, ada ghwaak gilimwanang' ghana ghwaak gilihaw; nea lang'uudadeeda meanang'oocheanda ea moadawa ruweanga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gwanda gidamuy muuchi eadeaksi hing'eadayda aseeta, ak ea nihi, haleanjeeda adiiw siida ak ea mwaweada eara iisawana; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea haleanjeeni gwarooda nea majeeng'na; nea abeeda niny ea niji baleanda, ak ea mandeawana gil aba geatindaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidariteayda aba jeeda ghaamwat, gaygabiikta gicha gawa nea dawiishta gidahitaayda; ak ea mwanyasa gil aba gadiyeadaanyi, ea ghwaat aba geatindaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih ng'asheanda muy muuchi, nea gideaba gidahitaayda ea gichea ghabeada; ak abeeda gwaloosa naaha siida gadiyeesiinda jeameeda? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Askwearjoojigaaschi sean goobiita heeda misana, nea gagiisan muuchi, nea ghabwada geeyooda ea ng'weaniidooda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ula, ng'asheega eayeenyi aniini aamiyaas nea ghwahit, ada gideaba gweagiischi siida nea gwaleeshi, ak goohoosan geaw aba haleanjeeda miyaasiin aba gadiyoojigaaschi sean sin aba hing'eadayda aseeta, aba jeeda eaweagaaschi sean adaw ASEETA; aba gideaba nih gidasiitawi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.18",
            "verseOrgIds": [
              "ECC.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gicha, aba iita gilasih, ghayi adaw ASEETA baruureega ea haleanjeeda, ak ghwanung' ghoamu ghwaak haleanjeeni, ak ghwanyas gidasiitaw, nea gahoosasa gadiyeadaanyi sean sin nih gida adaw ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.19",
            "verseOrgIds": [
              "ECC.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba mayghoapkaat muuchi askwearjoojiga eaweagaaschi; aba gideaba ASEETA gayghoadaw niny hooseaneega aba jeeda gurooroadaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.20",
            "verseOrgIds": [
              "ECC.5.20"
            ]
          }
        }
      ]
    }
  ],
