{
  "id": "JHN.10",
  "number": "10",
  "bookId": "JHN",
  "reference": "Yohana 10",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JHN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gida sigala haghweadoocheanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aba huumwa, aba huumwa, geayeeshiineegwa, siida wassean masiga gidaghuuta ak gawa jeeda gheeda gisilga amadu ghamwaasta ak ghwala nawa nuut, siisi mareanghweanda gil nea gooreedi fih haleanjeeda; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.1",
            "verseOrgIds": [
              "JHN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuku siida weah jeeda gheeda nea gwasik gidaghuuta, siisi haghweadoocheanda gisilga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.2",
            "verseOrgIds": [
              "JHN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iissa gwajeassa furiischoocheanda gidaghuuta; ak iissa ghwayiiy gisilga ghuutaanyi, ak iissa gaguursa gisilgaaschi nea gaba nih guursiina gheawungaaschi ak gooruuta jarooda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.3",
            "verseOrgIds": [
              "JHN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iing'ata giruteayda hean goosheedeawa ak ghwaat geeshta gisilga aba gideaba ghwanal ghuutaanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.4",
            "verseOrgIds": [
              "JHN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayghwaat geeshta rabascheanda gaygamng'aw aba gideaba mwanala ghuusiga rabasta.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.5",
            "verseOrgIds": [
              "JHN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu gwarukuta ng'asheesu awaaghaniin, amadu eamajeeng'na saawa gidida rukusean.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu haghweadoocheanda miy",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.6",
            "verseOrgIds": [
              "JHN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta Yesu gicha ak gwayeesha, “Aba huumwa, aba huumwa, geayeeshiineegwa, aniini geawooschi gidaghuuta gisilga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.7",
            "verseOrgIds": [
              "JHN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga suurja sean ghayi ashooynanean mareanghooga gil ea fuga areedi fih haleanjeeda; ak ea mealeeysiiniit gisilga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.8",
            "verseOrgIds": [
              "JHN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini geawooschi gidaghuuta, siida iiweah gah nea gwasku heedeanyu gajeelealu, gaygawa gah nea gwardu ak abeeda gayghwanyas haghweeda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.9",
            "verseOrgIds": [
              "JHN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mareanghweanda iissa ghwaan gwajagwadiischi nea gwanuus nea ghwadatas; aniini ghaawunyi ghwanyasa eaweega ea ghwanaawda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.10",
            "verseOrgIds": [
              "JHN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini geawooschi haghweadoocheanda miy. Haghweadoocheanda miy iissa ghoaghaashta eaweagaaschi aba badayda gisilga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.11",
            "verseOrgIds": [
              "JHN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siida siitaw gidageatinda mawoosa haghweadoocheanda biissa gisilga ea mii gaaschi, iidaah suuyeanda nea ghwaan, gwanung'usa heeda gisilga ak gamng'aw; ak ghoang'waay suuyeanda ak ghoadaarda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.12",
            "verseOrgIds": [
              "JHN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niny gamng'aw aba gideaba maduupa ng'asheega gisilga aba gideaba niny siida mushaahara gil. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.13",
            "verseOrgIds": [
              "JHN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini geawooschi haghweadoocheanda miy; aniini ghaanali geasu ak eara geasu ghwanalan, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.14",
            "verseOrgIds": [
              "JHN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gidanaldanaan Bwaabwa, ghaanali Bwaabwa; aniini ghaaghashti eaweegeasu aba badahuuka gisilga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.15",
            "verseOrgIds": [
              "JHN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geabiisi dandeawa gisil suuk manda seamoodeaba gheawi; asi eara suh gammiisa gideaba gaydaaghuumu, ak gayghwayiiy ghuuteanyu. Ak abeeda ghoah hawanyeanda agi, ak haghweadoocheanda gajea agi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.16",
            "verseOrgIds": [
              "JHN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba sareani Bwaabwa ghabwariinyan, aba gideaba ghaaghashti eaweegeasu, ak geabiikti dageanu gicha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.17",
            "verseOrgIds": [
              "JHN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manda siida geandeawanean, ghaaghashti aniini aba uhuudeanyu nea gabwageaw. Geandeawi uurda jea daghashtaawa ak geandeawi uurda jea dabiikta dageana; nih gidaghayi adeaganean Bwaabwa sinooda.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.18",
            "verseOrgIds": [
              "JHN.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.18",
            "verseOrgIds": [
              "JHN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gabiikta gicha ghwadarda fuga Yahudi aba badaydeaba ng'asheesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.19",
            "verseOrgIds": [
              "JHN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi fuga saang'a aba jeenyaawa, “Siisi gabearji meangeenda, ak ghabwada nih gaba geas; ghwasaan anda gooleeysiit?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.20",
            "verseOrgIds": [
              "JHN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwayi mwaatkwa, “Ng'asheega sunu maba siida bearji meangeenda. Neada meangeenda ghoamu ghwajaat gheanyanga siida ng'oowi?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu geaheawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda aba hoowa bea Yerusalemuun gwanda ghweelmeeda simwanya gheeda sibata ASEETA; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.22",
            "verseOrgIds": [
              "JHN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea abeeda damandida ea damanda gooroogeeda, nea eara Yesu abeeda gwaneayeewa jeeda gheeda sibata ASEETA heeda was doodooda Sulemani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.23",
            "verseOrgIds": [
              "JHN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gwaneaweesa fuga Yahudi ak gwayeesha, “Gaynung'waada eepiidana jeeda hirbabandeeda ea ghoah eeju? Iiwoosi Gristo nea huumwa gil girukuneasa nea giidaajiidi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.24",
            "verseOrgIds": [
              "JHN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha Yesu nea gwayeesha, “Nigeawiit darukuneegwa ak ea moamwasi. Gadiyoojiga easinyi aba gheawunga Bwaabwa gamuuwunean aniini; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.25",
            "verseOrgIds": [
              "JHN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "iidu ea moamwasi agooga aba gideaba moowoosi gisilgeasu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.26",
            "verseOrgIds": [
              "JHN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gisilgeasu ghwayiiy ghuuteanyu ak ghaanali saawa ak gweadu geeshteanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.27",
            "verseOrgIds": [
              "JHN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "aniini iissa ghaadawji eaweega manda muudeanooda, ak eara saawa ghanyea maygwarooda earahay ea ghoah eaweega manda muudeanooda, nea ghanyea manda siida ammu gageandeawa geatindeanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.28",
            "verseOrgIds": [
              "JHN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwaabeedeanyu, goonan ea haweewa sean, ak ghanyea manda siida ammu gageanda saawa aba geatinga Bwaabwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.29",
            "verseOrgIds": [
              "JHN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniini sea Bwaabwa geawooschi gilagi.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gageanu fuga Yahudi lagheanga nea gajeefta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.31",
            "verseOrgIds": [
              "JHN.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha Yesu nea gwayeesha, “Aniini naahiimneegwa gadiyoojiga saang'a miyaasiin leabu heeda Bwaabwa; abeeda ea aneeda gil aba jeedeaba ng'asheesu jea ghwanung' aftean aba lagheangean?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.32",
            "verseOrgIds": [
              "JHN.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha fuga Yahudi nea gwayeesha niny, “Majeefteey aba gadiyoojiga miyaasiin isinayi, gaygweagu ng'asheagaagu munyas irukusi ASEETA; aba gideaba gisini geaw ASEETA nea guwoosi siida.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghwasha Yesu nea gwayeesha, “Miyeeng'waari aba jeeda deaweedeedeang'wa gideaba, ‘Geayeenyi goowooschi aseecheeka’? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.34",
            "verseOrgIds": [
              "JHN.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda iiguura aseecheeka fugiga ghayi hina ng'asheanda ASEETEAN (nea ng'ooruutka ea mayghwayamwa), ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.35",
            "verseOrgIds": [
              "JHN.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "goobalooli siidida ghayi amiidu Bwaabwa ak goojeagu ghwaan badayda ng'eanyiidean ak gooyeeshi, ‘Girukuni badayda ASEETA ng'asheega munyas,’ aba gideaba geayeenyi, ‘Aniini geawooschi Orjeeda ASEETA’? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.36",
            "verseOrgIds": [
              "JHN.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda iimeasini gadiyoojiga Bwaabwa, ea adoamwaschaan; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.37",
            "verseOrgIds": [
              "JHN.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama easinyi earapeadi moamwasaan ghang'wana ghoamwaschi gadiyoojiga ak abeeda goojeeng'u nea ghoanali gideaba Bwaabwa gwanda jeedeanyu nea geandi aniini jeeda Bwaabwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta Saawa gagasa ghoang'waay amadu gamul aba geatinga nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiikta Yesu gawa giigheawda Yordani heeda ghayi abaatiisaniisa Yohana buuneeda aba mwadi ak goobiida hoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaweay fuga saang'a headaanyi ak geeyeesha, “Yohana miigwasin gwadeagooda, duuku ng'asheega sean ghayi rugu aba badaydeaba siisi ea huumwa gil.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iidu ghamwas fuga saang'a mida hoowa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
      ]
    }
