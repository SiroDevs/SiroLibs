          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "DURUMANATA, gideaba ang'iing'i siiteen durumanataang'u ak guwoosi asasi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
