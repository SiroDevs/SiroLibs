          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "DARDEAYDA, sugoocheanduumeadaang'u nidarda ak geataw fuga Medi ea fuga Ajemi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
