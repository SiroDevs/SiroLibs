              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gidarugu ng'asheega: MOONEEDA gwarugu gideaba eawoojiga sugoocheanduumeadaang'u niyiida ASEETA ak gayghwanung' gamuudean; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
