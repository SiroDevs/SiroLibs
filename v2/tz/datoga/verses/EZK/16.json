{
  "id": "EZK.16",
  "number": "16",
  "bookId": "EZK",
  "reference": "Esekieli 16",
  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
