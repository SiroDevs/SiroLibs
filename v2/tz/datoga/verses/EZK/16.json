              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaydeamajeek neajeedeanyu sea ang'iing'i, ak abeeda gaynala gideaba geawooschi NG'UTAMIIDA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.16.62",
            "verseOrgIds": [
              "EZK.16.62"
            ]
          }
        },
