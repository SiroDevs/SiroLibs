    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giinyahuushooda aba badayda Diro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goobaloolan ng'asheanda NG'UTAMIIDA nea gwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Asi siida, ng'eada anyahuusheena aba badayda Diro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeshiina Diroyda mujiineeda mida ghuuta basooda, ageakshachi sea eemoojiga mida ng'eanyiida neaweesa basooda. Gwayi NG'UTAMIIDA was ASEETA,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Fuga Ajemi ea Ludi ea Butu, abeeda gwanda jeeda lugoadaang'u, nea fugaagu bea ng'ucheeda ghaghasta igeambooda ea ngoofajeanda aba jeadaang'u ak ghoadahaach miyindaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga Arfadi, sea lugoadaang'u abeeda gwanda uhuuda ghamardaang'u meadajeega sean, nea fuga Gamadi abeeda gwanda jeeda madalajeagaagu, ghaghasta igeambooniga nyaawa aba uhuuda ghamardaang'u meadajeega sean, ak ghoahiit alooheadaang'u.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Darshishi abeeda googeakshi aba headaang'u, aba seang'ayda meanang'oocheanduumeeda giliwas aba lapiya, ea gharinyeanda, ea mabwaati, ea ghoolghoolga, googeakshi aba gideaba ghwanyas haleanjeadaang'u sishaayda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga Yunani ea Dubali, ea Mesheki, googeakshi sea ang'iing'i, geatayda siida ea haleanjeeda gharinga oomng'i aba gideaba ghwanyas haleanjeadaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haleanjeadaang'u gishaaydi aba heeda fuga Bet-togarma, ak ginyasi faraaseeda jea gwasareeni haleanjeeda, ea dea ng'ucheeda, ea ngamiya ea digeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga Dedani abeeda fugaagu ageakshi gil, darooraka saang'a bea ghuuta basooda, abeeda naadeadaang'u gil, ak geeyeaneey gujaka beeshta ea masoonjeayeeka, eashaaha haleanjeadaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu abeeda googeakshi aba headaang'u, aba seang'ayda gadiyoojigaagu iisini, gweaneey hang'weaka nyawiiri ea gea oomng'i ea gea sinap muuchi ea hang'weaka bumbuni miyaas, ea gea ng'ooreadi ea gea oomnata gasa ghwahareariit, aba gideaba ghwanyas haleanjeadaang'u sishaayda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda ea gea ng'eanyiida Israeli googeakshi aba headaang'u, gagoonyi ngaano, ea booga manang'i ea maleeda, ea nagheeda ea haleanjeeda ng'andit ghwashaaha haleanjeadaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dameski googeakshi aba headaang'u, aba seang'ayda haleanjeadaang'u. Gagoonyi difaayeeda leabu Helboni, ea buudeega eashish bea gisilga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wedani ea Yafani googeakshi ghang'eada Usali aba haleanjeadaang'u, gharinyeanda siitaay, ea barjoomooda, ea mchaayi, abeeda gwanda jeeda haleanjeadaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dedani abeeda googeakshi aba headaang'u, ak gagoonyi hang'weaka sheayeeda haw, sibatiisa badayda faraasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabajeega ea fuga hees sean bea ng'eanyiida Gedari abeeda googeakshi aba headaang'u, fuga hees gil, aba giigeakshooda dayeega gisilga, ea lagweendiga ea nooga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuga ageakschi sea Sheba ea Rama, abeeda fuga ageakshi aba headaang'u gil, hoorgeeda haleanjeadaang'u gagoonyi nagheeda ng'andit, ea heeluutka lagheanga hees sheaya ea dahaabu siguura dahaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani, ea Gane, ea Adini googeakshi sea Sheba, nea Ashuru ea Gilmadi, abeeda googeakshi aba headaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suh abeeda googeakshi aba headaang'u aba haleanjeeda sheayeeda haw, ea hang'weaka meajea oomng'i nea siitaamdaam, ea sandakwajeega hang'weaka hees sheaya, sirada ghealooda nea geesina gubooyeanda aba jeeda haleanjeadaang'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maleambajeega hees bea Darshishi gwanda jeeda bareandaang'u, aba haleanjeadaang'u.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
      ]
    }
  ],
