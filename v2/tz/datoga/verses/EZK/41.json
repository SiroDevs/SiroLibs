  "reference": "Esekieli 41",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "EZK 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gweanean ea ghwaahiinaan gheeda sibata ASEETA, ak goodeen gidaghuudajeega, baraknataanyi bea jih, geatin lah, meatkweenagi nea hawundaanyi bea jih bea meatkweeda niirja nea hawunda gidaghuudajeega gil. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak hawunda naweeda gal gah abeeda geatin damanamughuush gil, nea naweeda mida murdeeda ea geatin muut gil meatkweenagi ak eara meatkweeda niirja ea geatin muut gil. Ak goodeen geawundaanyi geatin haradam, nea baraknataanyi bea jih geatin diktam.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gawa gah jeeda ghooriida mida gah, ak goodeen gidaghuudajeega naweeda gal gah geatin iyeenya naweeda geatin lah ak baraknata naweeda geatin ispwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak goodeen geawunda ghooriida geatin diktam, baraknataanyi bea jih geatin diktam, madeeda gheeda sibata ASEETA, ak gwayeeshiinean, “Nih heeda ghaydit muuchi gil.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ghoorajeega sideeksa murdeeda gheeda sibata ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goodeen ghamarda gheeda sibata ASEETA, geatin lah, ea baraknata ghoorajeega mida murdeeda, geatin ang'wan nea gwaneaweesa gheeda meadajeega sean. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoorajeega mida murdeedean gwanda geal samwagu geawi gal humng'eeda, akaleala gwanda badaydeaba nuut. Ak gaba gheawi mideawa ghooraji diktam ea damanamughuush ghealoanagi ak gabassa ghealoanagi, nea geenung' gawa jeeda ghamarda gheeda sibata ASEETA, aba gideaba ghoang'waay geat ghoorajeega sean bea murdeeda ak ea mwaang'waanya geat sea ghamarda gheeda sibata ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.6",
            "verseOrgIds": [
              "EZK.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoorajeegiga bea murdeedean gwaheetu jeesin muuchi, aba gidaneaweesiinda gheeda sibata ASEETA aba humng'eeda. Aba gideaba gidaneaweesiinda, gwaneaweesa aba humng'eeda, gwaneaweesa gheeda sibata ASEETA. Ak baraknata gheeda bea jih diita gil eara aba humng'eeda ak gwading'da ghang'eada ghooriida mida ng'eanyi ea ghwahita ghooriida mida humng'eeda nea gwasik naweedida bea bugustean. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean ghaadaay gheedida sibata ASEETEAN, gwandeawa doongulaayeeda lagheaneeda, nea sigatgat meadajeega sean. Ak siindeecheeka ghoorajeega mida murdeeda abeeda muudayeanda majeek gil bea geatin lah. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraknata ghamarda ghoorajeega mida murdeeda bea meatkweeda jarooda gaba geatin muut, ak dageascheeda abit gaba geatin muut was bugusta ghoorajeega mida jarooda ea gheeda sibata ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ghoorajeega furiischoodiga baraknataanyi bea jih gaba geatin diktam nea gwaneaweesa meadajeega sean bea gheeda sibata ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gidaghuudajeegeaba ghoorajeegiga mida murdeedean gwaduukusa dageascheedida abidiin, gidaghuudagi gafuursa wiilooda ng'eanyiida biyeara. Ak baraknata dageascheeda abit abeeda ea geatin muut gil meadajeega sean.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gheeda mida heeda biyeara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gheeda duukusiinyi sea gheeda sibata ASEETA bea heeda biyeara baraknataanyi bea jih geatin laadam ea damanamughuush gil. Ak ghamardeaba gheedida baraknataanyi gaba geatin muut meadajeega sean, nea geawundaanyi gaba geatin seedam ea damanamughuush.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mooneeda sean bea giideenda gheeda sibata ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goodeen gheeda sibata ASEETA, ak geawundaanyi gaba geatin bughala. Ea heeda ghayi sinung'waada ea gheedida sea ghamardaanyi geawundaanyi gaba geatin bughala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.13",
            "verseOrgIds": [
              "EZK.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak baraknata madeeda gheeda sibata ea heeda ghayi sinung'waada was meatkweeda ghayeawa geatin bughala gil. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goodeen geawundeaba gheedida, duukusa heeda ghayi sinung'waadaan mida meatkweeda biyeara sea ghamardaanyi meadajeega sean gaba geatin bughala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iita gheeda sibata ASEETA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea gidingoojiga, ea seawuutka sidukuta ea doodooda mida meadajeega sean bea gealgiga asamwagu geawi gal humng'eedean duukusa gidingoojigean. Ak geayiin badatka geediga meadajeega sean, ghang'eada ng'eanyi ea ghwahita seawuutka ak seawuutka ea sidukuta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea ghwahita uhuuda gidaghuuta ea ghooriida mida gah, ea jarooda, ea uhuuda ghamarda sean bea meadajeega sean, aba jeeda ghooriida mida gah ea dea mida jarooda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geetaamdaamwa geeruubajeanda ea miilayga, miileanjagi gwanda bugusta geeruubajeanda ea geeruubajeanda nuut, ak geeruubajeega gaba nih mideawa gheamamuunat iyeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.18",
            "verseOrgIds": [
              "EZK.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda gwanda gheamamda siida duukusa miileanjagi, ea gheamamda dayeenda ng'adiida duukusa miilayeandeaba iyeenya, asi nih giduurji gil aba meadajeega sean bea gheeda sibata ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada ng'eanyi ea ghwahita uhuuda gidaghuuta, ghamarda gwadukuta geeruubajeanda ea miilayga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
              "EZK.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea gheawi sibata ASEETEAN, huwanga gidaghuudajeagaaschi gooyang'deay.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.21",
            "verseOrgIds": [
              "EZK.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Heeda wagiida sisina geediga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea madeeda heeda ghaydit deestaanyi iisidaa gawuurji gidaghayi bea mwadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.21",
            "verseOrgIds": [
              "EZK.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heeda wagiida abeeda geesina geediga, geawundaanyi gal humng'eeda geatin samwagu gil, ak geawundaanyi ea geatin iyeenya gil ea gujakaaschi ea sindeetaanyi. Ak ghamardaanyi gaba geediga, ak gwayeeshiinean, “Nih measeeda mida madeeda NG'UTAMIIDA gil.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.22",
            "verseOrgIds": [
              "EZK.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gidaghuudajeega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 41:22"
          },
          "items": [
            {
