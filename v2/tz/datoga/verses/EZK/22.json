{
  "id": "EZK.22",
  "number": "22",
  "bookId": "EZK",
  "reference": "Esekieli 22",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
