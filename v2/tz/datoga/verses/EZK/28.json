              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goobaloolan ng'asheanda NG'UTAMIIDA gicha nea gwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.1",
            "verseOrgIds": [
              "EZK.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ea orjeeda siida, eeshiina siida haw bea Diro, gwayi NG'UTAMIIDA was ASEETA,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giibeedeayda sugoocheanda Diro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
