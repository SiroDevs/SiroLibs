        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lachooda ng'eanyiida bea dooshinga fuga Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Suh gheawunga eemoojiga gil, ghang'eada moonghooda wiilooda ng'eanyiida ghayeawa, ak ghang'eada basooda bea naweeda Hetloni, weah ea ghwahita Hamati ea Hasar-enoni, bea moonghooda Dameski, was meatkweeda wiilooda ng'eanyiida neekeewa Hamati, meatkweeda ghayeawa ea meatkweeda biyeara gaygaba gharmucheanjagi bea eemeeda Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea moonghooda Dani ghang'eada meatkweeda ghayeawa ea ghwahita meatkweeda biyeara gaygaba gharmucheanjagi eemeeda Asheri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak moonghooda Asheri, ghang'eada meatkweeda ghayeawa ea ghwahita meatkweeda biyeara gaygaba gharmucheanjagi bea eemeeda Naftali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada moonghooda Naftali bea meatkweeda ghayeawa, ea ghwahita meatkweeda biyeara, gaygaba gharmucheanjagi eemeeda Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada moonghooda Manase bea meatkweeda ghayeawa, ea ghwahita meatkweeda biyeara, gaygaba gharmucheanjagi Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada moonghooda Efraimu bea meatkweeda ghayeawa ea ghwahita meatkweeda biyeara gaygaba gharmucheanjagi Rubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada moonghooda Rubeni bea meatkweeda ghayeawa ea ghwahita meatkweeda biyeara gaygaba gharmucheanjagi Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Heeda siloat bea jeeda ng'eanyiida",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iing'ata heeda eemeeda Yuda abeeda gaysaja ng'eanyiida geatin sagalamnyooji diktam ea muut baraknataanyi ea geawundaanyi. Ghang'eada wiilooda ng'eanyiida ghayeawa ea gagul wiilooda ng'eanyiida biyeara, ak geawunda nih gayghang'eada heeda ghayeawa ea gagul heeda biyeara, gawuurji heeda eemoojiga wassean. Ak bugusteaba ng'eanyiini gaygwanda gheeda sibata ASEETA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea heeda jea saja aba badayda gheeda sibata ASEETA geawundaanyi gajea geatin sagalamnyooji diktam ea muut gil geawundaanyi, ea geatin sagalamnyooji diktam baraknataanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea aba hiji gaygwanda heeda ghaydit bea ashoohoodiga. Meatkweeda wiilooda ng'eanyiida ghayeawa geawundaanyi gajea geatin sagalamnyooji diktam ea muut gil, ak meatkweeda biyeara hawundaanyi gajea geatin sagalamnyooji damanamughuush gil, nea meatkweeda ghayeawa hawundaanyi ea geatin sagalamnyooji damanamughuush, ak meatkweeda wiilooda ng'eanyiida biyeara geawundaanyi gajea sagalamnyooji diktam ea muut gil nea heeda ghaydit bea NG'UTAMIIDA gaygwanda bugustaanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwanda heeda ashoohoodiga was orjooga Sadoki, ghayi siikghaydiit ak gwasin gadiyeedeanyu ak saawa ea mii ghaheawanaan aba damanda heawanaan fuga Israeli. Gawuurji gidaheawata fuga Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak nih gajea heeda sisaji jea goobiida saawa bea heeda ghaydit bea ng'eanyiida, was heeda ghaydit muuchi ak gwaduukusiinyi sea ng'eanyiida fuga Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga Lawi heechea goobiida gajea wiilooda ng'eanyiida biyeara, bea ashoohoodiga. Ak ng'eanyiini geawundaanyi gajea geatin sagalamnyooji diktam ea muut gil. Ak hawundaanyi gajea geatin sagalamnyooji damanamughuush gil ak geawunda sean gajea geatin sagalamnyooji diktam ea muut gil, baraknataanyi ea sagalamnyooji damanamughuush. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'eanyiini ea manda heeda jea eashaayda, nea mwajeayam nea manda siida jea eataw booga madeeda, aba gideaba ea ghaydit aba NG'UTAMIIDA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hooweani abit aba ng'eanyiida sisachiin, gaba geatin sagalamnyooji muut, baraknataanyi nea geawundaanyi gaba geatin sagalamnyooji diktam ea muut, ea heeda jea eegadiyeata bea mujiini ea heeda jea eepiida ea heeda madameega. Nea bugusta gaygwanda mujiini; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak nih ea gichea eeteenda gil, wiilooda ng'eanyiida ghayeawa geatin sagalamnyooji ang'wan ea muut. Wiilooda ng'eanyiida biyeara geatin sagalamnyooji ang'wan gil ea muut, meatkweeda ghayeawa ea sagalamnyooji ang'wan gil ea muut, meatkweeda biyeara ea sagalamnyooji ang'wan gil ea muut. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak mujiini gaygwanda ng'eanyiida bwara, wiilooda ng'eanyiida ghayeawa gajea geatin bughalaji iyeenya gil ea haradam ea damanamughuush, meatkweeda wiilooda ng'eanyiida biyeara gajea geatin bughalaji iyeenya gil ea haradam ea damanamughuush meatkweeda ghayeawa gajea bughalaji iyeenya gil ea haradam ea damanamughuush, meatkweeda biyeara ea bughalaji iyeenya gil ea haradam ea damanamughuush. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea heeda jea ghoabit iihit deesta heeda ghaydit, abeeda gajea geatin sagalamnyooji damanamughuush gil, heeda ghayeawa, ak meatkweeda biyeara eara gajea geatin sagalamnyooji damanamughuush gil. Ak gaygwadeenyi sea heeda ghaydit, nea boagaaschi gajea hamita fuga sin gadiyeeda aba mujiini gil. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fiisu gadiiyi aba mujiiniin bea eemeeda sean bea Israeli, abeeda gayghabwar ng'eanyiini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'eanyiida sean heeda jea saja was heeda ghaydit ea mujiini gaygooyang'deay, gajea geatin sagalamnyooji diktam gil ea muut, meadajeega sean.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak ng'eanyiida heeda abit bea meadajeega sean bea heeda ghaydit ea dea mujiini gaygaba siida haw. Ghang'eada geatin sagalamnyooji diktam ea muut, bea moonghoodean ghayeawa ea meatkweeda biyeara bea geatin sagalamnyooji diktam ea muut, suh gaygaba siisi hawiin. Nea heeda ghaydit bea gheeda sibata ASEETA gaygwanda bugusta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghang'eada gicha ng'eanyiida fuga Lawi, ak ghang'eada mujiini aba gideaba gwanda bugusta ng'eanyiida siida haw, bugusta moonghooda Yuda ea moonghooda Benjamini gaygaba siida haw.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng'eanyiida eemoojiga suuk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eemoojiga abit gajeelakiisiindunu ng'eanyiida nyaawa, fuga Benjamini gajeataw gharmucheanjagi ng'eanyiida ghang'eada heeda ghayeawa ea gagul heeda biyeara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea ng'eanyiida duuksiinyi sea ng'eanyiida Benjamini ghang'eada meatkweeda ghayeawa ea gagul meatkweeda biyeara gharmucheanjagi gaygaba eemeeda Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'eanyiida duuksiinyi sea ng'eanyiida Simeoni, ghang'eada meatkweeda ghayeawa ea gagul meatkweeda biyeara gharmucheanjagi gaygaba eemeeda Isakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ng'eanyiida duuksiinyi ea ng'eanyiida Isakari, ghang'eada meatkweeda ghayeawa ea gagul meatkweeda biyeara gharmucheanjagi gaygaba eemeeda Sabuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'eanyiida duuksiinyi sea ng'eanyiida Sabuloni ghang'eada meatkweeda ghayeawa ea gagul meatkweeda biyeara gharmucheanjagi gaygaba eemeeda Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'eanyiida duuksiinyi sea ng'eanyiida eemeeda Gadi ak gagul wiilooda ng'eanyiida biyeara ea ghwahita mujiineeda Damari ak gawa eenda Meriba-gadeshi ea ghwahita ghealooda Misri, bwak ea ghwahita basooda haw. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak nih ea ng'eanyiida jea alakiisiina fuga Israeli gil, gwahearan, ak suh ea gharmucheeka nyaawa gil gwarugu NG'UTAMIIDA was ASEETA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gidaghuudajeega Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nea mujiineeda Yerusalemu gaygwanda ghamarda jea gwanda gidaghuudajeega jea eesik iisiweay gah, ea gea jea eesik iisirita. Geawunda ghamarda bea meatkweeda wiilooda ng'eanyiida ghayeawa gaygaba geatin sagalamnyooji ang'wan ea bughalaji muut iisiiteen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak gaygwanda gidaghuudaji samwagu gidaghuuta Rubeni, ea dea Yuda ea dea Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamarda meatkweeda ghayeawa geawundaanyi iisiiteen gajea geatin sagalamnyooji ang'wan gil ea bughalaji muut, ea gidaghuudaji samwagu, gidaghuuta Yosefu, ea dea Benjamini, ea dea Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamarda wiilooda ng'eanyiida biyeara geawundaanyi iisiiteen gajea geatin sagalamnyooji ang'wan gil ea bughalaji muut, ak gaba gidaghuudaji samwagu, dea Simeoni, ea dea Isakari, ea dea Sabuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghamarda meatkweeda biyeara geawundaanyi gajea geatin sagalamnyooji ang'wan gil ea bughalaji muut. Ak gaba gidaghuudaji samwagu, dea Gadi ea dea Asheri, ea dea Naftali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geawunda sean bea ghamarda meadajeega sean asang'wan iisineaweesa gaygaba geatin sagalamnyooji damwan sis. Ak gheawunga mujiini ghang'eada eaweedida geeguura, “NG'UTAMIIDA gwanda hiji.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
