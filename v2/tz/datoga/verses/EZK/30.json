          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gwayi NG'UTAMIIDA was ASEETA,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
