            "number": "9",
            "style": "v",
            "sid": "EZK 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ak eaweecheanji gaydeajeakta buuneeda goomuuw fuga Gushi ghayi hinda geat gideaba gaba seayu, ak gaygaboodani eaweeda jea ealasa uhuuda fuga Misri, aba huumwa eaweecheanji ghwahidu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
