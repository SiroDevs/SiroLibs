          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean goobaloolan gicha ng'asheanda NG'UTAMIIDA nea gwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.1",
            "verseOrgIds": [
              "EZK.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ea orjeeda siida, ramoora nea giyeeshi, gwayi NG'UTAMIIDA was ASEETA,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
