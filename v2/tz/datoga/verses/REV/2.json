              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea fuga mida jeedeang'wa aba ng'eanyiida Diyatira, was fuga moang'waanya giinealshooniin, fuga mwanala gidaguura buuneeda mwaatkwa haleanjeeda sheagi jih bea Shataani, aba heedeang'wa gaydayi, mwaydayiin badahuukeagwa sareenda nuut; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ghusa ging'ooyda gida indeawi, ea dahidu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea siida jooriischi ak ghoang'waay gadiyoojigeasu ea ghwahita huuydeanda, gaydanung' goombal fuga eemoojiga, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "REV 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gayghoahaaghwiida saawa bileangida gharinyeanda, gawuurji gidiisa ghwanyarda haleanjeeda sisna sigeeda ak ghoah banajanga, gwasunu eara aniini naanyaschi uurda leabu heeda Bwaabwa; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
              "REV.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "REV 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak gaydaadaw miing'weandida bea muchuunoodean. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.28",
            "verseOrgIds": [
              "REV.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "REV 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilinyoo googar iita, dayiinya ng'asheanji rukusa Guroorooda ganiisajeegean.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.29",
            "verseOrgIds": [
              "REV.2.29"
