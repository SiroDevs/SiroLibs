          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rukusiina buuneeda ng'asheesu, reekusiina nea giiwoowsi aba gheambalmeeda indeawi sean. Ak ea adiidu gafoolnyi siida.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
              "TIT.2.15"
            ]
          }
        }
      ]
    }
