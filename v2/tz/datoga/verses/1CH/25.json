          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damanamuut Yeremoti, ea diibigaaschi, ea orjooga ghaamwat, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.22",
            "verseOrgIds": [
              "1CH.25.22"
            ]
          }
        },
