          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damwalah Hananiya, ea diibigaaschi, ea orjooga ghaamwat, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.23",
            "verseOrgIds": [
              "1CH.25.23"
            ]
          }
        },
