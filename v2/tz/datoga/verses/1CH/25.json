          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba diktam ea iyeenya Gidalti, ea diibigaaschi, ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.29",
