          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damasamwagu Shebueli, ea diibigaaschi ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.20",
            "verseOrgIds": [
              "1CH.25.20"
            ]
