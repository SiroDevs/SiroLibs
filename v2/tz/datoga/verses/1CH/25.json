          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba diktam ea agi Hotiri, ea diibigaaschi, ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.28",
            "verseOrgIds": [
              "1CH.25.28"
            ]
          }
        },
