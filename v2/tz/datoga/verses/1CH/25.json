          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damanang'wan Matitiya, ea diibigaaschi ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
            "verseOrgIds": [
              "1CH.25.21"
            ]
