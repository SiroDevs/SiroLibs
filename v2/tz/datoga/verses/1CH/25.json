            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba diktam Eliata, ea diibigaaschi, ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.27",
            "verseOrgIds": [
              "1CH.25.27"
            ]
          }
        },
