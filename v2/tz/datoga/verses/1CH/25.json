          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damasis Hanani, ea diibigaaschi, ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.25",
            "verseOrgIds": [
