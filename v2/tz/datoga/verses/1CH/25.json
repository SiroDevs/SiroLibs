          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damanispwa Yoshbekasha, ea diibigaaschi, ea orjooga ghaamwat; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.24",
            "verseOrgIds": [
              "1CH.25.24"
            ]
