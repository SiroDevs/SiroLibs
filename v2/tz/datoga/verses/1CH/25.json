          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damashageash Maloti, ea diibigaaschi, ea orjooga ghaamwat ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.26",
            "verseOrgIds": [
