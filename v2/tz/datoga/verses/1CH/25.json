          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damaniyeenya Hashabiya, ea diibigaaschi ea orjooga ghaamwat, ea damaniyeenya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
            "verseOrgIds": [
              "1CH.25.19"
            ]
          }
        },
