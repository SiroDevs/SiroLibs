{
  "id": "1CH.24",
  "number": "24",
  "bookId": "1CH",
  "reference": "1 Damanyoojiga 24",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "1CH 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gadiyeeda siiteaga ashoohoodiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi gadiyoojiga orjooga Haruni suh. Orjooga Haruni: Nadabu gil ea Abihu, ea Eliyasari, ea Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea Nadabu ea Abihu goosheedeawa ghwaan miyeeda, nea mandeawana diibiga, ak ghoah Eliyasari ea Itamari ashoohoodiga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu Dawdi ak ghoadaarda jeacheenga Haruni ak gaba nih adaw gadiyeeda nea gaweechi sea Sadoki bea jeata Eliyasari, gaweechi Ahimeleki, bea jeata Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak geanyasa fuga hees orjooga Eliyasari mawuurji gea jeeda orjooga Itamari, ak gealajaada gaba geen sis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gealajaada nea gealooda geat; aba gideaba gwanda fuga hees bea heeda ghaydit ea fuga hees bea ASEETA aba jeeda orjooga Eliyasari ea orjooga Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ata gageanu ng'oorshoocheanda siguura Shemaya was orjeeda Netaneli, bea eemeeda Lawi, ak ghang'oar saawa aba madeeda sugoocheanda, ea madeeda fuga hees, ea Sadokeeda was ashoohoocheanda, ea Abimeleki orjeeda Abiyatari, ea fuga hees bea gealga ghweaniga nyaawa was ashoohoodiga ea gea Lawi; ak gealoat gheawagi bea ghwaan was Eliyasari ak gealoat agi jea gaba Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hean gealoat aba mwadi Yehoyaribu, nea deaba iyeenya gealoat Yedaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.7",
            "verseOrgIds": [
              "1CH.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba samwagu gealoat Harimu, deaba ang'wan gealoat Seorimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.8",
            "verseOrgIds": [
              "1CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba muut gealoat Malkiya, deaba lah gealoat Miyamini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.9",
            "verseOrgIds": [
              "1CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba ispwa gealoat Hakosi, deaba sis gealoat Abiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.10",
            "verseOrgIds": [
              "1CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba shageash gealoat Yeshuwa, deaba damanamughuush gealoat Shekaniya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.11",
            "verseOrgIds": [
              "1CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damanagi gealoat Eliashibu, deaba damaniyeenya gealoat Yakimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.12",
            "verseOrgIds": [
              "1CH.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damasamwagu gealoat Hupa, deaba damanang'wan gealoat Yeshebe-abu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.13",
            "verseOrgIds": [
              "1CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damanamuut gealoat Bilga, deaba damwalah gealoat Imeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.14",
            "verseOrgIds": [
              "1CH.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damanispwa gealoat Hesiri, deaba damasis gealoat Hapisesi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.15",
            "verseOrgIds": [
              "1CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba damashageash gealoat Betahiya, deaba diktam gealoat Yeheskeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.16",
            "verseOrgIds": [
              "1CH.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba diktam ea agi gealoat Yakini, deaba diktam ea iyeenya gealoat Gamuli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.17",
            "verseOrgIds": [
              "1CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "deaba diktam ea samwagu gealoat Delaya, deaba diktam ea ang'wan gealoat Maasiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.18",
            "verseOrgIds": [
              "1CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nih gadiyeeda nyaawa jea gwasina ak gaweay jeeda gheeda NG'UTAMIIDA aba gisirukusiinda aba geatinda ghweanda nyaawa was Haruni, gawuurji gidarukusiinda NG'UTAMIIDA was ASEETA Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gidabeada fuga Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea suh ea jeacheenga suuk bea Lawi: Baleanjagi bea jeata Amramu geeguura Shubaeli; nea dea Shubaeli geeguura Yedaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gea Rehabiya: gea orjooga Rehabiya, Ishiya dea was siida hawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dea dooshta Ishari: gwaji Shelomoti; nea dea jeata Shelomoti, ea Yahati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.22",
            "verseOrgIds": [
              "1CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjooga Hebroni: Yeriya siida hawi, deaba iyeenya ea Amariya, deaba samwagu Ya-asieli, deaba ang'wan Yekameyamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dea jih Usieli, geeguura Mika; dea jih Mika geeguura Shamiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjeeda geenyea Mika gwaji Ishiya; nea Ishiya gwaji Sekariya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjooga Merari: Mahli gil, ea Mushi. Orjeeda Yaasia: geeguura Beno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjooga Merari: gea Yaasia, Beno gil, ea Shohamu, ea Sakuri ea Ibri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dea Mahli: Eliyasari ak ea mii gwaji diibiga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
              "1CH.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orjooga Gishi: Yerameli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
              "1CH.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nea orjooga Mushi: Mahli, ea Ederi ea Yeremoti; suh Lawi aba gidabeada dooshinga ghweaniga nyaawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eara suh gealoat, gawuurji orjooga geanyaawa was orjooga Haruni aba madeeda sugoocheanda was Dawdi, ea madeeda Sadoki ea Ahimeleki, ea madeeda fuga heeda aba gealga nyaawa, was ashoohoodiga ea fuga Lawi, ghang'eada orjeeda haw ea ghwahita dea mwanang'.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.25",
