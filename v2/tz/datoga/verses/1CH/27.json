              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeeda Yonatan was orjeeda ghamagheamata Dawdi, siida ghuuta Dawdihi, ak ea siida mideawa fughareeda, ak ea ng'oorshoocheanda. Yehieli orjeeda Hakmoni abeeda gwandeawa sea orjeeda sugoocheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
