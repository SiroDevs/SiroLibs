          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nea Ahitofeli ea siida ghuuta sugoocheanda; nea Hushayi, bea eemeeda Arki, ea siida rooroochi sugoocheanda; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
