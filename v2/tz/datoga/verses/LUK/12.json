          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba huumwa geayeeshiineey mayriteawana ghealooniga ea eaghus ea niidaydi heelajeanda huuydean.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.59",
