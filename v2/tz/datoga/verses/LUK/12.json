              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghwasaan anda agooga moamuusi alaja girgweageedeang'wa nea goobeayi geadi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.57",
            "verseOrgIds": [
              "LUK.12.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 12:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba gideaba iideayeewi siida ahaaktaneey madeeda siida laja girgweaguutka, hiji duu andeewana naweedean ghang'wana gooduupchi ada ghwaanyi ea ghoahiitaneey madeeda siida laja girgweaguutka, ak ghwayiinyi siida laja girgweaguutka geatinga shirikarajeanda ak gwajakseey shirikarajeanda ghealooniga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.58",
            "verseOrgIds": [
              "LUK.12.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
