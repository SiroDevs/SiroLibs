                "loc": "ACT.17.1"
              },
              "items": [
                {
                  "text": "Bik 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tughandiikira Ekikunsu eky'Abaikiriza mu Kurisito abali e Thessalonika, aba Katonda Lata ni Musengwa Yesu Kurisito.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda Lata waife ni Musengwa Yesu Kurisito abaghe enkabi n'emiraala.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboluganda, tuli n'okusiima Katonda buli kaseera olwa imwe, era nga bwe tugwaine kuba okwikiriza kwaimwe kuli kweyongera inho. Era n'okugonza kiisi mulala ku imwe kw'agonzaamu abandi kwona kweyongera inho. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ife beene kye tuva ni tuwulira nga twesiimye n'imwe, mu Bikunsu eby'Abaikiriza mu Kurisito ebya Katonda, olw'okuguma n'okwikiriza bye muli nabyo mu kukirigibwa n'okudaazibwadaazibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kyoleka nga Katonda bw'asalira abantu omusango mu butuufu. Ng'era olumaliira muligwanira okuba mu Bwakyabazinga bwa Katonda bwe muli kudaagirira. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.5",
            "verseOrgIds": [
              "2TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Katonda aja kukola ekituufu: aja kuleetera abo ababadaazadaaza badaagedaage, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.6",
            "verseOrgIds": [
              "2TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "era ife ghalala n'imwe abadaagadaaga alitugha okwesiima. Kino alikikola, Yesu lw'aliva mu igulu ni yeeyoleka ni bamalaika be abakola eby'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.7",
            "verseOrgIds": [
              "2TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliidha n'omuliro ogwaka, yaaleetera abatatya Katonda n'abatagondera Mawulire Malungi aga Musengwa waife Yesu, okudaagadaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.8",
            "verseOrgIds": [
              "2TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibonerezo kye balifuna kya kuzikirira, na kubingibwa mu maiso ga Musengwa aghali ekitiisa kye eky'amaani.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.9",
            "verseOrgIds": [
              "2TH.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.10"
              },
              "items": [
                {
                  "text": "Isa 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.9",
            "verseOrgIds": [
              "2TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kiribaagho ku lunaku olwo lw'aliidha, abatuukirivu be ni bamugha ekitiisa, ni boonaboona abamwikiriza bamusaaka. Mwena muliba mu abo kuba mwaikiriza ebyo bye twabakobera.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kye tuva ni tubasabira buliidho ye Katonda waife, mu buyinza bwe abafuule abagwaniire okwetebwa kwe, atuukirize ebirungi byonabyona bye muba musazeegho okukola era n'ebikolwa byonabyona eby'okwikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.11",
            "verseOrgIds": [
              "2TH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo eriina lya Musengwa waife Yesu ligheebwe ekitiisa mu imwe, era mwena mufunire ekitiisa mu oyo, olw'ekisa kya Katonda waife ni Musengwa Yesu Kurisito.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.12",
            "verseOrgIds": [
              "2TH.1.12"
            ]
          }
        }
      ]
    }
  ],
