            }
          ]
        },
        {
          "text": "Ninze Paulo, ni Siluvano, ni Timotheo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
