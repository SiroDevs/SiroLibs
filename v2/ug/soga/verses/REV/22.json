              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye embwa, n'abalogo, n'abenzi, n'abatemo n'abasinza ebyo ebitali Katonda, n'abaguya, baliba kuliya.",
          "type": "text",
          "attrs": {
