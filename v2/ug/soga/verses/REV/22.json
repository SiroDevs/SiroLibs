            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba nkabi abo abaamula ebivaalo byaibwe. Baligheebwa obukumu okulya ebibala eby'omuti ogw'obulamu, era n'okwingira mu kibuga nga babita mu miryango.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
