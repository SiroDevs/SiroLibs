        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika asooka yaafuuwa eigwala lye, omugozi n'omuliro nga bitabwirwamu n'omusaayi byamagala ku nsi. Ekitundu kirala kirala ku buli bitundu bisatu eby'ensi kyaya, n'ekitundu kirala kirala ku buli bitundu bisatu eby'emiti kyaya, era n'eisubi eibisi lyonalyona lyaya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
