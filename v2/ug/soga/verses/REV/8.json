            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika owokuna yafuuwa eigwala lye. Ekitundu kirala kirala ku buli bitundu bisatu eby'endhuba, n'ekitundu kirala kirala ku buli bitundu bisatu eby'omwezi, n'ekitundu kirala kirala ku buli bitundu bisatu eby'emuunienie byakubwa; olwo kyaba nti ekitundu kirala kirala ku buli bitundu bisatu eby'obutangaavu bwabyo kyafuuka nzikiiza. Ekitundu kirala kirala ku buli bitundu bisatu eby'olunaku, n'ekitundu kirala kirala ku buli bitundu bisatu eby'obwire, byaba nzikiiza.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
