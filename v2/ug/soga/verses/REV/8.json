            "sid": "REV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho bamalaika omusanvu abaali n'amagwala omusanvu beetegeka okugafuuwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        }
