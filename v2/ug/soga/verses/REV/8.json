              "attrs": {
                "loc": "EXO.9.23+EXO.9.24+EXO.9.25"
              },
              "items": [
                {
                  "text": "Kuv 9:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Ezek 38:22",
                  "type": "text"
                }
              ]
            }
