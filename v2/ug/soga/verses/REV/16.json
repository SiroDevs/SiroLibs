          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emizimu emibi egyo gyasololeza bakyabazinga mu kifo ekyetebwa Arimageddo mu Luheburayi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
