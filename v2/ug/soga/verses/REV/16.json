          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bona, ndidha kwidha ng'omwibi! Wa nkabi oyo asigala ng'ali kumoga, n'akuuma ebivaalo bye, alobe kutambula madu, na kuswala mu bantu.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
