              "type": "text"
            }
          ]
        },
        {
          "text": "ate era omulamu. Nali nfiire, aye mperaano ndi mulamu ebyanda n'ebyanda, era nfuga okufa n'amagombe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
