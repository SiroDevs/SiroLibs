          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mperaano ghandiika by'obona ebirigho, n'ebiribaagho ye bwidha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
