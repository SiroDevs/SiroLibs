            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninze Yoanne muganda waimwe era Mukurisito munaimwe, agabanira aghalala n'imwe ku kudaazibwadaazibwa ni ku Bwakyabazinga bwa Kurisito era ni ku kuguminkiriza mu kudaazibwadaazibwa. Nateebwa ku kizinga ekyetebwa Patumo nga nangibwa okwegeresa abantu ekibono kya Katonda n'olw'okuba omudhulirwa wa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku lwa Musengwa, Mwoyo yandidhaku, naawulira e mugongo wange amamiro ag'amaani nga gali ng'oti ndeka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaakoba gati: “By'obona bighandiike mu kitabo okigheereze Ebikunsu eby'Abaikiriza mu Kurisito bino: eky'Efeso, eky'e Simuruna, eky'e Perugamo, eky'e Thuyatira, eky'e Sarudi, eky'e Filadelufia, n'eky'e Laodikea.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naagaluka okubona ali kwogera ninze. Bwe nagaluka, naabona ebikondo by'entaala musanvu ebya zaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghagati mu bikondo ebyo, nabonamu afaanana ng'oti mwana wa muntu ng'avaire ekivaalo ekituuka ku bigere, era nga yeesibye mu kifuba olusibiro olwa zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutwe gwe n'enviiri byali bitukula ng'oti biviiri bya ntaama ebyeru, nga byeru ng'oti mugozi. Amaiso ge nga gaaka ng'oti muliro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
