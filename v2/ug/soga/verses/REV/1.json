            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurisito oyo atugonza era eyatunaazaaku ebibi byaife n'omusaayi gwe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaatufuula obwakyabazinga, era yaatufuula bakabona ba Katonda Ise. Agheebwenga ekitiisa n'obuyinza ebyanda n'ebyanda. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        },
