          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Aghanga Ebintu Byonabyona akoba ati: “Ninze Alufa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "Alufa:",
              "type": "text"
            },
            {
              "text": "Nukuta etoolererwaku mu walifu ow'olulimi Olugureki",
              "type": "text"
            }
          ]
        },
        {
          "text": " ni Omega ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "Omega:",
              "type": "text"
            },
            {
              "text": "Nukuta ekoobera mu walifu ow'olulimi Olugureki",
              "type": "text"
            }
          ]
        },
        {
          "text": " entoolo era Enkomerero, aligho, eyaligho era aliidha.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
