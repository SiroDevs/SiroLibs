          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona, wuuyo aliidhira ku bireri! Abantu boonaboona balimubona, era n'abo abaamufumita balimubona. Abantu boonaboona ku nsi baligegenga ku lulwe. N'ekyo. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
