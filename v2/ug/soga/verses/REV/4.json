                "loc": "EZK.1.22"
              },
              "items": [
                {
                  "text": "Ezek 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "5—10",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "10:14",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate okwezungulula ekityamo ekyo, ku buli luuyi lwakyo, ng'eriyo ebitonde ebiramu bina, nga biidhwire amaiso emberi n'einhuma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitonde ekiramu ekisooka kyali kiri ng'oti mpologoma ekyokubiri nga kiri ng'oti nte nume ekyokusatu nga kyakula mu maiso ng'oti muntu ekyokuna nga kiri ng'oti nkookooma eri kuguluka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kirala ku bitonde ebiramu ebyo ebina nga kiri n'amaghagha mukaaga. Era nga ebitonde ebiramu ebyo biidhwire amaiso ku ngulu ni munda. Omusana n'obwire nga tibirekera kwemba biti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
