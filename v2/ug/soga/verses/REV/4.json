          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emberi gh'ekityamo ekyo, nga ghaligho enhandha eri ng'oti kirawuli, era ng'ebitamu amaiso.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
