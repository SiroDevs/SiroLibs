              "REV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitonde ebiramu ebyo byaghanga ekitiisa oyo atyaime ku kityamo eky'obwakyabazinga omulamu ebyanda n'ebyanda, nga bimusaaka era nga bimweyanza. Bwe byabanga nga bikola bityo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'abakulembeze amakumi abiri n'abana (24) beeyala mu maiso g'oyo atyaime ku kityamo eky'obwakyabazinga, baamusinza oyo omulamu ebyanda n'ebyanda. Era engule dhaibwe baadhiisa gha mberi gh'ekityamo nga bakoba bati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
