                {
                  "text": "Ezek 37:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.11"
              },
              "items": [
                {
                  "text": "Lev 26:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
