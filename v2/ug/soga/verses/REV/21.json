          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.11"
              },
              "items": [
                {
                  "text": "Isa 60:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiisa n'eby'obukombe eby'amaghanga goonagoona birireetebwa mu kibuga ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "REV 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye tikiringiramu kintu kitali kirongoofu, waire omuntu akola ebyenhinhalwa oba omuguya, okutoolaku abo bonka abaaghandiikibwa mu kitabo eky'obulamu eky'Entaama Ento.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.27",
