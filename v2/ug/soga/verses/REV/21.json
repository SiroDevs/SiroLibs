        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabona ekibuga ekitukuvu, Yerusalemu ekiyaaka, nga kiika kiva mu igulu ewa Katonda, nga kiri ng'oti n'omugole ye bavaaziiza, eyetegeike okutwalibwa ewa iba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
