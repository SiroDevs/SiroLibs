              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alibeeya amaziga goonagoona mu maiso. Ghaliba tighakaali kufa, kugegenga oba kulira, oba obulumi. Kuba olwo eby'eira biriba nga byawaagho.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
