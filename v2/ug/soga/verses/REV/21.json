              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naabona eigulu eiyaaka n'ensi empyaka, kuba eigulu eryasooka n'ensi eyasooka byali bibuzeegho, n'enhandha nga tekaaligho.",
          "type": "text",
          "attrs": {
