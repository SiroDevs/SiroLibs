        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Okubonekerwa kwe mufuna kwa buguya, ni bye mulagula ti bituufu naire. Muli babi abatasiimya Katonda naire, era olunaku lwaimwe lutuuse, n'ekiseera eky'okubonerezebwa kwaimwe okusembayo. Empiima eja kusala amamiro gaimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
