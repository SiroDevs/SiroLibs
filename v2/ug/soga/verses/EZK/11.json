            "number": "25",
            "style": "v",
            "sid": "EZK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakobera abaali mu bunhage ebintu byonabyona Musengwa Katonda bye yandholeka.",
          "type": "text",
