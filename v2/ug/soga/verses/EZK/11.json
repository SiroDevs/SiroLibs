            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Ezek 43:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho bikerubi byayandhuluza amaghagha gaabyo byaguluka. Byaja nga n'enkede dhoona dhiri kujiira ghalala nabyo, era nga n'okumesunkana okw'ekitiisa kya Katonda wa Isiraeli kuli ghaigulu ghaabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiisa kya Musengwa Katonda kyasituka kyava ghagati mu kibuga, kyaja kyaba ku lusozi olwali ku luuyi olw'e buvandhuba olw'ekibuga ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
            "verseOrgIds": [
              "EZK.11.23"
            ]
          }
        },
        {
          "name": "verse",
