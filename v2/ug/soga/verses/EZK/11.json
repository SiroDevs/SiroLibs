              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omwoyo gwa Katonda gwambeeda nga ndi mu kubonekerwa okwo, gwandhizaayo y'abaali mu bunhage e Babilonia. Olwo bye nabona mu kubonekerwa byakoma agho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.24",
            "verseOrgIds": [
              "EZK.11.24"
            ]
          }
        },
        {
          "name": "verse",
