              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.3",
            "verseOrgIds": [
              "EZK.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha oyo yankoba ati: “Iwe omuntu, lingirira weekalirise bye nja okukwoleka, obitegere amatu, era obiteeku omwoyo kuba ekyo n'ekikuleeteisa ghano mbikwoleke. Bw'onaamala, byonabyona oidha kubikobera ab'eighanga Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.4",
            "verseOrgIds": [
              "EZK.40.4"
            ]
          }
        }
      ]
    },
