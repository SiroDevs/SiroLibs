              "items": [
                {
                  "text": "Lev 22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kabona taalyenga ku mamba ya nsolo oba ya nhonhi efiire yeene, waire eyo eitiibwa ensolo eyindi.”",
          "type": "text",
          "attrs": {
