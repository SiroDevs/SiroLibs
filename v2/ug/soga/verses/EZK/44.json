                  "text": "Lev 21:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kabona taidhanga kuseeta ku muntu afiire, olwo alobe kwereeteranga okuba atali mulongoofu. Okutoolaku ng'omuntu oyo abaire ise, oba inhina, oba omwana we, oba muganda we, oba mwanhina atali mufumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'anaamalanga okwiramu okuba omulongoofu, anaabisangagho enaku musanvu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "memale yaaghangayo ekigheebwayo olw'ebibi ekikye, ku lunaku lw'anaingirirangaku mu luya olw'omunda olw'eisinzizo okugheereza. Nze Musengwa Katonda ninze nkobye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
