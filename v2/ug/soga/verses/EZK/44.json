            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bakabona banaayegeresanga abantu bange okwawulagho ebintu ebitukuvu n'ebitali bitukuvu, n'okwawulagho ebirongoofu n'ebitali birongoofu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ghanaabangagho enkaayana mu bantu, bakabona n'abanaalamulanga nga bajiira ku mateeka gange. Baidha kukuumanga embaga edh'ebibinuko byange bye nalagira, n'enaku dhange edha Sabbato entukuvu, nga bajiira ku mateeka gange n'ebiragiro byange.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
      ]
    },
