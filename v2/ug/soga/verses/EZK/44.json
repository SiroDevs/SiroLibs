                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "Lev 21:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bakabona tibaidhanga kumwa nviiri ku mitwe gyaibwe kudhimaliriraku, waire okudhirekanga okuleegha inho, aye baidha kudhisalangaku busale dhibenga nhimpiyimpi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.9"
              },
              "items": [
                {
                  "text": "Lev 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kabona taidha kwingiranga mu luya lwa munda ng'anhweire omwenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
