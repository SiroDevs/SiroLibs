            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
