          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Nze mwene ndija naamenha akasaga ku muti omuvule omuleeyiriri, kale keene akato akasembayo ghaigulu ku busanso bw'ensaga dhaagwo. Era nze mwene ndija naakasimba ghaigulu ku lusozi oluleeyi einho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
