          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imwe muli ntaama dhange, entaama dhe ndhaya, ate nze naaba Katonda waimwe.” Musengwa Katonda atyo bw'akoba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
