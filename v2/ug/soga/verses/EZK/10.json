              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo n'ebyali ebitonde ebiramu bye nabona ghansi gha Katonda wa Isiraeli gha mwiga Kebari era naamanha nga byali bikerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
