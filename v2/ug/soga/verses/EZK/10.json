            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kikerubi kyali n'obweni bwa mikuzi ena, kyabaaku n'amaghagha ana, era kyabaaku n'ekintu ekiboneka ng'oti mukono gwa muntu, nga kiri ghansi mu maghagha gaakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emboneka yaabyo mu maiso, yali nga n'eyo yeeneyeene ye nabona okumpi n'omwiga Kebari. Buli kirala kyasobolanga okuja ku ndhuyi dhoonadhoona aghazira kukyetaagisa kumala kukyuka.",
          "type": "text",
