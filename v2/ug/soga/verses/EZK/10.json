                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Kwol 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Buli kikerubi kyali n'obweni bwa mikuzi ena. Obweni obwasooka bwali ng'oti bwa nte nume, obwokubiri bwaba ng'oti bwa muntu, obwokusatu bwaba ng'oti bwa mpologoma, ate obwokuna bwaba ng'oti bwa nkookooma.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        }
