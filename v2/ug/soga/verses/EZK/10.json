              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Kwol 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Agho naja okulinga nti nga mbona ghaigulu agh'emitwe egy'ebitonde ebiramu ebyo, mu ibbanga eryali ghaigulu ku ngulu, nga ghaligho ekiri ng'oti kityamo kya bwakyabazinga, nga kifaanana ng'oti n'eibaale ery'omughendo eryetebwa saffiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Kwol 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katonda yaakoba omuntu eyali avaire engoye empegheevu ati: “Ja ghagati mu nkede edhiri kwezungulula ghansi agh'ebitonde bikerubi, oyoole amanda agaidhula engalo dho agaliku omuliro, oje ogamansire ku kibuga.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu oyo yaaja nga ndi kubona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo, bikerubi byali byemereire ku luuyi olw'omukono omusaadha olw'e buvandhuba olw'eisinzizo. Omuntu oyo bwe yangira mu isinzizo, ekire kyagema woonawoona mu luya olw'omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiisa kya Musengwa Katonda kyasituka nga kiva gha bikerubi, kyaja ku mulyango ogw'eisinzizo. Ekire kyagema woonawoona mu isinzizo, oluya lwaidhula obutangaavu obw'ekitiisa kya Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuvuuma ogw'amaghagha ga bikerubi gwawulirwa n'ere mu luya olw'okuliya, nga guli ng'oti n'amamiro ga Katonda Aghanga Ebintu Byonabyona bwe gawulirwa, bw'aba ng'ayogeire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda bwe yalagira omuntu ole eyali avaire engoye empegheevu okuyoola omuliro ng'agutoola ghagati agh'enkede edhaali dhiri kwezungulula ghansi gha bikerubi, omuntu oyo yaaja yaayemerera munda okumpi n'eyindi ku nkede edho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ekindi ku bikerubi, kyagolola omukono nga kiri ghagati gha bikerubi bire ebindi, kyatoola ku muliro ogwali ghagati ghaabyo kyaguta mu ngalo dh'omuntu ole eyali avaire engoye empegheevu. Oyo yaagugema yaafuluma nagwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kikerubi kyaliku ekintu ekiboneka ng'oti mukono gwa muntu, nga kiri ghansi mu maghagha gaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
