            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Kwol 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ghagati agh'ebitonde ebiramu ebyo ghaaligho ebintu ebyaboneka ng'oti manda agaliku omuliro, oba ng'oti bisiki ebiri kwaka. Ebintu ebyo byali nga biri kutambula bwe biira eno n'ere ghagati mu bitonde ebiramu ebyo. Era omuliro ogwo nga guli kumalanga gwayaka inho, gwavaamu okumyansa ng'oti kwa lukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ebitonde ebiramu ebyo byona byali biri kumansuka embiro ng'oti kughemya kwa lukuba, nga biira eno n'ere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
