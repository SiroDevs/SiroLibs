          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe byalekera okuguluka ni biisa amaghagha gaabyo, ghaabaagho amamiro agaawulikika nga gali kuva ghaigulu gh'ekintu ekyaboneka ng'oti ni ku igulu ekyali gha mitwe gyabyo.",
          "type": "text",
