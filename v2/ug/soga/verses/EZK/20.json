              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.48",
            "verseOrgIds": [
              "EZK.20.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 20:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nze naakoba nti: “Aa, Musengwa Katonda, abantu bali kundhogeraku bati nze buli kiseera ndhogera mu nfumo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.49",
