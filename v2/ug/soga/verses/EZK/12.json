        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mu Isiraeli timulibaamu kabiri kubonekerwa kwa buguya, waire obulanzi obubuzaabuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze Musengwa Katonda mwene, ninze ndidha okwogeranga, era nga kye nkoba kituukirizibwa. Tighaabengagho kulwisa naire. Kye nnaayogeranga mu biseera byaimwe, imwe abadheemu, ndidha kukituukirizanga. Nze Musengwa Katonda ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
