          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oba bwe ndeetera olutalo okwidha mu nsi, ni ndulagira okwita abantu n'ensolo okumaliriragho, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
              "EZK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu abo abasatu ni bwe bandigibairemu, nze Musengwa Katonda ndayira nti nga bwendi omulamu, tibandiwoniizaagho waire abaana baibwe. Beene bonka bati n'abandiwonezeibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        }
      ]
    },
