              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Era iwe omuntu otabatyanga waire okutyanga bye boogera. Ni bw'onaababangamu ng'oti n'omuntu ali mu nkandwa ni mu mawa, oba ng'oti n'atyaime ku siga, otatyanga badheemu abo bye boogera waire okudhugumira olw'emmoga yaibwe eidhwire obukambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.6",
            "verseOrgIds": [
              "EZK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kubakobera bye ndi kukutuma okubakobera, oba bawulirisa oba tibawulirisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        }
      ]
    },
