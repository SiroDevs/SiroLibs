                "loc": "REV.5.1"
              },
              "items": [
                {
                  "text": "Kwol 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naja okulinga nti, nga mbona omukono ogusonse ye ndi. Era okuja okwetegereza nga mbona gugemye enzingo ey'ekitabo erimu ebighandiikiibwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaazingulula enzingo ey'ekitabo eyo mu maiso gange, naabona nga yaghandiikibwaku munda ni ku ngulu. Yali nga yaghandiikibwaku ebibono eby'okulira enaku, n'okugegenga, n'okuwowoola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
              "EZK.2.10"
            ]
          }
        }
