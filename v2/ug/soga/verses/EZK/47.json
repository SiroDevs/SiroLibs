                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Yoa 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Kwol 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Agho omusaadha yandhizaayo ku mulyango ogw'eisinzizo. Okuja okulinga nti nga mbona amaadhi gali kuva ghansi gh'omulyango ogwo, gaakuuluula nga gaja e buvandhuba eisinzizo ye lyalingirira. Amaadhi ago gaali gali kuviira ghansi ku luuyi olw'omukono omusaadha olw'e buvandhuba w'eisinzizo, nga gali kujiira ku luuyi lwene olwo olw'omukono omusaadha olw'e buvandhuba olw'alutaari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yanfulumya nga tubitira mu mulyango ogw'oku luuyi olw'omukono omugooda olw'e buvandhuba, yantwala yaneetolooza eyo kuliya, yantuusa ku mulyango ogw'okuliya ogulingiriire e buvandhuba. Naabona amaadhi nga gali kukuuluula nga gava ku luuyi olw'omukono omusaadha olw'e buvandhuba olw'omulyango ogwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omusaadha yaakozesa olupimo, yaapima obuleeyi bwa mita ebikumi bitaanu (500), ng'ali kujiira ku luuyi olw'e buvandhuba amaadhi ye gaali gali kuja. Yaamala yambisa mu maadhi ago, nga gatuuka mu bukongoivule. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaapima obuleeyi obundi nga bwona bwa mita ebikumi bitaanu (500). Era yaamala yambisa mu maadhi ago, nga gatuuka mu bivu. Kabiri yaapima obuleeyi obundi nga bwona bwa mita ebikumi bitaanu (500). Era yaagambisaamu nga gatuuka mu nkende. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabiri era yaapima obuleeyi obundi nga bwona bwa mita ebikumi bitaanu (500). Agho gwali gufuuse mwiga gwene nga tisobola kugutambulamu, kuba amaadhi gaali maleeyi inho. Omuntu nga tasobola kugatambulamu okutoolaku nga yeewuze bwewuge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yankoba ati: “Iwe omuntu ebyo obiboine?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yandhizaayo nga tubitira ku mbali okw'omwiga ogwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabona nga ku mbali ni ku mbali okw'omwiga ogwo kuliku emiti kamaala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yankoba ati: “Amaadhi ago gakuuluula nga gaja mu biketezo eby'e buvandhuba ebiri mu kiiko ekirimu omwiga Yorudani. Bwe gatuuka mu maadhi ag'omu nhandha, galongoosa amaadhi ago ag'omu nhandha gaafuuka malungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaadhi ago ag'omu mwiga ogwo, buli ye galikuuluulira eribaayo ebitonde ebiramu kamaala, yaabaayo ebyenhandha kamaala, era buli kintu ekiriba eyo kirifuna obulamu kuba galirongoosa amaadhi ag'omu nhandha gaafuuka malungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abavubi baliba ku mbali okw'omwiga ogwo, okuva mu kiketezo ekyetebwa Engedi okutuukira irala ku kyetebwa Enegulaimu. Balyanikanga okwo obutimba bwaibwe bwakala. Era ebyenhandha biriba eyo bya bika kamaala ng'oti n'ebiri mu Nhandha Eyaghagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye amaadhi ag'omu bibali ni mu bidiba ebiriba ku mbali okw'enhandha, tigalirongoosebwa kufuuka malungi. Galisigala nga ga muunhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Kwol 22:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ku mbali ni ku mbali okw'omwiga ogwo kulimeraku emiti egya buli nsambo, nga gibalaku ebibala ebiriibwa. Amakaba g'emiti egyo tigalinialanga, era emiti egyo tigirirekeranga kutaaku bibala. Giidha kutangaku ebibala ebiyaaka buli mwezi, olw'okuba ginhwa amaadhi agava mu isinzizo. Ebibala byagyo binaabanga mere, n'amakaba gaagyo gaabanga bulezi obuwonia.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba ati: “Dhino n'ensalosalo edh'ensi ey'ensikirano ye muligabania mu bika eikumi n'ebibiri eby'Abaisiraeli aye ekika kya Yosefu nga kifuna emigabo ebiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "47:13:",
              "type": "text"
            },
            {
              "text": "emigabo ebiri:",
              "type": "text"
            },
            {
              "text": "Ebika ebibiri ebya batabane ba Yosefu, Manasse ni Efuraimu, buli kirala kyafuna omugabo ogwa kyo mulala mulala.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalayirira badhaadha baimwe okubagha ensi eno. Kale mugigabananga nga mwazayaza, yaafuuka eyaimwe ey'ensikirano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ensalosalo dhaayo dhiriba dhiti: Ku luuyi olw'omukono omugooda olw'e buvandhuba, ensalosalo eriva ku Nhandha Eyaghagati yaabitira e Hethiloni, yaatuuka gh'oingirira e Hamathi, yaatuuka e Zedadi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Berotha, n'e Siburaimu ekiri ku nsalosalo eyawula ekiketezo eky'e Damasiko n'eky'e Hamathi, yaaja yaatuuka e Hazeri Hattikoni ekiri ku nsalosalo ni Haurani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni ensalosalo eyo ey'oku luuyi olw'omukono omugooda olw'e buvandhuba etyo bw'eriba ng'eva ku Nhandha Eyaghagati, yaaja yaatuuka e Hazari Enoni ekiri ku nsalosalo y'ekiketezo ky'e Damasiko n'eky'e Hamathi, ku luuyi olw'omukono omugooda olw'e buvandhuba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ku luuyi olw'e buvandhuba, ensalosalo eriva e Hazari Enoni, ekiri ghagati gh'e Haurani n'e Damasiko, yaaja ng'enonereza omwiga Yorudani ghagati gha Gileadi n'ensi Isiraeli. Agho yeeyongerayo ku Nhandha Eyomuunhu e buvandhuba, yaatuuka e Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ku luuyi olw'omukono omusaadha olw'e buvandhuba, ensalosalo eriva e Tamari yaaja yaatuuka ku maadhi ag'e Meriba mu Kadeshi. Era erija nga yeeyongerayo, ng'enonereza akaiga ak'e Misiri okutuuka ku Nhandha Eyaghagati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
