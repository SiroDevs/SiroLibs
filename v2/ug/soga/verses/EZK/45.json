                {
                  "text": "Kuv 12:1-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Kub 28:16-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ku lunaku olweikumi n'eina olw'omwezi ogusooka, mwidha kutooleranga embaga ey'Ekibinuko eky'Okwidhukiriraku Okubitizibwa, era munaamalanga enaku musanvu nga mulya migaati gitazimbulukusiibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo olusooka, kyabazinga anaatangagho ku lulwe ni ku lw'abantu boonaboona, ente enume entototo ng'ekigheebwayo olw'ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lunaku okumala enaku omusanvu edh'ekibinuko, aidha kutangagho ente enume musanvu entototo n'entaama enume musanvu nga dhiziraku kikyamu kyonakyona, dhibenga ekigheebwayo ekyokebwa. Era buli lunaku aidha kutangagho n'embuzi enume ndala, ebenga ekigheebwayo olw'ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku buli nte ni ku buli ntaama aidha kuteerangaku ekigheebwayo eky'emere ey'empeke, nga kya kilo ikumi na musanvu n'ekitundu, ateereku ni lita isatu edh'omuzigo ogw'ebibala eby'emiti emyoliva.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        }
      ]
