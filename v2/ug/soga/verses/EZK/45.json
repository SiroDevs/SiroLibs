              "EZK.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.36"
              },
              "items": [
                {
                  "text": "Lev 19:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mukozesenga minzaani entuufu nga n'ebipimo byonabyona bituufu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekipimo ekyetebwa efa kye bapimisa ebintu ebikalu, kibenga nga kyagayaga n'ekipimo ekyetebwa bathi kye bapimisa ebintu ebiyuyika ng'oti maadhi. Olwo ekipimo ekyetebwa homeri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:11:",
              "type": "text"
            },
            {
              "text": "homeri:",
              "type": "text"
            },
            {
              "text": "Okusinziira ku bipimo ebitongole ebyaligho mu biseera ebyo, ekipimo ekyo baakipimisanga nga tikiboola bintu bikalu oba ebyo ebiyuyika ng'amaadhi. Kyajangamu lita ng'oti kikumi na nsanvu na itaanu (175). Kale nga efa oba bathi ejaamu lita ng'oti ikumi na musanvu n'ekitundu (17.5).",
              "type": "text"
            }
          ]
        },
        {
          "text": " kibenga nga n'ekiyimba ebyo byombi aghalala. Homeri ekyo kibengamu efa ikumi era kibengamu ni bathi dhoona ikumi. Ekikoba nti efa ni bathi dhibenga nga dhaagayaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekipimo ekyetebwa shekeli ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:12:",
              "type": "text"
            },
            {
              "text": "shekeli:",
              "type": "text"
            },
            {
              "text": "Okusinziira ku bipimo ebitongole ebyaligho mu biseera ebyo, ekipimo ekyo kyali kyagayaga ni guraamu ng'oti ikumi na ndala n'ekitundu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kibenga nga kijaamu ekipimo ekyetebwa gera emikuzi amakumi abiri, ate shekeli enkaaga dhikolenga ekipimo ekyetebwa mina.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muti bwe mwidha okughangayo ebigheebwayo: Mwidha kutoolanga ekitundu kirala kirala ku buli bitundu mukaaga eby'engaano ye mukungula, era mutoolenga n'ekitundu kirala kirala ku buli bitundu mukaaga ebya sayiri ye mukungula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku muzigo ogw'ebibala eby'emiti emyoliva mwidha kughangayo ekitundu kirala kirala ku buli bitundu ikumi eby'ekipimo kya bathi okuva ku buli kipimo kya kori (kori eyo yoona ebaamu bathi ikumi, ekikoba nti eyagayaga ni homeri). ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ntaama edhiri mu byayiro mu nsi Isiraeli, mwidha kughangayo entaama ndala ndala ku buli ntaama ebikumi ebibiri (200). Ebyo n'ebinaabanga ebigheebwayo eby'emere ey'empeke, n'ebigheebwayo ebyokebwa, n'ebigheebwayo olw'okutabagana, abantu basoniyibwe ebibi byaibwe. Nze Musengwa Katonda ninze nkobye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu boonaboona ab'omu nsi Isiraeli baidha kuleetanga ebigheebwayo ebyo ye kyabazinga wa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kyabazinga oyo n'aidha okutangagho ebigheebwayo ebyokebwa byonabyona okuwaagho, n'ebigheebwayo eby'emere ey'empeke, n'ebigheebwayo eby'okunhwa, ku mikolo gino: ku mbaga edh'Ebibinuko eby'Okuboneka kw'Omwezi, ni ku Sabbato, ni ku mbaga edh'ebibinuko ebindi ebyalagirwa mu ighanga Isiraeli. Era aidha kutangagho ebigheebwayo olw'ebibi, n'ebigheebwayo eby'emere ey'empeke, n'ebigheebwayo ebyokebwa, n'ebigheebwayo olw'okutabagana, olw'okusabira abantu b'eighanga Isiraeli basoniyibwe ebibi byaibwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba ati: “Ku lunaku olusooka, mu mwezi ogusooka, mwidha kutoolanga ente enume entototo era eziraku kikyamu kyonakyona, mugigheeyo olw'okutukuza eisinzizo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.18",
            "verseOrgIds": [
              "EZK.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona aidha kutoolanga omusaayi ogw'ekigheebwayo ekyo olw'ebibi, agusiige ku myango egy'endhigi dh'eisinzizo, ni ku nsonda eina edh'omugo gw'alutaari, ni ku bikondo eby'omulyango ogwingira mu luya olw'omunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.19",
            "verseOrgIds": [
              "EZK.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ku lunaku olwomusanvu olw'omwezi mwidha kukolanga mutyo, olwa buli muntu anaabanga ng'akoze ekibi, nga tagendereire oba nga taidhi nga ky'ali kukola kibi. Mutyo bwe munaakuumanga eisinzizo nga itukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.20",
            "verseOrgIds": [
              "EZK.45.20"
            ]
          }
        }
      ]
