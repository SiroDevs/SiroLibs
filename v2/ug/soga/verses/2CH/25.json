              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Amazia owa Buyudaaya, mutabane wa Yoashi, yasigala ng'akaaligho okumala entangama ya myaka ikumi n'etaanu, nga kyabazinga Yehoashi mutabane wa Yehoahazi amaze okufa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindi byonabyona Amazia bye yakola okuva mu mainhama okutuuka ku nkomerero, byaghandiikibwa mu Kitabo ky'Ebyomubyanda bya Bakyabazinga ba Buyudaaya n'aba Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuviira irala Amazia lwe yakyuka n'ava ku Musengwa Katonda, ghaaligho abaakola olukwe mu Yerusalemu okumwita. Kale yaalumukira mu kibuga ky'e Lakishi, aye era baatumayo abantu okumunooniayo, era baamwitirayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulambo gwe baaguleetera ku mbalaasi, baamuziika mu Yerusalemu mu lwambiidhi lwa badhaadha be, mu kyetebwa Ekibuga kya Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
