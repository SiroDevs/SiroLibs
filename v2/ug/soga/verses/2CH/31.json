              "2CH.31.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12+NUM.18.13"
              },
              "items": [
                {
                  "text": "Kub 18:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Era yaalagira abantu ab'omu Yerusalemu okuleetanga omugabo ogw'okughanga bakabona, basobolenga okutuukiriza Amateeka ga Musengwa Katonda n'omwoyo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiragiro ekyo bwe kyamala okulangirirwa, baaleeta mu bungi ebisooka okukungulwa, ku ngaano, ni ku mwenge ogw'emizabbibu, ni ku muzigo ogw'ebibala eby'emiti emyoliva, ni ku mudheenene ogw'endhuki, ni ku birime byonabyona. Era baaleeta mu bungi n'ekintu kirala kirala ku buli bintu ikumi ku ebyo bye baali nabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boonaboona abaabanga mu bibuga bya Buyudaaya baaleeta ente ndala ndala ku buli nte ikumi, n'entaama ndala ndala ku buli ntaama ikumi dhe baali nadho. Era baaleeta n'ekintu kirala kirala ku buli bintu ikumi bye baali nabyo, baabibunga agho, nga babighaireyo bibe ebya Musengwa Katonda waibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebyo baatoolera okubibunga mu mwezi ogwokusatu, baamaliriza mu mwezi ogwomusanvu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Hezekia n'abakungu be bwe baidha ni babona emungo edho, beebaza Musengwa Katonda, era beebaza n'abantu be Abaisiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia oyo yaabuuza bakabona ebigema ku mmungo edho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Azaria Kabona Omukulu, mwidhukulu wa Zadoki, yaakoba ati: “Okuva abantu lwe baatoolera okuleeta ebintu mu isinzizo, tulya emere twaiguta twalekerera n'okulekerera, yaasigalagho nhingi inho kuba Musengwa Katonda aghaire abantu be enkabi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Hezekia yaalagira bategekeyo ebisenge mu isinzizo, era baabitegeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baingiza omwo n'obwegendereza ebyagheebwayo okuba ebya Musengwa Katonda, n'ekintu ekirala ekirala ku buli bintu eikumi omuntu bye yali nabyo. Baataagho Konania Omulevi okukolanga ogw'okubirabirira, nga Shimei muganda we n'amwiririra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate abaayambangaku Konania oyo ni muganda we oyo Shimei, nga ni bano: Yehieli, ni Azazia, ni Nahathi, ni Asaheli, ni Yerimothi, ni Yozabadi, ni Elieli, ni Isimakia, ni Mahathi, ni Benaia. Era nga baalondebwa kyabazinga Hezekia ni Azaria Kabona Omukulu ow'eisinzizo lya Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate Kore mutabane wa Imuna, omukuumi w'omulyango ogw'e buvandhuba, n'eyalabiriranga ebyo abantu bye baaghaayo ye Musengwa Katonda ekyeyendere nga n'agabaniamu ebigheereibwayo okuba ebitukuvu einho ebya Musengwa Katonda oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamuyambangaku baali, Edeni, ni Miniaminu, ni Yeshua, ni Shemaia, ni Amaria, ni Shekania. Baamuyambangaku n'obwesigwa mu bibuga bya bakabona, okugabira Balevi banaibwe ebintu, abakulu n'abato, mu bikunsu byaibwe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye mu abo timwalimu abo abaali baghandiikiibwa mu nkalala edh'obuzaale. Baagabiranga abasaadha n'abaana abalenzi boonaboona, ab'emyaka esatu egy'obukulu n'okusingagho, abaajanga mu isinzizo okugheereza mu ngobo edh'ebikunsu byaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona baaghandiikibwanga mu nkalala dh'obuzaale nga bajiira ku nda dha baiseibwe. Ate Abalevi baaghandiikibwanga okuva ku b'emyaka amakumi abiri egy'obukulu n'okusingagho, nga bajiira ku mirimo gye baakolanga mu bikunsu byaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona baaghandiikibwanga ghalala ni bakazi baibwe, n'abaana baibwe abalenzi n'abaghala, n'ab'omu maka gaibwe boonaboona kuba kyabeetaagisanga okwekuuma nga batukuvu okukola omulimo gwaibwe ekiseera kyonakyona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigema ku bakabona baidhukulu b'Aaroni abaabanga mu nimiro edh'omu byalo eby'oku bibuga byaibwe, ghaaligho abantu abaateebwagho mu butongole okughanga omugabo kiisi musaadha abalirwa mu bakabona, na kiisi Mulevi eyaghandiikibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Hezekia yaakolanga atyo mu Buyudaaya yoonayoona. Yaakolanga ebirungi n'ebituufu ebisiimya Musengwa Katonda we, era yaabanga mwesigwa y'ali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byamujiiranga bukalamu, kuba buli mulimo ogw'okusinza Katonda we mu isinzizo yagukolanga na mwoyo mulala, ng'ajiira ku mateeka n'ebiragiro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
