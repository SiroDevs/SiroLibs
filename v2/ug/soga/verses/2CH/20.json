              "2CH.20.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.4+DEU.2.5+DEU.2.6+DEU.2.7+DEU.2.8+DEU.2.9+DEU.2.10+DEU.2.11+DEU.2.12+DEU.2.13+DEU.2.14+DEU.2.15+DEU.2.16+DEU.2.17+DEU.2.18+DEU.2.19"
              },
              "items": [
                {
                  "text": "Ma 2:4-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mpegaano bona, Abammoni, n'Abamoabu, n'abantu ab'oku lusozi Seiri batulumbye. Ate nga badhaadha baife bwe baava mu nsi Misiri, tiwabaganha kulumba bantu abo. Badhaadha baife baabita ghala n'abantu abo, baaloba kuseeta ye bali era baaloba kubazikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.10",
            "verseOrgIds": [
              "2CH.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buti bali kutusasulamu na kutubinga mu nsi ye watugha okubanga obutaka bwaife. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.11",
            "verseOrgIds": [
              "2CH.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo Katonda waife, babonereze, kuba ife tuzira maani ga kulwanisa igye inene lino eritulumbye. Titwidhi kya kukola, aye tulingiriire ku iwe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera n'ekirala ekyo, abasaadha boonaboona ab'omu Buyudaaya baali beemereire agho ni bakazi baibwe, n'abaana baibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omwoyo gwa Musengwa Katonda gwaidha ku Mulevi eyali mu bantu abaali beesololeiza agho. Omulevi oyo ng'ayetebwa Yahazieli mutabane wa Zekaria, Zekaria mutabane wa Benaia, Benaia mutabane wa Yeieli, Yeieli mutabane wa Mattania, owundi ku baana ba Asafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.1+DEU.20.2+DEU.20.3+DEU.20.4"
              },
              "items": [
                {
                  "text": "Ma 20:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yahazieli oyo yaakoba ati: “Isebantu kyabazinga Yehoshafati, n'imwe mwenamwena abantu ab'omu Buyudaaya ni mu Yerusalemu, muwulirise: Musengwa Katonda akoba ati, mutatya, era eigye lino einene litabamalamu maani, kuba olutalo luno ti niimwe mwidha okululwana, aye Katonda mwene n'aidha okululwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwaidho imwe muje mubalumbe. Mwidha kubabona nga bali kuniinaniina ghale aghaingirirwa mu Zizi, olwo mubaagaane ekiiko ghe kikoma, aghatandiikira eirungu ery'e Yerueli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.16",
            "verseOrgIds": [
              "2CH.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.13+EXO.14.14"
              },
              "items": [
                {
                  "text": "Kuv 14:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tikiidha kubeetaagisa imwe kulwana lutalo luno. Imwe mwetegeke, mwemerere bwemerere, olwo mubone obughanguzi Musengwa Katonda bw'anaabagha. Imwe abantu ab'omu Buyudaaya n'ab'omu Yerusalemu, mutatya era mutawaamu maani. Olwaidho imwe muje mubalumbe, Musengwa Katonda aidha kuba ghalala n'imwe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yehoshafati yaakuba amakiryaivu era yaakutama n'ekyeni kyatuuka ku itaka. N'abantu boonaboona ab'omu Buyudaaya n'ab'omu Yerusalemu baakuba amakiryaivu mu maiso ga Musengwa Katonda, baamusinza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalevi abasimuka mu Kohathi ni mu Kora, baayemerera, baasaaka Musengwa Katonda, Katonda wa Isiraeli mu mamiro ag'amaani einho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe bwakya, baasituka ku nkyo okuja mu irungu ly'e Tekoa. Bwe baali bali kuja, Yehoshafati yaayemerera, yaakoba ati: “Imwe abantu ab'omu Buyudaaya n'ab'omu Yerusalemu, mumpulirise. Mwikirize Musengwa Katonda waimwe, olwo mwidha kuba bagumu. Mwikirize eby'abalanzi be, olwo mwidha kughangula.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yamala okwebuuzaaku ku bantu, yaataagho ab'okwembera Musengwa Katonda okumusaaka, nga bavaire ebivaalo eby'emikolo emitukuvu. Abo baakulemberamu eigye, baaja nga bemba bati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
