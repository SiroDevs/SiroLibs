              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abalasi b'obusaale baalasa kyabazinga Yosia, era yaakoba abagheereza be ati: “Mundhizeeyo, banfumiite inho ebibwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale abagheereza be baamutoola mu kigaali kye eky'omu lutalo kye yalimu, baamwiza mu kigaali kye ekindi eky'omu lutalo, olwo baamutwala e Yerusalemu. Yaafiira eyo era baamuziika mu lwambiidhi lwa badhaadha be. Abantu boonaboona ab'omu Buyudaaya n'ab'omu Yerusalemu baamulira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
