                "loc": "1KI.10.4+1KI.10.5+1KI.10.6+1KI.10.7"
              },
              "items": [
                {
                  "text": "1 Bakyab 10:4-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.3+2CH.9.4+2CH.9.5+2CH.9.6"
              },
              "items": [
                {
                  "text": "2 Byom 9:3-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale oba Katonda avaaza atyo eisubi ery'omu nsiko eririgho leero ate enkyo ni lisuulibwa mu muliro, talisingagho kubavaaza, imwe abali n'okwikiriza okutono?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kale ni muteeraliikiriranga nga mukoba muti tunaalya ki? Oba muti tunaanhwa ki? Oba muti tunaavaala ki? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abataidhi Katonda n'abanoonia ebyo imwe Iseimwe ali mu igulu aidhi ati ebyo byonabyona mubyenda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni musookenga kunoonia Bwakyabazinga bwa Katonda n'obutuufu bwe, era byonabyona biribongerwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulekenga ni kweraliikirira byaidho kuba olwaidho lulyeraliikirira ebyalwo, buli lunaku luli n'ebizibu ebirumala.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.34",
            "verseOrgIds": [
              "MAT.6.34"
            ]
          }
        }
      ]
