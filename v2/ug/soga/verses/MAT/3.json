              "items": [
                {
                  "text": "2 Bakyab 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yoanne ono, yali n'ekivaalo kye nga kya buviiri bwa ngamiya n'olukoba olw'oluwu mu nkende era emere ye yali nga nzige na mudheenene gwa mu nsiko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu okuva e Yerusalemu ni mu Buyudaaya mwonamwona, ni mu biketezo ebiriinaine omwiga Yorudani boonaboona baaja y'ali ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "era yaababatiza mu mwiga Yorudani nga bwe baatula ebibi byaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        }
      ]
    },
    {
