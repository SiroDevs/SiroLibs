                  "text": "Luk 9:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " N'eiroboozi lyava mu igulu lyakoba liti: “Ono ni mutabane wange omugonzi, mwe neesiimira einho.”",
          "type": "text",
          "attrs": {
