            "sid": "MAT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yesu bwe yamaliriza bye yagalagira Abeegeresebwa be Eikumi n'Ababiri, yaava agho yaaja okulangirira n'okwegeresa abantu mu bibuga byaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
    {
