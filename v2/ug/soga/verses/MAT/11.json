                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ka mbakobere: Ku lunaku olw'okusalirwaku omusango, Tiro ni Sidoni birisaasirwa okusinga imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate imwe abantu be Kaperinaumu, koodhi mwegulumiza kwenda kutuuka bwa mu igulu? Mwidha kwisibwa bwa mu magombe kuba nguli ebyewuunhio ebyabaagho mu imwe byali kubaagho mu Sodoma, nguli kikaaligho n'okutuusa olwaleero.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24+GEN.19.25+GEN.19.26+GEN.19.27+GEN.19.28"
              },
              "items": [
                {
                  "text": "Mainh 19:24-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ka mbakobere: Ku lunaku olw'okusalirwaku omusango, Sodoma kirisaasirwa okusinga imwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
            "verseOrgIds": [
              "MAT.11.24"
            ]
          }
        },
