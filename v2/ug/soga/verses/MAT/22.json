          ]
        },
        {
          "text": "Agho Abafarisaayo bwe baali nga bakeesololeiza ghalala, Yesu yaababuuza ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
