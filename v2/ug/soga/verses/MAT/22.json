          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati: “Mudhuuba mutya ku Kurisito? Mwana w'ani?” Baamukoba bati: “Wa Daudi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
