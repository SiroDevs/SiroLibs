          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mulala ku abo, nga Munamateeka, yaamubuuza ng'amuleba ati:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
