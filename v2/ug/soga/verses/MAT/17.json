            "style": "v",
            "sid": "MAT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.18",
            "verseOrgIds": [
              "MAT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abeegeresebwa baidha ye Yesu nga bali bonka baakoba bati: “Lwaki ife titwasobola kugubinga?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.19",
            "verseOrgIds": [
              "MAT.17.19"
            ]
          }
        }
      ]
    },
