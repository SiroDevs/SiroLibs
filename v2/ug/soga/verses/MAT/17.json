            }
          ]
        },
        {
          "text": "Yaakoba ati: “Agha.” Yesu yaamwesooka, yaakoba ati: “Simoni, olowooza otya? Bakyabazinga ab'ensi, empooza oba omusolo babitoola ku baani? Ku bataka oba ku basenze?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
