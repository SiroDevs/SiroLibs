              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ogw'engeri eno tiguva ku muntu okutoolaku ng'obise mu kusaba n'okusiiba.]”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
