          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakoba ati: “Ku basenze.” Yesu yaamukoba ati: “Ekikoba abataka ba idembe obutagha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        },
        {
          "name": "verse",
