            "sid": "MAT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.5",
            "verseOrgIds": [
              "MAT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegeresebwa olwawulira ekyo, baatya inho, era beeyala ghansi nga beefundiike. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.6",
            "verseOrgIds": [
              "MAT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Yesu yaaseeta yaabagemaku, yaakoba ati: “Musituke, muleke kutya.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.7",
            "verseOrgIds": [
              "MAT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baalinga ghaigulu, ghazira wundi ye baabona okutoolaku Yesu yenka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.8",
            "verseOrgIds": [
              "MAT.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.8",
            "verseOrgIds": [
              "MAT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baali baikirira ku lusozi Yesu yaabasikirira, yaakoba ati: “Ghatabaagho ye mukobera ku kye muboine okutuusa ng'Omwana w'Omuntu amaze okuzuukira mu bafu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.9",
            "verseOrgIds": [
              "MAT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.9",
            "verseOrgIds": [
              "MAT.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegeresebwa baamubuuza bati: “Lwaki Abanamateeka bakoba bati Eliya n'ow'okusooka okwidha?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.10",
            "verseOrgIds": [
              "MAT.17.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.5"
              },
              "items": [
                {
                  "text": "Mal 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.10",
            "verseOrgIds": [
              "MAT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabairamu ati: “Kituufu Eliya n'ow'okusooka okwidha, era wa kutereeza byonabyona ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.11",
            "verseOrgIds": [
              "MAT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye ka mbakobere: Eliya yaidha ira, aye tibaamumanha era baamukola byonabyona nga bwe baasiima. Mu nsambo n'endala bwe baja okudaazadaaza n'Omwana w'Omuntu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.12",
            "verseOrgIds": [
              "MAT.17.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.14"
              },
              "items": [
                {
                  "text": "Mat 11:14",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
