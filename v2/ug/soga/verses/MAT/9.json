          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaagema ku maiso gaibwe yaakoba ati: “Kibe kityo nga bwe mwikiriiza.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
