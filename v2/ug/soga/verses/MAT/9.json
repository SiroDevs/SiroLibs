          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho amaiso gaibwe gaazibuka. Yesu yaabasikirira ati: “Mubone nga tighaba akimanha.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
