          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwava agho, abatulu babiri baamunonereza, bwe baasiikana nga bakoba bati: “Omwana wa Daudi tusaasire!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.27",
            "verseOrgIds": [
              "MAT.9.27"
            ]
