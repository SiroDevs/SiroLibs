          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yatuuka mu ndhu abatulu baaseeta gh'ali, era yaabakoba ati: “Mwikiriza nga nsobola okubawonia?” Baamukoba bati: “Yii, Musengwa!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        }
      ]
