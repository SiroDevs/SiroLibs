          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawulire gano gaabuna ekiketezo ekyo kyonakyona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
