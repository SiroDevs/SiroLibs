          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaabaagho omukazi eyali alwaire ekikulukuto okumala emyaka ikumi n'ebiri, yaava emugongo wa Yesu, yaagema ku lusa lw'ekivaalo kye ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.20",
            "verseOrgIds": [
              "MAT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba mule yali akoba ati: “Ni bwenaagema obw'oku kivaalo kye ndidha kuwona.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.21",
            "verseOrgIds": [
              "MAT.9.21"
            ]
          }
        }
