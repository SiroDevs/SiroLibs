          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yakyuka yaamubona, yaakoba ati: “Mughala iwe guma omwoyo okwikiriza kwo kukuwoniiza.” Era ku saawa eyo yeene omukazi yaawona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
