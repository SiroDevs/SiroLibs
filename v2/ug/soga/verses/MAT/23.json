          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.5"
              },
              "items": [
                {
                  "text": "Yer 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba ka mbakobere: Timuliirayo kumbona okutuusa lwe mulikoba muti, ‘Wa nkabi oyo aidha mu liina lya Musengwa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
            "verseOrgIds": [
              "MAT.23.39"
            ]
          }
