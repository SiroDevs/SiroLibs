              },
              "items": [
                {
                  "text": "Mat 5:34",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mukagwireku Abanamateeka n'Abafarisaayo, abakuusa imwe, kuba mughaayo ekitundu kirala kirala ku buli bitundu ikumi eky'obuwoowo obuwoomesa eiva, nga buno: eduosimo, anetho, ni kumino. Aye mwaleka ebisinga obukulu ebiri mu Mateeka, bino: Okukolera banaimwe ebibagwaniire, ekisa, n'okwikiriza. Ebyo mugwaine okubikola ate ni bire obutabireka.",
          "type": "text",
          "attrs": {
