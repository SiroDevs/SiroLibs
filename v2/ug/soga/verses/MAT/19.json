                "loc": "EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16"
              },
              "items": [
                {
                  "text": "Kuv 20:13-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18+DEU.5.19+DEU.5.20"
              },
              "items": [
                {
                  "text": "Ma 5:17-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu yaakoba ati: “Toitanga, toyendanga, toibanga, otaghaayirizanga, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 19:19"
          },
          "items": [
            {
              "text": "19",
