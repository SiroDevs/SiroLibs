          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamukoba ati: “Oba ng'oyenda okuba atuukiriire, ja otane ebibyo, oghe abaavu, era oidhe onnonereze, obukombe oliba nabwo mu igulu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        }
      ]
    },
    {
