          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yeenayeena aleka enhumba, oba baganda be, oba baanhina, oba ise, oba inhina, oba abaana, oba ebibandha, ku lwange aliirizibwagho emikuzi kikumi, era yaafuna n'obulamu obutawaagho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
