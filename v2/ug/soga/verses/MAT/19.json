          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye abantu kamaala ab'emberi abaliba ab'ensembo, n'ab'ensembo abaliba ab'emberi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
