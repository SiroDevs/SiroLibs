          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Petero yaamukoba ati: “Bona eno, ife twaleka byonabyona twakunonereza olwo ife tulifuna ki?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        }
      ]
    },
