            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegeresebwa olwawulira ekyo, beewuunhia ekibitiriire nga bakoba bati: “Memale olwo naani aghanga okulokolebwa?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        }
      ]
    },
