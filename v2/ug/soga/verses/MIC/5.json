              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'e Yerusalemu mwesoloze mukole eigye! Batuzingiiza! Bakubye omufuzi wa Isiraeli ku itama n'olwigo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
