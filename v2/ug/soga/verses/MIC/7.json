              "items": [
                {
                  "text": "Luk 12:53",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nze, amaiso ndidha kugatanga ku Musengwa Katonda yenka. Katonda oyo ye ndidha okuteegereranga aidhe andokole. Katonda wange aidha kuwuliranga okusaba kwange.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazigu baife, mulobe kutusekerera mbu kuba tugwire. Tuja kusituka! Waire tuli mu nzikiiza buti, Musengwa Katonda aidha kutugha obutangaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakola ebibi eri Musengwa Katonda, kale tuli n'okugumira by'ali kutukola. Aye tikiidha kuba kiseera kireeyi, aidha kutuwolereza era atweye amaziga ge tulira olw'ebiinoino abazigu bye batukola. Aidha kutufulumya ku luya eri obutangaavu era twidha kubaagho atulokole nga tubona tuti. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo abazigu baife baidha kukibona baswale abo abaatuyeeyerezanga nga bakoba bati: “Musengwa Katonda waimwe ali gha?” Tulisangaala okubona nga batyankirirwa mu nguudo ng'oti bityanka!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'e Yerusalemu, ekiseera kiidha kutuuka musobole okuzimba ekimante okwezunguluza ekibuga kyaimwe. Era agho Yerusalemu kija kugazigha ensalosalo dhaakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.11",
            "verseOrgIds": [
              "MIC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mu biseera ebyo abantu baimwe baja kwira nga bava mu ndhuyi dhoonadhoona okuva Assiria e buvandhuba, Misiri ekiri ku luuyi olw'omukono omusaadha olw'e buvandhuba, okuva mu biketezo eby'omwiga Eufurate, n'okuva eghala, ku nhandha ni ku nsozi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ensi eja kufuuka irungu olw'abo abagibaamu ng'ebyo n'ebibala bye bakungula mu bikolwa byaibwe ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo Musengwa Katonda, ife abantu bo be weerondera okuba ababo ku bubwo, tulabirire ng'omwayi bw'agema omwigo n'alabirira entaama dhe. Waire tuli eyo twenka mu irungu, aye ensi etwezungulwire ngimu. Tuleke tuje tukozese ebiketezo by'e Bashani n'e Gileadi ebigimu obulungi nga bwe twakolanga eira.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo Musengwa Katonda, tukolere ebyewuunhio nga bwe wakolanga mu biseera bye twalinga e Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.15",
            "verseOrgIds": [
              "MIC.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'omu maghanga balibona bino, baatenha waire nga ba maani. Balibulwa eky'okwogera ng'ate bazira na kye bawulira, olw'okutya n'okusoberwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balyeghaluliza mu nkungu ng'oti misota, nga bava mu bifo byaibwe eby'okwewogomamu, baira ye iwe Musengwa Katonda waife, nga badhugumira olw'okutya einho.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MIC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezirayo katonda ali ng'oti niiwe, Musengwa Katonda. Osonigha ebibi eby'abantu bo abawoniegho. Tosungughala bujiiririire, aye osangaala okutwoleka okugonza kwo okutakoma. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MIC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kutugemerwa kabiri ekivunika. Oidha kutyankirira ebibi byaife n'ebigere byo, memale obisuule mu nhandha bidimire okutuukira irala ghansi ku ntobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.19",
            "verseOrgIds": [
              "MIC.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MIC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kutwoleka obwesigwa bwo n'okugonza kwo okutakoma, ife abantu bo baidhukulu ba Aburahamu era aba Yakobo, nga bwe wasuubiza badhaadha baife eira einho.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.20",
            "verseOrgIds": [
              "MIC.7.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
