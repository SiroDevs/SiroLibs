          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.53",
            "verseOrgIds": [
              "JDG.9.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JDG 9:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abimeleki yaayangugha okweta omwisuka eyamugemeranga eby'okulwanisa bye, yaamulagira ati: “Sowolayo empiima yo ondhite, abantu balobenga kundhogeraku bati mukazi n'eyandhita.” Kale omwisuka yaamufumita yaafa. ",
          "type": "text",
