              "JOB.42.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.1+JOB.1.2+JOB.1.3"
              },
              "items": [
                {
                  "text": "Yob 1:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho Yobu bwe yamala okusabira bakagwa be, Musengwa Katonda yaamwirizaagho obukombe bwe; nga bwe yali nabwo mu mainhama okubyamu emikuzi ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baganda ba Yobu ni baanhina, ni boonaboona abaali bamwidhi baidha, baaliira ghalala naye ekiiwulo mu nnaku ye. Era baamusaasira olw'ebizibu byonabyona Musengwa Katonda bye yamutuusaaku. Buli muntu yaamugha ekitundu kya feeza n'empeta eya zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaagha Yobu enkabi mu kiseera eky'obulamu bwe eky'oluvainhuma, okusingaku ni mu kyasooka. Yobu yaaba n'entaama omutwalo mulala n'enkumi ina, n'engamiya kakaaga, n'ente edhirima lukumi, n'endogoyi enkazi lukumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaazaala abaana abalenzi musanvu, n'abaghala basatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omughala asooka yaamutuuma eriina Yemima, owokubiri Kezia, n'owokusatu Kereni Happuki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "42:14",
              "type": "text"
            },
            {
              "text": "Kereni Happuki:",
              "type": "text"
            },
            {
              "text": "Amaina g'abaana ba Yobu abaghala googera ku bulungi bwaibwe: Yemima mu Luheburayi “Jemimah”, litegeeza “enjiibwa”; Kezia, mu Luheburayi “Keziah”, litegeeza “akawoowo ka kassia”; Kereni Happuki, mu Luheburayi “Keren Happuch”, litegeeza “akasanduuku omuterekebwa ebyesiigibwa ku bisige by'amaiso.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsi yoonayoona nga ghazira bakazi baboneka bulungi ng'oti ni baghala ba Yobu. Era iseibwe yaabagha emigabo egy'obusika aghalala ni baanhinaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bwe byawa, Yobu yaaghangaala emyaka kikumi n'ana, yaabona ni ku biidhukulu n'ebiidhukulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oluvainhuma Yobu yaafa nga musaadha mukaire, ow'emyaka emingi gyenegyene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
