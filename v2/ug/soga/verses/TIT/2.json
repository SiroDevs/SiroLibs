          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yegeresanga ebintu bino ng'olamba era ng'onenianga abantu bo n'obuyinza bwonabwona. Ghatabangagho muntu yeenayeena akunhoomanga.",
          "type": "text",
