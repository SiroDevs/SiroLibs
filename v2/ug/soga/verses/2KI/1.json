              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga yaakoba ati: “Oyo ni Eliya Omutishubi.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
