          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.16",
            "verseOrgIds": [
              "2KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omukuumi yali ayemereire ku kituuti ekirengererwaku mu Yezireeli, yaalengera Yehu n'ekikunsu kye eky'abantu nga kiri kwidha. Yaakoba ati: “Ndi kubona ekikunsu eky'abantu ekiri kwidha.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.17",
            "verseOrgIds": [
              "2KI.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoramu yaakoba ati: “Funayo omuntu omutume ku mbalaasi, aje ye bali ababuuze ati, ‘Mwidhie lwa miraala?’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.17",
            "verseOrgIds": [
              "2KI.9.17"
            ]
          }
        }
      ]
    },
