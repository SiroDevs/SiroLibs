        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu mwezi ogwomusanvu, Ishimaeli mutabane wa Nethania era mwidhukulu wa Elishama ow'oku lulyo olulangira, yaaja n'abantu ikumi e Mizipa, baalumba baita Gedalia, n'Abayudaaya, era n'Abababilonia abaali naye eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu boonaboona, abakulu n'abato, nga kw'otaire n'abakulu mu magye bale, baasituka baalumukira e Misiri, nga bali kutya Abababilonia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
