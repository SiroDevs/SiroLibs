        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kyabazinga Evilimerodaki ow'e Babilonia, yaagemerwa kyabazinga Yehoiakini ow'e Buyudaaya ekivunika mu mwaka gwene Evilimerodaki oyo gwe yafuukiramu kyabazinga. Yaamutoola mu ikomera ku lunaku olwamakumi abiri n'omusanvu, mu mwezi ogweikumi n'ebiri (12), mu mwaka ogwamakumi asatu n'omusanvu (37), okuva Yehoiakini oyo kyabazinga wa Buyudaaya lwe yasibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evilimerodaki oyo yaamubisa bukalamu, yaamuta mu kifo kya ghaigulu okusinga bakyabazinga abandi abaali naye mu bunhage e Babilonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoiakini baamuganha okutoolamu ebivaalo by'eikomera, era buli lunaku yaaliiranga ku kiiwulo kya kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga yaalagira bamughenga omugabo ogwa buli lunaku, ekiseera kyonakyona kye yamala nga mulamu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
          }
        }
