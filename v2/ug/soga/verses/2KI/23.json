            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Yosia yaamenhagho n'ekifo ekigulumivu eky'okusinzizaamu ekyali e Betheli, kyabazinga Yeroboamu mutabane wa Nebati kye yazimba n'aleetera Isiraeli okwonoona. Yosia oyo yaamenhagho alutaari ghalala n'ekifo ekyo ekigulumivu eky'okusinzizaamu, yaamulungula amabaale ge baabizimbisa gaafuuka bwa nkungu, era yaayokya n'ekifaananie ky'omusambwa omukazi Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
