        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaatoolayo embalaasi bakyabazinga ba Buyudaaya dhe baali baghaireyo eri endhuba. Era yaayokya ebigaali eby'omu lutalo ebyali mu luya okumpi n'aghaingirirwa mu isinzizo, okuliiraana n'endhu ya Nathani Meleki, eyali owundi ku bakungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamenhamenhagho alutaari, bakyabazinga ba Buyudaaya dhe baali bazimbye ghaigulu ku ngulu kw'endhu ya kyabazinga Ahazi, era n'edho kyabazinga Manasse dhe yali azimbye mu mpya dhombi edh'eisinzizo. Edho dhoonadhoona yaadhisaaniagho, dhaafuuka bwa nkungu, era enkungu eyo yaagiyugha mu kaiga Kiduroni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
