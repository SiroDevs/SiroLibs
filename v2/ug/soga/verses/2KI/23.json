          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Yehoiakimu yaasolozanga feeza ni zaabu ku bantu b'omu nsi ye ng'ajiira ku nfuna yaibwe, aghange okugheza omughendo gw'empiiya edh'omusolo kyabazinga w'e Misiri gwe yamulagira okusasulanga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
