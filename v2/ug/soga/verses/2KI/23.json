        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Yosia yaayonoona ebifo ebigulumivu eby'okusinzizaamu ebyali ku lwetebwa Olusozi olw'Okwonoona ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:13",
              "type": "text"
            },
            {
              "text": "Olusozi olw'Okwonoona:",
              "type": "text"
            },
            {
              "text": "Kitegeeza olusozi olw'emiti emyoliva.",
              "type": "text"
            }
          ]
        },
        {
          "text": " oluli ku luuyi olw'e buvandhuba wa Yerusalemu. Ebifo ebyo, kyabazinga Solomoni owa Isiraeli yali abizimbiire ebifaananie eby'emisambwa egyenhinhalwa: ekindi nga kya musambwa omukazi Ashera ogw'Abasidoni, ekindi kyaba kya musambwa Kemoshi ogw'Abamoabu, n'ekindi kyaba kya musambwa Moleki ogw'Abammoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.7"
              },
              "items": [
                {
                  "text": "1 Bakyab 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Yosia yaamenhamenha empango, era yaatematema n'ebifaananie eby'omusambwa Ashera. Mu bifo byabyo yaidhuzaamu amagumba g'abafu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
