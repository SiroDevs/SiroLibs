          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Yosia era yaayonoona ekifo ekyayetebwanga Tofethi, ekyali mu kiiko eky'Abahinnomu. Olwo ghalobenga kubaagho muntu yeenayeena ayokerayo mutabane we oba mughala we, ng'ekigheebwayo ekyokebwa eri omusambwa Moleki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
