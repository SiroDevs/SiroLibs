              "2KI.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoiakimu yali agheza emyaka amakumi abiri n'etaanu egy'obukulu ghe yafuukira kyabazinga wa Buyudaaya. Era yaafuga okumala entangama ya myaka ikumi na mulala mu Yerusalemu. Inhina nga ni Zebida, mughala wa Pedaia ow'e Ruma.",
          "type": "text",
          "attrs": {
