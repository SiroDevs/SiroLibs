              "2KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogwasatu n'omwenda (39) nga kyabazinga Uzzia n'afuga Buyudaaya, Shallumu mutabane wa Yabeshi yaafuuka kyabazinga wa Isiraeli, era yaafugira mu Samaria okumala entangama ya mwezi mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Menahemu mutabane wa Gadi, yaava e Tiruza yaaja e Samaria, yaita Shallumu, yaafuga mu kifo kye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindi byonabyona Shallumu bye yakola, omuli n'olukwe olw'okwita Zekaria lwe yakola, byaghandiikibwa mu Kitabo ky'Ebyomubyanda bya Bakyabazinga ba Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Menahemu yaazikiriza ekibuga Tappua, n'abaakirimu boonaboona, n'ebiketezo ebikiriiraine okuviira irala e Tiruza kuba baaloba okumwiguliragho okwingira. N'abakazi boonaboona abaakirimu nga bali mabunda, amabunda yaagabaagamu!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
