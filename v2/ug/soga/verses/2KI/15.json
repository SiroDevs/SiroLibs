        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kyatuukiriza Musengwa Katonda kye yasuubiza kyabazinga Yehu, ati: “Ab'eizaire lyo okutuuka ku luse olwokuna, balityama ku kityamo eky'obwakyabazinga bwa Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
