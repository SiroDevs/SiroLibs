        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'amakumi asatu n'omunaana (38) nga kyabazinga Uzzia n'afuga Buyudaaya, Zekaria yaafuuka kyabazinga wa Isiraeli, kyabazinga Yeroboamu owokubiri nga n'amuzaala. Yaafugira mu Samaria okumala entangama ya myezi mukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakola ebibi eri Musengwa Katonda nga badhaadha be bwe baakolanga. Yaakola ebibi ng'ebya Yeroboamu mutabane wa Nebati, ebyaleetera Isiraeli okwonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Shallumu mutabane wa Yabeshi yaamukolera olukwe, yaamufumitira mu Ibuleamu, yaamwita, era yaafuga mu kifo kye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        }
      ]
    },
