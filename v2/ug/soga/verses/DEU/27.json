        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa yaasikirira abantu ku lunaku olwo ng'akoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwe mulimala okusomoka omwiga Yorudani, ab'ebika bino n'abalyemerera ku lusozi Gerizimu okusabira abantu enkabi: ekika ekya Simeoni, n'ekya Levi, n'ekya Yuda, n'ekya Issakari, n'ekya Yosefu, n'ekya Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
