                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Ma 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yosh 8:33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate ab'ebika bino n'abalyemerera ku lusozi Ebali okukolima: ekika ekya Reubeni, n'ekya Gadi, n'ekya Ashera, n'ekya Zebuluni, n'ekya Dani, n'ekya Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo Abalevi balikoba Abaisiraeli boonaboona mu mamiro ag'amaani bati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Omuntu yeenayeena anaakolanga ekifaananie ekibaadhe, oba ekisaanuusiibwa mu kyuma, memale n'akitaagho n'akisinza, akolimirwenga! Kuba okusinza ebitali Katonda kiba ekyenhinhalwa ye Musengwa Katonda.’ Olwo abantu boonaboona baliiramu bati, ‘Amiina.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        },
