        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa yaayogera ebibono by'olwembo luno byonabyona, ng'Abaisiraeli boonaboona abeesoloiza bali kuwulira, ati:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
