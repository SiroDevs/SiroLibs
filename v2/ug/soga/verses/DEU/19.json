            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaakoba Abaisiraeli ati: “Omudhulizi omulala yenka taasingisenga muntu musango, olw'ekibi oba ekintu ekikyamu kyonakyona omuntu oyo ky'anaabanga ng'akoze. Omuntu anaakakasibwanga okuba ng'aliku omusango lwa budhulizi bwa bantu babiri oba basatu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
