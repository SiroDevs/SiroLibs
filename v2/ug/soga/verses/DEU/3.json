                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "Ma 32:48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Wo Musengwa Katonda waife, nze ndidhi nga waakatoolera butoolere okundholeka ebikologho n'ebyewuninkiriza by'oja okukola. Ezira katonda mu igulu oba mu nsi asobola okukola eby'amaani by'okoze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkweghemba, onganhe nsomoke omwiga Yorudani, mbone ensi ey'ensozi eri eyo enungi, era mbone n'ekiketezo ky'e Lebanoni.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
    },
    {
