            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaakoba Abaisiraeli ati: “Mwidhukire Abamaleki kye baabakola, bwe mwali mu lugendo nga muva e Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14"
              },
              "items": [
                {
                  "text": "Kuv 17:8-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15:2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabalumba bwe mwali nga mukooye era nga muwoiremu amaani, baaloba kutya Katonda, baita boonaboona abaali nga basembyeyo einhuma waimwe, ng'amagulu gabazitoighe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ni, Musengwa Katonda waimwe bw'alibagha okutyama mu nsi ni mutereera, n'atoolagho abazigu baimwe boonaboona ababeezungulwire mu nsi y'ali kubagha okuba obutaka bwaimwe, mulizikiriza Abamaleki abo mwabasaaniagho, baaloba kwidhukirwanga ku nsi. Muteerabiranga kukola ekyo.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    }
