            "number": "22",
            "style": "v",
            "sid": "DEU 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni bwe mwali e Tabera, n'e Massa, n'e Kiburothi Hattaava, yoona mwasungughalizaayo Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
