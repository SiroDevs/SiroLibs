            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutasinzanga Musengwa Katonda waimwe mu nsambo beene ye basinzaamu bakatonda baibwe, kuba bwe baba nga bali kusinza bakatonda baibwe, bakola buli kyenhinhasa Musengwa Katonda era ky'atayenderaku irala. Bookya n'abaana baibwe mu muliro, ng'emisengo eri bakatonda baibwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
    },
