                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "Ma 15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi kye mughaayo ye Musengwa Katonda, mutakiriiranga eyo ye muba: ka kibe ekitundu ekirala ekirala ku buli bitundu ikumi eby'engaano yaimwe, oba eby'omwenge gwaimwe ogw'emizabbibu, oba eby'omuzigo ogw'ebibala eby'emiti emyoliva oba ka dhibe ensolo dhaimwe, ng'ente, entaama, oba embuzi, edhizaalibwa mu luzaalo olusooka oba ekigheebwayo kyaimwe eky'okutuukiriza obweyamo bwaimwe ye Musengwa Katonda, oba ekigheebwayo kyaimwe eky'ekyeyendere, oba ebigheebwayo byaimwe ebindi bye mughaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye imwe, ni batabane baimwe, ni baghala baimwe, n'abagheereza baimwe abasaadha n'abakazi, n'Abalevi ababa mu bibuga byaimwe, mwidha kulyanga ebigheebwayo ebyo mu maiso ga Musengwa Katonda waimwe, mu kifo ekyo Musengwa Katonda waimwe oyo ky'aidha okulondagho. Era mwidha kusagambiranga eyo olwa byonabyona bye munaabanga nga mukoze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwegenderezenga mulobe kusuulirira Balevi, ekiseera kyonakyona kye munaamala nga muli balamu ku nsi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Musengwa Katonda waimwe bw'aligaziya ekiketezo kyaimwe nga bweyabasuubiza, ni muwulira mule nga muli kwenda okulya emamba, mwidha kubanga ba idembe okugirya nga bwe mwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo Musengwa Katonda waimwe ky'aliba ng'alonzeegho okumusinzizangamu bwe kinaabanga eghala einho, munaitanga nga bwe mbalagiire ku nsolo dhaimwe, ente, entaama n'embuzi, Musengwa Katonda dh'abaghaire, mwadhiriira ye munaabanga, nga bwe munaabanga mwenze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalongoofu n'abatali balongoofu banaabanga ba idembe okulya ku mamba eyo, ng'oti ni bwe balya ku y'empuuli n'ey'empongo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mwegenderezenga mulobe kulya ku musaayi, kuba omusaayi n'obulamu. Kale ni mutalyanga bulamu ghalala na mamba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
