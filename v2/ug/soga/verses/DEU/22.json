              "items": [
                {
                  "text": "Kuv 22:16-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha oyo aidha kughanga lata w'omughala oyo ebitundu ataanu ebya feeza, era omughala oyo aidha kufuukanga mukazi we. Kuba yamala okumukaka yaaba naye, era omusaadha oyo mu bulamu bwe bwonabwona, taabingenga mukazi oyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
      ]
    },
