          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghasobola okubaagho omusaadha, yaayagaanibwa ng'akase omughala omwegha akaali kwandhula, era yaaba naye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
