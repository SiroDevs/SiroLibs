          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuristo banaimwe ab'omu Kikunsu eky'Abaikiriza mu Kurisito eky'omu Babiloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:13",
              "type": "text"
            },
            {
              "text": "Babiloni:",
              "type": "text"
            },
            {
              "text": "Kino kisobola okuba Ekikunsu eky'Abaikiriza mu Kurisito eky'omu Roma ( Kwol 14:8; 17:5; 18:2).",
              "type": "text"
            }
          ]
        },
        {
          "text": " boona abaalondebwa Katonda babalamwisa. Era n'omwana wange Mariko yeena abalamwisa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
