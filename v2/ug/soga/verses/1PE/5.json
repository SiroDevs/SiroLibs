        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaghandiikiire embaluwa eno enhimpi nga nhambibwaku Siluvano, nze ye mbona nga Mukurisito munange omwesigwa. Ndi kubakubiriza era naabakakasa nti kino kye mpandiise n'ekisa kya Katonda kyenekyene, era mutakivangamu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
