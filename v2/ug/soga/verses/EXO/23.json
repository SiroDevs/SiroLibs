        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Weesambirenga irala okughaayiriza omuntu yeenayeena. Omuntu aziraku musango era omutuufu, otamusaliranga gwa kufa. Kuba tiriroba kuvunaana kiisi mukozi wa kibi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otalyanga nguzi, kuba enguzi eziba abantu amaiso era yaafuulaniafuulania ensonga dh'oyo omutuufu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
