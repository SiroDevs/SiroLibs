              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekibinuko eky'Amakungula n'ekyokubiri, ekibaagho nga muli kukungula bye mwasiga mu misiri gyaimwe ebisooka.",
          "type": "text",
          "attrs": {
