              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi musaadha anaabanga n'okwidha okunsinza nze Musengwa Katonda waimwe mu bibinuko ebyo eby'emikuzi esatu buli mwaka.",
          "type": "text",
          "attrs": {
