          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Onaamalanga emyaka omukaaga ng'osimba emere yo, era ng'ogikungula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.1+LEV.25.2+LEV.25.3+LEV.25.4+LEV.25.5+LEV.25.6+LEV.25.7"
              },
              "items": [
                {
                  "text": "Lev 25:1-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu mwaka ogwomusanvu olekanga eitaka lyo lyawuumulaku, era emere yoonayoona ebala mu misiri erekebwangayo, abaavu baagirya. Ate eyo abaavu ye baba nga tibaliire bagirekeranga ensolo edh'omu nsiko dhaalya. Mu nsambo n'endala eyo, otyo bw'onaakolanga amasamba go ag'emizabbibu n'ag'emiti emyoliva.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
