            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oli n'enaku mukaaga dh'oghanga okukoleramu emirimo gyo, aye olwomusanvu oidhanga kuwuumula. Olwo ente dho n'endogoyi dho dhighange okuwuumula, era abairu bo, n'abamaghanga agandi abakukolera bawuumule bairemu amaani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
