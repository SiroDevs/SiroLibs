            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otasansaanianga ngambo, era oteeyimbanga na mukozi wa bibi ng'ogha obudhulizi obutali butuufu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
