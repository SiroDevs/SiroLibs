        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kyaba kityo okumala enaku musanvu okuva Musengwa Katonda lwe yakuba omwiga Kiyira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
