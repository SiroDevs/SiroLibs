        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwidha kukolanga Ekibinuko eky'Emigaati Egitazimbulukusiibwa. Mwidha kulyanga emigaati egyo okumala enaku musanvu, nga bwe nabalagira, mu biseera ebyateebwagho, mu mwezi gwa Abibu. Kuba mu mwezi gwa Abibu ogwo, ni gwe mwaviiramu mu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
