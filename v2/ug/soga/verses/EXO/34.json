              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaana ababeri boonaboona abalenzi, baidha kubanga bange. Era n'ensolo edhizaalibwa mu luzaalo olusooka nga nume, mu nte, mu ntaama, ni mu mbuzi, dhoona dhange. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endogoyi enume ezaalibwa mu luzaalo olusooka muginunulanga nga mughaayo entaama ento. Aye bwe mubanga nga timuginunwire, muginiolanga enkoto yaafa. N'omwana omulenzi omuberi munaamununulanga mu nsambo n'endala eyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
