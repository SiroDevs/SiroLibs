            "number": "17",
            "style": "v",
            "sid": "EXO 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muteewumbiranga kifaananie kya katonda nga mukozesa akatiba n'ekyuma ekisaanuuse, ni mumala ni mumusinza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        },
        {
