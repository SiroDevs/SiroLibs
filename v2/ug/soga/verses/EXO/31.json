          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda bweyamala okwogera ni Musa ku lusozi Sinai, yaamugha ebibaadho ebibiri eby'amabaale Katonda mwene bye yaghandiikaku amateeka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
