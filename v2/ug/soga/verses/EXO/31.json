                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Abaisiraeli boonaboona, abaana n'abaidhukulu, baidha kukuzanga olunaku lwa Sabbato ng'akamanhiso ak'endagaano etawaagho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kaidha kubanga kamanhiso akatawaagho ghagati ghange n'Abaisiraeli boonaboona okubaidhusanga nze Musengwa Katonda bwe nakola eigulu n'ensi mu nnaku omukaaga, ku lwomusanvu ni ndekera agho okukola, ni mpuumula.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
