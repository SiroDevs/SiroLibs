                "loc": "DEU.4.20"
              },
              "items": [
                {
                  "text": "Ma 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.6"
