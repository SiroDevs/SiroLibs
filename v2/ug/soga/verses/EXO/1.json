              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano n'amaina aga batabane ba Yakobo be yaja nabo mu Misiri, nga buli muntu aja n'ab'omu maka ge:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
