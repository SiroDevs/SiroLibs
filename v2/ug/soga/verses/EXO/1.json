              },
              "items": [
                {
                  "text": "Mainh 46:8-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
