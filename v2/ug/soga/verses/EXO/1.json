            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni, Simeoni, Levi, Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Issakari, Zebuluni, Benjamini, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.3",
            "verseOrgIds": [
              "EXO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dani, Nafutali, Gadi ni Ashera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.4",
            "verseOrgIds": [
              "EXO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu baamwagaanayo mu Misiri, kale abantu boonaboona abaali basimuka mu Yakobo baaba nsanvu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ekiseera kyatuuka Yosefu, ni baganda be, n'abantu abandi ab'oluse olwo lwonalwona, baaba nga bafiire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Abaisiraeli abo, abaana be baaleka baazaalagana inho era baaba ba maani agataloodheka, kumpi baidhuza Misiri yoonayoona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
