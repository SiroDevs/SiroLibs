              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Musengwa Katonda bweyawonia Abaisiraeli ng'abatoola mu buyinza bw'Abamisiri, era Abaisiraeli baabona emirambo gy'Abamisiri nga giri agho ku mbali okw'enhandha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli bwe baabona amaani agataloodheka Musengwa Katonda ge yakozesa okughangula Abamisiri, baamutya inho baamwikiriza era baikiriza n'omugheereza we Musa.",
          "type": "text",
