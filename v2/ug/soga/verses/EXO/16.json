                "loc": "NUM.11.7+NUM.11.8"
              },
              "items": [
                {
                  "text": "Kub 11:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaakoba ati: “Musengwa Katonda yatulagira tulekeghooku akaibo aka mannu, tukaterekere abaana n'abaidhukulu abaliiragho, babone ku mere Musengwa Katonda ye yatughanga nga tuli mu irungu, lwe yatutoola mu Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa yaakoba Aaroni ati: “Funayo ekidoome, ofukemu akaibo ka mannu, memale okite mu maiso ga Musengwa Katonda olw'okuterekera abaana n'abaidhukulu abaliiragho.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Heb 9:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nga Musengwa Katonda bweyalagira Musa, Aaroni bweyakola, yaatoola ekidoome yaakita aghali Sanduuku ey'Endagaano, kiterekebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli baalya mannu okumala emyaka amakumi ana, okutuusa lwe baatuuka mu nsi ey'e Kanaani ghe baafuula obutaka bwaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
