              "type": "tag",
              "attrs": {
                "loc": "JOS.5.12"
              },
              "items": [
                {
                  "text": "Yosh 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Okusinziira ku bipimo ebitongole ebyaligho mu biseera ebyo, ng'akaibo akalala kajaamu kilo ng'oti ndala ey'obuse.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.36",
            "verseOrgIds": [
              "EXO.16.36"
            ]
          }
        }
