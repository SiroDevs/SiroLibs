          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oyo kwairaku Refaia mutabane wa Huri eyafuganga ekitundu ku kiketezo ky'e Yerusalemu, yaalongoosa ekitundu ekyairaku ku kimante ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        }
      ]
