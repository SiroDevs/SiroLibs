              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzzieli mutabane wa Harihaia, omugheesi w'ebintu bya zaabu, yairaku, yaalongoosa ekitundu ekyairaku ku kimante ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oyo kwairaku Hanania omukozi w'obuwoowo, yaalongoosa ekitundu ekyairaku ku kimante ekyo, okutuuka ku Kimante Ekigazi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        }
      ]
    },
    {
