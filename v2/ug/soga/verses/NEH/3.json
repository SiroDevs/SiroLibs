        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku abo kwairaku Melatia ow'e Gibeoni, ni Yadoni ow'e Meronothi, n'abantu abandi ab'e Gibeoni n'ab'e Mizipa abaali bafugibwa omukungu w'ekiketezo ekiri ere ng'osomoike omwiga Eufurate abo boona baakola ogw'okulongoosa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
