            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'e Tekoa baazimba ekitundu ekyairaku ku kimante ekyo, aye abakungu baayo baaloba okukola omulimo Musengwa Katonda waibwe gwe yabagha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
