          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikiya mutabane wa Harimu, ni Hassihubu mutabane wa Pahathi Moabu, bombi baalongoosa ekitundu ekyairaku ku kimante ekyo, era baalongoosa n'Omunaala ogw'Eziiko.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        }
