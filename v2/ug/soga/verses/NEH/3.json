          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabane ba Hassena baazimba ogwetebwa Omulyango ogw'Ebyenhandha. Baasimbagho emyango gyagwo, baataamu endhigi dhaamu, era endhigi edho baadhitaaku eminhololo n'ebisiba ebindi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        }
      ]
    },
    {
