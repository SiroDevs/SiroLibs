          ]
        },
        {
          "text": "Bakabona ab'omu kiketezo eky'oku museetwe bano, n'abaalongoosa ebitundu ebyairaku ku kimante ekyo: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
