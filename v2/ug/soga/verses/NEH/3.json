          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku abo kwairaku Shallumu mutabane wa Halloheshi, eyafuganga ekitundu ekindi ku kiketezo kire eky'e Yerusalemu, yaalongoosa ekitundu ekyairaku ku kimante ekyo, ng'ayambibwaku baghala be.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
