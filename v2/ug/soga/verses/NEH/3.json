          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oyo kwairaku Hattushi mutabane wa Hashabuneia, yaalongoosa ekitundu ekyairaku ku kimante ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        }
