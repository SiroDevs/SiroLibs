          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoiyada mutabane wa Pasea ni Meshullamu mutabane wa Besodeia, baalongoosa ogwetebwa Omulyango Omukaire. Baasimbagho emyango gyagwo, baataamu endhigi dhaamu, era endhigi edho baadhitaaku eminhololo n'ebisiba ebindi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
