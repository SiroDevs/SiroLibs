          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku oyo kwairaku Yedaia mutabane wa Harumafa, yaalongoosa ekitundu ekyairaku ku kimante ekyo, ekyali okumpi n'endhu ye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
