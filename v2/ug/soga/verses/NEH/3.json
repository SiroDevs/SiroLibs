            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakkuri mutabane wa Imuri yaazimba ekitundu ekyairaku.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
