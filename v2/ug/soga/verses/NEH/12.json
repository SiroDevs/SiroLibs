          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni bakabona bano boona baayemerera agho: Maaseia, ni Shemaia, ni Eleazari, ni Uzzi, ni Yehohanani, ni Malikiya, ni Elamu, ni Ezeri. Abembi baayemba nga bakulemberwa Yezerahia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
