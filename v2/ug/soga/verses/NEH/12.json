              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ebikunsu ebyo byombi eby'abo abaali nga baidhie okwebaza, byatuuka aghali eisinzizo. Ninze zeena, nga ndi ghalala n'ekitundu kire ekyasigalagho ku bakulu b'omu Buyudaaya bale, twayemerera agho, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
