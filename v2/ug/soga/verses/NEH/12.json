          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "aghalala ni bakabona bano: Eliakimu, ni Maaseia, ni Miniamini, ni Mikaia, ni Elioenai, ni Zekaria, ni Hanania, nga bali kufuuwa amagwala gaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
