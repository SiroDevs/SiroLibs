            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano n'abatyamye abakulu ab'omu kiketezo ekyo ekya Buyudaaya, abaabanga mu Yerusalemu: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
