      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abakulembeze b'abantu baasenga mu Yerusalemu baabanga omwo, aye abantu abaasigalagho abandi baakuba obululu okulonda omuntu omulala omulala ku buli bantu eikumi, okubanga mu Yerusalemu ekibuga ekitukuvu. Ate bale omwenda abasigalagho ku buli bantu eikumi, nga ba kubanga mu bibuga ebindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era abantu nga basanhukira inho omuntu asalagho ku lulwe okuja okubanga mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
