              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boonaboona abaasimuka mu Perezi abaabanga mu Yerusalemu baali ebikumi bina na nkaaga na munaana (468), nga boonaboona bantu abaziramu ntete.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
