            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababenjamini boonaboona abaabanga mu Yerusalemu baali lwenda n'abiri na munaana (928). ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeli mutabane wa Zikuri n'eyali omukulembeze waibwe, ate Yuda mutabane wa Hassenua n'eyaiririranga omukulu ow'ekibuga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        }
      ]
