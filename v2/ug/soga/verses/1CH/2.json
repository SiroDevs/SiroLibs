        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu yali n'omukazi ow'embali nga ni Efa, yaamuzaalamu Harani, ni Moza, ni Gazezi. Harani oyo yazaala omwana yeena baamweta Gazezi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
