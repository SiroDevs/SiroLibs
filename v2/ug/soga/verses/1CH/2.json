          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano n'abaana Yakobo be yazaala: Reubeni, Simeoni, Levi, Yuda, Issakari, Zebuluni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.1",
            "verseOrgIds": [
              "1CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dani, Yosefu, Benjamini, Nafutali, Gadi, ni Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
