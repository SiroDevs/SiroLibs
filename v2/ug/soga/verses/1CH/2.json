    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezironi yaazaala: Yerahameeli, Ramu, ni Kelibai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ramu yaazaala Amminadabu, Amminadabu yaazaala Nahashoni omukulembeze w'ab'ekika kya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.10",
            "verseOrgIds": [
              "1CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahashoni yaazaala Saluma, Saluma yaazaala Boazi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.11",
            "verseOrgIds": [
              "1CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boazi yaazaala Obedi, Obedi yaazaala Yesse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesse yaazaala abaana abalenzi musanvu: Eliabu nga n'omuberi, kwairaku Abinadabu, kwairaku Shimea, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.13",
            "verseOrgIds": [
              "1CH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwairaku Nethaneli, kwairaku Raddai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.14",
            "verseOrgIds": [
              "1CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwairaku Ozemu, ate ku oyo kwairaku Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.15",
            "verseOrgIds": [
              "1CH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaazaala n'abaana abaghala babiri: Zeruia ni Abigaili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeruia yaazaala abaana abalenzi basatu: Abishai, Yoabu, ni Asaheli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigaili yaazaala Amasa. Lata wa Amasa oyo nga ni Yetheri Omuishimaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu mutabane wa Hezironi yaazaala ni mukazi we Azuba omwana omughala, nga ni Yeriothi. Era mukazi we Azuba oyo, yaazaala abaana abalenzi bano: Yesheri, Shobabu, ni Arudoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.18",
            "verseOrgIds": [
              "1CH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azuba bwe yafa, Kalebu yaabayiza Efurathi yaamuzaalamu omwana nga ni Huri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.19",
            "verseOrgIds": [
              "1CH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huri oyo yaazaala Uri, ate Uri Yazaala Bezaleli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezironi bweyali ng'agheza emyaka nkaaga egy'obukulu, yaabayiza mughala wa Makiri yaamuzaalamu omwana nga ni Segubu. Makiri oyo nga ni lata wa Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.21",
            "verseOrgIds": [
              "1CH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Segubu yaazaala Yairi eyali mwene bibuga amakumi abiri n'ebisatu mu kiketezo ky'e Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.22",
            "verseOrgIds": [
              "1CH.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye obwakyabazinga bw'e Geshuri ni mu Aramu bwabanhagaku ebibuga bya Yairi ni Kenathi nkaaga, ghalala n'ebyalo ebibyezungulwire. Abantu boonaboona abaali eyo, nga n'abasimuka mu Makiri, lata wa Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.23",
            "verseOrgIds": [
              "1CH.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezironi bwe yamala okufa, Kalebu yaazaala ni Efurathi namwandu wa lata we Hezironi oyo omwana, nga ni Ashuhuri. Ashuhuri oyo ni lata wa Tekoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerahameeli eyali omwana omukulu owa Hezironi, yaazaala abaana bano: Ramu nga n'omuberi, ni Buna, ni Oreni, ni Ozemu, ni Ahiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.25",
            "verseOrgIds": [
              "1CH.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerahameeli yali n'omukazi owundi nga ni Atara, ye yazaala naye Onamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.26",
            "verseOrgIds": [
              "1CH.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ramu eyali omwana omukulu owa Yerahameeli, yaazaala Maazi, ni Yamini, ni Ekeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.27",
            "verseOrgIds": [
              "1CH.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onamu yaazaala Shammai ni Yada. Ate Shammai yaazaala Nadabu ni Abishuri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishuri yaabayiza omukazi nga ni Abihaili, yaamuzaalamu Ahibani ni Molidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.29",
            "verseOrgIds": [
              "1CH.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate Nadabu yaazaala Seledi ni Appaimu. Aye Seledi yaafa nga tazaireeku mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.30",
            "verseOrgIds": [
              "1CH.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Appaimu yazaala Ishi, Ishi yaazaala Sheshani, ate Sheshani yaazaala Ahalai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yada muganda wa Shammai yaazaala Yetheri ni Yonathani. Aye Yetheri yaafa nga tazaireeku mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.32",
            "verseOrgIds": [
              "1CH.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonathani yaazaala Pelethi ni Zaza. Abo ni baidhukulu ba Yerahameeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheshani tiyazaalaku mwana mulenzi, yazaala baghala beereere. Aye yali n'omwiru we Omumisiri nga ni Yaruha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.34",
            "verseOrgIds": [
              "1CH.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Sheshani yaatoola mughala we yaamugha omwiru we oyo Yaruha yaamubayiza, era yaazaala naye Attai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.35",
            "verseOrgIds": [
              "1CH.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Attai yaazaala Nathani, Nathani yaazaala Zabadi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.36",
            "verseOrgIds": [
              "1CH.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zabadi yaazaala Efulali, Efulali yaazaala Obedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.37",
            "verseOrgIds": [
              "1CH.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedi yaazaala Yehu, Yehu yaazaala Azaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.38",
            "verseOrgIds": [
              "1CH.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria yaazaala Helezi, Helezi yaazaala Eleasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.39",
            "verseOrgIds": [
              "1CH.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleasa yaazaala Sisimai, Sisimai yaazaala Shallumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.40",
            "verseOrgIds": [
              "1CH.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shallumu yaazaala Yekamia, Yekamia yaazaala Elishama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        }
      ]
    },
    {
