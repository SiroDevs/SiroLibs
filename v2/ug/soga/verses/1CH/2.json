            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano n'abaasimuka mu Kalebu: Huri n'eyali omwana omukulu owa Kalebu, ye yazaala mu mukazi we Efuratha. Huri oyo yaazaala Shobali lata wa Kiriathi Yearimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabane we owokubiri Saluma ni lata wa Bethelehemu. Mutabane we owokusatu Harefu ni lata wa Bethigaderi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.51",
            "verseOrgIds": [
              "1CH.2.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
