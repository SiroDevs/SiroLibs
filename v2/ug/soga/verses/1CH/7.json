              "text": "7:23",
              "type": "text"
            },
            {
              "text": "Beria:",
              "type": "text"
            },
            {
              "text": "Eriina eryo livuga ng'ekibono eky'Oluheburayi ekitegeeza “Okuba mu kabi”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuba akabi kaagwira amaka ge.",
          "type": "text",
