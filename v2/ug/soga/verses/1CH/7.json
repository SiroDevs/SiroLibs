          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu yazaala Shuthela, Shuthela yaazaala Beredi, Beredi yaazaala Tahathi, Tahathi yaazaala Eleada, Eleada yaazaala Tahathi, Tahathi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
