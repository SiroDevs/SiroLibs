          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Efuraimu oyo yaaba ni mukazi we mu buliri, omukazi oyo yaatoola enda, yaazaala omwana mulenzi. Efuraimu yaamutuuma eriina Beria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
