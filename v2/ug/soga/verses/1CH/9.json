        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeli yaazaala abaana abalenzi mukaaga, era amaina gaibwe ni gano: Azarikamu, ni Bokeru, ni Ishimaeli, ni Shearia, ni Obadia, ni Hanani. Abo n'abaali batabane ba Azeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
      ]
