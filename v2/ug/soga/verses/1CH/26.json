            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano n'abaali abakuumi b'emiryango gy'eisinzizo: Mu bantu abaasimuka mu Kora, mwalimu Meshelemia mutabane wa Kore ow'oku nda ya Asafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshelemia oyo yazaala abaana abalenzi bano: Zekaria nga n'omuberi, kwairaku Yediaeli, kwairaku Zebadia, kwairaku Yathinieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwairaku Elamu, kwairaku Yehohanani, memale kwairaku Eliehoenai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        }
      ]
    },
    {
