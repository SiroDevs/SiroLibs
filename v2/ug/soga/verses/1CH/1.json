              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku Shemu okutuuka ku Aburamu: Shemu yaazaala Aripakishadi, Aripakishadi yaazaala Shela, Shela yaazaala ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.24",
            "verseOrgIds": [
              "1CH.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eberi, Eberi yaazaala Pelegi, Pelegi yaazaala Reu, Reu yaazaala ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.25",
            "verseOrgIds": [
              "1CH.1.25"
            ]
          }
        },
        {
