        },
        {
          "text": "Hamu yaazaala: Kushi, Misiri, Puti, ni Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.8",
            "verseOrgIds": [
              "1CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
