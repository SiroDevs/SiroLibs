          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "era n'eyasimukamu Abayebusi, n'Abamori, n'Abagirigashi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.14",
            "verseOrgIds": [
              "1CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
