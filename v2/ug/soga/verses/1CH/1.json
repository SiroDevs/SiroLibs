        },
        {
          "text": "Misiri yaazaala: Ludimu, Anami, Lehabu, Nafutu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
        },
