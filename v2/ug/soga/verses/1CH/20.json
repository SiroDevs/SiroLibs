                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho omwaka nga gutoolera, mu kiseera bakyabazinga kye bajiiramu okulwana entalo, Yoabu yaakulembera eigye yaalumba ensi eya Abammoni. Yaazingiza ekibuga Rabba era yaakizikiriza. Aye kyabazinga Daudi yaasigala e Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi oyo yaatoola engule ku mutwe gwa kyabazinga waibwe ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:2",
              "type": "text"
            },
            {
              "text": "kyabazinga waibwe:",
              "type": "text"
            },
            {
              "text": "Oba, ekifaananie eky'omusambwa gwaibwe Moleki. Zef 15",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaagita ku mutwe gwe. Engule eyo yali ya zaabu n'amabaale ag'omughendo einho, ng'ezitogha kilo ng'oti amakumi asatu na ina. Daudi oyo era yaanhaga ebintu kamaala inho mu kibuga ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaatwala n'abantu abaali mu kibuga omwo, yaabakozesanga emirimo nga bakozesa emisumeeni, ensuuluulu, n'empasa. Era atyo bwe yakola abantu boonaboona abaali mu bibuga eby'Abammoni byonabyona. Agho Daudi n'abantu be boonaboona bairayo e Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
