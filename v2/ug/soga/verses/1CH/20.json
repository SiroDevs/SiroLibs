              "items": [
                {
                  "text": "1 Sam 17:4-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kabiri ghaabalukagho olutalo olundi n'Abafilisiti. Elihanani mutabane wa Yairi yaita Lahimi muganda wa Goliathi Omugitti, eyali n'eifumo eryali n'olunhago olunene, olwaga n'ekiti kye balukisa engoye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        }
      ]
