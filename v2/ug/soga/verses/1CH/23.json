              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'ebyo Daudi bye yasembyayo okusikirira abantu, Abalevi abaaba nga bagheziiza emyaka amakumi abiri n'okusingagho bonka, n'abaaghandiikibwanga okukolanga ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
