                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9"
              },
              "items": [
                {
                  "text": "Kub 3:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " emirimo egy'okubeerangaku bakabona ab'oku lulyo lw'Aaroni, mu byonabyona ebigema ku kugheereza mu isinzizo lya Musengwa Katonda, era nga ni gino: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "okulabiriranga ebigema ku migaati egigheebwayo eri Musengwa Katonda, obuwunga bwe baakozesanga mu kigheebwayo eky'emere ey'empeke, emigaati emitono egitazimbulukusiibwa, ebigheebwayo ebifumbibwa, n'ebigheebwayo eby'obuwunga obutabwirwamu omuzigo ogw'ebibala by'emiti emyoliva. Era n'okupimanga obungi, n'obuzito, n'obunene obw'ebigheebwayo mu isinzizo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalevi abo nga bali n'okwebazanga Musengwa Katonda n'okumusaakanga buli nkyo n'eigulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okughangayo eri Musengwa Katonda oyo ebigheebwayo ebyokebwa, ku Sabbato, ni ku buli Kibinuko eky'Okuboneka kw'Omwezi, era ni ku nnaku edhindi edhaateebwagho. Ebyo byonabyona nga bali n'okubikolanga mu maiso ga Musengwa Katonda aghazira kwosaamu naire, era nga bajiira ku mughendo ogulagirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era baagheebwa ogw'okulabiriranga Eweema ey'Okwagaananirangamu ni Musengwa Katonda, n'Ekifo Ekitukuvu, nga babeeraku baganda baibwe bakabona ab'olulyo lwa Aaroni okugheerezanga mu isinzizo lya Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
