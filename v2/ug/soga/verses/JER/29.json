          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yankoba nje nkobe Shemaia ow'e Nehelamu nti ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Afuga Amagye, Katonda wa Isiraeli, akoba ati: Waghandiika embaluwa ku bubwo iwe mwene, waadhigheereza eri abantu boonaboona mu Yerusalemu, n'eri Zefania kabona mutabane wa Maaseia, n'eri bakabona abandi boonaboona, nga dhikoba dhiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zefania yansomera embaluwa eyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "era agho Musengwa Katonda yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gheereza abali mu bunhage boonaboona obukwenda buno obugema ku Shemaia ow'e Nehelamu, oti, ‘Nze Musengwa Katonda nja kubonereza Shemaia oyo n'abaana be era n'abaidhukulu boonaboona. Nze timutumangaku naire, aye yayogera n'imwe ng'oti se mulanzi era yaabaikirizisa eby'obuguya. Mu baidhukulu baimwe timuja kubaamu babe. Era talighangaala kutuuka ku kubona bintu birungi bye nja okukolera abantu bange, kuba yakoba abantu bandheemere nze Musengwa Katonda.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31+JER.29.32",
            "verseOrgIds": [
              "JER.29.31",
              "JER.29.32"
            ]
          }
        }
      ]
    }
