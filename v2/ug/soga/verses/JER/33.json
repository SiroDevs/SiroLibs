              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakola endagaano n'omusana era naakola endagaano n'obwire, nti bibengagho mu kiseera kyabyo ekituufu, era endagaano eyo ghazira asobola kugimenhagho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
