              "attrs": {
                "loc": "2SA.7.12+2SA.7.13+2SA.7.14+2SA.7.15+2SA.7.16"
              },
              "items": [
                {
                  "text": "2 Sam 7:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1 Bakyab 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.11+1CH.17.12+1CH.17.13+1CH.17.14"
              },
              "items": [
                {
                  "text": "1 Byom 17:11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nze Musengwa Katonda nsuubiza nti buliidho ghaidha kubangagho omuntu ku baidhukulu ba Daudi, anaabanga kyabazinga wa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9+NUM.3.10"
              },
              "items": [
                {
                  "text": "Kub 3:5-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Era buliidho ghaidha kubangagho bakabona ab'omu kika kya Levi abanampeerezanga, nga baghaayo ebigheebwayo ebyokebwa, n'ebigheebwayo eby'emere ey'empeke, n'emisengo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
