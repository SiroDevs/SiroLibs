        },
        {
          "text": "Agho Zedekia kyabazinga wa Buyudaaya yaatuma ye ndi Pashuhuri mutabane wa Malakia ni Zefania kabona mutabane wa Maaseia, ng'akoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
