                "loc": "ISA.17.1+ISA.17.2+ISA.17.3"
              },
              "items": [
                {
                  "text": "Isa 17:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.3+AMO.1.4+AMO.1.5"
              },
              "items": [
                {
                  "text": "Amo 1:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.1"
              },
              "items": [
                {
                  "text": "Zek 9:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bino Musengwa Katonda bye yakoba ku Damasiko, ati: “Abantu b'omu bibuga Hamathi ni Arupadi beeraliikirivu era basobeirwa, kuba baawulira amawulire amabi agatiisa. Okweraliikirira kuli kubeefuukuula mu myoyo gyaibwe ng'oti kwefuukuula kwa nhandha. Era bazira miraala naire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.23",
            "verseOrgIds": [
              "JER.49.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 49:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu b'e Damasiko bawoiremu amaani era balumwikegho nga batiire inho. Bali mu bulumi era beeraliikirivu, ng'oti n'omukazi ali kulumwa okuzaala. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.24",
            "verseOrgIds": [
              "JER.49.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 49:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibuga ekyali kimanhikaine einho era nga kirimu eisanhu, buti baakireka bw'agho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.25",
            "verseOrgIds": [
              "JER.49.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 49:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo abazigu baliitira abaisuka b'omu kibuga ekyo mu nguudo dhaakyo, n'abaisirukale baakyo boonaboona baabazikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.26",
            "verseOrgIds": [
              "JER.49.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikunaania omuliro ku bimante ebyezungulwire ekibuga Damasiko, era naayokya ekisaagaati kya kyabazinga Benihadadi. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino Musengwa Katonda bye yakoba ku kika kya Kedari ni ku biketezo ebifugibwa Hazori, kyabazinga Nebukadinezzari ow'e Babilonia bye yaghangula. Yakoba ati: “Muje mulumbe abantu ba Kedari, muzikirize ekika ekyo eky'abantu ab'e buvandhuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.28",
            "verseOrgIds": [
              "JER.49.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhage weema dhaibwe, n'ensuubo dhaamu, n'ebirimu byonabyona. Mutwale ebyayo byaibwe n'engamiya dhaibwe. Era mukobere abantu muti, ‘Buli ghantu ghali ntiisa ndhereere!’",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imwe abantu b'e Hazori, nze Musengwa Katonda mbalabula nti mulumuke muje ghala inho mwegise. Kyabazinga Nebukadinezzari abeesoomeire okubakola akabi, ng'akoba ati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.30",
            "verseOrgIds": [
              "JER.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Mwidhe tuje, tulumbe abantu abo abawulira mule nga bali mu miraala. Ekibuga kyaibwe kiziraku ndhigi, oba okubaaku ebisiba, oba okubaaku abakikuuma.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.31",
            "verseOrgIds": [
              "JER.49.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.31",
            "verseOrgIds": [
              "JER.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Munhage engamiya dhaibwe n'ebyayo byaibwe byonabyona. Abantu abo abasala ku nviiri dhaibwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.32",
            "verseOrgIds": [
              "JER.49.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "49:32:",
              "type": "text"
            },
            {
              "text": "abasala ku nviiri dhaibwe:",
              "type": "text"
            },
            {
              "text": "Abantu abo ab'omu irungu baasalanga ku nviiri dhaibwe okudhiyimpaya, olw'okugha omusambwa gwaibwe ekitiibwa. Kale Abaisiraeli tibaikirizibwanga kusala ku nviiri dhaibwe mu nsambo ng'oti n'eyo ( Lev 19:27).",
              "type": "text"
            }
          ]
        },
        {
          "text": " ndibasansaaniza mu ndhuyi dhoonadhoona. Era ndibatuusaaku akabi nga kava mu ndhuyi dhoonadhoona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.32",
            "verseOrgIds": [
              "JER.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazori kija kufuulibwa irungu ebyanda n'ebyanda, era kibe ekifo omuba obw'ebibe. Abantu tibaliiramu kusengayo. Tighaliba muntu alibangayo kabiri. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Zedekia nga yaakamalanga okufuuka kyabazinga wa Buyudaaya, Musengwa Katonda yaayogera ninze Yeremia, ebigema ku nsi Elamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 49:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba ati: “Nze Musengwa Katonda Afuga Amagye, ndiita abalasa obusaale boonaboona abaleeteire Elamu okuba ey'amaani etyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndireeta kiwunga yaakunta mu nsi Elamu ng'ava ku ndhuyi dhoonadhoona. Olwo naasansaaniza abantu baayo ku ndhuyi dhoonadhoona, okutuusa nga mu buli nsi mulimu abalumukiireyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndireetera abantu ab'e Elamu okutya abazigu baibwe abenda okubaita. Mu busungu bwange obubitirivu, ndibatuusaaku akabi nga mbasindikira entalo edhiribaita okutuusa lwe ndibasaaniagho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizikiriza bakyabazinga baibwe n'abakungu baibwe, naamala naataagho ekityamo kyange eky'obwakyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu biseera eby'oluvainhuma, ndireetera ebintu okwiramu okujiiranga Elamu obukalamu. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
          }
        }
      ]
    }
