        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye nga ghabiseegho ekiseera, ndireetera Abammoni ebintu okwiramu kabiri okubajiiranga obukalamu. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.6",
            "verseOrgIds": [
              "JER.49.6"
            ]
          }
        }
