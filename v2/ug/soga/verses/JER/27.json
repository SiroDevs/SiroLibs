                "loc": "2CH.36.11+2CH.36.12+2CH.36.13"
              },
              "items": [
                {
                  "text": "2 Byom 36:11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwe baali baakamala okufuula Zedekia mutabane wa Yosia abe kyabazinga wa Buyudaaya, Musengwa Katonda yankoba nze Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "neekolereyo ekikoligo mu miti nga ngisibye n'enkoba, nkivaale mu nkoto. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memale mpeereze obukwenda eri bakyabazinga bano: ow'e Edomu, n'ow'e Moabu, n'ow'e Ammoni, n'ow'e Tiro, n'ow'e Sidoni, nga mbita mu bakwenda baibwe abaidha e Yerusalemu okubona kyabazinga Zedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkobe abakwenda ba bakyabazinga abo, bakobere bakyabazinga baibwe abo bati, Musengwa Katonda Afuga Amagye Katonda wa Isiraeli, akoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nze Musengwa Katonda nakozesa obuyinza bwange obungi n'amaani gange agataloodheka, natonda ensi n'abantu baamu, n'ensolo dhaamu dhoonadhoona. Era ensi eyo ngigha oyo ye mba nga nsazeegho okugigha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "BAR.3.16"
              },
              "items": [
                {
                  "text": "Bar 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "BAR.3.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Era mperaano ninze mpaire omugheereza wange, kyabazinga Nebukadinezzari ow'e Babilonia, okufuga amaghanga gano goonagoona. Era naamugha n'ensolo edh'omu nsiko dhoona dhimugheereze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaghanga goonagoona galimugheereza era gaagheereza ni mutabane we ni mwidhukulu we, okutuusa ekiseera bwe kirituuka eighanga lye ni ligwa. Olwo eighanga lye lyona lyafuuka mugheereza wa amaghanga kamaala ag'amaani, agafugibwa bakyabazinga abakologho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye eighanga lyonalyona oba obwakyabazinga, abaliroba okufugibwa Nebukadinezzari, ni baloba okugonda ng'oti n'ensolo bw'egonda n'evaala mu nkoto ekikoligo kya musengwa waayo, ndibabonereza nga mbazikiriza mu ntalo era nga mbasindikira endhala n'endwaire ya kawumpuli bibaite, okutuusa lwe ndireetera Nebukadinezzari oyo okubasaanizaagho irala. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutajiira ku bya balanzi baimwe oba balaguzi baimwe, waire okujiira ku muntu yeenayeena abakoba ati asobola okulagula ebiribaagho ng'abita mu kuvuunula ebirooto, ni mu kukola eby'obulogo n'eby'emizimu. Abantu abo boonaboona babakoba obutaganha kyabazinga w'e Babilonia kubafuga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bye balagula bya buguya, era, imwe, birindeetera nze, okubatwala eghala einho okuva mu nsi yaimwe. Ndibabinga mu nsi yaimwe, mwaja mwazikiririra eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye abantu ab'eighanga, abaliganha okufugibwa kyabazinga Nebukadinezzari ow'e Babilonia, ni bagonda ng'oti n'ensolo bw'egonda n'evaala mu nkoto ekikoligo kya musengwa waayo, ndibaleka baasigala mu nsi yaibwe, baagirimamu emere era baatyama baatereera. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu n'ekirala ekyo, kye nakoba kyabazinga Zedekia ow'e Buyudaaya nti: “Ganha kyabazinga ow'e Babilonia akufuge, ogonde ng'oti n'ensolo bw'egonda n'evaala mu nkoto ekikoligo kya musengwa waayo. Omugheereze mwene n'abantu be, memale obe omulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki iwe n'abantu bo mwenda okufiira mu ntalo, oba okulambuka endhala, oba okufa endwaire ya kawumpuli? Ebyo Musengwa Katonda bye yakoba ati n'ebirituuka ku ighanga lyonalyona eririroba okufugibwa kyabazinga w'e Babilonia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutawulirisa bya balanzi ababakoba bati, ‘Mutaganhanga kugheereza kyabazinga w'e Babilonia’. Abalanzi abo balanga bya buguya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda mwene akoba ati tabatumangaku, kale ni bye balanga mu liina lye bya buguya. Era birireetera Musengwa Katonda oyo okubabinga imwe mu nsi yaimwe, mwaja mwazikiririra eyo ghalala n'abalanzi abo ababaguya.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naakobera bakabona n'abantu abandi nti Musengwa Katonda yakoba ati: “Mutawulirisa bya balanzi abalanga bati, ‘Mubone eno, ebintu by'eisinzizo bali kumpi okubiiza okuva e Babilonia’. Ebyo balanga bya buguya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutawulirisa bye babakoba. Mugondere kyabazinga w'e Babilonia, olwo mwidha kuba balamu. Lwaki ekibuga kino kyandifuuse emungo edh'ebifunfugu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baba nga bwenebwene balanzi, era nga bali n'obukwenda obuva ye ndi, kale bansabe nze Musengwa Katonda Afuga Amagye, ndobe kuganha bintu ebyasigala mu isinzizo ni mu kisaagaati kya kyabazinga kutwalibwa Babilonia.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Afuga Amagye akoba ati, ku bigema ku mpango, ni ku tanka, ni ku bikolo ebityamaku benseni, ni ku bintu ebikozesebwa mu isinzizo ebindi ebyasigala mu kibuga Yerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebintu ebyo, kyabazinga Nebukadinezzari ow'e Babilonia by'ataatwala, lwe yatwala mu bunhage Yekonia mutabane wa Yehoiakimu kyabazinga wa Buyudaaya, n'abakungu boonaboona ab'omu Buyudaaya n'ab'omu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.20",
            "verseOrgIds": [
              "JER.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.20",
            "verseOrgIds": [
              "JER.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Muwulire bino nze Musengwa Katonda Afuga Amagye bye nkoba, ebigema ku bintu ebyasigala mu isinzizo, ni mu kisaagaati kya kyabazinga wa Buyudaaya e Yerusalemu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biidha kutwalibwa e Babilonia, era bisigale eyo okutuusa lwe ndiiramu kabiri okubirowoozaaku, ni mbiiza mu kifo kino. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.22",
            "verseOrgIds": [
              "JER.27.22"
            ]
          }
        }
      ]
    }
  ],
