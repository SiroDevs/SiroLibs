      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Ekiseera kiri kwidha, mbe Katonda w'ebika byonabyona ebya Isiraeli, ate beene babe bantu bange. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bakaali mu irungu nze nagemerwa ekivunika abo abaawonagho ni bataitibwa. Era Abaisiraeli abo bwe beegomba einho okuwuumulaku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.2",
            "verseOrgIds": [
              "JER.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nze nababonekera nga ndi ghala okuva ghe baali. Imwe Abaisiraeli, nze nava ira nga mbagonza, era ndidha kweyongeranga okubagonza obutalekera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.3",
            "verseOrgIds": [
              "JER.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiiramu kabiri okubazimba imwe abantu bange mube eighanga eiyaaka. Muliiramu kabiri okugema obugoma bwaimwe, mwabukuba nga musagamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.4",
            "verseOrgIds": [
              "JER.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muliiramu kabiri okusimba amasamba ag'emizabbibu ku nsozi dh'e Samaria, era abo abaligasimba balirya ku bibala ebigavaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.5",
            "verseOrgIds": [
              "JER.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwenebwene ekiseera kiri kwidha, abakuumi beete nga bali ku nsozi edh'e Efuraimu bati, ‘Mwidhe tuniineniine Sioni, tuje eri Musengwa Katonda waife.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.6",
            "verseOrgIds": [
              "JER.31.6"
            ]
          }
        }
      ]
    },
