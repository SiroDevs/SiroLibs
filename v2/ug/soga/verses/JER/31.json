        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Afuga Amagye, Katonda wa Isiraeli, akoba ati: “Bwendiiza abantu bange mu nsi yaibwe, mu Buyudaaya ni mu bibuga byayo, ni mbaleetera ebintu kabiri okubajiiranga obukalamu, baliiramu okukobanga bati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nze Musengwa Katonda nkoba nti ekiseera kiri kwidha, ndidhuze Isiraeli ni Buyudaaya abantu n'ensolo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
              "JER.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nga bwe nakola einho okubabonereza, n'okubaiwululagho, n'okubamenhamenha, n'okubaleetera okughangulwa, n'okubazikiriza, era ntyo bwe ndifaayo einho okubasimba n'okubazimba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.2"
              },
              "items": [
                {
                  "text": "Ezek 18:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ekiseera ekyo bwe kirituuka abantu baliba tibakaakoba bati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        }
      ]
    },
