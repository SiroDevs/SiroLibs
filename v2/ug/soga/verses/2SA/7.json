            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wo Musengwa Katonda wange, niiwe Katonda, otuukiriza buli ky'okoba, era niiwe osuubiiza nze omugheereza wo ebintu ebyo ebirungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkweghemba iwe Musengwa Katonda wange, oghe enkabi ab'endhu yange nze omugheereza wo, babenga bagonzi y'oli ebyanda n'ebyanda, nga bw'onsuubiiza. Era olw'enkabi dho, ab'endhu yange nze omugheereza wo baidha kubanga ba nkabi ebyanda n'ebyanda.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
      ]
