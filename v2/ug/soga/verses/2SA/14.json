              "2SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kyabazinga yaakoba omukazi ati: “Otangisa kintu kyonakyona ku bye nja okukubuuza.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yaakoba ati: “Isebantu kyabazinga, mbuuza.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
