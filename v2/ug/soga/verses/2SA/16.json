              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abusalomu yaakoba Ahithofeli ati: “Buti tughe ku magezi. Tukole ki?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
