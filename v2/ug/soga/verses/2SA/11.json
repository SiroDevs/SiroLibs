              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathisheba bwe yawulira nga Uria iba bamwise, yaamulira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
