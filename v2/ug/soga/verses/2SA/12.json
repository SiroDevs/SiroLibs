            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:25",
              "type": "text"
            },
            {
              "text": "Yedidia:",
              "type": "text"
            },
            {
              "text": "Mu Luheburayi kitegeeza omugonzi eri Musengwa Katonda.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuba Musengwa Katonda oyo yamugonzanga inho.",
          "type": "text",
