          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Daudi yaagumya mukazi we Bathisheba, yaaba naye mu buliri yaatoola enda, yaazaala omwana mulenzi. Daudi yaatuuma omwana oyo eriina Solomoni. Musengwa Katonda yaagonzanga inho omwana oyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
