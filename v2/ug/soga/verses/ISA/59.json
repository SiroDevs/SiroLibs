          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.26"
              },
              "items": [
                {
                  "text": "Rom 11:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musengwa Katonda era akoba abantu be ati: “Ndija e Sioni okununula baidhukulu ba Yakobo abakyuka ni bava mu kwonoona kwaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 59:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkoze n'imwe endagaano, era mbaghaire obuyinza bwange n'endhegeresa yange, bibenga byaimwe buliidho. Era okuva ni mpegaano mwidha kungonderanga era mwegeresenga abaana baimwe okumpuliranga ebyanda n'ebyanda.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.21",
            "verseOrgIds": [
              "ISA.59.21"
            ]
          }
        }
      ]
    }
