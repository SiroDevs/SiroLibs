            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, abantu balita omwoyo ku Mutonzi waibwe, n'amaiso baagakyukiza eri oyo Omutukuvu wa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balirekera agho okufangayo einho ku alutaari dhe beekolera beene n'engalo edhaibwe, era baalekera agho okwesiganga ebintu obuntu beene bye beekolera ka bibe ebifaananie bya Ashera omusambwa gwaibwe omukazi, oba alutaari edhiniokezebwaku obubbaani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
