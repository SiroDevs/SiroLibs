            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
