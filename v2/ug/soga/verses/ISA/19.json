            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, Abamisiri baliba bati inho ng'oti bakazi. Balitya era baadhugumira, bwe balibona nga Musengwa Katonda Afuga Amagye agalwire omukono okubabonereza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eighanga Buyudaaya lirireeteranga Abamisiri okutya einho. Buli aliwuliranga nga balyogeraku alityanga inho, olw'akabi Musengwa Katonda Afuga Amagye k'ategeike okubakola.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, abantu balyogera olulimi Olukanaani mu bibuga bya Misiri bitaanu, era baalayira mu liina lya Musengwa Katonda Afuga Amagye. Ekibuga ekindi ku ebyo balikyeta, Ekibuga ky'Endhuba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, mu nsi Misiri balizimbamu alutaari yaaba ya Musengwa Katonda, ni ku nsalosalo y'ensi eyo balimuzimbirayo empango ey'amabaale. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo buliba bumanhiso obwoleka nga Musengwa Katonda Afuga Amagye ali mu nsi Misiri. Era abantu bwe balimulirira nga bali kutuntuzibwa, alibatumira omuyambi yaabalwanirira era yaabawonia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo Musengwa Katonda alyeyoleka mu Bamisiri, baamumanha, baamusinza nga baghaayo emisengo n'ebigheebwayo ebyokebwa. Balyeyama y'ali era baatuukiriza bye beeyamye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda alibonereza Abamisiri, aye ate b'abonereiza alimala yaabawonia. Balikyukira y'ali baamusaba, era yaawulira okusaba kwaibwe yaabawonia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, ghalibaagho oluguudo oluva mu Misiri okuja mu Assiria. Abassiria baliidhanga mu Misiri, n'Abamisiri baajanga mu Assiria, era Abamisiri n'Abassiria balisinzizanga ghalala Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, ensi Isiraeli, ni Misiri, ni Assiria, dhiryazayaza ekitiibwa era dhaagheesa ensi yoonayoona enkabi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda Afuga Amagye alidhigha enkabi ng'akoba ati: “Misiri eighanga lyange, ni Assiria nze mwene lye natonda, ni Isiraeli lye nalondamu okuba eryange, gagheebwenga enkabi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
  ],
