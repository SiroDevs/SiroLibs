          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baliidhanga omwo okuyiiga n'obulaso n'obusaale, kuba ensi eyo yoonayoona eriba eidhwire nkandwa na mawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
