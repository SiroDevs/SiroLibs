                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Byom 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mu mwaka kyabazinga Uzzia gwe yafiiramu, nabona Musengwa Katonda ng'atyaime ku kityamo kye eky'obwakyabazinga, ekigungumavu era nga kya kitiisa. Era ng'ekivaalo kye eky'oku ngulu kyeyandhulwiza okubuna eisinzizo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaigulu gha kyabazinga oyo, ghaali nga gheemereiregho ebitonde ebyetebwa serafimu, nga buli kirala kiri n'amaghagha mukaaga: abiri nga kigeeghembye mu maiso, abiri agandi kyageeghemba ku bigere, ate abiri agasigairegho kyagakozesa okuguluka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kitonde kyali nga kiri kukoba kiinaakyo kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
