            "style": "v",
            "sid": "ISA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate eri abagwira abaasenga mu bantu ba Musengwa Katonda, ni bagheereza Musengwa Katonda oyo nga bamugonza, ni beekalangula ku ndagaano ye, era ni bakuuma Sabbato dhe ni batadhoonoona, Musengwa Katonda abakoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.13"
              },
              "items": [
                {
                  "text": "Mat 21:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.17"
              },
              "items": [
                {
                  "text": "Mar 11:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.46"
              },
              "items": [
                {
                  "text": "Luk 19:46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ndibatwala ku Sioni olusozi lwange olutukuvu, naabagha eisanhu mu ndhu yange ey'okusinzizaamu. Ebigheebwayo byaibwe ebyokebwa n'emisengo gyaibwe ndibiikiriza ku alutaari yange, kuba endhu yange enaayetebwanga ndhu ya kusinzizaamu ab'amaghanga goonagoona.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda, oyo asoloza abantu be Abaisiraeli abaabingibwa mu nsi yaibwe, akoba ati alisolozaayo n'abandi, boona baidha beeyongera ku abo abaamala eira okusolozebwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda era akoba ati: “Imwe mwenamwena amaghanga ag'endha mwidhe muzikirize abantu bano ng'oti n'ensolo edh'omu nsiko bwe dhizikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze b'abantu bange bali ng'oti batulu beene. Tibakaalimu magezi, bali ng'oti n'embwa edhitaboigola. Baba mu kuwongera, na mu kutenduka ndoolo, na mu kuloota. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali ng'oti mbwa edh'amairu amangi, edhitaiguta naire. Abakulembeze abo tibakaalimu kategeera, buli muntu yeefubiriire ku bibye, nga yeenooneza by'anaafunamu amagoba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakobagana bati, ‘Mwidhe tufuneyo ku mwenge ogw'emizabbibu tunhweku. Ka twerenge ebitamiiza, n'olwaidho lwona lwidha kuba ng'oti n'olwaleero, era n'okulusingaku.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
    }
