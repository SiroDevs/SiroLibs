                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musengwa Katonda airamu ati: “Natyankirira amaghanga zenka ng'oti n'ole atyanka emizabbibu mu kikunhiro, aye mu bantu mwaloba kubaamu anhambaku. Nagatyankirira n'obusungu bwange, omusaayi gwago gwasambukira ku bivaalo byange byonabyona, byaidhula ebimyamya ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba ekiseera kyali kimaze okutuuka eky'okununula abantu bange, n'okwesasuuliza ku bazigu baibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.16"
              },
              "items": [
                {
                  "text": "Isa 59:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nalingirira inho, aye nga tibona aidha ye ndi kuunhamba. Naatya inho, aye nga ghazira angumya. Kale naakozesa amaani gange n'obusungu bwange, byandeetera okughangula. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natyankatyanka mu busungu amaghanga, naagamanhiangula n'ekiruyi kyange, naayugha ku itaka omusaayi gw'abantu ogubagha obulamu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yakoba ati: “Bwenebwene bano bantu bange, abataja kunguyaguya.” Kale ni yaaba Omulokozi waibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabalumirwa mu kudaazibwadaazibwa kwaibwe kwonakwona, era yaabawonia mwene, se ti malaika we. Era olw'okugonza kwe n'okusaasira kwe by'ali nabyo, yaabanunula era yaabalabiriranga okuva eira n'eira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye baamala beene baadheema, baanakughaza omwoyo gwe omutukuvu. Kale Musengwa Katonda oyo yaakyuka yaafuuka muzigu waibwe, era yaabalwanisa mwene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
