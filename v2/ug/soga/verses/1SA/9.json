              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsambo eyo Saulo yaaliira ghalala ni Samueli ku lunaku olwo. Bwe baava agho mu kifo ekigulumivu eky'okusinzizaamu, baaja mu kibuga. Baayalira Saulo obuliri ku ngulu kw'endhu, yaalambaala okwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:25",
              "type": "text"
            },
            {
              "text": "... Ku ngulu kw'endhu ...",
              "type": "text"
            },
            {
              "text": "Obusolya bw'endhu tibwabangaku migongo. Kale ng'omuntu asobola okuniinayo yaalambaala eyo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
