              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho obwire nga buli kukya, Samueli yaayeta Saulo ghaigulu ku ndhu, ng'amukoba ati: “Situkagho nkusiibule oje.” Agho Saulo yaasitukagho, baafuluma bombi ni Samueli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka ekibuga ghe kikanga, Samueli yaakoba Saulo ati: “Koba omugheereza wo abitegho, ajenga emberi. Iwe oyemerereku ghano katono, nkumanhise Katonda ky'akobye.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
            "verseOrgIds": [
              "1SA.9.27"
            ]
          }
        }
