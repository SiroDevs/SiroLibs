              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwe neewozaaku olwasooka ghazira yali ku luuyi lwange, boonaboona bandekulira agho. Aye Katonda mmusaba alobe kubalanga ekyo! ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        },
        {
          "name": "verse",
