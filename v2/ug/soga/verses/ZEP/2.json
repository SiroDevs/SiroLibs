          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe Abafilisiti ababa mu kiketezo eky'oku nhandha, mukagwireku, kuba Musengwa Katonda abasaliire omusango okubasinga. Aidha kubazikiriza mwenamwena ghabule asigalagho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiketezo kyaimwe eky'oku nhandha kija kufuuka kyayiro, nga kiidhwire entindi edh'abaayi n'ebigo eby'ebyayo byaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiketezo ekyo eky'oku nhandha kija kufuuka kya Bayudaaya. Eyo ye balyayiranga ebyayo byaibwe, era baasula mu ndhu edh'omu kibuga Ashikeloni kuba Musengwa Katonda waibwe aidha kubalabiriranga, abaleetere ebintu kabiri okubajiiranga obukalamu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
