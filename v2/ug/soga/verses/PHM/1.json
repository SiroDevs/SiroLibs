        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninze Paulo, omusibe olwa Kurisito Yesu, era ni Timotheo muganda waife.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpandiikira mukagwa waife era mukozi munaife Filemoni, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni Affia mwanhina ife, ni Arikippo mulwani munaife, era n'Ekikunsu eky'Abaikiriza mu Kurisito ekyesololeza mu ndhu yo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.17"
              },
              "items": [
                {
                  "text": "Kol 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda era Lata waife, ni Musengwa Yesu Kurisito abaghe enkabi n'emiraala.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buliidho nkwidhukira mu kusaba kwange era naasiima Katonda wange. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.4",
            "verseOrgIds": [
              "PHM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba mpulira okugonza kw'ogonzaamu abatuukirivu boonaboona, era n'okwikiriza kw'oli nakwo mu Musengwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.5",
            "verseOrgIds": [
              "PHM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nsaba nti okwisania kwaife n'iwe mu kwikiriza, kutwongere okumanha ebirungi bye tuli nabyo mu Kurisito. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.6",
            "verseOrgIds": [
              "PHM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganda wange, okugonza kwo kundeeteire okusagamba einho era n'okwiramu amaani, kuba ku lulwo emyoyo gy'abatuukirivu, giize buyaaka.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'okugonza kw'ogonzaamu abatuukirivu boonaboona, nze ng'owoluganda mu Kurisito tikyandintiisiisa kukulagira bulagire kukola ekyo ekigwaine. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.8",
            "verseOrgIds": [
              "PHM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye olw'okuba tugonzania, nkweghemba bweghembe, waire nga ninze Paulo omukwenda wa Kurisito Yesu, era omusibe ku lwa Kurisito oyo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi kukweghemba ku lw'omwana wange Onesimo eyafuuka omwana wange nga ndi musibe.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.10",
            "verseOrgIds": [
              "PHM.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.9"
              },
              "items": [
                {
                  "text": "Kol 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.10",
            "verseOrgIds": [
              "PHM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eira tiyakugasanga, aye mperaano yafuuka wa mugaso ye iwe ninze. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.11",
            "verseOrgIds": [
              "PHM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi kumutuma aire y'oli, aye nga mmugonza inho. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.12",
            "verseOrgIds": [
              "PHM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandyenze inho mmusigaze ghano ninze, anhambe mu kifo kyo nga ndi mu busibe buno bwe ndimu olw'Amawulire Amalungi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.13",
            "verseOrgIds": [
              "PHM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye tyayenda kukola kintu kyonakyona nga toganhie olwo obuyambi bwonabwona bw'okola bube nga buviire mu mwoyo gwo mwene aghazira kukakibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba katyo kyali nti Onesimo yali ali n'okukuvaaku entangama entonotono, memale aghange okwira okuba owuwo ekiseera kyonakyona. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.15",
            "verseOrgIds": [
              "PHM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mperaano ti mwiru bwiru kyonka, aye asinga omwiru: buti waluganda waife, omugonzi einho ye nze, aye ate okusingira irala ye iwe. Kuba mwiru ate kabiri yaaba muganda wo mu Musengwa!",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeeni oba nga nze ndi mwino, Onesimo musangaalire oti ni bwe wandisangaaliire nze. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.17",
            "verseOrgIds": [
              "PHM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba nga ghaligho ekibi kye yakukola oba ekintu ky'omubandha, kibale ku nze. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.18",
            "verseOrgIds": [
              "PHM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino nkighandiise n'omukono gwange mwene nti: nze Paulo ndidha kukusasula. Ndidhi nti ni bwe ntakwidhukiza, okiidhi bukalamu ng'okaali kunsasula olw'obulamu bwo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.19",
            "verseOrgIds": [
              "PHM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni owoluganda, nkolera eky'omugaso ku lwa Musengwa. Kola ekinaasangaaza omwoyo gwange mu Kurisito.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga neesiga obugonvu bwo, mpandiise nga ndidhi nti oidha kukola ekisingagho ku ekyo kye nsabye.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.21",
            "verseOrgIds": [
              "PHM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.21",
            "verseOrgIds": [
              "PHM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekindi kye nsaba, ntegekeraayo agh'okusula ng'omugeni, kuba ndi kusuubira nti Katonda aidha kwiramu okusaba kwaimwe mwenamwena andhize ye muli.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.22",
            "verseOrgIds": [
              "PHM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.22",
            "verseOrgIds": [
              "PHM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafura musibe munange ku lwa Kurisito Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
