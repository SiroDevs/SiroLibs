        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Musa bwe yagabaniamu Abaisiraeli ekiketezo ky'e Moabu ekiri e buvandhuba wa Yeriko ni Yorudani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ekika eky'Abalevi tiyakigha mugabo. Yabakoba ati omugabo gwaibwe gwidha kuvanga ku binaagheebwangayo eri Musengwa Katonda wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.33",
            "verseOrgIds": [
              "JOS.13.33"
            ]
          }
