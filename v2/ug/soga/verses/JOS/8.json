          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yoshua yaasomera abantu amateeka goonagoona nga bawulira, ng'omwo n'omuli n'enkabi, n'ebikolimo, nga bwe byaghandiikibwa mu kitabo eky'Amateeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ebyo Musa bye yalagira ghazira Yoshua ky'ataasoma, era mu Baisiraeli abeesoloza okumuwulira ng'asoma, n'omwali abakazi, n'abaana, n'abasenze abaali baba aghalala n'Abaisiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
      ]
