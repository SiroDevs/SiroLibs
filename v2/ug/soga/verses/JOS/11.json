                {
                  "text": "Ma 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo, Yoshua yaja yaazikiriza olulyo olw'abantu abawaigufu abaayetebwanga Abanaki, abaabanga mu bibuga Heburoni, Debiri, Anabu, ni mu biketezo byonabyona eby'ensozi eby'omu Buyudaaya ni mu Isiraeli. Yoshua yabazikiriza boonaboona n'ebibuga byaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biketezo byonabyona eby'Abaisiraeli timwasigala Muanaki waire mulala, okutoolaku abatonotono abaasigalaku mu Gaza, Gathi ni mu Ashidodi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale atyo Yoshua bwe yanhaga ekiketezo ekyo kyonakyona eky'ensi, nga Musengwa Katonda bwe yalagira Musa. Yoshua yaamala yaakigabaniamu mu Baisiraeli boonaboona, buli kika nga kifunaku aghaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu baalekera okulwana entalo baafunaku emiraala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    }
  ],
