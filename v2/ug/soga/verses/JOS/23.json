                {
                  "text": "Ma 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.30"
              },
              "items": [
                {
                  "text": "32:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buti ni mufubenga inho okugonza Musengwa Katonda waimwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwemutaliba beesigwa eri Musengwa Katonda, aye ni musalagho okukolagana n'abantu abo abanaasigalanga mu biketezo bye tuja okunhaga, ni mubayiza baghala baibwe, era boona ni mubaganha babayize baghala baimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.12",
            "verseOrgIds": [
              "JOS.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo mumanhanga nga Musengwa Katonda waimwe aliba takaabingagho maghanga ago mu buli kiketezo ghe munaatuukanga. Amaghanga ago gaja kubafuukira ekizibu ng'oti lutuula oba olwina oluleeyi. Era ng'obulumi bwe gabaleetera buli ng'oti bwa muntu ye bakubye enkoba mu mugongo, oba ali n'eiwa mu liiso, okutuusa lwe mulizikirira ni muva ku nsi eno enungi, Musengwa Katonda waimwe ye yabagha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Buti ndi mu lugendo, ndi kuja e magombe nga badhaadha boonaboona bwe baaja. Mwenamwena mwidhi bukalamu mu myoyo gyaimwe ng'ebirungi byonabyona Musengwa Katonda waimwe bye yabasuubiza, ghazira ky'ataatuukiriza. Byonabyona yabikola era ghazira kyamulema. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ng'ebirungi byonabyona bye yabasuubiza bwe yabituukiriza, n'ebibi byonabyona bye yeesoomera okubakola, atyo bw'alibituukiriza, okutuusa lw'alibazikiriza ni muwa ku nsi eno enungi ye yabagha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasita muloba okukuuma endagaano Musengwa Katonda waimwe ye yabalagira okukuuma, ni mugheereza era ni musinza bakatonda abandi, aja kubasungughalira era ababonereze okutuusa lwe mulizikirira ni muwa ku nsi eno enungi ye yabagha.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        }
      ]
    }
  ],
