              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboluganda, mbeeghemba ku bwa Musengwa waife Yesu Kurisito era n'olw'okugonza kwa Mwoyo Mutukuvu mweyimbe ghalala ninze mu kunsabira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munsabire mpone abataikiriza abali mu Buyudaaya, era n'abantu ba Katonda abali mu Yerusalemu basiime bye mbatwalira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo ni Katonda bw'aliba nga asiimye ndiidha okubakyalira nga ndi n'eisanhu lingi, mpuumulireku e waimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda mwene kugaba miraala, abe n'imwe mwenamwena. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
