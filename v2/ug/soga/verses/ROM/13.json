    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi muntu agonderanga abafuzi, kuba ghazira bufuzi butava wa Katonda era abafuzi abaligho baateebwagho Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.1",
            "verseOrgIds": [
              "ROM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni kiisi adheemera abafuzi, aba adheemeire abo Katonda be yataagho, era aba yeereeseeku mwene omusango ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.2",
            "verseOrgIds": [
              "ROM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba abafuzi baba babi y'abo abakola ebibi, aye ti y'abo abakola ebikalamu. Oyenda omufuzi obutakutiisa? Kale kola ebikalamu era aidha kukusiima, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.3",
            "verseOrgIds": [
              "ROM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba oyo mugheereza wa Katonda olw'okukugasa iwe. Aye bw'okola ebibi, mutye, kuba obufuzi bwe ti bwa busa, mugheereza wa Katonda era abonereza abo abakola ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.4",
            "verseOrgIds": [
              "ROM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni mugwaine okugondera abafuzi ti lwa kutya kubonerezebwa kyonka, aye n'olw'okugondera omwoyo gwaimwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno n'ensonga lwaki mugha omusolo, kuba abafuzi baba bagheereza ba Katonda bwe batuukiriza emirimo gyaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
