          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ng'Abaisiraeli abaanoonia obutuukirivu obujiira ku Mateeka, tibaasobola kutuukiriza Mateeka ago. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
