          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "waire obugungumavu, waire okwika ghansi, waire ekitonde ekindi kyonakyona, tibirisobola kututoola ku kugonza kwa Katonda okuli mu Kurisito Yesu Musengwa waife.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.39",
