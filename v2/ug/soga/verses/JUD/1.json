              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugumyenga abo abaikiriza n'emyoyo ebiri ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
