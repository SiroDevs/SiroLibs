          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JUD 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda omulala ati Omulokozi waife ng'abita mu Yesu Kurisito Musengwa waife, agheebwe ekitiisa, obufuzi, amaani n'obuyinza okuva ku ntoolo, na buti, n'okutuusa ebyanda n'ebyanda. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.25",
            "verseOrgIds": [
              "JUD.1.25"
            ]
