          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda oyo ow'obusobozi obubakuuma ni mutagwa, ni bubatuusa mu maiso ge ag'ekitiisa nga muziraku musango gwonagwona era nga musagamba, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
            "verseOrgIds": [
              "JUD.1.24"
            ]
          }
        },
