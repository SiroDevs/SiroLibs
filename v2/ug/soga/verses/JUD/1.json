          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "muwonieku abandi nga mubaghendula mu muliro. Abandi mu basaasire aye nga mubatya, nga mwesambira irala n'ebivaalo byaibwe ebyayonebwa ebikolwa byaibwe eby'omubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
