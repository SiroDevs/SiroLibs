              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bano buli kaseera baba mu kutolooma olw'obutasiima, bageyigeyi, bajiira ku kwegomba kwa mibiri gyaibwe, beesaaka era baasuutiriza abantu nga bali ni kye babendaku.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        }
