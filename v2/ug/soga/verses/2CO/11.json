          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda era Lata wa Musengwa waife Yesu, asaakibwa ebyanda n'ebyanda, aidhi nga tiri kuguya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
