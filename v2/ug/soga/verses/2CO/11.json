          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaire n'okukola einho n'amaani era emikuzi kamaala nga nsula titendwike, ndi ndhala, n'endigho enuma ate nga nzira na mere ya kulya, naaba mu mpewo nga nzira na kya kwebwika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku ebyo, naataaku buli lunaku obuzito obw'okweraliikirira olw'Ebikunsu eby'Abaikiriza mu Kurisito byonabyona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ghabaagho anafughaire, zeena nnafughala bweghabaagho agwisiibwa mu kibi, nsiriira omwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
