              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ngendo dhange kamaala nfunie obuzibu obw'emiigo, obw'abanhazi, obuva mu Bayudaaya banange n'obuva mu bamaghanga agandi. Mbaire mu buzibu mu bibuga ni mu malungu, ku nhandha, era n'okuva y'abo abeeyeta aboluganda ate nga tibali.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
