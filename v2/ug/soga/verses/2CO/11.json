              "type": "text"
            }
          ]
        },
        {
          "text": "Emikuzi esatu nakubwa emiigo olundi bankuba amabaale. Emikuzi esatu eryato lyatudimiraku, naasula era naasiiba mu nhandha.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
