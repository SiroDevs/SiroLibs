                  "text": "Bik 9:23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwe nali mu Damasiko, omufuzi eyateebwagho kyabazinga Areta, yakuuma ekibuga Damasiko angeme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
