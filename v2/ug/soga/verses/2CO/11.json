              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe mba nga ndi wa kwesaaka ndidha kwesaaka olw'ebyo ebyoleka obunafu bwange. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
