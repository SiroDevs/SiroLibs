          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twogera tuti kuba tuli n'obwesige mu Katonda, Kurisito bw'atugha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.4",
            "verseOrgIds": [
              "2CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife ku bwaife tuzira bughanzi butusobozesa kukola kintu kyonakyona, obughanzi bwaife buva wa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo n'eyatusobozesa okuba abagheereza ab'endagaano empyaka, etali ya mateeka maghandiike aye ey'amateeka aga Mwoyo. Amateeka amaghandiike galeeta kufa, aye Mwoyo aleeta bulamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.31"
              },
              "items": [
                {
                  "text": "Yer 31:31",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amateeka amaghandiike gaabaadhibwa mu nukuta ku bipande eby'amabaale, era bwe gaali gagheebwa ghaaligho okumesunkana kunene. Amaiso ga Musa gaaliku okumesunkana okwo, era waire kwali nga kuli kukendeera, Abaisiraeli baali nga tibasobola kumwekalirisa mu maiso. Kale oba nga Amateeka agaleeta okufa gaagheebwa mu kumesunkana okwaga agho,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.29"
              },
              "items": [
                {
                  "text": "Kuv 34:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "okugheebwa kwa Mwoyo tikulibaaku kumesunkana kusinga okwo? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba nga okugha ekyo ekireetera abantu okusalirwa omusango okubasinga, kwaliku okumesunkana, memale okugha ekyo ekireetera abantu obutuukirivu tikulisingagho mu kumesunkana? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu butuufu ekyo ekyaliku okumesunkana, mperaano tikikaaliku kumesunkana naire, olw'okumesunkana kule okubitamu einho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba oba nga ekyawaagho kyaliku okumesunkana, memale ekyo ekitawaagho tikiteekwa kubaaku kumesunkana okusinga agho?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bwe tuli n'obwesige oti n'obwo, tuli bagumu inho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.12",
            "verseOrgIds": [
              "2CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tituli oti ni Musa eyali n'okweghemberera ekitambaala mu maiso, Abaisiraeli balobe kubona okumesunkana okusembayo okw'amaiso ge nga kuwaagho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
            "verseOrgIds": [
              "2CO.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.33"
              },
              "items": [
                {
                  "text": "Kuv 34:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
            "verseOrgIds": [
              "2CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye emyoyo gyaibwe gyakalanguka, kuba n'okutuukiza irala buti, bwe basoma endagaano enkaire, ekitambaala kyene ekyo kikaabaghembereire. Kurisito yenka n'asobola okutoolagho ekitambaala ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwene ni ye buli eno buli lwe basoma ebyaghandiikibwa bya Musa, emyoyo gyaibwe giba mighembe gyaku ekitambaala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
              "2CO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omuntu bw'agalukira ye Musengwa ekitambaala kitoolebwagho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.16",
            "verseOrgIds": [
              "2CO.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.34"
              },
              "items": [
                {
                  "text": "Kuv 34:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.16",
            "verseOrgIds": [
              "2CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa ni Mwoyo, era Mwoyo wa Musengwa gh'aba, ghaba eidembe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.17",
            "verseOrgIds": [
              "2CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ife twenatwena bwe tutoolebwaku ekitughembye ku maiso, tubonerwamu okumesunkana kwa Musengwa ng'oti mbonerwamu. Okumesunkana okuva ye Musengwa era nga ni Mwoyo, kutufuula twafaanana nga mwene mu kumesunkana okuja nga kweyongera.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.18",
            "verseOrgIds": [
              "2CO.3.18"
            ]
          }
        }
      ]
    }
  ],
