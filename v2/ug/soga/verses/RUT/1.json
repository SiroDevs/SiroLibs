          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atyo Naomi bwe yaira ng'ava e Moabu yaira ni Ruthi Omumoabu, namwandu wa mutabane eyafiira e Moabu. Baatuuka e Bethelehemu ng'abantu baakatoolera okukungula sayiri.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.22",
            "verseOrgIds": [
              "RUT.1.22"
            ]
          }
        }
      ]
    }
