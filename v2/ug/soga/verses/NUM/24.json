              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Balaamu ng'akaali mu kubonekerwa, yaabona Abamaleki era yaayogera ebibono eby'obulanzi bino, ati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
