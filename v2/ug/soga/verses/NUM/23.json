          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Balaki yaakoba Balaamu ati: “Onkoze ki kino? Nakuleese kukolimira bazigu bange, aye kabiri iwe waabula ekindi ky'okola okutoolaku okubasabira obw'enkabi?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        }
      ]
