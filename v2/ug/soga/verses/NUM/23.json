              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu yaakoba Balaki ati: “Yemerera kumpi n'ekigheebwayo kyo ekyokebwa, nze nje ere ndhagaanane ni Musengwa Katonda.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
