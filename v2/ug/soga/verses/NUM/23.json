            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Balaamu yaayogera ebibono eby'obulanzi bino, ati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
