              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu yaakoba Balaki ati: “Nzimbira ghano alutaari musanvu, era ondeetere ghano ente enume musanvu n'entaama enume musanvu.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki yaakola nga Balaamu bweyamukoba, era bombi baagheerayo ku buli alutaari, ente enume ndala n'entaama enume ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu yaakoba Balaki ati: “Yemerera kumpi n'ekigheebwayo kyo ekyokebwa. Nze ka nje mbone oba nga Musengwa anaidha okwagaanana ninze. Era buli ky'anandholeka kyonakyona, ndidha kwira nkikukobere.” Agho yaaja yaaniina ghaigulu ku lusozi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda yaayagaanana ni Balaamu oyo. Balaamu yaakoba Katonda ati: “Mmaze okutegeka alutaari musanvu era ku buli ndala mpeereireyo ekigheebwayo kya nte enume ndala n'entaama enume ndala.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
