          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale yaatwala Balaamu oyo ghaigulu ku lusozi Peori olulingiriire eirungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
