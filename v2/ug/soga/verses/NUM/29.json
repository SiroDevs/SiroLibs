          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nnaku edho omusanvu mwidha kughangayo ekigheebwayo ekyokebwa ekiri n'akawoowo akansangaaza nze Musengwa Katonda.",
          "type": "text",
