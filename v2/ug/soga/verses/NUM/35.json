        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ole bw'anaitanga omuntu, aidha kwitibwanga nga ghamaze kubaagho obudhulizi obumulumiriza obuswika obw'omuntu omulala. Aye omudhulizi amulumiriza bw'anaabanga omulala ati yenka, omuntu oyo taitibwenga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
