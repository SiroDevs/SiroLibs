              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olusooka mu mwezi ogwokubiri, mu mwaka ogwokubiri kasookanga Baisiraeli bava mu nsi Misiri, Musengwa Katonda yayogera ni Musa, mu irungu ery'e Sinai, mu Weema ey'Okwagaananirangamu ni Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
