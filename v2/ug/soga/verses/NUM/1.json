              "attrs": {
                "loc": "NUM.26.1+NUM.26.2+NUM.26.3+NUM.26.4+NUM.26.5+NUM.26.6+NUM.26.7+NUM.26.8+NUM.26.9+NUM.26.10+NUM.26.11+NUM.26.12+NUM.26.13+NUM.26.14+NUM.26.15+NUM.26.16+NUM.26.17+NUM.26.18+NUM.26.19+NUM.26.20+NUM.26.21+NUM.26.22+NUM.26.23+NUM.26.24+NUM.26.25+NUM.26.26+NUM.26.27+NUM.26.28+NUM.26.29+NUM.26.30+NUM.26.31+NUM.26.32+NUM.26.33+NUM.26.34+NUM.26.35+NUM.26.36+NUM.26.37+NUM.26.38+NUM.26.39+NUM.26.40+NUM.26.41+NUM.26.42+NUM.26.43+NUM.26.44+NUM.26.45+NUM.26.46+NUM.26.47+NUM.26.48+NUM.26.49+NUM.26.50+NUM.26.51"
              },
              "items": [
                {
                  "text": "Kub 26:1-51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yaamukoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mubale Abaisiraeli boonaboona abali mu buli kika ni mu buli nda. Mughandiike amaina ag'abasaadha boonaboona ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abagheza emyaka amakumi abiri n'okusingagho, abasobola okulwana mu lutalo. Iwe ni Aaroni mubabale. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu buli kika mwidha kuvaamu omukulu waakyo mukole naye.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano n'amaina ag'abantu abo be muja okukola nabo:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo n'abakulembeze abaalondebwa okuva mu bantu boonaboona Abaisiraeli, era nga n'abakulu ab'ebika eby'Abaisiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ni Aaroni baatwala abantu abo aboogeirwaku, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "baayeta abantu boonaboona Abaisiraeli beesololeza ghalala ku lunaku olusooka mu mwezi ogwokubiri. Baaghandiika amaina ag'abantu boonaboona mu bika byaibwe ni mu nda dhaibwe, abaali bagheza emyaka amakumi abiri n'okusingagho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale atyo Musa yaaghandiika abantu era yaababalira mu irungu ery'e Sinai nga Musengwa Katonda bweyamulagira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaina ag'abantu abaali nga bagheza emyaka amakumi abiri n'okusingagho, abaali basobola okulwana mu lutalo, gaaghandiikibwa nga gajiira ku bika byaibwe ni ku nda dhaibwe. Baatoolera n'ab'ekika kya Reubeni mutabane wa Yakobo omuberi, obungi bwaibwe nga bwaga buti:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
