              "NUM.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa yaasaba Musengwa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wo Musengwa Katonda, Katonda ow'emyoyo era n'emibiri, londa mu bantu bano, oyo anaaba omukulu waibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu aidha okubakulemberangamu era abakuumenga mu buli kye banaakolanga. Olwo abantu bo abo, iwe Musengwa Katonda, balobe kubanga ng'oti n'entaama edhiziraku mwayi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
