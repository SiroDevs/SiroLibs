            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaakoba Musa ati: “Niina ku lusozi luno Abarimu olengere ensi ye mpaire Abaisiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Ma 3:23-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
