              "attrs": {
                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "32:48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onaamala okugirengera, oidha kutwalibwa weeyimbe ku bantu bo abaafa, nga muganda wo Aaroni bweyatwalibwa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba mwadheemera ekiragiro kyange mu irungu ery'e Zini. Abantu bwe beemuluguunhia nga muli gha maadhi ag'e Meriba mu Kadeshi, timwayoleka bantu abo nga nze ndi n'obuyinza.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
