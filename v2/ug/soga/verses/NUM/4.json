          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baali kanaana na bitaanu na kinaana (8,580). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.48",
            "verseOrgIds": [
              "NUM.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
