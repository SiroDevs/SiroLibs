          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa ni Aaroni n'abakulembeze b'Abaisiraeli baabala Abalevi abasaadha ab'olulyo lwa Kohathi, nga bajiira ku nsimuko dhaibwe ni ku nda dhaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.34",
            "verseOrgIds": [
              "NUM.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
