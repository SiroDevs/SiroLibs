          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabala Abasaadha ab'emyaka okuva ku makumi asatu okutuuka ku ataanu, abaikirizibwa okungira ni bakola emirimo mu Weema ey'Okwagaananirangamu ni Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.35",
            "verseOrgIds": [
              "NUM.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
