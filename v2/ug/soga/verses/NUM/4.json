          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baali enkumi ibiri na lusanvu n'ataanu (2,750).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.36",
            "verseOrgIds": [
              "NUM.4.36"
            ]
          }
