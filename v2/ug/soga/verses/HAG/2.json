              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku lwene olwo olwabiri n'eina Musengwa Katonda era yaayogera ni Haggai omulanzi omukuzi ogwokubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "verse",
