          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaaba ni Rakeli yeena era yaamwenda inho okusinga Leeya. Agho Yakobo yaakolera Labani okumala emyaka egindi musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
    },
    {
