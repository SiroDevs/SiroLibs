              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuti iwe tootukolengaku kabi, nga ife twena bwe tutaakukolaku kabi. Twakukolera bikalamu byereere, era twakuleka waaja miraala. Mpegaano Musengwa Katonda niiwe y'aghaire enkabi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
