            "sid": "GEN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.27",
            "verseOrgIds": [
              "GEN.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwidhuzo nga guwoire, Noa yaaghangaala emyaka egindi ebikumi bisatu n'ataanu (350), ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.28",
            "verseOrgIds": [
              "GEN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "era yaafa ng'agheza emyaka lwenda n'ataanu egy'obukulu (950).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.29",
            "verseOrgIds": [
              "GEN.9.29"
            ]
          }
        }
      ]
    }
  ],
