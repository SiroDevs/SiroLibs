              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamughayira bati: “Yosefu akaali mulamu, era n'afuga ensi yoonayoona ey'e Misiri.” Yakobo omwoyo gwamwezinduka era yaaloba kwikiriza kye bakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bwe baamughayira ebyo byonabyona Yosefu bye yabakoba, era n'abona ebigaali eby'okutambuliraku Yosefu bye yasindika okumutwaliraku, yairamu omwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
