          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yeeghemba ise ati: “Bbaaba, enkabi oli na ndala eti yonka? Wo bbaaba nkweghembye zeena nsabira enkabi!” Agho yaatoolera okuwowoola.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        }
