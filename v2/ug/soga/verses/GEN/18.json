              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yaakoba ati: “Wo Musengwa Katonda otansungughalira, ndidha kwogera kabiri: Aye bwe kiba nga eriyo makumi asatu?” Musengwa Katonda yairamu ati: “Tiidha kukizikiriza bwe nnaayagaanayo amakumi asatu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yaakoba ati: “Wo Musengwa, nsonigha okukana ni ndhogera n'iwe ntyo. Aye bwe kiba ng'eriyo amakumi abiri?” Musengwa yairamu ati: “Tiidha kukizikiriza olw'abatuufu amakumi abiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yaakoba ati: “Wo Musengwa, otansungughalira, ndidha kwogera mukuzi guno gwonka. Aye bwe kiba ng'eriyo ikumi bonka?” Musengwa yairamu ati: “Tiidha kukizikiriza olw'abatuufu eikumi abo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
