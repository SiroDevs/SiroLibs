          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda bweyamala okwogera ni Aburahamu, yaaja. Ni Aburahamu yeena yaira ewuwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
