              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli baaba mu nsi y'e Misiri, mu kiketezo eky'e Gosheni. Baakombaghalira omwo, era baazaala abaana kamaala, beeyongera okwala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
