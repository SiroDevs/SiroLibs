          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaamala emyaka ikumi na musanvu mu nsi y'e Misiri; kale yaaba ng'agheziiza emyaka kikumi n'ana na musanvu (147) egy'obukulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        },
        {
          "name": "verse",
