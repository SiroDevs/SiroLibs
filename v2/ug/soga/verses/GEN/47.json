          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli bweyali ng'anaatera okufa, yaayeta omwana we Yosefu, yaamukoba ati: “Ngemerwa ekivunika, oleete omukono gwo okakase by'oja okulayira: layira oti tolinziika mu Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
