          },
          "items": [
            {
              "text": "9:27",
              "type": "text"
            },
            {
              "text": "Ekyenhinhalwa Ekizikiriza:",
              "type": "text"
            },
            {
              "text": "Ekifaananie eky'omusambwa ogw'abamaghanga agandi ekyateebwagho mu isinzizo mu Yerusalemu ( 1 Bamak 1:54-61).",
              "type": "text"
            }
          ]
        },
        {
          "text": " okutuusa enkomerero eyategekerwa oyo azikiriza bw'erituuka.”",
          "type": "text",
