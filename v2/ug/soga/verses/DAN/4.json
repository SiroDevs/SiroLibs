              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwe nairamu okutegeera obukalamu, Katonda yandhiriza obwakyabazinga bwange nairamu okuba ow'ekitiisa era omukologho. Abawi bange ab'amagezi n'abakungu bange, baidha baaneisuusaayo era bandhiza ku bwakyabazinga bwange. Neeyongeraku okuba omukologho okusinga bwe nalinga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        }
      ]
    },
