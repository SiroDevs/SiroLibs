              "DAN.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kaseera keene ako ebibono ebyo byatuukirira ku Nebukadinezzari. Baamubinga baamutoola mu bantu, yaalyanga isubi ng'oti nte, n'omusulo oguva ku igulu gwamukubanga yaabola. Era enviiri dhe dhaakula dhaaleegha ng'oti mooya ga nkookooma, n'enkumu dhe dhaaleegha ng'oti dha nhonhi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        }
      ]
    },
