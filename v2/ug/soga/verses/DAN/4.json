              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kale ni Isebantu kyabazinga, amakulu ni gano: Ekyo, oyo Ali Ghaigulu Yeene, n'ekyo kye yalagira ekija okukutuukaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baidha kukubinga bakutoole mu bantu, bakusindike mu nsolo edh'omu nsiko. Omale emyaka musanvu ng'olyanga isubi ng'oti nte, n'omusulo oguva ku igulu gukukubenga obole, okutuusa lw'olimanha ng'oyo Ali Ghaigulu Yeene n'afuga obwakyabazinga obw'abantu. Era ng'abugha oyo y'ayenda yeenayeena. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nga malaika bwe yalagira okulekagho ekikolo eky'omuti ogwo mu itaka, obwakyabazinga bwo baliiramu okubukugha, bw'olimala okwatula oti Katonda n'afuga ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TOB.12.9"
              },
              "items": [
                {
                  "text": "Tob 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.3.30"
              },
              "items": [
                {
                  "text": "Sir 3:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Agho ni, Isebantu kyabazinga, ganha amagezi ge nja okukugha: Lekera okukola ebibi okole ebituufu, era olekere okwonoona oyoleke okusaasira eri abo abanhigirizibwa. Oba katyo, olwo ebintu binaakujiiranga bukalamu.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byonabyona byatuuka ku kyabazinga Nebukadinezzari. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Nebukadinezzari oyo bwe yali ali kutambulatambula ghaigulu ku ngulu okw'endhu ye ey'obwakyabazinga, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:29",
              "type": "text"
            },
            {
              "text": "... ku ngulu kw'endhu ...:",
              "type": "text"
            },
            {
              "text": "Obusulya obw'endhu tibwabangaku migongo. Kale ng'omuntu asobola okutambuliraku obukalamu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nga ghaakabitagho emyezi ikumi n'ebiri, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaakoba ati: “Ha, bona Babiloni bwekiri ekikologho! Nakizimba n'obukumu bwange n'amaani gange, kibe ekibuga omuli ekisaagaati kyange eky'obwakyabazinga obw'ekitiisa.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
