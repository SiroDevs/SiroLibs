        },
        {
          "text": " Era bangi ku abo abali e magombe abaafa balizuukira, abandi baliba mu bulamu obutawaagho ate abandi baaba mu kuswazibwa n'okunhoomebwa okutakoma. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
