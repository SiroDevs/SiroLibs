              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Esid 7:97",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abakulembeze abagezi balimesunkana ng'oti n'okumesunkana okw'oku igulu. N'abo abakyusa abantu ni bakola ebituufu balyakaayakana ng'oti muunienie ebyanda n'ebyanda.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        }
      ]
