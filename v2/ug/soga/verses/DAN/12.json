              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yandhiramu ati: “Danieli, gema engira yo oje, kuba ebintu ebyo biidha kukuumibwa nga bya kyama era bikwekebwe okutuusa ku kiseera eky'enkomerero. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.9",
            "verseOrgIds": [
              "DAN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.11"
              },
              "items": [
                {
                  "text": "Kwol 22:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abantu kamaala balinaazibwa, baatukuzibwa era baizibwa buyaaka. Aye ababi balyeyongera bwa kukola bibi, era ezira waire omulala ati ku babi abo alitegeera. Aye abagezi balitegeera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.10",
            "verseOrgIds": [
              "DAN.12.10"
            ]
          }
        }
      ]
    },
