              "items": [
                {
                  "text": "Mar 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Okuva abantu lwe balirekera okughaayo ebigheebwayo ebyokebwa ebya buli lunaku, ng'Ekyenhinhalwa Ekizikiriza kimaze okuteebwagho, ghalibaagho enaku lukumi na bibiri na kyenda (1,290). ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba nkabi abo abalisigala nga beesigwa okutuusa enaku olukumi n'ebisatu n'asatu n'eitaanu (1,335) lwe dhiriwaaku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        }
      ]
    },
