            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kale ni iwe Danieli, gema engira yo oje, osigale ng'oli mwesigwa okutuusa ku nkomerero. Era waire olifa, olimala waazuukira wagheebwa empeera yo mu kiseera eky'oluvainhuma.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
