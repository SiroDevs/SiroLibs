              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho mu mwaka ogwokubiri nga kyabazinga Asa n'afuga Buyudaaya, Nadabu mutabane wa Yeroboamu yaafuuka kyabazinga wa Isiraeli, era yaafugira entangama ya myaka ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakola ebibi eri Musengwa Katonda nga lata we bwe yakola n'ayonoona, era n'aleetera ni Isiraeli okwonoona.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
