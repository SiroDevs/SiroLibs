                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Lwe 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yayiiya ensambo enkumi isatu (3,000), n'enhembo edhiswika mu lukumi (1,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
