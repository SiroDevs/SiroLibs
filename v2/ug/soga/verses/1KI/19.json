    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaamukoba ati: “Irayo mu irungu ery'e Damasiko. Bw'onaatuukayo, oidha kusiiga Hazaeli omuzigo afuuke kyabazinga wa Siria, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "osiige ni Yehu mutabane wa Nimushi abe kyabazinga wa Isiraeli, era osiige ni Elisha mutabane wa Shafati ow'e Abeli Mehola abe omulanzi mu kifo kyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale omuntu yeenayeena anaawonanga okwitibwa Hazaeli, aidha kwitibwanga Yehu. Ate anaawonanga okwitibwa Yehu, aidha kwitibwanga Elisha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        }
      ]
    },
