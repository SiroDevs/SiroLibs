              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye ndirekagho abantu kasanvu (7,000) mu Isiraeli, abo boonaboona abataakubiranga Baali makiryaivu era abataamunhwegeranga.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        },
