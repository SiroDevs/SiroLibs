                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka ogwasooka ogwa kyabazinga Kuro okufuga Perusia, Musengwa Katonda yatuukiriza ekyo kye yayogera ng'abita mu Yeremia omulanzi. Musengwa Katonda oyo yaleetera kyabazinga Kuro oyo okulangirira ekiragiro mu bwakyabazinga bwe bwonabwona, nga kighandiikiibwa kiti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Isa 44:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kyabazinga Kuro ow'e Perusia akoba ati: Musengwa Katonda ow'eigulu, yampa obwakyabazinga bwonabwona obw'oku nsi, era ampaire obuvunaanizibwa okumuzimbira eisinzizo e Yerusalemu ekiri mu Buyudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaba Katonda abe n'imwe mwenamwena abantu be. Mwidha kuja e Yerusalemu ekiri mu Buyudaaya, muzimbe buyaaka eisinzizo lya Musengwa Katonda, Katonda wa Isiraeli, oyo ni Katonda ali mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi Muyudaaya yeenayeena eyawonagho, eyo yoonayoona ye yasenga, agwaine ayambibwe abantu b'aba nabo aghalala, nga bamugha ebintu bino: feeza, ni zaabu, n'ebintu ebindi ebikozesebwa, n'ensolo ng'okwo kw'otaire n'ebigheebwayo eby'ekyeyendere eby'okughaayo mu isinzizo lya Katonda eriri mu Yerusalemu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abakulu b'enda dha baiseibwe mu bika, ekya Yuda n'ekya Benjamini, ni bakabona, n'Abalevi abandi, na buli muntu yeenayeena Katonda ye yaleetera okwenda okuja, baasituka okuja okuzimba obuyaaka eisinzizo lya Musengwa Katonda mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu be baabanga nabo aghalala, baabayamba nga babagha ebintu ebya feeza, ni zaabu, n'ebintu ebindi, n'ensolo, n'ebintu eby'omughendo einho, nga kw'otaire n'ebigheebwayo eby'ekyeyendere.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kyabazinga Kuro yaafulumya ebintu eby'omu isinzizo lya Musengwa Katonda, kyabazinga Nebukadinezzari bye yali atoire mu Yerusalemu n'abitwala n'abita mu masabo ag'emisambwa gye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuro oyo kyabazinga w'e Perusia, yaagemya ebintu ebyo Mithuredathi omughanika, eyabibala n'abigha Sheshibazzari eyali nga n'omufuzi ow'e Buyudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guno n'ogwali omughendo gwabyo:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byonabyona ebya zaabu n'ebya feeza aghalala, byali enkumi itaanu na bina (5,400). Ebintu ebyo byonabyona Sheshibazzari yabitwala e Yerusalemu ghalala n'abaali mu bunhage, okuva mu nsi Babilonia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
