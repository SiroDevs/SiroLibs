          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luno n'olukalala olw'abasaadha abaali babayiiza abakazi abamaghanga agandi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        }
