              "items": [
                {
                  "text": "12:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.7"
              },
              "items": [
                {
                  "text": "Mar 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
