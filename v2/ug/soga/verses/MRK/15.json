          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
