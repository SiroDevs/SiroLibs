          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omukulu ow'ekikunsu eky'abaisirukale ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        },
        {
          "text": " eyali ayemereire agho mu maiso bwe yabona nga bw'aisiiza omuuka ogusembayo, yaakoba ati: “Bwenebwene omuntu ono abaire Mwana wa Katonda!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
