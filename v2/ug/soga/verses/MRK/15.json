          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaabaagho omuntu mulala, yaalumuka yainhika ekyangu mu mwenge ogw'emizabbibu ogw'endoota, yaakita ku lugada, yaamugha anhwe nga bw'akoba ati: “Muleke tubone oba nga Eliya anaidha yaamughanula ku musalaba!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
