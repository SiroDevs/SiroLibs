          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho olusuubo olw'omu isinzizo lwakanukamu ghabiri okuva ghaigulu okutuuka ghansi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
