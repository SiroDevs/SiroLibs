          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusango gwe baamulanga gwaghandiikibwa guti: “KYABAZINGA OW'ABAYUDAAYA!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era baamukomerera n'abanhazi babiri omulala ku mukono omusaadha, ate owundi ku mugooda. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.27",
            "verseOrgIds": [
              "MRK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekighandiiko ekitukuvu kyatuukirira ekikoba kiti: “Yabalirwa mu babi.”]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        },
