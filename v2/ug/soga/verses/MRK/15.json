          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi abo baabitanga naye ng'ali e Galilaaya era baamugheerezanga ghalala n'abandi kamaala abaaniinaniina naye e Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
