              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababise baamuvuma, baatengeesa emitwe gyaibwe nga bakoba bati: “Ha! Iwe amenha eisinzizo era waalizimba mu nnaku isatu!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
