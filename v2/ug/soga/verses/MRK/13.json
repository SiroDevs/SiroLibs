          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye ghazira aidhi lunaku olwo oba saawa ni bwebaakaba bamalaika mu igulu, waire Omwana, okutoolaku Lata.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
