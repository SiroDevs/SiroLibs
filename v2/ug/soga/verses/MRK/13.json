          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ng'atuma bamalaika nga basoloza abalonde be okuva mu mpewo eina, okuva ensi y'ekoma okutuuka eigulu ye likoma.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
