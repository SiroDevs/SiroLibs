          ]
        },
        {
          "text": "kuba ghaliidhagho abeeyeta Kurisito n'abeeyeta abalanzi, baakola obumanhiso n'ebyewuunhio nga benda kuwubania abalondemu bwe kiba kisoboka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
              "MRK.13.22"
            ]
