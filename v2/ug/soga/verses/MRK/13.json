          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kiri ng'omuntu avaagho n'aja eghala, n'aleka amaka ge ng'aghaire abagheereza be obuyinza ate n'emirimo emyawufu buli mugheereza. Era oyo ali ku mulyango n'amulagira okukuumanga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
