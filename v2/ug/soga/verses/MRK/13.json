          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye imwe mwekuume, mbakobeire byonabyona nga bukaali.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.23",
            "verseOrgIds": [
              "MRK.13.23"
