        },
        {
          "text": "“Agho ni, bweghabaagho abakoba ati, ‘Bona, Kurisito wuuno’, oba ati, ‘Wuule’, mutaikirizanga ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
