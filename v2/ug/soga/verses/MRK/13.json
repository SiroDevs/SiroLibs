              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.36+LUK.12.37+LUK.12.38"
              },
              "items": [
                {
                  "text": "Luk 12:36-38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale mumoge, kuba timwidhi mwene ghaka gh'atuukira, oba igulo, oba mu bwire ghagati, oba mu nkoko nga dhikolyoka, oba nga bukya! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale bw'abagwaku alobe kubaagaana nga mutendwike. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kye nkoba imwe, kye nkoba boonaboona nti mwekuume!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.37",
            "verseOrgIds": [
              "MRK.13.37"
            ]
          }
        }
