              "items": [
                {
                  "text": "Mainh 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Era ninze eyazikiriza abandi ku imwe nga bwe nazikiriza ab'e Sodoma n'ab'e Gomorra. Imwe abaawonagho mwaba ng'oti n'oluti olutooleibwa mu muliro. Aye era mwaloba okwira ye ndi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        }
