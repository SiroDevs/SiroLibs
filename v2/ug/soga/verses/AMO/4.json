                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.12.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ninze eyabasindikira endhala mu bibuga byaimwe byonabyona, emere yaabula buli ghantu woonawoona. Aye era mwaloba okwira ye ndi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagemerera amaadhi gaaloba kugwa mu kiseera ebirime byaimwe ghe byageetaagira einho, ng'ekaabulayo emyezi esatu okutuuka ku kukungula. Naatoonhesaaku amaadhi mu kibuga ekindi aye nga mu kindi tigagwa. Amaadhi gaagwa mu musiri ogundi aye ogundi gwakala olw'amaadhi obutagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale abantu ab'omu bibuga ebibiri oba ebisatu, baaja nga batambulatambula eyo batyo mu kibuga ekirala okufuna ku maadhi ag'okunhwa, aye nga ti gabamala. Aye era mwaloba okwira ye ndi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Era ninze eyasindikira ebisimbe byaimwe okuvuluka n'okwengerera, era naakaza emisiri gyaimwe n'amasamba gaimwe ag'emizabbibu. Enzige dhaidha dhaalya emiti gyaimwe emitiini n'emyoliva. Aye era mwaloba okwira ye ndi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Era ninze eyabasindikira ebibamba okubagwaku, ng'ebyo ebyagwa ku Bamisiri. Naita abaisuka baimwe mu lutalo era abazigu baaja n'embalaasi dhaimwe. Era naidhuza enhindo dhaimwe ekivundu eky'emirambo woonawoona ghe mwasimba weema dhaimwe. Aye era mwaloba okwira ye ndi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        }
      ]
    },
