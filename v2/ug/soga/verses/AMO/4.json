          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kale ni Baisiraeli imwe, nja kubabonereza era olw'ekyo mwetegekerenga omusango gwe nja okubasalira.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
