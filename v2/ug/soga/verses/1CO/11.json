    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukolenga nga nze, era nga zeena bwe nkola nga Kurisito bye yakola.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.16"
              },
              "items": [
                {
                  "text": "1 Kor 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.17"
              },
              "items": [
                {
                  "text": "Fil 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukola bukalamu kuba buliidho mundidhukira, era mwagema butiribiri ebyo bye nabeegeresa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nhenda mumanhe nga Kurisito n'afuga buli musaadha, omusaadha n'afuga mukazi we, era Katonda n'afuga Kurisito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale omusaadha asaba, oba akobera abantu ekibono kya Katonda nga yeeghembye ku mutwe aswaza Kurisito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omukazi yeenayeena asaba oba akobera abantu ekibono kya Katonda nga tiyeeghembye ku mutwe aswaza iba kuba omukazi oyo azira ndhawulo na mukazi amweireku nviiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi bw'ateeghemba ku mutwe kiba kikalamu okusalaku enviiri dhe. Aye nga bwe kiswaza omukazi okusalaku, oba okughalagata omutwe, ateekwa okweghemba ku mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha tikimwetaagisa kweghemba ku mutwe, kuba omusaadha n'ekifaananie era n'ekitiisa kya Katonda, aye omukazi n'ekitiisa ky'omusaadha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26+GEN.1.27"
              },
              "items": [
                {
                  "text": "Mainh 1:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba omusaadha tiyatondebwa ng'ava mu mukazi, aye omukazi n'eyava mu musaadha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.18+GEN.2.19+GEN.2.20+GEN.2.21+GEN.2.22+GEN.2.23"
              },
              "items": [
                {
                  "text": "Mainh 2:18-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era omusaadha tiyatondebwa ku lwa mukazi, aye omukazi n'eyatondebwa ku lw'omusaadha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lwa bamalaika omukazi agwaine okweghembanga ku mutwe kyoleke ng'afugibwa iba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu Musengwa omukazi tabaagho yenka nga ghazira musaadha, n'omusaadha tabaagho yenka nga ghazira mukazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'omukazi bwe yatondebwa ng'ava mu musaadha, mu nsambo n'endala omusaadha azaalibwa mukazi, era ebintu byonabyona biva ye Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe beene mukibone. Kikalamu omukazi okusaba Katonda nga tiyeeghembye ku mutwe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutonde bwonka tibubalaga ng'omusaadha okupiita enviiri kimuswaza, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye ng'omukazi okupiita enviiri kimubonesa bukalamu? Kuba omukazi dhaamugheebwa ng'ebyokweghemba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omuntu yeenayeena bw'ayenda okukitakania, akimanhe nga ife n'Ebikunsu eby'Abaikiriza mu Kurisito ebya Katonda, tuzira ngeri yindi mu kusaba okutoolaku eno.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kino kye nja okubeegeresa nhenda okubakobera nti timukola bukalamu mu kwesoloza kwaimwe, kuba ebivaamu ti biba bikalamu aye bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusookera irala, mpulira mbu bwe mwesoloza ng'Ekikunsu eky'Abaikiriza mu Kurisito, mwekutulakutulamu obukunsu, era zeena kino ndi oti nkikakasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye era okwekutulakutulamu kuli n'okubaagho, memale abatuufu mu imwe bamanhike. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe mwesoloza, bye mulya ti n'ekyeigulo kya Musengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba bwe muba nga mulya buli muntu atoolera bwa kulya mere ye nga tateeze bandi, abandi baasigala ndhala, ate nga abandi batamiire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki? Muzira maka gaimwe mwe musobola kuliira na kunhwera? Oba munhooma bunhoome Ekikunsu eky'Abaikiriza mu Kurisito ekya Katonda, na kuswaza abo abazira ke bali nako? Munsuubira kubakoba ki ku nsonga eno? Munsuubira kubasiima? Bbe, tiidha kubasiima.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwegeresebwa kwe nafuna okuva ye Musengwa zeena kwe nabagha. Obwire Musengwa Yesu bwe baamugheerayo, yagema omugaati, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "era bwe yamala okusiima Katonda, yaagumegulamu era yaakoba ati: “Guno n'omubiri gwange oguligho ku lwaimwe. Mukolenga kino olw'okundidhukiranga.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsambo n'endala, bwe baamala okulya ekyeigulo yaagema ekikopo yakoba ati: “Ekikopo kino n'endagaano empyaka ekakasibwa n'omusaayi gwange. Buli lwe munaakinhwangaku, mukikolenga olw'okundidhukira.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.6+EXO.24.7+EXO.24.8"
              },
              "items": [
                {
                  "text": "Kuv 24:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.31+JER.31.32+JER.31.33+JER.31.34"
              },
              "items": [
                {
                  "text": "Yer 31:31-34",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kitegeeza kiti buli lwe mulya ku mugaati guno, era ni munhwa ku kikopo kino, munaabanga muli kumanhisa okufa kwa Musengwa okutuusa lw'aliira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale buli alya omugaati oba anhwa ku kikopo mu nsambo etagheesa Musengwa kitiisa, aiza omusango ku mubiri n'omusaayi gwa Musengwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.27",
            "verseOrgIds": [
              "1CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ni, buli muntu ateekwa kwebona oba nga agwaine, memale yaalya ku mugaati, era yaanhwa ku kikopo ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba buli alya ku mugaati, era n'anhwa ku kikopo nga tategeire makulu ga mubiri gwa Musengwa, yeereetera mwene omusango okumusinga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
              "1CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno n'ensonga lwaki bangi ku imwe muli balwaire, era banafu, era n'abandi baafa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ife beene nkuli tusooka twebona oba nga tugwaine, Katonda tiyanditusaliire musango. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
            "verseOrgIds": [
              "1CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Musengwa bw'atusalira omusango n'atukangaivula, atwegeresa tulobe kusalirwa musango kutusinga aghalala n'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale aboluganda, bwe mwesolozanga okuliira aghalala, mulindengaku banaimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
              "1CO.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ghabangagho endhala y'eruma, asookenga kulya ka ewuwe memale olwo okwesoloza kwaimwe kulobe kubaviirangamu Katonda kubasalira musango. Ebindi ndibibakobera nga ndidhie.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
            "verseOrgIds": [
              "1CO.11.34"
            ]
          }
        }
      ]
    }
