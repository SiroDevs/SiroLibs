            "sid": "JAS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninze Yakobo omugheereza wa Katonda, era owa Musengwa Yesu Kurisito.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
