          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye ku lunaku Loti lwe yafuluma mu Sodoma, omuliro n'obunhota byamagalika okuva mu igulu byabazikiriza boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo bwe kiriba ku lunaku Omwana w'Omuntu lw'alibonekeraku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo, oyo aliba ku ndhu ku ngulu aye nga ebibye biri mu ndhu atairanga inhuma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
