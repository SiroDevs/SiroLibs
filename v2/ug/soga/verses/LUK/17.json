              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwidhukire muka Loti ekyamutuukaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.32",
            "verseOrgIds": [
              "LUK.17.32"
            ]
          }
