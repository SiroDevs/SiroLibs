              "type": "tag",
              "attrs": {
                "loc": "LUK.21.37"
              },
              "items": [
                {
                  "text": "Luk 21:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye baalemwa okubona eky'okukola kuba abantu boonaboona nga bwe bamuwulirisa, tibenda kulekera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
            "verseOrgIds": [
              "LUK.19.48"
            ]
          }
        }
