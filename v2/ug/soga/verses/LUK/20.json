              "LUK.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo abandi ku Banamateeka baamukoba bati: “Mwegeresa, oizeemu bukalamu!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era okuva olwo tibairayo kukana kumubuuza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaabuuza ati: “Lwaki bakoba bati Kurisito mwidhukulu wa Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate nga Daudi mwene akoba mu kitabo kya Zabbuli ati,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
