            }
          ]
        },
        {
          "text": "aghazira kutiisibwa bazigu baimwe mu nsambo yoonayoona. Kano n'akamanhiso ka Katonda akabooleka nga baja kuzikirizibwa, ate akooleka imwe nga muja kulokolebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
