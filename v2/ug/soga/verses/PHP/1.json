              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba mwagheebwa enkabi okwikiriza Kurisito era n'okudaagadaaga ku lulwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
            "verseOrgIds": [
