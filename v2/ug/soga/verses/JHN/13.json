                "loc": "2JN.1.5"
              },
              "items": [
                {
                  "text": "2 Yoa 5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi muntu bw'agonzanga mwine, ku ekyo abantu boonaboona kwe balimanhira nga muli beegeresebwa bange.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petero yaamubuuza ati: “Musengwa olaga gha?” Yesu yaamwiramu ati: “Mperaano toghanga kuunonereza ye ndaga, aye oidha kuunonereza ye bwidha.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero yaamukoba ati: “Musengwa lwaki tighanga kukunonereza mperaano? Ndidha kughaayo obulamu bwange ku lulwo!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamwiramu ati: “Onaaghaayo obulamu bwo ku lwange? Bwenebwene ka nkukobere: enkoko teidha kukolyoka ng'okaali kuneegaana emikuzi esatu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.38",
            "verseOrgIds": [
              "JHN.13.38"
            ]
          }
        }
      ]
    }
