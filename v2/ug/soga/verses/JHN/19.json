          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kabiri ekyaghandiikibwa ekindi kikoba kiti: “Baliringa ku ole ye baafumita.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
