          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho nga batoola mulambo gwa Yesu, nga baguzinga mu ngoye endheru ghalala n'obuwoowo, ng'empisa ey'Abayudaaya mu kuziika bwe yali.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        }
      ]
