              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mperaano, agho mu kifo ghe baakomerera Yesu ghaaligho enimiro omwali amagombe amayaaka agaali tigateebwangamuuku mufu yeenayeena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
