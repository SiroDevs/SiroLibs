              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamukoba ati: “Oikiriiza lwa kuba omboine. Ba nkabi abaikiriza nga tibaboineeku.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
