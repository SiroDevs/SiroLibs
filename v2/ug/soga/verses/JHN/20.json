          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriyo ebyewuunhio ebindi kamaala Yesu bye yakola ng'Abeegeresebwa be babona ebitaaghandiikibwa mu kitabo kino. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
