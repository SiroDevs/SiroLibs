          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
