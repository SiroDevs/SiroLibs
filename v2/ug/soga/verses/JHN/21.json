              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero bwe yamubona yaakoba Yesu ati: “Musengwa, ate ono aliba atya?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        },
