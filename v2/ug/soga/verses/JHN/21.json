                "loc": "JHN.13.25"
              },
              "items": [
                {
                  "text": "Yoa 13:25",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
