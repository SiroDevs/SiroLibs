          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamwiramu ati: “Bwe nhenda abeegho okutuusa lwe ndiidha, ofaayo ki? Iwe nnonereza.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        }
