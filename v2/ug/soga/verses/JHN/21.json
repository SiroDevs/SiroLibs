              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ono n'Omwegeresebwa omudhulizi w'ebintu bino era eyabighandiika era twidhi ng'obudhulizi bwe bwa mazima.",
          "type": "text",
          "attrs": {
