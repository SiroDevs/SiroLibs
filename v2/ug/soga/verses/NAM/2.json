          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba Musengwa Katonda aja kwirizaagho Yakobo ekitiibwa kye ekyo nga n'ekitiibwa eky'Abaisiraeli ekyaligho ng'abazigu bakaali kwidha abaanhaga ebintu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
