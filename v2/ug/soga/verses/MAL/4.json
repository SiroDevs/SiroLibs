          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo alireetera balata b'abaana okwisania n'abaana baibwe, olwo ndobe kwidha kuzikiriza nsi yaimwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
