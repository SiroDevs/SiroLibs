        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Musengwa Katonda Afuga Amagye akoba ati: “Olwo ndiseeta ye muli naasala omusango. Amangu geene ndirumiriza abalogo, abenzi, abalayira eby'obuguya, abakupankupania empeera y'abapakasi, abakiriga banamwandu ni bamulekwa n'abasenze, n'abo boonaboona abatantya.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        }
      ]
    },
    {
