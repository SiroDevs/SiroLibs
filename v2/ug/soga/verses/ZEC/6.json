      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabiri naafuna okubonekerwa okundi, era okuja okulinga nti nga mbona ebigaali eby'omu lutalo bina biri kuviira ghagati gh'ensozi ibiri. Ensozi edho dhaali nga dha kyuma kya kikomo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.1",
            "verseOrgIds": [
              "ZEC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.4"
              },
              "items": [
                {
                  "text": "Kwol 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ekigaali ekyasooka kyali n'embalaasi dha kasaayisaayi nga dhiri kukighaluza, ate ekyokubiri kyaba n'embalaasi ndhirugavu nga n'edhiri kukighaluza. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.2",
            "verseOrgIds": [
              "ZEC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.2"
              },
              "items": [
                {
                  "text": "Kwol 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ekigaali ekyokusatu kyali n'embalaasi ndheru nga dhiri kukighaluza, ate ekyokuna kyaba n'embalaasi dha kikuusikuusi nga n'edhiri kukighaluza. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.3",
            "verseOrgIds": [
              "ZEC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naabuza malaika eyali ali kwogeranga ninze nti: “Musengwa, ebigaali eby'omu lutalo ebyo bitegeeza ki?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.4",
            "verseOrgIds": [
              "ZEC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
