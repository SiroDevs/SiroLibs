            "style": "v",
            "sid": "ZEC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'eghala baliidha baayamba mu kuzimba obuyaaka eisinzizo lya Musengwa Katonda, olwo mwamanha nga Musengwa Katonda Afuga Amagye n'eyantuma ye muli. Ebyo birituukirira, bwe muligondera n'omwoyo omulala ebyo Musengwa Katonda waimwe by'alagira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    }
