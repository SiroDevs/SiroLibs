            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.20"
              },
              "items": [
                {
                  "text": "Mat 24:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Kwol 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Era ndita mu baidhukulu ba Daudi ni mu bantu ab'omu Yerusalemu abandi boonaboona, omwoyo omusaasizi era ogwenda einho okusinza. Kale bwe baliringa ku ole ye baafumita, balimulira ng'oti n'omuntu alira omwana we y'abaire naye yenka ati. Baliwowoola ng'oti n'omuntu alira omwana we omuberi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo, okulira mu Yerusalemu kuliba kwa maani ng'oti bwe baalira Hadadi Rimmoni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:11:",
              "type": "text"
            },
            {
              "text": "Hadadi Rimmoni:",
              "type": "text"
            },
            {
              "text": "Lino liri ng'oti lyali liina lya musambwa ogwetebwa Baali, abantu gwe baatwalanga okuba nga ni katonda ow'ebimera, era nga bagusinza mu Kanaani ni mu Siria. Buli mwaka ebimera bwe byafanga, abo abagusinza baaguliranga nga balowooza bati gwona gufiire.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mu kiketezo eky'oku museetwe e Megiddo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yoonayoona eririra amaziga, nga buli maka galira lwago: Abasaadha ab'omu maka ag'oku nda ya Daudi balirira ku lwaibwe, ni bakazi baibwe boona baalira ku lwaibwe. Abasaadha ab'omu maka ag'oku nda ya Nathani balirira ku lwaibwe, ni bakazi baibwe boona baalira ku lwaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaadha ab'omu maka ag'oku nda ya Levi balirira ku lwaibwe, ni bakazi baibwe boona baalira ku lwaibwe. Abasaadha ab'omu maka ag'oku nda ya Shimei balirira ku lwaibwe, ni bakazi baibwe boona baalira ku lwaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mu maka agasigaireyo goonagoona, abasaadha aba buli mu maka balirira ku lwaibwe, ni bakazi baibwe boona baalira ku lwaibwe.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
