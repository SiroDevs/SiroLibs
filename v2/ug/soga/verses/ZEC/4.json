          "items": [
            {
              "text": "4:10b-14:",
              "type": "text"
            },
            {
              "text": "Mu Baibuli edhindi, obunhiriri obwo babutoola ghano ghe buli baabwizaayo einhuma ku kanhiriri 5, olw'okusobozesa amakulu okutegeerekeka obukalamu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Malaika era yankoba ati: “Entaala omusanvu dh'oboine, ago n'amaiso ga Musengwa Katonda agabona woonawoona ku nsi.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        }
      ]
    },
