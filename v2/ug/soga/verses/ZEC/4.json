              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho naamubuuza nti: “Ate emiti emyoliva ebiri egiri ku mbali kw'ekikondo ekyo, ogundi ku luuyi olw'omukono omusaadha n'ogundi ku luuyi olw'omugooda, gitegeeza ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era naamubuuza nti: “Ensaga eibiri edh'omuti omwoliva edhiri ku mbali okw'emikonda ebiri egya zaabu egikozesebwa okwitulula amafuta ag'entaala, dhitegeeza ki?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
      ]
