              "HOS.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuzi ogwasooka Musengwa Katonda okwogerera mu Hosea, Musengwa Katonda oyo yakoba Hosea ati: “Ja ofumbirwe omukazi atali mwesigwa malaaya, ozaale naye abaana ab'obwamalaaya, kuba abantu bange banviireku nze Musengwa Katonda, tibakaali beesigwa naire.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Hosea yaaja, yaafumbirwa Gomeri mughala wa Dibulaimu, era Gomeri oyo yaatoola enda, yaazaala omwana mulenzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
