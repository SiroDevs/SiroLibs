            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Rom 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli baliba bangi inho ng'oti musenho gwa ku nhandha ogutasoboka kubalibwa oba okupimwa. Mperaano Katonda abakoba ati: “Timuli bantu bange,” aye ekiseera kirituuka yaabakoba ati: “Muli baana ba Katonda omulamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'omu Buyudaaya n'ab'omu Isiraeli baliiramu okuba aghalala, beerondera omukulembeze mulala. Era ebintu biriiramu okubajiira obukalamu mu nsi yaibwe. Bwenebwene olunaku lw'e Yezireeli luliba lukologho inho.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
