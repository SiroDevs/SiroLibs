                "loc": "1KI.8.27"
              },
              "items": [
                {
                  "text": "1 Bakyab 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.5"
              },
              "items": [
                {
                  "text": "Isa 42:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.48"
              },
              "items": [
                {
                  "text": "Bik 7:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oyo ghazira kye yeetaaga bantu kumukolera, kuba oyo n'abagha obulamu na buli kintu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muntu omulala Katonda ye yatonda, n'omwava amaghanga goonagoona ag'abantu agabunia ensi. Yasooka okubateeragho ebiseera ebigere, n'ensalo edh'ebifo mwe banaabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo bamwagale nga bali n'eisuubi ery'okumubona, waire nga tali ghala na kiisi mulala ku ife ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
