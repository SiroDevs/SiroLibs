          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukulu w'abaisirukale yaamuganha. Paulo yaayemerera ku madaala yaaghemya abantu. Bwe baasirika yaayogera nabo mu lulimi Oluheburayi, yaakoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
