              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
