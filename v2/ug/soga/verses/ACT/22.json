              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukulu w'ekikunsu eky'abaisirukale olwawulira ekyo, yaaja y'omukulu ow'abaisirukale yaamukoba ati: “Oja kukola ki? Omusaadha ono Muroma!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        }
      ]
    },
    {
