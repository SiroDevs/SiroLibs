          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangu ago abo abaali baja okumukuba baamuleka era n'omukulu ow'abaisirukale yaatya bwe yamanha nga Paulo ye yasiba Muroma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
