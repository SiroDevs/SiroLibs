          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho omukulu ow'abaisirukale yaaja ye Paulo yaamubuuza ati: “Nkobera, oli Muroma?” Paulo yairamu ati: “Yii.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukulu ow'abaisirukale yairamu ati: “Nze okufuna Oburoma kyantwalaku ebintu kamaala.” Paulo yaamwiramu ati: “Aye nze nazaalibwa nga ndi Muroma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        }
      ]
