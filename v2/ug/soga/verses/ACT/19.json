      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apollo bwe yali mu Korintho, Paulo yaabita mu kiketezo eky'eitale yaatuuka mu Efeso, yaayagaanayo abandi ku baikiriza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaababuuza ati: “Mwafuna Mwoyo Mutukuvu bwe mwaikiriza?” Baamwiramu bati: “Tituwuliranga naku tuti eriyo Mwoyo Mutukuvu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabakoba ati: “Kale okubatizibwa kwaimwe kwali kwa nsambo ki?” Baamwiramu bati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okubatizibwa kwa Yoanne.” Paulo yaabakoba ati: “Yoanne yabatiza n'okubatizibwa okw'okwenenia, yaakoba abantu baikirize oyo amuvaaku einhuma, oyo nga ni Yesu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
