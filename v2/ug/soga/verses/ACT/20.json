          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo bwe yamala okwogera ebyo yaakuba amakiryaivu nabo, yaasaba nabo boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonaboona baalira, baamwevumba, baamunhwegera. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyasinga okubanakughaza n'okubakoba ati tibakairayo kumubona. Baamugherekeraku okumutuusa ku lyato.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
            "verseOrgIds": [
              "ACT.20.38"
            ]
