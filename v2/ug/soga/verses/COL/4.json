          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arisitaruko musibe munange abalamwisa ni Mariko omwiwa wa Barunaba. Mariko ono ni ye nabakoberaku nti bw'aidhanga ye muli mumusangaaliranga.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
