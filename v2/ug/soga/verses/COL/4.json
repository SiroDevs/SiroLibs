              "items": [
                {
                  "text": "Efe 6:21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kyenva ndi kumubatumira abakobere twenatwena bwe tuli, mwiremu emyoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali kwidha ni Onesimo, owoluganda omugonzi era omwesigwa, ate nga era w'eyo ewaimwe. Baidha kubakobera byonabyona ebifa eno.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
