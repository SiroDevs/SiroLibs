          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owundi abalamwisa ni Yesu abandi ye beeta Yusito. Mu bantu be nkola nabo ku lw'Obwakyabazinga bwa Katonda, abo ni bonka abakekete era bandhizaamu inho amaani.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
