            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muunamukize aboluganda abali e Laodikea, muunamukize Nunfa n'Ekikunsu ky'Abaikiriza mu Kurisito abeesololeza mu ndhu ye. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embaluwa eno bw'emala okubasomerwa, mubone nga esomerwa n'Ekikunsu ky'Abaikiriza mu Kurisito ekiri e Laodikea. Era mwena musome eyo ab'e Laodikea ye balibagheereza.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
            "verseOrgIds": [
              "COL.4.16"
            ]
          }
        }
      ]
    },
