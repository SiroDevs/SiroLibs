              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalumirwa ghalala n'abasibe era bwe mwanhagibwaku ebyaimwe mwaguminkiriza n'eisanhu, nga mwidhi muti muli n'ekibisinga obukalamu era eky'olubeerera. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
