            }
          ]
        },
        {
          "text": "Mwidhukire ebiseera eby'eira bwe mwamala okufuna obutangaavu bwa Katonda ni muguminkiriza okudaazibwa okw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
