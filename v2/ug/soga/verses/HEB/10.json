              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale mutasuula ere kumwesiga kwaimwe, kuba kulimu empeera nnene.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
