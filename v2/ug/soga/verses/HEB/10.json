          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikuzi egindi mwavumibwanga era mwadaazibwadaazibwa mu maiso g'abantu, emikuzi egindi mwalumirwanga ghalala n'abo be bakolanga batyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
