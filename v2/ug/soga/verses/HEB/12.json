          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timwidhie ng'Abaisiraeli bwe baaja ku lusozi Sinai olusobola okugemwaku era olwaka omuliro. Era timwidhie ya nzikiiza egemye bedimudimu, oba ya kiwunga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16+EXO.19.17+EXO.19.18+EXO.19.19+EXO.19.20+EXO.19.21+EXO.19.22"
