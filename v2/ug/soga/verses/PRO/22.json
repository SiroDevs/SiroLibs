          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otakyusanga ensalosalo ey'eira, kugitoola badhaadha bo ghe baagita.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        }
