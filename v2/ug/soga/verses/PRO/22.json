        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.23",
            "verseOrgIds": [
              "PRO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otakwananga muntu wa busungu, oba okubita n'ole nga mukambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.24",
            "verseOrgIds": [
              "PRO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba oghanga okugema emize gyaibwe egyo, gy'akugemya ng'oti mitego, waaloba kugivaamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.25",
            "verseOrgIds": [
              "PRO.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
