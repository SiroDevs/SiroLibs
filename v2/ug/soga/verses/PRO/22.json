          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otatetenkerezanga mwavu olw'okuba ti yeeghanga, oba okukiriga omughafu ali kuwoza omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.22",
            "verseOrgIds": [
              "PRO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba Musengwa Katonda aja kubalwanirira, era aja kwesimba mu abo ababatiisatiisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.23",
            "verseOrgIds": [
              "PRO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
