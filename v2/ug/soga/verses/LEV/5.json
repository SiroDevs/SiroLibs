      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaalayizibwanga okugha obudhulizi ku musango, aye n'atakoba kye yabona oba kye yawulira, anaabonerezebwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaagemanga ku kintu ekitali kirongoofu nga tategeire, ka tukobe ng'emamba ey'ensolo ey'omu nsiko oba ey'ensolo enfuge etali nongoofu oba ey'ekintu ekyeghaluliza ku itaka, anaabangaku omusango amangu geene ng'ategeire ky'akoze.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaagemanga ku kintu kyonakyona ekiviire ku muntu ekitali kirongoofu, nga tategeire, anaabangaku omusango amangu geene ng'ategeire ky'akoze.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaayanguyirizanga okweyama okukola ekintu ekirungi oba ekibi, nga tataireyo mwoyo ng'abantu bwe bakola, anaabangaku omusango amangu geene ng'ategeire ky'akoze.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaizanga omusango gwonagwona mu ebyo, aidha kwatulanga ekibi kye yakola. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era anaaleetanga eri Musengwa Katonda entaama enkazi oba embuzi ng'omutango olw'omusango ogwo gw'aiziiza. Kabona anaaghangayo ebintu ebyo byaba ekigheebwayo ng'omutango olw'ekibi eky'omuntu oyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omuntu oyo bw'anaabanga nga tasobola kughaayo ntaama oba mbuzi, olw'okuba ow'entoola ghatono, anaaleetanga enhonhi dhino eri Musengwa Katonda dhaaba ekigheebwayo ng'omutango olw'omusango gw'aiziiza: amaghemba abiri oba enjiibwa ibiri enhonhi eyindi ng'ekigheebwayo olw'ebibi, ate eyindi ng'ekigheebwayo ekyokebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaadhireetanga eri kabona, kabona yaasooka okughaayo eyo egheebwayo olw'ebibi, yaaginiola enkoto aye nga tagikutulaku mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era anaamansiranga ogundi ku musaayi gwayo mu mbali mw'alutaari ogusigairegho gwonagwona yaagukamulira ku ntobo y'alutaari eyo. Ekyo n'ekigheebwayo olw'ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaaghangayo enhonhi ere eyindi, ng'ekigheebwayo ekyokebwa, ng'ajiira ku mateeka. Mu nsambo eyo kabona anaabanga aghaireyo omusengo olw'ekibi omuntu oyo ky'akoze, era omuntu oyo anaasoniyibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omuntu oyo bw'anaabanga nga tasobola kughaayo maghemba abiri oba njiibwa ibiri, anaaleetanga kilo ndala ey'obuwunga obuseereibwa obukalamu, ng'ekigheebwayo olw'ebibi. Taateerengaku muzigo waire obubbaani, kuba ekyo n'ekigheebwayo olw'ebibi, se ti ni kire ekigheebwayo eky'emere ey'empeke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaaleetanga obuwunga obwo eri kabona, kabona oyo yaayoolaku omuganda ng'akamanhiso akooleka nga bwonabwona bugheereibwayo eri Musengwa Katonda, era yaabwokera ku alutaari ng'ekigheebwayo ekyokebwa n'omuliro. Ekyo n'ekigheebwayo olw'ebibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsambo eyo kabona anaabanga aghaireyo omusengo olw'ekibi omuntu oyo ky'akoze, era omuntu oyo anaasoniyibwanga. Obuwunga obusigairegho bunaabanga bwa kabona, nga bwe kiba ku kigheebwayo eky'emere ey'empeke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaagha Musa ebiragiro bino ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu bw'anaakolanga ekibi nga tagendereire, olw'obutaghaayo ebitukuvu by'ateekwa okughaayo eri Musengwa Katonda, anaaleetanga eri Musengwa Katonda entaama enume, oba embuzi eziraku kikyamu kyonakyona ebe ekigheebwayo ng'omutango. Omughendo ogw'empiiya oguja mu nsolo eyo, gunaabalirirwanga mu mbala entongole ey'eisinzizo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era anaaleetanga ekyo ky'ataaghaayo, yaayongeraku n'omutango gwa kitundu kirala kirala ku buli bitundu bitaanu eby'ekyo ky'ataaghaayo. Ebyo anaabireetanga eri kabona, kabona oyo yaaghaayo ensolo eyo yaaba ekigheebwayo ng'omusengo olw'ebibi by'omuntu oyo, era omuntu oyo yaasoniyibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu bw'anaakolanga ekibi, n'asobya mu kintu kyonakyona ku ebyo Musengwa Katonda bye yalagira, waire nga taidhi, anaabanga n'omusango, era anaabonerezebwanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaaleetanga eri musengwa entaama enume, oba embuzi eziraku kikyamu kyonakyona ng'eviire mu kisibo kye, yaagighaayo ebe ekigheebwayo ng'omutango. Omughendo ogw'empiiya oguja mu nsolo eyo, gunaabalirirwanga mu mbalirira entongole ey'omu isinzizo. Kabona anaaghangayo omusengo olw'ebibi omuntu oyo bye yakola nga tagendereire, era omuntu oyo yaasoniyibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo n'ekigheebwayo ng'omutango olw'ebibi omuntu oyo bye yakola mu maiso ga Musengwa Katonda.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
