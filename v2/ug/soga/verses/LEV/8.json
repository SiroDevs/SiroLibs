              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale, Aaroni ni batabane be baakola byonabyona Musengwa Katonda bye yalagira ng'abita mu Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
