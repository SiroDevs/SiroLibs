          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuisiraeli oba omusenze yeenayeena eyasenga mu Isiraeli bw'anaalyanga ku musaayi, ndidha kumukyaghanga era mbenga nga tikaamubalira mu bantu bange.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
