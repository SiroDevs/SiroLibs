              "LEV.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Endwaire ey'ebigenge ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:47",
              "type": "text"
            },
            {
              "text": "Endwaire ey'ebigenge:",
              "type": "text"
            },
            {
              "text": "Ekibono ekikozesebwa mu Luheburayi “tsar'at” tikikoma ku ndwaire ya bigenge yonka nga bwe tugiidhi, aye kitwalizaamu n'endwaire edhindi edh'oku mubiri, ghalala n'obukuku ku bintu ng'engoye, amawu, ebimante by'endhu, n'ebintu ebindi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bw'enaabanga mu kivaalo, ka kibe nga kyakolebwa mu buviiri bwa ntaama oba nga kya lugoye lughegheevu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "oba n'eba mu kighero kyonakyona eky'olugoye olughegheevu oba ekyakolebwa mu buviiri bw'entaama, oba ku luwu, oba ku kintu ekyakolebwa mu luwu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "era endwaire eyo n'eba eya kiragalalagala oba emyukirivu, mu kivaalo oba ku luwu oba ku kintu ekyakolebwa mu luwu, enaalagibwanga kabona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona anaagyekebeedhanga, yaakuumira ekintu ekyo aghantu okumala enaku musanvu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anairangamu okwekebeedha endwaire eyo ku lunaku olwomusanvu. Bw'enaabanga ng'esansaine, ekintu ekyo kinaabanga nga tiikirongoofu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona anaakyokyanga, kuba eyo n'endwaire ey'ebigenge. Eteekwa okuzikirizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
