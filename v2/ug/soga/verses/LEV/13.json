          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye kabona bw'aneekebeedhanga n'abona ng'endwaire tesansaine mu kintu ekyo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "anaalagiranga baakyoza, era kyaterekebwa okumala enaku edhindi musanvu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kabona anaakyekebeedhanga kabiri. Endwaire bw'enaabanga nga tekyusiiza langi yaayo, waire nga tesansaine mu kintu ekyo, ekintu ekyo era tikiibenga kirongoofu. Kinaayokebwanga, ka kibe ng'obukuku buli munda oba ku ngulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kabona bw'anairangamu okukyekebeedha n'abona ng'endwaire ekendeire, anaakanulangagho ekipaapi ekyo endwaire ky'erimu mu kivaalo oba mu luwu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endwaire bw'enairangamu okuboneka, olwo enaabanga ng'eri kusansaana kabiri, era ekintu ekyo kinaayokebwanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
