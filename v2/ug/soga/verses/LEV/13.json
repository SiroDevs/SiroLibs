              "LEV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu bw'anaabanga n'okubutukabutuka ni kuwona, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "aye aghabaire okubutukabutuka okwo ni ghairagho obuzimbu obweruukirivu oba ni ghamwaguka ebintu ebimyukirivu, omuntu oyo anaajanga eri kabona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona anaamwekebeedhanga. Era bwe kinaabonekanga ng'ebintu ebyo ebimumwagwikeku byesimye mu mubiri, n'obuviiri bwagho nga bweruukiriire, kabona anaamulangiriranga ati tiimulongoofu, eyo n'endwaire ey'ebigenge efulumiire mu kubutukabutuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kabona bw'aneekebeedhanga aghalwaire, n'abona ng'obuviiri bwagho tibweruukiriire, era nga tigheeyongeire kwesima mu mubiri aye nga ghakendeire, olwo kabona anaamukuumiranga mu kifo yenka okumala enaku musanvu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebyo ebimumwagwikeku bwe binaabunanga ku mubiri gwe, olwo kabona anaamulangiriranga ati tiimulongoofu, mulwaire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bwebinaakomanga agho ni bitasansaana ku mubiri, eyo nga n'enkovu ey'okubutukabutuka okuwonie. Agho kabona anaamulangiriranga ati mulongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
    },
