          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omusaadha oba omukazi bw'anaabanga n'okubutukabutuka okwengereire ku mubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabona anaamwekebeedhanga. Okubutukabutuka okwo bwe kunaabanga nga tikwa maani, ekyo kinaabanga kimyamya bumyamya nga kifulwime mu mubiri; oyo anaabanga mulongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
