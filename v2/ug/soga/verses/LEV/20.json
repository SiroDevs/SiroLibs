        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha bw'anaabanga n'owundi ku baka ise mu buliri, anaabanga ng'awemwire ise. Era bombi, omusaadha oyo n'omukazi, banaitibwanga. Beene n'abanaabanga nga beereeteire okwitibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
