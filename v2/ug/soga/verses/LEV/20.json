          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omusaadha bw'anaabanga ni muka musaadha mwine mu buliri, abenzi bombi, omusaadha oyo n'omukazi, banaitibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
