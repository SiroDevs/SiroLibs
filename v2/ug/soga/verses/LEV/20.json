          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha bw'anaabanga n'ensolo, mu nsambo abasaadha ye baba n'abakazi mu buliri, anaitibwanga era ensolo eyo yoona enaitibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
