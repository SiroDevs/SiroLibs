          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha bw'anaabayizanga omukazi n'inhina w'omukazi oyo, ekyo kinaabanga kiive. Abasatu abo banaayokebwanga omuliro baafa. Era mutaganhanga kibi ng'oti n'ekyo okuba mu imwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
