              "LEV.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha bw'anaabanga n'omukazi mu buliri ng'ali mu biseera bye eby'okulwala, bombi banaabanga nga tibakaabalirwa mu bantu bange, kuba bamenhie amateeka agagema ku bulongoofu.",
          "type": "text",
          "attrs": {
