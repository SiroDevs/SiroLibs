          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kiisi anaakolimiranga ise oba inhina, anaitibwanga mwene n'anaabanga nga yeereeteire okwitibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        },
