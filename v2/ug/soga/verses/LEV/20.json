                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Ma 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omukazi bw'anaabanga n'ensolo mu nsambo abasaadha ye baba n'abakazi mu buliri, anaitibwanga era n'ensolo eyo yoona yaitibwa mwene era n'ensolo eyo n'abanaabanga nga beereeteire okwitibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaadha bw'anaabayizanga mwanhina, waire nga mwanhina ku ise ow'omukazi owundi, oba mwanhina ku inhina ow'omusaadha owundi, banaabanga bakoze kiive. Banaabanga nga tibakaabalirwa mu bantu baibwe. Omusaadha oyo anaabonerezebwanga olw'ekibi kye ekyo, eky'okuba ni mwanhina mu buliri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        },
        {
