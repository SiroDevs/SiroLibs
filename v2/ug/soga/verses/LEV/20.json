                "loc": "LEV.18.22"
              },
              "items": [
                {
                  "text": "Lev 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
