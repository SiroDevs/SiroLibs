        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musa ng'amaze okukobera ebyo Abaisiraeli, baatwala oyo eyakolima mu kifo aghazira weema dha bantu, baamukuba amabaale yaafa. Mu nsambo eyo Abaisiraeli baakola nga Musengwa Katonda bweyakoba Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.23",
            "verseOrgIds": [
              "LEV.24.23"
            ]
