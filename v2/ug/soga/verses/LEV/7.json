        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago n'amateeka agafuga ebigheebwayo ebyokebwa, n'ebigheebwayo eby'emere ey'empeke, n'ebigheebwayo olw'ebibi, n'ebigheebwayo ng'omutango, n'ebigheebwayo olw'okwawulibwa, n'ebigheebwayo olw'okutabagana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyo ku lusozi Sinai mu irungu, Musengwa Katonda ye yagheera Musa ebiragiro ebyo, ku lunaku lwe yakoberaku Abaisiraeli okumuleeteranga ebigheebwayo byaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
