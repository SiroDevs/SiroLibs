            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
