        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aŋun, ŋakiro ŋuna irworo Ekapolon Akuj ikes nu, ‘Aŋuna tokona ŋituŋa itamuniata iyes aronis kus alotooma akiŋer ayoŋ ŋina eleere, ŋina etoodiunit ŋasecisya alotooma daadaŋ ŋuna itiyaete iyes, ikirikoryo iyes anakwap kus.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        }
      ]
    },
