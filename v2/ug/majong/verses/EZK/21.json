              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon kirwor neni kaŋ tema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lokoku a ituŋanan, todwar ŋakiro nu ebe, ‘Alimu Ekapolon atemar,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.9"
            ]
