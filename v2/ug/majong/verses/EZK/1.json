        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
