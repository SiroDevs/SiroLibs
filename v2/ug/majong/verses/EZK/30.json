        "style": "s1"
      },
      "items": [
        {
          "text": "Akiolol aŋuna a Ijipit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
