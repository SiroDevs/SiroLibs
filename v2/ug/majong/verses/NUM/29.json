      },
      "items": [
        {
          "text": "Ŋainakineta aŋuna a ŋasuban a ŋuna a ŋarupepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋirwa ke elap epei elap ŋolo a ŋikanikaarei, emaikina iyes tocunakinos iwapei kilipa, nyemaikina iyes toloto loticisyo kus kitiyata, erae akoloŋit ŋin ŋina ikusyata iyes ŋarupepe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido emaikina iyes yaut ŋainakineta nu ŋuna epeyo ŋuna ebob eure kec aneni ke Ekapolon: Emoŋ ŋolosorokit, emesek ka ŋikaalei ŋulumesekin ŋikanikaarei ŋulu erae apolou kec ekaru epei, ŋulu emam neni eŋwalit. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwapei ainakinet ŋina a ŋikinyom, emaikina iyes yaut ŋakirya ŋuna ajokak ŋuna iguritoe ka akimyet, aŋuna a emoŋ, ŋakiloi ŋauni aŋuna a emesek, ŋakiloi ŋaarei ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka akilo apei aŋuna a ŋinikale a ŋulukanikaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina nabo iyes yaut ekoroe erae ainakinet aŋuna ka asecit ka aŋuna ka amookuno kus. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Einakinio ŋainakineta ŋun kaapei ka ŋainakineta ŋuna epeyo ŋuna ke elap a ŋolokitete kaapei ka ŋainakineta ŋuna a ŋikinyom ta ŋainakineta ŋuna epeyo ŋuna a ŋinakoloŋit kaapei ka ŋainakineta ŋuna a ŋikinyom, kaapei ka ŋainakineta ŋuna a ŋimaten lopite ŋolo elimunitere aŋuna kec alokisil, erae ikes ŋainakineta ŋuna epeyo ŋuna ebob eure aneni ke Ekapolon.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋainakineta aŋuna ka akoloŋit a ŋina ka amookuno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
