          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina daŋ iyes yaut ekoroe erae ainakinet aŋuna ka asecit, yaut kaapei ka ainakinet ŋina epeyo ŋina a ŋinakoloŋit kaapei ka ainakinet ŋina a ŋikinyom ta ainakinet ŋina a ŋimaten.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
