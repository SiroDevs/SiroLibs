          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋirwa ke elap ŋitomon ka ŋikan elap ŋolo a ŋikanikaarei, emaikina tocunakinos iwapei kilipa, nyilot loticisyo kus kitiyata. Emaikina iyes kinumunuma ŋasuban neni ke Ekapolon ŋirwa ŋikanikaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
