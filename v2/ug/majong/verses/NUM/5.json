              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Erae lo ekisil apaki daadaŋ ŋina elomia aberu toriŋa erukito ka ekile keŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
