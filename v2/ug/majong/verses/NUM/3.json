            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina Moses ka Aron ta ŋidwe ka Aron ŋulusapa toloma kiŋaŋaren eema ŋolokilipet, lowae ŋolo alo Kide, ŋolo elomununia akoloŋ, etic kec akitiya ŋitalyo alotooma akibois ŋina asegan aŋuna a Ŋisirael. Ituŋanan daadaŋ ŋini aapiyari nen, amaikina toarae.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekimar a ŋilepi a ŋulu apotu Moses ka Aron kigira a ŋatekerin kec lopite ŋolo ecikitor Ekapolon Moses arae ŋalipyo ŋatomoniarei ka ŋaarei, arae ŋul daadaŋ ŋidwe ŋulusapa ŋulu arae apolou kec elap epei ka adepar.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alakun ŋikiyae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 3:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirwor Ekapolon neni a Moses tema, “Kigir ŋidwe daadaŋ ŋulusapa ŋulu erae ŋikiyae aneni a Ŋisirael, ŋidwe ŋulu erae apolou kec elap epei ka adepar, kimar ikes. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai emaikina iyoŋ kimyek ŋilepi aŋuna kaŋ. Arae ayoŋ Ekapolon! Ilunyokin ŋul neni a ŋidwe a daadaŋ a ŋulusapa a ŋulukiyae aneni a Ŋisirael ka ikwaŋinapei ilunyokin ŋibaren daadaŋ ŋulu a ŋilepi neni a ŋikiyae a ŋibaren a Ŋisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 3:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, abu Moses kigir ŋidwe daadaŋ ŋulusapa ŋulukiyae ŋulu a Ŋisirael, lopite ŋolo ecikitor Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ekimar a ŋidwe a daadaŋ a ŋulusapa a ŋulukiyae a ŋulu arae apolou kec elap epei ka adepar imaritae a ŋirorwa kec ŋalipyo ŋatomoniarei ka ŋaarei ka ŋamiae ŋaarei ka ŋatomonikanikaarei ka ŋauni.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 3:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirwor nabo Ekapolon neni a Moses tema, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Totyaka ŋilepi kilunyokinos neni a ŋidwe a ŋulusapa a ŋulukiyae a ŋulu a Ŋisirael ka ŋibaren a ŋilepi kilunyokin neni a ŋikiyae a ŋibaren a Ŋisirael, eruworosi ŋilepi ŋulu kaŋ. Arae ayoŋ Ekapolon! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 3:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwapei elalaketa ŋidwe a Ŋisirael ŋulusapa ŋulu erae ŋikiyae akilo ŋilepi, edeparit ekimar a ŋidwe a Ŋisirael ŋolo a ŋidwe a ŋilepi a ŋidwe ŋamiae ŋaarei ka ŋatomonikanikaarei ka ŋiuni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "emaikina iyoŋ kijau aŋuna a ŋinikoku ŋicekelya ŋikan, ipimitae alotyae a ŋicekelya a ŋulu ecamunito ŋituŋa daadaŋ isitiyao anakibois a ŋina asegan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 3:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iyoŋ iinak Aron ka ŋidwe keŋ ŋulusapa ŋisiliŋa ŋul ŋulu elakunitere ŋidwe a Ŋisirael ŋulusapa ŋulu adeparito ekimar kec ŋolo a ŋidwe” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Moses kijau ŋisiliŋa ŋulu alakunere ŋidwe a Ŋisirael ŋulukiyae ŋulu adeparit ekimar kec ŋolo a ŋilepi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirirau Moses ŋisiliŋa ŋulu arae apotis kec ŋicekelya aliput ka ŋamiae ŋauni ka ŋatomonikanikapei ka ŋakan ipimunitae alotyae aŋicekelya a ŋulu ecamunito ŋituŋa daadaŋ isitiyao anakibois a ŋina asegan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido abu inak ŋisiliŋa ŋul neni ka Aron ka ŋidwe keŋ ŋulusapa, lopite ŋolo alimunitor Ekapolon, ikwapei ecikitor Ekapolon Moses.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
              "NUM.3.51"
            ]
          }
        }
      ]
