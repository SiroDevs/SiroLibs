          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimu nai Balaam ŋakiro tema, “Ŋakiro a Balaam alokoku a Beor,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋakiro a Balaam ŋuna esidyok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
