            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.19",
            "verseOrgIds": [
              "NUM.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
