          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋolik nai Balaam anakitoodikinet a Akuj Ŋiamaleki ŋituŋa a Ses, tosodi tolimu ŋakiro nu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
