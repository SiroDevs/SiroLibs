  "reference": "Ekim. 11",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NUM 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiŋuruŋura Analoŋisat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Ŋisirael kisyakis akiŋuruŋura neni ke Ekapolon aŋuna a ŋatyokisyo a ŋuna, aryamunito ikes analoŋisat, ani iirari Ekapolon akiŋuruŋura kec, toŋo nooi, ido kiyaku akim tonom ikes, tonomiya ŋawaetin a alomar. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋituŋa kigworokis Moses, tosodi Moses kilip neni ke Ekapolon ka abu akim toduŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, aponi tolimokinae akwap ŋin Tebera, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:3",
              "type": "text"
            },
            {
              "text": "Tebera",
              "type": "text"
            },
            {
              "text": "iŋes atemar akinom",
              "type": "text"
            }
          ]
        },
        {
          "text": " anerae abu akim ke Ekapolon tonom ikes.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi ŋituŋa ŋulugelaanotin ŋulu awosete kaapei ka Ŋisirael, apotu ŋituŋa ŋul kiitana nooi akiriŋ, apotu Ŋisirael daŋ kiŋuruŋura nabo kaapei ka temasi “Okoe, kerae ca oryamutu akiriŋ adio onyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.4",
            "verseOrgIds": [
              "NUM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitor isua ŋikolya ŋulu anyameneneo isua alo Ijipit apaki daadaŋ ŋina acamitere emam etacit eitor isua ŋakolil, ŋadekela, ŋikituŋgurui ŋulu erae edia, ŋikituŋgurui ŋulu akwaŋak ŋulu akukunyok nooi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.5",
            "verseOrgIds": [
              "NUM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nai tokona adaun agogoŋu kosi; mam ibore eyai Manna na ŋina iteo a ŋinakoloŋit na.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae Manna ibore ŋini ekoni ŋicok a emucele ka ekoni eminae a ekaramwae. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloseneneete ŋituŋa akirira Manna alokiŋa alomar, yaut nalomar, kiryata a ŋamoru, kori toruko a ŋilepito, ido kipoto a ŋamoti kipout ŋamugati ŋuna abobok ŋuna ekoni abobou kec ŋina a amugati a ŋuna ipotoi ka akimyet. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋinakoloŋit, adoiununui Manna kaapei ka ŋakopi nakwaare.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki ŋin kiira Moses ŋituŋa igworosi a ŋikalya a daadaŋ, egworo ŋolokal alopuke a eema keŋ. Abu Ekapolon toŋo nooi ka Moses daŋ pa alakara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, abu Moses kiŋit Ekapolon tema, “Kaanukiro itiyaa iyoŋ neni a eketiyan kon erono nooi ikona? Kaanukiro pa aryamunitor ayoŋ alakara aloŋaren kon? Kaanukiro ikiinakinia iyoŋ ayoŋ akidaŋidaŋ ŋakiro daadaŋ aŋuna a ŋituŋa a lu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayoŋ mono apotiuni ŋituŋa lu daadaŋ a? Ayoŋ mono auruuni ikes a? Kaanukiro ibaakar iyoŋ ayoŋ todak ikes anatorobu kon lopite ŋolo edakitor akedaran ikoku ŋini eriŋa enaki, Kaanukiro ibaakar iyoŋ ayoŋ ya ikes nakwap ŋina ibu iyoŋ kiik ikoŋi ainakin neni atapapaa kec? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.12",
            "verseOrgIds": [
              "NUM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai bo tokona aryamunia ayoŋ akiriŋ ŋina ainakini ŋituŋa lu daadaŋ? Anerae eponito ikes neni kaŋ igworosi ka ebasi, ‘Inakinae isua akiriŋ tonyamae!’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.13",
            "verseOrgIds": [
              "NUM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyapedori ayoŋ bon akidaŋidaŋ ŋakiro a ŋituŋa a lu a daadaŋ, nyapedori ayoŋ ŋakiro a ŋituŋa a lu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.14",
            "verseOrgIds": [
              "NUM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kerae lo epite ŋolo ikitiŋitor iyoŋ ayoŋ, tolema akiyar kaŋ atipei, ani kajok ayoŋ alokiŋaren kon, nyikimyek ayoŋ eŋolik ŋican.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikasikou ŋulutomonikanikaarei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Ekapolon tolimok Moses tema, “Tocunak aŋuna kaŋ, ŋikasikou ŋatomonikanikaarei alotuŋa a Ŋisirael, ŋikasikou ŋulu iyeni iyoŋ atemar erae ŋikatukok a ŋituŋa ka epolokinito ŋituŋa, yau ikes loeema ŋolokilipet kiboikinos kaapei ka iyoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuni ayoŋ, ido erworo ka iyoŋ a nen, tosodi alemari ayoŋ etau kaŋ edyo ŋolo sek ainakinit ayoŋ iyoŋ, oinak neni a ŋikasikou a ŋul, ido idaŋidaŋete ikes ŋakiro a ŋituŋa a lu kaapei ka iyoŋ, ikotere nyidaŋidaŋ iyoŋ bon ŋakiro kec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.17",
            "verseOrgIds": [
              "NUM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok nai ŋituŋa ŋakiro nu, ‘Kitaleunos aŋuna a moi taparacu, ido inyamete iyes akiriŋ,’ anerae igworo iyes epupi Ekapolon ibasi, ‘Okoe, kerae ca oryamutu akiriŋ adio onyama! Kire jik, ajok aneni kosi akiboi alo Ijipit!’ Aŋun ikiinakini Ekapolon iyes akiriŋ ka inyamete iyes! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi nyinyamete iyes akiriŋ ŋin akoloŋit apei, kori ŋirwa ŋiarei, kori ŋirwa ŋikan, kori ŋirwa ŋitomon kori, ŋirwa ŋitomoniarei, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.19",
            "verseOrgIds": [
              "NUM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nai elap daadaŋ, akitodol ŋina eurunio alokumes kus topyaniar anakituka kus, anerae iŋero iyes Ekapolon ŋolo irukito ka iyes ka igworo alokiŋaren keŋ ibasi, ‘Kaanukiro emyekinere isua akwap a Ijipit?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tolimok Moses Ekapolon tema, “Erae ŋituŋa daadaŋ ŋulu ikirukit ayoŋ ŋalipyo ŋamiae ŋakanikapei, ido ibala iyoŋ ebe, ‘Ainakini ayoŋ ikes akiriŋ ŋina imujete elap epei!’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.21",
            "verseOrgIds": [
              "NUM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyakasi mono ŋamesekin ka ŋaatuk ŋuna itemok akiŋol aŋuna kec a? Eyakasi mono ŋikolya nanam ŋulu itemokin aŋuna kec a?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok Ekapolon Moses tema, “Edit mono apedor ke Ekapolon a? Iŋolikini iyoŋ tokona, kiyookin ŋakiro kaŋ, kori pa kiyookin.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, abu Moses torotok aneni erworotor iŋes ke Ekapolon, tolot tolimok Ŋisirael ŋakiro ŋuna alimokini Ekapolon iŋes ka abu tocunak ŋikasikou a Ŋisirael ŋulutomonikanikaarei, kitowo ikes irimokinito eema ŋolokilipet kidiŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Ekapolon totiyaun eyai lodou kirwor neni a Moses, tolema etau keŋ edyo aneni a Moses inak neni a ŋikasikou a ŋulutomonikanikaarei, ani emini etau a Ekapolon neni kec, apotu ikes todwara. Nai nyedwara ikes nabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki ŋin kidoŋito ŋikasikou ŋiarei nalomar, anyaritae epei Elidad ka ŋoloce Medad, abu etau min neni kec daŋ, anerae emarakinitae ikes daŋ lokasikou ŋulutomonikanikaarei, nai pa alosito ikes loeema, ŋolokilipet, aŋun apotu ikes todwara analomar. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu esorokit epei tomotun neni a Moses tolimok iŋes tema, “Edwarete Elidad ka Medad analomar.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi Yosua lokoku a Num, ŋolo arae ekeŋarakiniton a Moses ŋinapei eriŋa Yosua esorokana kirwor neni a Moses tema, “Ekapolon kaŋ Moses, tolimok ikes tojoŋoto akidwar!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tolimok Moses iŋes tema, “Ililit iyoŋ aŋuna kaŋ a? Okoe kerae ca torae ŋituŋa a Ekapolon daadaŋ ŋikadwarak, ido inakinite Ekapolon ikes etau keŋ!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu nai Moses ka ŋikasikou a Ŋisirael toboŋosi nalomar.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋalurui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon kitukut ekuwuam alowae a ŋolo ka anam abu ekuwuam ŋol kiwoku ŋalurui, apotu ŋalurui ŋun todoto alomar ŋiwaetin daadaŋ neni apedori ituŋanan alosit akoloŋit apei a ŋolowae ka alomar, atukosi ŋalurui ŋun amita apei ameun alokidiama tari kwap. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu ŋituŋa kitiyata akoloŋit apei, apaaran ka akuwar ka akoloŋit ŋina atupakini ŋin iriraete ŋalurui, ituŋanan ŋini abu kirirau ŋalurui ŋuna ekudyoko, abu kirirau ŋuna apiyarit apotis kec ŋakiloi ŋaarei. Apotu nai ŋituŋa tolokis ŋalurui ŋuna eriraunete ikes kiryama alomar kec daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani eriŋa ikes enyamete akiriŋ a ŋalurui a ŋun, eriŋa nyirikara ŋalurui, toŋo Ekapolon nooi neni a ŋituŋa, abu Ekapolon toar ikes ke edeke a ŋolo aronon nooi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, aponi tolimokinae akibois ŋin Kibiros-Ataapa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:34",
              "type": "text"
            },
            {
              "text": "Kibiros-Ataapa",
              "type": "text"
            },
            {
              "text": "iŋes atemar ŋalyalin ŋuna ke ekwane",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alo Kibiros-Ataapa apotu Ŋisirael towoto Aseros.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
      ]
    }
