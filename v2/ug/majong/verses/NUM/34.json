          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikukorin ka akwap a Kanaan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirwor Ekapolon neni a Moses tema, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.1",
            "verseOrgIds": [
              "NUM.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kicik Ŋisirael, tolimok ikes ebe, ‘Ani ilomarete iyes nakwap a Kanaan (iŋes akwap ŋina akainakinit ayoŋ iyes toruwor ŋina kus, erae akwap a Kanaan ŋina igerunito ŋikukorin lu:) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.2",
            "verseOrgIds": [
              "NUM.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alowae a ŋolo alo Kwap, emyeari ekukoru analoŋisat a ŋina a Sin (iŋes Kades) alokukoruu a ŋolo ka akwap a Edom. Egeuni ekukoru ŋolo alo Kwap alokisal a Anam ŋina Atwan a ŋina eyai Kide. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:3",
              "type": "text"
            },
            {
              "text": "Anam ŋina Atwan:",
              "type": "text"
            },
            {
              "text": "Iŋes anam ŋina ka Acumbi",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kilugok a nen lowae ŋolo alo Kwap totub aloŋisat Sin tomyaa Kwap Akirabim-Pas, totubor naloŋisat Sin kisalakin Kades-Barinea alowae a ŋolo alo Kwap tomea a nen tari Asar-Adar, totubor Asimon ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "neni ilugokinia tomyaa nayonae ŋina a Ijipit, kisalakin nanam Mediteranian.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Ekukoru kus ŋolo alo To iŋes anam Mediteranian.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Ekukoru kus ŋolo alo Kuju iŋes lo: Ageun ananam Mediteranian tari Moru Or ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.7",
            "verseOrgIds": [
              "NUM.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ameun alo Moru Or emyaari tari Leboamas, tomyaa nabo tari Sedad, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.8",
            "verseOrgIds": [
              "NUM.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tomyaa a nen tari Sipiron kisalakin Asarenan. Eruwor ŋol ekukoru kus ŋolo alo Kuju.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
            "verseOrgIds": [
              "NUM.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
            "verseOrgIds": [
              "NUM.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Egeuni ekukoru kus ŋolo alo Kide alo Asar-Enam, toremor Sepam ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.10",
            "verseOrgIds": [
              "NUM.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "totiyaar a nen tomyaa Ribila alowae a ŋolo alo Kide Ain, totiyaar a nen toman adipo anam Kineres ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:11",
              "type": "text"
            },
            {
              "text": "Kineres:",
              "type": "text"
            },
            {
              "text": "Iŋes Galileya",
              "type": "text"
            }
          ]
        },
        {
          "text": " alo Kide, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "totiyaar nabo a nen tari Yorodan, tomek Yorodan kisalak nanam ŋina Atwan. Eruwor ŋin akwap kus ka ŋikukorin ŋulu irimokinito iŋes kidiŋ.’”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicik Moses Ŋisirael tema, “Erae ŋin akwap ŋina eruwor ŋina kus anakilamilam, akwap ŋina ecik Ekapolon ainakin lotuŋa a ŋikabilae a ŋikanikaomwon ka atutubet apei ŋina a ekabila a epei; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae adaut ŋituŋa a ekabila a Ruben ka ŋulu a ekabila a Gad aryamun akwap kec kaapei ka atutubet apei ŋina a ekabila a Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aryamut ŋikabilae ŋuluarei ŋul ka atutubet apei a ekabila a epei akwap ŋina aruwor ŋina kec alokekwaye Yorodan amyar alo Yeriko tomyaa lowae ŋolo alo Kide.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikarikok a ŋikabilae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirwor Ekapolon neni a Moses tema, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Erae lu ŋirorwa a ŋikilyok a ŋulu ikikorakinete iyes akwap ŋina eruwor ŋina kus: Esacaradoti Eleasar ka Yosua lokoku a Nun. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iyes tonyaraut ekarikon epei alotooma ŋolokabila akoranakin ŋituŋa akwap ŋina eruwor ŋina kec.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋirorwa a ŋikilyok a ŋul ikes lu: Alokabila a Yuda Kaleb lokoku a Yepune. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila a Simon Semuel lokoku a Amiud. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila a Benjamin Elidad lokoku a Kisilon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila a Dan Buki lokoku a Yogili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabilae a ŋiletok a Yosepu tonyara lu: Alokabila a Manase Aniel lokoku a Epod ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka alokabila a Epuraim Kemuel lokoku a Sipitan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila a Sebulon Elisapan lokoku a Paranak. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.25",
            "verseOrgIds": [
              "NUM.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila a Isakar Palitiel lokoku ka Asan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.26",
            "verseOrgIds": [
              "NUM.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila ka Aser ekarikon iŋes Aiud lokoku a Selomi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.27",
            "verseOrgIds": [
              "NUM.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokabila a Naputali Padael lokoku ka Amiud. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.28",
            "verseOrgIds": [
              "NUM.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
