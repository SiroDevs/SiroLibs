            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towotokis alo Dibon-Gad tolomiyasi Alimon-Dibilasaim. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.46",
            "verseOrgIds": [
