            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towotokis alo Obos tolomiyasi Yeabarem anakwap a Moab. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
