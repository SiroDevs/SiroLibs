          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋikaru ka Aron amiat ka ŋatomoniarei ka ŋiuni akoloŋit ŋina atwania iŋes alo Moru Or.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        }
