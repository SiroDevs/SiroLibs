          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.24",
            "verseOrgIds": [
              "2KI.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyiirara iyoŋ ŋinapei kanuwan atemar ayoŋ abu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.25",
            "verseOrgIds": [
              "2KI.19.25"
            ]
          }
        }
      ]
