          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nai ayeni ayoŋ apaki ŋina inyounio iyoŋ ka apaki ŋina iboikinor iyoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.27",
            "verseOrgIds": [
              "2KI.19.27"
            ]
          }
        }
