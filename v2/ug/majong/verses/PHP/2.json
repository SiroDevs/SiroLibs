{
  "id": "PHP.2",
  "number": "2",
  "bookId": "PHP",
  "reference": "Ŋipil. 2",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "PHP 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akitiditeuna ka apolou a Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erae kire kiryamunito iyes akisimukekino make anakimorikina ka Kristo, akitalakanar aŋuna ka amina a ŋina ebunit aneni keŋ, akimorikina aŋuna ke Etau a ŋolo ka Akuj, arimao ka akisyonenen; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
              "PHP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekelipit nai iyes kilelebikis alakara kaŋ alotooma ayakau ŋatameta ŋapei, toyakatar amina apei, etau epei ka alosikenet apei. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.2",
            "verseOrgIds": [
              "PHP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyitiyata idiobore anakiloiloa kori anakisupa, nai anakitiditeuna; yaito ŋuluce erae ŋulu ejokak akilo iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyitemokino idio alokidiŋ kus etamuna bon, nai itemokino totamunite ŋuluce daŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyakatar ŋatameta ŋuna ikote ŋun, ŋuna ayakar Yesu Kristo:",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.5",
            "verseOrgIds": [
              "PHP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toraakas akica anakwap",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, ŋikaitotoi kaŋ ŋuluminan, ikwapei jwi jwi iwuapitotor iyes ŋakiro kaŋ paaran apaki ŋina ikirukitor iwon, ejok nabo nooi iyes akiwuap ŋakiro kaŋ tari apaki ŋina alwania ayoŋ aneni kus. Torubakisi itiyaete alokabule ka anakerit Akuj aŋuna ka aiuno kus, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.12",
            "verseOrgIds": [
              "PHP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae Akuj iŋes itiyae alotooma kus, ikotere ikitacamu ka ikitepedo iyes akiwuap ŋakiro ŋuna ajokak ŋuna ecamit iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyata ŋinibore daadaŋ emam akiŋuruŋura kori apeganakin, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.14",
            "verseOrgIds": [
              "PHP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikotere toruworos ŋulu nyisecito ka tosegak alotai ikwapei iraakatar ŋidwe ŋulu ka Akuj ŋulu emam aronis, ŋulu iboiyete alokidiŋ ŋituŋa ŋulu a ŋinyas ŋulu asecak. Itemokino iyes tocayete alokidiŋ kec ikwa ŋikacer ŋulu ecayete alokidiama, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.15",
            "verseOrgIds": [
              "PHP.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikwapei iricitotor iyes ŋakiro ŋuna ka akiyar. Ani kitiyata iyes ikoŋina, aryamuni ayoŋ ŋakiro ŋuna eturokinor aŋuna kus Akoloŋit ŋina a Kristo, anerae itoodiuni neni ebe abu ayoŋ nyecanican agogoŋu ka etic kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.16",
            "verseOrgIds": [
              "PHP.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tari erae kainak akiyar kaŋ ikwa amuronot, kiyatakinae namuronot kus, ŋina erae anupit kus; alakari ayoŋ ka ikimori alelyan kus. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.17",
            "verseOrgIds": [
              "PHP.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwaŋinapei, itemokino iyes daŋ tolakaros ka omora alelyan kaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Timoteo ka Epapurodito",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egeno ayoŋ neni ke Ekapolon Yesu atemar eyakuuni Timoteo neni kus atipei, ikotere ekesimukek ayoŋ eemut ŋolo ke epite a ŋolo iyakatar iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.19",
            "verseOrgIds": [
              "PHP.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoteo iŋes bon ŋolo ikimori ka ayoŋ ŋatameta kaŋ ka iŋes kire ikimitakinit iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.20",
            "verseOrgIds": [
              "PHP.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anerae emitakinit ŋinituŋanan ŋakiro keŋ a ilope, nyemitakinit ŋuna a Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.21",
            "verseOrgIds": [
              "PHP.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyenete iyes ŋilopeyek epite ŋolo etoodiunitor iŋes etic keŋ; epite ŋolo ikitiyaa iŋes ka ayoŋ kaapei ikwa esapat ka papa keŋ aŋuna a Ŋakiro a ŋuna Ajokak. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.22",
            "verseOrgIds": [
              "PHP.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, egeno ayoŋ akiyakuun iŋes neni kus atipei, apaki ŋina ayenunia ayoŋ ŋuna etakanunete neni kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.23",
            "verseOrgIds": [
              "PHP.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ekinyomit ayoŋ Ekapolon atemar apedori ayoŋ daŋ elope adolun neni kus atipei. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.24",
            "verseOrgIds": [
              "PHP.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamaki ayoŋ atemar ejoikinit ayoŋ ekeyakik iyes lokaato yok Epapurodito, ŋolo ikitiyae ka ŋolo ikitijiye kaapei ka ayoŋ Satan alotic a ŋolo a Ŋakiro a ŋuna Ajokak. Etiya iŋes ikwa ekiyakitono kus akiŋarakin ayoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.25",
            "verseOrgIds": [
              "PHP.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburakinit iŋes nooi abunore aanyun iyes daadaŋ ka ebulit, anerae ipotu iyes kiirasi atemar adyaka iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.26",
            "verseOrgIds": [
              "PHP.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kire adyaka iŋes ka adikino etwani. Nai abu Akuj kitimok iŋes nooi; meere iŋes bon, nai abu eketimok ayoŋ daŋ, ikotere nyiyatakin akiyaloloŋ kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.27",
            "verseOrgIds": [
              "PHP.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeburit ayoŋ nooi akitoboŋun iŋes neni kus, ikotere tolakaros iyes nabo iŋolikinete iŋes, ido todaun nai akiyaloloŋ kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
            "verseOrgIds": [
              "PHP.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijautu nai iŋes ka alelyan ikwapei lokaato alotooma Ekapolon. Kitopoloorito ŋituŋa daadaŋ ŋulu ikote iŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
              "PHP.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae adikino iŋes ejali akiyar keŋ aŋuna ke etic a Kristo aŋuna ka akiŋarakin ayoŋ alopite a ŋolo pa ipedoritotor iyes ŋilopeyek akiŋarakinia ayoŋ alotic a ŋol.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.30",
            "verseOrgIds": [
              "PHP.2.30"
            ]
          }
        }
      ]
    }
  ],
