          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.19",
            "verseOrgIds": [
              "JDG.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toruwor Samuson ekatubon ŋakiro alo Isirael ŋikaru ŋatomoniarei alorwa a ŋulu epukatotor Ŋipilistin akwap ŋin.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.20",
            "verseOrgIds": [
              "JDG.15.20"
            ]
          }
        }
      ]
    }
