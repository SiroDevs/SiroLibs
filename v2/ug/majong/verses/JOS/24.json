          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi tonukae iŋes nakwap keŋ neni enyaritae Timina Sera anakwap a ŋina a ŋikamukumukui a ŋina a Epuraim, Kuju emukura Gaas.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
