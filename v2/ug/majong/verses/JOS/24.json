              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kelunyarosi ŋakiro ŋun, abu Yosua lokoku a Nun ŋolo arae eketiyan a Ekapolon totwan. Arae ŋikaru keŋ 110. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
