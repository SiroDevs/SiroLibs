          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋun ŋakwapin ŋuna abu Moses tokorak lokabilae a Ŋisirael anadipoe a Moab alokekwaye Yorodan alo Kide Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai abu Moses nyekorak adiokwap lokabila a Lepi. Abu tolimok ikes atemar ainakinet kus iŋes atutubet adio anainakineta a ŋuna einakinio Ekapolon Akuj a Ŋisirael.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.33",
            "verseOrgIds": [
              "JOS.13.33"
            ]
          }
        }
