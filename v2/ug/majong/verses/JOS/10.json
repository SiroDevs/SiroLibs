          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu nai Yosua ka Ŋisirael daadaŋ toloto lotaun Debir, toremo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikama Yosua etaun ka erwosit keŋ kaapei ka ŋitaunio ŋulucicik ŋulu aapiyete a nen. Toara ŋituŋa daadaŋ a nen a ekileŋ, nyelakak idiotuŋanan ebucar. Abu Yosua kitiyak Debir ŋuna abu iŋes kitiya lotaun Eburon ka lotaun Libina ka erwosit keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
