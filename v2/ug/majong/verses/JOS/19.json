              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani nai irikakinete Ŋisirael akikor akwap lokabilae kec, apotu ikes inakis Yosua lokoku a Nun akwap ŋina abu toruwor ŋina keŋ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikwapei alimunitor Ekapolon. Apotu ikes inakis Yosua etaun ŋolo aris Yosua kiŋit ikes. Arae etaun ŋol Timina-Sera ŋolo ayai nakwap ŋina a ŋikamukumukui ŋina ke Epuraim. Abu nai Yosua toduk nabo etaun ŋol kiboikin iŋes nen.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
