          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitelem erwosit Ausero ŋituŋa akwap keŋ ka ŋulu eboiyete alotooma ŋiculae ka anam ocur. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiticisyo ka Ausero daadaŋ, ŋuna ka apedor ka agogoŋu keŋ, kaapei ka ŋuna ka apolou a ŋina ainakini erwosit Moridekai daadaŋ, igiritae lokaabo ŋolo a ŋakiro a ŋirwosi a Media ka Perisia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae Moridekai Eyudayat ŋolo ewuapit erwosit Ausero anapolou. Iŋes apol aneni a Ŋiyudayan, ayenen iŋes nooi aneni a ŋiyeneta keŋ a ŋulu alalak, anerae abu iŋes kitiya ŋuna ajokak aŋuna a ŋituŋa keŋ ka abu kirwor ŋuna kiuryaret akiyar a ŋiletok keŋ daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
  ],
