            "sid": "ISA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki ŋina ikisieŋunia Ekapolon iyes anaryebo alocan ka alotic a ŋolo agogoŋon a ŋolo ikitiyakinitae iyes, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "irworotor iyes erwosit a Babilon ijamuwarito ibasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
      ]
    },
    {
