            "number": "1",
            "style": "v",
            "sid": "ISA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai isyoni nabo Ekapolon ŋiletok a Yakob ka eseuni nabo Ŋisirael, iwuakini ikes nabo nakwap kec, epote ŋituŋa ŋulugelae akiboi kaapei ka ŋiletok a Yakob. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.1",
            "verseOrgIds": [
              "ISA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaete ŋituŋa a ŋakwapin ikes nakwapin kec, ido kinyakut nabo ikes nakibois kec, epolokinete nabo ŋituŋa a Isirael ŋituŋa a ŋakwapin, ikwaanikin ŋituŋa ŋulugelaanotin ka ŋapi ta ŋipi anakwap a Ekapolon, eyaete ikes erae ŋirikon ŋulu apotu kikamasi ikes ka ipukaete ŋulu apotu kisicana ikes.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akilouno a erwosit a Babilon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
