          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ekapolon ŋolo a ŋajoresyo, “Emani ayoŋ Babilon ka alemari ekiro keŋ ta ŋipiya, ŋidwe ka ŋiletok keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eturuwori ayoŋ Babilon neni iboiyoto ŋapupui neni eya ŋataparin, apyaari ayoŋ Babilon omunya ibore daadaŋ a nen.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋakiro ŋuna etoroniyaritere Asiriya",
          "type": "text"
        }
      ]
    },
