            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irworo Ekapolon ebala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.1",
            "verseOrgIds": [
              "ISA.30.1"
            ]
          }
        }
      ]
