            "number": "6",
            "style": "v",
            "sid": "ISA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae nu ŋakiro ŋuna aponi todwarae aŋuna a ŋityaŋ a ŋulu eya Negeb:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.6",
            "verseOrgIds": [
              "ISA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ŋituŋa ŋulu aŋerok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.7",
            "verseOrgIds": [
              "ISA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolot tokona, kigir ŋakiro nu alokiŋaren kec namoru ŋinadapal,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.8",
            "verseOrgIds": [
              "ISA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiikinet ka Akuj Sion",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.18",
            "verseOrgIds": [
              "ISA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kire jik, okoe ŋituŋa a Sion, ŋituŋa ŋulu iboiyete alo Yerusalem, nyigworete iyes nabo jik. Itiyae iŋes ajokis neni kus apaki ŋina iirarya akigworo kus, ani iirari iŋes akigworo kus, ikiboŋokini iŋes iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.19",
            "verseOrgIds": [
              "ISA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari kikiinak Ekapolon iyes ŋimoe ka ŋican, nyeŋopiyari Eketataman kus nabo, nai iŋolikinete iyes Eketataman kus. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.20",
            "verseOrgIds": [
              "ISA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kilot iyes lowae ŋolo aloteten, kori lowae ŋolo alokedyeny, iirarete iyes etoil alokaku kus ebala, “Erot lo, tomekisi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.21",
            "verseOrgIds": [
              "ISA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi nai, inyasunete iyes ŋitorubei a ŋakujo kus ŋulu eburusiyaritae a esilipa ka ŋitorubei ŋulu eburisikinitae egolid. Icakarete iyes ikes esibito ŋaraco ŋuna asiilyanak, itemarete iyes neni kec, “Nyikicamit isua iyes!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyakuuni iŋes akiru a ŋuna a ŋikinyom a ŋulu iekinete iyes nalup, ido akimuj ŋina elomuni analup, eruwor ŋina etuman ka ŋina alalan nooi. Akoloŋit ŋin, epote ŋaatuk kus adak neni ca daadaŋ eya ŋinya; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.23",
            "verseOrgIds": [
              "ISA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "enyamete ŋimoŋin ŋulu itaete ka ŋisigirya ŋulu itaete ŋinya ŋulu iŋadatae ŋulu elemyo a akitiyo ka auma ŋina apolon. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋina earere ŋimoe kus ŋulu alalak ŋina eritarere ŋaduketa ŋuna aoyak, eyakaunosi ŋayona ŋuna elelyaata ŋakipi alomoru a ŋulu aoyak a daadaŋ ka alokamukumukui a ŋulu aoyak a daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋina imadya Ekapolon neni ewanan alotuŋa keŋ ka ŋina itaŋaleunio Ekapolon ŋajemei ŋuna abu iŋes kiteryamu ŋituŋa keŋ, ecauni elap ikwa akoloŋ ekwaŋiar akica a akoloŋ akilo tari ŋarwa ŋakanikaarei, ikwaanikin akica ŋin bon ka ŋina a ŋirwa a ŋikanikaarei.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atubokino a ŋituŋa ka Asiriya",
          "type": "text"
        }
      ]
    }
  ],
