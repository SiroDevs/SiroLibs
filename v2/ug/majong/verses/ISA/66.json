        },
        {
          "text": "“Ekok etaun kaŋ ŋolo asegan aberu ŋina idouni eriŋa nyeryabakina,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
