    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Epite ŋolo ipukaa Akuj ka ŋolo eŋoya Akuj",
          "type": "text"
        }
