              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoe ŋituŋa a Sion, tonyoutu, tonyoutu kitoodiutu agogoŋu kus!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
