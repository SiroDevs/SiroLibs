              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        },
        {
          "name": "verse",
