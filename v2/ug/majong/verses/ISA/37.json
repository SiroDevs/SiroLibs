        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ISA 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋin nakwaare abu emalaika ke Ekapolon tolot neni aya ŋasigarya ka Asiriya toar ŋasigarya ŋalipyo amiat ka ŋatomonikanikauni ka ŋikan, ani taparacu iwalari akwap, toryamunae ikes daadaŋ erae ŋalyalin bon ayakasi nen. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai erwosit Senakerib ŋolo ka Asiriya tolot, toboŋo lore keŋ, kiboi alo Ninepe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit apei eriŋa Senakerib ilipi alokai a akuj keŋ a ŋina anyaritae Nisirok, apotu ŋidwe keŋ ŋulusapa Adiramalek ka Sareser toara iŋes a ekileŋ, ido tosiwa nakwap ŋina ka Ararat. Abu lokoku keŋ ŋolo anyaritae Esaradon kilunyokin lokicoloŋ keŋ kipuka Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
            ]
          }
        }
      ]
