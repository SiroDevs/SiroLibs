        },
        {
          "text": "Alorwa a ŋulu araakatar Yosam ka Aas ta Esekia ŋirwosi ŋulu a Yudaya, abu Ekapolon tolimok ŋakiro nu neni a Maika. Arae Maika ŋolo abunit alotaun a ŋolo a Moreses. Abu Ekapolon kisileerek Maika ŋakiro nu daadaŋ aŋuna a Samaria ka Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atubokino a Samaria ka Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amunyaro ŋina a ŋitaunio a Yudaya",
          "type": "text"
        }
      ]
    }
