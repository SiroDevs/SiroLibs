          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikimunya isua erwosit Nebukadinesar ŋolo a Babilon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.34",
            "verseOrgIds": [
              "JER.51.34"
            ]
