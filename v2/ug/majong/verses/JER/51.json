          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aŋun, alimu Ekapolon atemar,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.52",
            "verseOrgIds": [
              "JER.51.52"
            ]
          }
        }
