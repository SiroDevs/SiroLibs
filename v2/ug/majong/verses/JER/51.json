          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Irurumaete ŋituŋa a Babilon kaapei ikwa ŋiŋatunyo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.38",
            "verseOrgIds": [
              "JER.51.38"
            ]
          }
        }
