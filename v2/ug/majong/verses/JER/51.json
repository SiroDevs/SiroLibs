          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kipenasi ŋikaleŋeleŋe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.11",
            "verseOrgIds": [
              "JER.51.11"
            ]
