      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erae ŋituŋa a Isirael ŋulu itiyaete aŋuna ke Ekapolon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akinyasuno a Babilon",
          "type": "text"
        }
      ]
    },
    {
