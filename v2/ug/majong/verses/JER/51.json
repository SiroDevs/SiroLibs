          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kiirasi, eyai akigworo Babilon!",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.54",
            "verseOrgIds": [
              "JER.51.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
