        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.57",
            "verseOrgIds": [
              "JER.51.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
