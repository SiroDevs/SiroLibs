          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kire jik, eponito ŋirwa ŋulu esicania ayoŋ ŋakujo a Babilon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.47",
            "verseOrgIds": [
              "JER.51.47"
