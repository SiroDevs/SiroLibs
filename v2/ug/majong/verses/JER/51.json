          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoe ŋituŋa kaŋ, tolomutu kiŋa alo Babilon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.45",
            "verseOrgIds": [
              "JER.51.45"
            ]
          }
        }
