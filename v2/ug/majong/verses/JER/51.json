          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Emaikina Babilon kinyasunae aŋuna a ŋituŋa a Isirael,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.49",
            "verseOrgIds": [
              "JER.51.49"
            ]
          }
        }
