        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋatakanikineta ka ŋakitoodikineta ŋuna a Paulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemokino ayoŋ eturokin tari kemam epoida daŋ a? Nai erwori ayoŋ tokona ŋuna eketatakanik ka eketoodik Ekapolon ayoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.1",
            "verseOrgIds": [
              "2CO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeni ayoŋ ekile ece ŋolo a Kristo, ŋolo aponi yaarae kidiama nakuj ŋikaru ŋitomon ka ŋiomwon ŋulu alunyarosi. Nyayeni ayoŋ erae keyakar iŋes aina akuwan kori etau bon--Akuj bon eyeni! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.2",
            "verseOrgIds": [
              "2CO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeni ayoŋ atemar aponi ekile ŋol yaarae najakaanut ŋina anakuj. Nyayeni ayoŋ erae keyakar iŋes aina akuwan kori etau bon--Akuj bon eyeni! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.3",
            "verseOrgIds": [
              "2CO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu iŋes kiira ŋakiro ŋuna nyepedori idiotuŋanan akirwor ŋuna nyepedoryo alimun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.4",
            "verseOrgIds": [
              "2CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, eturokinor ayoŋ ekile ŋol, nai nyeturokin ayoŋ aŋuna kaŋ ke elope, mati apalago kaŋ bon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.5",
            "verseOrgIds": [
              "2CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kacamit ayoŋ akiturokin, nyaruwor ayoŋ ebaŋ, anerae erwori ŋakiro ŋuna a kire. Nai aesik ayoŋ akituro, anerae nyacamit ayoŋ idiotuŋanan eketojok ayoŋ nooi akilo ŋuna ite ka epupi iŋes aneni kaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.6",
            "verseOrgIds": [
              "2CO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.6",
            "verseOrgIds": [
              "2CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋuna ka akiretakin ayoŋ nyeturo, aŋuna ka alalau a ŋakitoodikineta, aponi okoinakin ayoŋ apipilu ŋina ikoni aremot ŋina ke ekukwae, apipilu ŋina erae Satan iyakuunit, akisican ka akiretakin ayoŋ nyeturo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.7",
            "verseOrgIds": [
              "2CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋarwa ŋauni, abu ayoŋ elip neni ke Ekapolon aŋuna a ibore a ŋin ka eŋitak iŋes alemar ibore ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.8",
            "verseOrgIds": [
              "2CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai abu iŋes okolimok ayoŋ tema, “Ajokis kaŋ iŋes bon iitanit iyoŋ, anerae egogoŋ apedor kaŋ nooi apaki ŋina ipalagia iyoŋ.” Alakari ayoŋ nooi eturokin aŋuna ka apalagu kaŋ, ikotere min apedor ŋina a Kristo tooma kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.9",
            "verseOrgIds": [
              "2CO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋuna nai a Kristo, alakara ayoŋ nooi aŋuna ka apalagu, ŋiyany, ŋatyokisyo, ŋakisicaneta ka ŋaronisya! Anerae ani apalag ayoŋ, agogoŋior.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.10",
            "verseOrgIds": [
              "2CO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amitakinit a Paulo Ŋikristo alo Korinto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.10",
            "verseOrgIds": [
              "2CO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiyae ayoŋ ikwa ebaŋaanot! Ipotu iyes itoreikis ayoŋ akitiya ŋun. Etemokino torae iyes ikitojokito ayoŋ. Tari karae ayoŋ ecaryoit, nyekeloito jik ayoŋ ŋituŋa ŋul ŋulu ebookoi iyes “Ŋikiyakia ŋulu apolok nooi”. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.11",
            "verseOrgIds": [
              "2CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakitoodikineta ŋuna iteyenunito atemar arae ayoŋ ekiyakia ŋolo a kire, ikes aponi kitiyae alokidiŋ kus alotooma atitinyikinit daadaŋ ka abu Akuj kitiya ŋakujuwuanisya, ŋaumonokineta, ta ŋiticisyo ŋulu apolok. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.12",
            "verseOrgIds": [
              "2CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaani ibore ŋini abu ayoŋ etiyak natukon a Ŋikristo ŋunace, ŋini nyitiyakina neni kus? Ŋisiliŋa robo ca bon nyiŋita ayoŋ iyes. Okoe, kisyoni ayoŋ aŋuna ka adyakaret a ŋin.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.13",
            "verseOrgIds": [
              "2CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.13",
            "verseOrgIds": [
              "2CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae tokona na apaki ŋina a ŋauni, ŋina atenitor ayoŋ abunio aanyun iyes ka emam ibore idio ekeŋisi iyes. Ekeitanit ayoŋ iyes, meere ŋisiliŋa kus, anerae meere ŋidwe itemokino kiŋarakis ŋikauruunak kec, kire ŋikauruunak ikes itemokino kiŋarakis ŋidwe kec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.14",
            "verseOrgIds": [
              "2CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuni ayoŋ alakari nooi erae kekesunyak iyes ŋinibore daadaŋ ayakar ka ojal akuwan kaŋ daŋ aŋuna ka akiŋarakin ŋitai kus. Kaanukiro ikiminatar iyes ayoŋ iwadiocici aŋuna akaminar ayoŋ iyes nooi?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.15",
            "verseOrgIds": [
              "2CO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.15",
            "verseOrgIds": [
              "2CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icamunete iyes kire atemar, abu ayoŋ nyetogogoŋ akiyar kus. Nai etemarete ŋituŋa ŋice amodiyana ayoŋ ka abu ekeŋalaiya iyes ka alyokonu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.16",
            "verseOrgIds": [
              "2CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwaani nai? Abu mono ayoŋ oryamu epoida anakiyakuun neni kus ŋikilyok ŋulu abu eyaku a? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.17",
            "verseOrgIds": [
              "2CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ elip Tito alosit ka abu eyaku lokaato ŋolo abu torukut ka iŋes. Itemarete nai iyes abu Tito toryamu epoida aneni kus a? Nyitiya nai isua a epite a epei a? Nyetupa mono isua erot epei a?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acepaki itamete iyes atemar kori iwaritae isua jik aryamun epite ŋolo eiunore isua alokiŋaren kus. Mam! Ikirworo isua alopite a ŋolo ikicamakinitor isua Kristo kirworoe alokiŋaren Akuj; ŋikaitotoi kaŋ, ibore daadaŋ ŋini ikitiyae isua, ikitiyae akiŋarakinia iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.19",
            "verseOrgIds": [
              "2CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabulit ayoŋ atemar ŋina adolunio ayoŋ inaa, akaryamuni iyes igelaaka, pa ikote neni acamit ayoŋ iyes kikote ka ayoŋ daŋ pa ekoni neni icamito iyes ayoŋ ekoni. Akabulit ayoŋ atemar aryamuni aneni kus ebura, arakao, anyunyura, emwane, ŋiyany ka akirworor ŋuluce, akituro ka atyakatyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.20",
            "verseOrgIds": [
              "2CO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabulit ayoŋ atemar ŋina adolunio inaa, ebuni Akuj kaŋ akisurum ayoŋ ŋileec alokiŋaren kus ka abuni nai ayoŋ akigworo aŋuna a ŋulu alalak, a ŋulu apotu toseca ŋapakio ŋuna alunyarosi toriŋa nyekiwa ŋipitesyo kec ŋulu ka aronis, ebe adoteu ka amalao.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.21",
            "verseOrgIds": [
              "2CO.12.21"
            ]
          }
        }
      ]
    }
  ],
