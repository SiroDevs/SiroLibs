          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toseunae Saul aruwor erwosit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayai Isirael ekile ŋolo abarit nooi, abunit alokabila a Benjamin, arae ekiro keŋ Kis lokoku ka Abiel a ŋolo arae lokoku a Seror, arae Seror lokoku a Bekoras, ido arae Bekoras lokoku ka Apia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.1",
            "verseOrgIds": [
              "1SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakar Kis ikoku keŋ ŋinisapat ŋini anyaritae Saul, arae Saul esorokit ŋolo ebus, mam ekile alo Isirael ebus akilo iŋes; arae iŋes ekile ŋolo aoyan akilo Ŋisirael daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apeikoloŋit, kepotu ŋisigirya a Kis a papa a Saul toolyoto. Aŋun, abu Kis tema neni a Saul a lokoku keŋ, “Torukosi ka eketiyan epei, toloto kiwarasi ŋisigirya.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu nai Saul ka eketiyan ŋol kiwarasi ŋisigirya, kiwara nakwap ŋina a ŋikamukumukui ŋina enyaritae Epuraim ka kiwara nakibois ŋina enyaritae Salisa; nai apotu ikes nyeryamut ŋisigirya. Kiwarasi nakibois ŋina enyaritae Saalim, nai apotu nyeryamut. Ekaku, kiwarasi nakwap ŋina a Benjamin, nai apotu nyeryamut tari a nen.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edolunete ikes nakwap ŋina a Sup, tema Saul neni a eketiyan a ŋolo arukitotor iŋes, “Apena oboŋosi, epedori acepaki papa kaŋ akimyekin atamatam aŋuna a ŋisigirya, ido kisyak atamatam aŋuna yok.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.5",
            "verseOrgIds": [
              "1SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tema eketiyan ŋol neni a Saul, “Eyai lotaun ŋol ekile ŋolo erae ituŋanan ŋini ka Akuj, erae iŋes ekile ŋolo itopolooritae. Iyoonokin ŋakiro daadaŋ ŋuna elimuni iŋes. Apena neni keŋ tokona; acepaki ikilimokini iŋes iwon neni ikiryamunia ŋisigirya.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.6",
            "verseOrgIds": [
              "1SA.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema nai Saul neni a eketiyan a ŋol, “Ani nai tokona kelosi iwon neni keŋ, nyo eayo iwon ataca ekile ŋol? Anerae adaun ŋamugati alocweei yok, ido mam ainakinet ŋina eayo iwon neni ke ekile a ŋolo erae ituŋanan ŋini ka Akuj a ŋol. Nyo eyakare iwon?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.7",
            "verseOrgIds": [
              "1SA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok nabo eketiyan ŋol Saul tema, “Kiŋolik, ayakar ayoŋ ŋicekelya ŋidi ŋulu a esilipa; ainakini ayoŋ ikes neni a ekile a ŋol a ŋolo erae ituŋanan ŋini ka Akuj, ikotere ikilimokini iŋes iwon neni emaikina iwon ewarasi ŋisigirya.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.8",
            "verseOrgIds": [
              "1SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Koloŋ sek anakwap a Isirael, ituŋanan daadaŋ ŋini acamit akiŋit Akuj ŋakiro ŋadi, atemari ebe, “Bua, apena oanyutu eketeyenikinan;” anerae ituŋanan ŋini tokona enyaritae ekadwaran, anyaritae apaki ŋin eketeyenikinan.) ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.9",
            "verseOrgIds": [
              "1SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Saul neni a eketiyan a ŋol, “Ejok! Bua apena.” Aŋun, apotu ikes toloto lotaun neni ayai ekile ŋolo arae ituŋanan ŋini ka Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eriŋa ikes itipeete emukura elosete lotaun, kiryamas ka ŋapesur ŋace ŋuna alosete kare elomunete alotaun, kiŋita ata Saul ŋapesur ŋun temasi, “Eyai eketeyenikinan lotaun lo a?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.11",
            "verseOrgIds": [
              "1SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋokis ŋapesur temasi, “Eyai, eŋolopei alokiŋaren kus ŋol. Kiwonyakisi! Adolun iŋes lotaun kosi napei na, anerae earito ŋituŋa amuronot nakoloŋit na anakibois a ŋinamukur. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.12",
            "verseOrgIds": [
              "1SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomar iyes lotaun bon, iryamunete iyes iŋes eriŋa nyeloto nakibois ŋinamukur akimuj, nyimujete ŋituŋa mati kelot iŋes nen; anerae emaikina iŋes kiterereŋ amuronot, kimuja nai ŋituŋa ŋulu enyaritae nen. Kitipeiyosi, iryamunete iyes iŋes atipei.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.13",
            "verseOrgIds": [
              "1SA.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu ikes kitipeiyosi lotaun. Alomar ikes lotaun bon, kiŋolikis Samuel ebunit neni ayakasi ikes, itipe nakibois ŋinamukur.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.14",
            "verseOrgIds": [
              "1SA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.14",
            "verseOrgIds": [
              "1SA.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriŋa akoloŋit ŋina atupakinit ŋina abunio Saul, kebu Ekapolon tolimok Samuel ŋakiro nu, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.15",
            "verseOrgIds": [
              "1SA.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Moi taparacu apaki napei na, eyakuuni ayoŋ neni kon ekile ŋolo ebunit anakwap a Benjamin, ido emaikina iyoŋ kiosak akimyet lokile ŋol, toruwor iŋes ekepukan a ŋituŋa kaŋ a Ŋisirael. Eiuni iŋes ŋituŋa kaŋ anakan a Ŋipilistin; anerae eŋolik ayoŋ ŋican ŋulu eryamunito ŋituŋa kaŋ ka adolu akigworo kec neni kaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.16",
            "verseOrgIds": [
              "1SA.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iŋolikini Samuel Saul, tema Ekapolon neni a Samuel, “Ekile ŋolo akalimokinit ayoŋ iyoŋ iŋes ŋol. Iŋes emaikina kipuka ŋituŋa kaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.17",
            "verseOrgIds": [
              "1SA.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todol nai Saul neni a Samuel eriŋa eyai tooma ekek, tema neni keŋ, “Kiŋarakinae ro, tolimokinae! Ai eyai akai a eketeyenikinan?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.18",
            "verseOrgIds": [
              "1SA.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok Samuel Saul tema, “Ayoŋ arae eketeyenikinan, kitipeiyo kidiama, kiŋarenikinoe ayoŋ apena nakibois ŋinamukur, anerae emaikina iyoŋ emuja ka ayoŋ nakoloŋit na, ido ekemyek ayoŋ iyoŋ tolot moi taparacu, kadau alimokin iyoŋ ŋakiro daadaŋ ŋuna eya natameta kon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.19",
            "verseOrgIds": [
              "1SA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tojoŋo atamatam ŋuna a ŋisigirya kon a ŋulu aolito ŋirwa ŋiuni ŋulu alunyar; adaun ikes aryamun. Ŋae mono etamakinito Ŋisirael daadaŋ atemar kipuka ikes, meere mono iyoŋ ka ŋituŋa a ekal a papa kon a?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.20",
            "verseOrgIds": [
              "1SA.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok Saul tema, “Arae ayoŋ ituŋanan ŋini a ekabila a Benjamin a ŋolo edit alokabilae a Ŋisirael. Ŋituŋa a ekal kosi daŋ, erae ŋicaryo alokalya a ekabila a Benjamin. Kaanukiro nai ikilimokinia iyoŋ ayoŋ ŋakiro ŋuna ikote ŋun?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.21",
            "verseOrgIds": [
              "1SA.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.21",
            "verseOrgIds": [
              "1SA.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya nai Samuel Saul ka eketiyan a Saul, ya ikes tooma akai, kisiboik ikes kiŋaren ŋituŋa ŋulu anyaraunitae nen, ŋulu adolit ekimar ŋatomoniuni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.22",
            "verseOrgIds": [
              "1SA.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Samuel ekepon tema, “Yau akiriŋ ŋina takae akainit ayoŋ iyoŋ, ŋina abala ayoŋ iyoŋ toseta nawae.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.23",
            "verseOrgIds": [
              "1SA.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolemu nai ekepon amuro ka akiriŋ ace ŋina arukitotor, kiwuak kiŋaren Saul. Tema Samuel neni a Saul, “Kiŋolik, ewuakin kiŋaren kon akiriŋ ŋina sek eŋadaaritae. Kimuj, anerae eŋadaaritae sek iŋes a ŋuna kon, kimuj apaki na ŋina itemokinitoe, kimuja kaapei ka ŋituŋa ŋulu anyaraunit ayoŋ akimuj.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
