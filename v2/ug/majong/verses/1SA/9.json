              "type": "text"
            }
          ]
        },
        {
          "text": "Kimuja Saul ka Samuel kaapei akoloŋit ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani etiyaun ikes anakibois a ŋinamukur, epote lotaun, aponi kitemokinoe neni eperi Saul nenilapat alokidiama, kinapakin iŋes nen tojotoor. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani nai esodi akwap akiwalar, tonyarau Samuel Saul alokidiama akai tema, “Tonyou, ikotere eketolot ayoŋ iyoŋ.” Tonyou Saul, torukosi ka Samuel kiŋa akai toloto lorot.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiosak Samuel Saul akimyet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
