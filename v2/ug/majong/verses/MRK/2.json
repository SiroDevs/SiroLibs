              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok nabo Yesu ikes tema, “Asubunio Sabato aŋuna a ituŋanan, meere ituŋanan aŋuna a Sabato. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, Lokoku a Ituŋanan iŋes erae Ekapolon tari a Sabato.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.28",
            "verseOrgIds": [
              "MRK.2.28"
            ]
          }
        }
