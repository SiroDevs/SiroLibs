              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok Yesu ikes tema, “Nyesyoma iyes ŋuna abu Daudi kitiya lotuŋa keŋ apaki ŋina anyamitor ikes akoro a? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋina abunio iŋes toloma kai ŋinakilipet Akuj, ŋirwa ŋulu araakar Abiasar Esacaradoti ŋolo Apolon nooi, bu tonyam ŋamugati ŋuna ainakinitae Akuj, ŋuna acamakinitae ŋisacaradotin bon akinyam. Ani kenyam, inak ŋikeerukitos daŋ tonyama.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        }
      ]
    },
    {
