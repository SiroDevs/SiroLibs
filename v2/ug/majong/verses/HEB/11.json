      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes ayenut kire atemar erae ŋakiro ŋuna ikigeno iwon ŋuna a kire, anupit iŋes amamukau ka aŋayaŋayat aloboro a ŋulu nyikite iwon. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.1",
            "verseOrgIds": [
              "HEB.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anerae anupit kec iŋes abunio Akuj tocamunia ŋituŋa ŋulu a koloŋ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes ikiyenia iwon atemar kesubi Akuj akwap kan akirot keŋ, aŋun ibore ŋini ikite iwon, kitiyaunio aloboro a ŋulu nyetakanete.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.3",
            "verseOrgIds": [
              "HEB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.3",
            "verseOrgIds": [
              "HEB.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes etelemuni Abel amuronot ŋina ajokan akilo ŋina a Kain. Anupit iŋes abunio Akuj tocamunia iŋes erae ŋolo iyookino, anerae Akuj alope abu kiteyenu ŋun anacamun ŋainakineta ŋuna ka Abel. Aŋuna ka anupit keŋ, eriŋa ŋakiro ŋuna abu iŋes kitiya irworosi neni yok, tari ketwanit iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.4",
            "verseOrgIds": [
              "HEB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.4",
            "verseOrgIds": [
              "HEB.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes pa abunio Enok totwania. Akilo, aponi yaarae iŋes kidiama ka emam ituŋanan abu toryamu iŋes, anerae abu Akuj ya iŋes nakuj. Igiritae Nakigireta atemar ani eriŋa Enok nyeara kidiama, aris iŋes kitalaka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.5",
            "verseOrgIds": [
              "HEB.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam ituŋanan italakari Akuj mati eyakar anupit; anerae ŋini ebuni neni ka Akuj, itemokino tonupite atemar eyai Akuj, nabo einanakini Akuj eropit neni a ŋulu enupito iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.6",
            "verseOrgIds": [
              "HEB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.6",
            "verseOrgIds": [
              "HEB.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes eirarya Noa ŋakiro ŋuna ecikya Akuj iŋes aŋuna a ŋakiro a ŋuna eriŋa nyetakanuna. Abu iŋes kiira ŋakiro ŋuna ka Akuj, toduk ataker ŋina abunio iŋes ka ekeekal toiunotor. Aŋakiro a ŋun, aponi totubokinae akwap daadaŋ, nai abu Noa toryamu aneni ka Akuj akiyookino, anerae anupit iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.7",
            "verseOrgIds": [
              "HEB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.7",
            "verseOrgIds": [
              "HEB.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes ewuapakinia Aburaam ŋakiro ŋuna ka Akuj apaki ŋina anyaraa Akuj iŋes alosit nakwap ŋina eikinit Akuj ainakin iŋes. Toesik iŋes akwap keŋ, pa eyeni neni alosi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.8",
            "verseOrgIds": [
              "HEB.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes abunio Aburaam kiboi anakwap a ŋina eikinit Akuj iŋes erae ituŋanan ŋini gela. Abu iŋes kiboi aloeemae ikwa Isaka ka Yakobo ŋulu apotu toryamut akiikinet ŋinapei aneni ka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.9",
            "verseOrgIds": [
              "HEB.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anerae edarit Aburaam anakigeno etaun ŋolo etemunit ka adukunit Akuj, etaun ŋolo erubakini eyai jik.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.10",
            "verseOrgIds": [
              "HEB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.10",
            "verseOrgIds": [
              "HEB.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes aruworor Aburaam papa tari ŋina abunio iŋes tomojoŋia nooi daŋ ka Sara daŋ pa auri. Ayeni Aburaam atemar Akuj ŋina adau akiikin, erae ŋina ikinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.11",
            "verseOrgIds": [
              "HEB.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari daŋ apaki ŋina atakania iŋes esibit aris kesalu, abu touru ŋidwe ŋulu alalak ikwa ŋikacer alokidiama ka etya asinyon ŋina ka anam, ŋina nyimarun.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.12",
            "verseOrgIds": [
              "HEB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.12",
            "verseOrgIds": [
              "HEB.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋituŋa ŋul daadaŋ totwaka enupito. Apotu ikes nyeryamut ŋiboro ŋulu sek eikinit Akuj ikes, nai apotu toanyuwasi ŋiboro ŋul aneni elwana, tolakaros. Apotu tolimosi atemar erae ikes ŋituŋa ŋulu gelae ka ŋikawuotok anakwap a na. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.13",
            "verseOrgIds": [
              "HEB.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋituŋa ŋulu irworosi ŋakiro ŋuna ikote ŋun, isileereunito atemar ecamito ikes akwap ŋina erae ŋina kec a ŋilopeyek. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.14",
            "verseOrgIds": [
              "HEB.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ikes nyerubakis etamunito akwap ŋina apotu toesikis; kerae torubakinito, keryamunito apaki ŋina boŋoret. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.15",
            "verseOrgIds": [
              "HEB.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai arae akibois ŋina ajokan akilo eitanito ikes, akibois ŋina eyai nakuj. Aŋun, nyirumito Akuj ŋileec enyarito ikes iŋes Akuj kec, anerae etemok etaun aŋuna kec.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.16",
            "verseOrgIds": [
              "HEB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.16",
            "verseOrgIds": [
              "HEB.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes alemunia Aburaam lokoku keŋ Isaka toruwor amuronot apaki ŋina ekatakinitor Akuj iŋes. Atenit Aburaam ainakin lokoku keŋ ŋolo donupei aruwor amuronot, tari ŋina aris ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.17",
            "verseOrgIds": [
              "HEB.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuj kiikinia iŋes tema, “Erae neni a Isaka iŋes iryamunia iyoŋ ŋiletok ŋulu ekeik ayoŋ iyoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.18",
            "verseOrgIds": [
              "HEB.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atami Aburaam atemar epedori Akuj akiteyarun Isaka--ka ikwaan ŋakiro nu ka atemar, abu Aburaam kijau Isaka tari sek ketwanit.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.19",
            "verseOrgIds": [
              "HEB.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.19",
            "verseOrgIds": [
              "HEB.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes eikinia Isaka Yakobo ka Esau ŋarereŋisyo ŋuna eponito alokiŋaren.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.20",
            "verseOrgIds": [
              "HEB.11.20"
            ]
          }
        }
      ]
    },
    {
