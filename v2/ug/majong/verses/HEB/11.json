      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.20",
            "verseOrgIds": [
              "HEB.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anupit iŋes eterereŋio Yakobo ŋidwe a Yosepu ŋulusapa eriŋa iŋes nyetwana. Abu iŋes togwaŋakin lobela keŋ, ido kilip Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.21",
            "verseOrgIds": [
              "HEB.11.21"
            ]
          }
        }
      ]
    },
