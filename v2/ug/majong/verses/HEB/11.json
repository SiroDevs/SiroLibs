        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Akuj tocamu ŋituŋa ŋul daadaŋ aŋuna ka anupit kec, nai nyeryamuna ikes ŋuna sek eikinit Akuj, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
            "verseOrgIds": [
              "HEB.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "HEB 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "aŋuna abunio Akuj totubunio ibore ŋini ajokan nooi aŋuna yok, pa acamit iŋes akituruwor ikes ŋulu iyookino kire emamukae iwon.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
