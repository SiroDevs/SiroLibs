{
  "id": "1CH.10",
  "number": "10",
  "bookId": "1CH",
  "reference": "1 Ŋakiro A Ŋirwa 10",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
