    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kipuka Yosia Yudaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋikaru a Yosia ŋikanikauni ŋina esyakinia akipuka. Kipuka iŋes Yudaya alo Yerusalem ŋikaru ŋatomoniuni ka epei. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu iŋes kitiya ŋakiro ŋuna etalakarito Ekapolon ka ewuapit ŋipitesyo daadaŋ ŋulu a Daudi a papaa keŋ. Abu Yosia nyimyek akitiya ŋuna eyookino alokiŋaren Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edolete ŋikaru ŋulu epukator iŋes ŋikanikauni eriŋa iŋes erae edya, abu iŋes kisyak ayenun ŋuna ka Akuj a papaa keŋ a Daudi. Ani edolete ŋikaru keŋ ŋitomon ka ŋiarei, abu iŋes kisyak amunaanar alo Yudaya ka alo Yerusalem ŋakiboisyo ŋunamukur ŋuna elipere neni a ŋakujo, tomunaana tari ŋitorubei a ŋakujo ŋuluce daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakiro a ŋuna alimuni iŋes, aponi toukonoroe ŋamuroeta a Baal, tobwaŋabwaŋarae ŋitorubei ŋulu aya kidiama ŋamuroeta ŋun, tomunaa ŋitorubei a akuj a ŋina anyaritae Asera ka ŋitorubei a ŋakujo ŋuluce daadaŋ, kinyaadiyarae toruwor apuwa, ido kielakinae apuwa ŋin kidiama ŋalyalin a ŋulu apotu sek inanakis ŋamuronisya nakujo ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu daŋ Yosia kicuny ŋakoyo a ŋisacaradotin a ŋakujo a ŋun alokidiama ŋamuroeta ŋuna sek apeyoto ikes ŋainakineta ikotere inyasunio ŋamuroeta ŋun; aŋun, abu Yosia kitaleu Yudaya ka Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Yosia kitiya ŋakiro ŋunapei ŋun lotaunio ka nakiboisyo ŋuna aponi kinyasunae alokabilae a lu: Manase, Epuraim ka Simeon todol tari lokabila ŋolo a Naputali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kitiya nu anakwap a Yudaya a daadaŋ, tobwaŋabwaŋaa ŋamuroeta, ŋitorubei ka akuj a ŋina anyaritae Asera, kinyaadi ŋakujo toruwor apuwa ka totubutubu ŋamuroeta ŋuna ecunyere ekinyate anakwap a Isirael a daadaŋ. Ani irikakini, toboŋo Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toryamunae ekitaabo ŋolo a Ŋikisila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokaru a ŋolo a ŋitomon ka ŋikanikauni ipukat Yosia, toris iŋes kitaleu akwap a Yudaya ka Akai ka Akuj, abu iŋes kiyakiya Sapan lokoku ka Asalia ka Maaseia ŋolo arae ekapolon a etaun ta Yoa lokoku a Yoaas a ŋolo arae ekegirigiran alosit akiduk neni amunaara alo Kai ke Ekapolon Akuj keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋituŋa ŋul toloto neni a Ilikia a esacaradoti a ŋolo Apolon nooi, inakis iŋes ŋisiliŋa ŋulu keponi yaunae Kai ka Akuj. Arae ŋilepi ka ŋiketeok epuke ŋolo ka Akai ka Akuj kepotu tocunut ŋisiliŋa ŋul aneni a ŋituŋa a ekabila a Manase, a Epuraim ka aneni a ŋituŋa a daadaŋ a ŋulu kidoŋito nakwap a Isirael erikoryo ŋuluce ta aneni a ekabila a Benjamin ka ŋituŋa a Yudaya daadaŋ ka aneni a ŋituŋa a ŋulu eboiyete alo Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋituŋa ŋulu eyakit Yosia ŋul inakis ŋisiliŋa neni a ŋulu apolokinito etic ŋolo ka Akai ke Ekapolon, tosodo ŋul totaca ŋiketiyak ŋulu adukete neni amunaanara ka akitojokun nabo Akai ka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu daŋ ikes inakis ŋisiliŋa neni a ŋikeciak ŋabaoi ka neni a ŋikadukok togyeluniata ŋamoru ŋuna atubutubutoe ejok ka ŋabaoi aŋuna ka adukokinia nabo ŋaduketa ŋuna apotu ŋirwosi a Yudaya kimyekis emunaar. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋiketiyak ŋul kitiyata etic ŋol anakikinyoma. Ŋituŋa lu apolokinito ikes itiyaete: Yoas ka Obadia ŋiletok a ŋilepi a ŋulu anateker a Merari; Sakariya ka Mesulam ŋiletok a Koas. Apotu ŋilepi ŋice daŋ ka ŋulu daadaŋ ayenete akiram ŋiboro ŋulu eore, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "topolokis ŋituŋa ŋulu etiyaete ka kimanimana ŋiketiyak daadaŋ alotooma ŋolotic etiyao alo Kai ka Akuj. Arae ŋilepi ŋice ŋikegirigirak, ŋikapolokinitok etic ka ŋiketeok ŋipukei.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani elemunete ikes ŋisiliŋa ŋulu eŋadatae Kai ke Ekapolon, toryamu esacaradoti Ilikia ekitaabo ŋolo a Ŋikisila a Ekapolon, ekitaabo ŋolo ayakasi Ŋikisila ŋulu ainakini Ekapolon neni a Moses. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Ilikia neni a Sapan a ekegirigiran, “Arukau ayoŋ ekitaabo ŋolo a Ŋikisila alotooma Akai ka Akuj.” Inak Ilikia ekitaabo ŋol neni a Sapan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yau Sapan ekitaabo ŋol neni a erwosit, tolimok Sapan erwosit tema, “Itiyaete ejok ŋiketiyak kon etic daadaŋ ŋolo ainakinitae ikes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaut ikes ainakin ŋisiliŋa daadaŋ ŋulu aya Kai ka Akuj neni a ŋulu epolokinito etic ŋolo ka akiduk neni emunaara alo Kai ka Akuj ka neni a ŋiketiyak.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema nai Sapan ŋolo arae ekegirigiran a erwosit neni a erwosit, “Akainaki ayoŋ esacaradoti Ilikia ekitaabo.” Tosyom nai Sapan ekitaabo ŋol alokiŋaren erwosit ikeunit ŋakiro ŋuna asyomi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirari erwosit Yosia ŋakiro ŋuna egiritae lokitaabo ŋolo a Ŋikisila, abu tocilicili ŋilowi keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu erwosit kicik Ilikia, Aikam lokoku a Sapan, Abidon lokoku a Mika ka Sapan ekegirigiran ta Asaia ekiyakitono ŋolo a erwosit tema, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Toloto toanyutu aneni ke Ekapolon ŋakiro ŋuna ekekamunito ayoŋ ka ŋituŋa ŋulu idoŋito Isirael ka Yudaya, anakiro a ŋuna igirir lokitaabo lo ŋolo arukaun. Ikiŋoikinit nooi Ekapolon iwon, anerae apotu atapapaa yok towout akiwuap ŋakiro ŋuna a Ekapolon, nyitiya ikes lopite ŋolo ecamuna ka ŋuna daadaŋ igiritae tooma lokitaabo lo.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiŋitae akadwaran Ulida ŋakiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Ilikia ka ŋulu sek eyakit erwosit toloto aanyun aberu ŋina anyaritae Ulida; ŋina arae akadwaran, torae aberu a Sulam alokoku keŋ a Tikiba a ŋolo arae lokoku ka Asira a ŋolo edarit akabati a ŋilowi a ŋulu ilipere. (Eboi iŋes alo Yerusalem anatutubet a ŋina a ŋaarei alootoma ŋaomwon a akwap a Yudaya.) Tolimokis ŋul Ulida ŋakiro ŋuna eyakitere ikes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu akadwaran ŋin tolimok ikes tema, “Ebala Ekapolon ŋolo erae Akuj a Ŋisirael ebe, ‘Tolimokisi ekile ŋolo ikiyakuunit iyes neni kaŋ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "atemar kire jik, esicani ayoŋ akibois na ka ŋituŋa keŋ lopite ŋolo igiritere lokitaabo ŋakiro daadaŋ ŋuna aponi tosyomunae alokiŋaren erwosit. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋuna akaŋeryoto ikes ayoŋ ka aŋuna ainakiniata ŋainakineta neni a ŋakujo a ŋace, adaut ikes akitoŋo ayoŋ nooi aloticisyo a daadaŋ a ŋulu itiyaete ikes. Aŋun, eyatakin aŋoit kaŋ nooi aŋuna a ŋituŋa a akibois a na, ido nyedaun aŋoit kaŋ jik.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tolimokisi erwosit a Yudaya ŋolo ikiyakuunit iyes akiŋitun ŋakiro aneni ke Ekapolon atemar, ebala Ekapolon ŋolo erae Akuj a Ŋisirael, ikote ne ŋakiro ŋuna ibu iyoŋ kiira, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Aŋuna ibunio iyoŋ toki alotau kon ka kitiditeun apaki ŋina iirarya ŋakiro ŋuna abu ayoŋ erwor etoroniyarit akwap na ka ŋituŋa keŋ ka aŋuna iciliciliya ŋilowi kon, ido ikikaloik ayoŋ, adau ayoŋ daŋ akiirar iyoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, akacunakini ayoŋ iyoŋ ka atapapaa kon, ikinukio iyoŋ ejok emam ŋace. Nyiŋolikini iyoŋ akisicanio daadaŋ ŋina alosi ayoŋ ayaun nakwap na ka lotuŋa keŋ.’” Apotu nai ŋituŋa ŋulu eyakitae ŋul yaasi ŋakiro ŋun neni ke erwosit.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kikiteteunae Acamunet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai erwosit Yosia kiyakiya ŋituŋa tocunut neni keŋ ŋikasikou a Yudaya daadaŋ ka ŋulu a Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu erwosit kitipeiyo Kai ka Akuj, torukosi ka ŋituŋa daadaŋ ŋulu a Yudaya ka ŋulu a Yerusalem daadaŋ. Torukosi iŋes ka ŋisacaradotin, ŋilepi ka ŋituŋa daadaŋ, ŋulu acarioko kaapei ka ŋikarwok. Tosyom iŋes alokiŋaren kec ŋakiro daadaŋ ŋuna egiritae lokitaabo ŋolo ka Acamunet, ŋolo aponi torukaunae alotooma Akai ka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towo erwosit Yosia anakibois a ŋina sek iboiyonokin iŋes, kikoŋ alokiŋaren Ekapolon akiwuapit iŋes, akiricakinit ŋakiciketa keŋ, ŋakiro keŋ ka ŋikisila keŋ a etau keŋ a daadaŋ ta akitiya ŋuna daadaŋ igiritae lokitaabo ŋol. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok nai erwosit ŋituŋa a Yerusalem daadaŋ ka ŋulu a Benjamin ŋulu ayakasi nen kiikis akiwuap Acamunet ŋin. Apotu nai ŋituŋa a Yerusalem kiwuapa ŋakiro a Acamunet a ŋin a ŋina ka Akuj atapapaa kec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolema Yosia asiilyo daadaŋ anakwap a daadaŋ a ŋina a Ŋisirael, kituruwo Ŋisirael daadaŋ ŋulu ilipete neni a Ekapolon Akuj kec. Apotu Ŋisirael kiwuapa Ekapolon Akuj atapapaa kec ŋirwa daadaŋ ŋulu ayarya erwosit Yosia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
