              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiticisyo a Solomon ŋuluce daadaŋ, ameun ŋuna eŋarenok tari ŋuna esidyok, igiritae nakiro a ekadwaran a ŋolo anyaritae Nasan ka nakiro ŋuna abu Aija ŋolo alo Silo todwar ta nakirujaeta ŋuna abu Ido ŋolo arae eketeyenikinan kirwor aŋuna a Yeroboam alokoku a Nebat. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Solomon kipuka Isirael daadaŋ alo Yerusalem ŋikaru ŋatomoniomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Solomon totwana ikwapei atapapaa keŋ ka aponi tonukae lotaun a Daudi a papa keŋ, kilunyokin Reoboam lokoku keŋ lokicoloŋ toruwor erwosit.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
