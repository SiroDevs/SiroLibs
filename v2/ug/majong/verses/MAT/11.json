          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolemasi ayokot kaŋ tonapa ka kisisyata aneni kaŋ; anerae apatana ka eyapara ayoŋ alotau, ido iryamunete akieŋun ŋina a ŋitai kus. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
