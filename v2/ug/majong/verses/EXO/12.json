        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akisyakinet a ŋasuban a ŋuna a Paska",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Ekapolon neni a Moses ka Aron anakwap a Ijipit, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.1",
            "verseOrgIds": [
              "EXO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kimarakisi elap lo toruwor aneni kus elap ŋolo ke epei alotooma ekaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.2",
            "verseOrgIds": [
              "EXO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimokisi Ŋisirael daadaŋ atemar ani edolete ŋirwa ke elap a lo ŋitomon, emaikina ŋolokile daadaŋ tolemu imesek aŋuna ka ekal keŋ; ipei a ŋolokal. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.3",
            "verseOrgIds": [
              "EXO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kekudyoko ŋituŋa ke ekal ke ece aŋuna ka akirikar imesek emaikina ekal ŋol kimorikinos ka ŋolo idunyatar iŋes, ido kiryamuryamut imesek, totyaka itiriyanitae ke ekimar a ŋituŋa a ŋulu enyamete iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.4",
            "verseOrgIds": [
              "EXO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina ŋibaren ŋulu ilemunete iyes erae ŋulumoŋin, ŋulu erae apolou ekaru epei, tomam neni ewanan anawat kec, ipedorete iyes alemun ŋibaren ŋul anamesekin, kori anamee. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.5",
            "verseOrgIds": [
              "EXO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyoko ŋibaren ŋul akitodol ŋirwa ke elap a lo ŋitomon ka ŋiomwon akoloŋit ŋina emaikina Ŋisirael daadaŋ toareta ŋibaren ŋul eikuuni akoloŋ eapuuni adoiyor. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.6",
            "verseOrgIds": [
              "EXO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina nai ikes toorut ŋaokot ŋadi alobaren a ŋul, kiosakis nakito ŋuna anawae ka ŋuna alokidiama ŋipukei a ŋakais a ŋuna enyamyata ikes ŋimeesekin ŋul. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.7",
            "verseOrgIds": [
              "EXO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina ikes tonyama akiriŋ ŋin epeitoe, tonyama imoriyarito ka ŋidyas ŋulu adwarak ta ŋamugati ŋuna emam ŋakinyalet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.8",
            "verseOrgIds": [
              "EXO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinyam akiriŋ ŋin ejon, kori ipotoi, nai topeo ibore daadaŋ: Ŋakyes, ŋimolokony ka ŋiboro a akook daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.9",
            "verseOrgIds": [
              "EXO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyimyekis akiriŋ ŋin adio daŋ idoŋi kiwalak, emaikina ŋina iwalakini daadaŋ kicunyarae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.10",
            "verseOrgIds": [
              "EXO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epite lo iŋes inyamyata iyes akiriŋ ŋin: Emaikina iyes toenito ŋilowi kus nacirin, tonapito ŋamuk kus ka totiŋito ŋibelae kus anakan, ido tonyama akiriŋ ŋin iburiburete. Erae ŋasuban ŋun ŋuna a Paska (iŋes atemar alunyar) aŋuna ke Ekapolon; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae akoloŋit ŋin nakwaare, etori ayoŋ nakwap a Ijipit daadaŋ, oar ŋikiyae daadaŋ alo Ijipit, ŋulu a ŋituŋa ka ŋulu a ŋibaren. Esicani ayoŋ ŋakujo a Ijipit daadaŋ. Arae ayoŋ Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eruwor ŋaokot emacar ŋolo itoodiunit ŋakais ŋuna iyes. Ani eŋolikini ayoŋ ŋaokot, alunyar ayoŋ aneni kus, ido mam ŋican eyakaun neni kus apaki ŋina ayaunia ayoŋ akisicanet nakwap a Ijipit.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Emaikina iyes torubakis itamunito akoloŋit na, kitiyaete ŋasuban aŋuna ke Ekapolon akoloŋit na ananyameta kus a daadaŋ ka itamunito ŋasuban ŋun erae etal ŋoloruba jik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyama ŋamugati kus ŋirwa ŋikanikaarei emam ŋakinyalet; akoloŋit ŋina esyaunan alorwa a ŋul, emaikina iyes tolemasi ŋakinyalet anakais kus, anerae ituŋanan daadaŋ ŋini enyami ibore ŋini eya ŋakinyalet akisyakin akoloŋit ŋina esyaunan tari ŋina a ŋakanikaarei, emaikina iŋes nyimari erae Esiraelit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋina esyaunan, emaikina iyes totukokinos aŋuna ka akilip neni ke Ekapolon, ani nabo edoli akoloŋit ŋina a ŋakanikaarei, emaikina totukokinos aŋuna ka akilip neni ke Ekapolon. Nyitiyata etic edyo alorwa a ŋul, mati akipore akimuj ŋina enyami ŋinituŋanan, ŋun bon emaikina iyes kitiyata. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.16",
            "verseOrgIds": [
              "EXO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyata ŋasuban ŋuna a ŋamugati a ŋuna emam ŋakinyalet, anerae akoloŋit ŋina a ŋasuban a ŋun iŋes abunio ayoŋ oyaunia anakwap a Ijipit ŋatukon kus ŋuna asibito ŋajoresyo. Torubakisi itiyaete ŋasuban ŋun ananyameta kus a daadaŋ ka itamunito ŋasuban ŋun erae etal ŋoloruba jik. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.17",
            "verseOrgIds": [
              "EXO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotooma elap ŋolo ke epei, itemokino iyes kimuja ŋamugati ŋuna emam ŋakinyalet akisyakin ŋirwa ke elap ŋitomon ka ŋiomwon eboŋ tari ŋirwa ke elap ŋatomoniarei ka epei eboŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.18",
            "verseOrgIds": [
              "EXO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotooma ŋirwa ŋikanikaarei ŋulu ke elap a ŋol, nyemaikina ŋakinyalet eyakasi nakais kus. Ituŋanan daadaŋ ŋini enyami ibore ŋini eya ŋakinyalet, emaikina iŋes nyimari erae Esiraelit; kerae iŋes egela, kori Ŋisirael eurito. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.19",
            "verseOrgIds": [
              "EXO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyinyam ibore ŋini ipotoi eya ŋakinyalet. Tonyama ŋamugati ŋuna emam ŋakinyalet alotooma ŋinakibois daadaŋ iboikinosi iyes.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyarau nai Moses ŋikasikou a Ŋisirael daadaŋ tema neni kec, “Apesi toseut ŋibaren aŋuna a ŋikalya kus, ido toara ŋibaren ŋul aŋuna a ŋasuban a Paska. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolemut ateni a ekitoe a ŋolo enyaritae Isop, kilumokis naokot ŋuna eya nabesen, ido kiosakis ŋaokot ŋun nakito ŋuna a ŋipukei. Mam iyes Ŋisirael ŋini emaikina tolomu alokai nakwaare tari ŋina iwalarya akwap; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae akoloŋit ŋin nakwaare, itori Ekapolon ne eari Ŋijipitian; ani kiŋolik iŋes ŋaokot eya nakito ŋuna a ŋipukei, elunyar iŋes alopukei a ŋul. Nyecamakini iŋes ekamunyaran elomuni nakais kus akiar iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuapa ŋakiro nu toruwor ŋunarubae aneni kus ka aneni a ŋidwe kus. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.24",
            "verseOrgIds": [
              "EXO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ilomarete iyes nakwap ŋina ikiinakini Ekapolon iyes ikwapei ikiikinitor, totamunito akitiya ŋasuban ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ikiŋisete iyes ŋidwe kus ebe, ‘Nyo apolou a ŋasuban a nu aneni kus?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.26",
            "verseOrgIds": [
              "EXO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iboŋokinete iyes ikes ebe, ‘Erae amuronot ŋina a Paska neni ke Ekapolon, anerae abu iŋes tolunyar anakais a Ŋisirael alo Ijipit, ikimyek isua apaki ŋina aarya Ŋijipitian.’ ” Ekaku aŋun, apotu Ŋisirael toryediko kilipa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ikes kitiyata ŋuna ecikit Ekapolon Moses ka Aron.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akisicanet ŋina a ŋatomon: Atwanare a ŋikiyae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edoli kidiŋ akuwar, toar Ekapolon ŋikiyae alo Ijipit daadaŋ, akisyakin aneni a ŋini a Parao a ŋini emaikina kisiboikinoe lokicoloŋ akipuka, tari neni a ŋini a emabus a ŋolo ayai lojera ka ŋikiyae daadaŋ ŋulu a ŋibaren kec. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyout Parao nakwaare ka ŋikapolok ŋulu epukatotor iŋes ta ŋituŋa a Ijipit daadaŋ; min akigworo ŋina apolon nooi nakwap a Ijipit, anerae amam ekal ŋolo pa atwanitor ituŋanan akoloŋit ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.30",
            "verseOrgIds": [
              "EXO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyarau nai Parao Moses ka Aron akoloŋit ŋin nakwaare tema, “Tonyoutu, torotokisi alotuŋa kaŋ, iyes kaapei ka Ŋisirael kus! Apesi kilipa neni ke Ekapolon lopite ŋolo ilimunitotor iyes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomyaasi ŋamesekin ka ŋaatuk kus lopite ŋolo ilimunitotor iyes, ido torotokis a ne. Togatakinae ayoŋ daŋ arereŋu!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Awosit alo Ramases tari Sukos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibunyakis Ŋijipitian Ŋisirael arotokin atipei anakwap kec, anerae abasi ikes, “Ani pa kerotokis Ŋisirael, ikimunyar iwon daadaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.33",
            "verseOrgIds": [
              "EXO.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu Ŋisirael torotokis kiwoko ŋamureta kec ŋuna amam ŋakinyalet. Kiwoko ikes tari ŋiboro ŋulumuran ŋakirya eenitae lolowi ŋulu aryoŋito ikes elosete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.34",
            "verseOrgIds": [
              "EXO.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Ŋisirael kitiyata ŋuna alimokinit Moses ikes; kijaununut aneni a Ŋijipitian ŋiboro ŋulu etiyaunitae a esilipa ka egolid kaapei ka ŋilowi daŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.35",
            "verseOrgIds": [
              "EXO.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kebu Ekapolon kitirimaanik Ŋijipitian Ŋisirael, ido kepotu Ŋijipitian inakis Ŋisirael ŋiboro ŋulu eŋitasi. Aŋun, kepotu Ŋisirael toŋatut ŋiboro aneni a Ŋijipitian.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torotokis Ŋisirael alo Ramases toloto tari Sukos. Arae ikes ŋikilyok ŋulu aapiyarit ekimar kec ŋalipyo ŋamiae ŋakanikapei pa imarakinitae ŋaberu ka ŋidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋituŋa ŋice daŋ ŋulu alalak torukosi ka ikes. Tomyaasi ikes ŋibaren ŋulu alalak, ŋamesekin ka ŋaatuk. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipout ikes ŋamugati ŋuna amam ŋakinyalet anamureta a ŋuna ewokunete ikes alo Ijipit. Amam ŋakinyalet anamureta a ŋamugati a ŋun, anerae aponi ikes kibunyakinae arotokin alo Ijipit eriŋa nyiwuakina ŋakinyalet namureta ŋun, mam daŋ akimuj adio ŋina aris ikes kitemonokis aŋuna ke erot.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋikaru ŋulu kiboitotor Ŋisirael alo Ijipit ŋamiae ŋaomwon ka ŋatomoniuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edaun ŋikaru ŋul, akoloŋit ŋina jik aŋetakinotor, apotu ŋatukon ŋuna asibito ŋajoresyo ŋuna ke Ekapolon torotokis anakwap a Ijipit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae aneni ke Ekapolon akuwar ŋin ŋina emaikina kitiyaere ŋasuban aŋuna ayaunia Ekapolon Ŋisirael anakwap a Ijipit. Itemokino Ŋisirael daadaŋ etamunito akitiya ŋasuban akuwar ŋin aŋuna ke Ekapolon ananyameta kec a daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋuna emaikina kiwuapae anasuban a Paska",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Ekapolon neni a Moses ka Aron, “Erae nu ŋakiro ŋuna emaikina kiwuapae anasuban a Paska: Mam igelaanot emaikina tonyam ŋasuban a Paska. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai epito daadaŋ ŋolo adaun akigyel ka akileŋer epedori akinyam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam igelaanot ŋini erae ipeyonon, kori ŋini enyaraunitae akitiya, epedori akinyam ŋasuban ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemokino iyes tonyama ŋasuban ŋun alokai ka apei, nyiya akiriŋ adio kiŋa. Nyitubo akoit adio ŋina a ŋibaren a ŋasuban a ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
            "verseOrgIds": [
              "EXO.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EXO 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemokino Ŋisirael daadaŋ kitiyata ŋasuban ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemokino igelaanot daadaŋ ŋini iboiyete ka iyes ŋini ecamit akitiya ŋasuban ŋun, kileŋer ŋisapa alokal keŋ daadaŋ, tosodi kitiya ŋasuban ŋun esibit ituŋanan ŋini ka akwap kus. Nai nyemaikina ituŋanan ŋini nyileŋeritae enyami ŋasuban ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae ŋun ŋuna emaikina kiwuapa ŋituŋa daadaŋ, kerae ŋini anakwap kus, kori kerae igelaanot ŋini iboiyete ka iyes.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Ŋisirael daadaŋ kitiyata ŋakiro ŋun lopite ŋolo ecikitor Ekapolon Moses ka Aron. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Ekapolon yau Ŋisirael a ŋatukon a ŋuna asibito ŋajoresyo akoloŋit ŋinapei anakwap a Ijipit.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
      ]
    }
