        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitiyau anaŋga ŋina ke epuke a Eema a ŋolo iryamununoi a ŋiraŋgi a lu: A ŋolopus, a ŋolokipurat-areŋan ka a ŋolo areŋan ta ŋina edonyuno ejok a ŋiusyo a ŋulu amilimilak, todonyonokinitetei ŋitorubei ŋulu isibusitere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyau ke egolid ŋikodoce ŋulu ka anaŋga a ŋin ka kitiyau anakito ke eewoi ŋakito ŋaomwon ŋuna igurorito anaŋga ŋin, ido toburusik egolid nakito ŋun. Ani ekaku kitiyau ke eburonis ŋawoeta a ŋakito a ŋun.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
              "EXO.26.37"
            ]
          }
        }
      ]
    }
