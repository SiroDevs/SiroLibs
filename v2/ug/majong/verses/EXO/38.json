    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitiyaunae Namuroet ŋina a ŋainakineta a ŋuna epeyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Besalel kitiyau a ŋakito ke eewoi Namuroet ŋina ariyan ŋiwaetin ŋuluomwon daadaŋ, arae ŋisepyon ŋimitae ŋiarei, torae kiŋaren ka neni iteotor ŋimitae ŋiarei ka aoyau alokwap tari kidiama arae emita epei. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak iŋes ibore ŋini asibit ŋamomwar lokoonae ŋulu a Namuroet a ŋin etapakina Namuroet erae ibore ipei bon, ido toburusik eburonis Namuroet ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.2",
            "verseOrgIds": [
              "EXO.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyau ke eburonis ŋiboro daadaŋ ŋulu esitiyao a Namuroet a ŋin, ikwapei: Ŋamoti ŋaoketa, ŋabakulei ŋunawuaset, ŋakijikoi ŋunacagwar ŋuna isitiyao aŋuna ka akibeleo akiriŋ ka ŋiboro ŋulu edakitere akim. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.3",
            "verseOrgIds": [
              "EXO.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyau ke eburonis ŋasuwa ŋuna a Namuroet a ŋin, tosipok Namuroet tooma ŋasuwa ŋun, pena ŋikoonae a Namuroet kidiama neniluluŋ, abu iŋes kimyek Namuroet ikyaara iwadio anasuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.4",
            "verseOrgIds": [
              "EXO.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak iŋes eburonis ŋololuluŋ lokoonae ŋuluomwon ŋulu alokwap ŋasuwa ŋun, ikotere toeniut ŋasuwa ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.5",
            "verseOrgIds": [
              "EXO.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyau a nakito a ŋiwo ŋakito, toburusik eburonis nakito ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.6",
            "verseOrgIds": [
              "EXO.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirepak iŋes ŋakito ŋun nasuwa ŋunaluluŋ ŋuna anawae a Namuroet, ikotere edakitere Namuroet.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyau Besalel ke eburonis abesen kaapei ka awoet keŋ. Arae eburonis ŋolo a ŋaroeta a ŋaberu a ŋuna etiyaete lopuke ŋolo ke Eema a ŋolo iryamununoi iŋes etiyaunitere abesen ŋin ka awoet keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitiyaunae alapatu ŋina alokidiŋ Eema ŋolo iryamununoi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kirikak Besalel akitiya ŋun, abu kitiyak kiŋa Eema ŋolo iryamununoi alapatu. Arae aoyau a alapatu a ŋin alowae a ŋolo alo Kwap ŋimitae ŋatomoniomwon ka ŋiomwon, ido aya ŋanaŋgae ŋuna amilimilak ŋuna adonyuno ejok. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiyau ke eburonis ŋipirin ŋatomoniarei ka ŋawoeta kec ŋatomoniarei, nai ŋikodoce ŋulu enenetere ŋanaŋgae lopirin kaapei ka ŋikabobooe ŋulu emoryanakinitere ŋanaŋgae ŋun, abu iŋes kitiyau ke esilipa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowae ŋolo alo Kuju Eema, ayakasi ŋanaŋgae ŋuna arae aoyau alosepyon ŋimitae ŋatomoniomwon ka ŋiomwon, torae ŋipirin ŋatomoniarei ka ŋawoeta kec ŋatomoniarei ŋuna etiyaunitae ke eburonis; ka ŋikodoce ŋulu enenetere ŋanaŋgae lopirin kaapei ka ŋikabobooe ŋulu emoryanakinitere ŋanaŋgae, etiyaunitae ke esilipa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowae ŋolo alo To Eema ŋolo iryamununoi, ayakasi ŋanaŋgae ŋuna arae aoyau kec alosepyon ŋimitae ŋatomoniarei ka ŋiuni. Kiwuak iŋes nen ŋipirin ŋitomon ka ŋawoeta kec ŋatomon; kitiyaut ke esilipa ŋikodoce ŋulu enenetere ŋanaŋgae lopirin ka ŋikabobooe ŋulu emoryanakinitere ŋanaŋgae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae aoyau a alapatu a ŋin alowae a ŋolo alokiŋaren, a ŋolo ewasi alo Kide ŋimitae ŋatomoniarei ka ŋiuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinenek iŋes ŋanaŋgae ŋuna arae aoyau kec alosepyon ŋimitae ŋulu eapiyarito ŋikanikaarei epeiwae epuke a akibois a ŋin, abu daŋ iŋes kiwuak nen ŋipirin ŋiuni ka ŋawoeta kec ŋauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, lowae ŋoloce daŋ ke epuke a ŋolo ka alapatu a ŋin, ayakasi ŋanaŋgae ŋuna arae aoyau ŋimitae ŋulu eapiyarito ŋikanikaarei; toyakas daŋ ŋipirin ŋiuni ka nawoeta kec ŋauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonyunitoe ejok nooi a ŋiusyo a ŋulu amilimilak ŋanaŋgae daadaŋ ŋuna enenetoi nalapatu ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae eburonis etiyaunitere ŋawoeta a ŋipirin, nai ŋikodoce ŋulu enenetere ŋanaŋgae lopirin ka ŋikabobooe ŋulu emoryanakinitere ŋanaŋgae, arae esilipa etiyaunitere; toburusikinitetei esilipa nakyes a ŋipirin a ŋul, ido kilodotetei ŋipirin ŋul ke esilipa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonyonokinitoe nanaŋga ŋina ke epuke a alapatu a ŋin ŋiusyo lu ŋulu esibusitere: Ŋolopus, ŋolo kipurat-areŋan areŋan ka ŋolo areŋan, ido arae ŋina adonyuno ejok. Arae aoyau ka anaŋga a ŋin alosepyon ŋimitae ŋikanikaomwon, ido alokiŋaren ka neni iteotor arae ŋimitae ŋikan eriyan ŋanaŋgae a alapatu akisyakin alokwap tari kidiama, arae ŋimitae ŋiarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi nen ŋipirin ŋiomwon; etiyaunitae ke eburonis ŋawoeta kec, ido arae esilipa etiyatere ŋikodoce kec. Ewuakinitae esilipa nakyes a ŋipirin a ŋul, kilodotetei ke esilipa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae eburonis etiyatere ŋases daadaŋ ŋuna ke Eema a ŋolo iryamununoi ka ŋuna a a alapatu a ŋina alokiŋa Eema ŋolo iryamununoi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etyae a ŋiboro a ŋulu adukere Eema ŋolo iryamununoi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae lo etyae a ŋiboro a ŋulu adukere Eema ŋolo eryamununosi Ŋisirael aŋuna ke Ekapolon, eema ŋolo ewuakinitae ŋamoru ŋunaarei ŋunadapal, ŋuna egiritae Ŋakiciketa ŋunatomon. Arae Moses abu tolimu atemar kimarae ŋiboro ŋul, ido apotu ŋilepi ŋulu apolokinit Isamar lokoku ka Aron a esacaradoti kitiyata ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Besalel lokoku a Uri ŋolo arae lopapaait a Ur a ŋolo alokabila a Yuda kitiyau ibore daadaŋ ŋini ecikit Ekapolon Moses kitiyau. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae Oliab lokoku ka Aisamak a ŋolo alokabila a Dan ekeŋarakiniton keŋ ŋolo apiiryana anakiciere ŋiboro ka anakiram ŋitorubei ta akidony ŋilowi ŋulu amilimilak ŋulupusiyek, ŋulu kipura-areŋak ka ŋulu areŋak.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae apotis ke egolid a daadaŋ a ŋolo apotu ŋituŋa yaut ikwapei ŋainakineta ŋuna edukere Eema ŋolo iryamununoi ŋakiloi aliput, ipimitae alopite a ŋolo sek ipimere a ŋolo acamunito ŋituŋa daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋulu epimete apotis ŋina ke esilipa a ŋolo apotu ŋituŋa yaut, toryamut apotis ke esilipa erae ŋakiloi ŋalipyo ŋauni ka ŋamiae ŋoamwon ka ŋatomoniuni, ipimitae alopite a ŋolo sek ipimere, a ŋolo acamunito ŋituŋa daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekimar ŋol iŋes apotu ŋituŋa ŋulu aponi kimarunae tolemut, abu ŋinituŋanan tolemu etyae ŋolo acamakinitae, ŋolo ipimitae alopite a ŋolo sek ipimere, a ŋolo ecamunito ŋituŋa daadaŋ. Arae ŋituŋa daadaŋ imarunitae ŋalipyo ŋamiae ŋakanikapei ka ŋauni ka ŋamiae ŋakan ka ŋatomonikan, akisyakin a ŋulu a ŋikaru a ŋatomoniarei toten kidiama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Besalel kisitiya esilipa ŋakiloi ŋalipyo ŋauni ka ŋamiae ŋaomwon, adukunio ŋawoeta amiat neni awuar Eema ŋolo iryamununoi ka neni asipotor ŋanaŋgae, ŋinawoet a Eema, abu ya ŋakiloi ŋatomoniuni a ŋaomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiloi ŋatomoniuni ŋuna apotu kideun, abu iŋes kisitiya akitiyaunia ŋikodoce ŋulu a ŋipirin ka kiwuanak nakyes a ŋipirin ka kilodoo ŋipirin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae apotis ke eburonis a ŋolo apotu ŋituŋa yaut ikwapei ŋainakineta ŋakiloi ŋalipyo ŋaarei ka ŋamiae a ŋaomwon a ŋatomoniarei a ŋakan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak Besalel eburonis ŋol kwap lopuke ŋolo ke Eema a ŋolo eeryamununosi Ŋisirael, kitiyaunia ece Namuroet, kilodoo ece Namuroet ka kitiyaunia ece ŋiboro ŋulu a Namuroet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 38:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak tari nalapatu ŋina alokiŋa Eema ŋolo iryamununoi ka kitiyaunia ŋases ke Eema a ŋol daadaŋ ta ŋases daadaŋ ŋuna aya nawaetin a alapatu a ŋina alokiŋa Eema ŋol.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.31",
            "verseOrgIds": [
              "EXO.38.31"
            ]
          }
        }
      ]
    }
