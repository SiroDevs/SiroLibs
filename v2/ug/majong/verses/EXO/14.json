              "type": "text"
            }
          ]
        },
        {
          "text": "Nai apotu Ŋisirael todoka Anam eonit neni alosyoto ikes ka erounito ikes ŋakipi esibit ŋarwatatain aloteten ka alokedyeny kec.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
