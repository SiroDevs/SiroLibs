{
  "id": "EPH.3",
  "number": "3",
  "bookId": "EPH",
  "reference": "Ŋiep. 3",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EPH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etic a Paulo alokidiŋ ŋituŋa ŋulu nyerae Ŋiyudayan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋakiro a ŋun, elipit ayoŋ Akuj, ayoŋ Paulo ŋolo arae emabus aŋuna ejaanakinia Yesu Kristo aŋuna kus a ŋulu nyirae Ŋiyudayan. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kire idaut iyes akiirar ebe adau Akuj ainakin ayoŋ ajokis keŋ akitiya etic keŋ lo aneni kus. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.2",
            "verseOrgIds": [
              "EPH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae nakitoodikinet abunio Akuj ekesileerek ayoŋ ŋakiro keŋ ŋuna imunono, ŋuna ŋoon sek abu ayoŋ egir euruwuaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani isyomete iyes ŋuna adau ayoŋ akigir, ipedorete ayenun epite ŋolo ayenunia ayoŋ ŋakiro ŋun, ŋuna imunono, ŋuna erae ŋuna a Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koloŋ sek, pa alimokinitae ŋituŋa ŋakiro ŋuna imunono ŋun, nai tokona adau Akuj akitoodiun ikes alotooma Etau keŋ neni a ŋikiyakia keŋ a ŋulu ka Akuj ka neni a ŋikadwarak. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.5",
            "verseOrgIds": [
              "EPH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiro ŋuna imunono ikes nu ebe, aŋuna a Ŋakiro a ŋuna Ajokak, amora ŋituŋa ŋulu nyerae Ŋiyudayan ka Ŋiyudayan ŋarereŋisyo ŋuna ka Akuj; eraakasi ikes ŋipei ka amora ŋakiikineta ŋuna abu Akuj kiik alotooma Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi eketuruwor ayoŋ eketiyan ŋolo a Ŋakiro a ŋuna Ajokak alotooma ainakinet ŋina abu Akuj okoinak ayoŋ anajokis keŋ alotooma apedor keŋ ŋina itiyaa iŋes etic. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.7",
            "verseOrgIds": [
              "EPH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae neni kaŋ a ŋolo arae ecaryoit alotuŋa a daadaŋ a ŋulu ka Akuj aponi okoinakin ajokis ŋina limonokinet Ŋakiro ŋuna Ajokak neni a ŋulu nyerae Ŋiyudayan--ŋakiro ŋuna ka ajakaanut a Kristo a ŋina nyeŋicun etyae keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.8",
            "verseOrgIds": [
              "EPH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi daŋ okinakin akisileerekin lotuŋa epite ŋolo itiyakinia Akuj ŋuna imunono ŋuna elosikinit iŋes. Abu Akuj, ŋina erae akasuban a ŋiboro daadaŋ kiwua ŋuna imunono ŋun ŋikaru daadaŋ ŋulu alunyarosi; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.9",
            "verseOrgIds": [
              "EPH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikotere nai alotooma Ŋikristo toyenut ŋikepukak ka ŋapedorosyo ŋuna anakuj aosou ŋina ka Akuj alotooma ŋiboro daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Akuj kitiya ŋun ikwapei ayakar alosikinet keŋ ŋina a ŋikaru ka ŋikaru, ŋina ayakar iŋes alotooma Yesu Kristo Ekapolon yok. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.11",
            "verseOrgIds": [
              "EPH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotooma akimorikina ka Kristo ka aŋuna ka anupit yok neni keŋ, ikipedori iwon aponare neni ka Akuj emam akuryanu ka ikiyakar akikinyomit. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.12",
            "verseOrgIds": [
              "EPH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, ekemaimai nai ayoŋ iyes, nyijamakis aŋuna a ŋican a ŋulu aryamu ayoŋ aŋuna kus, a ŋulu erae aŋuna ka akitopolooro kus moi anakuj.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amina ŋina a Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋakiro a ŋun, aryediki ayoŋ alokiŋaren Akuj Papa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.14",
            "verseOrgIds": [
              "EPH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋolo erae neni keŋ eponitotor ŋikalya daadaŋ ŋulu anakuj ka ŋulu alokwap. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.15",
            "verseOrgIds": [
              "EPH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elipenene ayoŋ neni ka Akuj ikiinak iyes anabaru a ŋina a ŋarereŋisyo keŋ apedor ŋina kicaset alotai kus alotooma Etau keŋ ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.16",
            "verseOrgIds": [
              "EPH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka elipenene ayoŋ Akuj kituruwo ŋitai kus neni iboiyo Kristo aŋuna ka anupit kus. Elipi ayoŋ atemar ibore daadaŋ ŋini itiyaete iyes, torae ŋini ebunit alotooma amina, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.17",
            "verseOrgIds": [
              "EPH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikotere nai iyes kaapei ka ŋituŋa ŋulu ka Akuj daadaŋ iyakaunotor apedor ŋinayenunet epite ŋolo epoloo nooi amina ŋina a Kristo ŋina nyipimun. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.18",
            "verseOrgIds": [
              "EPH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, elipi ayoŋ atemar toyenut iyes amina keŋ--tari pa kepedor ayenun iŋes nooi--ikotere nai kikwaanikinos iyes ka Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epedori Akuj akitiya alotooma yok ŋuna alalak nooi akilo daadaŋ ŋuna ikipedori iwon akilip iŋes kori ŋuna ikitami iwon atemar ikitiyakini. Itiyae iŋes ŋun anapedor a ŋina itiyae alotooma yok. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyai neni keŋ apolou aneni a Ŋikristo anakimorikina ka Yesu Kristo ananyameta a daadaŋ, ŋikaru ka ŋikaru! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
  ],
