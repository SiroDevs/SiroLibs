        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aberu ŋina iitit, eenikinito Ŋikisila ŋulu ka Akuj neni ke ekile keŋ, eriŋa ekile keŋ eyari, nai ani ketwana ekile keŋ, ecamakinio iŋes akiitakin ka ekile daadaŋ ŋolo ecamit iŋes, nai itemokino ekile ŋol torae Ekristoit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakitam kaŋ ebuni aberu ŋin alakari nooi, erae kidoŋ iŋes nyiitara. Erae ŋun atamakinit ayoŋ, nai atami ayoŋ atemar ayakar ayoŋ daŋ Etau ŋolo ka Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    }
