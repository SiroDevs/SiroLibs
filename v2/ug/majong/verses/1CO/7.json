              "1CO.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimunit ayoŋ ŋun akiŋarakin iyes. Nyewuakinit ayoŋ neni kus egogos ŋolo apolon. Nai acamit ayoŋ iyes kiboiyoto alopite a ŋolo iyookino ka kitiyanakis Ekapolon emam akitumonor.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keyai ekile ŋolo etami atemar nyejokak ŋipitesyo keŋ alotooma aŋayaŋayat akiit apese ŋina iikina ka iŋes ka ani kegogoŋ ekibure keŋ, itemokino ikes kiitas ikwa ecamitor iŋes. Nyesecit iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani ketubu kire ekile atemar nyeitari, nyereikinitae iŋes, nabo ani kipukat iŋes ekibure keŋ ka toris sek iŋes atyaku alotau keŋ ŋuna kitiya, etiya iŋes ejok erae pa kiit apese ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, ekile ŋolo iitari apese ŋina iikina akiito ka iŋes, itiyae ŋuna ajokak; nai ekile ŋolo nyiitari, itiyae ŋuna ajokak nooi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
