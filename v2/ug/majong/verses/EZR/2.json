          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋiletok a Delaia ka Tobia ta Nekoda daadaŋ ŋamiae ŋakanikapei ka ŋatomonikan ka ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.60",
