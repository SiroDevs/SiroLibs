          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋiletok a Sepatia ŋamiae ŋauni ka ŋatomonikanikaarei ka ŋaarei, ",
          "type": "text",
