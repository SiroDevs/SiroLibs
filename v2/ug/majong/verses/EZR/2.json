          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋiletok a Ara ŋamiae ŋakanikaarei ka ŋatomonikanikaarei ka ŋakan, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
