            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
