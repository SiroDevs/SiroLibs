          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Omiri togyel emukura ŋolo enyaritae Samaria aneni a Semer a ŋitalentae a ŋiarei a ŋulu a esilipa; toduk iŋes lomukura ŋol ejok, tolimok ekiro ke etaun Samaria, ekiro a Semer a elope emukura.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
