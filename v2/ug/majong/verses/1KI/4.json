          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inak Akuj Solomon aosou ŋina alalan nooi, ayenut epite ŋolokisibaket ŋakiro ka etau ŋolo ijaununui ŋakiro daadaŋ tari daŋ kelalak ikwa asinyon ŋina eyai nawae a anam. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloit nooi aosou a Solomon ŋina a ŋikilyok a daadaŋ a ŋulu aya kide akwap ka ŋina a daadaŋ a ŋulu aya Ijipit. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aos iŋes akilo ŋikilyok daadaŋ, aos akilo Esan ŋolo arae Esirait, Eman, Kalikol, Darida ka ŋidwe a Maol ŋulusapa. Toru ekiro a Solomon anakwapin a daadaŋ a ŋuna edunyatar iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Solomon kirwor ŋakitadapeta ŋalipyo ŋauni ka totamu ŋieosyo aliput ka ŋikan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu iŋes tolimununu ŋirorwa a ŋikito akisyakin aneni a ŋolo enyaritae Cedar a ŋolo ayai Lebanon tari neni a ŋolo anyaritae Isop a ŋolo elemununio anarwatatain. Alimununui Solomon ŋirorwa a ŋityaŋ, ŋulu a ŋikieny, ŋulu a ŋiboorei a ŋulu elyato ka ŋulu a ŋikolya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponeneete ŋituŋa ŋice anakwapin a daadaŋ akiirar ŋuna ka aosou a Solomon, arae ŋul ŋulu eyakuunito ŋirwosi kec ŋulu keris kiirasi ŋakiro a aosou a Solomon anakwapin a daadaŋ anakwap.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
        }
      ]
    }
