              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok nai erwosit tema, “Inakisi aberu ŋina ageuni akirworikin isapat eyari; nyiar iŋes, erae ŋin toto keŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
            "verseOrgIds": [
