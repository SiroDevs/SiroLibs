          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina asepwae daadaŋ erae ŋina ke Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina nu toruworos etal ananyameta kus a daadaŋ ka anakiboisyo kus a daadaŋ: Nyemaikina iyes tonyama asepwae adio, kori tonyama ŋaokot ŋadi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.17",
            "verseOrgIds": [
              "LEV.3.17"
            ]
          }
        }
      ]
