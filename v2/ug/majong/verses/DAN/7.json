          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiro daadaŋ ikes ŋun ŋuna aponi okolimokin ayoŋ apolou kec. Ani eruwor ayoŋ Daniel, apotu ŋatameta kaŋ eketubulo ayoŋ nooi, ido abu ereet kaŋ kilocokin, nai abu ayoŋ eric ŋakiro daadaŋ alotau kaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
          }
        }
      ]
    }
  ],
