          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae lu ŋirorwa a ŋirwosi a ŋidwe ke Esau a ŋatekerin kec ka a ŋitela kec: Ŋitiminae, Ŋialipae, Ŋiyeses, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 36:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiolibamae, Ŋielae, Ŋipinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 36:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋikenasi, Ŋitemani, Ŋimibisari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋimagidoeli ka Ŋiirami. Arae ŋun ŋatekerin ke Edom (iŋes Esau papaa ŋolo a esyakinan a ŋituŋa ke Edom). Anyaritae ŋirorwa kec a ŋakiboisyo a akwap a ŋin eboiyoto ikes.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
            "verseOrgIds": [
              "GEN.36.43"
            ]
          }
        }
      ]
