            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolemu Yakob ŋibelae alokito a lu: Popilari, Alimond ka Pulane, topoiyana ŋapoco aiwace totakanu akitoe neni akwaŋan, kidoŋo ŋibelae eesyaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiperik ŋibelae ŋul kiŋaren ŋibaren natakerin ŋuna aya neni amasyata ŋibaren. Ewuakini iŋes ŋibelae ŋul nen, anerae asuposi ŋibaren epote akimat. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togeut ŋibaren asupo alokaku ŋibelae ŋulu eriwokina natakerin; touryata ŋibaren ŋikaalei ŋulububuwo, ŋulukoliyek ka ŋulumeriyek. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kipaka Yakob ŋikaalei anakinei, ido kigaŋ ŋakinei lowae ŋolo aya ŋibaren a Laban ŋulububuwo ka ŋulukiryonok cuc; kipaka ŋakinei keŋ nawae, nyimorik ka ŋuna a Laban. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki daadaŋ ŋina isyakiniata ŋibaren ŋulu agogoŋ ŋawat asupo, eriwonokini Yakob ŋibelae ŋul natakerin kiŋaren ŋakinei, ikotere esuposi ŋakinei alodiyete ŋibelae. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani esuposi ŋakinei ŋuna nyegogoŋ ŋawat, nyiriwok Yakob ŋibelae kiŋaren kec; aŋun, apotu ŋakinei ŋuna pa agogoŋ toruwor ŋuna a Laban, ido ŋuna agogoŋok apotu toruwor ŋuna a Yakob. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋun kitabara Yakob nooi, tolalata ŋakinei keŋ nooi ka ŋikaala ta ŋisigirya, ŋaketiyak ka ŋiketiyak.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
      ]
