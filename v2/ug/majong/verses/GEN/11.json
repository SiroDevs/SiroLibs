          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torukosi Tera ka lokoku a Aburaam ta Lot lopapait keŋ lokoku ka Aran kaapei ka Sarai aberu ka Aburam, toloto alo Ur anakwap a ŋina a Ŋibabiloniyae tari nakwap ŋina a Kanaan. Nai ani edolunete ikes Aran, toloma nen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edolete ŋikaru a Tera ŋamiae ŋaarei ka ŋikan, totwan iŋes alo Aran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
