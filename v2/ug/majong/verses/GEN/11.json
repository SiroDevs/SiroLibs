          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiboi Aripakasad ŋikaru ŋamiae ŋaomwon ka ŋiuni kedau auruun Sela. Touru ŋisapa ŋice ka ŋapesur.",
          "type": "text",
          "attrs": {
