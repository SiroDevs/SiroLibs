            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema nabo Akuj, “Toyakaun nakwap ŋisubuna ŋulu eyarete ŋulu a ŋolokabila: Ŋibaren, ŋityaŋ ŋulu elyato ka ŋityaŋ ŋulu ka ariet ŋulu a ŋolokabila.” Apotu ŋun kitiyakin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosub Akuj ŋityaŋ ŋulu anakwap a ŋikabilae kec: Ŋibaren a ŋikabilae kec, ŋityaŋ adaŋ ŋulu elyato alokwap a ŋikabilae kec. Toanyu Akuj atemar ejokak ŋul.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
      ]
    },
