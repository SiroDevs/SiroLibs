          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋilepi ikes lu: Yesua lokoku ka Asania, Binui lokoku Anedad, Kadimel; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
