            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikicamu daŋ isua atacenen a ŋolokaru atutubet apei alotooma ŋiuni a ecekel aŋuna ke etic a ŋolo ka Akai ka Akuj ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "aŋuna a ŋamugati a ŋuna iwuanakinio lomesa a ŋilaino, aŋuna ka ainakinet a ŋina a ŋikinyom a ŋina sek ainanakinio, aŋuna a ainakinet a ŋina epeyo a ŋina sek emaikina einanakinio, aŋuna a ŋainakineta aŋuna a Sabato, aŋuna ke elap a ŋolokitete, aŋuna a ŋasuban aŋuna sek ikicikitae akinumunum, aŋuna a ŋainakineta aŋuna asegak ka aŋuna a ŋainakineta a ŋuna ka asecit, ikotere emookunere Ŋisirael ta aŋuna ke etic a daadaŋ a ŋolo ka Akai ka Akuj kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaun daŋ isua ŋisacaradotin, ŋilepi ka ŋituŋa ŋuluce akilamilam aŋuna a ŋainakineta a ŋakito, ikotere eyeununio ateker ŋina emaikina yau ŋakito alotooma apaki ŋina etubokinitae ikes a ŋolokaru; emaikina yaunae ŋakito ŋun Kai ka Akuj aŋuna ka akinokia akim alokidiama Namuroet a Ekapolon kosi, lopite ŋolo igiritere lokisila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikicamu daŋ isua ayaunun a ŋolokaru Kai ka Akuj kosi ŋaraito ŋuna eŋarenok alomanikorin kosi ka ŋaraito a ŋikito a daadaŋ ŋuna eŋarenok, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikicamu daŋ isua ayaunun ŋidwe kosi ŋulusapa ŋulu kiyae ka ŋikiyae a ŋaatuk kosi lopite ŋolo igiritere lokisila ka ŋikiyae a ŋamesekin kosi Kai ka Akuj kosi ka neni a ŋisacaradotin a ŋulu itiyaete nen. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaununuyo daŋ isua amurat kosi ŋina esyaunan ka ŋainakineta kosi, ŋaraito ŋuna a ŋikito a daadaŋ ŋuna esyaunak a epiini ka akimyet. Eyaununio isua ŋul neni a ŋisacaradotin ka nagulei ŋuna iŋadao ŋiboro alo Kai ka Akuj kosi, acamun daŋ isua ayaunun neni a ŋilepi atutubet apei alotooma ŋitomon a ŋiboro a ŋulu itaunio isua, anerae ŋilepi ikes iriraete atutubet apei alotooma ŋitomon a ŋiboro alotaunio kosi a ŋulu cicik a daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina ŋisacaradotin, ikes ŋiletok ka Aron toyakas kaapei ka ŋilepi apaki ŋina ijauniata ŋilepi ŋatutubeta ŋapeipei alotooma ŋitomotomoe a ŋiboro a ŋituŋa, ido ŋilepi ikes eyaunete atutubet apei alotooma ŋitomon a ŋiboro a ŋul Kai ka Akuj kosi, nagulei ŋuna ka akai a ŋina iŋadao ŋiboro. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina Ŋisirael kaapei ka ŋilepi yaanasi ŋainakineta kec ŋuna a ŋikinyom, ŋuna a epiini, a akimyet nagulei ŋuna iŋadao ŋiboro, neni eya ŋiboro ŋulu isitiyao anakibois a ŋina asegan ka neni eya ŋisacaradotin ŋulu itiyanakinete Ekapolon ka neni eya ŋiketeok ŋipukei ta ŋikaeok. Nyikijamakini isua Akai ka Akuj kosi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    }
