          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayai epei a ŋidwe a ŋulusapa a ŋulu a Yeoiada alokoku ka Eliasib a esacaradoti a ŋolo Apolon nooi, ŋolo arae lokamuran a Sanibalat a ŋolo alo Oron, abu ayoŋ erita iŋes aneni kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totamunite ikes, okoe Akuj kaŋ, anerae apotu ikes tomunaasi asacaradotonu ka acamunet ŋina ibunio iyoŋ tocamunotor ka ŋisacaradotin ka ŋilepi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
      ]
