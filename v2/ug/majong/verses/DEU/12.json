              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani emunyari Ekapolon Akuj kus alokiŋaren kus ŋituŋa a ŋakwapin a ŋuna eapi iyes alomar ka akituruwor ŋuna kus, ani kidaut iyes akiritar ikes ka kiboikinosi nakwapin kec, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kedaun amunyar ŋituŋa ŋul, tocoito nyikimodiyar, iyes kitiyata ŋuna etiyaete ŋituŋa ŋul, nyiŋitanarosi ŋuna a ŋakujo kec ibasi, “alipite mono kilipyata ŋituŋa ŋul neni a ŋakujo kec? Acamit ayoŋ daŋ akitiya lopite ŋolo etiyaata ikes.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyemaikina iyes kitiyata ŋun neni ke Ekapolon a Akuj kus, anerae apotu ikes kitiyata neni a ŋakujo kec asiilyo daadaŋ ŋina eŋerit Ekapolon. Ewuanakinete ikes tari ŋidwe kec ŋulupesur ka ŋulusapa nakim aŋuna a ŋakujo kec. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iyes kiwuapa ejok ŋakiro daadaŋ ŋuna ekecik ayoŋ iyes akitiya, nyiyatakis akirot adio nakiro ŋun, kori nyilemasi adio.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
            "verseOrgIds": [
              "DEU.12.32"
            ]
          }
        }
      ]
