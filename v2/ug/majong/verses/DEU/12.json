          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tocoikisi akiwuap ŋakiro ŋun daadaŋ ŋuna adau ayoŋ alimokin iyes, ikotere emamukaun ŋace ŋikaru ka ŋikaru aneni kus ka aneni a ŋidwe kus a ŋulu epote ekaku kus, anerae ipotu iyes kitiyata ŋuna ajokak ŋuna iyookino alokiŋaren Ekapolon Akuj kus.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyilipa neni a ŋakujo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
