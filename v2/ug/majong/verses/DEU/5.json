          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kori nyiŋobel ŋinituŋanan aberu a ekidunyet keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kori nyiburak akai a ikidunyet keŋ, kori nyiŋobel akai a ikidunyet keŋ, kori emanikor keŋ, kori epito keŋ, kori apito keŋ, kori emoŋ keŋ, kori esigirya keŋ, kori ibore ca daadaŋ ŋini erae ŋini a ikidunyet keŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moses ekemorikinan Akuj ka ŋituŋa anacamunet a ŋina ka Akuj",
          "type": "text"
        }
      ]
    },
