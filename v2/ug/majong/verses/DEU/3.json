              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolot kidiama emoru Pisiga, kiŋoliya aina lowaetin kon daadaŋ, To, Kuju, Kwap ka Kide. Kiŋolik ŋiwaetin ŋul ejok, anerae nyitubor iyoŋ ekekwaye Yorodan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
