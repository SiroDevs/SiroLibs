              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyecamakinitae ekile akituruwor aberu a papa keŋ ŋina keŋ, erae ŋun ajamuwar papa keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.30",
