              "DEU.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keryamun ekile ka apese ŋina nyiryamakina ke ekile, ido nyiikinitae iŋes neni a ekile a edio, tosodi ekile ŋol kikamu apese ŋin kiryamakin ka iŋes ka toryamunae ikes anenipei itiyaete ŋun, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "emaikina ekile ŋol tolemu ŋisilipae ŋatomonikan, inak neni a papa keŋ ka apese, tosodi eruwor apese ŋin aberu keŋ jik. Aŋuna enyasunia ekile ŋol apese ŋin, nyecamakinitae iŋes tolak iŋes ŋirwa daadaŋ ŋulu ka akiyar keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
      ]
    },
