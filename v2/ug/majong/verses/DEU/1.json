          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kidaut iyes akiboi alo Kades ŋirwa daadaŋ ŋulu ipotu iyes kiboiyoto a nen,",
          "type": "text",
