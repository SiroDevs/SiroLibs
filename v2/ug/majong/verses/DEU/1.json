{
  "id": "DEU.1",
  "number": "1",
  "bookId": "DEU",
  "reference": "Ŋikis. 1",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "DEU 1"
      },
