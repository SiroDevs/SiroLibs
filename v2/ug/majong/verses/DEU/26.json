{
  "id": "DEU.26",
  "number": "26",
  "bookId": "DEU",
  "reference": "Ŋikis. 26",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
