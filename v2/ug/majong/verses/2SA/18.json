        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobul erwosit nooi, tolot todoka kidiama nalapatu ŋina alo kidiama epuke, kigwor a nen; ani elosi iŋes, abu tema, “Okoe lokoku kaŋ Abusalom, lokoku kaŋ, lokoku kaŋ Abusalom. Nyo pa araakar ayoŋ atwani akilo iyoŋ; okoe Abusalom lokoku kaŋ, lokoku kaŋ!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
