              "2SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiworou Aimas neni ke erwosit tema, “Ejokak ŋakiro daadaŋ.” Toryedik iŋes alokiŋaren erwosit kijuuru todol ereet kwap, ido tema, “Kipuroe Ekapolon Akuj kon, ŋina ikiinak iyoŋ akiloun ŋituŋa ŋulu ikimanito iyoŋ erwosit ekapolon kaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit erwosit iŋes tema, “Mam ba ŋace aneni a esorokit ka Abusalom?” Toboŋok Aimas tema, “Ani apaki ŋina ekeyakuunia Yoab ayoŋ eketiyan kon, abu ayoŋ eŋolik ŋituŋa iguryakina, nai nyeanyuna ayoŋ ŋakiro ŋuna eguryakinito ikes.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema erwosit neni keŋ, “Tori nawae, towo a ne.” Aŋun abu Aimas tori, torubak ewoi a nen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
