          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira ŋolo alo Isir; Gareb ŋolo alo Isir; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.38",
            "verseOrgIds": [
              "2SA.23.38"
            ]
          }
        },
        {
          "name": "verse",
