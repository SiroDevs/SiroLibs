          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selek ŋolo alo Amon; Naarai ŋolo alo Beeros, ŋolo aryoŋit ŋiboro a Yoab alokoku a Seruia ŋulu ke ejie; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
          }
        },
        {
          "name": "verse",
