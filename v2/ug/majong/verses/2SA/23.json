              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliaba ŋolo alo Saalibon; ŋidwe a Yasen ŋulusapa; Yonasan ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
            ]
          }
        },
        {
