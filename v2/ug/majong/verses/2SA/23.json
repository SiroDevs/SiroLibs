          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igal lokoku a Nasan a ŋolo alo Soba; Bani ŋolo alo Gad; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.36",
            "verseOrgIds": [
              "2SA.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
