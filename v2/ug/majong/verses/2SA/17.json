              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Ŋisirael ŋulu arukito ka Abusalom kiboiyosi nakwap ŋina a Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
