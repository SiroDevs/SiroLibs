{
  "id": "2SA.8",
  "number": "8",
  "bookId": "2SA",
  "reference": "2 Sam. 8",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2SA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋijiesyo ŋulu eloununuya Daudi ŋimoe keŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaku ka apaki a ŋina auruwuana, kitijik Daudi Ŋipilistin kilou ikes, todemu Ŋipilistin akwap ŋina anyaritae Meseg-Ama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Daudi kilou tari Ŋimoabi, kiperik ikes kwap, kimaru ŋilaino ŋiarei ŋulu a ŋulu emaikina toarae ka elain epei ŋolo a ŋulu emaikina kimyekinae toyara. Aŋun, apotu Ŋimoabi toruwor ŋiketiyak a Daudi, kisyakis akitac ocur neni a Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu daŋ Daudi toar erwosit ŋolo anyaritae Adadeser, lokoku a Reob a ŋolo a Soba. Etiyae iŋes ŋun apaki ŋina alosyo Adadeser akikamar akwap ŋina ayai diyete aŋolol ŋina enyaritae Eupurate. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Daudi kikama aneni ka Adadeser ŋikilyok aliput ka ŋamiae ŋakanikaarei ŋulu adokito ŋaŋolei ka ŋulu alosete a ŋakejen ŋalipyo ŋatomoniarei. Kiŋwal Daudi ŋaŋolei kec ŋuna erito ŋagaari, toŋedeŋede ŋamori a ŋakejen kec; kimyek ŋuna iriyarete ŋagaari amiat bon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani epote Ŋiarameani, ŋituŋa ŋulu alo Damasko akiŋarakin erwosit Adadeser ŋolo alo Soba, toar Daudi Ŋiarameani ŋalipyo ŋatomoniarei ka ŋiarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiboik nai Daudi ŋasigarya keŋ Damasko, nakwap a Ŋiarameani; ido apotu Ŋiarameani toruworos ŋulu epukat Daudi, kisyakis akitac ocur neni a Daudi. Abu Ekapolon inak Daudi akilounun ŋimoe keŋ aneni daadaŋ abunio iŋes kitijikinio ikes. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toŋatu Daudi ŋaupala ŋuna ke egolid ŋuna atiŋito ŋasigarya ka Adadeser. Yau Daudi ŋaupala ŋun Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Daudi toŋatu eburonis ŋolo alalan alo Beta ka alo Berosai, alotaunio ka Adadeser.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirari Toi erwosit ŋolo ka Amas atemar elou Daudi asigar ka Adadeser daadaŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyakiya iŋes lokoku keŋ ŋolo anyaritae Yoram neni a Daudi a erwosit, akimala ka akitalakar Daudi aŋuna elounia Adadeser. Kenipit sek Adadeser Toi ka aŋorot kitiji jik. Ya Yoram neni a Daudi ŋiboro ŋulu etiyaunitae a esilipa, a egolid ka a eburonis. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Daudi inak ŋiboro ŋul daŋ neni ke Ekapolon, tocunak ka esilipa ta egolid ŋolo erirauni iŋes anakwapin aŋuna abu iŋes kilou; ŋolo aris sek iŋes keinaki Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirirauni sek Daudi esilipa ŋol ka egolid ŋol anakwapin a nu: Alo Edom, alo Moab, aneni a Ŋiamoni, aneni a Ŋipilistin, aneni a Ŋiamaleki ka aloboro a ŋulu aŋatuni iŋes aneni ka Adadeser alokoku a Reob a ŋolo arae erwosit a Soba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torwoniar Daudi nooi kedau aboŋun alojie a ŋolo aarya Ŋiedomi ŋalipyo ŋatomon ka ŋikanikauni anakadipaalat a ŋina ka acumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiboik nai Daudi ŋasigarya keŋ Edom daadaŋ. Toruwor Ŋiedomi daadaŋ ŋiketiyak a Daudi. Inak Ekapolon Daudi akilounun ŋimoe keŋ aneni daadaŋ abunio iŋes kitijikinio ikes.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikapolok ŋulu epukatotor Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, abu Daudi kipuka Isirael daadaŋ, abu iŋes kitiya ŋuna ajoikinito ŋituŋa ka ŋuna eyookino alotuŋa keŋ a daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoab lokoku a Seruia iŋes apolokinit ŋasigarya daadaŋ, ido Yeosapat lokoku ka Ailud iŋes arae ekeŋadan ŋakiro ŋuna igirir. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadok lokoku ka Aitub ka Aimelek lokoku ka Abiasar ikes arae ŋisacaradotin; torae Seraia ekaran. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
            "verseOrgIds": [
              "2SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaia lokoku a Yekoiyada iŋes apolokinit Ŋikeresi ka Ŋipelesi; ido arae ŋidwe a Daudi ŋulusapa ŋisacaradotin.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.18",
            "verseOrgIds": [
              "2SA.8.18"
            ]
          }
        }
      ]
    }
  ],
