  "bookId": "2SA",
  "reference": "2 Sam. 1",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2SA 1"
      },
      "items": [
        {
          "text": "1",
