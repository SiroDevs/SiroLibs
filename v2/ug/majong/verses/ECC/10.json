            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituruwonoryo ŋibaŋaanotin ŋulu alalak ŋikapolok, ido kimyekinitetei ŋikaosok erae ŋiketiyak a ŋibaŋaanotin ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋolik ayoŋ ŋipi edokito ŋaŋolei, ido tolosete ŋikapolok a ŋakejen esibit ŋipi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
