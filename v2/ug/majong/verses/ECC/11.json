          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lopite ŋolopei nyiyeniata iyes epite ŋolo eyeunere ikoku anakook a toto keŋ, nyiyenete daŋ iyes ŋiticisyo ŋulu ka Akuj a ŋina erae ekasuban a ŋinibore.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
