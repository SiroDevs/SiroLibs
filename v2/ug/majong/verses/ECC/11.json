          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iyes ŋisorok tolelyana eriŋa irae ŋisorok. Kitiyata daadaŋ ŋuna icamito iyes akitiya ka kiwuapa ŋuna ecamito ŋitai kus. Nai totamunito atemar ikitubokini iyes Akuj anakiro a daadaŋ a ŋuna itiyaete iyes.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
