          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kita ŋikinyom kon taparacu, ido nyijamak akitare ŋikinyom kon tari ŋisaae ŋulu ka ataboŋo, anerae nyiyeni iyoŋ atemar a lu elomunete ejok tokoko ejok, kerae ŋulu ka taparacu, kori ŋulu ka ataboŋo, kori elomunete daadaŋ ejok tokoko ejok ikwaan.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asoroko ka Amojoŋu",
          "type": "text"
        }
      ]
    },
    {
