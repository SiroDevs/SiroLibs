          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina ŋituŋa elakara ŋikaru daadaŋ ŋulu iboiyoto ikes anakwap a na, nai emaikina ikes etamunito atemar elalak nooi ŋikaru ŋulu eyakaun ituŋanan ekaku ka akiyar a na, ŋuna daadaŋ epote erae ŋakoŋinae.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
