              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baraagendayoga kuhiiga baina obuta n'emyambi, habwokuba ensi yoona eriba emazirweho amakerre n'amahwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
