              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oha ogu arukuruga Edomu, arukuruga Bozira, anyakujwaire ebyokujwara ebirukutukura, ogu anyakujwaire ebyokujwara, ebirukumuzookesa nkooku ali w'ekitiinisa, arukurubata n'ekitiinisa n'amaani? Ninyowe MUKAMA, owobusobozi obw'okujuna, ninyowe arukwija kurangirra obusinguzi bwange.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
