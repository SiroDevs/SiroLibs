          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 63:3"
