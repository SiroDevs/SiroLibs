              "ISA.66.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.5"
              },
              "items": [
                {
                  "text": "Kus 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubuga rwange orurukwera, nirusisana omukazi, anyakuzara bwango omwana atagenzire omwizarro Omukazi obu akaba atakahikire omu izarro, yazaara, atakarumirwe, akaba azaire ira omwana w'obwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oha araahuliireho ekintu nk'eki? N'oha araaboineho ebintu nk'ebi? Ensi eraazarwa omu kiro kimu? Ihanga lirizaarwa omukacu kake kati? Habwokuba Siyoni obu yatandikire kurumwa eti, ahonaaho yazaara abaana baayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: nsobora kuhikya omuntu ha kuzaara kandi nkalema kuzaaza? Ruhanga naagamba ati: Nyowe anyakuzaaza, kandi ninyowe ndaigara enda? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukyanganuke kandi musemererwe hamu na Yerusaalemu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba MUKAMA naagamba ati: Ndimuha obusinge bwingi nk'amaizi g'ekyambu, n'obuguuda bw'amahanga oburukusisana akasaaru akarukugera; mulisisana nk'omwana arukulerwa nyina amuhimbire kandi naamwoleka engonzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'omuntu arukuhumuzibwa nyina nanyowe nukwo ndibahuumuza; mulihuumulizibwa Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu mulirora eki kyabaho, mulisemererwa; kiribafoora b'amaani kandi boomeezi. Obu nubwo mulimanya nyowe MUKAMA nkooku nkoonyera abo abanyakumpurra kandi abanyanzigwa bange nkooku mbooleka ekiniga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, MUKAMA aliizira omumurro, n'ebigaali biriija nk'akairiringwa, afubire abo aba yabiihiriirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona ab'omunsi, abalizooraho omusango, alibafubiza omurro n'ekitara, kandi abantu abaaliita baliba baingi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: Abo abarukweyeza kandi bakeesemeza kutaaha omu misiri nibakuraatira ogu anyakuli hagati, abarukulya enyama y'empunu, n'ebintu ebibi n'embeba, balihwerekererra hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba mmanyire ebikorwa byabo n'ebiteekerezo byabo, kandi ninyija kusorooza amahanga n'abantu aba buli ngambo baliija barole ekitiinisa kyange. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibataho akarorwaho ndibaihamu abaasigaireho, mbatume omu mahanga hali Tarasiisi, Puti Rudi, abarasi b'obuta, hali Tubbali na Yovani, n'omu bizinga ebinyakuli hara muno ebitakahurrahoga ha kurangaanwa kwange kandi abatakabonahoga kitiinisa kyange; abo nubo balimanyisa amahanga ekitiinisa kyange. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nubo balireeta bagenzi banyu boona babaihe omu mahanga goona, babaleetere hambaraasi, ha bigaali ba batwarre, ha nyumbu, hangamiya, babahikye harusozi rwange orurukwera Yerusaalemu, nk'Abaisirairi oku baleeta ekihongwa kyabo eky'ebyokulya omunju ya Ruhanga, bakitaire omukikwato eky'ecumi; ebi, nibyo MUKAMA arukugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: Kandi abamu omuli bo, nabo ndibafoora banyakatagara kandi Baleevi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
