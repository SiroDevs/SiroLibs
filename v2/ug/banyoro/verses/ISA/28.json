                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.6"
              },
              "items": [
                {
                  "text": "1Pet 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikyo MUKAMA Ruhanga arukugambira ati: “Nimbyara ibaale ery'omusingi omu Siyoni, ibaale ery'omuhendo ery'obugumizo, ery'omusingi ogutarukutengeeta; erinyakuhandiikirweho ebigambo binu; ‘Okwikiriza okugumire kuba n'okugumiisiriza.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwinganiza nubwo buliba rukoba orw'okulengesa omusingi, kandi obwesigwa nubwo buliba rulengo rw'ebisiika.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako, endagaano yanyu mwaragaine na Warufu aho nuho erigarukira, enyikirraniza yanyu nanyabuyonga aho nuho erihwera. Omuhito oguhinguraine obu guliija, na inywe gulibahikaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.18",
            "verseOrgIds": [
              "ISA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu guliba nigukyarabaho guti, na inywe gulibahikaho, habwokuba guraijaga buli kiro, nyamusana n'ekiro; kandi kiraabaga kintu ky'okutiinisa kukenga ebigambo ebi gulireeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.19",
            "verseOrgIds": [
              "ISA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ekitabu kigufu muno, omuntu tasobora kukihikaho, kandi ekyokwesweka kitoito muno, omuntu tarukukyesweka kikamuhika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.20",
            "verseOrgIds": [
              "ISA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
