            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.10+JOS.10.11+JOS.10.12"
              },
              "items": [
                {
                  "text": "Yos 10:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba MUKAMA aliimuka nkooku yaimukire ha rusozi Perazimu, alibiihirwa nkooku yabiihiirwe omu kihanga ekya Gibbyoni; akole omulimo gwe, omulimo gwe oguhuniriza! Akole omulimo gwe ogwahukaine ha mirimo endi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.21",
            "verseOrgIds": [
              "ISA.28.21"
            ]
          }
        }
      ]
    },
