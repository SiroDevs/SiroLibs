              },
              "items": [
                {
                  "text": "1Kor 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu mutampurre, Ruhanga alyekoonyeza abanyamahanga abarukubaza engambo etamanyirwe, nubo bagambire abantu be ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.11",
            "verseOrgIds": [
              "ISA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba yagambiire ati: “Kinu nikyo ekihuumuro; muhuumuzeege enjwahi; kandi bunu nubwo obusinge”; baitu bakanga kuhurra ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.12",
            "verseOrgIds": [
              "ISA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikyo MUKAMA arukwija kubeegeseza enyuguta emu emu, orukarra rumu rumu, ekigambo kimu kimu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki inywe abantu ab'emigayo, abanyakulema abantu banu aba Yerusaalemu, muhurre Ruhanga eky'arukugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.14",
            "verseOrgIds": [
              "ISA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.1.16"
              },
              "items": [
                {
                  "text": "Ama 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.14.12"
              },
              "items": [
                {
                  "text": "Sir 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba mukagamba muti: “Tukakora endagaano na Rufu twaikirraniza na nyabuyonga; obu haliija omuhito oguhinguraine, itwe tigulituhikaho; habwokuba turaayebingaga abanyabisuba turairukiraga omu bacwangya; nibyo biritutungisa obusinge.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.15",
            "verseOrgIds": [
              "ISA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Zab 118:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.33"
              },
              "items": [
                {
                  "text": "Bar 9:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.11"
              },
              "items": [
                {
                  "text": "10:11",
