                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ekitara kyange kinywire esagama omwiguru kyahaaguka; hati nikigenda kutema Edomu abantu abo abanacweriire ira omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA aina ekitara; kikanywa esagama kyahaaguka, kiswekerwe ebisajwa, kiroho esagama ey'ebyana by'entaama n'ey'embuzi, kiswekerwe ebisajwa eby'ensigo n'eby'empaya z'entaama. Habwokuba MUKAMA atambire ekyonzira omu Bbozira kandi aisire abantu baingi omunsi Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embogo zirafeera hamu nabo, kandi biraitirwa hamu n'enimi enkuru. Ensi yabo niija kunywa esagama, itaka lyabo, ebisajwa biraalyongera orwezo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba aina ekiro ekyalihorraho enzigu, ekyalisasulizaaho ebyakozirwe Siyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaizi ag'obwambu bw'Edomu galifooka rweju, itaka lyayo lihinduke buganga bw'ekibiriiti; ensi yayo erifooka rweju kaaka murro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.11"
              },
              "items": [
                {
                  "text": "Kus 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.3"
              },
              "items": [
                {
                  "text": "19:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamusana n'ekiro, omurro ogu tiguliraara; omwika guraikaraga nigucuuka ebiro byona. Eriikara eri kitongo okuruga ha mulembe gumu okuhika ha mulembe ogundi; tihaligaruka kubaho omuntu aligirabamu ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maleere n'enyamunungu nibyo birigyetungira, ensindizi n'ebingoora nibyo birigiikaramu. MUKAMA aligaruka agifoole byenga ebitasobora kwerwaho kantu, nkooku ekaba eri ebintu bitakahangirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku tihalibayo mukama n'omu, kandi ababiito bayo balifa busa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahwa galimera omu bigo byayo, omumya n'amatojo omumbuga zaayo; eraikaraga neegurukirwamu eboha, eraikarwamuga maaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.13",
            "verseOrgIds": [
              "ISA.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyamaiswa ez'omu irungu hamu n'empisi numwo biraatangatanganaga, ekyegasagasa nuho kiraayeteraga kigenzi kyakyo; ego, oku nuho haliruga waizikya kagendakiro, ayeserurre ekiikaro eky'okuhuumuramu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.14",
            "verseOrgIds": [
              "ISA.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku, ensindizi nuho eryombeka ekiju kyayo, nuho eryaalika amahuli, nuho eryatirra, kandi nuho eribumbatirirra obwana bwayo; oku nuho empungu ziraayesorooleezaaga, buli emu na ntaahi yayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muserre kandi musome omu kitabu kya MUKAMA, murole eki kirukugamba kiti: “Ha bintu ebi, tihalibaho na kimu ekiribura; kandi tihalibaho na kimu ekitaligira kitaahi kyakyo.” Habwokuba MUKAMA nuwe aragiire n'akanwa ke, kandi Mwoyo we nuwe yabisoroize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.16",
            "verseOrgIds": [
              "ISA.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuwe yatiire akaruuru kooleke omugabo ogwa buli omu, yabiteraho ensaro n'emitaano ebiro n'ebiro, kandi birigiikaramu ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.17",
            "verseOrgIds": [
              "ISA.34.17"
            ]
          }
        }
      ]
    }
  ],
