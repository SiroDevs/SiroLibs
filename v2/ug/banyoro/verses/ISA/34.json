            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byona eby'omwiguru birijunda bihweho, iguru lyekube nk'omuzingo gw'ekitabu. Ebintu byalyo byona ebinyakuliikaramu birigwa, nk'ebikoora by'omuzabbibbu oku bigwa, nk'ebikoora eby'omutini okubigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
