          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Kyona ekikuroho ninkimanya, ekyokora, n'ekiikaro ekyogendamu mmanyire nkooku ongirra ekiniga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.28",
            "verseOrgIds": [
              "ISA.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpuliire nkooku wambiihiriirwe kandi mpuliire nkooku orukwehemba, lero hati, ninyija kukudubura enyindo n'irobo lyange, nkute ekyoma kyange omu kanwa, nkugarreyo, ninkurabya omu muhanda guli gwonyini ogw'akuleesire.’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.29",
            "verseOrgIds": [
              "ISA.37.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
