        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.29",
            "verseOrgIds": [
              "ISA.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinu nikyo oraamanyiraho: mwaka gunu, olye ebinyakwemereze byonka, n'omu gwakabiri olye ebiryemeza nibiruga omuli ebi; hanyuma omu mwaka ogwakasatu, musige kandi mugese, mulime emisiri ey'emiti ey'emizabbibbu, niyo mulyehoga ebijuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.30",
            "verseOrgIds": [
              "ISA.37.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'enju ya Yuda abaliba basigaireho, balyongera kunaga emihama bazaale bakanye; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.31",
            "verseOrgIds": [
              "ISA.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba omu Yerusaalemu abantu abaliba basigaireho, ha harusozi Siyoni, halirugayo ekitebe ky'abantu abaliba basigaireho, habwokuba MUKAMA Ow'obusobozi bwona, nuwe yacwiremu kukora eki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.32",
            "verseOrgIds": [
              "ISA.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
