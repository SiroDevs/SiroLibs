            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kirihika, omukama omuhyaka ow'aliruga omu rulyo orw'abakama ab'enju ya Daudi, eki alizookeraho ali karorwaho k'amahanga. Abantu balyesorooleza omu rubuga rwe orw'obukama, bamuhe ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abasigaireho nibagaruka n'omuhimbo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
