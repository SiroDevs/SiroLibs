              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabbu obu yahuliire ebigambo ebi, yatemura ebyokujwara bye, yajwara eguniya, yasiiba, yabyamira eguniya ezi, yaikara naagendagenda aina obujune. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
