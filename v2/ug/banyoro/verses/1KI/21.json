          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akakaguza Eriya Omutisibi ati: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
