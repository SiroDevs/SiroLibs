          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogwa kana omu kwezi okwa Zivu, nubwo baatandikire kwimukya kukora omusingi ogw'enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu mwaka ogwa ikumi na gumu, omu kwezi okwa Buli, enju nubwo yahweriire kimu yoona, nkooku ekaba etegekerwe. Akagyombekera emyaka musanju.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
