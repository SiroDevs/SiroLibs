          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga akaha Solomooni amagezi n'obwetegereza ebihinguraine, kandi yamuha okumanya okutaina rulengo, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "amagezi ge gakakira amagezi ag'abantu boona aba Burugaizooba, n'ag'abantu boona aba Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
