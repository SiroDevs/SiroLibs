          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabazaaho emiti, okutandikira ha mikogoto eya Lebanoni, okugarukira ha mwihura ogunyakuranda ha kisiika; atagarukire aho, akabazaaho ha bisoro, ha binyonyi, ha bintu ebinyakwekurra, na ha ncu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
