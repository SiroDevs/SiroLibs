                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "niiwe ayayekonyiize Mwoyo Ahikiriire kugambisa isenkuru-itwe Daudi omuheereza waawe oti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.25",
            "verseOrgIds": [
              "ACT.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaikiriza ab'okubanza baakorraga hamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
