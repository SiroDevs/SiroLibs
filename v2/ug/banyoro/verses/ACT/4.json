              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli bo hakaba hatarumu n'omu ayaburwahoga ekintu, habwokuba boona abakaba baina ebibanja rundi amaju bakabitunda, baaleeta sente ezi baihiremu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
