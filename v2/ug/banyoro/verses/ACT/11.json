              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaikiriza bakacwamu buli muntu aheyo obukoonyezi nkooku arukusobora, ebintu babitwekere bagenzi baabo abaikara Buyudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.29",
            "verseOrgIds": [
              "ACT.11.29"
            ]
          }
