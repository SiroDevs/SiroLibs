              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Bir 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiragiro obimanyire: ‘Otalisiihana, otaliita, otaliiba, otalihangirra, otiinege sso na nyoko.’”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.20",
            "verseOrgIds": [
              "LUK.18.20"
            ]
          }
        }
      ]
    },
