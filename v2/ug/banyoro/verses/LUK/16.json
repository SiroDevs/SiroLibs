          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.8",
            "verseOrgIds": [
              "LUK.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 16:9"
          },
          "items": [
