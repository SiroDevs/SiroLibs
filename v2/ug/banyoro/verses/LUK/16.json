                "loc": "MAT.6.24"
              },
              "items": [
                {
                  "text": "Mat 6:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiharoho muheereza anyakusobora kuheereza abakama babiri. Alinobaho omu, agonze ondi; rundi aligumira hali omu, agaye ondi. Timusobora kuheereza Ruhanga n'okwemarra ha itungo ly'ensi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naagarukamu abaamusekeriize",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafalisaayo abagonzaaga itungo ly'ensi obu baahuliire ebi byona, baamusekeereza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo Yesu kubagambira ati: “Inywe mweyoleka nk'abarungi omu maiso g'abantu, baitu Ruhanga amanyire emitima yanyu. Habwokuba abantu eki banyumiza, Ruhanga akinuga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
