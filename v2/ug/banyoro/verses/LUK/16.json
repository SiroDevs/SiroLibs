            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu weena anyakubinga mukazi we akaswera ondi aba asiihaine; kandi n'omusaija anyakuswera omukazi abingirwe, nawe aba asiihaine.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
