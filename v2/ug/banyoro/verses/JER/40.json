              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.6",
            "verseOrgIds": [
              "JER.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.22+2KI.25.23+2KI.25.24"
              },
              "items": [
                {
                  "text": "2 Bakam 25:22-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engabwa z'amahe zoona ezikaba ziri omu byaro n'abasaija baabu, obu baahuliire ngu omukama wa Bbabbulooni akomere Gedaliya mutabani w'Ahikamu amufoire mulemi omukuru omunsi, kandi amukwasize abasaija, abakazi n'abaana, abo abaakirraga kimu obunaku omunsi, abakaba batazaahisibwe Bbabbulooni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "baagenda Mizipa omba Gedaliya-Isimairi mutabani wa Nesaniya, Yohanaani mutabani wa Kaleya, Seraaya mutabani wa Tanihumeesi, batabani b'Efai Omunetofasi, na Yezaniya mutabani w'omumaaka, n'abasaija baabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedaliya mutabani w'Ahikamu, mwijukuru wa Safani, yabarahira hamu n'abasaija baabu ati, “Mutatiina kuheereza Abakalidaaya. Mwikale omunsi muheereze omukama wa Bbabbulooni nukwo mutunge obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe habwange ninyija kwikara Mizipa, mbege mukurasi wanyu, hali Abakalidaaya abalituhikaho; baitu inywe, musorooze eviini, ebijuma eby'omu mwaka ogw'ekyanda n'amagita, ebimu mubyahule omu minaga yanyu, nukwo mwikale omu mbuga ezi mwahambire.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mulingo nugwo gumu Abayudaaya boona abakaba bali Mowabbu omu Baamooni, Edomu n'omunsi ezindi, nabo obu baahuliire ngu omukama wa Bbabbulooni alekere abantu bake omunsi ya Yuda, kandi ngu akomere Gadaliya mutabani w'Ahikamu mwijukuru wa Safani, abe mulemi wabo omukuru, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "boona nubwo baarugire omubiikaro byona ebi bakaba babingiirwemu, baija omunsi ya Yuda, baahika Mizipa omba Gedaliya; baasorooza eviini n'ebijuma eby'omwaka ogw'ekyanda ebihinguraine muno obwingi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanaani mutabani wa Kaleya n'abaduumizi b'amahe boona, abakaba bali omu byaro, baagenda Mizipa omba Gedaliya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "baamukaguza bati, “Omanyire Baalisi omu kama w'Abamooni, nkooku atumire Isimairi mutabani wa Nesaniya kukwita?” Baitu Gedaliya tiyabaikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanaani mutabani wa Kaleya nubwo yabaliize Gedaliya omunsita, bali Mizipa ati, “Kangende nyite Isimairi, mutabani wa Nesaniya eki busaho muntu arakimanya. Naasobora kukwita ata, Abayudaaya boona abanyakukwesorooliizeeho bakararanga, n'abantu ba Yuda abasigaireho, bakahwerekerra?” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Gedaliya mutabani wa Ahikamu yagarukamu ati, “Eki otakisura, habwokuba Isimairi noomuhangirra.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
    }
  ],
