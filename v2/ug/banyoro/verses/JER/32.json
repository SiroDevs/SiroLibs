                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Bakam 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30"
              },
              "items": [
                {
                  "text": "Yer 7:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebisisani by'embandwa zaabu ebinugwa, bakabita omunju eyayombekiirwe kundamizaamuga, baagisiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Bakam 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Yer 7:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Lev 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayombeka amatambiro omukihanga kya Hinoomu, nuho batambirrege batabani na bahara baabu, embandwa Moleki; eki ntakibaragire, kandi nkaba ntarukuteekereza nti, basobora kukora ekintu nk'eki, bakanaga abantu ba Yuda omu kibi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA Ruhanga owa Isirairi, akangambira ati, ‘Yeremiya, abantu nibagamba ngu obulemu, kiihe, na kagingo iriteera orubuga runu kugwa omu mukono gw'omukama wa Bbabbulooni. Hati nu, huura ekindukugamba.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyija kubasorooza mbaihe omunsi zoona ezi nabararangizeemu, mbiihiirwe, nkwasirwe ekiniga, kandi ekiniga ekitagambwa; ndibagarra omu kiikaro kinu, mbahe okugwagwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baliba bantu bange, na nyowe ndiba Ruhanga wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibaha omutima gumu n'omuhanda gumu, nukwo bantiine ebiro byona, eki kibarugiremu oburungi, kandi kirugiremu abaabu oburungi, bbo batakyaroho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikora nabo endagaano ey'obusinge, ey'erukugumya nkooku ntalireka kubakorra ebirungi, kandi emitima yaabu, ndigitamu kuntiina, nukwo baleke kundugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndisemererwa muno, okubakorra ebirungi, kandi ndibabyarra kimu omunsi enu, n'omutima gwange gwona, n'obwomezi bwange bwona.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: “Abantu banu nkooku nabaleetiire akabi akakooto kanu koona, kandi nukwo ndibaleetera oburungi bwoona obu nabaraganiize. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emisiri ey'omunsi enu ei murukugamba ngu, kinu itongo, eritarumu bantu rundi ebisoro; ngu lihairwe Abakalidaaya, niija kugurwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati, “Omunsi ya Banyamisiri n'omu biikaro ebiherraine Yerusaalemu, omu mbuga za Yuda, omu mbuga ez'ensi ey'ensozi, omu mbuga ez'omu kyeya n'embuga eza Negebbu, emisiri erigurwa eheerwe sente, endagaano eriteebwaho emikono ibohwe iteebweho emanyikirizo, kandi habeho abakaiso, habwokuba ndibagarurra itungo lyabo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
