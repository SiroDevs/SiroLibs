          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Yeremiya ekigambo kinu ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA Ruhanga owa Isirairi naagamba ati: Ebigambo byona ebi nkugambiire, obihandiike omukitabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati, habwokuba akasumi aka ndigarurramu abantu bange aba Isirairi na Yuda, itungo lyabo, kalihika, kandi ndibagarra omunsi ei nahaire baisenkurubo, bagirye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binu nibyo ebigambo MUKAMA ebi yagambireho Isirairi na Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
