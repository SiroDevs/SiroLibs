                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuganuro ogw'ebijuma eby'itaka lyanyu, muguleetege omunju ya MUKAMA Ruhanga wanyu. Ekyana ky'embuzi, mutalikicumbisa amata ga nyinakyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
