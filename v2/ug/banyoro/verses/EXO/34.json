                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutemuga ekitiinisa obugenyi obwa wiiki, nubwo obugenyi obw'omuganuro, n'obugenyi obw'igesa erya ha mpero y'omwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija baanyu boona, bazookege emirundi esatu buli mwaaka omumaiso ga MUKAMA Ruhanga, Ruhanga wa Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, ndibinga amahanga mutakagahikiremu, nyirizeeyo emitaano yawe, busaho n'omu ow'alyegomba kwegarurra emitaano yawe, obu muraabaga mugenzire kukurata omumaiso ga MUKAMA Ruhanga wanyu emirundi egi esatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
