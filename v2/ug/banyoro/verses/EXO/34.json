                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalyekorra baaruhanga kuruga omu bintu ebirukwagibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
