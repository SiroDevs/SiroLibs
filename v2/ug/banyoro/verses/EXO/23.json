          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otalihonga esagama ey'ekyonzira kyange hamu n'ekintu ekitatumbisiibwe, rundi kuleka ebisajwa eby'ekihongwa kyange bikaikaraho okuhikya nyenkya.",
          "type": "text",
