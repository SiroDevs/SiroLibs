            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu myaka mukaaga, mubyalege embibo omu itaka lyanyu, mugese ebiryereze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omu mwaka ogwa musanju, muliteneke kwonka, mulirekege lihuumule, limereze abanaku ab'ensi yanyu ebyokulya, kandi ebirisigaramu, biriibwe ebisoro eby'omu kisaka. Omusiri gwawe ogw'emizabbibbu, n'orugonjo rwawe orwa oliva, nabyo nukwo obikolege oti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
