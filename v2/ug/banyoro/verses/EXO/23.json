          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emirundi esatu buli mwaka, omusaija weena azookege omumaiso ga MUKAMA Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
