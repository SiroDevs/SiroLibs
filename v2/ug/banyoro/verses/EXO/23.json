              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro mukaaga, okolege emirimo yawe yoona, baitu ha kiro ekya musanju, ohuumulege, ente yawe n'enkaina yawe, nabyo bihuumule, mutabani w'omuzaana ou waguzire n'omunyaihanga, bagarukwemu amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taho omutima byona ebi nkugambiire. Otaliramya abaruhanga abandi n'obwakubaire kubagambaho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
