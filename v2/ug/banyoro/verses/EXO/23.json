              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyana ky'entaama, otalikicumbira omu mata ga nyinakyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
