            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba osanga ente rundi enkaina ey'omunyanzigwa wawe ehabire, ogihabule ogimuleetere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba orora enkaina ey'omuntu ayakunobere egwire, ebintu bigyejumikiire, otaligireka hansi n'ebintu ebi, gikonyere ogiimukye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
