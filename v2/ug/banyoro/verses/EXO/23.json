            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muracumbaga obugenyi obw'ekiro eky'omuganuro ogw'ebintu byanyu ebi mwereze omu misiri yanyu, ebyarugire omu kutalibana kwanyu. Ha mpero y'omwaka, muracumbaga obugenyi obw'okuhunika, obu muraabaga nimuhunika ebi mwaihire omu misiri yanyu, ebyarugire omu kutalibana kwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
