            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olekege kuburanganiza obwinganiza omu musango, okuhenderra omunaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyerinde kucwa omusango ogw'okuhenderra, kandi otaliita omuntu atanyina musango rundi anyakuhikiriire, habwokuba nyowe MUKAMA, omuntu omubi tindimwihaho musango. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otalirya enguzi omurundi na gumu, habwokuba enguzi esiikiriza abalemi kandi eburanganiza obulyo bw'abo abarukubaza amazima.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
