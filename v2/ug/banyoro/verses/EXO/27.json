{
  "id": "EXO.27",
  "number": "27",
  "bookId": "EXO",
  "reference": "Kurug 27",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
