              },
              "items": [
                {
                  "text": "Baheb 9:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.20"
              },
              "items": [
                {
