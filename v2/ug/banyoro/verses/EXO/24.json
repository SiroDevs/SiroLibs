                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yakwata esagama, yagimiisira abantu naagamba ati: “Enu niyo sagama ey'endagaano MUKAMA ei akozire na inywe, ebigambo by'ekitabu kinu nkooku birukugamba.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Musa na Arooni, Nadabu, Abihu, n'abantu nsanju ab'omu bakuru ba Isirairi, baatemba ha rusozi, baarora Ruhanga owa Isirairi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.9",
            "verseOrgIds": [
              "EXO.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "hansi y'ebigere bye, hakaba nihasisana nka haliriirwe amabaale ag'omuhendo mwingi agarukwetwa Safiro, nihazooka nk'iguru, obu liba likiire kurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
              "EXO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b'abantu aba Isirairi, MUKAMA atabakoleho kabi, bakamurora, baalya, baanywa n'obusinge.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa ali ha rusozi Sinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga yagamba Musa ati: “Temba onsange ha rusozi, oikaleyo, ninyija kukuha ebibbali by'amabaale, ebinyakuroho ebiragiro n'eby'okuduuma, ebi mpandiikire obyegese abaana ba Isirairi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yaimuka hamu n'omuheereza we Yoswa, yatemba ha rusozi rwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagambira abakuru ba Isirairi ati: “Mutulindirre hanu, okuhikya obu turaagaruka, nabasigira Arooni na Hura, omuntu weena ow'araaba n'ekigambo eki arukwenda kumumarra, abahikeho.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Musa yatemba ha rusozi, orusozi rwaswekwa ekicu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.15",
            "verseOrgIds": [
              "EXO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiinisa kya Ruhanga kyazooka kandi kyaikara ha rusozi. Orusozi rwaswekwa ekicu okumara ebiro mukaaga; ha kiro kya musanju, MUKAMA yayeta Musa, ali omu kicu hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisirairi baarora ekitiinisa kya MUKAMA ha mutwe gw'orusozi nikisisana omurro kahwerekereza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.17",
            "verseOrgIds": [
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.9"
              },
              "items": [
                {
                  "text": "Bir 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yataaha omu kicu, yatemba ha rusozi, akamarayo ebiro makumi ana nyamusana n'ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.18",
            "verseOrgIds": [
              "EXO.24.18"
            ]
          }
        }
      ]
    }
