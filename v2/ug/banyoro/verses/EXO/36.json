          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi baarukorra enyomyo itaano n'ebikwaso byazo. Emitwe yazo, baagisweka zaabbu, baitu obucuba bwazo, bukaba buli bw'omulinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
