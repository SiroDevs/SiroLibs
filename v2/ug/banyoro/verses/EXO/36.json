              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakora orukingyo orw'orugoye orwa kitaani enyakurangirwe kurungi, etabwirwemu ehuuzo eza kaneke, kahukya n'ezirukugaajuka, bakarukora baarubazirraho kurungi ebisisani by'ebihange byamapapa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orukingyo baarukorra enyomyo ina ez'omuti omusisa, baazisweka zaabbu, baazikwasizaaho n'ebikwaso ebya zaabbu, baazeemereza omu bucuba obw'efeeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baakora orutimbe orw'omulyango ogw'Eheema, omu rugoye orurukirwe kurungi, baatamu amanyumizo ag'ehuuzo eza kaneke, kahukya n'ezirukugaajuka, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
