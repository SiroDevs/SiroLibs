{
  "id": "ECC.7",
  "number": "7",
  "bookId": "ECC",
  "reference": "Mug 7",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ECC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebitekerezo ebirukukwata ha bwomeezi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.1"
              },
              "items": [
                {
                  "text": "Nfu 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibara, erirungi nirikira amagita ag'omuhendo; kandi ekiro eky'okufa, kikira eky'okuzaarwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okugenda omunju nambere barukurra, kirungi okukira kugenda omunju nambere hali obugenyi; habwokuba okufa niyo empero ey'abantu boona, kandi aboomeezi eki baikalege nibakiijuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusaalizi buba burungi okukira enseko, habwokuba, obujune obwa ha maiso, busemereza omutima. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gw'omuntu ow'amagezi, gwikara omunju nambere hali kurra; baitu omutima gw'abadoma, gwikara omunju nambere hali enseko. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirungi omuntu kwikiriza kuhanwa abanyamagezi, okukira omuntu kuhurra ekizina ky'abadoma. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba enseko z'abadoma zisisana amahwa aganyakuhuulikira omu kyoto eki na kyo tikiina mugaso. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazimakwo, okusaaliza omuntu, kuteera abanyamagezi obudoma, kandi enguzi, esiisa ebitekerezo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero y'ekintu, eba nungi kukira entandiko; kandi okugumiisiriza, kuba kurungi kukira okwekuza. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.19"
              },
              "items": [
                {
                  "text": "Yak 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olekege kubiihirwa bwango, habwokuba, abadoma nubo baikaza ekiniga ha mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olekege kwekaguza oti, “Habwaki omu biro ebya ira, ebintu byali biri birungi, okukira ebya hati?” Eki, tikiri kikaguzo ky'amagezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi kintu kirungi, kigasira abo abanyakujwerwa omusana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, sente nkooku zirinda omuntu, n'amagezi nukwo gamulinda: kandi ekirungi ekiruga omu magezi, nikyo kinu: anyakwina amagezi, arora nkooku garukumulinda kurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oteekereze Ruhanga ebi yakozire; eki yaramaize, n'oha asobora kukigorra? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ak'obusinge, semererwa, kandi omu kasumi ak'omuhito teekereza oti; Ruhanga nuwe yaleesire obusinge kandi nuwe yaleesire omuhito. Omuntu nukwo aleme kumanya, ekyamutegekiirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bwomeezi bwange bunu obw'akacu kake, nkeetegerezaamu bingi muno: Omuntu omurungi, omuburungi bwe noobu aba naakora ebirungi bita, nuwe afa, kandi omuntu atatiina Ruhanga, ayomeera kukiraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleke kuhinguraniza kuba muhikiriire, kandi oleke kweyeta munyamagezi anyakuhinguraine; habwaki nooyenda kufa? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleke kuba mubi kutamu ensaagi, kandi oleke kuba mudoma; nooyendera ki kufa, akasumi kaawe katakahikire? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekirukukira oburungi, nukwo kugumya ekimu, baitu ekindi nakyo kutakireka, habwokuba, omuntu anyakutiina Ruhanga, ebi byombi alibihikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi gaha omunyamagezi amaani, okukira ag'abalemi ikumi abanyakuli omu rubuga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazimakwo, omunsi munu tiharumu muntu omurungi, ataina kamogo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olekege kuta omutima ha bintu byona, abantu ebi bagamba, otaliikara kuhurra omuheereza waawe naakukondereza; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.21",
            "verseOrgIds": [
              "ECC.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na iwe wenka noomanya, nkooku wakonderiize abantu abandi emirundi nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi byona nkabyetegereza n'amagezi; nukwo kucwamu nti, “ndaabaga w'amagezi”; baitu eki kikandema. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi byona, nkabirengesa n'amagezi nagamba nti, ndiba w'amagezi; baitu amagezi ntagahikeho. Tinsobora kugakenga; kintu ekihamire, kihamire muno, n'oha asobora kukyetegereza? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwange, nkagumarra ha kumanya kwekebiija, kuserra amagezi n'omuhendo gw'ebintu, na ha kumanya obubi bw'obugwagwa, n'obudoma, niryo iraro. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi eki naboine ekisaaliire kukira orufu, nuwe omukazi; omutima gwe, mitego kandi butimba kandi emikono ye mpiingo, omuntu anyakusemereza Ruhanga, ayetantara omukazi, baitu omusiisi ogu, aliba munyankomo we. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ECC 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugambizi naagamba ati, obu nkaba ninyongera ekintu ekimu ha kindi, nukwo nzoole omuhendo kinu nikyo nazoire, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ECC 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "eki naikaraga ninseruliriza ntakizoole. Omu basaija rukumi, nkasangamu omusaija omu, baitu omukazi omuli abo boona, ntasangemu n'omu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ECC 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimu kyonka nikyo nazoire, Ruhanga akahanga omuntu aterekeriire, ebintu ebigumire kandi ebitarukwetegerezibwa, omuntu akabyeereetera wenka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.29",
            "verseOrgIds": [
              "ECC.7.29"
            ]
          }
        }
      ]
    }
  ],
