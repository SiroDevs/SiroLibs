        },
        {
          "text": "“Otalinyigiriza omunyaihanga rundi enfuuzi, rundi kwihaho enfaakati ekyokujwara kye gube musimbo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
