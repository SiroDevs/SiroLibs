                "loc": "MRK.10.4"
              },
              "items": [
                {
                  "text": "Mar 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omusaija kakuba aswera omukazi, hamazire kuhingura akasumi akagamba ngu: omukazi ogu tarukumugonza, habwokuba anyina ekyamuboineho ekyatarukwenda, akamuhandiikira ebbaruha erukumuha obusobozi obw'okwahukana na uwe akagimuha, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukazi ogu kakuba aswerwa omusaija ondi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "omusaija ogu na uwe akagamba ngu: omukazi ogu tarukumugonza, akamuhandiikira ebbaruha erukumuha obusobozi obw'okwahukana na uwe akagimuha akamubinga omunju ye, omusaija ogu ayamuswire hanyuma kakuba afa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "iba oli kimuswera okubanza ayamubingire, tarukwikirizibwa kumuswera obwa kabiri, amazire kusiisikara; habwokuba, eki Ruhanga takigonza, kandi ensi MUKAMA ei arukwija kukuha otaligireetaho omusango.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebiragiro ebitali by'omuliingo gumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
