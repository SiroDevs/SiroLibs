          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obworabaga noonoga ebijuma byawe ebya oliva, omuti otaligunogororra kimu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
