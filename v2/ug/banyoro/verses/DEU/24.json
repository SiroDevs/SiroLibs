                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu kakuba bamusanga naanyaga omu ha bagenzibe Abaisirairi, akamufoora nk'omwiru, rundi akamuguza omuntu ondi, omunyagi ogu kimusemeriire afe, obu olikora oti, nubwo olyeihamu obubi bwona obwonyinabwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
