        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Lev 13:1—14:54.",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kinu okiteho omutima, kakuba okwatwa ebigenge, oyekambe okuhikiriza byona banyakatagara Abaleevi ebibaraakwoleka; byona ebinabaragiire kukora nibyo okole. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Kubar 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu mukaba nimuruga omunsi Misiri, mwijukege MUKAMA Ruhanga wanyu ekiyakozire Miryamu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
    {
