              "items": [
                {
                  "text": "Lev 19:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otalikerereza okusasura omusaara gw'omuntu omunaku, kandi omuseege anyakukukoliire, ou wayetiire omulimo, noobu aliba omu ha bagenzi bawe, rundi omu ha banyamahanga abanyakuli omunsi yawe, omumbuga zaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusasulege empeera ye ha kiro ekyagikoleriireho, izooba litakagwire, habwokuba munaku, kandi omutima gwe gwona guli ha sente ezi; ataliikara kukusabira kubi hali MUKAMA, eki kikakurugirramu ekibi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
