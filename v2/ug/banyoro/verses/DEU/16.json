                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mubalege wiiki musanju; wiiki ezi mutandikege kwibara nimurugirra ha kasumi aka muraatandikirahoga kugesa engano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, nubwo musemeze ekiro kikuru eky'igesa, mutemu MUKAMA Ruhanga wanyu ekitiinisa, nimumuleetera ebihongwa eby'okwegondeza ebirukwingana omugisa ogu yabahaire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukyanganukege omumaiso ga MUKAMA Ruhanga wanyu, inywe, batabani banyu na bahara banyu, abairu banyu n'abazaana banyu, Omuleevi anyakwikara omumbuga zanyu, omunyaihanga, enfuuzi n'abafaakati abamurukwikara nabo. Mukyanganukirege omukiikaro MUKAMA Ruhanga wanyu ekyalyekomera kwikaramu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwijukege nkooku mukaba muli bairu omunsi Misiri; habweki, mwekambege kukwata ebiragiro binu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
