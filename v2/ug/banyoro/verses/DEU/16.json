            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Buli mwaka, abasaija bawe boona, bazookege omumaiso ga MUKAMA Ruhanga wawe omukiikaro ekyalyeekomera: ha bugenyi obw'emigaati etatumbisiibwe, ha bugenyi obwa wiiki musanju, na ha bugenyi obw'ensiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bataliija ngaro nsa omumaiso ga MUKAMA. Buli muntu aheyo ekyarukusobora, nimurorra ha mugisa MUKAMA Ruhanga wanyu ogu yabahaire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okurolerra obwinganiza",
          "type": "text"
        }
      ]
    },
    {
