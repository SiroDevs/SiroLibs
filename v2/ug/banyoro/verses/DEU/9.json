            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi noomu biikaro: Tabera, Maasa, na Kiburosi-hataava, nabwo mukabiihiza MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
