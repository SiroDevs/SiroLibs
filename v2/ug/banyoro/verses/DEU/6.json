            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebigambo binu ebi ndukubaragira, mubiikazeege ha mutima, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
              "DEU.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mubyegeseege muno abaana banyu, obu muraabaga mwikaliire omumaju ganyu, obu muraabaga nimugenda omu muhanda, obu muraabaga mubyamire, n'obu muraabaga nimwimuka, mubibazeehoga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubyebohege hamukono bibaikaleho nk'akarorwaho, kandi bibege habuso hagati y'amaiso ganyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubihandiikege hamikumirro ey'enyigi ez'amaju ganyu, na hamalembo ganyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.9",
            "verseOrgIds": [
              "DEU.6.9"
            ]
          }
        }
      ]
    },
