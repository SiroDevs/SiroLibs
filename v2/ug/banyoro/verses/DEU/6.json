              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu biro eby'omumaiso, abaana banyu obu balibakaguza bati: ‘Ebiragiro n'ebigambo ebi, MUKAMA Ruhanga waitu yabaragiire, biina makuru ki?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubagarukemu muti: ‘Tukaba tuli bairu ba Faraaho omunsi Misiri; MUKAMA yatwihisaayo obusobozi bwe obw'amaani; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatukorra ebintu eby'amahano n'ebihuniriza, eby'amaani kandi ebitiinisa, naarwanisa Misiri, Faraaho neeka ye yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.22",
            "verseOrgIds": [
              "DEU.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatwiha kuli, nukwo atuleete hanu, atuhe ensi ei yarahiire okuha baisenkuruitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
              "DEU.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaturagira okukwata ebiragiro bye byona, n'okutamuga MUKAMA Ruhanga waitu ekitiinisa, eki obutoosa nikyo kiraaturugiramuga oburungi, nukwo atwikaze tuli bomeezi nkooku tuli hati. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutulitaho omutima okukwata ebiragiro binu byona, MUKAMA nkooku yaturagiire, eki kiritufoora bahikiriire.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
            "verseOrgIds": [
              "DEU.6.25"
            ]
          }
        }
      ]
    }
