            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA Ruhanga wanyu, obu alibahikya omunsi ei yarahiire baisenkuru inywe Abburahamu, Isaaka na Yakobbo ngu aligibaha, ensi enyakurumu embuga enkooto kandi enungi ezi mutarayombekere, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'amaju aganyakwijwiire ebintu byona ebirungi ebi mutaratairemu, n'amaziba agamutaralimire, emisiri ey'emizaabbibbu n'emiti eya oliva ei mutarabyaire, obumulirya mukaiguta, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "obu, mwerinde, mutaliikara kwebwa MUKAMA ayabaihire omunsi Misiri, nambere mukaba mutungirwe muli bairu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.10"
              },
              "items": [
                {
                  "text": "Mat 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.8"
              },
              "items": [
                {
                  "text": "Luk 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutemuga MUKAMA Ruhanga wanyu ekitiinisa, mumuheerezeege, kandi murahirege ibara lye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaliramya embandwa zoona noobu hakubaire eza mahanga aga muherraine nago, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba MUKAMA Ruhanga anyakuli hagati yanyu, aba Ruhanga ow'ihali; ataliikara kubakwatirwa muno ekiniga, akabahwerekereza akabamara omunsi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        }
      ]
    },
