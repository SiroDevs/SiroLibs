              "attrs": {
                "loc": "EXO.17.1+EXO.17.2+EXO.17.3+EXO.17.4+EXO.17.5+EXO.17.6+EXO.17.7"
              },
              "items": [
                {
                  "text": "Kurug 17:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutalikisura kulenga MUKAMA Ruhanga wanyu nkooku mwamulengere omunsi Maasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekambirege kukwata ebiragiro bye, n'ebigambo bye ebi yabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukolege ebihikire, kandi, MUKAMA ebi asiima nukwo mutunge omugisa, mugende mulye ensi enungi ei yarahiire kuha baisenkuru inywe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naabanza kubingamu abanyanzigwa banyu boona nkooku yakinihiize.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
    {
