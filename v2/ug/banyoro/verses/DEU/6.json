              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumugonzeege n'omutima gwanyu gwona, n'omwoyo gwanyu gwona, n'amaani ganyu goona.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.5",
