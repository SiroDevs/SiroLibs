          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaisirairi nibasaba omukama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri obuyagurusire, abaana be nubo yafoora bacwi b'emisango ba Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.1",
            "verseOrgIds": [
              "1SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibara ly'omwana we omuzigaijo, nuwe Yoweri, omusubiro nuwe Abiya; emisango baagicweraga Beeri-seba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.2",
            "verseOrgIds": [
              "1SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abaana abo, batabe n'engeso nke'zaise bo, omutima bakagumarra ha sente, nukwo kweha kulya enguzi n'okutagendera habwinganiza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru boona aba Isirairi, nukwo kwesorooza, baagenda Rama hali Samwiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.4",
            "verseOrgIds": [
              "1SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.14"
              },
              "items": [
                {
                  "text": "Bir 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baamugambira bati: “Hati, wakura, kandi abaana bawe tibaina ngeso nk'ezaawe; otukomere omukama ow'okutulema, na itwe tube n'omukama nk'amahanga agandi goona.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.5",
            "verseOrgIds": [
              "1SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ekintu eki eky'okusaba omukama, kikabiihiza Samwiri, uwe nukwo kusaba MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Samwiri ati: “Ohurre kyona abantu ekibarukukugambira; habwokuba tibangire iwe, bangire nyowe, ndeke kuba mukama wabo nkabalema. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Byona ebibaakankozire okuruga ha kiro ekinabaihiireho Misiri okuhika na hati: nk'okundugaho n'okuheereza embandwa, hati nibyo barukukukora na iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, iwe ohurre ekibarukugamba; kyonka obahabule kurungi, kandi obakengese engeso z'omukama arukwija kubalema.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo MUKAMA ebiyagambire, Samwiri nukwo kubagambira abantu abo, abakaba nibamusaba omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabagambira ati: “Binu nibyo mukama wanyu alibakora: abamu ha baana banyu, alibafoora baserikale, abamu hali bo baheerezeege omu bulemu obunyakurwanirwa ha bigaali, abandi baheerezeege omu bulemu obunyakurwanirwa ha mbaraasi, abandi bairukege omumaiso g'ebigaali bye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu alibafoora ngabwa ez'abantu enkumi n'ab'amakumi ataano, kandi abandi balimi abaramulimiraga, abaraamugeseraga, kandi abaraamuheesiraga ebyokurwanisa n'ebintu eby'ebigaali bye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alitwara bahara banyu bamukorrege ebintu ebirukuboya, bamucumbirege ebyokulya n'emigaati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emisiri yanyu, ey'emizabbibbu, n'ey'emizaituni erukukirra kimu yoona oburungi, aligibaihaho agihe abaheereza be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ngano yanyu na hamisiri yanyu ey'emizabbibbu, aliihaho kimu kya ikumi, akihe abalemi be n'abaheereza be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abairu banyu n'abazaana banyu alibabaihaho, ente n'enkaina zanyu ezirukukirra kimu oburungi, alizibaihaho azikoze omulimo gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha magana ganyu ag'embuzi, alitwaraho kimu kya ikumi, kandi inywe inywenka, mulifooka bairu be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro eki obu kirihika, muliteera omukungo habw'omukama wanyu ogu ou mwayekomiire; baitu obu, MUKAMA talibaanukura.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abantu baayanga kuhurra Samwiri ekiyabagambiire; baagamba bati: “Nangwa! Nitwenda omukama, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.19",
            "verseOrgIds": [
              "1SA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na itwe nukwo tusisane n'amahanga agandi goona, omukama waitu ogu, nukwo atuleme, atwebembere, aturwanire amalemu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
            "verseOrgIds": [
              "1SA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri obuyamazire kuhurra byona abantu ebibaagambire, yagenda yabigambira MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Samwiri ati: “Bakorre ekibarukwenda obahe omukama.” Samwiri nubwo yagambiire Abaisirairi ati: “Buli omu ataahe owabu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    }
  ],
