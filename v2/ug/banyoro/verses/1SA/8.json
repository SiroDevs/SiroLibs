{
  "id": "1SA.8",
  "number": "8",
  "bookId": "1SA",
  "reference": "1 Sam 8",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
