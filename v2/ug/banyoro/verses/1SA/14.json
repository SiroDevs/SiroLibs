              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro eki, Abaisirairi bakaita Abafirisiti, okuruga Mikimaasi okuhika Aiyaroni. Omukasumi ako, enjara ekaba ebali kubi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo kugwera ebibanyagireho abanyanzigwa: entaama, enimi n'enyana, baaziita, baaliiramu n'esagama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
        {
