              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi obuyagarukire Zikiraga, yakwata ekicweka eky'omunyago yakitwekera banywani be bakuru b'abantu ba Yuda naagamba ati: “Mbahaire ekisembo nkikyo, kirugire hamunyago ogwanyagirweho abanyanzigwa ba MUKAMA;” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
