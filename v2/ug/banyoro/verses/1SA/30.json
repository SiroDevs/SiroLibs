              "type": "text"
            }
          ]
        },
        {
          "text": "aba Horuma, aba Borasaani, ab'Ataki, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
