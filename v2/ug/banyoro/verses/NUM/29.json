        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eky'okubanza eky'okwezi okwa musanju, mwesoroozeege; ha kiro eki, mulekege kukora omulimo ogw'amaani. Ekiro eki nikyo muraateerrahoga engwara, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "muhongege ekihongwa eky'okwokya, ekirukurugwamu ekisorrokoko ekirukuboyera kurungi MUKAMA: muhongege ente emu, empaya y'entaama emu, ebyana by'entaama ebihaya musanju ebitanyina kamogo, ebinyakuhikize omwaka gumu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekihongwa kyabyo eky'ebyokulya, niyo nsaano enyakuniinuukire kurungi, etabwire n'amagita, kiloguraamu isatu ezirukugenda hamu n'enimi, na kiloguraamu ibiri ezirukugenda hamu n'empaya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi na kiloguraamu emu eyerukugenda hamu n'ebyana by'entaama musanju; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamu n'empaya y'emburabuzi ey'okubasabira ey'ekihongwa eky'okuganyiza ebibi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nibyongerwa ha kihongwa eky'okwokya ekya buli mboneko y'okwezi n'ekihongwa kyakyo eky'ebyokulya, ekihongwa eky'ekyokunywa, ekihongwa eky'okwokya, ekirukurugwamu ekisorrokoko ekirukuboyera MUKAMA nkooku byaragiirwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
