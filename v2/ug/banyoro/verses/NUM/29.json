              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamu n'ekihongwa eky'ebyokulya n'eby'okunywa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.24",
            "verseOrgIds": [
