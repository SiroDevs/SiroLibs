              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekya ikumi na bitaano eky'okwezi okwa musanju, musorrokanege; mutalikora omulimo ogw'amaani. Mumale ebiro musanju nimukorra MUKAMA obugenyi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutambire MUKAMA ekihongwa eky'okwokya ekirukurugwamu ekisorrokoko ekirukumuboyera: nizo enimi ento ikumi na isatu, empaya z'entaama ibiri, ebyana by'entaama ikumi na bbina eby'omwaka gumu ebitanyina kamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekihongwa kyabyo eky'ebyokulya, niyo ensaano enyakuniinuukire kurungi etabwiremu amagita agarukuhikya kiloguraamu isatu ezirukugenda hamu n'enimi, kiloguraamu ibiri ezirukugenda hamu n'empaya ibiri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kiloguraamu emu eyerukugenda hamu n'ebyana by'entaama ikumi na bbina; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'empaya y'emburabuzi emu ey'ekihongwa eky'okuganyiza ebibi ekirukwongerwa ha kihongwa eky'okwokya ekya butoosa, ekihongwa kyakyo eky'ebyokulya n'ekyekyokunywa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        }
