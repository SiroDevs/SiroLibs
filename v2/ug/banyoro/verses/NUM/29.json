                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekya ikumi eky'okwezi okwa musanju oku, musorrokanege kandi mwefubirege, mutalikora omulimo na gumu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu muhongere MUKAMA ekihongwa eky'okwokya ekirukurugwamu ekisorrokoko ekirukuboya, ekihongwa eki; niyo enimi ento emu, empaya y'entaama emu, ebyana by'entaama musanju eby'omwaka gumu; ebirungi mali kandi ebitanyina kamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ekihongwa kyabyo eky'ebyokulya, niyo ensaano enyakuniinuukire enyakutabwire n'amagita, na kiloguraamu isatu, ezirukugenda hamu n'enimi, na kiloguraamu ibiri ezirukugenda hamu n'empaya y'entaama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kiloguraamu emu eyerukugenda hamu n'ebyana by'entaama musanju; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'empaya y'emburabuzi emu ey'ekihongwa eky'okuganyiza ebibi, ebirukwongerwa ha kihongwa eky'okusaba kuganyirwa ebibi, hamu n'ekihongwa kyakyo eky'ebyokulya, n'ebihongwa byabyo eby'ekyokunywa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
        }
      ]
