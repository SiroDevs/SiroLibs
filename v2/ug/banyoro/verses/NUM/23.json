        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yagambira Baraki ati: “Nyombekera hanu amatambiro musanju, ondeetere enimi musanju n'empaya z'entaama musanju.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yakora nkooku Baramu yamuragiire; Baraki na Baramu, ha buliitambiro baahongeraho enimi emu n'empaya emu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yagambira Baraki ati: “Yemerra haihi n'ekihongwa kyawe, nyowe ka ngende; MUKAMA asobora kwija kuntaangaana; kyona eki arandagira ndaakikugambira.” Yagenda ahonaaho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga yaitirana Baramu; Baramu yagambira Ruhanga ati: “Nyombekere amatambiro musanju, ha buli itambiro nahongeraho enimi emu n'empaya y'entaama emu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baramu naasabira Isirairi omugisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Baramu ekigambo, kandi yamuragira ati: “Ogarukeyo hali Baraki, omugambire eki nkugambiire.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yagaruka hali Baraki, yamusanga ayemeriire haihi n'ekihongwa kye, ali hamu n'abalemi aba Mowabbu boona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yatandika orubazo rwe ati: “Baraki omukama owa Mowabbu anyihire Aramu omu nsozi eza Burugaizooba ‘yandeeta’: ‘Ija onkyenere Yakobbo, ija osimuze Isirairi!’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yakaguza Baramu ati: “Kandi obu, onkoliire biha binu? Eki nakuleetiire nukwo kukyeena abanyanzigwa bange, baitu tobakyenere, kandi obasabiire omugisa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yamukaguza ati: “Tikimpikiriire kugamba ebigambo MUKAMA ebi andagira?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yagarukamu Baramu ati: “Ija tugende handi, nambere oraayema kubarora; noija kurora abanyakuli haihi muno; abo nabo, toobarole boona; oku nuho oyeme, obankyeenere.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamutwara omubwerre bw'irungu lya Zofimu, ha mutwe gw'orusozi Piisiga, yayombekayo amatambiro musanju, ha buli itambiro, yahongeraho enimi n'empaya y'entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yagambira Baraki ati: “Yemerra haihi n'ekihongwa kyawe, nyowe ka mbanze ngende nseeri hali ndole MUKAMA.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yarora Baramu kandi yamugambira ekigambo eki araagamba, yamuragira ati: “Garuka hali Baraki omugambire nkooku nkugambiire.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yahikaho Baraki, yamusanga ayemeriire haihi n'ekihongwa kye, ali hamu n'abalimi aba Mowabbu. Baraki yakaguza Baramu ati: “MUKAMA agambire ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yatandika orubazo rwe ati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yagambira Baramu ati: “Hati nu, otakyeena kandi otaha omugisa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yagarukamu Baraki ati: “Tinkugambiirege? Kyona MUKAMA eki agamba, eki nikyo nkora.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yagamba Baramu ati: “Hati ka nkutwale omu kiikaro ekindi rundi ekikiraasemeza Ruhanga, nukwo akwikirize kubankyenera nooyema omu kiikaro eki.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Baraki yatwara Baramu ha mutwe gw'orusozi Pehora orunyakuroleriire irungu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramu yagambira Baraki ati: “Nyombekera hanu amatambiro musanju, ondeetere enimi musanju, n'empaya z'entaama musanju.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki yakora nkooku Baramu yamuragiire, ha buli itambiro yahongeraho enimi n'empaya y'entaama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.30",
            "verseOrgIds": [
              "NUM.23.30"
            ]
          }
        }
      ]
    }
