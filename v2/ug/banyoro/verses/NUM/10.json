              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kasumi Esanduuko y'Endagaano obu yaimukyaga, Musa yagambaga ati: “Ai MUKAMA imuka, abanyanzigwa bawe bararangibwe, kandi abo abanyakukunoba bairuke baruge omumaiso gawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Esanduuko y'Endagaano obu yahuumuraga, Musa yagambaga ati: “Ai MUKAMA, garuka hali enkuyanja n'enkuyanja za Isirairi, iwe anyakugendera ha bicu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        }
