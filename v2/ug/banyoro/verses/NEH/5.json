              "items": [
                {
                  "text": "Bir 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
