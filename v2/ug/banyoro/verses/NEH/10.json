                "loc": "EXO.30.11+EXO.30.12+EXO.30.13+EXO.30.14+EXO.30.15+EXO.30.16"
              },
              "items": [
                {
                  "text": "Kurug 30:11-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitwe nitwija kwecwera kuhaga buli mwaka ekicweka kimu kya kasatu ekya sente eky'okukora omulimo omunju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'okugura omugaati ogw'okuhonga, ekihongwa eky'ebyokulya eky'oruteekerro, ekihongwa eky'okwokya eky'oruteekeero, ebiro bya Sabbato ameezi amahyaka, ebiro ebikuru ebyatairweho, ebintu ebirukwera, ebihongwa eby'okwihaho ebibi eby'okuleherra Isirairi, na habw'omulimo gwona ogw'enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi itwe banyakatagara, Abaleevi, n'abantu abandi, tutiire akaruuru, nukwo tukome enganda eziraasenyaga enku bakaireeta omunju ya Ruhanga waitu buli mwaka ha busumi obwataireho, amaju ga baisenkuruitwe mbere garukwingana, enku ez'okuhemba ha itambiro lya MUKAMA Ruhanga waitu, nkooku kyahandikirwe omu Biragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Kurug 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "34:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "Bir 26:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitwecwera okuleetaga buli mwaka ebijuma eby'okubanza ebi twereze, n'ebijuma eby'okubanza ebindi eby'emiti yoona: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Kurug 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okubireetaga omunju ya Ruhanga, hali banyakatagara abanyakukora omulimo omunju ya Ruhanga, emizigaijo ey'abaana baitu n'ey'ente zaitu, nkooku kyahandiikirwe omu biragiro, emizigaijo ey'abaana baitu n'ey'ente zaitu, nkooku kyahandiikirwe omu biragiro, emizigaijo ey'ente zaitu n'ey'embuzi zaitu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Kubar 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okuleetera omuganuro gwaitu ogw'ebyokulya ebitali birungi, ebihongwa byaitu, ebijuma eby'emiti yoona, eviini, amagita, ebi kubitwarraga banyakatagara kubitwaraga omu bisiika by'enju ya Ruhanga; n'okutwarraga Abaleevi ebicweka by'ikumi eby'ebintu ebi twereze, habwokuba omu mbuga zaitu zoona ez'omu byaro, Abaleevi nubo basoroozamu eby'ikumi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.26"
              },
              "items": [
                {
                  "text": "Kubar 18:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nyakatagara mutabani w'Arooni, araabaga n'Abaleevi abo, obu baraabaga nibaheebwa eby'ikumi; bbo nukwo baleete kimu kya ikumi ha by'ikumi omunju ya Ruhanga, omu bisiika n'omulyahurro. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leevi atwalege ekihongwa eky'ebyokulya, eviini, n'amagita omu bisiika ebinyakurumu ebikwato eby'ekiikaro Ekirukwera, na banyakatagara, abanyakuheerezamu, abalinzi n'abazini. Tutaligarahira enju ya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    }
