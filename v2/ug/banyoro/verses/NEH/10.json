            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Titulisweza bahara baitu abantu ab'ensi enu, rundi kuswererra batabani baitu bahara baabo; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
