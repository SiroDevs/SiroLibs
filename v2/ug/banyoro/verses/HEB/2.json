              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.9",
            "verseOrgIds": [
              "HEB.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga anyakuhanga kandi anyakwikazaaho ebintu byona, obu yagondeze kutaahya abantu baingi omu kitiinisa kye, akaba asemeriire kubanza kuhikiriza ogu ayabaleetiire okujunwa naamurabya omu busaalizi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ogu anyakweza, aina obuzaale bumu n'abo abanyakwezibwa. Nikyo atakwatirwa nsoni kubeeta bagenzi be, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
