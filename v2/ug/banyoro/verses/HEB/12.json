                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Yob 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11"
              },
              "items": [
                {
                  "text": "Nfu 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
