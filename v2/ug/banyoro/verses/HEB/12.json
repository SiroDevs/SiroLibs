                  "text": "Hag 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu nubwo iraka lye lyatengeseze ensi; baitu hati araganiize ati: “Ninyija kugaruka kutengesa ensi; teri nsi yonka, baitu n'iguru.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
