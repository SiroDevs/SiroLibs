            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwegendereze, muleke kwanga kuhuliriza Ruhanga arukubaza. Abaayangire kuhuliriza ogu ayabahabwire ali ha rusozi, obu baliba bataratabukire, kiraasura ki itwe kakuba twanga kuhuliriza anyakuhabura naayema omu iguru? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
