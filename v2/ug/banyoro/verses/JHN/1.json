                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.1"
              },
              "items": [
                {
                  "text": "Luk 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaba haroho omuntu ayatumirwe Ruhanga, ibara lye nuwe Yohaana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.6",
            "verseOrgIds": [
              "JHN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu akaija kuba kaiso ow'okumanyisa eby'omusana, abantu boona nukwo baikirize habwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.7",
            "verseOrgIds": [
              "JHN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe akaba atali musana, baitu akaija kuba kaiso w'eby'omusana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.8",
            "verseOrgIds": [
              "JHN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.8",
            "verseOrgIds": [
              "JHN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusana ogw'amazima ogujwera abantu boona, gukaba nigwija omunsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba ali omunsi, kandi ensi ekahangirwa omuli uwe, baitu nabwo etamumanyirre. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.10",
            "verseOrgIds": [
              "JHN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaija owaabu, kyonka abantu be batamutangirre. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.11",
            "verseOrgIds": [
              "JHN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu boona abaamutangiriire, baamwikiriza akabaha obusobozi obw'okufooka abaana ba Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.12",
            "verseOrgIds": [
              "JHN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nubo abatarazairwe omu buzarranwa bw'omuntu, rundi omu kwegomba kw'omubiri; baitu abaazairwe Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigambo akafooka muntu, yaikara omuli itwe aijwire obwomeezi n'amazima; tukarora ekitiinisa kye, ekitiinisa ekiheebwa Omwana omu wenka owa Isiitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohaana akamumanyisa obu yarangiriire haiguru ati: “Onu nuwe ou nagambireho nti: ‘Arukwija ankuraatiire, nankira ekitiinisa, habwokuba akabaho nyowe ntakabaireho.’” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.15",
            "verseOrgIds": [
              "JHN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwena tukatunga ha mbabazi ze, nituheebwa emigisa etarukubarwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.16",
            "verseOrgIds": [
              "JHN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba Ebiragiro bikaija nibiraba omuli Musa; obwomeezi n'amazima bikaija nibiraba omuli Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.17",
            "verseOrgIds": [
              "JHN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busaho n'omu ararozire Ruhanga, kwihaho Omwana omu wenka anyakumwigamiire, nuwe yamumanyisize abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yohaana Omubatiza ebi yamanyisize hali Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bunu nubwo bwakaiso bwa Yohaana, Abayudaaya obu baamutumireho banyakatagara n'Abaleevi abaarugire Yerusaalemu kumukaguza bati: “Niiwe oha?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.19",
            "verseOrgIds": [
              "JHN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaatura, ataculeere, baitu akaatura bbwa ati: “Nyowe tindi Kristo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.20",
            "verseOrgIds": [
              "JHN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.5"
              },
              "items": [
                {
                  "text": "Mara 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.15"
              },
              "items": [
                {
                  "text": "Bir 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.48.10"
              },
              "items": [
                {
                  "text": "Sir 48:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.48.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamukaguza bati: “Kandi si niiwe oha? Niiwe Eriya?” Yabagarukamu ati: “Tindi ogu.” Nandiki bbo bati: “Niiwe murangi oli?” Yabagarukamu ati: “Nangwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayongera kumukaguza bati: “Niiwe oha? Tugarukemu, otugambire eki turaamanyisa abo abatutumire. Nooyeyeta oha?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.22",
            "verseOrgIds": [
              "JHN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Is 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo Yohaana kubagarukamu ati: “Ninyowe ogu arukwamirra omwirungu nti: ‘Muterekereze omuhanda gwa MUKAMA’, omurangi Isaaya nkooku yarangire.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abakaba batumirwe Abafalisaayo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.24",
            "verseOrgIds": [
              "JHN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "baamukaguza bati: “Kandi habwaki noobatiza obu oraaba otali Kristo, rundi Eriya, rundi omurangi oli?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.25",
            "verseOrgIds": [
              "JHN.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohaana yabagarukamu ati: “Nyowe nimbatiza n'amaizi, baitu omuli inywe heemeriiremu ou mutarukumanya; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.26",
            "verseOrgIds": [
              "JHN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuwe ogu arukunnyija enyuma, kandi tinsemeriire kusuumurra orukoba rw'enkaito ze.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.27",
            "verseOrgIds": [
              "JHN.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi bikabaho Betaniya, nseeri y'ekisaaru Yorudaani, nambere Yohaana akaba naabatiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwana gw'entaama wa Ruhanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekyakurasireho, Yohaana akarora Yesu namwizira, yagamba ati: “Murole Omwana gw'entaama wa Ruhanga, murole anyakwihaho abantu ebibi! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.29",
            "verseOrgIds": [
              "JHN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu nuwe ou nagambireho nti: ‘Haroho arukunnyija enyuma, arukunkira ekitiinisa, habwokuba akabaho nyowe ntakabaireho.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.30",
            "verseOrgIds": [
              "JHN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyowe nyenka nkaba ntamumanyire; baitu nikyo naiziire nimbatiza n'amaizi, nukwo amanyisibwe Isirairi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.31",
            "verseOrgIds": [
              "JHN.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohaana akagumya naagamba ati: “Nkarora Mwoyo Ahikiriire naasirimuka naaruga omwiguru omu kisisani ky'eriiba, yamwikaraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.32",
            "verseOrgIds": [
              "JHN.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyowe nyenka nkaba ntarukumumanya; baitu Ogu ayantumire kubatiza n'amaizi, nuwe yangambiire ati: ‘Ogu ou oraarora Mwoyo naamusirimukaho naamwikaraho, nuwe abatiza na Mwoyo Ahikiriire.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.33",
            "verseOrgIds": [
              "JHN.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nkakirora kandi naagumya nti: Ogu nuwe Mwana wa Ruhanga.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abeegesebwa ba Yesu ab'okubanza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekyakurasireho, Yohaana akaba ayemeriire na babiri ha beegesebwa be; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.35",
            "verseOrgIds": [
              "JHN.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "obu yarozire Yesu naahingura, yabagambira ati: “Murole Omwana gw'entaama wa Ruhanga!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.36",
            "verseOrgIds": [
              "JHN.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegesebwa ababiri bakamuhurra naagamba eki, nukwo kuhondera Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.37",
            "verseOrgIds": [
              "JHN.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe yakubutuka, yabarora bamuhondiire, yabakaguza ati: “Nimuserra ki?” Baamugarukamu bati: “Rabbi” (amakuru gaakyo ngu, Mwegesa). “Nooraara nkaha?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabagarukamu ati: “Mwije muroleyo.” Baagenda baarora nambere yaraaraga, baraara nawe ekiro eki, habwokuba esaaha zikaba ziri nka ikumi eza rwebagyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ha babiri abaahuliire Yohaana ebi yagambire kandi bahondera Yesu, nuwe Andereya, mugenzi wa Simooni Petero. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.40",
            "verseOrgIds": [
              "JHN.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andereya akabanza kuhikaho mukuru we Simooni, yamugambira ati: “Turozire Mesiya” (amakuru gaakyo ngu, Kristo.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.41",
            "verseOrgIds": [
              "JHN.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamuhikya hali Yesu. Yesu yamugumyaho amaiso, yagamba ati: “Niiwe Simooni mutabani wa Yohaana? Oraayetwaga Keefa” (amakuru gaakyo ngu, Petero rundi mwandara).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naayeta Filipo na Nasanairi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro ekyakurasireho, Yesu obu yamazire kucwamu kugenda Galiraaya, yatangaana Filipo, yamugambira ati: “Mpondera.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo akaba ali wa Betisaida, ekyaro ky'owaabu Andereya na Petero. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.44",
            "verseOrgIds": [
              "JHN.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo yatangaana Nasanairi yamugambira ati: “Turozire ogu Musa ou yahandiikireho omu Biragiro, kandi abarangi ou baarangire. Nuwe Yesu owa Nazareeti, mutabani wa Yosefu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.45",
            "verseOrgIds": [
              "JHN.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo Nasanairi kumukaguza ati: “Nazareeti esobora kurugwamu ekintu ekirungi?” Filipo yamugarukamu ati: “Ija oyerorre.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu obu yarozire Nasanairi naija nambere ali, yamugambaho ati: “Dora Omunyaisirairi mali ataina bugobya!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasanairi yamukaguza ati: “Wammanya ota?” Nandiki Yesu ati: “Filipo obu abaire atakakwesire, nkurozirege oli hansi y'omutini.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasanairi yamugarukamu ati: “Mwegesa, niiwe Mwana wa Ruhanga! Niiwe Mukama wa Isirairi!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.49",
            "verseOrgIds": [
              "JHN.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandiki Yesu ati: “Habw'okukugambira nti: Nkurozirege hansi y'omutini, nikyo oikiririize? Baitu olirora ebikuru ebirukukira binu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.12"
              },
              "items": [
                {
                  "text": "Kub 28:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yayongera ati: “Mazimakwo ninkugambira nti: Olirora iguru likingwirwe na bamalaika ba Ruhanga nibatembera kandi nibasirimukira ha Mwana w'omuntu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.51",
            "verseOrgIds": [
              "JHN.1.51"
            ]
          }
        }
      ]
    }
  ],
