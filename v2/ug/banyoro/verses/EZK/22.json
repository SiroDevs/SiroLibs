          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abalemi ba Isirairi abanyakuli omuli iwe, omutima gwabo gwona gubali ha kuseesa esagama nkooku barukusobora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.6",
            "verseOrgIds": [
              "EZK.22.6"
            ]
          }
        },
