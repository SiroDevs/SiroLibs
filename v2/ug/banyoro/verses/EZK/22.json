              "type": "text"
            }
          ]
        },
        {
          "text": "Baise-baana na banyina-baana abanyakuli omuli iwe nibagaywa; omunyaihanga naanyagwa na iwe oroleriire; enfuuzi n'enfaakati niikorwa kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.7",
            "verseOrgIds": [
              "EZK.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
