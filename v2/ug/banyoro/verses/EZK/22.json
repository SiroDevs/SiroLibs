            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga naagamba ati: Omuli iwe harumu abantu abanyakulya enguzi nukwo baseese baite abantu; ogonza kandi oihaho abataahi ebintu ebingi n'amagoba noobanyaga ebyabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikyo ndukuhuniririrra habw'amagoba agatali g'amananu agawatungire, na habw'esagama eyaseesekere omuli iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.13",
            "verseOrgIds": [
              "EZK.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki ndikweteraho kutongana, oliguma, oliba n'amaani? Nyowe MUKAMA, eki ninyowe nkigambire, kandi ndikikora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikutaabaaniza omu mahanga, ndikurarangya omunsi yoona, nukwo nkumalemu obubi bwawe obu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nubwo olimanya nkooku ndi MUKAMA.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
            "verseOrgIds": [
              "EZK.22.16"
            ]
          }
        }
      ]
    },
    {
