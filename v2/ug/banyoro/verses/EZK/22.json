              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okagaya ebintu byange ebirukwera, n'ekiro kyange ekya Sabbato tokitamu kitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
              "EZK.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli iwe munu, harumu abantu abarukuhangirra abandi nukwo babaise harumu abantu abanyakuliira hansozi; abanyakukora eby'orwanju obataireho eriiso ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
              "EZK.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.7+LEV.18.8+LEV.18.9+LEV.18.10+LEV.18.11+LEV.18.12+LEV.18.13+LEV.18.14+LEV.18.15+LEV.18.16+LEV.18.17+LEV.18.18+LEV.18.19+LEV.18.20"
              },
              "items": [
                {
                  "text": "Lev 18:7-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harumu abasaija abanyakusiihana na bakaiisebo; harumu abasaija abanyakuhambiriza abakazi abanyakuli omu kwezi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
              "EZK.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu omu asiihana na muk'omutaahi ou aherraine nawe; ondi asiihana na mukamwana; ondi asiihana na munyanya, kizaarwa ise. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.11",
            "verseOrgIds": [
              "EZK.22.11"
            ]
          }
        },
