            "style": "v",
            "sid": "EZK 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.5",
            "verseOrgIds": [
              "EZK.22.5"
            ]
          }
        },
        {
