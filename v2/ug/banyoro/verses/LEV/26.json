          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nibyo bigambo Ruhanga ebi yaragiire, n'ebiragiro ebi yateeriireho abantu ba Isirairi ebiyaragiire Musa ha rusozi Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
