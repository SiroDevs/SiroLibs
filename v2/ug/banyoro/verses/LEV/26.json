              "attrs": {
                "loc": "DEU.28.15+DEU.28.16+DEU.28.17+DEU.28.18+DEU.28.19+DEU.28.20+DEU.28.21+DEU.28.22+DEU.28.23+DEU.28.24+DEU.28.25+DEU.28.26+DEU.28.27+DEU.28.28+DEU.28.29+DEU.28.30+DEU.28.31+DEU.28.32+DEU.28.33+DEU.28.34+DEU.28.35+DEU.28.36+DEU.28.37+DEU.28.38+DEU.28.39+DEU.28.40+DEU.28.41+DEU.28.42+DEU.28.43+DEU.28.44+DEU.28.45+DEU.28.46+DEU.28.47+DEU.28.48+DEU.28.49+DEU.28.50+DEU.28.51+DEU.28.52+DEU.28.53+DEU.28.54+DEU.28.55+DEU.28.56+DEU.28.57+DEU.28.58+DEU.28.59+DEU.28.60+DEU.28.61+DEU.28.62+DEU.28.63+DEU.28.64+DEU.28.65+DEU.28.66+DEU.28.67+DEU.28.68"
              },
