              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutalyekorra ebisisani eby'okuramya, mutalyekorra ekisisani ekisarwirwe rundi kwemereza ibaale lyona eriri omunsi yanyu, habwokuba ninyowe MUKAMA Ruhanga wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musemezeege ekiro kyange ekya Sabbato, kandi ekiikaro kyange ekirukwera, mukitemuga ekitiinisa: Ninyowe MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
