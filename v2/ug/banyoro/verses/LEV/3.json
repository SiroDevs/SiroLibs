          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bibe kyokulya ekyokeze, kirugwemu ekisorokoko ekirukuboya kurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
