          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihongwa kye kakuba eba mbuzi, agihonge omumaiso ga MUKAMA, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
          "name": "verse",
