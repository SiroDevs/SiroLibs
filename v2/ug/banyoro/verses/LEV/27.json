            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.14"
              },
              "items": [
                {
                  "text": "Kubar 18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Busaho kintu na kimu ekyasoroirwe kyahongerwa MUKAMA ekisemeriire kuguzibwa rundi kucungurwa, abe muntu, kibe kisoro rundi itaka eryagwesirwe; ekintu kyona ekihairwe MUKAMA, kiba kintu ekirukukirra kimu kwera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busaho muntu ayayeziibwe ati, asemeriire kucungurwa; ogu aitwege.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
