            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.22+NUM.6.23+NUM.6.24+NUM.6.25+NUM.6.26"
              },
              "items": [
                {
                  "text": "Kubar 6:22-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arooni obu yamazire kuhonga ekihongwa eky'okuganyiza, ekihongwa eky'okwokya n'ekihongwa habw'okusaba obusinge, aho yaimukiza abantu emikono, yabasabira omugisa, yarugaho yagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Arooni baagenda omu Heema ey'okutangatanganiramu, kandi obu baarugiremu, baasabira abantu omugisa, abantu baarora ekitiinisa kya MUKAMA nikyangasana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurro gwaruga omumaiso ga MUKAMA, gwasiriiriza kimu ekihongwa eky'okwokya n'ebisajwa ebikaba biri ha itambiro, abantu boona obu baarozire eki, baayamuza, baajuumara hansi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
