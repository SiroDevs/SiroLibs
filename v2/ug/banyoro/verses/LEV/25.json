              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ha rusozi Sinai ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gambira abantu ba Isirairi ngu: Obu mulihika omunsi ei ndukwija kubaha, itaka libe na Sabbato ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulimara emyaka mukaaga nimulima emisiri, nimubyara engonjo, kandi emyaka egi mukaaga, muligimara nimwombera, nimusarra engonjo ez'emizaabbibbu, nimunoga ebijuma kandi nimuhunika ebi mwereze; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu omwaka ogwa musanju, gubege Sabbato ya MUKAMA, itaka lyona lihuumule; omwaka ogu, mutaligubyarramu rundi kusarra engonjo zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiryemeza byonka mumazire kugesa, mutalibigesa, n'ebijuma by'emizaabbibbu etasaliirwe, mutalibinoga; guraabaga mwaka gw'itaka lyona kuhuumura. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabbato ey'itaka niyo eraabahaga ebyokulya, inywe inywenka, abairu baanyu n'abazaana, abakozi baanyu abakorra empeera n'abanyamahanga abarukwikara na inywe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi eraahaga ebyokulya ente zanyu n'ebisoro byona ebinyakuli omunsi yanyu, byona itaka ebi liraamezaaga, mubiryege.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omwaka ogw'okugarra buhyaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mubalege Sabbato ey'emyaka musanju, nukwo kugamba emyaka musanju emirundi musanju, egi niyo myaka ana na mwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekya ikumi eky'okwezi kwa musanju, ekiro eky'okwereherra, muteere engwara ihulirwe omunsi yanyu yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musemezeege omwaka ogw'amakumi ataano, murangirre abantu boona nkooku guli mwaka gw'obusinge; guraabaaga mwaka gwanyu ogw'okujaguza. Buli omu omuli inywe, nubwo araasoboraga kugaruka omunsi ei yaihirwemu rundi omu ruganda rwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwaka ogw'amakumi ataano ogu, guraabaga gw'okujaguza kwanyu, mutaligubyarramu, noobukwakuba kugesa ebinyakwemereze byonka rundi kunoga ebijuma by'emizaabbibbu etasaliirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba guraabaga mwaka ogurukwera, mulyege ebi gumereze omu misiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu mwaka ogu, buli muntu agarukege owaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba oguza rundi oguraho mutaahi wawe ekibanja, muleke kugobezangana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusasule noororra ha myaka eyakahinguraho ekijaguzo kimazire kuhwa, na uwe akuguzeege naarorra ha birimwa ebya buli mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka obu eraaba eri nyingi, oyongere omuhendo gw'ensimbi, obu eraaba eri nke, ogukeehye, habwokuba eki arukukuguza nibyo ebirimwa ebya buli mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleke kugobezangana, kyonka mutiine nyowe Ruhanga wanyu; habwokuba ninyowe MUKAMA Ruhanga wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, mukwatege ebiragiro byange, mukuraatire n'ebigambo kandi mukole ebibirukuragira; nubwo muliikara omunsi n'obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi eribeereza ebyokulya, mulirya mwigute nukwo mugiikalemu n'obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba mwekaguza muti: ‘Obu turaaba tutarukusiga kandi tutarukugesa, tulirya ki omu mwaka ogwa musanju?’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibaha omugisa omu mwaka ogwa mukaaga, gubeereze ebyokulya ebi mulirya okumara emyaka esatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu muliba nimusiga omu mwaka ogwa munaana, muraalyaga ebyokulya eby'emyaka ey'enyuma; okuhika omu mwaka ogwa mwenda, ebyalimirwe omu mwaka ogu, obu birigeswa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itaka muleke kuliguliza kimu, habwokuba lyange; inywe muli banyamahanga kandi nsuuhuuki abanyebingire. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, omunsi egi yoona ei mwatungire, mwikirizeege itaka licungurwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kakuba owanyoko aseega akaguza itaka lye mugenzi we arukumukurata, itaka eri alicungule. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu kitunda, obu araaba ataina muntu ondi arukusobora kucungura itaka eri, uwe wenka ali munaku, hanyuma akatunga eby'okulicungura, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "abale emyaka eyakahinguraho, okuruga obu yaligulize, nukwo asasule kigura emyaka ey'omumaiso; itaka lye alyegarurre. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu kakuba alemwa kulicungura, atalyegarurra, alireke, liikale liri ly'oli ayaliguzire, okuhika omwaka gw'okujaguza obu gulikahika; omu mwaka ogu, ayaliguzire aliba atakyaliinaho busobozi, nubwo mukama walyo alyegarurre. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba omuntu atunda enju erukuraarwamu, enyakuli omu rubuga orunyakuzitiirwe, asobora kugicungura omwaka gumu gutakahoireho okuruga ha mwaka ogu yagitundiireho; omu mwaka ogu gwona, naaba anyina obugabe obw'okugicungura. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.29",
            "verseOrgIds": [
              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba etacungurwa omu mwaka ogu gwona, obu enju egi ebiro byona erigumibwa nkooku eri y'ogu kigigura; terimwihwaho omu mwaka gw'okujaguza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu amaju aganyakuli omu byaro ebitazitiirwe, garaabarwaga nk'agombekerwe omu bwerre, gasobora kucungurwa kandi gasobora kugarulirwa bakama baago omu mwaka ogw'okujaguza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Abaleevi omu mwaka ogw'okujaguza, nibasobora kucungura amaju aganyakuli omu mbuga zaabu ezi barukulema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Omuleevi kakuba atacungura enju ye omu rubuga nk'oru, nubwo enju eyaguzirwe eyekaba eri omu rubuga rwabo neesobora kugarulirwa Omuleevi mukama wayo omu mwaka gw'okujaguza; habwokuba amaju goona agaraabaga omu mbuga ezinyakuli omwitaka Abaleevi eri baahairwe omu Isirairi, garaabaga gaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu itaka kwonka ery'embuga zaabu litagurwe; habwokuba butaka bwabo obw'ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
