              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ganu nugo magenyi ga MUKAMA agatairweho, nugo muraayesoroolezaahoga kuramya, aga mulirangirra omu kasumi aka gaateerirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
