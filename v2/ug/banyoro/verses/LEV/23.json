                "loc": "EXO.35.2"
              },
              "items": [
                {
                  "text": "35:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Bir 5:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukolege emirimo omu biro mukaaga; baitu ekiro ekya musanju kiro ky'okuhuumura, musorrokanege muramye, mutalikisura mukakora omulimo ha kiro eki; egi eba Sabbato ya MUKAMA, hoona ha muraakabaga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
    },
    {
