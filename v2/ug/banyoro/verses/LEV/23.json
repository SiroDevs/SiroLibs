          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gambira abantu ba Isirairi oti: Ekiro kibanza eky'okwezi kwa musanju, mukitemuga ekitiinisa, kibe kiro ky'okuhuumura, muraakiijukibwaga iraka ly'engwara, ey'erukubeeta kuramya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalikora mulimo gw'amaani; muleetere MUKAMA ekihongwa eky'okwokya.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        }
      ]
