{
  "id": "MAT.28",
  "number": "28",
  "bookId": "MAT",
  "reference": "Mat 28",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
