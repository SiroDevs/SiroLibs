              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyakatagara abakuru n'Abafalisaayo obu baahuliire enganikyo ze, baamanya nkooku bali nubo arukugambaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu baagondeze kumukwata, baatiina enkuyanja y'abantu, habwokuba baamwetaga murangi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
