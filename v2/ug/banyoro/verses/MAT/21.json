            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba Yohaana Omubatiza akaija hali inywe naabooleka omuhanda ogu musemeriire kurabamu, mutamwikirize; baitu abasorooza b'omusoro n'abamalaaya bbo bakamwikiriza. Inywe noobu mwarozire eki, nabwo muteegarukemu mukamwikiriza.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruganikyo rw'abakozi ababi omu rugonjo rw'emizaabbibbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
