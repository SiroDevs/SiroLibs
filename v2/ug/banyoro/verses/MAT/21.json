              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yabagambira ati: “Timukasomaga Ekyahandiikirwe ekirukugamba kiti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
