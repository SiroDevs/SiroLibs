    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekiro eky'okwija kwa MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ow'amahe naagamba ati, ekiro ekituumiire kimu nk'ekyoto nikiija, obu kirihika, abeekuliiriza boona hamu n'enkozi z'ebibi zoona, balisisana nk'ebisunga; MUKAMA ow'amahe naagamba ati, ekiro eki ekiriija, kirisiiriiriza kimu embuba ezi, nukwo haleme kusigaraho ekikoro rundi akababi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu inywe abanyakumpurra, obusobozi bwange obunyakujuna oburukusisana nk'izoba, bulibahikaho, bubatambire nk'amaranga g'izooba. Muliba n'obusinge kandi mulisemererwa muno nk'enyana ezinyakwihirwe omu kihongole. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA ow'amahe naagamba ati, ha kiro eki obu ndyoleka obusobozi bwange mulirubaatirra ababi, omumaiso balisisana nk'ecuucu hansi y'ebigere byanyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
