        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwijukege ebiragiro by'omwiru wange Musa, n'ebigambo ebi namugambiriire ha rusozi Holebu, nti bikwatwege Isirairi yoona.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        }
