          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebi, obirangirre. Kandi oteererre abantu baawe noohana n'obusobozi bwona. Otaikiriza muntu n'omu kukugaya.",
          "type": "text",
          "attrs": {
