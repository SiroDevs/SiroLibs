                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayayehaireyo habwaitu okutucungura, naatwiha omu bubi bwona kandi naayeyereza abantu be, nubo abo abeekambira okukora ebirungi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
