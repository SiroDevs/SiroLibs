              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izooba obu likaba nirirenga, Abburamu yagwijagira oturo twingi; omwirima kasira ogurukutiinisa gwamusweka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
