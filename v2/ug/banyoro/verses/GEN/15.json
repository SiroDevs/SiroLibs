              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izooba obu likaba limazire kugwa, obwire buteeraine, haazooka ebintu bibiri: oruswa rw'omurro orukaba nirucuukwaho omwika, n'ekimuli ekirukwaka, byaraba hagati y'ensinga ez'ebisoro biri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Ebik 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, nubwo MUKAMA yakozire endagaano n'Abburamu naagamba ati: “Ensi enu ndigiha baijukuru bawe, okuruga ha kisaaru kya Misiri okuhika ha kisaaru ekikooto, nikyo ekisaaru Efuraate, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ensi ey'Abakeeni, Abakenezi, Abakadenoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.19",
            "verseOrgIds": [
              "GEN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahiiti, Abaperezi, Abalefaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.20",
            "verseOrgIds": [
              "GEN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamooli, Abakanaani, Abagirigasi, n'Abayebusi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.21",
            "verseOrgIds": [
              "GEN.15.21"
            ]
          }
        }
      ]
