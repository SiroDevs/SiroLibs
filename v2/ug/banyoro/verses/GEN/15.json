          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.1+EXO.1.2+EXO.1.3+EXO.1.4+EXO.1.5+EXO.1.6+EXO.1.7+EXO.1.8+EXO.1.9+EXO.1.10+EXO.1.11+EXO.1.12+EXO.1.13+EXO.1.14"
              },
              "items": [
                {
                  "text": "Kurug 1:1-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.6"
              },
              "items": [
                {
                  "text": "Ebik 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo MUKAMA Ruhanga yamugambira ati: “Manyira kimu, baijukuru bawe nkooku baliba baikazi omunsi etali y'owabu, baliba bairu omunsi egi, balikorwa kubi kumara akasumi ak'emyaka ebikumi bbina; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Kurug 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.7"
              },
              "items": [
                {
                  "text": "Ebik 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu ihanga erinyakubatungire ndirifubira, hanyuma baliruga omunsi egi banyina ebintu bingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu iwe olifa n'obusinge, okurate baaswenkuru; olifa ogurusire muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaijukuru bawe ab'enyakana baligaruka omunsi enu; habwokuba obubi bw'Abamooli tibukahoire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
