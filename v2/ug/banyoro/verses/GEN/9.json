              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga akanyise Yafeesi, aikalege omu heema za Seemu; Kanaani abege mwiru we.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.27",
            "verseOrgIds": [
              "GEN.9.27"
            ]
