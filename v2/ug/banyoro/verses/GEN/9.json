              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuruga ha kusandaara kw'amaizi, Noha akongera yayomeera emyaka endi bikumi bisatu n'ataano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.28",
