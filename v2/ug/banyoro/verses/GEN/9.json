            }
          ]
        },
        {
          "text": "Yayongera yagamba ati: “MUKAMA Ruhanga wange ahe Seemu omugisa; Kanaani abege mwiru we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.26",
