                {
                  "text": "2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu obu baatandikire kukanya omunsi; bakazaara abaana baisiki, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu ba Ruhanga obu baarozire abaisiki abo bali barungi, baayeswerra baingi omuli bo nkooku baagondeze. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo MUKAMA Ruhanga yagamba ati: “Omwoyo gwange ogunyakwomeeza, tiguliikara omu muntu ebiro byona, habwokuba omuntu w'okumara akacu kake, araayomeeraga emyaka kikumi n'amakumi abiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Kubar 13:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.16.7"
              },
              "items": [
                {
                  "text": "Sir 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "BAR.3.26"
              },
              "items": [
                {
                  "text": "Baru 3:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebi, abantu ba Ruhanga obu baateeraine na bahara b'abantu, baabazaraho abaana, omunsi haabamu abantu emanzi. Abo, nubo baabaire bantu b'amaani aba ira, bakaba bali bantu barangaanwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
