          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA obu yamazire kubaza n'Abburahamu, yagenda kandi n'Abburahamu yagaruka owaabo.",
          "type": "text",
          "attrs": {
