              },
              "items": [
                {
                  "text": "Ebik 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobbo obu yamazire kuteererra abatabani, yahinya amaguru ge, yagata ha kitabu kye, yakaba yakurata baisenkuru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
