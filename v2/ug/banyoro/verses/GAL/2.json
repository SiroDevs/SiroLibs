            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "Ebik 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi obu haahingwireho emyaka ikumi n'ena, nkagaruka Yerusaalemu hamu na Baranaba, naatwara na Tito. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyantwaireyo nukwo kusuukururwa, nasoborra abakwenda Amakuru Amarungi aga ndangirra Abanyamahanga (nagasoborra omu nsita kandi omu maiso g'abo abakaba bali baarangaanwa muli bo) ntaikara kuba nk'arukwirukira busa rundi ayairukiire busa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na Tito ou nkaba nyinawe, atahambirizibwe kusarwa noobwakubaire yali Mugiriiki. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu eky'okusarwa kikaleetwa bagenzi baitu ab'ebisuba abaatutaahiremu tutamanyire, batate obugabe bwaitu obu twina omu Kristo Yesu, nukwo batugarre omu bwiru. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo tutaboorobere naakake konka, nukwo amazima g'Amakuru Amarungi gasobole kulindwa habwanyu gatahindukire.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Bir 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hali abo abakaba bali baarangaanwa omuli bo, (okurangaanwa kwabu oku nyowe ntakufeeho, habwokuba Ruhanga tasoroora) ningamba nti: Abo abakaba nibarangaanwa muli bo tibaina eki baayongiireho kumpabura. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimu kyonka bakamara kwetegereza nkooku nakwasiibwe Amakuru Amarungi kugarangirra abatasazirwe, nka Petero oku yagakwasiibwe habw'abasazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ningira ogu ayasoboize Petero okuhikya obukwenda ha basazirwe, nuwe yasoboize nyowe kubuhikya ha Banyamahanga.) ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobbo, Keefa, na Yohaana abakaba bamanyirwe nkooku bali nyomyo z'ekitebe, obu baayetegeriize omugisa ogu nahairwe, bakaikirraniza na nyowe nibagamba ngu, itwe na Baranaba tugende omu Banyamahanga, kandi bbo bagende omu basazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonka eki baatuteeriire nukwo kwijuka abanaku, eki na nyowe nikyo natahoga omutima kukora.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo naahabura Petero bali Antyokiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Keefa obu yahikire Antyokiya nkamuhakaniza nimmugambira burole, habwokuba akazooka asobeze muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abamu abaatumirwe Yakobbo obu bakaba batakaizire, uwe yalyaga n'Abanyamahanga. Baitu obu bamazire kwija, yayehinya, yabeecwaho habw'okutiina ab'ekitebe ky'abasazirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya abandi nabo bakahondera obucwangya bwe; nangwa na Baranaba yabagenderamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu naboine batarukugendera ha mazima ag'Amakuru Amarungi, nagambira Keefa omumaiso g'abo boona nti: “Baitu iwe Omuyudaaya, obu oraaba noohondera engeso z'Abanyamahanga otarukukora nk'Omuyudaaya, osobora ota kuhambiriza Abanyamahanga kuhondera engeso ez'Abayudaaya?”",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abantu boona bajunwa habw'okwikiriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwe abaasazirwe, tuli Bayudaaya nyakabara, tituli Banyamahanga abasiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Zab 143:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.20"
              },
              "items": [
                {
                  "text": "Bar 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.22"
              },
              "items": [
                {
                  "text": "Bar 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi tumanyire omuntu nkooku atahikirizibwa kworobera Ebiragiro, baitu ahikirizibwa okwikiriza Yesu Kristo; kandi na itwe tukaikiriza Yesu Kristo, nukwo tuhikirizibwe Ruhanga habw'okwikiriza Kristo, hatali kworobera Ebiragiro. Ningira busaho muntu alihikirizibwa okworobera Ebiragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangwa na itwe noobu turaaba nitwekambira okuhikirra habw'okwikiriza Kristo, nabwo tukyali basiisi. Nukwo kugamba ngu, Kristo nuwe muleesi w'ebibi? Nikikafuuhe! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe kakuba ningaruka hati kwombeka ebi naseesire ira, buli ninkigumya nkooku nkaba ncwire Ebiragiro. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba omu Biragiro nkaba nfiire; gamba Ebiragiro nibyo byanyisire, nukwo nyongere nyomeere hali Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabambwa ha musaraba hamu na Kristo; takyali nyowe arukwomeera, baitu Kristo nuwe arukwomerra omuli nyowe. Kandi obwomeezi obu nyinabwo hati omu mubiri, nyinabwo habw'okwikiriza Omwana wa Ruhanga ayangondeze kandi yayehayo habwange. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindukwija kunagaija mbabazi za Ruhanga; habwokuba obuhikiriire obu buliba bwarabire omu Biragiro, buli Kristo akafeera busa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
  ],
