        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo naikirizibwa abakwenda abandi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
