      },
      "items": [
        {
          "text": "Okufa kw'Ahabbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Ahabbu owa Isirairi na Yehosafaati owa Yuda baagenda kuramagira Ramosi-Giryadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama wa Isirairi yagambira Yehosafaati ati, “ninyija kwehindura, nukwo ngende ha bulemu, baitu iwe ojwale ebyokujwara byawe eby'obukama.” Omukama wa Isirairi yayehindura; baagenda ha bulemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama wa Siriya akaba ateereriire engabwa ez'abatembi b'ebigaali bye ati, “Mutarwansia omuntu n'omu, omuto rundi omukuru, murwanise omukama wa Isirairi wenka.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatembi b'ebigaali obu baaboine Yehosafaati, baagira nuwe omukama wa Isirairi. Nukwo kukubutuka bamurwanise; Yehosofaati yayamuza, MUKAMA yamukonyera, yabamujuna; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "engabwa z'ebigaali obu zaaboine nkooku atali mukama wa Isirairi, baaleka kumwirukya, baagaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omusirikale omu Siriya yamara garasa, omusogi gwateera omukama wa Isirairi hagati y'ebijwaro bye eby'okurwanisa n'ekya ha kifuba; nukwo kugambira omuvugi w'ekigaali ati, “Kubuutuka onyihe omu bulemu, habwokuba mputaire.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro eki, obulemu bwasarra, omukama wa Isirairi, yayetengeneka omu kigaali, yaikara aroleriire Abasiriya okuhika orwebagyo muno; izooba obu likaba niritobera, yafa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
      ]
    }
