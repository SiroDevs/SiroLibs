        },
        {
          "text": "Akataho n'okwemera omukama Nebbukadaneeza ayamurahiize Ruhanga; yagumangana yakadadaza omutima, yayanga kugaruka hali MUKAMA Ruhanga owa Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyakatagara abakuru boona, oteho n'abantu, bakabulirwa kimu obwesige, baayetaho ebintu eby'ensoni byona ebyakorwaga amahanga, kandi baasiisa Enju ya MUKAMA ei akaba ayeyeriize Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA Ruhanga owa baisenkurubo, akabatumira abakwenda be obutalekerra, habwokuba, akaba naaganyira abantu b'Enju ye; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu bo, baikara nibasekereza abakwenda ba Ruhanga, nibagaya ebigambo bye, kandi nibagaaniiza",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:16",
              "type": "text"
            },
            {
              "text": "nibaganiza kujejeemya",
              "type": "text"
            }
          ]
        },
        {
          "text": " abarangi be, okuhika MUKAMA obu yakabiihirwe muno, haabura omubazi ogw'okufukyafukya ekiniga eki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        }
      ]
    },
