              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owanyina Eliakimu, nuwe yafoora mukama wa Yuda na Yerusaalemu, ibara lye yalihindura yamweta Yehoyakimu; Neko akakwata Yehoyahazi owanyina yamutwara Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
