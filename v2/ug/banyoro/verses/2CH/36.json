            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogw'okubanza ogw'omukama Kuuro, ekigambo MUKAMA eki yagambisize Yeremiya nukwo kihikirre, akatamu Sirasi omukama wa Paasa omwoyo, yaturukya ekirangirro omu bukama bwe bwona, kandi yakita n'omu buhandiiki naagamba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Is 44:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuuro omukama wa Paasa naagamba ati, ‘MUKAMA Ruhanga ow'iguru, ampaire obukama bwona obw'ensi kandi andagiire kumwombekera Enju omu kiikaro Yerusaalemu, ekinyakuli omunsi ya Yuda. Wena anyakuli omuli inywe ha bantu be boona, Mukama Ruhanga we aikale na uwe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
