        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri akazaara Ludimu, Anamimu, Lehabimu, Nafutuhimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasirusimu, Kasiruhimu, (ogu nuwe yarugirwemu Abafirisiti); na Kafutolimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
