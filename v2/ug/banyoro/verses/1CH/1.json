              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Seemu:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.17",
            "verseOrgIds": [
              "1CH.1.17"
            ]
          }
        }
