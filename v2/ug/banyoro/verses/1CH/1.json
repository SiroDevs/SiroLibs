              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu hakaba hatakabaireho mukama n'omu, ayalemere Abaisirairi, abo nubo abakama, abaalemere omunsi y'Edomu: Beera mutabani wa Behora, mukama w'orubuga orwayetwaga Dinihabba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.43",
            "verseOrgIds": [
              "1CH.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beera obu yatuulize, Yobbabbu mutabani wa Zeera yateera engoma omukiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.44",
            "verseOrgIds": [
              "1CH.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobbabbu obu yatuulize, Husamu ow'omunsi ey'Abatemaani, yateera engoma omukiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.45",
            "verseOrgIds": [
              "1CH.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Husamu obuyatuulize, Hadadi mutabani wa Bbedadi, ayasingwire Abamidiani abakaba bali omunsi Mowabbu, ibara ly'orubuga rwe nurwo Avisi yateera engoma omukiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.46",
            "verseOrgIds": [
              "1CH.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi obu yatuulize, Samura owa Masireka, yateera engoma omu kiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.47",
            "verseOrgIds": [
              "1CH.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samula obu yatuulize, Saulo owa Rrehobboosi ow'akaba ali ha kisaaru Efuraate, yateera engoma omu kiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.48",
            "verseOrgIds": [
              "1CH.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sahura obu yatulize, Bbaalihanani mutabani w'Akibbora, yateera engoma omu kiikaro kye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.49",
            "verseOrgIds": [
              "1CH.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bbaali-hanani obu yatuulize, Hadadi yateera engoma omukiikaro kye; ibara ly'orubuga rwe, nurwo Pai, kandi ibara lya mukazi we, nuwe Mehetabbeeri, muhara wa Matireedi, mwijukuru wa Mezahaabbu. Hadadi yafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.50",
            "verseOrgIds": [
              "1CH.1.50"
            ]
          }
        }
      ]
    },
    {
