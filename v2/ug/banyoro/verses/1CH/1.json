        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaani akazaara Sidoni, nugwo omuzigaijo gwe, yataho Heesi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.13",
            "verseOrgIds": [
              "1CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Abayebbusi, Abaamooli, Abagirigaasi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.14",
            "verseOrgIds": [
              "1CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahiivi, Abaaliki, Abasiini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.15",
            "verseOrgIds": [
              "1CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaaravadi, Abazemari n'Abahamasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.16",
            "verseOrgIds": [
              "1CH.1.16"
            ]
          }
        }
      ]
    },
