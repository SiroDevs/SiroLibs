        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.50",
            "verseOrgIds": [
              "1CH.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu nubo abanyoro b'Edomu: Timuna, Aliya, Yesesi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholibbama, Ela, Pinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.52",
            "verseOrgIds": [
              "1CH.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenazi, Temani, Mibbuzaara, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.53",
            "verseOrgIds": [
              "1CH.1.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 1:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magadyeri, na Iramu; abo nubo abanyoro b'Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.54",
            "verseOrgIds": [
              "1CH.1.54"
            ]
          }
        }
