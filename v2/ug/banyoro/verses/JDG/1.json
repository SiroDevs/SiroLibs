          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, omusaija yagenda omunsi y'Abahiiti, yayombekayo orubuga, yaruruka ibara Luzi, na hati nukwo rwetwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abantu abatarabingirwe Abaisirairi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
