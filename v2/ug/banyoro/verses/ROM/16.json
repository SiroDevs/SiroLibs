          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga ow'amagezi goona, Uwe wenka aheebwe ekitiinisa ebiro n'ebiro habwa Yesu Kristo! Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.27",
