              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu hati eyolekerwe kandi yamanyisibwa amahanga goona omu Bihandiiko by'abarangi, Ruhanga nkooku yaragiire, nukwo amahanga ago gaikirize kandi gahurre. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
