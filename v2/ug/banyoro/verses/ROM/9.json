              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagenderra kwoleka ekitiinisa kye ekingi ha bibindi ebimukwasa embabazi, ebi yateekaniriize ekitiinisa okuruga ira. ",
          "type": "text",
          "attrs": {
