              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibindi ebi niitwe aba yayesire, atatwihe omu Bayudaaya bonka, baitu n'omu Banyamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
