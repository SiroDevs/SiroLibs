        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otongera kunywa amaizi gonka, baitu onywehoga n'otwarwa tuke habw'enda yawe na habw'endwara yawe enyakwikara niimuka.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
