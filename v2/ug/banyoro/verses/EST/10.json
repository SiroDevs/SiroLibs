              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Ahaswero akaragira abantu ab'omunsi n'aba ha mikungu y'enyanja kumuha omusoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikorwa byona ebirukwoleka obusobozi n'amaani, na byona ebirukubaza ha kitiinisa Morodekayi eki yamuhikizeeho, bikahandiikwa omu kitabu eky'obusinge bw'abakama aba Media na Paasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba Morodekayi Omuyudaaya, nuwe yamyokeraga omukama Ahaswero, Abayudaaya baamutamuga ekitiinisa kandi yagonzibwaga, bagenzi be baingi muno, habwokuba yaitiniraga obusinge bw'abantu be n'okugwagwana kw'abaijukuru be boona.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
