                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Zek 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukasumi ako, abarangi Hagayi na Zekaliya mutabani wa Ido, bakarangira Abaayudaya abakaba bali Yuda na Yerusaalemu, omu ibara lya Ruhanga ow'akaba abaroho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.12"
              },
              "items": [
                {
                  "text": "Hag 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.6+ZEC.4.7+ZEC.4.8+ZEC.4.9"
              },
              "items": [
                {
                  "text": "Zek 4:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Zerubbabbeeri mutabani wa Seralityeri, na Yeswa mutabani wa Yozadaki, baimukire baatandika buhyaka kwombekera MUKAMA enju Yerusaalemu; abantu abo, bakaba baina abarangi ba Ruhanga abarukubakonyera.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi nuko kamu, Tatenayi omulemi ow'ensi ey'obuseeri bw'ekisaaru, Sesarabbozenayi n'abagenzi baabo, bakabahikaho baabakaguza bati: “N'oha ayabaragiire kwombeka Enju enu n'okugizitirra?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baabakaguza bati: “Amabara ag'abantu abarukwombeka enju enu, nubo baha?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Ruhanga wabo, yaikazaaga eriiso ha bakuru b'Abaayuda, batabeemereze, okuhika Daliyo amazire kumanyisibwa, nukwo agarukemu naahandiika ebbaruha erukubaza ha kintu eki.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu niyo ekopi ey'ebbaruha Tatenayi omulemi ow'ensi ey'obuseeri bw'ekisaaru, Serali-bozenayi n'abalemi bagenzi be abakaba bali omunsi obuseeri bw'ekisaaru, ei baatwekiire Daliyo omukama; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "binu nibyo ebigambo ebi baamumanyisize. Nituhandiikira mukama Daliyo, nitukugondeza obusinge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitukumanyisa nkooku twagenzire omunsi ya Yuda, omu nju ya Ruhanga ow'ekitiinisa. Enju egi nibagyombekesa amabaale amakooto, omu bisiika batairemu embaaho; abarukukora omulimo nibagukora n'obwekambi kandi bagutaireho omutima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.8",
            "verseOrgIds": [
              "EZR.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo twakagwize abakuru abo tuti: “N'oha ayabaragiire kwombeka enju n'okugitamu ebintu ebirukwetaagwamu?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.9",
            "verseOrgIds": [
              "EZR.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi tukabakaguza n'amabara gaabo, nukwo tugakumanyise, tuhandiike amabara gaabo abarukubeebembera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.10",
            "verseOrgIds": [
              "EZR.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinu nikyo baatugarukiremu bati: “Tuli bairu ba Ruhanga ow'iguru n'ensi, hati nitwombeka buhyaaka enju eyayombekerwe ira, omukama ow'ekitiinisa owa Isirairi yagimara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.11",
            "verseOrgIds": [
              "EZR.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11+2KI.25.12"
              },
              "items": [
                {
                  "text": "2 Bakam 25:8-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20"
              },
              "items": [
                {
                  "text": "2 Byok 36:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.12+JER.52.13+JER.52.14+JER.52.15"
              },
              "items": [
                {
                  "text": "Yer 52:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu habwokuba baisenkuruitwe bakabiihiza Ruhanga ow'iguru, na uwe nukwo kubalekera Nebbukadeneeza omukama wa Bbabbulooni Omukalidaaya, ayaseesire enju enu, abantu yabatwara Bbabbulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.2+EZR.1.3+EZR.1.4+EZR.1.5+EZR.1.6+EZR.1.7+EZR.1.8+EZR.1.9+EZR.1.10+EZR.1.11"
              },
              "items": [
                {
                  "text": "Ezir 1:2-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omu mwaka ogw'okubanza ogw'engoma ya Sirasi omukama wa Bbabbulooni, omukama ogu akaragira ngu Enju ya Ruhanga enu eyombekwe buhyaaka; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikwato eby'ezaabbu n'eby'efeeza eby'Enju ya Ruhanga, Nebukadeneeza ebiyaihire omunju ya Ruhanga eya Yerusaalemu yabitwara omunju eya Bbabbulooni, ebi omukama ogu Sirasi, akabiihamu, yabikwasa omusaija ouyafoire mulemi omukuru ibara lye Sesebazaara, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.14",
            "verseOrgIds": [
              "EZR.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamugambira ati: ‘Twara ebikwato binu, ogende obite omunju ya Ruhanga eya Yerusaalemu, Enju ya Ruhanga egi, egaruke eyombekwe buhyaaka omukibanja kyayo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.15",
            "verseOrgIds": [
              "EZR.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sesebazaara nubwo yagenzire, yatandika omusingi ogw'enju ya Ruhanga ey'ekaba eri Yerusaalemu; okuruga omu kasumi ako n'okuhika hati, neekyayombekwa, tekahoire” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, waitu obu oraaba nookisiima, ragira baserre omumaahurro g'omukama aga Bbabbulooni, beetegereze, ekiragiro eky'okwombeka buhyaaka enju ya Ruhanga enu omu rubuga Yerusaalemu, obukiriba kyaturukiibwe omukama Sirasi beetegereze, omukama Sirasi, obu araaba ali nuwe yaragiire okwombeka buhyaaka enju ya Ruhanga omurubuga Yerusaalemu, nitusaba omukama atumanyise eki arukusiima ha kigambo eki.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.17",
            "verseOrgIds": [
              "EZR.5.17"
            ]
          }
        }
      ]
    }
  ],
