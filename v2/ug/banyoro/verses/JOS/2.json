        "style": "s1"
      },
      "items": [
        {
          "text": "Yoswa natuma entasi Yeriko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
