              "JOS.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.28+NUM.32.29+NUM.32.30+NUM.32.31+NUM.32.32"
              },
              "items": [
                {
                  "text": "Kubar 32:28-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.18+DEU.3.19+DEU.3.20"
              },
              "items": [
                {
                  "text": "Bir 3:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.1+JOS.22.2+JOS.22.3+JOS.22.4+JOS.22.5+JOS.22.6"
              },
              "items": [
                {
                  "text": "Yos 22:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa yagambira ab'oruganda rwa Rubbeni, orwa Gaadi n'ekicweka eky'oruganda orwa Manaase ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.12",
            "verseOrgIds": [
              "JOS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwijuke ekigambo Musa omuheereza wa MUKAMA ekiyabaragiire naagamba ati: ‘MUKAMA Ruhanga wanyu naija kubaha ensi ey'okuhuumurramu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi n'abaana banyu, nibaija kusaagaana hamu n'amagana omunsi Musa ei yabahaire, baitu abasaija boona abarwani omuli inywe, baraayebeembera bagenzi banyu babakonyere kurwaana ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.14",
            "verseOrgIds": [
              "JOS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuhikya obubaratunga ensi eya Bugwaizooba bwa Yorudaani MUKAMA Ruhanga wanyu arukubaha. Obwaliha obusinge enganda zoona eza Isirairi nubwo muligaruka hanu mulye ensi yanyu, Musa omuheereza wa MUKAMA ei yabahaire enyakuli busi bwa nseeri obw'ekyambu Yorudaani, ha bukiizi obwa Burugaizooba.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamugarukamu bati: “Byona ebi oturagiire turaabikora, kandi hoona h'oraatutumaga, turaagendayoga. Nkooku twaahurraga Musa omu buli kintu, na iwe nukwo turakuhurraga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.16",
            "verseOrgIds": [
              "JOS.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katusabe, MUKAMA aikale na iwe nkooku yaikaraga na Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.17",
            "verseOrgIds": [
              "JOS.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu weena araagayaga ekiragiro kyawe, akanga kuhurra ebi ogambire, aitwege. Baitu, fooka w'amaani kandi ogume omutima.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.18",
            "verseOrgIds": [
              "JOS.1.18"
            ]
          }
        }
      ]
    }
