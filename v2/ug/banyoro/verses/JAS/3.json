          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.19.20+SIR.19.21+SIR.19.22+SIR.19.23+SIR.19.24+SIR.19.25+SIR.19.26+SIR.19.27+SIR.19.28+SIR.19.29+SIR.19.30"
              },
              "items": [
                {
                  "text": "Sir 19:20-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nooha omuli inywe anyakwina amagezi n'okwetegegereza? Leka akigumye n'engeso ze enungi n'ebikorwa ebi akora n'obuculeezi obunyakurumu amagezi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omu mitima yanyu obu muraaba mwinamu ihali lingi rundi okwegonza, muleke kwenyumiza n'okusereka amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi nk'ago tigaruga omwiguru, baitu garuga omunsi; tigali g'abantu baitu g'Omwohi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambere hali ihali n'okwegonza, nuho haba okutaikirraniza, hamu n'ebikorwa ebibi byona. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu amagezi agaruga omwiguru, eky'okubanza gaba marungi, gongera galeeta obusinge n'obuculeezi, gaikiriza eby'obulyo, gaijwire embabazi, garugwamu ebikorwa ebirungi, tigasoroora mu bantu kandi tigarumu bugobya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        }
      ]
    },
