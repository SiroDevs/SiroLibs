              "JAS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleke mugenzi wanyu omunaku ayesiime, Ruhanga obu amunyumiza, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.6"
              },
              "items": [
                {
                  "text": "Is 40:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi omuguuda ayesiime Ruhanga obu amubundaaza, habwokuba abaguuda balihwaho nk'orwakyo rw'ebimera. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izooba obu lituruka liina ekibabu kyalyo ekisiiriiza kandi ekihotokya ebimera, orwakyo rwabyo rukunkumuka n'oburungi bwabyo buhwaho. Omuntu omuguuda nawe nukwo alihwaho ati, nakyaserra itungo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okugumiisiriza omu kwohebwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "W'omugisa omuntu ogu anyakugumiisiriza omu kwohebwa, habwokuba obu alimara kusingura, aliheebwa ekondo ey'obwomeezi Ruhanga ei yaraganiize abamugonza. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.15.11+SIR.15.12+SIR.15.13+SIR.15.14+SIR.15.15+SIR.15.16+SIR.15.17+SIR.15.18+SIR.15.19+SIR.15.20"
              },
              "items": [
                {
                  "text": "Sir 15:11-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu obu ayohebwa aleke kugira ati: “Nyohiibwe Ruhanga”, habwokuba Ruhanga tayohebwa kukora ebibi, kandi tayohya muntu n'omu; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu buli muntu ayohebwa obu abiihwabiihwa kandi atwalirizibwa okwegomba kwe okubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma okwegomba obu kumara kwija, kuzaara ekibi; kandi ekibi obu kimara kukura, kirugwamu kufa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenzi bange abagonzibwa, muleke kubiihwabiihwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.16",
            "verseOrgIds": [
              "JAS.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu kyona ekirungi n'ekisembo kyona ekihikire biruga omu iguru hali Kazooba Nyamuhanga, atahindahinduka kandi tali nk'ekituuru ekigenda nikiihwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.17",
            "verseOrgIds": [
              "JAS.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akacwamu kutufoora baana be natwoleka enyegesa ye ey'amazima, nukwo tube omuganuro gw'ebi yahangire.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
              "JAS.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ediini y'amazima nukwo kuhurra n'okukora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.18",
            "verseOrgIds": [
