            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JAS 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba habaho arukuteekereza nkooku ali muntu w'ediini, kandi kunu tarukulema rulimi rwe, baitu nayebiihabiiha, ediini y'omuntu ogu busamu kantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.26",
            "verseOrgIds": [
              "JAS.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JAS 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ediini nyakabara kandi etaina kamogo omumaiso ga Ruhanga Isiitwe niyo enu: kusuura enfuuzi n'abafaakati abali omu mihito, n'okwerinda okusiiswa ensi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.27",
            "verseOrgIds": [
              "JAS.1.27"
            ]
          }
        }
