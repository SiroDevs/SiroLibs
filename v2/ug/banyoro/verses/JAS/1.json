                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli inywe obu haraaba haroho anyakubuzirwe amagezi, agasabe Ruhanga anyakugabira abantu boona atarukubalirra kandi atarukweijukya, mazimakwo aligaheebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu asabe aina okwikiriza kandi atarukugurukyagurukya, habwokuba anyakugurukyagurukya asisana ekigonzi ky'enyanja ekinyakutwarwa kandi ekinyakucundwacundwa omuyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyakugurukyagurukya aleke kuteekereza ngu, omuntu ow'emitima ebiri kandi ow'atagumire omu ngeso ze zoona ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.7",
            "verseOrgIds": [
              "JAS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "aina eki alitunga hali MUKAMA.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
            "verseOrgIds": [
              "JAS.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eby'abanaku n'abaguuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
