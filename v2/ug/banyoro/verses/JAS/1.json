              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe Yakobbo, omuheereza wa Ruhanga kandi owa MUKAMA Yesu Kristo, nimbaramukya inywe ab'enganda ikumi na ibiri abaararangiire omu mahanga.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
