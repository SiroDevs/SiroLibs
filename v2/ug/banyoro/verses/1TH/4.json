              },
              "items": [
                {
                  "text": "Sir 48:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka tubaijukye MUKAMA ngu, itwe aboomire abaliba baroho MUKAMA haaligarukira, titulibanza abo abaagwijagiire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2ES.6.23"
              },
              "items": [
                {
                  "text": "2Esid 6:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba MUKAMA wonyini alisirimuka naaruga omwiguru, naaragira n'iraka ery'obusobozi, na mukuru wa bamalaika aliba naayamirra, kandi n'engwara ya Ruhanga eriba neegamba. Nubwo abaafeeriire omu Kristo balibanza kuhumbuuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma na itwe aboomiire abaliba bakyaroho, tulitwarwa hamu nabo omu bicu okutangirra MUKAMA omu mwanya; nukwo tuliikara tuti nawe ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki muhuumuzangane n'ebigambo ebi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
