        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwomeezi Ruhanga obu asiima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'okumalirra, bagenzi bange, nitubeesengerereza kandi nitubateererra omu ibara lya MUKAMA Yesu tuti: nkooku mwatwegiireho okuba n'engeso enungi n'okukora ebisiimwa Ruhanga, mweyongere muno, kukira nkooku murukukora hati. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanyire ebiragiro ebi twabahaire habwa MUKAMA Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningira kinu nikyo Ruhanga agonza: mube abarukwera, mwetantale obusiihani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu omuli inywe amanye okulema omubiri gwe gwikale nigwera kandi gwina ekitiinisa; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutatwarwa okwegomba okw'omubiri nk'abakafiiiri abatamanya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo haleke kubaho muntu weena anyakusobeza mugenzi we akamusiisira oburungi bwe obu, habwokuba MUKAMA nuwe muhoozi w'enzigu omuli ebi byona, nkooku twabahabwire kara nitubakomeetereza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningira Ruhanga atatwetere eby'obugwagwa, baitu akatwetera oburukwera. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weena anyakugaya enyegesa enu, tagaya muntu, baitu agaya Ruhanga anyakubaha Mwoyo we Ahikiriire.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ha kigambo ky'okugonza ab'oruganda, timurukwetaaga muntu n'omu kubahandiikira, habwokuba inywe inywenka Ruhanga akabeegesa okugonzangana; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mazimakwo nimugonza ab'oruganda boona abali omu Makedoniya. Baitu nitubateererra bagenzi baitu, mweyongere muno okukora muti. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muteho omutima kwikara mutaina bwogo, mwekambire emirimo yanyu, kandi mukole n'emikono yanyu nkooku twabahabwire, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo abantu b'aheeru babahe akitiinisa, kandi mwemale inywenka mutarukukwatirirwa muntu n'omu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abafu n'aboomeezi ha kugaruka kwa MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenzi bange, tirurukwenda inywe okutamanya ha by'abaagwijagiire nukwo muleke kusaalirwa nk'abandi abataina kunihira oku basaalirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
            "verseOrgIds": [
              "1TH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu turaaba nitwikiriza Yesu nkooku yafiire kandi yahumbuuka, nukwo n'abo abaagwijagiriire omu Yesu, Ruhanga alibaleeta hamu nawe obu aligaruka.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
            "verseOrgIds": [
              "1TH.4.14"
            ]
          }
        }
      ]
    },
