            "number": "2",
            "style": "v",
            "sid": "1CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi boona nkooku baabatiriziibwe omu kicu eki n'omu Nyanja ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:2",
              "type": "text"
            },
            {
              "text": "Okubatizibwa omu kicu n'omu nyanja",
              "type": "text"
            },
            {
              "text": "kyali kyokurorraho ky'okwogebwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bakwataniize na Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.2",
            "verseOrgIds": [
              "1CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
