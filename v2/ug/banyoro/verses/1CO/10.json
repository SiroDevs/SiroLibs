              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenzi bange ningonza mwijuke baisenkuruitwe nkooku baayebemberwaga Ekicu omwirungu, kandi boona nkooku baarabire omu Nyanja, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
