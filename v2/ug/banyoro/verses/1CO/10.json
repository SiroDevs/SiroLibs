                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busaho kyohyo ekirabaiziire ekitahikaho abantu boona. Ruhanga mwesigwa, taliikiriza ebyohyo ebibahinguraine kubahikaho, baitu omu kwohebwa nk'oku alibaha amagezi ag'okisingura nukwo musobole okugumiisiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
    {
