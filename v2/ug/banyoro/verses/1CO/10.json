                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noobu kiraaba kyabaire kiti, baitu baingi omuli bo batasiimwe Ruhanga kandi bakahwerekerezibwa omwirungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
