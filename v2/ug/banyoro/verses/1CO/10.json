              "type": "tag",
              "attrs": {
                "loc": "SIR.15.11+SIR.15.12+SIR.15.13+SIR.15.14+SIR.15.15+SIR.15.16+SIR.15.17+SIR.15.18+SIR.15.19+SIR.15.20"
