          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.5"
              },
              "items": [
                {
                  "text": "Kubar 21:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuleke kujwahya MUKAMA nk'abamu omuli bo oku baakozire, baahwerekerizibwa enjoka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
