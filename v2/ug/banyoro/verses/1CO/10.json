          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbahabura nk'abantu abarukwetegereza. Inywe mwecweremu inywenka amazima g'eki ndukugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
