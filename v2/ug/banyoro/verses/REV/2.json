            }
          ]
        },
        {
          "text": "“Anyakwina okutu, ahurre Mwoyo ebi arukugambira ebitebe by'abaikiriza. Anyakusingura, ndimuha byokulya ebiserekerwe, niyo maanu;",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:17",
              "type": "text"
            },
            {
              "text": "Maanu",
              "type": "text"
            },
            {
              "text": "nibyo byokulya Ruhanga yahaire Abaisirairi bali omwirungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ndimuha ibaale erirukwera erihandiikirweho ibara erihyaka eritamanyirwe muntu n'omu, okwihaho ogu anyakulirukirwe.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebbaruha eyahandiikiirwe abaikiriza aba Tiyatiira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
