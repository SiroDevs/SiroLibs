            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu nyina ebigambo bike ebi ndukubajunaana: oku mwinayo abantu abamu abarukwikiriza enyegesa za Balaamu ayahabwire Balaki kwesiitaaza abaana ba Isirairi, nukwo balye ebyokulya ebihongiirwe abacwezi kandi beemarre ha busiihani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mwina n'abamu abarukuhondera enyegesa ez'Abanikola. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati nu mwegarukemu. Kakuba muteegarukamu, ninyija kubahikaho bwango, abo boona mbarwanise n'empirima ey'akanwa kange.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        }
      ]
