              "items": [
                {
                  "text": "31:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyakwina okutu, ahurre Mwoyo ebi arukugambira ebitebe ky'abaikiriza. Anyakusingura ndimwikiriza kulya ha muti ogw'obwomeezi ogunyakuli omunsi ya Ruhanga ey'okuhiirwa.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
