          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Handiikira malaika ow'ekitebe eky'abaikiriza ekiri Tiyatiira noogamba oti: Binu nibyo bigambo by'Omwana wa Ruhanga, anyakwina amaiso agarukwaka nk'endimi z'omurro, kandi ebigere ebirukusisana omulinga oguzigwire. Naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
