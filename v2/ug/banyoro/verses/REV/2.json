              },
              "items": [
                {
                  "text": "21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu anyakwina okutu, ahurre Mwoyo ebi arukugambira ebitebe by'abaikiriza. Anyakusingura, okufa okwa kabiri tikwina eki kulimukoraho.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
