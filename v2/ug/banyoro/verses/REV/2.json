              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi handiikira malaika ow'ekitebe eky'abaikiriza ekiri Perugamo noogamba oti: Binu nibyo bigambo by'Ogu anyakwina empirima enyakutoire ey'amoogi abiri. Naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        }
