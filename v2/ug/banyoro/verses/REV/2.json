          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mmanyire ebikorwa byawe, engonzi zawe, okwikiriza kwawe, obuheereza n'okugumiisiriza kwawe; kandi nimmanya ebikorwa ebi orukukora hati nkooku birukukira ebyabandize. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
