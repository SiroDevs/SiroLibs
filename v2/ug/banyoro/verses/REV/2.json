              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu kinu nikyo ndukukujunaana: n'okyaikiriza omukazi ogu Yezabeeli, arukweyeta murangikati, nuwe ahabisa abaheereza bange kandi naabeegesa kwemarra ha busiihani n'okulya ebihongiirwe embandwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkamuha akasumi ak'okwegarukamu, baitu akanga kuleka obusiihani bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati nu ninyija kumuleetera endwara emuzingike, kandi abo abasiihana nawe ndibaleetera emihito nyingi, rundi buli balekere ebi arukukora; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
