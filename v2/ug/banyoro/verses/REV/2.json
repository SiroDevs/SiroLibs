                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.12"
              },
              "items": [
                {
                  "text": "Zab 62:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'abaana be ndibaita. Nukwo ebitebe byona eby'abaikiriza bimanye nkooku ali nyowe arukwetegereza ebiteekerezo n'emitima; kandi buli omu omuli inywe ndimuha ebisemeriire ebikorwa bye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        }
      ]
