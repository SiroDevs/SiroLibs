            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumaiso g'ekitebe eki hakaba haroho ekirukusisana nk'enyanja ey'ekirahule erukumuliikana nka kirisitaalo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
