              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwehinguliriza ekitebe, ha buli rubaju, hakaba haroho ebihangwa bbina ebyomeezi, biijwire amaiso embaju zoona, omu maiso n'enyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihangwa ekyomeezi eky'okubanza kikaba nikisisana entale; ekya kabiri kikaba nikisisana enimi; ekya kasatu, ha maiso kikaba nikisisana omuntu; kandi ekya kana kikaba nikisisana isamba kaharruka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
