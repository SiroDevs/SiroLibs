            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo nahuliire iraka erikooto eryarugire omu Nju ya Ruhanga ey'omwiguru, nirigambira bamalaika omusanju liti: “Mugende museese omunsi ebibindi musanju eby'ekiniga kya Ruhanga.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
