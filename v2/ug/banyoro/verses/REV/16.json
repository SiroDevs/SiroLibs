                {
                  "text": "Kurug 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ow'okubanza yagenda yaseesa omunsi ebiri omu kibindi kye, abantu abakaba baina akororwaho ak'ekinyamaiswa kandi abaaramize ekisisani kyakyo baacweka ebihooya ebibi ebirukununka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
