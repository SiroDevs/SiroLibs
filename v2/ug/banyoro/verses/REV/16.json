                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika owa kataano nawe yaseesa ebiri omu kibindi kye ha kitebe ky'obukama eky'ekinyamaiswa. Obukama bwakyo bwaswekwa omwirima; abantu baayeruma endimi habw'okuhururwa ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "baakondereza Ruhanga ow'omu iguru habw'okuhururwa oku n'ebihooya ebi bacwekere, baitu bateegarukemu ebi baakozire.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
