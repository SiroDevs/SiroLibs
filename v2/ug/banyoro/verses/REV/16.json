              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika owa kabiri yaseesa omu nyanja ebiri omu kibindi kye, enyanja yafooka nk'esagama y'omuntu afiire, kandi buli kintu ekyomeezi ekikaba kiri omu nyanja kyafa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
