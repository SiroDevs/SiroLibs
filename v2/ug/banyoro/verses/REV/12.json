              },
              "items": [
                {
                  "text": "Dan 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.21"
              },
              "items": [
                {
                  "text": "21",
