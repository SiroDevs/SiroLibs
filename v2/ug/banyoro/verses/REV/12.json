          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
