              "items": [
                {
                  "text": "Zek 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hagati y'ekitebe ky'obukama n'ebihangwa bbina ebyomeezi, n'omu bakuru abo hagati, nkarora Omwana gw'Entaama ayemeriire, naasisana nk'anyakutambirwe, aina amahembe musanju n'amaiso musanju, agarukumanyisa emyoyo musanju Ruhanga ei yatumire omunsi yoona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagenda yaiha omuzingo omu mukono ogw'obulyo ogw'Ogu ow'akaba asingire ha kitebe ky'obukama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.2"
              },
              "items": [
                {
                  "text": "Zab 141:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yamazire kutwara omuzingo, ebihangwa ebbina ebyomeezi n'abakuru amakumi abiri na bbana baajuumara omumaiso g'Omwana gw'entaama, buli omu akwasire endongo n'ebibindi bya zaabbu ebiijwire omugaju, nubwo bumanyisa okusaba kw'abahikiriire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
