                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Kus 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo narozire Omwana gw'Entaama ayemeriire ha rusozi Siyoni, hamu n'abantu akasiiriira kamu mu bukumi bbuna n'enkumi ina, abakaba bahandiikirwe ha buso ibara lye n'ibara lya Ise. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2ES.6.17"
              },
              "items": [
                {
                  "text": "2Esid 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nahurra iraka erirukuruga omwiguru, nirisisana okuhirra okw'amaizi maingi kandi okugamba okw'enkuba ez'amaani. Iraka eri nahuliire likaba nirisisana nk'ery'abateezi b'endongo abarukuteera endongo zaabbu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakaba nibazina ekizina ekihyaka omumaiso g'ekitebe ky'obukama, n'omu maiso g'ebihangwa bbina ebyomeezi, n'omu maiso g'abakuru abo. Busaho n'omu ayasoboire kukwata ekizina eki, okwihaho abantu akasiiriira kamu mu bukumi bbuna n'enkumi ina abaacungwirwe omunsi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubo abo abatarayesiisire n'abakazi, habwokuba batamanye bakazi; abo nubo bahondera Omwana gw'Entaama hoona h'akagenda; nubo abaacungwirwe omu bantu, bali munganuro gwa Ruhanga n'ogw'Omwana gw'Entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Zef 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kanwa kaabu hatasangwemu bisuba, habwokuba tibaina kamogo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bamalaika abasatu nibaranga ekiro eky'okucweraho omusango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
