        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nahurra iraka erirukuruga omu iguru nirigamba liti: “Handiika oti: Okuruga hati, baina omugisa abafu abaraafeeraga omu MUKAMA.” Kandi Mwoyo naakigumya ati: “Mazimakwo baina omugisa, hati bahuumule, baleke emirimo yabu, habwokuba ebikorwa byabu bagenda nabyo!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akasumi k'igesa kahikire",
          "type": "text"
        }
      ]
    },
