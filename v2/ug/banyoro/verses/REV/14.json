            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ondi owa kasatu yabakurataho naagamba n'iraka likooto ati: “Kakuba omuntu weena aramya ekinyamaiswa eki n'ekisisani kyakyo, kandi akateebwaho akarorwaho ha buso rundi ha mukono, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.9",
            "verseOrgIds": [
              "REV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
