            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haakurataho malaika ondi, owa kabiri, ayagaambire ati: “Rugwire Bbabbulooni orubuga rukuru! Rugwire oru orwatamiize amahanga goona n'obubi obw'obusiihani bwarwo!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.8",
            "verseOrgIds": [
              "REV.14.8"
            ]
          }
        }
