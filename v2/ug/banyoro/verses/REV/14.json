              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ondi yaruga omu Nju ya Ruhanga ey'omwiguru, nawe akaba akwasire enoijoro enyakutoire.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
