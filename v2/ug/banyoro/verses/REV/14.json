              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo narozire ekicu ekirukwera, kiikaliirweho omu arukusisana omwana w'omuntu, ajwaire ha mutwe ekondo ya zaabbu, akwasire omu ngaro enoijoro enyakutoire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
