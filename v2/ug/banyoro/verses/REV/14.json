          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho nuho harukwetaagirwa okugumiisiriza kw'abahikiriire. Nubo abo abakwata Ebiragiro bya Ruhangga kandi abaikiriza Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        }
