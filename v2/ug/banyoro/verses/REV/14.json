                "loc": "EZK.38.22"
              },
              "items": [
                {
                  "text": "Ezek 38:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe alinywa empotole ey'ekiniga kya Ruhanga, enyakwiturwirwe omu kikopo kye. Alibonabonesibwa omurro n'obuganga oburukwokya, bamalaika abahikiriire n'Omwana gw'Entaama baroleriire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.10"
              },
              "items": [
                {
                  "text": "Is 34:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwika ogw'okubonesibwa kwabo guliikara nigucuuka ebiro n'ebiro; kandi abo abaramya ekinyamaiswa n'ekisisani, kyakyo hamu n'abanyakwina akarorwaho ak'ibara lyakyo, tibaligira kihuumuro nyamusana n'ekiro.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
          }
        }
      ]
