                  "text": "Yow 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ondi yaruga omu Nju ya Ruhanga naayeta n'iraka likooto Ogu anyakwikaliire ha kicu naagamba ati: “Kwata enoijoro yawe ogese, habwokuba akasumi ak'okugesa kahikire, ebyokugesa by'ensi byeriire kimu.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
