                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi obu byahoire, nkarora omwiguru Enju ya Ruhanga erumu eheema y'obwakaiso ekingwirwe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "haarugamu bamalaika musanju baina emihito musanju kandi bajwaire ekanzu eza bafuta enungi erukunekaneka, beetegere omu kifuba emyeko ya zaabbu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekimu ha bihangwa ebbina ebyomeezi kyaha bamalaika musanju ebibindi musanju ebya zaabbu ebiijwire ekiniga kya Ruhanga anyakwomeera ebiro byona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
