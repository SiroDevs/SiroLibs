          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo narozire omwiguru ekyamahano ekindi ekikuru kandi ekirukuhuniriza. Nubo bamalaika musanju abaina emihito musanju ey'okumalirra, habwokuba ekiniga kya Ruhanga niyo kirukugarukiraho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
