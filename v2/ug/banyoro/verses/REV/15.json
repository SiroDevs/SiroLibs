          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nkarora ekintu ekirukusisana enyanja ey'ekirahule etabwirwemu omurro, n'abo abaasingwire ekinyamaiswa n'ekisisani kyakyo n'enamba y'ibara lyakyo beemeriire ha rubaju rw'enyanja ey'ekirahule, bakwasire omu ngaro endongo za Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
