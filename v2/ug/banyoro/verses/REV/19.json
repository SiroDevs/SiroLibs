          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narora ekinyamaiswa eki, n'abakama ab'ensi, n'amahe gaabu ageesoroize kurwanisa Ogu anyakwikaliire ha mbaraasi n'okurwanisa ihe rye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
