                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.22"
              },
              "items": [
                {
                  "text": "Luk 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "iraka lyaruga omwiguru nirigamba liti: “Niiwe Mwana wange omugonzibwa, ou nsiima muno.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.11",
            "verseOrgIds": [
              "MRK.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.11",
            "verseOrgIds": [
              "MRK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho Mwoyo yamutwara omu irungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.12",
            "verseOrgIds": [
              "MRK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamarayo ebiro makumi ana, naayohebwa Sitaani; kandi yaikaraga omu nyamaiswa hagati; n'abamalaika baamuheerezaaga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.13",
            "verseOrgIds": [
              "MRK.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naayeta abasohi bbana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.13",
            "verseOrgIds": [
              "MRK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohaana obu yamazire kukwatwa, Yesu yaija Galiraaya, naarangirra Amakuru Amarungi aga Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.14",
            "verseOrgIds": [
              "MRK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.2"
              },
              "items": [
                {
                  "text": "Mat 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "naagamba ati: “Akasumi kahikire, obukama bwa Ruhanga bwiriire haihi; mwegarukemu, mwikirize Amakuru Amarungi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.15",
            "verseOrgIds": [
              "MRK.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.15",
            "verseOrgIds": [
              "MRK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu akaba naaraba ha musa gw'enyanja ya Galiraaya, yarora Simooni na Andereya owanyina nibanaga akatimba omu nyanja; habwokuba bakaba bali basohi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.16",
            "verseOrgIds": [
              "MRK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yabagambira ati: “Mumpondere, ndibafoora basohi b'abantu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.17",
            "verseOrgIds": [
              "MRK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho baasiga obutimba bwabu, baamuhondera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.18",
            "verseOrgIds": [
              "MRK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yagenzireho omumaiso kake, yarora Yakobbo mutabani wa Zebedaayo, na Yohaana owanyina, nabo bakaba bali omu bwato bwabu nibasumiikaniza obutimba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.19",
            "verseOrgIds": [
              "MRK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahonaaho yabeeta; baaleka isebo Zebedaayo omu bwato hamu n'abarukukolerra empeera, baamuhondera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.20",
            "verseOrgIds": [
              "MRK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naakiza ayakwasirwe omwoyo omubi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
