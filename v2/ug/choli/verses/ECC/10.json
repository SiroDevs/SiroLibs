              "ECC.10.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.15"
              },
              "items": [
                {
                  "text": "Jab 7.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.26.27"
              },
              "items": [
                {
                  "text": "Car 26.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ŋat ma okwinyo bur bipoto i bur ma en okwinyo; ki ŋat ma muko kicika me ot bene twol bikayo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ma mukogot, got biŋolo; ki ŋat ma baro yen, yen biketo ret ikome.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce latoŋ lake olu, ka pe ipako lake, myero iti ki tekoni makato; ento ryeko ber konyo dano weko ticce woto maber.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce twol okayo dano ma peya won yat okweyo, latim yatyat doŋ pe bedo ki kony mo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok ma dano maryek loko miyo dano gipwoye, ento ŋat ma lamiŋ loko gin ma kelo can i kome kekene.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acakki me lokke opoŋ ki miŋo keken, lokke me agikki bene loko calo ŋat ma tye ki apoya marac.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamiŋ medo lok nyayo doko dwoŋ, kadi bed dano mo pe ŋeyo gin ma bibedo i anyim; aŋa kono ma twero tito bote gin ma bitimme lacen i anyim ma noŋo en doŋ eto woko?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamiŋ aye kome nyonne woko ki tic ma en tiyo, miyo pe ŋeyo yo ma cito i gaŋ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubineno can wun jo me lobo, ma kabakawu obedo calo latin matidi, ki rwodiwu bene gicamo karama wa odiko!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wutye ki yomcwiny wun jo me lobo ma kabakawu odoŋo i gaŋ kal, kun rwodiwu bene gicamo cam i kare ma mitte, wek gilim teko, ento pe pi mero!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka won ot obedo dano ma lacarcar ci wi ode ryebbe woko, dok pi wackome miyo wi ot cwer ka kot ocwer.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
          }
        }
      ]
    },
