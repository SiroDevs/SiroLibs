        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wac bot jo Icrael ni gujogga gityer, ci gugam gityer pa dano ducu ma gukelo ma cwinygi opwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye kit gityer ma wubigamo ki botgi: jabu, ryal, mola; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.3",
            "verseOrgIds": [
              "EXO.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uci ma bulu, ki ma lamar lamar, ki makwar, ki boŋo camanini maberre; yer dyegi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.4",
            "verseOrgIds": [
              "EXO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "laa nyogi romi ma ginyoŋo, laa dyegi; bao yat okuto lalwii: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.5",
            "verseOrgIds": [
              "EXO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "moo me mac tara, aŋwece me yubo moo wir ki pi odok eceta ma ŋwe kur; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.6",
            "verseOrgIds": [
              "EXO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "litino kidi onik litino kidi me wel me amwona i kom jabu pi epod ki kicaa kor. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.7",
            "verseOrgIds": [
              "EXO.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber gu yubba kabedo maleŋ wek abed i kingi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.8",
            "verseOrgIds": [
              "EXO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuti gin ducu kun wulubo kit cal ma abinyutti, ma dok i kom timo kema ki jami ma giketo iye ducu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gibipayo canduk ki bao yat lalwii; borre obed futi aŋwen",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25.10",
              "type": "text"
            },
            {
              "text": "Leb Ibru:",
              "type": "text"
            },
            {
              "text": "Kubit aryo ki nucu.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ki lacce futi aryo, ki borre tuŋ malo futi aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwon kome woko ki jabu ma giliyo maber, mwon iye ki ŋeye bene. Lul doge ducu irum woko ki jabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti agit me jabu aŋwen pire, iketgi i kom tyene aŋwen: ket agit aryo tuŋ cel ki aryo mukene tuŋ cel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti tal me yat lalwii, imwon komgi woko ki jabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwak tal i agit ducu ma tye i but canduk, me tiŋo canduk. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tal gibibedo i agit ma i kom canduk-ki matwal, pe gibiwotogi woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidi ma apada ma gicoyo iye lok me caden ma amiyi-ni ibiketogi i canduk. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.5"
              },
              "items": [
                {
                  "text": "Ibru 9.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok ibitiyo kom mekica kijabu ma giliyo maber; borre obed futi aŋwen, ki lacce futi aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti cal lukerubi aryo ki jabu kun itetogi ki nyol, i kom agikki kom me kica aryo ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.18",
            "verseOrgIds": [
              "EXO.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti cal lakerubi acel i agikkine tuŋ cel; ki acel i agikkine tuŋ cel; ti cal lukerubi kun gikubbe i kom me kica-ni i agikkine aryo ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.19",
            "verseOrgIds": [
              "EXO.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukerubi gibiyaro bwomgi malo me umo kom me kica ki bwomgi, kun waŋgi kemo lawote; waŋ Lukerubi binen kun kemo kom me kica. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibicibo kom me kica cuŋ i wi canduk, ci iket lok me caden ma abimiyo boti-ni i canduk. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "An abirwatte kwedi kunnu, ci abilok kwedi ki malo i wi kom me kica, ki i kin lukerubi ma gitye malo i wi canduk lok me caden-ni, kun aloko kwedi i kom cik ducu ma abimiyi pi jo Icrael.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ti meja ki bao yat lalwii; borre obed futi adek, ki lacce futi acel ki nucu, ki borre tuŋ malo futi aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwon kome woko ki jabu ma giliyo maber, dok ilul doge ducu, irum woko ki jabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ket riine ma lacce rom ki dye ciŋ, ilul dog rii ki jabu orum woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok itim agit me jabu aŋwen pire, ci imwon agit i twoke aŋwen ducu, i tyene aŋwen, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agit bibuto i kom rii, ci ibirwako iye tal me latin meja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.27",
            "verseOrgIds": [
              "EXO.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti tal ki jabu; gibitiŋo meja ki tal meno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.28",
            "verseOrgIds": [
              "EXO.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok iti caanine, ki ata bone me odok eceta, ki cupane ki werre me liyo gityer amate ibitimogi ki jabu ma giliyo mabe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.29",
            "verseOrgIds": [
              "EXO.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8"
              },
              "items": [
                {
                  "text": "Levi 24.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibicano mugati me aketa i nyima i wi meja jwijwi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dok ibitiyo okar-mac ki jabu m giliyo maber. Tedi okar-mac ki bolle gibiteto ki nyol; kikopone, en aye wen ki ature ducu, gibikubbe kwede kacel. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaŋe bibedo abicel ma gujany guryey gukaco ŋete ryoryo, jaŋ okar-mac ade ma guryeyo i bute tuŋ cel, ki jaŋ okai mac cadek ma guryeyo i tuŋ mukene-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom jaŋe tuŋ cel bibedo iye kikop adek ma gitimo macalo tur yaa, ku; acel acel tye ki wene ki ature, ki i kor jaŋe tuŋ mukene bene bibedo iy kikopo adek ma gitimo macalo tu yaa, kun acel acel tye ki wene ki ature jaŋe abicel ducu ma guryeyo gukac okar-mac-ci gibibedo kit meno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok i kom okar-mac kikome-ni bibedi iye kikopo aŋwen ma gitimo macalo tu yaa, ki wengi ki aturegi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki wene ma; okubbe i kom okar-mac-ci i te jaŋe abicel ma’ guryeyo ryoryo i kom okar mac. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wengi ki jaŋgi gubed ma gu kubbe kacel, kun kome ducu bedo jabi ma giliyo maber ma giteto ki nyol ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci doŋ ibitiyo pire mac laput abiro gicib mac laput malo i wiye wek omen: kabedo ma i nyime. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magacce ki caanine bibedo me jabu ma giliyo maber. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giyub okar-mac kacel ki jami tic magi ducu ki jabu ma giliyo maber ma pekke romo ratili miya acel",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
