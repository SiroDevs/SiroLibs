                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, “Wua woko ki kany, in ki lwak ducu ma yam ikwanyogi woko ki i lobo Ejipt, pi terogi i lobo ma yam akwoŋo pire bot Abraim, Icaka, ki Yakobo, kun acikogi ni, abimiyo bot likwayogi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok abicwalo lamalaika i nyimgi, ci abiryemo jo Kanaan woko, ki jo Amor, jo Kit, jo Periji, jo Kiv ki jo Jebuc. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cit malo i lobo ma mol cak ki moo kic; ento an pe abicito kwedwu kunnu, wek pe arid wiwu woko iyo, pien wun jo ma nutwu tek.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lwak giwinyo lok man marac-ci, ci gukumo; pe tye dano mo ma orukke me deyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien onoŋo Rwot owaco bot Moses ni, “Wac bot jo Icrael ni, ‘Wun wu jo ma ŋutwu tek; kono ka acito kwedwu kunnu pi kare manok mo, kono arido wiwu woko cut. Kombeddi doŋ wuluny ruk me deyowu woko ki i komwu, wek aŋe gin ma abitimo i komwu.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumiyo jo Icrael gulunyo ruk me deyogi woko, nia ki i te got Koreb ki cito kwede anyim.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno Moses obedo ka tero kema, ci guro woko i ne gony, ka mabor ki gony; ci olwoŋo ni, kema me rwatte. Ci ŋat ma yenyo Rwot cito woko i kema me rwatte, ma tye woko i ŋe gony. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ducu ma Moses kato cito woko i kema me rwatte, lwak ducu gia malo, kun ŋat acel acel cuŋ i nyim dog kemane, ka neno kor Moses nio ka odonyo wa i kema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Moses odonyo i kema, ci wir me pol dwogo piny cuŋ i doggola kema me rwatte, ci Rwot loko ki Moses. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lwak dano ducu guneno wir me pol ma ocuŋ i dog kema, ci dano ducu gia malo, giworo Lubaŋa, kun ŋat acel acel tye i dog kemane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno Rwot yam loko ki Moses waŋ ki waŋ, macalo dano loko ki lareme, Ka Moses odok i gony, Yocwa wod pa Nun, latin awobi ma lakony en, yam doŋ i kema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses owaco bot Rwot ni, “Nen, in onoŋo iwacca ni, ‘Kwany jo man woko;’ ento pe imiya aŋeyo ŋat ma ibicwalo acito kwede. Ento iwacci, ‘Aŋeyo in ki nyiŋi, ki in bene iyomo cwinya.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koni doŋ alegi, ka onoŋo ayomo cwinyi, nyutta kiti, wek aŋeyi, anoŋ gum ki boti. Dok itam bene ni, rok man gin aye lwakki.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot ogamo ni, “An kikoma abiwot kwedi, abimiyi iywe mot.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok owacce ni, “Ka in kikomi pe ibicito kweda, ci pe ikwanywa woko ki kany. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.15",
            "verseOrgIds": [
              "EXO.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien binene niŋniŋ ni anoŋo gum ki boti, an kacel ki lwakki? Pe pi in ma iwoto kwedwa-ni mumiyo waŋen pat? An, kacel ki lwakki, wapat ki jo mukene ducu ma gitye i wi lobo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, “Abitiyo gin man ma iwaco-ni kikome; pien iyomo cwinya, dok aŋeyo in ki nyiŋi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
              "EXO.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses ogamo ni, “Alegi inyutta deyoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.15"
              },
              "items": [
                {
                  "text": "Rom 9.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot ogamo ni, “Abimiyo berra ducu kato ki i nyimi, ka dok abituco nyina ni, ‘A Rwot’; abinyuto berra bot ŋat ma abinyuto berra bote, dok abitimo kica bot ŋat ma abitimo kica bote.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot dok owaco ni, “Ento pe ibineno waŋa; pien dano pe neno waŋa ci bedo kwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot owacci, “Nen, kabedo mo tye ka ŋeta ka ma ibicuŋ iye i kom got. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka deyona bikato ki kenyo, ci abiketi i kin got ma obar, ci abiumi woko ki ciŋa nio ka akato otum; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka doŋ abikwanyo ciŋa woko, ci ibineno neya; ento waŋa pe ibinenone.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.23",
            "verseOrgIds": [
              "EXO.33.23"
            ]
          }
        }
      ]
    }
  ],
