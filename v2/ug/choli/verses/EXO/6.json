              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Rwot owaco bot Moses ni, “Tin doŋ ibineno gin ma abitimo i kom Parao; en bicwalogi woko ki bade matek, ci ryemogi woko ki i lobone ki tek.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
