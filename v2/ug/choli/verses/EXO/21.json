        },
        {
          "text": "“Ka ŋatti mo ogoyo dano, ce oto, gibineke wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
