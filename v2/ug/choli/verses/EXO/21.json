            }
          ]
        },
        {
          "text": "“Ka jo mogo gubedo ka da, ce ŋat acel ocelo lawote ki got nyo odoŋo ki ciŋe ci pe oto, ento obedo ka twor labuto, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
