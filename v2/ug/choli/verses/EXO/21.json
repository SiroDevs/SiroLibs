              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ŋatti mo ogoyo opiine nyo aŋecane ki odoo ce oto woko cut, I gibiketo can i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
