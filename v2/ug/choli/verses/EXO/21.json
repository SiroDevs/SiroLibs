                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ka yam pe obuto okiye, ento Lubaŋa omiyo ciŋe orwatte i kome, ci abiyero kabedo mo ma en biriŋo laro iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka dano mo ocako lweny i kom gat mo me akaka me nekone woko ki ryeko, ci wubikwanye woko ki i kom keno tyerra, gineko woko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
