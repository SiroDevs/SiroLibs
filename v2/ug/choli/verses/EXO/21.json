          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka opii meno obedo kwo pi nino acel nyo aryc pe gibiketo can mo i kome; pien op meno obedo gire limme.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
