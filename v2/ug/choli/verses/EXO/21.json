          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "lacen ka dano meno ocukke oa malo kun woto komo ki odoo, kop pe biloyo ŋat ma ogoye-ni, ento bicul pi balo kare me ticce, dok bimiyo en caŋ maber.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
