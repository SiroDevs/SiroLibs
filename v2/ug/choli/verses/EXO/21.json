          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ŋatti mo ogoyo waŋ opiine nyo waŋ aŋecane, ce oloyo oneko woko, ci bigonyo opii meno nyo aŋeca meno, weko cito gire pi waŋe-nu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka otwomo omuko lak opiine nyo aŋecane ci bigonyo opii meno nyo aŋeca meno weko cito gire pi lake-nu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
