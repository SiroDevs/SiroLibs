          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ŋatti mo oweko wi bur twolo nyo ka ŋatti mo okwinyo bur ci pe oumo wiye woko, ce twon nyo kana mo opoto iye, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci won bur biculone; en bimiyo lim bot rwode, ci riŋone bibedo mere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        }
      ]
