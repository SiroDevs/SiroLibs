              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Cam mukwoŋo cek i potoni me wi mwaka myero ikel i ot pa Rwot Lubaŋani,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
