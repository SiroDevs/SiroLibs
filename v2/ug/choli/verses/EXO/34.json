            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, “Co lok magi; pien doŋ acikke kwedwu, in ki jo Icrael, ki gicikke ma lubo lok magi ducu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "En obedo kunnu kacel ki Rwot nino pyeraŋwen, dyeceŋ ki dyewor, kun pe camo dok pe mato pii bene. Ci ocoyo lok me gicikke i kom kidi ma apada, gin aye cik apar-ri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
