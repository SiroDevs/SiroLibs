        },
        {
          "text": "“Pe ityer remo me gitumma kacel ki tobi; pe giwek gitum me nino madit me Kato (Paska) obed nio wa odiko, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
