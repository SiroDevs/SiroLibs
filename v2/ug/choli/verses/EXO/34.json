              "type": "text"
            }
          ]
        },
        {
          "text": "“Litino kayo ducu mega, litino twonini, litino kayo me dyaŋi ki me romi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
