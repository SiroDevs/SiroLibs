              "items": [
                {
                  "text": "Luka 22.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.25"
              },
              "items": [
                {
                  "text": "1 Kor 11.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.19+HEB.9.20"
              },
              "items": [
                {
                  "text": "Ibru 9.19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.29"
              },
              "items": [
                {
                  "text": "10.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka Moses dok otiŋo remo, ocoro i kom lwak, kun wacci, “Nen remo me gicikke ma Rwot oketo kwedwu, ma lubo lok magi ducu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Moses ki Aron, Nadab ki Abiu, ki ludoŋo pa jo Icrael pyerabiro-ni gucito malo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.9",
            "verseOrgIds": [
              "EXO.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci guneno Lubaŋa pa Icrael. Gin mo obedo ka tyene macalo kidi capir ma bulu ma gipeto, ma ryeny macalo polo kikome. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
              "EXO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Lubaŋa pe ogudo kom ludoŋo pa Icrael ki ciŋe; guneno Lubaŋa, ci gucamo dok gumato pii bene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Moses ni, “Bin bota malo i wi got, ci ikura kunnu, Abimini kidi ma apada, kacel ki cik ki ginacika ma acoyo me pwonyo lwak.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Moses oa malo, kacel ki Yocwa ma lakonye, ka ocito i wi got pa Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owaco ki ludoŋo ni, “Wubed wukurwa kany, nio ka dok wadwogo botwu, Nen, Aron ki Kur gudoŋ botwu; ka ŋat mo tye ki lok mo, oter botgi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Moses cito malo i wi got, ci pol oumo got woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.15",
            "verseOrgIds": [
              "EXO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deyo pa Rwot obedo i kom got Cinai, ci pol oumo kema pi nino abicel. I kom nino me abirone, Rwot olwoŋo Moses ki i dye pol. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno deyo pa Rwot onen bot jo Icrael macalo mac arum i wi got, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.17",
            "verseOrgIds": [
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.9"
              },
              "items": [
                {
                  "text": "Nwo 9.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka Moses odonyo i dye pol, ocito malo i wi got; ci Moses obedo i wi got nino pyeraŋwen, dyeceŋ ki dyewor.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.18",
            "verseOrgIds": [
              "EXO.24.18"
            ]
          }
        }
      ]
    }
