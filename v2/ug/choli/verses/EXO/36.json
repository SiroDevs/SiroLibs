          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otiyo rii me bao yat lalwii abic pi guti me kema tuŋ cel, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki rii bao abic pi guti me kema tuŋ cel, ki rii bao abic pi guti me kema me ŋeye tuŋ potoceŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok otiyo rii bao ma i dyere ma oa ki i agikki tuŋ cel nio wa i agikki tuŋ cel ma oŋolo kor guti ari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci omwono kom guti woko ki jabu, ka otiyo agit me jabu me rwako bao iye; ki rii bao bene omwono komgi woko ki jabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
      ]
    },
