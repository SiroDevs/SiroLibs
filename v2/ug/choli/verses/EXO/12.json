        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Icrael gucito gutimo kit meno; macalo Rwot ociko Moses ki Aron, gutimo kit meno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
