                  "text": "Nwo 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka lawoti ojeŋo boŋone boti, ci ber idwokke ma ceŋ peya opoto; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
