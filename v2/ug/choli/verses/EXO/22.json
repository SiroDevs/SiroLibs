            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.28+DEU.22.29"
              },
              "items": [
                {
                  "text": "Nwo 22.28-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ŋatti mo obito nyako mo ma peya oneyo co, ma pe gitoŋo keny i kome, ce obedo kwede, ci myero okol lim me keny me nyome, ci oter obed dakone. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka wonne okwero woko matek pi nyare, ci en biculo wei lim ma romo nyomo nyako ma peya oneyo co.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
