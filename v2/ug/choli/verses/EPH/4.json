              "items": [
                {
                  "text": "Kol 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wubed jo ma lukica ki cwiny maber; dano acel acel myero otim ber bot lawote. Wutim kica i kinwu kekenwu ki luwotwu i kom balwu, macalo Lubaŋa otimowu kica i Kricito.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.32",
            "verseOrgIds": [
              "EPH.4.32"
            ]
