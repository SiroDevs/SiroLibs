                  "text": "Jab 4.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka kiniga omakowu, pe wupot i bal; ceŋ pe myero opoti ma noŋo pud wujul wutye ki kiniga i cwinywu,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "dok bene pe wumi kare ki Catan. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.27",
            "verseOrgIds": [
              "EPH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ma yam bedo ka kwalo jami pa jo mukene myero doŋ owek kwo obedi; myero en ocak tiyo tic maber ki ciŋe, wek onoŋ gin ma myero opok ki jo ma megi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.28",
            "verseOrgIds": [
              "EPH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok mo marac myero pe okatti ki i dogwu; wulok lok mabeco keken ma doŋo tam pa dano i yo ma mitte, wek jo ma winyo lokwu gunoŋ kony ki iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.29",
            "verseOrgIds": [
              "EPH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe wumi Cwiny pa Lubaŋa okum, en Cwiny ma gimiyowu me bedo lanen ma gimwono woko doŋ i komwu pi kuro nino ma gibikokowu iye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.30",
            "verseOrgIds": [
              "EPH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuwek doŋ keccwiny ducu, ki waŋ-ic ki kiniga, da i wi dano mukene, yet, kacel ki raccwiny ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.31",
            "verseOrgIds": [
              "EPH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
