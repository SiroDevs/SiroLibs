              "items": [
                {
                  "text": "Acak 2.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yam gicoyo ni, “Pi lok man dano biweko wonne ki minne, ci giribbe woko gin ki dakone, gin aryo doŋ gidoko kom acel.” ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man muŋ madit twatwal. An ki tuŋ bota agonyo tyen lokke ni Kricito ki lwak muye en. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
            "verseOrgIds": [
              "EPH.5.32"
            ]
          }
        },
        {
          "name": "verse",
