          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno, laco acel acel i kinwu myero omar dakone macalo maro kome kene, ki dako bene myero onen ni eworo cware.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.33",
