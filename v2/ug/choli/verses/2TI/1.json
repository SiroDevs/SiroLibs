              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraga man oa ki bot Paulo ma lakwena pa Kricito Yecu pi mit pa Lubaŋa, ma lubo cikkene me miyowa kwo ma tye i Kricito Yecu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
