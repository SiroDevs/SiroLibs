          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat 12.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot omiyo rec madit omwonyo Yona woko i iye; ci Yona ori i i rec meno pi nino adek dyeceŋ ki dyewor.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
      ]
    }
