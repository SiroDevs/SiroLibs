              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok kom Jeroboam mudoŋŋe ducu, ki gin ma otiyo ducu, ki tek mere ducu, ki kit ma yam olwenyo kwede, ki kit ma yam odwoko kwede Damaciko ki Kamat i lobo Icrael, ma onoŋo yam koŋ gubedo i ciŋ Juda, gityeko coyone i buk me Tekwaro pa Luker me Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Jeroboam oto, oywe kacel ki kwarine; wode Jekaria aye oleyo ka tyene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
              "2KI.14.29"
            ]
          }
        }
      ]
    }
