        },
        {
          "text": "En ocako cito gin ki Joram wod pa Akab ka lweny ki Kajael kabaka me Ciria wa i Ramot-gilead, ci jo Ciria guketo ret i kom Joram. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
