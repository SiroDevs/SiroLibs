                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.28.1+JER.28.2+JER.28.3+JER.28.4+JER.28.5+JER.28.6+JER.28.7+JER.28.8+JER.28.9+JER.28.10+JER.28.11+JER.28.12+JER.28.13+JER.28.14+JER.28.15+JER.28.16+JER.28.17"
              },
              "items": [
                {
                  "text": "28.1-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jedekia ocamo ker ma mwaka me ditte pyeraryo wiye acel, ci obedo ka loc ki i Jerucalem pi mwaka apar wiye acel. Nyiŋ minne Kamutal, nya pa Jeremia me Libna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.18",
            "verseOrgIds": [
              "2KI.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "En obedo ka tiyo gin ma nen marac i wan Rwot, kun Lubo gin ducu ma yam Yekoyakm otiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.15"
              },
              "items": [
                {
                  "text": "Ejek 17.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pi kiniga ma omako Rwot, ka kare oromo, omiyo Rwot obayo Jerucalem ki Juda woko ki i nyime.",
          "type": "text",
