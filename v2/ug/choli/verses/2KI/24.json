            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.1+JER.27.2+JER.27.3+JER.27.4+JER.27.5+JER.27.6+JER.27.7+JER.27.8+JER.27.9+JER.27.10+JER.27.11+JER.27.12+JER.27.13+JER.27.14+JER.27.15+JER.27.16+JER.27.17+JER.27.18+JER.27.19+JER.27.20+JER.27.21+JER.27.22"
              },
              "items": [
                {
                  "text": "Jer 27.1-22",
