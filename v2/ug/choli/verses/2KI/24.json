              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare pa Yekoyakim en aye Nebukadnejar, kabaka me Babilon, obino kwede, ci Yekoyakim odoko laticce pi mwaka adek; lacen olokke ojemo woko i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot ocwalo buca mony pa jo Kaldaya i kome, ki buca mony pa jo Ciria ki buca mony pa jo Moab, ki buca mony pa jo Ammon; ocwalogi ka lweny i kom jo Juda pi jwerogi woko ducu, kit ma yam Rwot oloko ki i dog luticce ma lunebi, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno ducu opoto i kom jo Juda pi cik pa Rwot, wek okwanygi woko ki i nyime, pi bal pa Manace, ki pi gin ducu ma yam otiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok pi remo pa io ma pe ki bal ma en ooyo noŋo; pien opoŋo Jerucalem ki remo pa jo ma pe ki bal, ma Rwot pe twero timo iye kica.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok kom Yekoyakim mudoŋŋe ducu, ki gin ma yam otiyo, gityeko coyone i buk me Tekwaro pa Luker me Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoyakim oto, oywe, kacel ki kwarine ci wode Yekoyakm aye oleyo ka tyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka me Ejipt pe dok onwoyo a ki i lobone, pien onoŋo kabaka me Babilon otyeko mayo lobo woko ki i cin kabaka me Ejipt, cakke ki i nota ora me Ejipt mo kwede wa i kulu Euprate ducu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoyakin ocamo ker ma mwaka me ditte apar wiye aboro, ci obedo ka loc ki i Jerucalem pi dwe adek. Nyiŋ minne Nekocita, nya pa Elnatan me Jerucalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedo ka tiyo gin ma nen marac i waŋ Rwot, kun lubo gin ducu ma yam wonne otiyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno en aye lutic pa Nebukadnejar, kabaka me Babilon, obino kwede i Jerucalem, ci monnye orumo gaŋ woko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Nebukadnejar ocito i Jerucalem I kare ma luticce gurumo woko-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.24+JER.22.25+JER.22.26+JER.22.27+JER.22.28+JER.22.29+JER.22.30"
              },
              "items": [
                {
                  "text": "Jer 22.24-30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.1+JER.24.2+JER.24.3+JER.24.4+JER.24.5+JER.24.6+JER.24.7+JER.24.8+JER.24.9+JER.24.10"
              },
              "items": [
                {
                  "text": "24.1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.1+JER.29.2"
              },
              "items": [
                {
                  "text": "29.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ci Yekoyakin kabaka me Juda oye mine kekene i ciŋ kabaka me Babilon, en kikome, ki minne ki luticce, ki rwodine, ki ludito ma i kalle. Kabaka me Babilon otweyo en macalo lamabuc i mwaka me locce me aborone. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otero bene jami ducu ma gikano i ot lim ma i ot pa Rwot, ki jami ma gikano i ot lim pa kabaka, ka otoŋo jami me jabu ma i ot, pa Rwot onidogi woko ducu, gin jarm ma yam Solomon kabaka me Icrael otiyo, kit ma yam Rwot oloko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otero jo me Jerucalem ducu i opii, rwodi ducu, tworu oteka lweny ducu. Jo ma giyakogi guromo alip apar, kacel ki ludiro tic mapatpat ducu ki lutet nyonyo. Pe dano acel mo odoŋ, kono jo ma lucan atika aye gudoŋ i lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12"
              },
              "items": [
                {
                  "text": "Ejek 17.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka doŋ otero Yekoyakin woko i opii wa i Babilon; min kabaka ki mon pa kabaka, luditone ki rwodi ma giloyo lwak ma i lobo-nu, oterogi i rok me bedo opii nia ki i Jerucalem nio wa i Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka me Babilon otero lwak opii ma gin ducu oteka lweny ma giromo alip abiro, ludiro tic mapatpat ki lutet ma giromo alip acel, gin ducu jo matego ma giromo mony. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.1"
              },
              "items": [
                {
                  "text": "Jer 37.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.13"
              },
              "items": [
                {
                  "text": "Ejek 17.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabaka me Babilon dok oketo Matania ma omin won Yekoyakin obedo kabaka ma oleyo ka tyene, ci oloko nyiŋe odoko Jedekia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
    },
