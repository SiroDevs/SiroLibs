            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Peka wod pa Remalia ma ladit, pa askarine ocako piro lok i kome, kacel ki jo pyerabic me Gilead, ci oneko en woko i Camaria, ki i gogo me ot pa kabaka, ci odoko kabaka ma kakare. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
