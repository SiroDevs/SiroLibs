                "loc": "2KI.10.30"
              },
              "items": [
                {
                  "text": "2 Luker 10.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man aye lok ma Rwot yam owaco ki Yeko ni, “Likwayi gibibedo i wi komker me Icrael nio wa i yalwak me aŋwenne”, ci otimme kit meno.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
      ]
