          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "En obedo ka tiyo gin ma nen marac i wan Rwot, pe obwoto lubo kit bal pa Jeroboam wod pa Nebat, ma en omiyo jo Icrael bene gubalo-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
