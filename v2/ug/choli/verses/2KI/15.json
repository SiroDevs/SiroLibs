          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Calum wod pa Jabec ocako loc i mwaka me pyeradek wiye aboŋwen me loc pa Ujia kabaka me Juda, ci obedo ka loc pi dwe acel ki i Camaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Menakem wod pa Gad oa ki i Tiŋa, obino i Camaria, ci ocobo Calum wod pa Jabec ki i Camaria oreto woko piny, oneko woko, ci odoko kabaka ma kakare. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok kom Calum mudoŋŋe ducu, ki lok ma en opiro, nen, gityeko coyone i buk me Tekwaro pa Luker me Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno Menakem ojwero gaŋ me Tapua woko, ki jo ma gibedo iye ducu, ki lo bo ma i ŋete, nia wa i Tiŋa; pien pe guye yabo doge wek en odony, mumiyo en ojwero woko, kun ryeko i mon ducu ma kunnu ma gitye ki ico",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
