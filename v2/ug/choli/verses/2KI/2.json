              "2KI.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.17"
              },
              "items": [
                {
                  "text": "Nwo 21.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gutyeko ŋolo loka tuŋcel, Elia owaco bot Elica ni, “Leg gin ma abitimo piri, ma peya gikwanya woko ki boti.” Elica owacci, “Alegi, imiya ale kit cwinyi-ni adod tyen aryo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elia ogamo ni, “Ilego gin matek; ento ka ce ibedo ka neno an i kare ma gitiŋa nia ki boti-ni, ci bibedo boti kit meno; ento ka ce pe inena, ci pe bibedo kit meno,” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onoŋo pud giwoto kun giloko, ci nen, gadigadi me mac ki aguragura opoko kingi gin aryo-ni woko, Elia ocako ci to woko malo i polo ki lapiru madit-ti, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.11",
            "verseOrgIds": [
              "2KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.14"
              },
              "items": [
                {
                  "text": "2 Luker 13.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elica oneno ci okok ni, “Wora, wora do! gadigadi pa Icrael ki wegi aguragurane!” Pe dok omedo ki neno kome.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En omako boŋone kikome oyeco woko i dul aryo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka okwanyo boŋo pa Elia ma opoto piny mua ki i kome-ni, odok kwede cen ci ocuŋ i dog Jordan. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwanyo boŋo pa Elia ma opoto ki i kome-ni, ocako goyo ki pii, kun wacci, “Rwot Lubaŋa pa Elia tye kwene?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka otyeko goyo pii, ci pii iye opokke yo tuŋŋi ki tuŋŋi; Elica owoto i dyere, oŋolo loka kulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lwak lunebi ma onoŋo gitye i Jeriko guneno en okato loka tuŋ botgi, ci guwacci, “Cwiny ma yam tye i kom Elia otyeko gamo Elica.” Gubino ka romo kwede, ci guguŋo piny i nyime. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giwacce ni, “Nen, wan luticci watye ki jo matego pyerabic. Walego icwalgi gucit ka yenyo rwodi; gwok nyo Cwiny pa Rwot otiŋe ci obole woko wa i got nyo i nota-gu.” En ogamo ni, “Pe wubicwalogi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka gubedo ka dido en nio ka lewic omake, owacci, “Wucwalgi.” Ci gucwalo jo pyerabic; gubedo ka yenyo Elia pi nino adek ci pe gunoŋo kome, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gudwogo bot Elica i kare ma en pud tye i Jeriko, ci owaco botgi ni, “An pe nene awacciwu ni, Pe wuciti?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo ma i gaŋ meno guwaco bot Elica ni, “Nen ba, gaŋ man tye-i kabedo maber ma yomo cwiny, kit ma in laditwa ineno-ni, Ento piine aye rac, ki lobone bene mi yo i mon poto woko.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "En owacci, “Wukella awal kwon manyen, ci wuony iye kado.” Ci gucako kelone bote. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ocito wa i wan pii ci oonyo iye kado-nu, kun wacci, “Rwot owaco kuman ni, An doŋ atyeko yubo wan pii man odoko maleŋ; pe doŋ bikelo to, pe miyo i mon poto.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno pii ocako doko maleŋ nio wa onyoo, kit macalo yam Elica olokoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
