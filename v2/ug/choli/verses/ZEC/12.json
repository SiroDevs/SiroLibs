                "loc": "MAT.24.30"
              },
              "items": [
                {
                  "text": "Mat 24.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Yabo 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Abionyo cwiny me kica ki cwiny me bako dog i kom ot pa Daudi ki i kom jo ma bedo i Jerucalem, wek ka gineno ŋat ma gicobo, ci gikum pire, macalo ŋat ma kumo pi latinne acel keken ma en onywalo, kun kok matek macalo dano ma koko latin kayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino meno kumo bibedo dit twatwal i Jerucalem ma rom ki kumo pi Adad-rimmon i bar me Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobo bikumo, kun jo me doggola acel acel kumo pigi kengi; jo me ot pa Daudi pat kun noŋo mongi bene kumo pat; jo me ot pa Natan pat kun mongi bene kumo pat; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo me ot pa Levi pat kun mongi bene kumo pat; jo me doggola pa Cimei pat kun mongi bene kumo pat. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki jo ducu me doggola mukene ma gudoŋ, acel acel bikumo pigi kengi, kun mongi bene gikumo kengi pat.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
