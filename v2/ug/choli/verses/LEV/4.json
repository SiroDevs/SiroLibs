          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biketo ciŋe i wi gitum me bal, ci neko i kabedo ma gineko iye gitum awana-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
            "verseOrgIds": [
