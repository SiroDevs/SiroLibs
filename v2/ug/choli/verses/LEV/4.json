              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka laloc mo aye obalo ma pe otimo akaka, kun otiyo gin mo acel i kom gin ducu ma yam Rwot Lubaŋane ociko ni pe gitim, ci otiŋo alii, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka gimiyo en oŋeyo bal ma en otimo-ni, ci en bikelo dyel pi gityerre, nyok ma kome pe ki mwonyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biketo ciŋe i wi dyel, ci neko i kabedo ma gineko iye gitum awaŋa i nyim Rwot; co aye gitum me bal. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajwaka bigwelo remo me gitum me bal ki lwet ciŋe, ci reyo i kom ten keno aŋwen me keno tyer me gitum awaŋa; remo mudoŋŋe en bionyo woko i te tedi keno tyer me gitum awaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "En biwaŋo dwolone ducu i wi keno tyer, macalo dwolo me gityer lakwecwiny; kit meno ajwaka bitimo gin lakwany bal ki i kome pi balle, ci Rwot biweko balle.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
    },
