              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses okwanyo moo wir ki remo man ok ma i wi keno tyer, okiro i kom Aron ki i kom boŋŋi arukane, ki i kom awo bene ki boŋŋi arukagi; kit meno okwero Aron ki boŋŋi arukane, ki awobene ki boŋŋi arukagi, gudoko maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
