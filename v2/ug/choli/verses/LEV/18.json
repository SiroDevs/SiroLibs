                "loc": "LEV.20.18"
              },
              "items": [
                {
                  "text": "Levi 20.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pe ibinyiko cok ki dako me bedo kwede i kare ma en tye ki kwer, ma peya olonnye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
            "verseOrgIds": [
              "LEV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Levi 20.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe ibibuto ki dako pa lawoti me bedo kwede, miyo ijerre kekeni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.1+LEV.20.2+LEV.20.3+LEV.20.4+LEV.20.5"
              },
              "items": [
                {
                  "text": "Levi 20.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe ibityero latinni mo me awaŋa ki mac bot jok Molek, pe ibipyedo nyiŋ Lubaŋani kulu; an a Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.13"
              },
              "items": [
                {
                  "text": "Levi 20.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe ibibuto ki laco macalo ibuto ki dako; meno tim gwok. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
