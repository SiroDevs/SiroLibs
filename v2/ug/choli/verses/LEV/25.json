                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce omeru ma bedo ka ŋeti odoko lacan ma pe twero konnye kekene, in ibikonye; en bibedo boti macalo weloni nyo labedo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe igam lim mo me magoba ki bote nyo pe imed wiye, ento lwor Lubaŋani, wek omeru obed kwo ki ka ŋeti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Nia 22.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Nwo 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe ibimiyo en mako banya boti wek inoŋ iye magoba, pe imiye cam wek odwok boti kun omedo wiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "An a Rwot Lubaŋawu ma yam akwanyowu ki i lobo Ejipt wek amiwu lobo Kanaan, abed Lubaŋawu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
