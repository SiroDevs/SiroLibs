              "2CO.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.1"
              },
              "items": [
                {
                  "text": "Tic 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ma doŋ ao i Teroa pi tito lok me kwena maber i kom Kricito, yam anoŋo ni Rwot oyabba yo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento cwinya pe opye pien pe anoŋo omera Tito kunnu. Ci aciko jo kunnu, ka akato acito i Makedonia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myero gipwo Lubaŋa ma nino ducu tye ka telowa i dorre me nyuto loc pa Kricito, dok tiyo kwedwa wek Kricito oŋene, macalo gin makur ma ŋwece duny i kabedo ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien wan wacal ki gin makur ma Kricito owaŋo otyero bot Lubaŋa, ma ŋwece duny mamit; jo ma tye i yo me larre ki jo ma tye i yo me rwenyo woko doki giŋweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ bot jo ma tye ka rwenyo, ŋwecwa obedo gin muto ma kelo to; ento ki bot jo ma tye ka larre, ŋwecwa obedo gin makwo ma kelo kwo. Aŋa mono ma twero tic man? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wan pe wacal ki pol pa dano mukene, ma girubo lok pa Lubaŋa ki lok mukene, macalo lucatwil ma pe genne; ento wan watito mere lok pa Lubaŋa keken, watito i Kricito ma cwinywa leŋ i nyim Lubaŋa, macalo jo ma Lubaŋa ooro.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
      ]
    }
  ],
