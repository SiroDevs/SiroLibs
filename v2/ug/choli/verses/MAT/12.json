                  "text": "Mar 9.40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ŋat ma pe tuŋ bota, meno noŋo en lakworra, dok ŋat ma pe nywako coko kweda, keto mere aketa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.30",
            "verseOrgIds": [
              "MAT.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno awacciwu ni, bal ducu ma dano timo, ki lok ducu ma giyeto kwede Lubaŋa, gibiwekone woko, ento bal me yet ma giyeto ki Cwiny Maleŋ pe gibiwekone matwal. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.31",
            "verseOrgIds": [
              "MAT.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.10"
              },
              "items": [
                {
                  "text": "Luka 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dok dano ma loko lok marac i kom Wod pa dano gibiweko balle; ento ŋat ma loko lok marac i kom Cwiny Maleŋ pe gibiweko balle, kadi i kare man nyo i kare ma bino anyim.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        }
      ]
