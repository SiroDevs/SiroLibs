                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jo mogo i kin lupwony-cik ki Luparicayo guwaco bot Yecu ni, “Lapwony, wamito neno lanyut mo ma a ki boti.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.38",
            "verseOrgIds": [
              "MAT.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
