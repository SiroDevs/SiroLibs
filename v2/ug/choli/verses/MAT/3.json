                {
                  "text": "Mar 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kun wacci, “Wuŋuti, pien ker me polo doŋ onyiko cok.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        },
        {
