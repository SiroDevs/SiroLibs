            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "Luka 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci dwan ocako winnye ma a ki i polo ma wacci, “Man aye Woda ma amare, ma cwinya yom i kome.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
