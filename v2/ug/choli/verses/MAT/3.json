          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Ic 40.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien man aye dano ma yam lanebi Icaya otito pire ni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
