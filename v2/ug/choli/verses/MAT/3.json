        },
        {
          "text": "I kare meno Jon Labatija obino kun tito lok i tim me Judaya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
