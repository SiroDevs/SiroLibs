              },
              "items": [
                {
                  "text": "Mar 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.39"
              },
              "items": [
                {
                  "text": "Luka 2.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.45"
              },
              "items": [
                {
                  "text": "Jon 1.45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Ic 11.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " En ocito obedo i gaŋ ma nyiŋe Najaret, wek gin ma yam lunebi guloko ocobbe kakare ni, “Gibilwoŋe ni Lanajaret.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.23",
            "verseOrgIds": [
              "MAT.2.23"
            ]
          }
        }
      ]
    }
