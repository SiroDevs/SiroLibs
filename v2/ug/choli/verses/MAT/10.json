                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.35"
              },
              "items": [
                {
                  "text": "Mar 8.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.24"
              },
              "items": [
                {
                  "text": "Luka 9.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "17.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Jon 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dano ma noŋo kwone, birwenyo kwone woko arwenya; ento ma rwenyo kwone pira binoŋo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.39",
            "verseOrgIds": [
              "MAT.10.39"
            ]
          }
        }
      ]
    },
