        },
        {
          "text": "Ka inen guketo ayela i komwu i gaŋ acel, ci wuriŋ woko i gaŋ ma cok kwede; pien ada awacciwu ni, pe wubiwoto i gaŋi me Icrael wurumo woko ducu, ma noŋo peya Wod pa dano obino.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.23",
            "verseOrgIds": [
              "MAT.10.23"
            ]
          }
        }
