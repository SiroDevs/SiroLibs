              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.12"
              },
              "items": [
                {
                  "text": "Mar 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.16"
              },
              "items": [
                {
                  "text": "Luka 21.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omego bimiyo ominne ni ginek woko, ki wego bene bimiyo latinne ni ginek woko, ki litino gibitugge i kom lunyodogi, gimiyo lunyodogi ni ginekgi woko; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.21",
            "verseOrgIds": [
              "MAT.10.21"
            ]
          }
        },
        {
