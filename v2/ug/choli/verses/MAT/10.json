                "loc": "LUK.10.3"
              },
              "items": [
                {
                  "text": "Luka 10.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nen, doŋ acwalowu me cito woko macalo romi i kin orudi; pi meno wubed ryek calo twol dok wubed laboŋo bal mo i komwu calo akuri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
