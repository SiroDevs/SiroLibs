        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.34"
              },
              "items": [
                {
                  "text": "Mat 9.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.24"
              },
              "items": [
                {
                  "text": "12.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.22"
              },
              "items": [
                {
                  "text": "Mar 3.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.15"
              },
              "items": [
                {
                  "text": "Luka 11.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ento romo ka dano ma gipwonyo-ni odoko calo ŋat ma pwonye, ki latic bene ka odoko calo laditte. Ka onoŋo gulwoŋo won ot ni Beeljebul, ci doŋ jo ma i pacone gibilwoŋogi ki nyiŋ marac ma rom mene?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.25",
            "verseOrgIds": [
              "MAT.10.25"
            ]
          }
        }
      ]
    },
    {
