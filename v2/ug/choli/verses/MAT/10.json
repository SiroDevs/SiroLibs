                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Dano ma pud gipwonyo apwonya pe bedo dit makato ŋat ma pwonye, kadi latic bene pe bedo dit makato laditte; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.24",
            "verseOrgIds": [
              "MAT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
