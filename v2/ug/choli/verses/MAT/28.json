              },
              "items": [
                {
                  "text": "Luka 3.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pi meno doŋ wuciti wucilok jo me rok ducu gudok jo ma luba, kun wubatijagi i nyiŋ Won ki Wod ki Cwiny Maleŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.19",
            "verseOrgIds": [
              "MAT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wupwonygi me gwoko gin ducu ma doŋ atyeko cikowu kwede. Nen, atye kwedwu kare ducu, nio i agikki piny.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.20",
            "verseOrgIds": [
              "MAT.28.20"
            ]
          }
        }
