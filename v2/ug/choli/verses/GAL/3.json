          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 3:21"
          },
          "items": [
