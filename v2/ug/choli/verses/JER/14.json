          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco kuman i komjone ni, “Yam gumaro wot atata kit meno, pe gujuko tyengi ka wot; pi meno omiyo Rwot pe gamogi. Kombeddi doŋ en bipo i kom bal megi ci biketo can i komgi pi balgi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
