            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Rwot, dok atyeko moko kit jami aŋwen maraco ma bityekogi: gibinekogi woko liweŋ ki pala lucwan, gwogi biywayo komgi muto-ni bedo me acamagi, winyo bene gibicamo komgi; ki lee mager me tim doŋ gibimwodogi gityekogi woko liweŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
