                }
              ]
            }
          ]
        },
        {
          "text": "Lacen Rwot owacca ni, “Kadi bed Moses ki Camuel gubedo ka Cuŋ i nyima kun gipido kweda, an kica pe bimaka i kom lwak man wacel. Wek gua ki i nyima gucit woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Yabo 13.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka ce inen gupenyo ka kwene ma myero gicit iye, wuwac botgi ni an Rwot awaco botgi ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
