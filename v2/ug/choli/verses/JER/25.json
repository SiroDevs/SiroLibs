              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Rwot owaco bota ni, “Tit bot lwak ni an Rwot me mony, Lubaŋa pa Icrael, acikogi me mato akemona nio waŋ ma gumer dok gunok, nio ka gupoto piny ma pe doŋ gitwero a malo pi lweny ma abecwalo i komgi-ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
