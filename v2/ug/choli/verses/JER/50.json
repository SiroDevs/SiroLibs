          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owacci,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
