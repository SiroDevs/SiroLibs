            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.6"
              },
              "items": [
                {
                  "text": "Yabo 18.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wulwon wegi atum me lweny i kom Babilon. Wucwal jo ducu ma giŋeyo telo atum ki celo atero guciti. Wurum gaŋ woko, pe wuwek ŋat mo obwoti. Wucul kwor i kome pi gin ducu ma yam en otimo, dok bene wutim en kit macalo yam en otimo kwede jo mukene-ni, pien en yam oette i koma ki wakke madit, an Rwot ŋat Maleŋ pa Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno awobegi gibinekogi woko i dye gaŋ, ki askarine bene gibinekogi gityekogi woko i nino meno. Man Rwot ma owaco.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
