                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.35"
              },
              "items": [
                {
                  "text": "Jer 32.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyubo waŋ jok i nota pa wod pa Kinom ma gilwoŋo ni Topet, ka ma gitwero waŋo iye awobegi ki anyiragi ki mac. Pe yam acikogi ni gutim kit meno, dok bene pe abedo ka tamo lok macalo meno wacel. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno, nen, kare tye ka bino ma pe dok gibilwoŋo ni Topet, nyo nota pa wod pa Kinom. Gibilwoŋo ni nota me Nek: pien gibiyiko dano i Topet, pien kabedo mo pe tye ka mukene kadi ki acel. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ kom jo magi ma guto-ni bidoko cam pa winyo ki pa lee me tim; ŋat mo pe ma biryemogi woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
