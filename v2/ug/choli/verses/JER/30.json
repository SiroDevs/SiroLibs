              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot me mony owaco ni, “Ka nino meno oromo abituro rii bao woko ki i ŋutgi dok bene abicodo nyor ma gitweyogi kwede woko; cakke i kare meno pe doŋ gibibedo opii pa lurok matwal. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bnto gin gibitiyo bot Rwot Lubaŋagi, ki bot Daudi kabakagi, ma an aye abimiyo botgi me bedo kabakagi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.22",
            "verseOrgIds": [
              "JER.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koŋ inen yamo kot pa Rwot! Akemone bedo calo yamo lapiru mager, ma bimwoc woko lituc i wi jo maraco. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.23",
            "verseOrgIds": [
              "JER.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akemone pe bigik nio waŋ ma en ocobo tiyo gin ma onoŋo doŋ otamo me timone. I kare ma lacen, i nino ma pud tye anyim, jone gibiniaŋ maber makato.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.24",
            "verseOrgIds": [
              "JER.30.24"
            ]
          }
        }
      ]
