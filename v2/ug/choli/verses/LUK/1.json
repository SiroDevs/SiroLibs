          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "LUK 1:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonne Jekaria opoŋ ki Cwiny Maleŋ, oloko macalo lanebi ni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
          }
        }
