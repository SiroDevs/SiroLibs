          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cabit, guywe kit macalo cik tye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
