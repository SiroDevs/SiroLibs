                "loc": "MAT.8.11"
              },
              "items": [
                {
                  "text": "Mat 8.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dano gibibino kun gia ki tuŋ wokceŋ, ki tuŋ potoceŋ, ki yo tuŋ acam, ki tuŋ yo acuc, gibibedo piny i dog cam i ker pa Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
