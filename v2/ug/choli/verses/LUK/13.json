              "items": [
                {
                  "text": "Mar 10.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nen, jo mogo ma lacen gibibedo meati, ki jo mogo meati gibibedo me lacen.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
