                }
              ]
            }
          ]
        },
        {
          "text": " Kunnu wubikok, wubikayo lakwu, ka wuneno Abraim ki Icaka ki Yakobo ki lunebi ducu kun gitye i ker pa Lubaŋa, ento wun kikomwu gibolowu woko. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
