                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.16"
              },
              "items": [
                {
                  "text": "Jon 13.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.20"
              },
              "items": [
                {
                  "text": "15.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lapwonnye pe dit kato dano ma pwonye; ento dano ducu ka doŋ gipwonyogi maber, gibidoko macalo lapwonygi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŋo ineno cuŋ kal ma tye i waŋ omeru, ento dul yat ma tye i waŋi in kikomi pe ineno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.41",
            "verseOrgIds": [
              "LUK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo itwero waco bot omeru niŋniŋ ni, ‘Omera, wek akwany cuŋ kal ma tye i waŋi-ni woko,’ kun in kikomi pe ineno dul yat ma tye i waŋi In lagoba, koŋ ikwoŋ kwanyo dul yat ma tye i waŋi-ni woko, ci miyo doŋ ineno piny maber me kwanyo cuŋ kal ma tye i waŋ omeru ca.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.42",
            "verseOrgIds": [
              "LUK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pien pe tye yat maber ma twero nyako nyige maraco; ki yat marac bene pe twero nyako nyige mabeco; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.43",
            "verseOrgIds": [
              "LUK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.33"
              },
              "items": [
                {
                  "text": "Mat 12.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " yat acel acel giŋeyo pi nyige. Pe gipwono olam ki i kom oryaŋ, dok bene pe gipwono olok ki i kom ocok. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.44",
            "verseOrgIds": [
              "LUK.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.34"
              },
              "items": [
                {
                  "text": "Mat 12.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dano maber kwanyo gin maber i kin jami mabeco ma en okano i cwinye, dano marac kwanyo gin marac ma i kin jami maraco ma en okano, pien dog dano loko gin ma opoŋ i cwinye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Piŋo wulwoŋa ni, ‘Rwot, Rwot,’ kun pe wutiyo gin ma acikowu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.46",
            "verseOrgIds": [
              "LUK.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano ducu ma bino bota ma winyo lokka, dok tiyo, abinyuto botwu ŋat ma en cal kwede. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.47",
            "verseOrgIds": [
              "LUK.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rom ki dano ma ogero ot ma okwinyo matut, ma ocibo guti i kom pata got; ka pii opoŋ, ci kulu ocorre i kom ot, ento pe otwero yeŋone, pien bigero maber. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.48",
            "verseOrgIds": [
              "LUK.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento dano ma winyo lokka kun pe tiyo, rom ki dano ma ogero ot i ŋom laboŋo guti; ka kulu omol ki tek i kome, oyotoyot opoto, ogannye woko piny lirubuku.”",
          "type": "text",
          "attrs": {
