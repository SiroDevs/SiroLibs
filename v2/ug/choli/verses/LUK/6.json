                "loc": "MAT.15.14"
              },
              "items": [
                {
                  "text": "Mat 15.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yecu obolo botgi carolok. Owacci, “Latowaŋ twero peyo latowaŋ lawote Gin aryo ducu pe gibipoto woko i bur? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.39",
            "verseOrgIds": [
              "LUK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
