                "loc": "JON.3.4"
              },
              "items": [
                {
                  "text": "Yon 3.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien kit macalo Yona yam odoko lanyut bot jo Nineve, kit meno Wod pa dano bene bidoko lanyut bot yalwak me kare man. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
