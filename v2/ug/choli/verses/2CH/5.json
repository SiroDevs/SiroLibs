                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Tek 15.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Solomon ocoko ludoŋo pa jo Icrael ki ludito wi kaka ducu, ma gin aye lutel wi doggola pa kwarogi ma i kin jo Icrael, ci gubino i Jerucalem pi kwanyo canduk me gicikke pa Rwot ki i gaŋ kal pa Daudi, ma gilwoŋo ni Cion. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci lwak jo Icrael ducu gucokke i nyim kabaka pi nino madito ma tye i dwe me abiro-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ludoŋo pa jo Icrael ducu gubino, ci Lulevi gucako tino canduk me gicikke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gutero canduk ki kema me rwatte, kacel ki jami maleŋ ducu ma yam tye i kema; ajwagi ki Lulevi gukelogi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Solomon ki lwak jo Icrael ducu ma gucokke bote-ni, gubedo i nyim canduk kun gitumo romi ki twoni-gu mapol ma welgi pe kwanne dok pe nene bene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno ajwagi gucako kelo canduk me gicikke pa Rwot wa i kabedone ma i tyelo me ot, en aye kabedo maleŋ makato ducu-ni, ci guketo piny i te bwom lukerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukerubi guyaro bwomgi ka wi kabedo me canduk wek lukerubi guum wi canduk woko kacel ki tal latiŋŋe ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok tal latiŋŋe yam wigi nen ki i kabedo maleŋ ma i nyim kabedo maleŋ ma i tyelo-ni; ento pe gitwero nenogi ki woko; pud gitye kunnu nio wa onyoo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Nwo 10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin mo onoŋo pe tye i canduk, kono kidi aryo ma apada keken ma yam Moses oketo i iye ki i Koreb, ka ma yam Rwot oketo iye gicikke ki jo Icrael, i kare ma gia ki i lobo Ejipt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
