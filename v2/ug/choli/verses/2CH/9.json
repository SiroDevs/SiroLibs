              "items": [
                {
                  "text": "Luka 11.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare ma kabaka ma dako me lobo Ceba owinyo pi yweka pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        }
