                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Nwo 16.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En obedo ka miyo gityer kit ma tic me nino acel acel mito kwede, kun lubo cik pa Moses i cen cabit ducu, ki i por dwe, ki i nino madito adek me mwaka ki mwaka-ni, ma gin aye nino madito me Mugati ma Tobi Pe Iye, nino madit me kwero Agikki Cabit Abiro, ki nino madito me Bolo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit macalo yam wonne Daudi ociko, en oketo lwak dul pa ajwagi ki dog ticgi, ki Lulevi gi dog ticgi me pako Lubaŋa ki me tic i nyim ajwagi, muporo tic me nino acel acel. Opoko bene tic pi lugwok doggola ducu ki dulgi i doggola acel acel, kit ma Daudi ma dano pa Lubaŋa yam ociko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gubedo ka lubo cik ma kabaka ociko ki ajwagi ki Lulevi, pe guweko gin mo ma mako lok ducu, ki ma mako kano limo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
