        },
        {
          "text": "Lwak ma gin wegi lobo gukwa nyo Yekoakaj wod pa Yocia, ci guketo en kabaka me leyo ka tyen wonne i Jerucalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoakaj ocamo ker ma mwaka me ditte pyeraryo wiye adek, ci obedo ka loc i Jerucalem pi dwe adek. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Kabaka me Ejipt oryemo Yekoakaj woko ki i ker ka oketo wel ajog mapek i kom jo Juda i wel me kilo alip abic me ryal ki kile pyerabic me jabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Jer 22.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabaka me Ejipt oketo Eliakim omin Yekoakaj obedo kabaka me Juda ki me Jerucalem ci ocako loko nyiŋe Yekoyakim; ento Neko okwanyo Yekoakaj otero woko i Ejipt.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
