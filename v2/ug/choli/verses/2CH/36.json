                "loc": "JER.34.1+JER.34.2+JER.34.3+JER.34.4+JER.34.5"
              },
              "items": [
                {
                  "text": "34.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot ocako kela kabaka pa jo Kaldaya ka lweny i komgi, ci oneko awobe ki pala lucwan ki i kabedo maleŋ ma i ot pa Lubaŋa, pe obedo ki kica i kom awobi nyo nyako, jo muteggi nyo jo muti; magi ducu Lubaŋa omiyogi woko i ciŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki jami ducu ma yam gitiyo kwedgi i ot pa Lubaŋa, jami madito ki matinone, ki lonyo ma gikano i ot pa Rwot, ki lonyo ma kabaka okano ki pa rwodine ducu, kabaka pa jo Kaldaya otero woko ducu i Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giwaŋo ot pa Lubaŋa woko, ka dok gimuko cel murumo Jerucalem, ci giwaŋo odi ma gibedo iye woko ducu ki mac, kun gibalo bene wa jami ma pigi tego, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "En otero jo ma guloyo ki i lak to i Babilon, ci gudoko opiine ki pa litinone nio ka ker me Percia ocuŋ matek. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Jer 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man obedo pi cobo lok pa Rwot ma yam oloko ki i dog Jeremia, nio wan ma lobo otyeko kwero cabitte ducu. Pi kare ducu ma lobo giweko ata noŋo tye ka kwero karene me yweyo mot macalo i ceŋ cabit, nio ka wel mwaka ocobo kakare ma oromo pyerabiro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
