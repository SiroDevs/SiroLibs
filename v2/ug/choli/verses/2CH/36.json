              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot, Lubaŋa pa kwarigi, obedo ka cwalo lok botgi teretere kun oro lukwenane me tito botgi, pien kica omako en i kom lwakke ki pi kabedo mere; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
