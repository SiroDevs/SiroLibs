          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gineko jo Piliciti i nino meno cakke ki i Mikmac o wa i Aijalon. Onoŋo kec obwoyo dano mada; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci dano gucako mwomme i kom I im ma giyako, ci gumako romi ki twoni ki roci-gu guradogi woko piny, ci lwak gucako mwodo riŋone kacel ki remo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
