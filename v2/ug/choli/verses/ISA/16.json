          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye lok ma yam Rwot oloko con i kom Moab. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento kombeddi Rwot owacci, “I mwaka adek ma obedo calo mwaka pa lapakaca-ni, deyo pa Moab bidoko gmacaya kadi bed en tye ki lwak jo mapol at; jo ma bidoŋ gibibedo nok twatwal, dok bene noŋo dok gin jo ma goro keken.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
