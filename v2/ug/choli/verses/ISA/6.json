                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I mwaka ma kabaka Ujia oto iye, aneno Rwot mubedo i wi komkerre, kun onyedde malo, madit twatwal, ma dog boŋone opoŋo i ot pa Lubaŋa woko liweŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
