            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lucerapi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.2",
              "type": "text"
            },
            {
              "text": "Lucerapi",
              "type": "text"
            },
            {
              "text": "gin lumalaika pa Lubaŋa Nyiŋgi te lokke gin ma ryeny calo mac.",
              "type": "text"
            }
          ]
        },
        {
          "text": " gucuŋ malo ka wiye, ma lacerapi acel acel bwome tye abicel; aryo me umo wangi, aryo me umo tyengi, ki aryo mukene me tukgi malo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Yabo 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Onoŋo gitye ka wer ma ŋat acel acel gamo dog lawote ni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
