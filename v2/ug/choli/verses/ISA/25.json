                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "21.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot Lubaŋa doŋ bimwonyo to woko matwal, dok en bidunyo pig waŋ dano woko ducu, ci kwanyo lewic woko ki i wi jone i nyim jo ducu i wi lobo; pien man lok ma Rwot aye owaco.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
