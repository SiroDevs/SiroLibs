          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "okelo wiye i weer, omiyo bot nyako; nyako omiyo bot minne. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.28",
            "verseOrgIds": [
              "MRK.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lupwonnye pa Jon guwinyo pire, gucito gutiŋo kome, guyiko i lyel.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.29",
            "verseOrgIds": [
              "MRK.6.29"
            ]
          }
        }
