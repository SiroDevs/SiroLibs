              "items": [
                {
                  "text": "Luka 14.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yecu olwoŋo lwak bote kacel ki lupwonnyene, ci otito botgi ni, “Ka ce dano mo mito lubo kora, myero okwoŋ kwerre kekene, ka ocak tiŋo yatariyane, olub ki kora.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
