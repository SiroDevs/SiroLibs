    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok oloko botgi, ni “Adada awacciwu ni, tye jo mogo ma gucuŋ i kinwu kany ma pe gibibilo to wacel, nio waŋ ma guneno ka ker pa Lubaŋa doŋ otyeko bino ki tek.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.1",
            "verseOrgIds": [
              "MRK.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.1",
            "verseOrgIds": [
              "MRK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 9:2"
          },
          "items": [
