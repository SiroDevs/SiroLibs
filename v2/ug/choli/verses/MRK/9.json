          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ma kwidi ma camogi pe to, ki macce bene pe to.] ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.44",
            "verseOrgIds": [
              "MRK.9.44"
            ]
          }
        },
