                "loc": "LUK.22.24"
              },
              "items": [
                {
                  "text": "Luka 22.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gin guliŋ aliŋa, pien gubedo ka laro lok kekengi i waŋayo ni, “Aŋa ma ladit i kingi?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.34",
