            "sid": "MRK 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwanyo latin mo, ci omiyo ocuŋ i kingi, ka otiŋo i kore ci okwako, ocako waco botgi ni, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.36",
            "verseOrgIds": [
              "MRK.9.36"
            ]
          }
        },
        {
