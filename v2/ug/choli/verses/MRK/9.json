              "items": [
                {
                  "text": "Luka 11.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien ŋat ma pe lakworwa, en aye lawotwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.40",
            "verseOrgIds": [
              "MRK.9.40"
            ]
          }
        },
