                {
                  "text": "Mat 10.42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Adada awacciwu ni, dano mo ma bimiyowu pii me amata i kikopo, pien wun jo pa Kricito, limo motte pe biloyo en kadi matidi mo.",
          "type": "text",
          "attrs": {
