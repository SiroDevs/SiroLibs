          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibino i Kapernaum. Ka gitye i ot, Yecu ocako penyogi ni, “Wubedo ka laro lok aŋo i waŋayo kekenwu-ni?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.33",
            "verseOrgIds": [
              "MRK.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
