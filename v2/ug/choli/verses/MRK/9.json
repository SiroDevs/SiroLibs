        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.29",
            "verseOrgIds": [
              "MRK.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua woko ki kunnu, guŋolo ki i Galilaya. Yecu pe omito ni dano mo oŋe pire, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.30",
            "verseOrgIds": [
              "MRK.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien onoŋo en tye ka pwonyo lupwonnyene kun waccigi ni, “Wod pa dano gibimiye i ciŋ dano; gibineke woko, ci en bicer woko i ŋe nino adek.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.31",
            "verseOrgIds": [
              "MRK.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento gin pe guniaŋ kit lokke-nu, dok gulworo penye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        }
      ]
    },
