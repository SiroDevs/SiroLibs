                  "text": "Luka 22.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yecu ka obedo piny ci olwoŋo jone apar wiye aryo, ocako waccigi ni, “Ka dano mo mito bedo mukwoŋo, myero en aye odoŋ cen i ŋe luwote ducu, en aye obed latic megi ducu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.35",
            "verseOrgIds": [
              "MRK.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
