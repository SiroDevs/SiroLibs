          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "dok pe gubedo ki cwiny maber bot litino pa Jerubaal, ma en aye Gideon, pi gin ducu maber ma yam otimo pi jo Icrael.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.35",
