          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Gideon doŋ oto, cutcut jo Icrael gulokke doki, gucako woro jogi Baal mapatpat ki tim kwete kwele, ci guketo Baal-berit",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.33",
              "type": "text"
            },
            {
              "text": "Baal-berit te lokke",
              "type": "text"
            },
            {
              "text": "Baal me gicikke.",
              "type": "text"
            }
          ]
        },
        {
          "text": " me bedo lubaŋagi, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Icrael pe doŋ gupo i kom Rwot Lubaŋagi, ma yam olarogi ki i ciŋ lumerokgi yo tuŋŋi ki tuŋŋi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.34",
            "verseOrgIds": [
              "JDG.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
