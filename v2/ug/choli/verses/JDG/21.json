            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Luŋol 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno onoŋo kabaka pe Icrael; dano acel acel tiyo gin ma co tamo ni tye atir.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
            "verseOrgIds": [
              "JDG.21.25"
            ]
          }
        }
