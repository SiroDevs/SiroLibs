          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuŋe ni wubilimo jami ducu ma Rwot oyubo wa con pi jone macalo bakacicgi. Wun lutic pa Rwotwa Kricito. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
