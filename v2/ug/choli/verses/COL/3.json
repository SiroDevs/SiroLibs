          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
