                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lacen aneno ot pa Lubaŋa, ma en kema lok me caden ma tye i polo; onoŋo oyabbe woko, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci lumalaika abiro gua ki i ot pa Lubaŋa gukatti woko ki gemo abiro. Onoŋo guruko boŋo camanini maleŋ adada, ma gutweyo korgi woko ki del jabu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci lee acel ki i kin lee makwo aŋwen-ni omiyo atabo jabu bot lumalaika abiro; onoŋo atabo magi gupoŋ woko ki kiniga pa Lubaŋa ma bedo kwo nakanaka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
