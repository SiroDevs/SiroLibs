            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok aneno gin mo ma nen calo nam me kiyo maleŋ ma orubbe ki mac; doŋ jo ma onoŋo gutayo lee ca ki calle, ki namba me nyiŋe, onoŋo gucuŋ i dog nam me kiyo, kun gumako naŋa pa Lubaŋa i ciŋgi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
