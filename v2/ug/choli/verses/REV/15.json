              },
              "items": [
                {
                  "text": "Nia 15.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onoŋo gitye ka wero wer pa Moses, ma obedo latic pa Lubaŋa, ki wer pa Latin romo kun giwacci,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
