              "items": [
                {
                  "text": "Yabo 16.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Doŋ ipo i kom gin ma ilimo ki ma iwinyo; gwok gin meno ento iŋuti. Ka ce pe ico, ci abibino boti macalo lakwo, ma in pe iŋeyo cawa ma abibino kwede i komi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.3",
            "verseOrgIds": [
              "REV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bed kumeno, pud itye ki jo mogo manoknok i Cardic ma peya gunywano boŋŋigi ki cilo. Gibiwoto kacel kweda ma noŋo guruko boŋŋi matar, pien gin aye gimyero. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.4",
            "verseOrgIds": [
              "REV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "Nia 32.32",
                  "type": "text"
                }
