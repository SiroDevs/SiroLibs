              "items": [
                {
                  "text": "Yubu 12.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bot lamalaika pa lwak muye an ma gitye i Piladelpia co kit man ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
