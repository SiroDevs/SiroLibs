              },
              "items": [
                {
                  "text": "Luka 12.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ŋat ma oloyo gibiruko kit meno ki boŋŋi mater, dok bene pe abijwayo nyiŋe woko ki i buk me kwo. Abituco nyiŋe i nyim Wora, ki i nyim lumalaikane. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ma ite tye myero owiny lok ma Cwiny Maleŋ oloko bot lwak ducu ma guye an.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
    },
