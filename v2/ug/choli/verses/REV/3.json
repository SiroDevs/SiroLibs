              "type": "text"
            }
          ]
        },
        {
          "text": "“Bot lamalaika pa lwak muye an ma gitye i Cardic co kit man ni, “ ‘Man lok pa ŋat ma tye ki cwiny pa Lubaŋa abiro, ki lakalatwe abiro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Aŋeyo ticci ducu; itye ki nyiŋ me bedo kwo, ento doŋ ito woko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Co woko ci ijiŋ gin ma pud odoŋ boti-ni obed tek, ma doŋ cok to-ni; pien anoŋo pe icobo ticci mo kakare i nyim Lubaŋana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.2",
            "verseOrgIds": [
              "REV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
