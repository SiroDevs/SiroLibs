            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.4"
              },
              "items": [
                {
                  "text": "Nwo 23.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3"
              },
              "items": [
                {
                  "text": "Wel 25.1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento atye ki lok mogo manoknok i komi, pien itye ki jo mogo kunnu ma gumako pwony pa Balaam, ma yam opwonyo Balak me keto ariya i nyim jo Icrael wek gupot i bal, kun obitogi ni gucam riŋo ma gityero bot jogi, ki me timo tim tarwaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno, in bene itye ki jo mogo ma gumako pwony pa jo Nikolaiti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce pe iŋut, ci abibino boti oyotoyot, ka doŋ alwenyo kwedgi ki pala lucwan me doga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        },
