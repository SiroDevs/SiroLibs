          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bot lamalaika pa lwak muye an ma gitye i Tuatira co kit man ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
