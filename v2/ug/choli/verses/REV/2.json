              },
              "items": [
                {
                  "text": "22.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bot lamalaika pa lwak muye an ma gitye i Cumurna co kit man ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        }
