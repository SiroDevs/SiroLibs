          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "REV 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ma ite tye myero owiny lok ma Cwiny Malaŋ oloko bot lwak ducu ma guye an.’",
          "type": "text",
