          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Man lok pa Wod pa Lubaŋa ma waŋe calo leb mac ma lyel, ki tyene ducu calo mola ma girudo maleŋ adada.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
