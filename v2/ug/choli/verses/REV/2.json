        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bot lamalaika pa lwak muye an ma gitye i Pergamo co kit man ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Man lok pa ŋat ma tye ki pala lucwan mabit ryoryo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Aŋeyo ka ma ibedo iye, ka ma kom pa Catan tye iye. In giri imako nyiŋa woko matek likiŋ, pe ikwero niyeni i koma, kadi ki i kare pa Antipac ma obedo cadenna me ada, dano ma lagen ma yam gineko i kinwu, ka ma Catan bedo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
