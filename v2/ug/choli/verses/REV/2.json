                "loc": "2KI.9.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento atye ki lok man i komi, pud iweko dako ca, Jejebel, ma lwoŋŋe kene ni en lanebi-ni, kun tye ka pwonyo luticca miyo giŋak woko i yo me tim tarwaŋ, ki camo riŋo mogo ma noŋo doŋ gityero woko bot jogi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo amiyo bote kare me ŋut, ento en okwero ŋut i tim tarwaŋe-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen,, abibolo dako-nu i wi kitanda ma noŋo two marac, pacogge bene abibologi woko i can madit atika, ka pe guŋut, gukwero lubo tim tarwaŋ pa dako-nu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
        {
