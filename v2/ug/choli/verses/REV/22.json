              "items": [
                {
                  "text": "2.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " An Alupa ki Omega, mukwoŋo ki me agikki, acakki ki agikki.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
