                "loc": "GEN.3.22"
              },
              "items": [
                {
                  "text": "3.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jo ma lwoko ginarukagi wek gibed ki twero me camo nyig yat me kwo, ki me donyo i gaŋ ma noŋo giwok ki i dogcel, jo-nu aye tye ki gum. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ŋe gaŋ woko tye iye jo ma timo tim calo gin gwogi, lutim tim jokjok, lutim abor, lunek dano, ki luwor cal jogi, ki jo ducu ma maro loko goba, kun gitiyo bene gin me gobagoba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
      ]
    },
