              },
              "items": [
                {
                  "text": "Jer 17.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nen, doŋ acok bino, kun akelo motta me pwoc, me culo dano acel acel muporo tic ma en otiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
