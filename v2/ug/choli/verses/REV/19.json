                  "text": "Ic 11.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lacen aneno polo oyobbe, cut atugi neno aguragura matar! Ŋat ma obedo i wiye gilwoŋo ni ŋat ma Genne dok me Ada, gin ma en timo ducu tye atir i ŋolo kop kadi wa i lweny bene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.6"
              },
              "items": [
                {
                  "text": "Dan 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waŋe ryeny calo mac, dok onoŋo oruko lalukana mapol me loc i wiye; onoŋo bene tye ki nyiŋ mo ma gigoro ma ŋat mo pe ŋeyo, kono en keken gire aye ŋeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oruko boŋo ma onoŋo giluto i remo, dok nyiŋ ma onoŋo gilwoŋe kwede en aye Lok pa Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak mony mapol me polo ma guruko boŋo camanini maberre, matar dok maleŋ, gulubo kore ma giriŋo ki aguragura matar. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.9"
              },
              "items": [
                {
                  "text": "Jab 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.3"
              },
              "items": [
                {
                  "text": "Ic 63.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Joel 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Yabo 14.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pala lucan mabit okatti ki i dogge, ma en bineko ki lurok woko ducu, ka doŋ bibedo ka loyogi ki odoo nyonyo; en binyono bur me biyo koŋo vino me akemo pa Lubaŋa mager ma en Won Twer Ducu-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo gicoyo nyiŋ i kom jorre ki i eme ma kwanne ni, Kabaka ma loyo luker ducu ki Rwot pa rwodi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
