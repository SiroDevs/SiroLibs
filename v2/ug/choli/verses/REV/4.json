            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.2"
              },
              "items": [
                {
                  "text": "Ic 6.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Doŋ lee makwo aŋwen-ni onoŋo lee acel acel bwome tye abicel, ma waŋgi noŋo pol ata, muromo komgi woko ducu ki yo tuŋ woko wa ki yo tuŋ i iye bene. Dyeceŋ ki dyewor pe giweko wer ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
