                {
                  "text": "Ejek 1.5-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "10.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee makwo mukwoŋo onoŋo nen calo labwor, ki me aryone onoŋo nen calo twon, lee makwo me adekke waŋe nen calo waŋ dano, ki lee makwo me aŋwenne onoŋo nen calo ocur ma tye ka tuk. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
