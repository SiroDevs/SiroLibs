                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.2"
              },
              "items": [
                {
                  "text": "Jek 4.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onoŋo tye gin mo ma wil awila calo lutkot ki i kom komker-ri, ki dwan mapol winnye iye, ki gin ma mwoc amwoca calo mwoc pa kot. I nyim komker onoŋo tye iye dog mac raa abiro ma tye ka lyel, ma gin aye cwiny pa Lubaŋa abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.22"
              },
              "items": [
                {
                  "text": "Ejek 1.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka dok aneno i nyim komker meno onoŋo tye iye gin ma nen calo nam me kiyo maleŋ calo gweŋ ma mil amila.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok lee makwo aŋwen gurumo komker woko dyere i ŋete tuŋŋi ki tuŋŋi, waŋgi pol ma mogo tye tuŋ i nyimgi ki mogo tye yo tuŋ i ŋegi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
