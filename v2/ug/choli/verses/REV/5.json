                "loc": "ISA.11.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Cutcut ŋat acel i kin ludoŋo owacca ni, “Pe ikoki. Nen, Labwor ma i kaka me Juda, Lwit yat pa Daudi, en aye doŋ oloyo, pi meno en twero yabo buk adola ki yabo ginanenane abiro ma gimwono kwede-ni woko.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
