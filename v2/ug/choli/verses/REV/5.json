          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok awinyo ginaketa ducu ma tye i polo, ki i wi lobo, ki piny i te lobo, ki ma gitye i nam-gu ki gin ducu ma tye iye, ma giloko ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
