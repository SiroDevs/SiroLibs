                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Acak 49.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Ic 11.1",
