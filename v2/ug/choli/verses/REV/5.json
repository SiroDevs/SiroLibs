                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.10"
              },
              "items": [
                {
                  "text": "Ic 42.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ci gubedo ka wero wer manyen ma waco ni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
