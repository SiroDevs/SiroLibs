          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kom nino me aryone ludito ma giloyo dog odi pa kwarogi ma i kin lwak ducu, kacel ki ajwagi ki Lulevi, gucito bot Ejira ma lapwony-cik pa Lubaŋa pi niyo lok ducu ma tye i buk me cik.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        }
      ]
    },
