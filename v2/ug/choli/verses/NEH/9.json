            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.4+EXO.16.5+EXO.16.6+EXO.16.7+EXO.16.8+EXO.16.9+EXO.16.10+EXO.16.11+EXO.16.12+EXO.16.13+EXO.16.14+EXO.16.15"
              },
              "items": [
