                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yoc 3.14-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "In imiyo likwayogi gunya mapol gudoko macalo lwak lakalatwe ma i polo, in yam imiyogi lobo ma myero gubed iye, en lobo ma yam ikwoŋo pire ni ibimiyo bot kwarogi wek gucam obed megi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.23",
            "verseOrgIds": [
              "NEH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.23"
              },
              "items": [
                {
                  "text": "Yoc 11.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Likwayogi gudonyo ci gumayo lobo pa jo Kanaan woko; dok in iloyo wegi lobo ma gibedo kunnu, ci i niyogi i ciŋgi gin kacel ki lukergi ki lwakgi ducu wek guti kwedgi gin ma gimito. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.24",
            "verseOrgIds": [
              "NEH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.10+DEU.6.11"
              },
              "items": [
                {
                  "text": "Nwo 6.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lwakki yam gumako gaŋi cel gogo kacel ki lobo ma ceko cam, ka gukwanyo odi ki lonyo ducu ma tye iye, ki bur pii ma gituco odonyo i nom piny, ki potti me yadijeituni ki lwak yadi ducu ma nyako nyiggi, kacel ki potti olok ma ginyako nyiggi madwoŋ; ma yam gucamo guyeŋ kwede ka gucako cwe ma cwinygi obedo yom twatwal pi jami mapol mabeco ma imiyogi-ni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.25",
            "verseOrgIds": [
              "NEH.9.25"
            ]
          }
        }
