                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.21"
              },
              "items": [
                {
                  "text": "Nwo 1.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare ma kec onekogi in ipitogi ki kwon mua ki i polo, ka dok imiyo gumato pii mua ki i kom pata got i kare ma orwo pii onekogi. Itito botgi bene ni gudony gucam lobo ma yam ikwoŋo pire ni ibimiyo botgi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.15",
            "verseOrgIds": [
              "NEH.9.15"
            ]
          }
        }
      ]
    },
