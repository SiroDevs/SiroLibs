                {
                  "text": "Luŋol 2.11-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ento lwakki gujemo dok gukwero lubo cikki; gubolo cikki odok yo tuŋ i ŋegi, kun gineko lunebini, ma gujukogi ni gulokke gudwog boti, ci pe guwinyo, gubedo ka yeti kare ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.26",
            "verseOrgIds": [
              "NEH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno omiyo iweko lukworgi oloyogi i lweny, dok gudiyogi matek; gukok boti i kare ma gitye i can ni ikonygi bene, ci in iwinyo kokogi ki i polo. Doŋ pi kicani madwoŋ omiyo icwalo botgi jo ma myero otel wigi, gin jo ma yam olarogi ki i ciŋ lumerokgi-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.27",
            "verseOrgIds": [
              "NEH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento i kare ma kuc dok odwogo botgi, gin gucako timo bal dok aye i nyimi, oweko in dok imiyogi i ciŋ lumerokgi, guloyogi. Kadi bed kumeno i kare ma guŋut gulokke gudwogo gukok boti, ci iwinyo kokogi ki i polo pi tyen mapol ci ilarogi pi kicani madwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.28",
            "verseOrgIds": [
              "NEH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Levi 18.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "In itito botgi ni gulokke gudwog cen boti dok gulub cikki. Ento gin gubedo ki wakke ci gukwero lubo cikki ducu, kadi bed nene atir ni mako cikki aye miyo dano bedo ki kwo, ento gin gutimo bal i kom gin ma in iciko. Gubedo ki tekwic gukwero lubo cikki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.29",
            "verseOrgIds": [
              "NEH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.13+2KI.17.14+2KI.17.15+2KI.17.16+2KI.17.17+2KI.17.18"
              },
              "items": [
                {
                  "text": "2 Luker 17.13-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15+2CH.36.16"
              },
              "items": [
                {
                  "text": "2 Tek 36.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibedo ka jukogi pi mwaka mapol, kun ijukogi ki Cwiny meri ma con otiyo i i lunebini; ento gin pe guwinyo. Omiyo iwekogi gubedo i te loc pa lwak me lobo me rok mukene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.30",
            "verseOrgIds": [
              "NEH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento pi kicani madwoŋ omiyo pe ityekogi woko, dok bene pe ibwotogi ata; pien onoŋo in Lubaŋa ma i won kica madwoŋ, ma kica maki twatwal.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.31",
            "verseOrgIds": [
              "NEH.9.31"
            ]
          }
        }
      ]
    },
