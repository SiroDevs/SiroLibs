                "loc": "DEU.1.26+DEU.1.27+DEU.1.28+DEU.1.29+DEU.1.30+DEU.1.31+DEU.1.32+DEU.1.33"
              },
              "items": [
                {
                  "text": "Nwo 1.26-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ento gin kacel ki kwarowa wigi obedo tek ci gubedo ki wakke, omiyo gukwero lubo cikki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.16",
            "verseOrgIds": [
              "NEH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Nia 34.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Wel 14.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gukwero lubone; dok wigi owil woko i kom tano mapol me aura ma ibedo ka tiyo i kingi; wigi obedo tek ci guyero dano mo acel me bedo laditgi wek otel wigi odwokgi cen i opii i Ejipt. Ento in Lubaŋa ma weko bal pa danoi in iber dok lakica, kiniga pe maki oyot, mar meri dwoŋ ma pe lokke, yam pe ibwotogi ata. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.17",
            "verseOrgIds": [
              "NEH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 9:18"
          },
          "items": [
