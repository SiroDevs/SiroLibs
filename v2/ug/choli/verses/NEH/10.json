              "items": [
                {
                  "text": "Nwo 26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wan waye me tero kai manyen ma wakayo, kacel ki nyig yadi ducu mukwoŋo cek, macalo gityer i ot pa Lubaŋa mwaka ki mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
