    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lutel wi lwak onoŋo gibedo i Jerucalem, ki lwak mukene-gu gubolo kwir me yero ŋat acel i kom jo apar me cito ka bedo i gaŋ maleŋ me Jerucalem, ma kun noŋo jo mukene mudoŋŋe gibedo i gaŋi mukene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak gupwoyo jo ma gumine pigi kengi me bedo i Jerucalem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
