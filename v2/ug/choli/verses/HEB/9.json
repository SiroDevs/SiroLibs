              },
              "items": [
                {
                  "text": "Ic 53.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kit meno Kricito bene otyerre kene kicel me tiŋo bal pa jo mapol, dok binen tyen me aryo, pe doŋ pi tic i kom bal, ento pi laro jo ma tye ka kure.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
