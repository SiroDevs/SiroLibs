            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23+EXO.25.24+EXO.25.25+EXO.25.26+EXO.25.27+EXO.25.28+EXO.25.29+EXO.25.30"
              },
              "items": [
                {
                  "text": "Nia 25.23-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien yam tye kema ma giyubo, ma obedo ki dul acel yo tuŋ woko ma gilwoŋo ni Kabedo Maleŋ, ma tye iye okar-mac, ki meja, ki mugati ma giketo i nyim Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Nia 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " I ŋe boŋo kicika me aryo yam tye iye kema ma gilwoŋo ni Kabedo Maleŋ Makato Ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
