            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.22+DEU.5.23+DEU.5.24+DEU.5.25+DEU.5.26+DEU.5.27"
              },
              "items": [
                {
                  "text": "5.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien wun pe wubino i gin ma gitwero gudo kome, ki mac ma yam olyel i wi got Cinai, ki colpiny me mutu ma ocido woko licuc, ki yamo lapiru matek, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki koko tum, ki dwan ŋat ma tye ka lok. Jo ma guwinyo lokke gubako doggi mada ni pe dok gimed loko botgi lok mo, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.12"
              },
              "items": [
                {
                  "text": "Nia 19.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " pien gin pe gitwero ciro cik ma giketo, ni meno, “Kadi ki lee mo ka ogudo got, myero gicel ki gweŋ ginek woko.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 12:21"
          },
          "items": [
            {
