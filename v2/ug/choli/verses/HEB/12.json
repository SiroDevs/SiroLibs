                {
                  "text": "Nia 20.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wugwokke pe wukwer winyo lok pa ŋat ma tye ka lok. Jo ma yam gukwero winyo lok pa ŋat mucikogi i wi lobo pe gubwot. Wan kono wabibwot niŋniŋ, ka wakwero winyo lok pa ŋat ma tye ka cikowa ki i wi polo kulu-ni? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.25",
            "verseOrgIds": [
              "HEB.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
