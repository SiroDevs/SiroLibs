              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Acak 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ki bot Yecu, layub gicikke manyen, ki bot remo ma gikiro, ma tito ki kica pi gin maber ma kato gin ma remo pa Abel otito pire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        }
