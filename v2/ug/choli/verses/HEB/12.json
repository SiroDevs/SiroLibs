                "loc": "ISA.35.3"
              },
              "items": [
                {
                  "text": "Ic 35.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pi meno, wutiŋ badwu mukwe-ni malo, wurye coŋwu magoro, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Car 4.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wuyub yo ma tyenwu lubo ocuŋ atir, wek ŋat ma tyene oŋol pe dok tyene oputte woko liweŋ ki i waŋ mwot, ento myero ocaŋ woko acaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuket tek me bedo ki kuc ki jo ducu, ki me bedo jo maleŋ; pien ŋat ma pe leŋ pe bineno Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.18"
              },
              "items": [
                {
                  "text": "Nwo 29.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wugwokke kun wuneno maber ni ŋat mo pe opoto ka gamo kica pa Lubaŋa. Wunen ni ŋat mo pe obedo macalo lwit yat makec ma ka otwi ci kelo ayela, dok balo jo mapol. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.29+GEN.25.30+GEN.25.31+GEN.25.32+GEN.25.33+GEN.25.34"
              },
              "items": [
                {
                  "text": "Acak 25.29-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wunen ni ŋat mo pe obed latim abor, nyo dano ma pe lworo Lubaŋa calo Ecau, ma yam ocato ditte me anywalli me bedo latin kayo pi cam me tyen acel keken. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Acak 27.30-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien wuŋeyo ni, lacen ka en omito ni wonne olam gum i kome, ento wonne okwere woko, kadi bed onoŋo mito ma kok ki pig waŋe, pien en yam pe onoŋo yo me ŋut i gin ma otimo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        }
      ]
    },
