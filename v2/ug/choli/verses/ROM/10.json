            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Jab 19.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento koŋ amito apeny ni, “Onoŋo yam pe guwinyo?” Guwinyo, kit macalo yam gicoyo i Jabuli ni,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
    {
