        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 10:5"
          },
          "items": [
            {
              "text": "5",
