              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka omiyo gipayo lwak mel i Ejion-geber, ma tye cok ki Elot i dog Nam Makwar i lobo Edom. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
