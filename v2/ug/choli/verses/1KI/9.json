          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiram ocwalo luticce ma gin lunam ma guŋiyo ki tic i nam wek guwot ki mel meno kacel ki jo pa Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
