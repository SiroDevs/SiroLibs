            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo giketo guti me te ot pa Rwot i mwaka me aŋwen, i dwe Jib, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka dok i mwaka apar wiye acelle, i dwe Bul",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.38",
              "type": "text"
            },
            {
              "text": "Dwe Bul",
              "type": "text"
            },
            {
              "text": "pa jo Icrael mito rom ki dwe apar wiye acel ma mewa-ni.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ma en aye dwe me aboro-ni, en aye gityeko iye tic i kom ot ducu, kun onoŋo gityeko tic ducu iye kit ma onoŋo yam giporo kwede, Gerone otero mwaka abiro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
