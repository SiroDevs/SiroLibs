          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok kom Nadab mudoŋŋe ducu, ki gin ducu ma en otiyo, gityeko coyone i buk me Tekwaro pa Luker me Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lweny obedo i kin Aca ki Baaca kabaka me Icrael pi kare me kwogi ducu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
