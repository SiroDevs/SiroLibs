          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano me lobo ducu gubedo ka yenyo kit yo me neno wan Solomon, ki pi winyo kit ryekone ma Lubaŋa oketo i cwinye-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano acel acel tero motte bote, kun gitero jami me ryal ki me jabu-gu, ki ginaruka-gu, ki odok murra, ki aŋwece, ki aguragura ki kanagu mwaka ki mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
