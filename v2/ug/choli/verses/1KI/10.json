              },
              "items": [
                {
                  "text": "Nwo 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "En yam limo aguragura ma a ki i Ejipt ki Kuc; lucat-wil pa kabaka gamogi ki i Kuc i wel lim ma onoŋo giyubo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadigadi lweny ma gia ki i Ejipt welgi onoŋo romo cekel me ryal miya abicel, ki aguragura acel welle cekel miya acel ki pyerabic; ka dok lucat-wil pa kabaka catogi’ bot luker ducu pa jo Kit ki bot luker me Ciria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
