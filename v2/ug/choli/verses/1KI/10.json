              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon ocoko gadigadi lweny ki lulweny ma giriŋo ki aguragura. Obedo ki gadigadi lweny alip acel ki miya aŋwen, ki wegi aguragura alip apar wiye aryo, Oketo mogo i kingi i gaŋi me gadigadi lweny, ki mukene gubedo bote i Jerucalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Solomon Omiyo ryal odoko gin malam ma rom ki gweŋ-gu i Jerucalem, dok okelo yadi cedar mapol ata ma rom ki olam ma i bar Cepela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
