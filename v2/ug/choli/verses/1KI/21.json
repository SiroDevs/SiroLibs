              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok pa Rwot dok obino bot Elia ma Laticbe ma waco bo te ni, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
