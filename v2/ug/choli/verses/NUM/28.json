        },
        {
          "text": "“I kom nino me tyero cam me wi mwaka, ma wukelo iye gityer me moko kwon kai manyen bot Rwot i ninowu madit me’ kwero agikki cabit abiro, wubibedo iye ki gurre maleŋ. Pe wuti iye tic mo matek, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento wutyer iye gitum awaŋa, gin ma ŋwece kur me yo mo cwiny Rwot: litino twoni aryo, nyok romo acel, ki litino nyogi romi abiro ma ditogi mwaka acel acel; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kacel ki gityer me moko kwon mapwotte ma’ girubo ki moo, Wumi ma romo agwata adek pi twon acel acel, agwata aryo pi nyok romo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki agwata acel pi latin romo acel acel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubityero bene nyok dyel acel pi kwanyo bal ki i komwu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubityerogi kacel ki gityer amata mutikogi kun wumedo ki gitum awaŋa me nino ducu. Wunen ni komgi pe ki mwonyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.31",
