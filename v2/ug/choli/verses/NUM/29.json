          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento wutyer gitum awaŋa bot Rwot, gin ma ŋwece kur me yomo cwinye: wod twon acel, nyok romo acel ki litino nyogi romi abiro ma ditogi mwaka acel acel; wunen ni komgi pe ki mwonyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumi bene gityer me moko kwon mapwotte ma girubo ki moo, agwata adek pi wod twon, agwata aryo pi nyok romo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
