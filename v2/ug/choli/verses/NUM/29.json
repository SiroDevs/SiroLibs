          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki agwata acel pi latin romo acel acel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubityero bene nyok dyel acel pi gitum me bal ma gimedo ki gitum me bal me lakwany bal, ki gitum awaŋa me nino ducu, ki gityer mere me moko kwon, ki gityer amata mutikogi ducu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
