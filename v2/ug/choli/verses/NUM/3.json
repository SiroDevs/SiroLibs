        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
