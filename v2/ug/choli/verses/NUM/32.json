              "NUM.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo pa Makir wod pa Manace gucito i lobo Gilead, gumako gumayo woko ki bot jo Amor ma onoŋo gitye kunnu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Moses omiyo Gilead bot jo pa Makir wod pa Manace, gucako bedo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jair me kaka pa Manace ocito omako gaŋi matino mapol, ocako nyiŋgi ni, Kavot-jair. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok Noba ocito omako Kenat ki gaŋi matino ma i ŋete, ci ocako nyiŋe Noba, macalo nyiŋe kikome.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
