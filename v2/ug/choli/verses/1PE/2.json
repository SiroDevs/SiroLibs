                "loc": "PSA.34.8"
              },
              "items": [
                {
                  "text": "Jab 34.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " pien doŋ wutyeko bilo ber pa Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        }
