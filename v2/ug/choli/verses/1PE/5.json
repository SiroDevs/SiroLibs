                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jo ducu muye Kricito ma gitye i Babilon ma Lubaŋa oyerogi kacel kwedwu gumotowu, ki woda Marako bene omotowu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumotte kekenwu ki mot me mar.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
      ]
    },
