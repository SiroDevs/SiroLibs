            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi aye ginaleya ma jo Icrael gulimo ki i lobo Kanaan, ma jo magi aye gupoko botgi: ajwaka Eleajar, Yocwa wod pa Nun ki ludito kaka ma i odi pa kwarogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.52+NUM.26.53+NUM.26.54+NUM.26.55+NUM.26.56"
              },
              "items": [
                {
                  "text": "Wel 26.52-56",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
