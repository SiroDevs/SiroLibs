              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno aye ginaleya ma yam Moses opoko i lobo aroo me Moab ma loka Jordan tuŋ wokceŋ mukemo Jeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
