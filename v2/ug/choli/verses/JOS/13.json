          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses omiyo ginaleya bot nucu kaka pa. Manace bene; opoko bot nucu kaka pa Manace muporo wel doggolagi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobogi ocakke ki i Makanaim, okwako lobo Bacan ducu, en aye ker pa Og kabaka me Bacan ducu liweŋ, ki gaŋi me Jair ducu ma gitye i Bacan, gaŋi pyerabicel, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki nucu lobo Gilead, kacel ki Acitarot ki Edrei ma gin aye gaŋ kal pa Og i lobo Bacan. Meno ducu gipoko bot jo pa Makir wod pa Manace, pi nucu kaka pa jo Makir muporo wel doggolagi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
