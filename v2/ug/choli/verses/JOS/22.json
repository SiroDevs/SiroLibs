              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ajwaka Finekaci ki rwodi ma luwi lwak, ki ludito kaka ma i Icrael ma onoŋo gitye kacel kwede guwinyo lok pa jo Reuben, jo Gad ki jo Manace ma gudbk iye-ni, ci cwinygi obedo yom mada. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finekaci wod pa ajwaka Eleajar owaco bot jo Reuben, jo Gad ki jo Manace ni, “Tin doŋ waniaŋ atir ni, Rwot tye i dyewa, pien wun pe wutimo man pi robo dog Rwot; kombeddi doŋ wutyeko laro jo Icrael woko ki i cin Rwot.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Finekaci wod pa ajwaka Eleajar ki rwodi ducu gua ki bot jo Reuben ki jo Gad ma i lobo Gilead, gudok i Kanaan bot jo Icrael ma tye kunnu, ci gudwoko lok botgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok ma gudwoko botgi oyomo cwiny jo Icrael mada, ci gupwoyo Lubaŋa, pe dok gumedde ki loko me cito ka lweny i komgi nyo pi balo lobo ma jo Reuben ki jo Gad gibedo iye-ni woko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Reuben ki jo Gad gucako nyiŋ keno tyer ma gucano ni, Caden, pien guwaco ni, “Man aye bedo me caden i kin wan ki wun ma moko ni, Rwot en aye Lubaŋa.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
      ]
