              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Nwo 11.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.11+DEU.27.12+DEU.27.13+DEU.27.14"
              },
              "items": [
                {
                  "text": "27.11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ci jo Icrael ducu, lubedo ki anywalli, kacel ki ludoŋo ki ludito tic ki luŋolkopgi, gin ducu gucuŋ i get canduk pa Rwot tuŋŋi ki tuŋŋi ki i nyim ajwagi ma Lulevi ma gutiŋo canduk me gicikke pa Rwot. Nucu dano gucuŋ i nyim got Gerijim ki nucu dano gucuŋ i nyim got Ebal, kit ma Moses latic pa. Rwot okwono cikogi kwede kit ma myero gilam kwede gum i kom jo Icrael. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lacen Yocwa okwano lok ducu ma i cik, wa lok me lamo gum ki lok me ceno dano ducu kikore macalo yam gicoyo ducu i buk me cik, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok acel mo pe odoŋ i kom lok ducu ma Moses yam ociko ma Yocwa pe okwano i nyim kacokke pa jo Icrael ducu, kacel ki mon ki litino ki lubedo ma gibedo i kingi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
