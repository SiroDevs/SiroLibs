                "loc": "EXO.20.25"
              },
              "items": [
                {
                  "text": "Nia 20.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kit ma yam Moses Latic pa Rwot ociko ki jo Icrael. Olubo lok ma gicoyo i buk me cik pa Moses ni, “Wucan keno tyer ki got ma pe gipayo komgi, ma danomo pe otiŋo nyonyo i kome.” En aye gutyero iye gitum awaŋa bot Rwot, ci gutumo gityer lakwecwiny, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Yocwa ocoyo kopi me cik pa Moses i kom godi kunnu ki i nyim jo Icrael kun lubo kit ma yam Moses ocoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
