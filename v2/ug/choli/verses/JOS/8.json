              "type": "text"
            }
          ]
        },
        {
          "text": "Yocwa ocano keno tyer i wi got Ebal pi Rwot Lubaŋa pa Icrael, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
