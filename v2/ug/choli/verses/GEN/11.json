          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arpakcad ori mwaka miya aŋwen ki adek ma doŋ otyeko nywalo Cela, dok omedde ki nywalo awobe ki anyira bene.",
          "type": "text",
          "attrs": {
