              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Arpakcad doŋ otyeko ri mwaka pyeradek wiye abic, ci onywalo Cela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
