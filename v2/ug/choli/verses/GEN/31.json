  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "GEN 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo obedo ka winyo kun awo be pa Laban giwaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yakobo doŋ otero lim pa wonwa woko ducu, olimo lonyo nia ki i kom lim pa wonwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo oneno ni waŋ Laban oballe woko i kome, pe dok nene maber kit macon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.2",
            "verseOrgIds": [
              "GEN.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot owaco bot Yakobo ni, “Doŋ idok i lobo pa kwarowu bot lutuwu, an abibedo kwedi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo olwoŋo Lakeri ki Lea i bar olet ka ma limme tye iye, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.4",
            "verseOrgIds": [
              "GEN.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci owaco botgi ni, “An aneno waŋ wonwu ocido woko i koma, pe doŋ nena maber kit macon. Ento Lubaŋa pa wora yam tye kweda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.5",
            "verseOrgIds": [
              "GEN.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun wuŋeyo ni atyeko tic bot wonwu ki tekka ducu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.6",
            "verseOrgIds": [
              "GEN.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci en obedo ka bwola, kun loko mucarana atata tyen apar kulu, ento Lubaŋa pe oye en otimo gin mo marac i koma, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.7",
            "verseOrgIds": [
              "GEN.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka owaco ni, ‘Lim ma abacabac bibedo meri me mucarani,’ ci lim ducu ginywal mubedo abacabac keken. Ka dok oloko doge ni, ‘Lim ma gibedo akolakol gin aye bibedo meri me mucarani,’ ci lim ducu dok ginywal akolakol. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.8",
            "verseOrgIds": [
              "GEN.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meno aye kit ma Lubaŋa okwanyo kwede lim pa wonwu ci omiyogi bota.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“I kare ma megine giyitogi, atiŋo waŋa malo ki i waŋ lek, ci aneno nyogi ma gitigo megine komgi obedo akolakol ki abacabac ki opukopuk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.10",
            "verseOrgIds": [
              "GEN.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamalaika pa Lubaŋa owacca i waŋ lek ni,. ‘Yakobo’, an agamo ni, ‘An a ene!’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.11",
            "verseOrgIds": [
              "GEN.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci owacca ni, ‘Tiŋ waŋi malo wek inen, nyogi ducu ma gitigo megine-ni gubedo akolakol ki abacabac ki opukopuk; pien atyeko neno kit ma Laban timi kwede. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.12",
            "verseOrgIds": [
              "GEN.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.18+GEN.28.19+GEN.28.20+GEN.28.21+GEN.28.22"
              },
              "items": [
                {
                  "text": "Acak 28.18-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "An Lubaŋa me Betel, ka ma yam iwiro iye wir ki moo, ka ikwoŋo iye kwoŋ bota-ni, Doŋ ia malo, icit woko cen ki i lobe-ni, idok i lobo ma ginywali iye ca.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.13",
            "verseOrgIds": [
              "GEN.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakeri ki Lea gugamo ni, “Tye dok dul lim mo nyo ginaleya mo ma dok odoŋ piwa i ot pa wonwa? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.14",
            "verseOrgIds": [
              "GEN.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe doŋ en nenowa macalo lurok ata? Doŋ otyeko catowa woko, tye ka camo bene lim ma gimiyo piwa woko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.15",
            "verseOrgIds": [
              "GEN.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lim ducu ma doŋ Lubaŋa otyeko kwanyo ki bot wonwa doŋ mewa ki pa litinowa; doŋ gin ducu ma Lubaŋa owacci aye itim.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo oa, oketo awobene ki monne i wi kinaga, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.17",
            "verseOrgIds": [
              "GEN.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "oleko limme ducu, ma yam olimo i Paddan-aram; ci ocako wot me dok i lobo Kanaan bot Icaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.18",
            "verseOrgIds": [
              "GEN.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laban onoŋo ocito ka ŋolo yer kom romine, ci Lakeri okwalo cal lubaŋa ki i ot pa, wonne. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.19",
            "verseOrgIds": [
              "GEN.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo obwolo Laban La-aram, pe otitte pi wotte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.20",
            "verseOrgIds": [
              "GEN.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwi ki lwak lim ducu ma yam tye kwede, ka ocako wot, oŋolo kulu Euprate, ci okemo lobo godi me Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka nino okato adek kulu, ci gitito bot Laban ni, “Yakobo doŋ otyeko lwi, ocito woko.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.22",
            "verseOrgIds": [
              "GEN.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ogwarre ki lutugi, gutwarre, gulubo kore; ka guwoto nino abiro, ci gudiŋo kore cokcok i kin godi me Gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.23",
            "verseOrgIds": [
              "GEN.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Lubaŋa obino bot Laban La-aram i waŋ lek, kun wacce ni, “Gwokke, pe icilok lok mo maber nyo marac bot Yakobo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laban omako Yakobo iyo. Onoŋo doŋ otyeko gony woko i lobo godi, ci Laban ki lutugi gugony i lobo godi meno me Gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.25",
            "verseOrgIds": [
              "GEN.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laban ocako lok ki Yakobo ni, “Itimo kuman piŋo, ma ibwola kit man, doŋ itiŋo anyirana, ilwi kwedgi, macalo iyakogi ayaka ki pala lucwan-ni? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.26",
            "verseOrgIds": [
              "GEN.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŋo ilwi woko alwiya i muŋ ali, kun iumo waŋa ma pe ititta gin mo, ma kono nene aciki ki yomcwiny ki wer ki ajaa ki opuk? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.27",
            "verseOrgIds": [
              "GEN.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŋo pe iweko aciko litinona kun anoto lem anyirana? Man itimo gin me caro a tika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.28",
            "verseOrgIds": [
              "GEN.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo atwero timi marac; ento Lubaŋa pa woru oloko kweda tin i dyewor, ocika ni ‘Gwokke pe icilok lok mo maber nyo’ marac bot Yakobo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.29",
            "verseOrgIds": [
              "GEN.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man doŋ ia icako wot woko, pien pi ot pa woru’ odoko mitti mada; ento dok ikwalo ki cal lubaŋana me ŋo kono?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.30",
            "verseOrgIds": [
              "GEN.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ogamo dog Laban ni, “Onoŋo abedo ki lworo, abedo ka tamo ni gwok nyo ibimayo anyirani woko ki bota. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.31",
            "verseOrgIds": [
              "GEN.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ibinoŋo cal lubaŋani bot ŋatti mo kany, ŋat meno pe bikwo. Cim koni jamini ma inoŋo tye bota kany i nyim utmegiwa ci ikwany idok giri kwede, “Onoŋo Yakobo pe oŋeyo ni Lakeri aye ma okwalogi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno Laban ocako donyo i kemapa Yakobo, ki i kema pa Lea, ki i kema pa mon aŋeca aryo-nu ducu, ci pe omedo ki nonogi; ka okato woko ki i kema pa Lea, dok odonyo i kema pa Lakeri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.33",
            "verseOrgIds": [
              "GEN.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno onoŋo Lakeri otiŋo lubaŋa-nu, ci orwakogi i kom me bedo i wi kinaga; ci obedo i wigi. Laban oŋiyo jami ma i kema ducu, pe omedo ki noŋogi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.34",
            "verseOrgIds": [
              "GEN.31.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakeri owaco bot wonne ni, “Laditta, pe kiniga omaki i koma ka ineno ni pe atwero a malo i nyimi, pien atye ki kit pa wan mon.” Kit meno Laban oyenyo cal lubaŋane kwe, pe omedo ki noŋogi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiniga omako Yakobo, ocako da ki Laban, kun waco bot Laban ni, “Balla doŋ tye kwene kaa? Atimo bal aŋo, mumiyo ilubo kora twatwal-li? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.36",
            "verseOrgIds": [
              "GEN.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bed iyenyo i kin jamina ducu, kit gin aŋo ma inoŋo i kom jami ducu ma oa i odi? Kel iket kany i nyim utmegini ki utmegina, wek guŋol kop i kin wan aryo-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.37",
            "verseOrgIds": [
              "GEN.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "An abedo kwedi mwaka pyeraryo; pe i megi romini ki megi dyegini mo opoto, pe bene acamo nyok romoni mo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.38",
            "verseOrgIds": [
              "GEN.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lim ma ŋuu aye omwodo pe akelo riŋone boti, an aye aculo gira; lim ma gikwalo i dyeceŋ ki i dyewor ipenyo bota. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.39",
            "verseOrgIds": [
              "GEN.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yam abedo kit meno, kun ceŋ waŋa dyeceŋ, koyo neka dyewor, pe aketo nino mo i waŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.40",
            "verseOrgIds": [
              "GEN.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "I lwak mwaka pyeraryo ma abedo kwedi i odi-ni, atiyo boti mwaka apar wiye aŋwen pi anyirani aryo-ni, ki mwaka abicel pi limmi, ibedo ka loko mucarana tyen apar kulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.41",
            "verseOrgIds": [
              "GEN.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce Lubaŋa pa wora, Lubaŋa pa Abraim ma Icaka bene lworo, pe obedo tuŋ bota, kono tin icwala adok tuwa ki ciŋa noŋo adada. Lubaŋa oneno twon aromana, ki tic ma atiyo ki ciŋa ci tin dyewor bene ojuki.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laban ogamo kun dok iye bot Yakobo ni, “Anyira man gin anyirana, ki litino bene gin litinona, lim bene gin limma, ki gin ma ineno-ni gin ducu limma. Ento abitimo gin aŋo tin i kom anyirana-ni, nyo i kom litinogi ma gunywalo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.43",
            "verseOrgIds": [
              "GEN.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ ibin wek waket gicikke i kin in ki an, me bedo caden i kin in ki an.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Yakobo otino got ocibo wek obed wir. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.45",
            "verseOrgIds": [
              "GEN.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Yakobo owaco bot utmegine ni, “Wucok got”, ci gucoko got, guguro kacel, ka gucamo cam i ŋet odur got meno, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laban ocako nyiŋ kabedo meno ni Jegarcaduta; ento Yakobo ocako nyiŋe ni Galeed. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.47",
            "verseOrgIds": [
              "GEN.31.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laban owacci, “Odur man en aye caden i kin in ki an tin.” Mumiyo ocako nyiŋe Galeed. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.48",
            "verseOrgIds": [
              "GEN.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ocako nyiŋ wir meno ni Mijpa, pien owacci, “Rwot ogwok kin an ki in, ka kinwa doŋ bipokke woko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ibiketo giŋi marac i kom anyirana, nyo ka dok ibinyomo mon mukene, idodogi i kom anyirana, kadi ŋatti mo pe tye kwedwa, ber ipo ni Lubaŋa en aye caden i kin in ki an,”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Laban dok owaco bot Yakobo ni, “Nen odur man, ki wir ma atyeko cibo i kin in ki an. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.51",
            "verseOrgIds": [
              "GEN.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odur man aye caden, ki wir bene en caden, an pe abikato ka ŋet odur man pi cito boti, in bene pe ibikato ka ŋet odur man ki wir man pi cito bota, ni pi tim marac. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubaŋa pa Abraim, Lubaŋa pa Nakor, Lubaŋa pa wongi, obed laŋolkop i kinwa.” Kit meno Yakobo okwoŋo kwoŋ ki nyiŋ Lubaŋa ma wonne Icaka lworo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo otyero gitum i wi got, kun olwoŋo iye utmegine ducu ka camo cam kwede, ci gucamo gubuto kunnu i wi got.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 31:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka piny oru odiko con, Laban oa, onoto lem likwaye ki lem anyirane, olamo gum i komgi, ci opokke kwedgi odok i gaŋŋe.’",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.31.55"
            ]
          }
        }
      ]
    }
  ],
