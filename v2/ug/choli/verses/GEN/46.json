              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce Parao olwoŋowu, ka openyowu ni, ‘Wun wutiyo tic aŋo?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
