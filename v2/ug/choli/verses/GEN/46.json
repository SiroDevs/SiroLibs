              "type": "text"
            }
          ]
        },
        {
          "text": "gin lukwat, pien gin yam lukwat dyaŋi; dok gin gubino ki dyegigi ki dyani-gu, ki gin ducu ma gitye kwede.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
