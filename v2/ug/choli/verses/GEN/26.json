              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Ecau doŋ ditte romo mwaka pyeraŋwen, onyomo monne, Judit nya pa Beeri, jo Kit, ki Bacemat nya pa Elon, jo Kit bene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
