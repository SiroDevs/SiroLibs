    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwak ducu gudaŋŋe ki woo madwoŋ, ka gipako Rwot, pien doŋ giketo guti me te ot pa Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento lwak jo mapol ki i kin ajwagi ki Lulevi ki ludito ma giloyo dog odi pa kwarogi, jo muteggi ma yam guneno ot pa Rwot mukwono ca, gukok matek ki dwan maloŋo i kare ma guneno ka gitye ka keto guti me te ot man, kadi ka jo mapol onoŋo gubedo ka daŋŋe ki yomcwiny; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumiyo dano pe gutwero poko kin dwan ma jo gidaŋŋe kwede pi yomcwiny ki dwan me daŋŋe ma jo gikok kwede akoka-ni, pien onoŋo lwak gubedo ka daŋŋe matek twatwal, dok dwangi bene owinnye wa ka mabor.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
