                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guwero wer kun gileyo aleya, ma gipako Rwot dok gimiyo pwoc bote, kun giwero ni,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
