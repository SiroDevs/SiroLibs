          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ gucako dok i Jerucalem ki i wi got Jeituni, ma cok ki Jerucalem, rom ki wot me ceŋ cabit.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.12",
              "type": "text"
            },
            {
              "text": "Wot me ceŋ cabit borre cok romo Km.1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 1:13"
          },
          "items": [
