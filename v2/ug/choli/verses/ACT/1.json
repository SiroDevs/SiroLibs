              "items": [
                {
                  "text": "Mar 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.16"
              },
              "items": [
                {
                  "text": "Luka 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.33"
              },
              "items": [
                {
                  "text": "Jon 1.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jon yam batija dano ki pii, ento odoŋ nino manok ma wun gibibatijawu ki Cwiny Maleŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
            "verseOrgIds": [
              "ACT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
