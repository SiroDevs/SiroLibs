          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno Petero ocuŋ i kin lwak utmego ma giromo miya acel ki pyeraryo kun wacci, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
            "verseOrgIds": [
              "ACT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Utmego, lok ma yam gicoyo myero ocobbe kakare, macalo yam Cwiny Maleŋ oloko ki i dog Daudi i kom Juda ma otelo wi jo ma gumako Yecu ca. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien yam gikwano en i kinwa, en bene obedo i dog tic man.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5+MAT.27.6+MAT.27.7+MAT.27.8"
              },
              "items": [
                {
                  "text": "Mat 27.3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dano meno owilo poto ki lim ma onoŋo pi tim aranyine, ka opoto aryeba cwiny ci iye otyer obar woko, cin iye owukke woko ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lok man oŋene bot jo ducu ma gibedo i Jerucalem, ci poto meno gilwoŋo ki i lebgi ni Akel-dama, en aye Poto me Remo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        }
      ]
