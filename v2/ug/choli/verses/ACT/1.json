                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.16+MRK.3.17+MRK.3.18+MRK.3.19"
              },
              "items": [
                {
                  "text": "Mar 3.16-19",
