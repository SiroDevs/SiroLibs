                "loc": "DEU.16.9+DEU.16.10+DEU.16.11"
              },
              "items": [
                {
                  "text": "Nwo 16.9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka nino me Pentekote doŋ oromo, onoŋo gin ducu gucokke kacel i kabedo acel. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyotoyot woo owinnye kun oa ki i polo macalo yamo ma kodo mager, opoŋo ot ducu ka ma gubedo iye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci gin mo onen botgi macalo leb mac ma opokke ci opye i wi ŋat acel acel i kingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ gin ducu gupoŋ ki Cwiny Maleŋ, ci gucako dumo leb mukene mapatpat macalo Cwiny Maleŋ omiyogi me lokone.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoŋo tye Lujudaya ma gibedo i Jerucalem, jo ma giworo Lubaŋa ma gua i rok ducu ma tye i wi lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka woo meno owinnye, lwak ducu gucokke kun wigi ocuŋ woko, pien onoŋo ŋat acel acel winyogi ka giloko leb tugi kikome. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci guuro matek twatwal ma kun giwacci, “Jo ma giloko-ni mono pe gin ducu Lugalilaya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŋo wan ducu dok wawinyogi kun ŋat acel acel tye ka lok i leb tugi kikome ma ginywale iye? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wan Luparti, jo Media, jo Elam, ki jo ma gibedo i Mecopotamia, Judaya ki Kapadokia, Ponto ki Acia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Purugia ki Pampulia, Ejipt ki lobo Libya ma dok tuŋ Cirene, ki welo ma gua ki i Roma ma gin Lujudaya ki jo ma gulokke gudonyo i diniwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukurete ki Luarab, wan ducu wawinyogi ka gitito pi tic madito me twero pa Lubaŋa i leb tuwa kikome.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ducu guuro ma pe gitwero niaŋ, ma giloko kekengi ni, “Man te lokke aŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento jo mukene gunyerogi anyera kun giwaco ni, “Jo-ni gumer ki koŋo vino manyen.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Petero ocuŋ kacel ki lukwena apar wiye acel, odaŋŋe ki dwan madit kun waco botgi ni, “Wun co me Judaya, ki wun jo ducu ma wubedo i Jerucalem, ber wuŋe lok man, dok wucik itwu ka winyo lokka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.14",
            "verseOrgIds": [
              "ACT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo man pe gumer, macalo wun wutamo, pien cawa pud adek keken me odiko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.15",
            "verseOrgIds": [
              "ACT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento man aye lok ma yam lanebi Joel oloko pire kun wacci, Lubaŋa owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.21",
            "verseOrgIds": [
              "ACT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wun jo Icrael, wuwiny lok man: Yecu Lanajaret obedo dano ma Lubaŋa aye onyuto botwu kun moko ki tic madito me twero, ki taŋo ki lanyut mapol ma Lubaŋa otiyo kacel kwede i kinwu, macalo wun wuŋeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.22",
            "verseOrgIds": [
              "ACT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.35"
              },
              "items": [
                {
                  "text": "Mat 27.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.24"
              },
              "items": [
                {
                  "text": "Mar 15.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.33"
              },
              "items": [
                {
                  "text": "Luka 23.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.18"
              },
              "items": [
                {
                  "text": "Jon 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yecu man gimiye botwu macalo Lubaŋa yam onoŋo oyubo kun oŋeyo gin ma bitimme i anyim, ci wun wugure i kom yatariya, wuneke ki ciŋ jo ma pe guye Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.5"
              },
              "items": [
                {
                  "text": "Mat 28.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.6"
              },
              "items": [
                {
                  "text": "Mar 16.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.5"
              },
              "items": [
                {
                  "text": "Luka 24.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ento Lubaŋa ocero en woko, kun gonye woko ki i arem me to, pien to pe twero moko i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.8+PSA.16.9+PSA.16.10+PSA.16.11"
              },
              "items": [
                {
                  "text": "Jab 16.8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien Daudi yam oloko i kome ni,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.28",
            "verseOrgIds": [
              "ACT.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Utmego, myero alok botwu i kom kwarowa Daudi atir ni yam en oto dok giyiko kome, watye ki lyelle botwa kany nio wa tin. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.29",
            "verseOrgIds": [
              "ACT.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.11"
              },
              "items": [
                {
                  "text": "Jab 132.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.12"
              },
              "items": [
                {
                  "text": "2 Cam 7.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onoŋo yam en lanebi, dok oŋeyo ni Lubaŋa yam okwoŋo kwoŋ bote ni ebiketo dano mo ma i kin likwaye ma bedo i wi komkerre. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.30",
            "verseOrgIds": [
              "ACT.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "En yam oneno gin ma bitimme i anyim ka oloko bene i kom cer pa Kricito ma Lubaŋa oyero ni, pe gitenye ata i lobo pa jo muto, kome bene pe otop. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.31",
            "verseOrgIds": [
              "ACT.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en Yecu ma Lubaŋa ocero woko, wan ducu wacaden i kom lok meno. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.32",
            "verseOrgIds": [
              "ACT.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gitiŋe malo wek obed i ŋet Lubaŋa yo tuŋ acuc i kabedo me deyo, ci ogamo Cwiny Maleŋ ki bot Wonne kit ma yam Lubaŋa ociko, ci oonyo i komwa gin man ma doŋ wuneno dok bene wuwinyo-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.33",
            "verseOrgIds": [
              "ACT.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Jab 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pien Daudi yam pe ocito i polo; ento en aye owaco ni,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka guwinyo man, cwinygi oton, ci guwaco bot Petero ki lukwena mukene ni, “Utmego, wabitimo aŋo?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero owaco botgi ni, “Wuŋut, gibatijawu ŋat acel acel ki i kinwu i nyiŋ Yecu Kricito, wek Lubaŋa owek balwu; ci wubilimo mot me Cwiny Maleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.38",
            "verseOrgIds": [
              "ACT.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien lok man giciko piwu ki pi litinowu ki pi jo ducu ma gitye ka mabor, ma Rwot Lubaŋawa bilwoŋogi bote.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok otito botgi lok mukene mapol, ma tuco matek dok cuko cwinygi kun waco ni, “Wularre kenwu wua woko ki bot yalwak man muŋak-ki.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.40",
            "verseOrgIds": [
              "ACT.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci jo muye lok ma en owaco botgi gibatijagi, ci gumedde i nino meno jo ma romo alip adek. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.41",
            "verseOrgIds": [
              "ACT.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gumine kengi ka winyo pwony pa lukwena, ka ribbe kacel ki jo ma guye Yecu, ka camo mugati ma gibaro, ki ka lega.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        }
      ]
    },
