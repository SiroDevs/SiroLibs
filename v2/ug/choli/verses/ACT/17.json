              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka guwinyo Paulo ka loko lok i kom cer ki i kin jo muto, jo mogo gucako caye ki jo mukene guwacci, “Wamito imed tito lok man botwa kare mukene.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
