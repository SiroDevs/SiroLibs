              "items": [
                {
                  "text": "Jab 146.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka guwinyo, ci gutiŋo dwangi malo kacel bot Lubaŋa kun giwaco ni, “Ai Rwot Lubaŋa, in ma con iketo polo ki lobo ki jami ducu ma tye i igi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.24",
            "verseOrgIds": [
              "ACT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.1"
              },
              "items": [
                {
                  "text": "Jab 2.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
