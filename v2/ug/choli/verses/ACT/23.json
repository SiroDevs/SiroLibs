          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci owacci, “Abiwinyo lokki ka ludoti guo.” Ociko ni gigwoke i ot madit pa Kerode",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
            "verseOrgIds": [
              "ACT.23.35"
            ]
