        },
        {
          "text": "Cwiny Maleŋ owaco bot Pilipo ni, “Nyik cok, irwatte ki gadigadi man.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
