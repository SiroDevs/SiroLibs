              "1CH.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.22"
              },
              "items": [
                {
                  "text": "Acak 35.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.3+GEN.49.4"
              },
              "items": [
                {
                  "text": "49.3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man lok kom likwayo pa Reuben ma latin kayo pa Icrael. En aye latin kayo, ento otimo kir pi bedo ki ci-wonne. Pi meno ditte me ‘anywalli gimiyo bot litino awobe pa Yucepu wod pa Icrael, pe doŋ gicoyo nyiŋe i buk me tekwaro ma lubo kit ma ginywale kwede. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.8+GEN.49.9+GEN.49.10"
              },
              "items": [
                {
                  "text": "Acak 49.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok kadi bed Juda yam obedo oteka i kin omegine, dok laker bene ononne ki i kin likwaye, ento dit me anywalli onoŋo tye bot Yucepu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.2",
            "verseOrgIds": [
              "1CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino awobe pa Reuben ma latin kayo pa Icrael gin aye Kanok, Pallu, Kejeron ki Karmi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litino awobe pa Joel gin ene: wode obedo Cemaya, ma wode Gog, ma wode Cimei, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma wode Mika, ma wode Reaya, ma wode Baal, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2 Luker 15.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma wode Beera ma yam Tiglat-pilecer kabaka me Aciria otero woko i opii; en yam obedo ladit pa jo Reuben.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukakagi yam gicoyo tekwarogi kun lubo yalwakgi ki doggolagi, gin ene: laditgi Jeyel, ki Jekaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki Bela wod pa Ajaj ma wod pa Joel; en yam bedo i Aroer, ma lobone oo wa i Nebo ki Baal-meon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En yam obedo bene yo tuŋ wokceŋ ma lobone o wa i dog tim ma i ŋet kutu Euprate tuŋ kany, pien onoŋo doŋ limgi onya madwoŋ i lobo Gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare pa Caulo gubedp ka lweny ki jo Agri ci gunekogi, ka gucako bedo i kemagi i lobo ducu ma i ŋet lobo Gilead yo tuŋ wokceŋ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likwayo pa Gad gubedo i lobo Bacan nio kwede wa i Caleka, kun gukemme ki jo Reuben. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joel obedo laditgi, me aryone Capamo Janai ki Capat bene gubedo i Bacan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukakagi gupokke i doggola mapatpat ma kwarogi obedo Mikael, Meculam, Ceba, Jorai, Jakan, Jia ki Eber, gin abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi aye gubedo likwayo pa Abikail wod pa Kuri, ma wod pa Jaroa, wod pa Gilead, wod pa Mikael, wod pa Jecicai, wod pa Jado, wod pa Buj. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aki wod pa Abdiel ma wod pa Guni, en aye obedo ladit ma loyo dog odi pa kwarogi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gubedo i Gilead, i Bacan ki i gaŋi ma i lobo meno, ki i kakwat ducu ma i lobo Caron, nio wa i waŋ lobo kikome, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo magi ducu gicoyo nyiŋgi i buk me tekwaro i kare pa Yocam kabaka me Juda, ki i kare pa Jeroboam kabaka me Icrael.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo pa Reuben, jo pa Gad, ki nucu kaka pa Manace yam gitye ki twoni oteka lweny ma gitye ki kwotgi ki pala lucwangi, ma gutelo atumgi bene, ma gin oyita lweny, dano alip pyeraŋwen wiye aŋwen, ki miya abiro ki pyerabicel ma guyubbe pi lweny. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulwenyo ki Jekur, Napic ki Nodab, ma gin jo Agri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.19",
            "verseOrgIds": [
              "1CH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubaŋa okonyogi ka lweny kwedgi, pien gukok bote i kare ma gilwenyo, ci en oye legagi pien onoŋo gigene, ci omiyo jo Agri ki lwakgi ducu i ciŋgi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.20",
            "verseOrgIds": [
              "1CH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyako limgi makwo ma romo kinaga alip pyerabic kulu, romi alip miya aryo ki pyerabic, ki kana alip aryo, kacel ki dano alip miya acel ma guyakogi makwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.21",
            "verseOrgIds": [
              "1CH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guneko jo mapol, pien mony meno obedo mony pa Lubaŋa. Ci gubedo i lobo pa jo-nu nio wa i kare ma giterogi i opii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo me nucu kaka pa Manace gubedo i lobo meno. Gubedo mapol mada cakke ki i lobo Bacan nio kwede wa i Baal-kermon, Cenir ki got Kermon",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi aye ludito wi kaka ma i odi pa kwarogi: Eper, Ici, Eliel, Ajriel, Jeremia, Kodavia ki Jadiel, twoni oteka lweny ma nyiggi oywek, ma gin aye ludito i odi pa kwarogi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.24",
            "verseOrgIds": [
              "1CH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento gu,nayo waŋ Lubaŋa pa kwarogi, gubedo ka woro lubaŋa pa jo me lobo meno ki tim kwele kwele-gu, gin jo ma onoŋo Lubaŋa otyekogi woko ki i nyimgi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.25",
            "verseOrgIds": [
              "1CH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
