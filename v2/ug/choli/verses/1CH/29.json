              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi oto ma doŋ oti woko likon, i kare maber mupoŋ ki lonyo ki deyo; ci wode Solomon oleyo ka tyene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
