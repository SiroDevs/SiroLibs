                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Caulo oto pien pe obedo lagen; oŋayo waŋ Rwot woko, pe otiyo gin ma Rwot ociko, dok owoto ka tyet bot lakor tipo pi yero nyime, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma pe openyo dog Rwot. Pienno omiyo Rwot oneke woko, ci okwanyo ker omiyo bot Daudi ma wod pa Yece.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
