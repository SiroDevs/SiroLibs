          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno jo Piliciti gulwenyo i kom Icrael. Jo Icrael guriŋo woko ki i nyim jo Piliciti, ci ginekogi i wi got Gilboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Piliciti guriŋo gudiŋo kor Caulo ki awo bene, ci guneko Yonacan ki Abinadab ki Malkicua, gin ducu awobe pa Caulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lweny ogeto matek i kor Caulo, ci wegi atero gucele woko, guketo ret i kome, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caulo owaco bot latin jami lwennye ni, “Wot pala lucwanni woko, icoba kwede pil, wek jo ma pe gilirogini, ma pe giŋeyo Lubaŋa pe gubin i koma, miyo giyarre i koma.” Ento latin jami lwennye pe oye, pien lworo omake matek, omiyo Caulo okwanyo pala lucwanne kikome ci opoto ogurre kwede kekene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka latin jami lwennye oneno ni Caulo doŋ oto woko, ci en bene opoto ogurre kene ki pala lucwanne, oto woko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit meno Caulo ki awobene adek-ki kacel ki jo me ode ducu, guto woko lawaŋacel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jo Icrael ducu ma onoŋo gitye i nota guneno ni mony pa jo Icrael guriŋo woko, ki Caulo ki awobene ginekogi woko, ci guriŋo guweko gaŋigi woko; ci jo Piliciti gubino gucako bedo i gani-nu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwone jo Piliciti gubino ka lunyo boŋŋi ki i kom jo ma ginekogi, ci gunoŋo kom Caulo ki kom awobene adek-ki i kom got Gilboa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulunyo jami lweny pa Caulo ki i kome, gucito kwede, wa ki wiye bene ma gutoŋo, ka gucwalo kwena oromo i lobo pa jo Piliciti ducu pi tero lok me yomcwiny bot jogigi ki bot lwakgi ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guketo jami lweny pa Caulo i oŋogigi; ka dok guguro wiye i ot jok Dagon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka jo Jabec-gilead ducu guwinyo gin ma jo Piliciti gutimo i kom Caulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci oteka lwenygi ducu gua, gukwanyo kom Caulo woko ki kom awobene, guterogi wa i Jabec, Ka guyiko cogogi i te yat kworo ma tye i Jabec, ci guri kec pi nino abiro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
