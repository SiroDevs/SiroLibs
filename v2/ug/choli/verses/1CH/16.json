            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci lwak ducu guket, dano acel acel odok i ode, ki Daudi bene odok i pacone ka lamo gum i kom jone.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
          }
        }
