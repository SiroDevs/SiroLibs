          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Rom 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wel jo Icrael bibedo macalo kweyo me dog nam, ma pe pimme, ma pe kwanne bene; dok i kabedo ka ma ceŋ giwaco botgi ni, “Wun pe wujona” gibiwaco botgi ni, “Wun litino pa Lubaŋa makwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Juda ki jo Icrael gibicokke kacel, ci gibiketo ŋat acel ma bi telo wigi; ci gibia woko ki i lobo meno, pien nino pa Jejreel bibedo dit twatwal.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
  ],
