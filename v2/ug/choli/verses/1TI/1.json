              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraga man oa ki bot Paulo ma lakwena pa Kricito Yecu pi cik pa Lubaŋa Lalarwa ki Yecu Kricito ma genwa ocuŋ i kome.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        }
