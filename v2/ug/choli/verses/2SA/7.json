          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai Rwot Lubaŋa, in aye Lubaŋa, lokki bedo me ada, ci in doŋ ityeke cikke me timo gin man maber pira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
