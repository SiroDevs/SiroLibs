  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2SA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Daudi dok otayo jo Piliciti, ocako loyogi, dok omayo Meteg ama ki i ciŋgi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi dok otayo jo Moab, ka opimogi ki tol, kun omiyo gubuto piny i nom. Opimo tol aryo me aneka ki tol acel me aweka makwo. Ci jo Moab gubedo i te loc pa Daudi, kun giculo mucoro bote.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi dok otayo Adadejer wod pa Rekob kabaka me Joba, ma onoŋo ocito ka roco kerre odoko tek i dog kulu Euprate. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi omako wegi aguragurane alip acel ki miya abiro, ki askari ma giwoto ki tyengi alip pyeraryo. Oŋolo odoŋ tyen aguragura ma yam ywayo gadigadi lwenygi, ento oweko mogo manok odoŋ ma romo ywayo gadigadi miya acel. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jo Ciria me Damaciko gubino ka konyo kor Adadejer me Joba, Daudi oneko jo Ciria alip pyeraryo wiye aryo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi oketo lumony i cel gogo i lobo Ciria ma i ŋet Damaciko; ci jo Ciria ma gitye kunnu gubedo i te loc pa Daudi kun giculo mucoro bote. Rwot obedo ka miyo tek me bwoyo lobo bot Daudi ka ma en cito iye ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi oyako lwak kwodi me jabu ma yam lutic pa Adedejer tinogi, ci oterogi i Jerucalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok kabaka Daudi oyako lwak jami mapol me mola ki i Beta ki Berotai, ma yam obedo gaŋi pa Adadejer.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ma Toi kabaka me Kamat owinyo ni Daudi otyeko tayo mony pa Adadejer woko ducu liweŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci Toi ocwalo wode Joram bot Daudi ka mote, ki pi pwoye pi lweny i kom Adadejer ki pi loyo en woko; pien yam Adadejer obedo ‘ka lweny ki Toi tyen mapol. Joram onoŋo obino ki jami me ryal ki jabu ki mola-gu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "jami meno bene kabaka Daudi odyerogi bot Rwot, kacel ki ryal ki jabu mukene ma en odyero ma oyakogi ki bot rok ducu ma en otayogi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bot jo Edom, jo Moab, jo Ammon, jo Piliciti ki jo Amalek, kacel ki jami ma oyako ki bot Adadejer wod pa Rekob, kabaka me Joba.’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.60"
              },
              "items": [
                {
                  "text": "Jab 60",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi olimo yweka pi tekke kekene. I kare ma doŋ en tye ka dwogo, oneko jo Edom alip apar wiye aboro i nota me Kado. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oketo lumony i cel gogo i Edom, oromo i lobo Edom ducu, ci jo Edom gubedo i te loc pa Daudi. Rwot omiyo Daudi obwoyo lobo ka ma ocito iye ducu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi oloyo jo Icrael ducu kit meno; dok obedo ka ŋolo kop atir dok kakare i kom lwakke ducu: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab wod pa Jeruya obedo ladit me mony; ki Yekocapat wod pa i Akilud obedo laco lok ma timme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jadok wod pa Akitub ki Akimelek wod pa Abiatar gubedo ajwagi; Ceraya obedo karan; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
            "verseOrgIds": [
              "2SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya wod pa ekoyada obedo ladit ‘ma loyo jo Keret ki jo Pelet; ki awobe pa Daudi gubedo ajwagi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.18",
            "verseOrgIds": [
              "2SA.8.18"
            ]
          }
        }
      ]
    }
