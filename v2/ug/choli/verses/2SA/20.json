            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-nu onoŋo Joab aye ladit ma loyo mony pa jo Icrael ducu; ki Benaya wod pa Yekoyada aye loyo jo Keret ki jo Pelet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
