          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceva obedo karan, ki Jadok ki Abiatar gubedo ajwagi pa Lubaŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        },
