          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoram aye onoŋo ladit ma loyo tic muroni; ki Yekocapat wod pa Akilud onoŋo laco lok ma timme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
