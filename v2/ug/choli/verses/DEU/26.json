              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dok tin Rwot otuco lok i komwu ni wun aye wu jone kikome, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "dok en bipilo wiwu makato rok ducu ma yam en oketo; gibipake piwu, nyiŋe biywek piwu, en bilimo deyo i komwu, dok otuco ni wun wubibedo rok maleŋ pi Rwot Lubaŋawu,” kit ma yam owaco ni.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
