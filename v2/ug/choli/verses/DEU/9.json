                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.16"
              },
              "items": [
                {
                  "text": "Ibru 3.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka yam Rwot ocwalowu nia ki i Kadec-bamea kun waco ni, ‘Wucit, wucam lobo ma doŋ amiyowu-ni’, ci wujemo woko i kom cik pa Rwot Lubaŋawu; yam pe wugene, pe wuworo doge. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
