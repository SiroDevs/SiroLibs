                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.7"
              },
              "items": [
                {
                  "text": "Nia 17.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Dok bene yam i Tabera, ki i Maca ki i Kibrot-atava wubedo ka mi yo Rwot bedo ki akemo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
