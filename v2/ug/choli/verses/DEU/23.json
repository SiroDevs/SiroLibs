          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka iwok ki i dye poto olok pa lawoti, itwero camo nyige mabup macalo imito, ento pe ibipiko mogo i kicaani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ka iwok ki i poto pa lawoti ma kal Ocuŋ iye, itwero jako wite ki ciŋi, ento pe ibiketo pala kac i ŋut kal mucuŋ i poto pa lawoti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
