              "items": [
                {
                  "text": "Mat 5.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ka ikwoŋo kwoŋ mo bot Rwot Lubaŋani, pe ibed ka galle ki cobone; pien Rwot Lubaŋawu bipenyi pire ada, ci bibedo bal boti ka pe iculo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka pe ikwoŋo kwoŋ, bal mo pe boti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento tekke imine ka kwoŋo kwoŋ mo bot Rwot Lubaŋawu, myero igwokke mada ka cobo lok ma okatti ki i dogi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
    },
