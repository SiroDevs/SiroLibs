                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Nwo 15.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Pe ibimiyo omeru ma dano me Icrael mako banya boti me ciliŋ nyo me cam pi limo magoba, kadi banya me gin mo ma kelo magoba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwero mako magoba i kom banya ma imiyo bot dano me rok mukene, ento pe i kom banya ma imiyo bot omeru ma Laicrael. Ka ilubo cik man ci miyo Rwot Lubaŋawu bimiyi gum i kom gin ducu ma ibitiyo i lobo ma doŋ wucok donyo iye me camone-ni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
      ]
