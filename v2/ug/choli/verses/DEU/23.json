          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 23:3"
          },
          "items": [
            {
              "text": "3",
