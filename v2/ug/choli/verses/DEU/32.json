              "type": "text"
            }
          ]
        },
        {
          "text": "Moses okwano wer man ducu wek lwak guwiny, en kacel ki Yocwa wod pa Nun.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
