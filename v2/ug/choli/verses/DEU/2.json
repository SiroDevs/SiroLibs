                "loc": "NUM.21.4"
              },
              "items": [
                {
                  "text": "Wel 21.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yam walokke, wawoto i tim, i yo ma dok tuŋ Nam Makwar, kit macalo Rwot ocika; ci wabedo ka rabo ŋet lobo godi me Ceir pi mwaka mapol. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok Rwot owacca ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Wubedo ka rabo ŋet lobo godi man kare malac, doŋ oromowu; wulokke wudok yo tuŋ acam. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "Acak 36.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ci icik lwak ni, Wun doŋ wucok ka wok ki i lobo pa utmegiwu likwayo pa Ecau ma gibedo i Ceir, ci gibibedo ki lworo i komwu. Myero wugwokke mada, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pe wucak lweny i komgi, pien pe abimiyowu dul lobogi mo, pe kadi ma tyenwu romo cuŋ iye, pien atyeko miyo lobo godi me Ceir bot Ecau obed mere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubiwilo cam botgi ki lim wek wucam; dok pii amatawu bene wubiwilo botgi ki limo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien Rwot Lubaŋawu obedo ka miyowu gum i kom tic ducu ma ciŋwu otiyo; en ŋeyo kit ma wuwok wukato kwede i dye tim man malac-ci. Rwot Lubaŋawu obedo kwedwu i lwak mwaka man ducu pyeranwen-ni, ma can gin mo pe omakowu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumiyo wacito waa ki ka ŋet utmegiwa likwayo pa Ecau ma gibedo i Ceir, kun walubo yo me Araba mua ki i Elat ki Ejiongeber.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ci walokke, wacito i yo ma kemo tuŋ tim me Moab. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.37"
              },
              "items": [
                {
                  "text": "Acak 19.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka Rwot dok owacca ni, ‘Pe icit magwa i kom jo Moab, pe icak lweny i komgi, pien pe abimiyi dul lobogi mo obed mewu, pien atyeko miyo Ar bot likwayo pa Lot obed megi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Yam jo Emim aye gukwoŋo bedo kunnu; gin rok madit, gipol bene, jo maboco macalo jo Anak. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.10",
            "verseOrgIds": [
              "DEU.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo man gikwanogi i kin jo Repaim bene macalo jo Anak, ento jo Moab lwonogi ni jo Emim. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.11",
            "verseOrgIds": [
              "DEU.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki jo Kori bene yam gukwoŋo bedo i Ceir, ento likwayo pa Ecau aye gucamo lobogi, gutyekogi woko liweŋ ki i nyimgi, guleyo kabedogi, macalo jo Icrael gutimo ki lobo ma odoko megi, ma Rwot omiyogi-ni.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Doŋ wua malo kombeddi, wuŋol nota ora me Jered.’ Kit meno yam wacito, waŋolo nota ora me Jered. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Wel 14.28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nia i kare ma waa ki i Kadec-bamea nio ka waŋolo nota ora me Jered onoŋo oromo mwaka pyeradek wiye aboro, nio kwede i kare ma yalwak meno ducu, ma en aye jo ma lulweny, doŋ guto gutum woko ki i gony, kit ma yam Rwot okwoŋo kwede kwoŋ i komgi-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien onoŋo yam ciŋ Rwot tye i komgi likiŋ pi tyekogi woko ki i gony, nio ka gutum woko ducu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kit meno ka yam jo ducu ma lulweny guto gutum woko ki i kin lwak, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
              "DEU.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci Rwot owacca ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.17",
            "verseOrgIds": [
              "DEU.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Tin doŋ ibikato ki i waŋ lobo Moab kun iwok ki i Ar. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.18",
            "verseOrgIds": [
              "DEU.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.38"
              },
              "items": [
                {
                  "text": "Acak 19.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka doŋ inyiko cok i nyim likwayo pa Ammon, pe icit magwa i komgi, pe icak lweny i komgi, pien pe abimiyi dul lobo mo pa jo Ammon obed mewu, pien atyeko miyone woko bot likwayo pa Lot obed megi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Meno bene gilwoŋo ni lobo pa jo Repaim. Jo Repaim aye yam gukwoŋo bedo kenyo, ento jo Ammon lwoŋogi ni jo Jamjummim, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.20",
            "verseOrgIds": [
              "DEU.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin yam gubedo rok madit, ma gipol bene, giboco macalo jo Anak; ento Rwot otyekogi woko liweŋ ki i nyimgi, ci jo Ammon gucamo lobogi, guleyo kabedogi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.21",
            "verseOrgIds": [
              "DEU.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kit ma yam Rwot otimo pi likwayo pa Ecau ma gibedo i Ceir, i kare ma otyeko jo Kori woko ki i nyimgi, ci likwayo pa Ecau gucamo lobogi, guleyo kabedogi, pud gibedo iye wa tin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.22",
            "verseOrgIds": [
              "DEU.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok jo Avi bene ma yam gubedo i gaŋgi matino nio wa i Gaja, jo Kaptor aye, ma yam gubino gua ki i Kaptor, gucamo lobogi, guleyo kabedogi.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Wua malo, wucak wot, wucit wuŋol nota me Amon. Nen, atyeko miyo Cikon i ciŋwu, ma en aye dano me Amor, kabaka me Kecbon, kacel ki lobone; wucak camone, ma wucako doŋ lweny i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tin abicako keto atiba ki lworo piwu i kom rok ma tye piny i te polo ducu. Ka giwinyo lok i komwu, komgi bimyel, gibinyonne woko piwu matek.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mumiyo acwalo lukwena nia ki i tim me Kedemot bot Cikon kabaka me Kecbon ki lok me kuc, kun awacce ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Ber iwek awok akat ki i loboni; abicito alubo gudo keken, pe Abiŋak adok yo tuŋ acuc nyo tuŋ acam, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibicatta cam me acama ma awilo ki lim, dok ibimiya pii bene me amata ma awilo ki lim. Wek awok akat ki tyena keken, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kit macalo likwayo pa Ecau ma gibedo i Ceir, ki jo Moab ma gibedo i Ar yam gutimo, nio ka aŋolo Jordan akato wa i lobo ma Rwot Lubaŋawa bimiyowa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Cikon kabaka me Kecbon pe oye ni wawok ki i lobonie; pien Rwot Lubaŋawu omiyo cwinye obedo tek ki adunone obedo nwaŋ, wek emi en i ciŋwu, macalo otimme-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot owacca ni, ‘Nen, doŋ acako miyo Cikon ki lobone i ciŋi: cak doŋ camone wek wule lobone obed mewu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok Cikon ocorre obino i komwa, en ki lwakke ducu ka lweny i Jakaj. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot Lubaŋawa omiyo en i cidwa, waloyo en ki awobene ki lwakke ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare meno wamayo gaŋine madito ducu, wajwerogi woko liweŋ, co wa ki mon ki litino, pe waweko ŋat mo odoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watero lim makwo keken wayako odoko mewa, kacel ki jami ma wayako ki i gaŋi ma wamayogi-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nia ki i Aroer ma tye i dog nota me Amon, ki nia ki i gaŋ ma tye i nota nio wa i Gilead, pe onen gaŋ mo ma gigero ma malo twatwal ma mayone oloyowa; Rwot Lubaŋawa omiyogi ducu i ciŋwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobo pa likwayo pa Ammon keken yam pe wunyiko cok kwede, en aye lobo ducu ma i dog kulu Jabok, ki gaŋi ma i lobo godi, ki ka ma Rwot Lubaŋawa ojukowa pire-ni ducu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
      ]
    }
