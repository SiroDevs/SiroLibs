                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wubikwano cabit abiro cakke ki i kare ma wukwoŋo keto iye pala kac i ŋut kal mucuŋ i poto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dok wubibedo ki nino madit me kwero agikki cabit abiro i nyim Rwot Lubaŋawu kun wumiyo gityer ma iwu opwoyo; wubimiyo muporo gum ma Rwot Lubaŋawu omiyowu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibibedo ki yomcwiny i nyim Rwot Lubaŋawu, in ki wodi ki nyari ki opiini ki aŋecani, ki Lulevi ma gibedo i gaŋwu, ki lubedo ki litino kic ki mon-to ma tye i kinwu, ki i kabedo ma Rwot Lubaŋawu biyero, ka ma en biketo iye nyiŋe bedo iye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubipo ni yam wubedo opii i Ejipt, ci wubigwoko cik magi ducu matek.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
