                }
              ]
            }
          ]
        },
        {
          "text": "“Wun aye litino pa Rwot Lubaŋawu: pe wubiŋolo komwu kenwu nyo Lyelo tur nyimwu pi kwero cola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
