              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka laco mo orwatte ki nyako mo ma peya gitoŋo keny i kome ce omake tektek obuto kwede, ka gimakogi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
