          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci laco ma obuto kwede-ni bimiyo lim me luk bot won nyako ma romo cekel pyerabic, ci nyako-nu bidoko dakone, pien omake ki tek; pe biryeme woko matwal pi kare me kwone ducu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
