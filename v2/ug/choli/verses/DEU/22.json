              "DEU.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.37+NUM.15.38+NUM.15.39+NUM.15.40+NUM.15.41"
              },
              "items": [
                {
                  "text": "Wel 15.37-41",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibikwoyo jira aŋwen i twok boŋo ma iume kwede-ni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka laco mo onyomo nyako ce obedo kwede, ka iye okwere woko, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.13",
            "verseOrgIds": [
              "DEU.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci otoŋo doge ki lok me lewic ma obalo nyiŋ nyako woko marac kun waco ni, ‘Anyomo nyako man ci ka anyiko bote cok pe anoŋo gin ma nyuto atir ni peya ocodo co,’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "won latin dako-nu ki minne gibikelo boŋo ma nyuto atir ni latin dako-nu peya ocodo co bot ludoŋo ma i gaŋ meno ka ma gicokke iye i dog gaŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.15",
            "verseOrgIds": [
              "DEU.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci won latin dako-nu biwaco bot ludoŋo ni, ‘Amiyo nyara o ot laco man ci onyomo ka dok okwero en woko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.16",
            "verseOrgIds": [
              "DEU.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci, nen, okelo lok me lewic i kome kun waco ni pe enoŋo gin ma nyuto atir ni nyara peya ocodo co, Koŋ wunen, man en aye gin ma nyuto atir ni nyara peya ocodo co.’ Ci biyaro bone-nu i nyim ludoŋo ma i gaŋ meno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.17",
            "verseOrgIds": [
              "DEU.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ludoŋo gibitero laco-nu gigoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
              "DEU.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "giŋolle cul me cekel me ryal miya acel. Gibimiyo limme bot won nyako, pien laco-nu obalo nyiŋ nya jo Icrael ma peya ocodo co. Ci bibedo dakone, pe biryeme woko matwal pi kare me kwone ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka lokke ada ni, gin mo pe ginoŋo ma nyuto atir ni latin dako-nu peya ocodo co, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci jo ma i gaŋ meno gibicele ki got gineko woko, pien otimo gin ma pe myero i Icrael pi codo co ki i ot pa wonne. Wubijwero tim marac woko ki i kinwu kit meno.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ginoŋo laco mo obuto ki dako pa laco mukene, gin aryo ducu gibito, laco ma obuto ki dako, ki dako bene. Kit meno miyo wubijwero gin marac woko ki i kinwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
