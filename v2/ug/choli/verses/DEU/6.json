                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.12"
              },
              "items": [
                {
                  "text": "Luka 4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Pe wuom i Rwot Lubaŋawu, macalo yam wuomo kwede iye i Maca. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuket cwinywu ka gwoko lok ducu ma Rwot Lubaŋawu ociko, ki lokke me caden, ki cikke ducu ma en ocikowu kwede. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok wubitiyo gin ma nen atir dok maber i waŋ Rwot, wek nyimwu obed leŋ, wek wucit wucam lobo maberri ma yam Rwot okwoŋo pire ni ebimiyo bot kwarowu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun wuryemo lukworwu woko ducu ki i nyimwu, macalo Rwot yam owaco.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“I kare me anyim, ka latinni bipenyi ni, ‘Lok man me caden kono te lokke aŋo, ki lwak cik ducu ki gin ma giŋolo ma Rwot Lubaŋawa ocikowa kwede-ni?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ci ibiwaco ki latinni ni, ‘Wan yam onoŋo wabedo opii pa Parao i Ejipt, ci Rwot okwanyowa ki i Ejipt pi twero me bade. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yam Rwot onyuto lwak lanyut ki taŋo madito dok malit twatwal i kom lobo Ejipt ki i kom Parao ki i kom jo ma i ode ducu ma waneno ki waŋwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.22",
            "verseOrgIds": [
              "DEU.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwanyowa woko ki kunnu wek ekelwa wa kany, eminiwa lobo ma yam okwoŋo pire ni ebimiyo bot kwarowa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
              "DEU.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot yam ocikowa ni walub cik magi ducu, dok ni walwor Rwot Lubaŋawa wek wabed maber nakanaka, wek en ogwokwa wabed makwo, macalo koni watye-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka wagwokke wek wacob lok man ducu ma gicikowa kwede ki i nyim Rwot Lubaŋawa, macalo en yam ocikowa kwede, miyo wabedo jo ma kitwa atir.’",
          "type": "text",
          "attrs": {
