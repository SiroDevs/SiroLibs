                  "text": "24.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe tye ŋat mo i gaŋ man ma woro lunyodone Gibedo ka uno labedo; dok gitime litino kic ki monto marac twatwal ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.7",
            "verseOrgIds": [
              "EZK.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.30"
              },
              "items": [
                {
                  "text": "Levi 19.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.2"
              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gubedo ka cayo jamina maleŋ-gu dok bene gupyedo cen cabitta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
              "EZK.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tye jo mogo i kinwu ma giloko lok me toŋo dano wek ginek woko. Jo mukneu i kinwu gicamo cam ma gityero bot cal jogi i waŋ jogi ma tye i wi godi. Gitime tim kipyeda twatwal i dye gaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
              "EZK.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.7+LEV.18.8+LEV.18.9+LEV.18.10+LEV.18.11+LEV.18.12+LEV.18.13+LEV.18.14+LEV.18.15+LEV.18.16+LEV.18.17+LEV.18.18+LEV.18.19+LEV.18.20"
              },
              "items": [
                {
                  "text": "Levi 18.7-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dano gibedo ki megigi ki ci-wegigi i Jeruca lem; dok bene gidiyo mon i kare ma noŋo gitwoyo two kwer tetek ci gibutu kwedgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
              "EZK.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gitimo gin me kwer bene kun gitimo abor ki mon pa luwotgi Jo mukene gitimo tim kipyeda i koo ci-wodgi, ki jo mukene gibalo k lumegigi ima anyira pa wegtgi kikome ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.11",
            "verseOrgIds": [
              "EZK.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 22:12"
          },
