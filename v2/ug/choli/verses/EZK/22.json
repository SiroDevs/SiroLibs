              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.19"
              },
              "items": [
                {
                  "text": "Nwo 16.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19"
              },
              "items": [
                {
                  "text": "23.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "jo mogo gineko dano pi lim ma noŋo giculogi kwede jo mukene limo magobi madwoŋ, ki noŋo lim mukene pi yako jami pa luwotgi tektek; mumiyo wigi doŋ owil woko i koma.” Man Rwot Lubaŋa ma owaco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.12",
            "verseOrgIds": [
              "EZK.22.12"
            ]
          }
        }
