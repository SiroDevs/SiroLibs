              "type": "text"
            }
          ]
        },
        {
          "text": "Doggola acel acel onoŋo giyubo laiye aryo ma giwirre giyabbe i dye ot ka maleŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
