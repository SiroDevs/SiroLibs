              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "Yabo 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.6"
              },
              "items": [
                {
                  "text": "19.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awinyo bwomgi ka ŋuro i kare ma gitye ka tuk, bwomgi mor calo mor pa pii ma corre, macalo mor pa Won Twer Ducu, ki dok macalo woo madwoŋ pa dwan jo me mony madit; ka gucuŋ mot, ci giumo bwomgi woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci dwan owinnye kun oa ki malo i ne pete ma orine malo ka wigi-ni; i kare ma onoŋo gucuŋ mot, guumo bwomgi woko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        }
