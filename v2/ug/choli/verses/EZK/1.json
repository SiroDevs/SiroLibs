                "loc": "REV.4.6"
              },
              "items": [
                {
                  "text": "Yabo 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki malo ka wi lee magi makwo-ni onoŋo giriyo iye gin mo ma nen calo pete me polo, ma ryeny aryenya calo pee, kun opette lamalo ka wigi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
