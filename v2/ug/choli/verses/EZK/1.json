                  "text": "Yabo 4.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malo i wi pete ma tye ka wigi-ni onoŋo tye iye gin mo calo komker, ma nen calo got capir ma bulu; doŋ gin ma neno calo dano obedo i wi komker meno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
