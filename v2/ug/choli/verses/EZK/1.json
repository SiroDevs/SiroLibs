              "attrs": {
                "loc": "EZK.8.2"
              },
              "items": [
                {
                  "text": "Ejek 8.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gin meno mubedo calo dano-ni onoŋo tye ka ryeny calo mola ocakke ki i pyere odok kwede malo, ma nen calo mac ma omoko orumo kome woko ducu; cakke ki i tuŋ pyere dok kwede piny, onoŋo nen calo mac, mac bene onoŋo tye ka lyel orume woko dyere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen calo danyu ma nen i kom pol ka i nino me kot, mac ma yam obedo ka lyel ma orume dyere-ni bene obedo kit meno.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
