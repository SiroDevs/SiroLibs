          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I te pete meno onoŋo guyaro iye bwomgi, kun bwomgi acel acel gukemme ki luwotgi; ki lee acel acel onoŋo tye ki bwome aryo me umo kome woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
