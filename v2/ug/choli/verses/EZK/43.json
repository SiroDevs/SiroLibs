          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok ibimiyo dyel pi nino abiro me gitum pi bal, kun i nino acel acel noŋo imiyo dyel acel. Dok bene gibimiyo twon ki nyok romo ma gikwanyo ki i kin lwak romi ma kome pe ki mwonyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
