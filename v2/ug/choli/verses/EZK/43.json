          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen dok dano-nu okela wa i dogcel ma okemo yo tuŋ wokceŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.1",
            "verseOrgIds": [
              "EZK.43.1"
            ]
          }
        },
