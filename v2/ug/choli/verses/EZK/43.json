              "items": [
                {
                  "text": "11.22-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "Yabo 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nen, deyo pa Lubaŋa pa Icrael oa ki yo tuŋ wokceŋ, kun mor calo mor pa pii ma corre; omiyo lobo obedo ka ryeny aryenya ki deyone, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok aneno ginanyuta ma obedo rom ki ginanyuta ma yam aneno ma onoŋo Rwot obino ka jwero gaŋ woko-ni, dok bene obedo calo ginanyuta ma yam aneno i ŋet kulu Kebar-ni. Ci cutcut apoto aryebbe woko piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.3",
            "verseOrgIds": [
              "EZK.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deyo pa Rwot okato ki i dogcel ma tye yo tuŋ wokceŋ ci odonyo i ot pa Lubaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Cwiny pa Rwot otiŋa woko malo, okela i dyekal me ot pa Lubaŋa ma i iye; ci aneno deyo pa Rwot opoŋo ot pa Lubaŋa woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ma onoŋo dano-nu pud ocuŋ ka neta, awinyo ŋat mo tye ka lok kweda ki i ot pa Lubaŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
            "verseOrgIds": [
              "EZK.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun wacca ni, “Wod pa dano, man aye kabedo ka ma komkerra bedo iye, dok bene en aye kabedo ka ma ateno iye tyena; en aye ka ma abibedo iye i kin jo Icrael matwal. Doŋ jo Icrael, nyo lukergi, pe gibimedde ki balo nyiŋa maleŋ-ŋi, kun giwoi o lubaŋa mukene nyo gucibo gin me po lukergi mogo ma doŋ guto woko-gu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukergi yam guyubo doggolagi okemme ki doggolana ki dok guketo yat doggolagi okemme ki mera, man omiyo doŋ tye cel acel keken ma opoko kinwa kwedgi. Gubalo nyiŋa maleŋ-ŋi ki gin me kwer-gu ma gutimo, omiyo kiniga omaka atyekogi woko liweŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kombeddi doŋ myero gukwany cal lubaŋagi-gu gubol woko, ki gin me po lukergi ma yam doŋ guto woko-gu, gubol woko ka mabor ki ka ŋeta, ci an abibedo i dyegi matwal.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Rwot dok omedde ki lokke owacca ni, “Wod pa dano, tit kit me ot pa Lubaŋa bot jo Icrael, tit botgi kit ma nen kwede ki kit yubbe, wek omi lewic omakgi pi balgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka doŋ ineno lewic omakogi pi bal ducu ma yam gutimo, ci doŋ itit botgi yub ma gigero ki ot pa Lubaŋa-ni, kit ma gigero kwede doggolane me donyo ki dogcel ka ma gikato ki iye ki ka ma gidonyo ki iye, ki kit ma gedo me ot pa Lubaŋa ducu ocuŋ kwede, Dok bene imi guŋe kit me lubo cikke ducu, ki gin ma Rwot ociko ducu; co woko piny i nyimgi ma gin bene gineno, wek omi gin gugwok dok guti gin ma giciko ducu kun gilubo cik ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.11",
            "verseOrgIds": [
              "EZK.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aye cik me ot pa Lubaŋa: Kabedo ducu murumo ma tye i wi got bibedo kabedo maleŋ makato ducu. Man aye cik me ot pa Lubaŋa.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
