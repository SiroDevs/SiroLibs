              "type": "text"
            }
          ]
        },
        {
          "text": "Ibityero bot Rwot, ki ajwagi gibikiro kado i komgi ka doŋ gicako tyerogi bot Rwot macalo gitum awaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
