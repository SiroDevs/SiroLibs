          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibityero gitum lakwany bal pi keno tyer pi nino abiro kun gilonyo, dok gikwero bene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
