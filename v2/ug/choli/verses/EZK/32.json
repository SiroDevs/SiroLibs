          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Edom tye kunnu kacel ki lukerre ki rwodine ducu. Gin onoŋo gubedo askari matego mada, ento kombeddi doŋ giyikogi kacel ki jo ma pe gilirogi ma yam ginekogi i lweny.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        }
      ]
    },
