                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.24+MRK.13.25"
              },
              "items": [
                {
                  "text": "Mar 13.24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.25"
              },
              "items": [
                {
                  "text": "Luka 21.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Yabo 6.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.12"
              },
              "items": [
                {
                  "text": "8.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka doŋ atyeko neki woko, ci abiumo pol woko, kun amiyo lakalatwene ducu gicido macol licuc; abimiyo pol umo ceŋ woko, ki dwe bene doŋ pe biryeny ma miyo derone caro piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abikwanyo dero me gin ma ryeny ducu ma tye i polo woko ci amiyo loboni doŋ i colpiny. Man Rwot Lubaŋa ma owaco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abiryano cwiny jo me rok mapol, ka aterowu i opii i kin lurok i wi lobo ducu ka ma yam onoŋo pe wuŋeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimiyo lwak me rok mapol gibedo ki ur twatwal i komi, ki lukergi bene komgi bimyel ki lworo piri. Ka atiŋo pala lucwanna i nyimgi i kare ma ibilimo iye can-ni, lurok kacel ki lukergi komgi bibedo ka myel amyela cawa ducu, kun noŋo dano acel acel paro pi kwone keken.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot Lubaŋa owaco kuman ni, “Kabaka me Babilon bibino ci lwenyo i komi ki pala lucwanne. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiweko askari ma gua ki i rok mager ducu giwoto pala lucwangi ci gineko ki lwakki woko. Gibijwero jami ducu ma it ye ka wakke pigi-ni, ci gineko lwakki woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abineko dyaŋini woko ducu ki i waŋ pii’ mapatpat, Doŋ dano nyo lee mo bibedo pe matwal ma birubo pii balo woko ki coto doki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimiyo piine pye mot ci doko maleŋ, dok abimiyo pii ma i kuluni ducu mol mot calo moo ma mol. Man Rwot Lubaŋa ma owaco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ma amiyo lobo Ejipt odoko obur ma iye odoŋ nono, dok ka jami ducu ma yam opoŋo loboni doŋ gijwero woko, ka bene aneko jo ducu ma gibedo iye, man bimiyo giŋeyo ni an aye a Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man bilokke doko wer lyel. Mon me rok ducu gibiwero wer man me lyel-li, kun gikok kwede pi Ejipt ki lwakke ducu; gibigoyo wer lyel man ki jami agoya-gu. Man Rwot Lubaŋa ma owaco.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino dwe apar wiye abic, dwe me acel, i mwaka me apar wiye aryo, Rwot oloko kweda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacci, “Wod pa dano kok pi lwak ma gibedo i Ejipt, ci icwalgi kacel ki mon me rok matego gudony piny i lobo pa jo muto, ka ribbe ki jo ma yam doŋ guto giyikogi i lyel kunnu-ni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.18",
            "verseOrgIds": [
              "EZK.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibito kacel ki jo ma ginekogi i lweny. Dok bene lweny ma tye-ni giyubo pi neko jo Ejipt ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwodi ma gin cogi oteka gibiloko pigi ki pi jo ma yam konyogi, ma noŋo doŋ gitye i dye lyel, kun giwacci, ‘Doŋ gutyeko donyo piny kany, gibuto woko mot, gin jo ma pe gilirogi ma ginekogi i lwenynyi.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aciria tye kunnu, ki lyel pa askari me monnye bene orume woko dyere. Gin askari-gu ducu ginekogi ki pala lucwan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.22",
            "verseOrgIds": [
              "EZK.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyelgi tye piny wa i dye bur ka matut adada, ki askari dul monnye gurumo lyelle woko; gin ducu doŋ ginekogi woko ki pala lucwan, gin jo ma yam nyayo lworo marac i lobo pa jo makwo-ni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elam bene tye kunnu, kun lwakke ducu gurumo lyelle woko; gin ducu ginekogi woko ki pala lucwan. Ci gudonyo piny i lyel i lobo pa jo muto ma kun pe gilirogi. Gin aye jo ma ginyayo lworo marac i lobo pa jo makwo, ento gibedo ki lewic kacel ki jo ma gidonyo piny i bur. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
            "verseOrgIds": [
              "EZK.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gipeto kitanda pi jo Elam i kin jo ma ginekogi kacel ki lwakke ducu, dok lyel pa askarine orume woko dyere. Gin ducu jo ma pe gilirogi, ginekogi woko ki pala lucwan. Yam lworo i komgi onya i lobo pa jo makwo, ento koni doŋ gibedo ki lewic kacel ki jo ma gidonyo piny i bur; giketogi i kin jo ma ginekogi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        }
      ]
    },
    {
