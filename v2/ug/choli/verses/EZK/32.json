              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mecek ki Tubal gitye kunnu, kacel ki lwakgi ducu, ki lyel pa askari monygi bene orumogi woko dyere. Gin ducu jo ma pe gilirogi ginekogi woko i lweny ki pala lucwan; pien gubedo ka nyayo lworo marac i lobo pa jo makwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano pe miyo botgi woro i kare ma giyikogi, kit macalo gimiyo woro kwede i kare ma giyiko twoni oteka lweny macon, ma giketogi i lyel ma gurukke woko ki jami lwenygi, giteno wigi ki pala lucwangi dok giumo komgi ki kwotgi. Gin twoni oteka magi onoŋo yam gitego mada ma gubedo ka miyo lworo marac omako jo makwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
