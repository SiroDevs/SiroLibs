                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot oloko kweda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.1",
            "verseOrgIds": [
              "EZK.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacci, “Wod pa dano, cik waŋi inen got Ceir, ci itit lok i kome. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.2",
            "verseOrgIds": [
              "EZK.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wac bot jo ma gibedo kunnu ni, an Rwot Lubaŋa awaco kuman ‘ni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, atye ki lok i komwu, wun jo ma i kom got Ceir.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiryeyo ciŋa i komwu ci amiyo lobowu doko obur ka ma dano mo pe bedo iye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiweko gaŋiwu ducu doko obur, ki wun doŋ wubibedo i lobo ma oballe woko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man bimiyo wuŋeyo ni an aye a Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wun onoŋo wubedo lumone pa jo Icrael ducu, kun wumiyo gibedo ka nekogi woko ki pala lucwan i kare ma can opoto i komgi, ki i kare me keto can i komgi me agikki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.5",
            "verseOrgIds": [
              "EZK.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno, kit macalo atye kwo-ni, man Rwot Lubaŋa ma owaco, doŋ abiyubo to aye ma binekowu, ma binekowu nakanaka tyekowu woko; pien wutye ki bal alii me nek, pi meno to bibedo ka nekowu nakanaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.6",
            "verseOrgIds": [
              "EZK.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimiyo got Ceir doŋ obur, ki lobone doŋ iye noŋo; doŋ abimiyo jo ma gibino ki jo ma gicito gikato ki kenyo gitum woko matwal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.7",
            "verseOrgIds": [
              "EZK.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abipoŋo wi godiwu ki kom dano ma ginekogi; ki jo ma ginekogi ki pala lucwan gibipoto i wi cerewu ducu ki i notawu ki loŋowu ducu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.8",
            "verseOrgIds": [
              "EZK.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimiyo lobowu iye doŋ noŋo kare ducu, ki gaŋiwu bene ducu dano doŋ pe bibedo iye. Man bimiyo wuŋeyo ni an aye a Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yam wubedo ka wacci rok magi aryo, Icrael ki Juda, ki lobogi ducu bidoko mewu, dok bene wubicamo bedo mewu, kadi bed an Rwot aye abedo Lubaŋagi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.10",
            "verseOrgIds": [
              "EZK.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno, kit macalo atye kwo-ni, man Rwot Lubaŋa ma owaco, abitic kwedwu kun lubo kit kinigawu ki nyekowu ma doŋ wutyeko nyutogi woko ka maleŋ-ŋi, pien wubedo ki adagadaga i kom jona. Abimiyo wuneya i kinwu kekenwu, ka doŋ acako ŋolo kop i komwu pi gin ma wutimo i kom jona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.11",
            "verseOrgIds": [
              "EZK.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man bimiyo wuŋeyo ni an Rwot onoŋo awinyo lok ma wubedo ka wacone ki cac i kom godi me Icrael, kun wuwacci doŋ gudoŋ igi noŋo, dok ni doŋ gimiyo botwu ni wucam obed mewu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.12",
            "verseOrgIds": [
              "EZK.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok bene wumine kenwu me bedo dit makato an woko, kun wunyatte kwede i koma ma wuloko lok mapol; ento meno an awinyo woko.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot Lubaŋa owaco kuman ni, “Abimiyo lobowu iye doŋ noŋo, wek jo me wi lobo ducu gubed ki yomcwiny pi can ma opoto i komwu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kit macalo wubedo ki yomcwiny pi ginaleya pa jo me ot pa Icrael, ni pien lobogi doŋ odoŋ nono, an bene abitimowu kit meno, wun jo ma wubedo i got Ceir, ki jo Edom ducu. Man bimiyo giŋeyo ni an aye a Rwot.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.15",
            "verseOrgIds": [
              "EZK.35.15"
            ]
          }
        }
      ]
    }
  ],
