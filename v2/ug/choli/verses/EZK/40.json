          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dok okela i dogcel ma tye yo tuŋ acam, ci opimo, onoŋo ditte obedo rom ki dito pa mukene-gu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
            "verseOrgIds": [
              "EZK.40.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicika ma ŋete-gu, ki cel ma i ŋet doggolane ki kicika ma i doggola me donye onoŋo ditogi ducu rom ki dito pa mukene-gu, onoŋo bene tye iye waŋ dirica mapol ma orumo woko dyere. Borre onoŋo romo futi pyeraŋwen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.36",
            "verseOrgIds": [
              "EZK.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicika ma doggola me donyo onoŋo okemo yo tuŋ dyekal ma woko. Onoŋo cal yadi otit tye ma gigoro i kom cel ma i ŋet doggolane ducu, acel tye yo tuŋcel, ki mukene tye yo tuŋcel ki yone ma ito malo onoŋo tye ki rwom aboro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.37",
            "verseOrgIds": [
              "EZK.40.37"
            ]
          }
        }
      ]
