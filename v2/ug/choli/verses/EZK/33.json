          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot oloko kweda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.23",
            "verseOrgIds": [
              "EZK.33.23"
            ]
          }
        },
