              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "I dyewor me nino meno kikome gineko kabaka Belcajar woko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
