                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Tek 36.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I mwaka me adekke me loc pa Yekoyakim kabaka me Juda, Nebukadnejar kabaka me Babilon obino i Jerucalem ci orumo woko, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.17+2KI.20.18"
              },
              "items": [
                {
                  "text": "2 Luker 20.17-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15+2KI.24.16"
              },
              "items": [
                {
                  "text": "24.10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Tek 36.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.39.7+ISA.39.8"
              },
              "items": [
                {
                  "text": "Ic 39.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot omiyo Yekoyakim kabaka me Juda i ciŋe, ci Nebukadnejar okwanyo jami mo go ma gitiyo kwedgi i ot pa Lubaŋa, oterogi woko i lobo Cinar, oketogi i ot pa lubaŋane, ka oketo jami magi i ot kano lim pa lubaŋane, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cutcut kabaka ociko Acipenaj ma en ladit ma loyo jo ma gikologi, me kelo dano mogo ki i kom jo Icrael, jo ma gin litino ker kacel ki litino pa jo ma gin luye, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "awobe ma komgi pe ki mwonyo, jo mabeco ma gupwonnye i kit ryeko ducu, dok ma gikwiri, ki jo ma tye ki ŋec muromo, ma gitwero tic i gaŋ kal pa kabaka, ki me pwonyogi ki nukuta ki leb pa jo Kaldaya, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka omiyogi ca mo cam maheco nino ducu, kit cam ma en ecamo-ni, ki mato koŋo yiŋo ma yam en mato-ni, Myero gibed ka pwonyogi pi mwaka adek; i agikki mwaka meno ka doŋ gikelgi gucuŋ i nyim kabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kin jo magi onoŋo tye iye Daniel, Anania, Micael, ki Ajaria ma gin ducu dano me kaka pa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci ladit ma loyo jo ma gikolo ocako nyiŋgi kit man: Daniel olwoŋo ni Beltecajar, Anania en olwoŋo ni Cadrak, Micael olwoŋo ni Mecak, ki Ajaria doŋ en olwoŋo ni Abednego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Daniel omoko tamme pe me camo gin me kwer me cam mabeco pa kabaka-ni, kadi ki me balo kome ki koŋo viŋo ma kabaka mato-ni; pi meno openyo ladit ma loyo jo ma gikologi ni oye tamme-ni wek pe ebal kome kekene, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Lubaŋa omiyo gum ki kica bot Daniel i nyim ladit ma loyo jo ma gikolo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ladit ma loyo jo ma gikolo owaco ki Daniel ni, “Alworo rwoda kabaka, ma oyero cam ma myero wucam ki ginamata-gu; ka oneno ni komwu pe yot ma rom ki kom awobe wadiwu ma mwaka me ditogi bene rom ki mewu, ci wubimiyo kabaka neka woko,” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lacen Daniel owaco ki lakan jami ma onoŋo ladit ma loyo jo ma gikolo oyero me gwoko Daniel, Anania Micael ki Ajaria ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Koŋ itemwa pi nino apar, ladit, wek gibed ka miyowa dek ŋor aye wacam ki pii amata keken, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka wek lacen doŋ inen komwa ci ipor ki kom awobe ma gicamo cam mabeco ma kabaka bene camo-ni, ka doŋ iti giri kwedwa kit macalo ineno,” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ladit ma loyo jo ma gikolo owinyo lok meno ma gititte-ni, ci otemogi kumeno pi nino apar. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I agikki me nino apar gineno ni komgi leŋ dok gucwe bene makato awobe ma ca ma gicamo cam pa kabaka mabeco-ni, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cutcut lakan jami okwanyo cam mabeco-gu ki koŋo vino ki botgi, ci omiyo dek ŋor botgi wek gucam.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubaŋa omiyo pwonnye ma malo bot awobe magi aŋwen, i kit kwa nukuta ducu, omiyo gubedo kwiri i lok ducu ki i ryeko ducu, kun Daniel onoŋo niaŋ i ginanyuta ki lek-gu ducu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "I agikki me kare meno, ma kabaka doŋ ociko ni gikelgi i nyime, ci ladit ma loyo jo ma gikolo okelogi i nyim kabaka Nebukadnejar. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gubino gucuŋ i nyim kabaka, ci kabaka oloko kwedgi; i kingi ducu pe ginoŋo ŋat mo kadi ki acel ma rom ki Daniel, Anania, Micael ki Ajaria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.19",
            "verseOrgIds": [
              "DAN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doŋ i kwa lok ducu ma kabaka openyogi kwede, onoŋo ni gikato lutyet ki lukor tipo ducu ma tye i te kerre tyen apar kulu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.20",
            "verseOrgIds": [
              "DAN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Daniel omedde ki bedo kunnu nio wa i mwaka mukwoŋo me loc pa Ciro.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.21",
            "verseOrgIds": [
              "DAN.1.21"
            ]
          }
        }
      ]
    }
  ],
