              "JAS.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.34+MAT.5.35+MAT.5.36+MAT.5.37"
              },
              "items": [
                {
                  "text": "Mat 5.34-37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Makatone ducu, utmegina, pe wukwoŋ kwoŋ ki nyiŋ polo, kadi ki nyiŋ lobo, kadi kit kwoŋ mukene ducu; ento ye lokwu ducu myero obed ni, “Iyo,” nyo ni, “Pe,” wek pe giŋol kop i komwu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat mo i kinwu tye ki can? Myero oleg Lubaŋa. Tye ŋat mo ma tye ki yomcwiny? Myero en ower wer me pako Lubaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
            "verseOrgIds": [
              "JAS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.13"
              },
              "items": [
                {
                  "text": "Mar 6.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tye ŋat mo i kinwu ma kome lit? Myero en olwoŋ ludoŋo me lwak pa Lubaŋa, wek guleg Lubaŋa pire kun giwire ki moo i nyiŋ Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
            "verseOrgIds": [
              "JAS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lega ma niye tye iye bicaŋo latwo, Rwot bitiŋe malo; ka ce onoŋo yam otimo bal mo, ci gibitime iye kica.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi meno, wutuc balwu, ŋat acel acel otuc mere bot lawote, dok bene ŋat acel acel myero oleg Lubaŋa pi lawote, wek wucaŋ. Lega pa dano ma kite atir tek, tye ki twero madwoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Luker 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.1"
              },
              "items": [
                {
                  "text": "18.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Elia yam obedo dano ma kite cal kwedwa, yam olego Lubaŋa matek ni kot pe ocwer, omiyo kot pe ocwer i lobo pi mwaka adek ki dwe abicel. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.17",
            "verseOrgIds": [
              "JAS.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.42+1KI.18.43+1KI.18.44+1KI.18.45"
              },
              "items": [
                {
                  "text": "1 Luker 18.42-45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ka dok olego aye, omiyo kot ocako cwer, lobo oceko cam mabup.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        }
      ]
    },
