                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waraga man oa ki bot Yakobo ma latic pa Lubaŋa ki Rwotwa Yecu Kricito.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        }
