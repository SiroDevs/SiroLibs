            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraga man oa ki bot Paulo, ma pi mit pa Lubaŋa yam Lubaŋa olwoŋe me bedo lakwena pa Kricito Yecu, ki dok ki bot ominwa Coctene.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        }
      ]
    },
