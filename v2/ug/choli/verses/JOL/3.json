          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerucalem bene bibedo maleŋ, ci lurok doŋ pe gibibaro dyere matwal.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.17",
            "verseOrgIds": [
              "JOL.3.17"
            ]
