              "type": "text"
            }
          ]
        },
        {
          "text": "Wutit lok man i kin rok ducu!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.3.9"
            ]
