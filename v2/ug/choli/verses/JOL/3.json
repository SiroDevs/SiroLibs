        },
        {
          "text": "“Pien nen, i nino meno, ki i kare maca, i kare ma abidwoko gum me Juda ki me Jerucalem, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abicoko rok ducu, abikelogi i nota pa Yekocapat. Ci abinologi kop ki kunnu, pi jona Icrael ma ginaleyana, pien gukeyogi woko i kin lurok, dok gupoko lobona woko, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "gubedo ka bolo kwir pi jo mera, kun gicato awobi pi malaya, dok gicato nyako wek ginoŋ koŋo vino, ci gumato.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        }
      ]
