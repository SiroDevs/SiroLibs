          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edom bi doko tim ata, pi timgi me gero i kom jo Juda, pien guonyo remo pa jo ma pe ki bal i lobogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.19",
