  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Obulamu bwange mbukyayidde ddala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "noolwekyo leka nfukumule okwemulugunya kwange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "njogerere mu kulumwa kw'emmeeme yange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaagamba Katonda nti, Tonsalira musango ne gunsinga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:2"
      },
      "items": [
        {
          "text": "ntegeeza ky'onvunaana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikusanyusa okunnyigiriza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "okunyooma omulimu gw'emikono gyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "n'owagira emirimu gy'abakozi b'ebibi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaaso go ga mubiri?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:4"
      },
      "items": [
        {
          "text": "Olaba ng'omuntu bw'alaba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennaku zo zisinga ez'omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:5"
      },
      "items": [
        {
          "text": "n'emyaka gyo gisinga egy'omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "olyoke onoonye ebisobyo byange",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:6"
      },
      "items": [
        {
          "text": "era obuulirize ekibi kye nkoze,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "newaakubadde ng'omanyi nti sirina musango",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:7"
      },
      "items": [
        {
          "text": "era nga tewali n'omu ayinza kunzigya mu mukono gwo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Emikono gyo gye gyammumba, gye gyankola.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:8"
      },
      "items": [
        {
          "text": "Ate kaakano onookyuka okunsanyaawo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jjukira nti wammumba ng'ebbumba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:9"
      },
      "items": [
        {
          "text": "ate kaakano onoonfuula ng'enfuufu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewanzitulula ng'amata",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:10"
      },
      "items": [
        {
          "text": "n'onkwasa ng'omuzigo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewannyambaza omubiri n'olususu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:11"
      },
      "items": [
        {
          "text": "n'oluka amagumba n'ebinywa n'ongatta?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale wampa okuganja mu maaso go,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:12"
      },
      "items": [
        {
          "text": "era walabirira, n'omwoyo gwange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bino wabikweka mu mutima gwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:13"
      },
      "items": [
        {
          "text": "era mmanyi nga byali mu birowoozo byo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa nyonoona, ondaba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:14"
      },
      "items": [
        {
          "text": "era tewandindese n'otombonereza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe mba nga nsingibbwa omusango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "zinsanze nze!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "Newaakubadde nga sirina musango, sisobola kuyimusa mutwe gwange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "kubanga nzijjudde obuswavu era mu kunyigirizibwa kwange, mwe nsaanikiddwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe mba ng'asituka, n'onjigga ng'empologoma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:16"
      },
      "items": [
        {
          "text": "era n'onnumba n'amaanyi go amangi ennyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleeta abajulizi abajja okunnumiriza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "era obusungu bwo ne bweyongera gye ndi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
