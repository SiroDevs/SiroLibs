    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "kubanga sigaanye bigambo bya Mutukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
