    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yobu Ayanukula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobu n'ayanukula ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.1",
            "verseOrgIds": [
              "JOB.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Singa okweraliikirira kwange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:2"
      },
      "items": [
        {
          "text": "n'okubonaabona kwange bipimibwa ne biteekebwa ku minzaani!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weewaawo byandisinze omusenyu gw'ennyanja okuzitowa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:3"
      },
      "items": [
        {
          "text": "ebigambo byange kyenvudde mbyanguyiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusaale bwa Ayinzabyonna buli mu nze",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "n'omwoyo gwange gunywedde obusagwa bwabwo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "entiisa ya Katonda erwana nange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entulege ekaaba awali omuddo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "oba ente ennume eŋŋooŋŋa awali emmere yaayo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmere etaliimu nsa eriika omutali munnyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:6"
      },
      "items": [
        {
          "text": "oba amazzi g'eggi okubaamu akawoomerera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwange tegusikirizibwa kubikombako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:7"
      },
      "items": [
        {
          "text": "biri ng'emmere etangasa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
