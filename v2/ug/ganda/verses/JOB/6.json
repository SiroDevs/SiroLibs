      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "Era enkomerero yange, eruwa ndyoke ngumiikirize?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
