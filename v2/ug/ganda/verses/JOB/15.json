  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOB 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erifaazi Ayogera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Erifaazi Omutemani n'addamu n'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuntu ow'amagezi yandizzeemu n'amagezi agataliimu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "oba n'ajjuza olubuto lwe embuyaga ez'ebuvanjuba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yandiwakanye n'ebigambo ebitaliiko kye bigasa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:3"
      },
      "items": [
        {
          "text": "oba okwogera ebigambo ebitalina kye bikola?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye onyooma Katonda",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:4"
      },
      "items": [
        {
          "text": "n'oziyiza okwewaayo eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga obutali butuukirivu bwo bwe buyigiriza akamwa ko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:5"
      },
      "items": [
        {
          "text": "era olonzeewo okukozesa olulimi lw'abalimba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwa ko kennyini ke kakusalira omusango si nze,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:6"
      },
      "items": [
        {
          "text": "emimwa gyo gyennyini gye gikulumiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwe wasooka abantu bonna okuzaalibwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:7"
      },
      "items": [
        {
          "text": "Oba ggwe wazaalibwa ensozi nga tezinnabaawo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofaayo okuwuliriza okuteesa kwa Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:8"
      },
      "items": [
        {
          "text": "Olowooza gwe mugezi wekka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiki ky'omanyi kye tutamanyi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:9"
      },
      "items": [
        {
          "text": "Kubikkulirwa ki kw'olina ffe kwe tutalina?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'envi abakaddiye bali ku ludda lwaffe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:10"
      },
      "items": [
        {
          "text": "abasajja abakulu n'okusinga kitaawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda by'akugambye ebikuzzaamu amaanyi bitono nnyo tebikumala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:11"
      },
      "items": [
        {
          "text": "ebigambo ebikubuuliddwa mu bukkakkamu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki omutima gwo gukubuzizza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:12"
      },
      "items": [
        {
          "text": "amaaso go ne gatemereza",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'olyoka ofuka obusungu bwo eri Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:13"
      },
      "items": [
        {
          "text": "n'ofukumula ebigambo bwe bityo okuva mu kamwa ko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuntu ye ani, alyoke abeere omutukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:14"
      },
      "items": [
        {
          "text": "oba oyo azaalibwa omukazi nti ayinza okuba omutuukirivu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda bw'aba tassa bwesige mu batukuvu be,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:15"
      },
      "items": [
        {
          "text": "n'eggulu ne liba nga si ttukuvu mu maaso ge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "oba oleeta otya omuntu obuntu, omugwagwa era omuvundu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:16"
      },
      "items": [
        {
          "text": "anywa obutali butuukirivu nga amazzi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mpuliriza nnaakunnyonnyola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:17"
      },
      "items": [
        {
          "text": "leka nkubuulire kye ndabye:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abasajja ab'amagezi kye bagambye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:18"
      },
      "items": [
        {
          "text": "nga tebalina kye bakwese ku kye baafuna okuva eri bakadde baabwe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo bokka abaweebwa ensi",
          "type": "text",
