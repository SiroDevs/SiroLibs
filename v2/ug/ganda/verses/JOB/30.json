  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JOB 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye kaakano bansekerera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "abantu abansinga obuto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "bakitaabwe be nnandibadde nteeka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "wamu n'embwa ezikuuma endiga zange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaanyi g'emikono gyabwe gaali gangasa ki?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:2"
      },
      "items": [
        {
          "text": "Abantu abaali baweddemu amaanyi ag'obuvubuka bwabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakoozimbye abaali mu bwetaavu era abayala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:3"
      },
      "items": [
        {
          "text": "bameketa ettaka ekkalu mu nsi enjereere mu budde obw'ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banoga ebiragala ebiwoomerera ng'omunnyo mu bisaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:4"
      },
      "items": [
        {
          "text": "enkolokolo ez'omwoloola y'emmere yaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagobebwa bave mu bantu bannaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:5"
      },
      "items": [
        {
          "text": "ne babaleekaanira gy'obeera nti, baali babbi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baawalirizibwa okubeera mu migga egyakalira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:6"
      },
      "items": [
        {
          "text": "mu njazi ne mu binnya wansi mu ttaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakaabira mu bisaka ng'ensolo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:7"
      },
      "items": [
        {
          "text": "ne beekweka mu bikoola by'emiti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezzadde ly'abasirusiru abatalina bwe bayitibwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:8"
      },
      "items": [
        {
          "text": "baagobebwa mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kaakano abaana baabwe bansekerera nga bannyimba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:9"
      },
      "items": [
        {
          "text": "nfuuse ekyenyinyalwa gye bali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abatanjagala abanneesalako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:10"
      },
      "items": [
        {
          "text": "banguwa okunfujjira amalusu mu maaso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano Katonda nga bw'atagguludde akasaale kange, ammazeemu amaanyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:11"
      },
      "items": [
        {
          "text": "beeyisizza nga bwe balaba mu maaso gange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bano bannumba ku mukono gwange ogwa ddyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "bategera ebigere byange emitego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "ne baziba amakubo banzikirize.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banzingiza",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "ne banzikiriza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "nga tewali n'omu abayambye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banzingiza ng'abayita mu kituli ekigazi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:14"
      },
      "items": [
        {
          "text": "bayingira nga bayita mu muwaatwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnumbiddwa ebitiisa eby'amaanyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "ekitiibwa kyange kifuumuuse ng'ekifuuyiddwa empewo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "era n'obukuumi bwange ne bubulawo ng'ekire.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okubonaabona kwa Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Era kaakano obulamu bwange buseebengerera buggwaawo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:16"
      },
      "items": [
        {
          "text": "ennaku ez'okubonaabona zinzijjidde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kifumita amagumba gange",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
