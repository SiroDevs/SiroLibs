            "number": "1",
            "style": "v",
            "sid": "JOB 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yobu n'addamu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.1",
                "verseOrgIds": [
                  "JOB.42.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mmanyi ng'oyinza okukola ebintu byonna,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:2"
      },
      "items": [
        {
          "text": "era tewali kyotegeka kyonna kiyinza kuziyizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuuza nti, 'Ani ono aziyiza okuteesa kwange atalina magezi?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "Mazima ddala nayogera ebintu bye sitegeera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "ebintu ebyassukirira okutegeera kwange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wulira nkwegayiridde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "nange mbeeko kye nkubuuza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "onziremu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatu gange gaali gaakuwulirako dda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:5"
      },
      "items": [
        {
          "text": "naye kaakano amaaso gange gakulabye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyenvudde neenyooma",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:6"
      },
      "items": [
        {
          "text": "era neenenyezza mu nfuufu ne mu vvu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.7",
                "verseOrgIds": [
                  "JOB.42.7"
                ]
              }
            }
          ]
        },
        {
          "text": "amaze okwogera ebigambo bino eri Yobu, n'agamba Erifaazi Omutemani nti, \"Nkunyiigidde ggwe ne mikwano gyo ababiri; kubanga temwanjogerako bituufu, ng'omuddu wange Yobu bw'akoze.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo kaakano mutwale ente ennume musanvu, n'endiga ennume musanvu, mugende eri omuddu wange Yobu, mweweereyo eyo ekiweebwayo ekyokebwa, n'omuddu wange Yobu ajja kubasabira, kubanga nzija kukkiriza okusaba kwe nneme okubakolako ng'obusirusiru bwammwe bwe buli. Kubanga temwanjogerako bituufu ng'omuddu wange bw'akoze.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Erifaazi Omutemani, ne Birudaadi Omusuki, ne Zofali Omunaamasi ne bagenda ne bakola nga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.9",
                "verseOrgIds": [
                  "JOB.42.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yabalagira. Awo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.9",
                "verseOrgIds": [
                  "JOB.42.9"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akkiriza okusaba kwa Yobu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.10",
                "verseOrgIds": [
                  "JOB.42.10"
                ]
              }
            }
          ]
        },
        {
          "text": "n'aggyawo ennaku ya Yobu bwe yamala okusabira mikwano gye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.10",
                "verseOrgIds": [
                  "JOB.42.10"
                ]
              }
            }
          ]
        },
        {
          "text": "n'awa Yobu ebintu emirundi ebiri okusinga bye yalina okusooka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo baganda be bonna ne bannyina bonna ne bajja n'abo abaali bamumanyi okusooka, ne balya naye emmere mu nnyumba ye; ne bamusaasira ne bamukulisa okubonaabona kwonna",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.11",
                "verseOrgIds": [
                  "JOB.42.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwe yakkiriza okumutuukako. Buli omu ku bo n'amuwaayo ffeeza nga bwe yasobola, n'empeta ya zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.12",
                "verseOrgIds": [
                  "JOB.42.12"
                ]
              }
            }
          ]
        },
        {
          "text": "n'awa Yobu omukisa mu nnaku ze ezaasembayo n'okusinga entandikwa ye bwe yali: yafuna endiga omutwalo gumu mu enkumi nnya, n'eŋŋamira kakaaga, ne ziseddume z'ente lukumi, n'endogoyi enkazi lukumi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.42.13",
                "verseOrgIds": [
                  "JOB.42.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuwa n'abaana aboobulenzi musanvu, n'aboobuwala basatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuwala ow'olubereberye n'amutuuma Yemima, n'owokubiri n'amutuuma Keeziya, n'owookusatu n'amutuuma Keremukappuki, n'aboobulezi musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu nsi yonna ne wataba bakazi balungi kwenkana bawala ba Yobu. Kitaabwe n'abawa omugabo ogw'ebintu ogwenkanankana ne gwe yawa bannyinaabwe abalenzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lw'ebyo, Yobu n'awangaala emyaka kikumi mu ana; n'alaba ku baana be ne ku bazzukulu be okutuuka ku bannakasatwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oluvannyuma n'afa ng'akaddiyidde ddala ng'awezezza emyaka mingi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
