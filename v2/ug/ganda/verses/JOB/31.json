            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obanga nnali ndabye omuntu yenna ng'afa olw'okubulwa ebyambalo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
