  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1CH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebika Ebyava mu Buwaŋŋanguse mu Babulooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eggwanga lyonna erya Isirayiri lyabalibwa ng'okuzaalibwa kwabwe bwe kwali era ne bawandiikibwa mu kitabo ky'ebyafaayo bya bassekabaka ba Isirayiri. Olw'okukola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.1",
                "verseOrgIds": [
                  "1CH.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", abantu ba Yuda nabo baatwalibwa mu buwaŋŋanguse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaasooka okubeera ewaabwe mu bibuga byabwe be baali Abayisirayiri abamu, ne bakabona, n'Abaleevi, n'abalala abaaweerezanga mu yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu ku abo abaabeeranga mu Yerusaalemi nga bava mu Yuda, ne Benyamini, ne Efulayimu ne Manase baali:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usayi mutabani wa Ammikudi, muzzukulu wa Omuli, muzzukulu wa Imuli, muzzukulu wa Bani, muzzukulu wa Pereezi, mutabani wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4",
            "verseOrgIds": [
              "1CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Basiiro,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.5",
            "verseOrgIds": [
              "1CH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:5"
      },
      "items": [
        {
          "text": "Asaya omuggulanda mu nnyumba ye, wamu ne batabani be.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.5",
            "verseOrgIds": [
              "1CH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bazzukulu ba Zeera,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:6"
      },
      "items": [
        {
          "text": "Yeweri n'ab'omu kika kye okuva mu Yuda abantu lukaaga mu kyenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bazzukulu ba Benyamini,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:7"
      },
      "items": [
        {
          "text": "Sallu mutabani wa Mesullamu, muzzukulu wa Kodaviya, muzzukulu wa Kassenuwa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7",
            "verseOrgIds": [
              "1CH.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Ibuneya mutabani wa Yerokamu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:8"
      },
      "items": [
        {
          "text": "ne Era mutabani wa Uzzi, muzzukulu wa Mikuli,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:8"
      },
      "items": [
        {
          "text": "ne Mesullamu mutabani wa Sefatiya, muzzukulu wa Leweri, muzzukulu wa Ibuniya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu b'omu kika kya Benyamini, baali bawera lwenda mu ataano mu mukaaga, ate nga bonna bakulu ba nda zaabwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bakabona abaakomawo kwaliko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:10"
      },
      "items": [
        {
          "text": "Yedaya, ne Yekoyalibu, ne Yakini,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10",
            "verseOrgIds": [
              "1CH.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Azaliya mutabani wa Kirukiya, muzzukulu wa Mesullamu, muzzukulu wa Zadooki, muzzukulu wa Merayoosi, muzzukulu wa Akituubu, omukulu eyavunaanyizibwanga ennyumba ya Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.11",
            "verseOrgIds": [
              "1CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Adaaya mutabani wa Yerokamu, muzzukulu wa Pasukuli, muzzukulu wa Malukiya, ne Maasayi mutabani wa Adyeri, muzzukulu wa Yazera, muzzukulu wa Mesullamu, muzzukulu wa Mesiremisi, muzzukulu wa Immeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.12",
            "verseOrgIds": [
              "1CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona abaali abakulu b'enda zaabwe baali lukumi mu lusanvu mu nkaaga. Baali basajja babuvunaanyizibwa mu buweereza bwabwe mu nnyumba ya Katonda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku baleevi kwaliko:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:14"
      },
      "items": [
        {
          "text": "Semaaya mutabani wa Kassubu, muzzukulu wa Azulikamu, muzzukulu wa Kasabiya, omu ku b'enda ya Merali,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14",
            "verseOrgIds": [
              "1CH.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Bakubakkali, ne Keresi, ne Galali ne Mattaniya mutabani wa Mikka, muzzukulu wa Zikuli, muzzukulu wa Asafu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.15",
            "verseOrgIds": [
              "1CH.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Obadiya mutabani wa Semaaya, muzzukulu wa Galali, muzzukulu wa Yedusuni;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:16"
      },
      "items": [
        {
          "text": "ne Berekiya mutabani wa Asa, muzzukulu wa Erukaana, eyabeeranga mu byalo eby'Abanetofa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaggazi ba wankaaki baali,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 9:17"
      },
      "items": [
        {
          "text": "Sallumu, ne Akabu, ne Talumoni, ne Akimaani ne baganda baabwe abalala, era mukulu waabwe ye yali Sallumu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.17",
            "verseOrgIds": [
              "1CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "be baayimiriranga ku ludda olw'ebuvanjuba olwa wankaaki ya Kabaka, era gwe mulimu gwabwe n'okutuusa leero. Abo be baali abaggazi ab'omu kika ky'Abaleevi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.18",
            "verseOrgIds": [
              "1CH.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sallumu yali mutabani wa Koole, muzzukulu wa Ebiyasaafu, muzzukulu wa Koola, ne ab'omu nnyumba ya kitaawe be baavunaanyizibwanga okukuuma enzigi za yeekaalu nga bajjajjaabwe nabo bwe baavunaanyizibwanga omulyango gw'ekifo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.19",
                "verseOrgIds": [
                  "1CH.9.19"
                ]
              }
            }
          ]
        },
        {
          "text": "gy'abeera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finekaasi mutabani wa Eriyazaali ye yakuliranga abaggazi mu biro eby'edda, era",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.20",
                "verseOrgIds": [
                  "1CH.9.20"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abeeranga wamu naye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekkaliya mutabani wa Meseremiya ye yali omuggazi ku mulyango gw'Eweema ey'Okukuŋŋaanirangamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
              "1CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonna awamu, abaalondebwa okuba abaggazi b'emiryango baali bibiri mu kkumi na babiri, era baali baawandiikibwa mu byalo byabwe ng'okuzaalibwa kwabwe bwe kwali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 9:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 9:22"
      },
      "items": [
        {
          "text": "Dawudi ne nnabbi Samwiri be bayawula emirimu gy'abaggazi nga bwe gyali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.22",
            "verseOrgIds": [
              "1CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bo ne bazzukulu baabwe, be baavunaanyizibwanga okukuuma enzigi z'ennyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1CH.9.23",
                "verseOrgIds": [
                  "1CH.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", ennyumba eyayitibwanga Eweema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaggazi baabeeranga ku njuyi ennya, olw'ebuvanjuba, olw'ebugwanjuba, olw'obukiikakkono, n'olwobukiikaddyo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.24",
            "verseOrgIds": [
              "1CH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "era baganda baabwe okuva mu byalo byabwe, bajjanga mu mpalo ne bakumanga okumala ebbanga kya nnaku musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.25",
            "verseOrgIds": [
              "1CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaggazi abana, abaali Abaleevi, be baaweebwa obuvunaanyizibwa okulabiriranga ebisenge eby'omunda n'amawanika ag'omu nnyumba ya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.26",
            "verseOrgIds": [
              "1CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasulanga okuliraana ne nnyumba ya Katonda kubanga be baagikuumanga, era nga buli nkya be bavunaanyizibwa okugiggalawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.27",
            "verseOrgIds": [
              "1CH.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu ku bo baavunaanyizibwanga okukuuma ebintu ebyakozesebwanga mu kuweereza mu yeekaalu, era nga be babala ennyingiza yaabyo ne nfulumya yaabyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.28",
            "verseOrgIds": [
              "1CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalala baavunaanyizibwanga okulabirira ebikozesebwa mu mirimu n'ebintu byonna eby'omu watukuvu, era nga be bavunaanyizibwa okulabirira obutta obulungi, n'omwenge, n'amafuta, n'omugavu, n'ebyakaloosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.29",
            "verseOrgIds": [
              "1CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula abamu ku bakabona baategekanga byakaloosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.30",
            "verseOrgIds": [
              "1CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mattisiya mutabani wa Sallumu Omukoola, ate nga y'omu ku Baleevi, ye yavunaanyizibwanga okufumba emigaati gy'ebiweebwayo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.31",
            "verseOrgIds": [
              "1CH.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "era abamu ku baganda b'Abakokasi baavunaanyizibwanga okussanga emigaati egya buli ssabbiiti ku mmeeza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayimbi, abakulu b'ekika ky'Abaleevi baasulanga mu bisenge eby'omunda wa Yeekaalu, era nga tebakola mulimu mulala gwonna emisana n'ekiro okuggyako ogwo ogwabwe omutongole.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bonna baali bakulu b'enda ez'Abaleevi, nga bwe baawandiikibwa mu kuzaalibwa kwabwe, era baabeeranga mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enda ya Sawulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyeri kitaawe wa Gibyoni era yatulanga mu Gibyoni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:35"
      },
      "items": [
        {
          "text": "n'erinnya lya mukyala we nga ye Maaka,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mutabani waabwe omuggulanda yali Abudoni, Zuuli n'amuddirira, Kiisi n'addako, Baali n'addako, Neeri n'addako, Nadabu n'addako,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Gedoli n'addako, Akiyo n'addako, Zekkaliya n'addako, Mikuloosi n'asembayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.37",
            "verseOrgIds": [
              "1CH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikuloosi yazaala Simyamu, era nabo baabeeranga kumpi ne baganda baabwe mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeri n'azaala Kiisi, Kiisi n'azaala Sawulo. Sawulo n'azaala Yonasaani, ne Malukisuwa, ne Abinadaabu ne Esubaali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.39",
            "verseOrgIds": [
              "1CH.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Yonasaani ye yali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:40"
      },
      "items": [
        {
          "text": "Meribubaali, ne Meribubaali n'azaala Mikka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Mikka baali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:41"
      },
      "items": [
        {
          "text": "Pisoni, ne Mereki, ne Taleya ne Akazi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazi n'azaala Yala, Yala n'azaala Alemesi, ne Azumavesi ne Zimuli, ate Zimuli n'azaala Moza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.42",
            "verseOrgIds": [
              "1CH.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza n'azaala Bineya, Bineya n'azaala Lefaya, Lefaya n'azaala Ereyaasa, Ereyaasa n'azaala Azeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeri yalina batabani be mukaaga, era gano ge gaali amannya gaabwe:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 9:44"
      },
      "items": [
        {
          "text": "Azulikamu, ne Bokeru, ne Isimayiri, ne Seyaliya, ne Obadiya, ne Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
      ]
    }
  ],
