{
  "id": "MAT.20",
  "number": "20",
  "bookId": "MAT",
  "reference": "Matayo 20",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Abalimi mu Nnimiro y'Emizabbibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka obw'omu ggulu bufaanana ng'omuntu ssemaka, eyakeera mu makya n'apangisa abakozi okukola mu nnimiro ye ey'emizabbibu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.1",
                "verseOrgIds": [
                  "MAT.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "N'alagaana n'abapakasi okubasasula omuwendo eddinaali emu emu, ze zaali ensimbi ez'olunaku olumu. N'abasindika mu nnimiro ye ey'emizabbibu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.2",
                "verseOrgIds": [
                  "MAT.20.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwe waayitawo essaawa nga bbiri n'asanga abalala nga bayimiridde mu katale nga tebalina kye bakola,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.3",
                "verseOrgIds": [
                  "MAT.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nabo n'abagamba nti, 'Nammwe mugende mu nnimiro y'emizabbibu, era nnaabasasula empeera ebasaanira.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.4",
                "verseOrgIds": [
                  "MAT.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ne bagenda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku ssaawa omukaaga ne ku mwenda n'asindikayo abalala mu ngeri y'emu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Essaawa nga ziweze nga kkumi n'emu n'asanga abalala nga bayimiridde awo, n'ababuuza nti, 'Lwaki muyimiridde awo olunaku lwonna nga temulina kye mukola?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.6",
                "verseOrgIds": [
                  "MAT.20.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ne bamuddamu nti, 'Kubanga tetufunye atuwa mulimu.' N'abagamba nti, 'Nammwe mugende mukole mu nnimiro yange ey'emizabbibu.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awo obudde nga buwungeera nannyini nnimiro n'alagira nampala ayite abakozi abawe empeera yaabwe ng'asookera ku b'oluvannyuma.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.8",
                "verseOrgIds": [
                  "MAT.20.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abaatandika ku ssaawa ekkumi n'emu ne baweebwa eddinaali emu emu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.9",
                "verseOrgIds": [
                  "MAT.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bali abaasookayo bwe bajja ne basuubira nti bo ze banaasasulwa zijja kusingako obungi. Naye nabo yabasasula omuwendo gwe gumu ogw'olunaku olumu nga bali.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.10",
                "verseOrgIds": [
                  "MAT.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe baagifuna ne beemulugunyiza nannyini nnimiro",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.11",
                "verseOrgIds": [
                  "MAT.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nga bagamba nti, 'Bano abooluvannyuma baakoledde essaawa emu yokka naye lwaki obawadde empeera eyenkana eyaffe, ffe abaakoze okuva mu makya ne mu musana gw'omu tuntu?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.12",
                "verseOrgIds": [
                  "MAT.20.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukama waabwe kwe kuddamu omu ku bo nti, 'Munnange si kubbye; bwe wabadde otandika okukola tetwalagaanye eddinaali emu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.13",
                "verseOrgIds": [
                  "MAT.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Twala eddinaali yo ogende. Naye njagala n'ono asembyeyo okumuwa empeera y'emu nga gye nkuwadde.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.14",
                "verseOrgIds": [
                  "MAT.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Siyinza kukozesa byange nga bwe njagala? Obuggya bukukutte kubanga ndi wa kisa?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.15",
                "verseOrgIds": [
                  "MAT.20.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kale nno bwe kityo bwe kiriba abooluvannyuma ne baba aboolubereberye, n'aboolubereberye ne baba abooluvannyuma.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.16",
                "verseOrgIds": [
                  "MAT.20.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yali ayambuka e Yerusaalemi n'atwala abayigirizwa be ekkumi n'ababiri, mu kyama. Bwe baali mu kkubo, n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Laba twambuka e Yerusaalemi, Omwana w'Omuntu aliweebwayo eri bakabona abakulu n'abannyonnyozi b'amateeka, bamusalire omusango ogw'okufa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.18",
                "verseOrgIds": [
                  "MAT.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era balimuwaayo eri Abamawanga ne bamuduulira ne bamukuba, era balimukomerera ku musaalaba. Naye ku lunaku olwokusatu alizuukizibwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.19",
                "verseOrgIds": [
                  "MAT.20.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusaba kwa Nnyina Yakobo ne Yokaana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo nnyina w'abaana ba Zebbedaayo, n'ajja eri Yesu ne batabani be bombi, n'amusinza ng'ayagala okubaako ky'amusaba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amubuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kiki ky'oyagala?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.21",
                "verseOrgIds": [
                  "MAT.20.21"
                ]
              }
            }
          ]
        },
        {
          "text": "N'addamu nti, \"Nsaba, mu bwakabaka bwo, abaana bange bano bombi batuule naawe omu ku mukono gwo ogwa ddyo n'omulala ku gwa kkono.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tomanyi ky'osaba. Muyinza okunywa ku kikompe nze kye ŋŋenda okunywako?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.22",
                "verseOrgIds": [
                  "MAT.20.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ne baddamu nti, \"Tuyinza.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Weewaawo ekikompe mugenda kukinywako. Naye eky'okutuula ku mukono gwange ogwa ddyo oba ogwa kkono nze sikirinaako buyinza. Ebifo ebyo byategekebwa dda Kitange.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.23",
                "verseOrgIds": [
                  "MAT.20.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayigirizwa bali ekkumi bwe baawulira ebyo abooluganda ababiri bye baasaba, ne babanyiigira nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu kwe kubayita n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mumanyi ng'abakulembeze b'abamawanga babazitoowereza embeera, n'abakulu baabwe babafuza lyanyi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.25",
                "verseOrgIds": [
                  "MAT.20.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye tekisaanye kuba bwe kityo mu mmwe. Buli ayagala okubeera omukulu mu mmwe, abeerenga muweereza wa banne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.26",
                "verseOrgIds": [
                  "MAT.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na buli ayagala okuba omwami mu mmwe aweerezenga banne ng'omuddu waabwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.27",
                "verseOrgIds": [
                  "MAT.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mube nga Omwana w'Omuntu atajja kuweerezebwa wabula okuweereza, n'okuwaayo obulamu bwe ng'omutango okununula abangi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.28",
                "verseOrgIds": [
                  "MAT.20.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Azibula Bamuzibe Babiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'abayigirizwa be bwe baali bava mu kibuga Yeriko, ekibiina kinene ne kimugoberera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazibe b'amaaso babiri abaali batudde ku mabbali g'ekkubo bwe baawulira nga Yesu ayita mu kkubo eryo, ne baleekaanira waggulu nnyo nga bakoowoola nti, \"Ssebo, Omwana wa Dawudi, otusaasire!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibiina ne kibalagira okusirika, naye bo, ne beeyongera bweyongezi okukoowoolera waggulu nga boogera nti, \"Ssebo, Omwana wa Dawudi, tusasire.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yabatuukako n'ayimirira n'ababuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwagala mbakolere ki?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.32",
                "verseOrgIds": [
                  "MAT.20.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamuddamu nti, \"Mukama waffe, twagala otuzibule amaaso.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abasaasira n'akwata ku maaso gaabwe amangwago ne gazibuka, ne bamugoberera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
  ],
