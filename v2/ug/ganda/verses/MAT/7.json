          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndibaddamu nti, 'Sibamanyi, muve mu maaso gange, kubanga ebikolwa byammwe byali bibi.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.23",
                "verseOrgIds": [
                  "MAT.7.23"
