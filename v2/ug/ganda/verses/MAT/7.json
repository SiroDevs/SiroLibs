          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Noolwekyo buli awulira ebigambo byange, n'abikola, alifaananyizibwa ng'omusajja ow'amagezi eyazimba enju ye ku lwazi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.24",
                "verseOrgIds": [
