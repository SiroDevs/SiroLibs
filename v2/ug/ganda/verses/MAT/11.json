        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala Ttuulo ne Sidoni biriyisibwa bulungiko okusinga mmwe ku lunaku olw'okusalirako omusango!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.22",
                "verseOrgIds": [
                  "MAT.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
