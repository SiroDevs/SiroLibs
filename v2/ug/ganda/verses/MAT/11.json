        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mujje gye ndi mmwe mwenna abakooye era abazitoowereddwa, nange nnaabawummuza.",
