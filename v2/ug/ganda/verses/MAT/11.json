              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Musitule ekikoligo kyange, muyigire ku nze, kubanga ndi muwombeefu era omuteefu mu mutima, n'emyoyo gyammwe girifuna ekiwummulo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.29",
                "verseOrgIds": [
                  "MAT.11.29"
                ]
              }
            }
          ]
