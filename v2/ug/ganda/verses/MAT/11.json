      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abakooye n'Abazitoowereddwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
