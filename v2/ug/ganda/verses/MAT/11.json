              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naawe Kaperunawumu, newaakubadde nga wagulumizibwa okutuuka eggulu gye likoma, naye oliserengesebwa wansi emagombe. Kubanga ebyamagero eby'ekitalo ebyakolebwa ewuwo, singa byakolerwa mu Sodomu, kyandibadde kikyaliwo ne leero.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.23",
                "verseOrgIds": [
                  "MAT.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
