          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'asaba bw'ati nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ayi Kitange, Mukama w'eggulu n'ensi, nkwebaza kubanga ebigambo byo bino eby'amazima wabikisa abo abeeyita ab'amagezi ennyo, naye n'obibikkulira abaana abato.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.25",
                "verseOrgIds": [
                  "MAT.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Weewaawo Kitange, bw'otyo bwe wasiima.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.26",
                "verseOrgIds": [
                  "MAT.11.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
