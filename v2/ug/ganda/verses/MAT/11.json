        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kitange yankwasa ebintu byonna era Kitange yekka y'amanyi Omwana, nange Omwana Nze nzekka Nze mmanyi Kitange, n'abo Omwana b'aba ayagadde okulaga Kitaawe nabo bamumanyi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.27",
                "verseOrgIds": [
                  "MAT.11.27"
                ]
              }
            }
          ]
        }
