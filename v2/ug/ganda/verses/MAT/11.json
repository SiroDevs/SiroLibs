        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zikusanze, ggwe Kolaziini! Zikusanze ggwe Besusayida! Kubanga ebyamagero bye nakolera mu mmwe, singa nabikolera mu Ttuulo ne mu Sidoni, bandibadde beenenya dda nga bali mu bibukutu n'evvu ku mitwe gyabwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.21",
                "verseOrgIds": [
                  "MAT.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
