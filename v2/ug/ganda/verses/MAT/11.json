        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala Sodomu kigenda kuyisibwa bulungiko, okusinga ggwe, ku lunaku olw'okusalirako omusango!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.24",
