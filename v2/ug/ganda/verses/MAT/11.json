        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga ekikoligo kyange kyangu, n'omugugu gwange teguzitowa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.30",
