          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akaziya Kabaka wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ab'omu Yerusaalemi ne bafuula Akaziya, mutabani wa Yekolaamu omuggalanda, kabaka, kubanga abasajja abanyazi abajja n'Abawalabu baali bamaze okutta abaana be bonna abakulu. Awo Akaziya mutabani wa Yekolaamu n'atandika okufuga Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaziya yalina emyaka amakumi ana mu ebiri bwe yatandika okufuga, era n'afugira omwaka gumu mu Yerusaalemi. Erinnya lya nnyina yali Asaliya, muzzukulu wa Omuli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Akaziya n'atambulira mu makubo ag'ennyumba ya Akabu, kubanga nnyina yamupikirizanga okukola ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.4",
                "verseOrgIds": [
                  "2CH.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ng'ennyumba ya Akabu bwe yakola, kubanga oluvannyuma olw'okufa kwa kitaawe be baamuwabyanga, okukola ebikyamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era naye yagobereranga ebirowoozo byabwe, era n'agenda ne Yekolaamu, mutabani wa Akabu kabaka wa Isirayiri okutabaala Kazayeeri kabaka w'e Busuuli e Lamosugireyaadi. Abasuuli ne bafumita Yolaamu ebiwundu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "era n'addayo e Yezuleeri okujjanjabibwa ebiwundu bye yali afunidde e Laama, bwe yali ng'alwana ne Kazayeeri kabaka w'e Busuuli. Awo Akaziya mutabani wa Yekolaamu kabaka wa Yuda n'agenda okulaba ku Yolaamu mutabani wa Akabu olw'ebisago ebyali bimutuusibbwako.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kyali kyategekebwa Katonda, nti okugwa kwa Akaziya kulimutuukako ng'akyalidde Yolaamu. Awo Akaziya bwe yatuuka eyo, n'agenda ne Yolaamu okusisinkana Yeeku mutabani wa Nimusu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.7",
                "verseOrgIds": [
                  "2CH.22.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gwe yali afuseeko amafuta okuzikiriza ennyumba ya Akabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yeeku bwe yali ng'asalira ennyumba ya Akabu omusango, n'asanga abakungu ba Yuda, ne batabani ba baganda ba Akaziya, abaaweerezanga Akaziya, n'abatta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oluvannyuma n'anoonya Akaziya, era abasajja be ne bamuwambira e Samaliya gye yali yeekwese, n'aleetebwa ewa Yeeku n'attibwa. Ne bamuziika nga boogera nti, \"Ono ye muzzukulu wa Yekosafaati, eyanoonya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.9",
                "verseOrgIds": [
                  "2CH.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'omutima gwe gwonna.\" Era mu nnyumba ya Akaziya ne wataba n'omu eyayinza okusikira obwakabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asaliya ne Yowaasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Asaliya, nnyina Akaziya bwe yalaba nga mutabani we afudde, n'asitula olutalo era n'azikiriza ennyumba yonna ey'obwakabaka bwa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yekosabeyaasi, muwala wa kabaka Yekolaamu, n'abba Yowaasi mutabani wa Akaziya okuva mu balangira abaali bagenda okuttibwa, n'amukweka ye n'omukozi we mu kimu ku bisenge. Awo Yekosabeyaasi muwala wa kabaka Yekolaamu, ate nga ye yali mukyala wa Yekoyaada kabona, n'akweka omwana, Asaliya aleme okumutta. Yekosabeyaasi, yali mwannyina Akaziya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana n'akwekebwa okumala emyaka mukaaga mu nnyumba ya Katonda, nga Asaliya y'afuga ensi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
    }
  ],
