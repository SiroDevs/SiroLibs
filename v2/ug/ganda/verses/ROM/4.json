  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ROM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibulayimu Yaweebwa Obutuukirivu lwa Kukkiriza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale kiki kye tunaayogera ku jjajjaffe Ibulayimu ku bikwata ku by'omubiri?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa Ibulayimu yaweebwa obutuukirivu lwa bikolwa, yandyenyumirizza, naye si eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyawandiikibwa bitugamba bitya? Ibulayimu yakkiriza Katonda ne kimubalirwa okuba obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'akola omulimu, asasulwa empeera ye. Empeera gy'aweebwa, teba kirabo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda tayinza kukusembeza olw'ebikolwa byo. Katonda asembeza aboonoonyi olw'okukkiriza kwe balina mu ye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Dawudi naye yayogera kye kimu ku muntu ono Katonda gw'awa obutuukirivu obutavudde mu bikolwa bye ng'agamba nti:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baweereddwa omukisa,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 4:7"
      },
      "items": [
        {
          "text": "abasonyiyiddwa ebyonoono byabwe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 4:7"
      },
      "items": [
        {
          "text": "ne baggyibwako ebibi byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aweereddwa omukisa omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 4:8"
      },
      "items": [
        {
          "text": "Mukama gw'atalibalira kibi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale omukisa guno, gw'abakomole bokka oba n'abatali bakomole? Ebyawandiikibwa bitugamba nti okukkiriza kwa Ibulayimu kwamubalirwa okuba obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.9",
            "verseOrgIds": [
              "ROM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale, kwamubalirwa kutya? Ng'akomolebbwa oba nga tannakomolebwa? Nedda si ng'akomolebbwa naye nga tannakomolebwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.10",
            "verseOrgIds": [
              "ROM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabonero ke yafuna ak'okukomolebwa, ye nvumbo ku butuukirivu olw'okukkiriza kwe, nga tannakomolebwa, alyoke abeere jjajja w'abo bonna abakkiriza nga si bakomole, nabo balyoke babalirwe obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.11",
            "verseOrgIds": [
              "ROM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era ye jjajja w'abantu bonna, abakomole, era abatambulira mu kkubo ery'okukkiriza, jjajjaffe Ibulayimu kwe yalina nga tannakomolebwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'ezzadde lye tebaaweebwa kisuubizo eky'okulya ensi yonna, ng'omugabo gwe, lwa kukwata mateeka. Katonda, ensi yagimusuubiza lwa butuukirivu obwamuweebwa olw'okukkiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga baweebwa obusika lw'amateeka, okukkiriza kuba tekugasa, era nga n'ekisuubizo tekirina makulu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda anyiiga Amateeka ge bwe gatagonderwa. Naye bwe wataba mateeka, tewaba mateeka ga kujeemera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo ekisuubizo kijja lwa kukkiriza, kiryoke kiweebwe lwa kisa, eri ezzadde lyonna, so si ezzadde erigondera amateeka lyokka naye n'eri ezzadde erya Ibulayimu olw'okukkiriza; era oyo ye jjajjaffe ffenna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyawandiikibwa nti, \"Nkufudde jjajja w'amawanga amangi.\" Ye jjajjaffe mu maaso g'oyo gwe yakkiriza, Katonda azuukiza abafu, era alaba ebitaliiwo ng'ebiriwo, era atonda ebintu ebiggya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda yasuubiza Ibulayimu abazzukulu bangi. Ne bwe kyalabika ng'ekitasoboka, Ibulayimu yalina okukkiriza mu Katonda, n'oluvannyuma n'abeera jjajja w'amawanga mangi, okusinziira ku ekyo ekyayogerwa nti, \"Ezadde lyo bwe liriba.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teyatendewererwa mu kukkiriza, newaakubadde nga yali wa myaka nga kikumi, nga n'omubiri gwe munafu nnyo, ate nga ne Saala mugumba.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teyabuusabuusa kisuubizo kya Katonda mu butakkiriza, naye yaweebwa amaanyi lwa kukkiriza; n'agulumiza Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakakasiza ddala nti Katonda kye yasuubiza asobola okukituukiriza,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "era bwe kityo ne kimubalirwa okuba obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.22",
            "verseOrgIds": [
              "ROM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tekyawandiikibwa ku lulwe yekka nti, \"Kyamubalirwa okuba obutuukirivu;\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye era naffe, abakkiririza mu oyo eyazuukiza Yesu Mukama waffe mu bafu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
              "ROM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo yaweebwayo okuttibwa olw'ebibi byaffe, n'azuukizibwa tulyoke tuweebwe obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.25",
            "verseOrgIds": [
              "ROM.4.25"
            ]
          }
        }
      ]
    }
  ],
