              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogobereranga bwenkanya bwokka olyoke olye ensi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
