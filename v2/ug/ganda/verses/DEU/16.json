              "type": "text"
            }
          ]
        },
        {
          "text": "Onoolondanga abalamuzi n'abakulembeze mu bantu, mu bika byo byonna, mu bibuga byo byonna,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
