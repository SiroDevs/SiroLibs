                "verseOrgIds": [
                  "DEU.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo by'akuwa, baweerezenga abantu nga babasalirawo ensonga zaabwe nga tebasaliriza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
