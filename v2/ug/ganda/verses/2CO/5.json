  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2CO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga tumanyi ng'ennyumba yaffe ey'ensiisira ey'oku nsi bw'erisaanyizibwawo, tulina ennyumba okuva eri Katonda, ennyumba etaakolebwa na mikono, ey'olubeerera ey'omu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga tusindira mu nnyumba eno, nga twegomba okwambazibwa ennyumba yaffe eriva mu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bwe tulyambazibwa, tetulisangibwa nga tuli bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ffe abali mu nsiisira eno tusinda, nga tuzitoowererwa, nga tetwagala kusangibwa nga tetwambadde, wabula nga twambadde, omubiri ogufa gumiribwe obulamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo eyatuteekerateekera ekintu ekyo kyennyini ye Katonda oyo eyatuwa amazima g'Omwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo tulina obwesige bulijjo nga tumanyi nti bwe tuba mu mubiri guno, tetuba waffe, olwo nga tetuli na Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga tutambula lwa kukkiriza so si lw'amaaso gaffe bye galaba.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo tuli bagumu era tuli basanyufu, wakiri okuva mu mibiri guno ne tubeera ewaffe mu ggulu ne Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo kyetuva tunoonya oba nga tuli ewaffe oba nga tetuli waffe, tumusanyuse.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ffe ffenna kitugwanira okulabika mu maaso g'entebe ya Kristo ey'okusalirako omusango, buli muntu asalirwe olw'ebyo bye yakola ng'akyali mulamu, okusinziira ku ebyo bye yakola oba birungi oba bibi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukwano ne Katonda nga Guyita mu Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bwe tumanya entiisa ya Katonda, kyetuva tukola obutaweera okuleeta abantu eri Kristo, era kye tuli kimanyiddwa eri Katonda, era nsuubira nga bwe kiri ne mu mitima gyammwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tetugezaako kuddamu kubeenyumiririzaako, naye tubawa omukisa okwenyumiriza ku lwaffe, musobole okuba n'eky'okuddamu abo ababeewaanirako kyokka nga mu mitima gyabwe si ba mazima.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe tuwulikika ng'abagudde eddalu olw'ebyo bye tweyogerako, tukikoze ku bwammwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.13",
            "verseOrgIds": [
              "2CO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okwagala kwa Katonda kutuwaliriza, ng'omu bwe yafiirira bonna, bonna kyebaava bafa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.14",
            "verseOrgIds": [
              "2CO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yafiirira abantu bonna; abalamu balemenga okubeera abalamu ku bwabwe bokka, wabula ku bw'oyo eyabafiirira era n'azuukira,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuva kaakano, tuleme okumanya omuntu yenna mu mubiri, bwe tuba nga ddala twamanya Kristo mu mubiri. Naye kaakano tetukyamumanyi bwe tutyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo omuntu yenna bw'abeera mu Kristo, aba kitonde kiggya; eby'edda nga bigenze, laba ng'afuuse muggya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.17",
            "verseOrgIds": [
              "2CO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byonna biva eri Katonda eyatukomyawo gy'ali nga tuyita mu Kristo, era ne tuweebwa obuweereza obw'okutabaganya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.18",
            "verseOrgIds": [
              "2CO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda yali mu Kristo, ng'atabagana n'abantu, nga tababalira, bibi byabwe, n'atuteresa ffe obubaka obw'okutabaganya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo ku bwa Kristo tuli babaka, era Katonda atuma ffe okwogera nammwe. Kyetuva tubeegayirira, ku bwa Kristo, mutabagane ne Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.20",
            "verseOrgIds": [
              "2CO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga oyo ataamanya kibi, yafuuka ekibi ku lwaffe, tulyoke tufune obutuukirivu obuva eri Katonda mu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.21",
            "verseOrgIds": [
              "2CO.5.21"
            ]
          }
        }
      ]
    }
  ],
