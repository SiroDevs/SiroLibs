  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "PRO 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ensibuko y'Obugagga Obungi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana omugezi assaayo omwoyo eri ebiragiro bya kitaawe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:1"
      },
      "items": [
        {
          "text": "naye omunyoomi tafaayo ku kunenyezebwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu asanyuka olw'ebirungi ebiva mu bibala bya kamwa ke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:2"
      },
      "items": [
        {
          "text": "naye atali mwesigwa yeegomba kuleeta ntalo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo eyeegendereza by'ayogera akuuma obulamu bwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:3"
      },
      "items": [
        {
          "text": "naye oyo amala googera, alizikirira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omugayaavu yeegomba kyokka n'atabaako ky'afuna,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:4"
      },
      "items": [
        {
          "text": "naye omunyiikivu byayagala byonna abifuna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omutuukirivu akyawa obulimba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:5"
      },
      "items": [
        {
          "text": "naye omukozi w'ebibi yeereetera kunyoomebwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutuukirivu bukuuma omuntu omwesimbu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:6"
      },
      "items": [
        {
          "text": "naye okukola ebibi kuzikiriza omwonoonyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omu ayinza okwefuula omugagga ate nga taliiko ky'alina,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:7"
      },
      "items": [
        {
          "text": "ate omulala ne yeefuula okuba omwavu so nga mugagga nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obugagga bw'omuntu buyinza okumununula,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:8"
      },
      "items": [
        {
          "text": "naye omwavu talina ky'atya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitangaala ky'abatuukirivu kyaka nnyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:9"
      },
      "items": [
        {
          "text": "naye ettaala y'abakozi b'ebibi ezikira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalala gazaala buzaazi nnyombo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:10"
      },
      "items": [
        {
          "text": "naye amagezi gasangibwa mu abo abakkiriza okulabulwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensimbi enkumpanye ziggwaawo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:11"
      },
      "items": [
        {
          "text": "naye ezijja empolampola zeeyongera obungi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Essuubi erirwawo okutuukirira lirwaza omutima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:12"
      },
      "items": [
        {
          "text": "naye ekyegombebwa bwe kituukirira kiba muti gwa bulamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu anyooma ebiragiro aligwa mu mitawaana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:13"
      },
      "items": [
        {
          "text": "naye oyo awuliriza ebimulagirwa aliweebwa empeera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuyigiriza kw'omuntu alina amagezi nsulo ya bulamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:14"
      },
      "items": [
        {
          "text": "era kuggya omuntu mu mitego gy'okufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okutegeera okulungi kuleeta okuganja,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:15"
      },
      "items": [
        {
          "text": "naye ekkubo ly'abateesigibwa liba zzibu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omwegendereza akola amaze kulowooza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:16"
      },
      "items": [
        {
          "text": "naye omusirusiru alaga obutamanya bwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubaka omubi yeesuula mu mitawaana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.17",
            "verseOrgIds": [
              "PRO.13.17"
