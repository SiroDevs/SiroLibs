          "text": "Omutima gwo gulemenga okukwatirwa aboonoonyi obuggya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        }
      ]
