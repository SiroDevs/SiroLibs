            "sid": "PRO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ye muntu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "abalirira ensimbi z'asaasaanyizza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "n'akugamba nti, \"Weeriire, weenywere,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "naye ng'omutima gwe tegukusanyukira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
