          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatono k'onooba olidde onookasesema,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
