      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'ayokya Ayi era ne kifuuka kifunvu ne leero.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
            "verseOrgIds": [
              "JOS.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate n'atta kabaka wa Ayi n'amuwanika ku muti okutuusa akawungeezi lwe baawanulayo omulambo gwe ne bagusuula awo ku wankaaki w'ekibuga ne bagutuumako entuumu y'amayinja era ekyaliyo ne kaakano.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekyoto Kizimbwa ku Lusozi Ebali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma Yoswa n'azimbira",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.30",
                "verseOrgIds": [
                  "JOS.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri, ekyoto ku lusozi Ebali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Musa omuweereza wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.31",
                "verseOrgIds": [
                  "JOS.8.31"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yakuutira Abayisirayiri era nga bwe kyawandiikibwa mu kitabo ky'amateeka ga Musa, \"Ekyoto eky'amayinja agataabajjibwa muntu ng'akozesa ekyuma.\" Bwe kyaggwa ne batandika okukiweerako",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.31",
                "verseOrgIds": [
                  "JOS.8.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ebiweebwayo ebyokebwa n'ebiweebwayo olw'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'awandiikira eyo ku mayinja mu maaso g'Abayisirayiri bonna, amateeka Musa ge yasooka okuwandiikira abaana ba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayisirayiri bonna n'abakulembeze baabwe, abalamuzi, n'abakungu ne bannaggwanga bonna ab'omu Isirayiri ne bayimirira eruuyi n'eruuyi w'Essanduuko okwolekera bakabona Abaleevi abaasitulanga Essanduuko y'Endagaano ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.33",
                "verseOrgIds": [
                  "JOS.8.33"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ne beegabanyaamu, ekitundu ekimu ne bayimirira mu maaso g'olusozi Gerizimu, ate abalala ne bayimirira mu maaso g'olusozi Ebali, nga Musa omuddu wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.33",
                "verseOrgIds": [
                  "JOS.8.33"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yabalagira mu kusooka nti, \"Kibagwanidde okusabira Abayisirayiri omukisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
