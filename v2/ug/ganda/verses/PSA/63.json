        "number": "63",
        "style": "c",
        "sid": "PSA 63"
      },
      "items": [
        {
          "text": "63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zabbuli ya Dawudi, bwe yali mu ddungu lya Yuda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, oli Katonda wange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "nkunoonya n'omutima gwange gwonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "emmeeme yange ekwetaaga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "omubiri gwange gwonna gukuyaayaanira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "nga nnina ennyonta ng'ali",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:1"
      },
      "items": [
        {
          "text": "mu nsi enkalu omutali mazzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.1",
            "verseOrgIds": [
              "PSA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkulabye ng'oli mu kifo kyo ekitukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:2"
      },
      "items": [
        {
          "text": "ne ndaba amaanyi go n'ekitiibwa kyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.2",
            "verseOrgIds": [
              "PSA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okwagala kwo okutaggwaawo kusinga obulamu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:3"
      },
      "items": [
        {
          "text": "akamwa kange kanaakutenderezanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.3",
            "verseOrgIds": [
              "PSA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntyo nnaakutenderezanga obulamu bwange bwonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:4"
      },
      "items": [
        {
          "text": "nnaayimusanga emikono gyange mu linnya lyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.4",
            "verseOrgIds": [
              "PSA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmeeme yange enekkutanga ebyassava n'obugagga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:5"
      },
      "items": [
        {
          "text": "nnaayimbanga nga nkutendereza n'emimwa egy'essanyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.5",
            "verseOrgIds": [
              "PSA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkujjukira nga ndi ku kitanda kyange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:6"
      },
      "items": [
        {
          "text": "era nkufumiitirizaako mu ssaawa ez'ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.6",
            "verseOrgIds": [
              "PSA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'okuba ng'oli mubeezi wange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:7"
      },
      "items": [
        {
          "text": "nnyimba nga ndi mu kisiikirize ky'ebiwaawaatiro byo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.7",
            "verseOrgIds": [
              "PSA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmeeme yange yeekwata ku ggwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:8"
      },
      "items": [
        {
          "text": "omukono gwo ogwa ddyo gumpanirira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.8",
            "verseOrgIds": [
              "PSA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abo abannoonya okunzita balizikirizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:9"
      },
      "items": [
        {
          "text": "baliserengeta emagombe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.9",
            "verseOrgIds": [
              "PSA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balisaanawo n'ekitala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:10"
      },
      "items": [
        {
          "text": "ne bafuuka emmere y'ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.10",
            "verseOrgIds": [
              "PSA.63.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 63:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ye kabaka anaajagulizanga mu Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "bonna abalayira mu linnya lya Katonda banaatenderezanga Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 63:11"
      },
      "items": [
        {
          "text": "naye akamwa k'abalimba kalisirisibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.63.11",
            "verseOrgIds": [
              "PSA.63.12"
            ]
          }
        }
      ]
    }
