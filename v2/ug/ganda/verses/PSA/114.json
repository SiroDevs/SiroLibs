          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri bwe yava mu Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:1"
      },
      "items": [
        {
          "text": "abaana ba Yakobo abo, ne bava mu bantu abaayogeranga olulimi olutali lwabwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 114:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda n'afuuka omutukuvu wa Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:2"
      },
      "items": [
        {
          "text": "Isirayiri n'afuuka amatwale ge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 114:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennyanja bwe yabalaba n'edduka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:3"
      },
      "items": [
        {
          "text": "Omugga Yoludaani ne gudda emabega.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 114:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensozi ne zibuukabuuka ng'endiga zisseddume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:4"
      },
      "items": [
        {
          "text": "n'obusozi obutono ng'obuliga obuto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 114:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe ennyanja, lwaki wadduka?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:5"
      },
      "items": [
        {
          "text": "Ggwe Yoludaani, lwaki wadda emabega?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 114:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe ensozi, lwaki mwabuukabuuka ng'endiga zisseddume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:6"
      },
      "items": [
        {
          "text": "nammwe obusozi obutono ng'obuliga obuto?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 114:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kankana, ggwe ensi, mu maaso ga Mukama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:7"
      },
      "items": [
        {
          "text": "mu maaso ga Katonda wa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 114:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyafuula olwazi ekidiba eky'amazzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:8"
      },
      "items": [
        {
          "text": "n'olwazi olugumu n'aluggyamu ensulo ez'amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
