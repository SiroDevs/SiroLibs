        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.8.9",
                "verseOrgIds": [
                  "PSA.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mukama waffe, erinnya lyo nga ddungi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:9"
      },
      "items": [
        {
          "text": "era kkulu nnyo mu nsi yonna!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.10"
            ]
          }
        }
