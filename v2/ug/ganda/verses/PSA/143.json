          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.143.9",
                "verseOrgIds": [
                  "PSA.143.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", abalabe bange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:9"
      },
      "items": [
        {
          "text": "kubanga ggwe kiddukiro kyange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
