            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.143.7",
                "verseOrgIds": [
                  "PSA.143.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "kubanga omwoyo gwange guggwaamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Tonkisa maaso go,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "nneme okufaanana ng'abafu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 143:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obudde nga bukedde, nsaba ondage okwagala kwo okutaggwaawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "kubanga ggwe gwe neesiga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Njigiriza ekkubo lye nsaana okutambuliramu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "kubanga omwoyo gwange gwonna guli gy'oli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
