    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olinneerabira kutuusa ddi, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.1",
                "verseOrgIds": [
                  "PSA.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "? Okutuusa emirembe gyonna?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:1"
      },
      "items": [
        {
          "text": "Olikomya ddi okunkweka amaaso go?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okulumwa mu mmeeme yange kulikoma ddi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "n'okunyolwa okwa buli lunaku mu mutima gwange kuliggwaamu ddi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "Abalabe bange balikomya ddi okumpangulanga nga beegulumiza?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onnyanukule, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.3",
                "verseOrgIds": [
                  "PSA.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:3"
      },
      "items": [
        {
          "text": "onzizeemu amaanyi nneme okufa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si kulwa ng'omulabe wange yeewaana nti, \"Mmuwangudde;\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:4"
      },
      "items": [
        {
          "text": "abalabe bange ne bajaguza nga ngudde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze neesiga okwagala kwo okutajjulukuka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:5"
      },
      "items": [
        {
          "text": "era omutima gwange gunaasanyukiranga mu bulokozi bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaayimbiranga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.6",
                "verseOrgIds": [
                  "PSA.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:6"
      },
      "items": [
        {
          "text": "kubanga ankoledde ebirungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    }
