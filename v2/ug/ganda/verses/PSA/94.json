                "verseId": "PSA.94.1",
                "verseOrgIds": [
                  "PSA.94.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ggwe Katonda awalana eggwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
