          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golokoka, Ayi ggwe Omulamuzi w'ensi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
