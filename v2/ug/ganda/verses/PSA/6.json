          "text": "awulidde okwegayirira kwange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:9"
      },
      "items": [
        {
          "text": "n'okusaba kwange akukkirizza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalabe bange bonna baliswazibwa era balitya nnyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    },
