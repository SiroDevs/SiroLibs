        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.9",
                "verseOrgIds": [
                  "PSA.6.10"
                ]
              }
            }
          ]
        },
