          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkubo lyo limanyibwe mu nsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:2"
      },
      "items": [
        {
          "text": "n'obulokozi bwo mu mawanga gonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
