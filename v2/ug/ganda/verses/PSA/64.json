  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "PSA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, owulire eddoboozi lyange, ery'okwemulugunya kwange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:1"
      },
      "items": [
        {
          "text": "okuume obulamu bwange eri okutiisibwatiisibwa omulabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onkweke mpone enkwe z'abakola ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:2"
      },
      "items": [
        {
          "text": "onzigye mu kibinja ky'aboonoonyi, abaleekaana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abawagala ennimi zaabwe ng'ebitala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:3"
      },
      "items": [
        {
          "text": "ne balasa ebigambo byabwe ng'obusaale obutta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beekweka ne bateega oyo atalina musango bamulase;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:4"
      },
      "items": [
        {
          "text": "amangwago ne bamulasa nga tebatya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawagiragana mu kigendererwa kyabwe ekibi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "ne bateesa okutega emitego mu kyama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "ne boogera nti, \"Ani asobola okutulaba?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beekobaana okukola ebitali bya bwenkanya, ne boogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "\"Tukoze enteekateeka empitirivu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "Ddala ddala ebirowoozo by'omuntu n'omutima gwe byekusifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Katonda alibalasa n'obusaale bwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:7"
      },
      "items": [
        {
          "text": "alibafumita, mangwago ne bagwa ku ttaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bye boogera biribaddira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "ne bibazikiriza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "ababalaba ne babanyeenyeza emitwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo abantu bonna ne batya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "ne bategeeza abalala omulimu gwa Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "ne bafumiitiriza ku ebyo by'akoze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutuukirivu ajagulizenga mu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.64.10",
                "verseOrgIds": [
                  "PSA.64.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "era yeekwekenga mu ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "Abo bonna abalina omutima omulongoofu bamutenderezenga!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    }
  ],
