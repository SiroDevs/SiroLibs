        {
          "text": "Kubanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.1.6",
                "verseOrgIds": [
                  "PSA.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "alabirira ekkubo ly'abatuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:6"
      },
      "items": [
        {
          "text": "naye ekkubo ly'abakola ebibi liribula.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
