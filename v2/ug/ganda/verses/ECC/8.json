  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ECC 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuwulize eri Abakulembeze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani afaanana omuntu omugezi",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "amanyi okunnyonnyola buli kintu?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Amagezi gaakaayakanyisa obwenyi bw'omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "ne gakyusa emitaafu gyamu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkugamba nti gondera ekiragiro kya kabaka, kubanga walayira",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "text": "mu maaso ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyanguyiriza kuva mu maaso ga kabaka. Kyokka ensonga bw'ebanga etali ntuufu, tobanga ku ludda lumuwakanya, kubanga ye akola buli ky'ayagala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.3",
            "verseOrgIds": [
              "ECC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ekigambo kya kabaka kisukkuluma byonna; kale ani ayinza okumubuuza nti, \"Okola ki ekyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.4",
            "verseOrgIds": [
              "ECC.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo agondera ekiragiro kye talituukibwako kabi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:5"
      },
      "items": [
        {
          "text": "omutima ogw'amagezi gulimanya ekiseera ekisaana okukoleramu ekintu gundi, n'engeri ey'okukolamu ekintu ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga waliwo ekiseera ekituufu n'enkola esaana ku buli kintu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:6"
      },
      "items": [
        {
          "text": "newaakubadde ng'obuyinike bw'omuntu bumuzitoowerera okukamala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bwe watali muntu amanyi binaabaawo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:7"
      },
      "items": [
        {
          "text": "kale ani ayinza okumutegeeza ebinajja?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewali muntu alina buyinza kufuga mpewo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "bwe kityo tewali n'omu alina buyinza ku lunaku lwa kufa kwe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "Ng'omuntu bw'aweebwa ebiragiro mu biseera eby'olutalo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "bwe kityo n'obutali butuukirivu bwe buduumira abo ababutambuliramu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byonna bye nalaba bwe nagezaako okwekenneenya buli kintu ekikolebwa wansi w'enjuba. Waliwo ekiseera omufuzi buli lw'abinika baafuga, kyokka nga yeerumya yekka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabye abantu abakozi b'ebibi nga baziikibwa, abo abaawaanibwanga mu kibuga nga bazze mu kifo ekitukuvu. Na kino nakyo butaliimu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.10",
            "verseOrgIds": [
              "ECC.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'asalirwa omusango n'atabonererezebwawo, emitima gy'ababi gijjula kuteekateeka kukola bubi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.11",
            "verseOrgIds": [
              "ECC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde ng'omuntu omubi azza emisango kikumi, ate n'awangaala, nkimanyi ng'abatuukirivu, abo abatya Katonda bijja kubagendera bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olwokubanga abakozi b'ebibi tebatya Katonda, tebiyinza kubagendera bulungi, era n'ennaku zaabwe zinaayitanga mangu ng'ekisiikirize.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo ekintu ekirala ekiraga obutaliimu ekiri ku nsi: abantu abatuukirivu batukibwako ebyo ebisaanira ababi, ate abatali batuukirivu ne batuukibwako ebyo ebigwanira abatuukirivu. Kino nakyo nkiyita butaliimu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.14",
            "verseOrgIds": [
              "ECC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntyo nteesa nti omuntu yeyagalire mu bulamu: kubanga wansi w'enjuba tewali kisinga, wabula omuntu okulya n'okunywa n'okweyagala. Kale essanyu linaamuwerekeranga mu mirimu gye, ennaku zonna ez'obulamu bwe Katonda bw'amuwadde wansi w'enjuba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nanoonyereza amagezi ne neetegereza okutegana kw'omuntu ku nsi kuno, nga teyeebaka emisana n'ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.16",
            "verseOrgIds": [
              "ECC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndaba ebyo byonna Katonda by'akoze, nga tewali n'omu ayinza kutegeera Katonda by'akola wansi w'enjuba, omuntu ne bw'agezaako ennyo okukinoonyereza tayinza kukivumbula. Newaakubadde omuntu omugezi yeefuula nti akimanyi, tayinza kukitegeera.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.17",
            "verseOrgIds": [
              "ECC.8.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ECC.9",
    "number": "9",
    "bookId": "ECC"
  },
