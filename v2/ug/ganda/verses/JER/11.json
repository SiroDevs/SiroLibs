                "verseId": "JER.11.21",
                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", tuleme okukutta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
