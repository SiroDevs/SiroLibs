              "attrs": {
                "verseId": "JER.11.21",
                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ku basajja b'e Anasosi abanoonya obulamu bwo nga bagamba nti, \"Totubuulira bunnabbi mu linnya lya",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
