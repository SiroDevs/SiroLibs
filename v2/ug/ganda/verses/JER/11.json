          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
