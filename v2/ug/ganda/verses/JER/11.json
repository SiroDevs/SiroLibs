                "verseOrgIds": [
                  "JER.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye nti, \"Laba, nzija kutta abavubuka n'ekitala; ne batabani baabwe n'abawala bafe enjala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
