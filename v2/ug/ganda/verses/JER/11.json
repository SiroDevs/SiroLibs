              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bw'atyo bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
