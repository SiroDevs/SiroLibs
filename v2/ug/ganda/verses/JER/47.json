              "attrs": {
                "verseId": "JER.47.6",
                "verseOrgIds": [
                  "JER.47.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, okaaba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
