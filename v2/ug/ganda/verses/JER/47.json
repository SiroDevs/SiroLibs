      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "abaasigalawo ku mbalama z'ekizinga Kafutoli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
