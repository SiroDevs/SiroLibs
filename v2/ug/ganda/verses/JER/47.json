            "number": "1",
            "style": "v",
            "sid": "JER 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kye kigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
            "verseOrgIds": [
              "JER.47.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.47.1",
                "verseOrgIds": [
                  "JER.47.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ekyajjira nnabbi Yeremiya ekikwata ku Bafirisuuti nga Falaawo tannalumba Gaza nga kigamba nti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
            "verseOrgIds": [
              "JER.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.47.2",
                "verseOrgIds": [
                  "JER.47.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "\"Laba amazzi agatumbira mu bukiikakkono,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "galifuuka omugga ogwanjaala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "Galyanjaala ku nsi",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "ne mu bibuga byonna ebigirimu n'ababituulamu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "Abantu balikaaba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "bonna abali mu nsi baliwowoggana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'emisinde gy'embalaasi ezidduka",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "n'okufuumuuka kw'amagaali g'omulabe",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "era n'okuwuuma kwa nnamuziga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "bakitaabwe tebajja kukyuka kuyamba baana baabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "emikono gyabwe gya kulebera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga olunaku lutuuse",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "okuzikiriza Abafirisuuti bonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "n'okusalako bonna abandisigaddewo",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
