      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda Wakuzikirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.1",
                "verseOrgIds": [
                  "JER.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'alyoka aŋŋamba nti, \"Musa ne Samwiri ne bwe bandiyimiridde okunneegayirira, sandisonyiye bantu bano. Bagobe okuva mu maaso gange, banviire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe bakubuuza nti, 'Tunaagenda wa?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "\"Bagambe nti, 'Kino",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.2",
                "verseOrgIds": [
                  "JER.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kyagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "Ab'okuttibwa bagenda kuttibwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "n'ab'ekitala bafe ekitala, n'ab'enjala bafe enjala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "n'ab'okuwambibwa bawambibwe.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiweereza engeri nnya ez'okubazikiriza,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.3",
                "verseOrgIds": [
                  "JER.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Ekitala kya kufumita, embwa zikulule, ebinyonyi eby'omu bbanga n'ensolo ez'omu nsiko zirye n'okuzikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndibawaayo babeetamwe eruuyi n'eruuyi mu bwakabaka bwonna obw'omu nsi olw'ekyo Manase mutabani wa Keezeekiya kabaka wa Yuda kye yakola mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani alikukwatirwa ekisa ggwe Yerusaalemi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Oba ani alikukungubagira?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Oba ani alikyama okubuuza ebikufaako?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanneegaana,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.6",
                "verseOrgIds": [
                  "JER.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "\"Temutya kudda nnyuma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "Noolwekyo mbagololeddeko omukono gwange",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "ne mbazikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "Sikyasobola",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "kukukwatirwa kisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndibakuŋŋunta n'ekitiiyo eky'amannyo",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "mu miryango gy'ebibuga eby'omu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "Ndizikiriza abantu bange ne mbamalawo",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "kubanga tebaaleka makubo gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bannamwandu beeyongedde obungi",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "okusinga n'omusenyu gw'ennyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "Mu ttuntu mbaleetedde omuzikiriza",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "amalewo ababazaalira abalenzi abato.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "Mbakubiddewo",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "obubalagaze n'entiisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyazaala omusanvu ayongobedde,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "awejjawejja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Enjuba ye egudde nga bukyali misana,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "amaanyi gamuwedde, ensonyi zimukutte, awuunze, awuubadde.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "N'abo abawonyeewo ndi wa kubasogga ekitala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "mu maaso ga balabe baabwe,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "bwayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.9",
                "verseOrgIds": [
                  "JER.15.9"
                ]
              }
            }
