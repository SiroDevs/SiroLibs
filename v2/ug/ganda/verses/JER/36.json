  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JER 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yekoyakimu Ayokya Ekiwandiiko kya Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogwokuna ogw'obufuzi bwa Yekoyakimu mutabani wa Yosiya kabaka wa Yuda ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.1",
                "verseOrgIds": [
                  "JER.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Yeremiya nga kigamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Twala omuzingo gw'empapula oguwandiikeko ebigambo byonna bye njogedde naawe ebikwata ku Isirayiri, ne Yuda n'amawanga gonna okuva mu biseera bye natandika okwogera naawe okuva mu bufuzi bwa Yosiya okutuusa kaakano.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboolyawo abantu ba Yuda bwe banaawulira ku bikangabwa bye ntegeka okubateekako, buli omu ku bo anaakyuka okuleka amakubo ge amabi, ndyoke mbasonyiwe ebibi byabwe n'obutali butuukirivu bwabwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yeremiya n'ayita Baluki mutabani wa Neriya, era nga Yeremiya ayogera ebigambo byonna",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.4",
                "verseOrgIds": [
                  "JER.36.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yali ayogedde naye, Baluki n'abiwandiika ku muzingo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yeremiya n'agamba Baluki nti, \"Nagaanibwa okugenda mu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.5",
                "verseOrgIds": [
                  "JER.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale laga mu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.6",
                "verseOrgIds": [
                  "JER.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ku lunaku olw'okusiiba osomere abantu ebigambo bya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.6",
                "verseOrgIds": [
                  "JER.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ebiri ku muzingo by'owandiise nga njogera. Bisomere abantu ba Yuda bonna abava mu bibuga byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboolyawo banaaleeta okwegayirira kwabwe eri",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.7",
                "verseOrgIds": [
                  "JER.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", era buli omu anaava mu makubo ge amabi, kubanga obusungu n'ekiruyi",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.7",
                "verseOrgIds": [
                  "JER.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": "by'agambye okutuusa ku bantu bano binene nnyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baluki mutabani wa Neriya n'akola byonna nnabbi Yeremiya bye yamugamba okukola; n'asomera, ebigambo bya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.8",
                "verseOrgIds": [
                  "JER.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": "okuva mu muzingo, mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.8",
                "verseOrgIds": [
                  "JER.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwezi ogwomwenda ogw'omwaka ogwokutaano ogw'obufuzi bwa Yekoyakimu mutabani wa Yosiya kabaka wa Yuda, ekiseera eky'okusiibira mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.9",
                "verseOrgIds": [
                  "JER.36.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kyalangirirwa eri abantu bonna mu Yerusaalemi era n'abo abaali bavudde mu bibuga bya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ng'abantu bonna bawulira, Baluki n'asoma ebigambo bya Yeremiya okuva mu muzingo, mu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.10",
                "verseOrgIds": [
                  "JER.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'ali mu kisenge kya Gemaliya mutabani wa Safani omuwandiisi, ekyali mu luggya olw'ekyengulu, mu mulyango omuggya ogw'ennyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.10",
                "verseOrgIds": [
                  "JER.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'abantu bonna bawulira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaaya mutabani wa Gemaliya mutabani wa Safani bwe yawulira ebigambo bya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.11",
                "verseOrgIds": [
                  "JER.36.11"
                ]
              }
            }
          ]
        },
        {
          "text": "byonna ebyali mu muzingo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'agenda eri ennyumba y'omuwandiisi mu lubiri lwa kabaka, abakungu bonna gye baali batudde: Erisaama omuwandiisi, ne Deraya mutabani wa Semaaya, ne Erunasani mutabani wa Akubooli, ne Gemaliya mutabani wa Safani, ne Zeddekiya mutabani wa Kananiya, n'abakungu bonna abalala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaaya ng'ababuulidde byonna bye yali awulidde Baluki asomera abantu okuva ku muzingo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakungu bonna ne batuma Yekudi mutabani wa Nesaniya, mutabani wa Seremiya mutabani wa Kuusi eri Baluki amugambe nti, \"Leeta omuzingo gw'osomedde abantu, naawe ojje.\" Awo Baluki mutabani wa Neriya n'atwalira omuzingo mu mikono gye n'agubaleetera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamugamba nti, \"Tuula wansi, ogutusomere.\" Awo Baluki n'agubasomera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baawulira ebigambo ebyo byonna, buli omu n'atunula ku munne ng'atidde ne bagamba Baluki nti, \"Tuteekwa okubuulira kabaka ebigambo bino byonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne babuuza Baluki nti, \"Tubuulire, wazze otya okuwandiika bino byonna? Yeremiya ye yabikugambye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baluki n'abaddamu nti, \"Weewaawo ye yayogedde ebigambo bino byonna, nze ne mbiwandiika ne bwino ku muzingo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abakungu bonna ne bagamba Baluki nti, \"Ggwe ne Yeremiya mugende mwekweke. Temukkiriza muntu yenna kumanya gye muli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baamala okutereka omuzingo mu kisenge kya Erisaama omuwandiisi, ne bagenda eri kabaka mu luggya ne bamutegeeza byonna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'atuma Yekudi okuleeta omuzingo, Yekudi n'aguleeta okuva mu kisenge kya Erisaama omuwandiisi agusomere kabaka n'abakungu bonna abaali bamuyimiridde ku lusegere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.21",
            "verseOrgIds": [
              "JER.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwali mwezi gwa mwenda ne kabaka yali atudde mu nnyumba etuulwamu mu budde obw'obutiti, ng'omuliro gwakira mu kibya kyagwo mu maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.22",
            "verseOrgIds": [
              "JER.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli Yekudi lwe yasomangako empapula ssatu oba nnya ez'omuzingo, kabaka ng'azisala n'akambe k'omuwandiisi n'azisuula mu muliro okutuusa omuzingo gwonna lwe gwajjiira mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.23",
            "verseOrgIds": [
              "JER.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'abantu bonna abaawulira ebigambo bino tebaatya, wadde okuyuza engoye zaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.24",
            "verseOrgIds": [
              "JER.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga Erunasani, ne Deraaya ne Gemaliya beegayirira kabaka obutayokya muzingo, teyabawuliriza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.25",
            "verseOrgIds": [
              "JER.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kabaka yalagira Yerameeri mutabani wa kabaka ne Seraya mutabani wa Azulyeri ne Seremiya mutabani wa Abudeeri okukwata Baluki omuwandiisi ne nnabbi Yeremiya, wabula",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.26",
                "verseOrgIds": [
                  "JER.36.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'abakwese.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka ng'amaze okwokya omuzingo ogwalimu ebigambo Baluki bye yali awandiise nga Yeremiya abyogera, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.27",
                "verseOrgIds": [
                  "JER.36.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Yeremiya nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Twala omuzingo omulala oguwandiikeko ebigambo byonna ebyali ku muzingo ogwasooka, Yekoyakimu kabaka wa Yuda gwe yayokya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamba ne Yekoyakimu kabaka wa Yuda nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.29",
                "verseOrgIds": [
                  "JER.36.29"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, Wayokya omuzingo ogwo n'ogamba nti, \"Lwaki wakiwandiikamu nti kabaka w'e Babulooni alijja azikiririze ddala ensi eno agimalemu abantu n'ensolo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.30",
                "verseOrgIds": [
                  "JER.36.30"
                ]
              }
            }
          ]
        },
        {
          "text": "eri Yekoyakimu kabaka wa Yuda nti, Tajja kubeera na muntu n'omu kutuula ku ntebe ya Dawudi, n'omulambo gwe gulisuulibwa ebweru gwanikibwe mu musana emisana ne mu butiti ekiro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimubonereza n'abaana be, ne bakalabaalaba be olw'okwonoona kwabwe. Ndimuleetako ne bonna ababeera mu Yerusaalemi ne bonna ababeera mu Yuda buli kibonoobono kye naboogerako, kubanga tebawulirizza.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo Yeremiya n'atwala omuzingo omulala n'aguwa omuwandiisi Baluki mutabani wa Neriya; nga Yeremiya ayogera, Baluki yawandiikamu ebigambo byonna ebyali mu muzingo guli Yekoyakimu kabaka wa Yuda gwe yayokya mu muliro. N'ebigambo bingi ebifaanana bwe bityo byayongerwamu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
  ],
