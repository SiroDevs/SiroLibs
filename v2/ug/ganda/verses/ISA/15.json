      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "omuddo guwotose,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:6"
