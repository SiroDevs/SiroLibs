      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "abantu be babundabunda, baddukira e Zowaali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
