          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muweereze abaana b'endiga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "eri oyo afuga ensi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "okuva e Seera, ng'oyita mu ddungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "okutuuka ku lusozi lwa Muwala wa Sayuuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ennyonyi ezabulwako ekisu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "n'ezisaasaana nga zidda eno n'eri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "bwe batyo bwe baliba abawala ba Mowaabu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "awasomokerwa Alunooni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tuwe ku magezi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "tubuulire, tukole tutya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Mutusiikirize mubeere ng'ekittuluze",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "wakati mu ttuntu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Abajja bagobebwa mubakweke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "abajja badaaga temubalyamu lukwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleke aba Mowaabu abajja bagobebwa babeere nammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Mubataakirize oyo ayagala okubamalawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 16:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Omujoozi bw'aweddewo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "n'okubetentebwa ne kuggwaawo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "omulumbaganyi aliggwaawo mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entebe ey'obwakabaka eryoke etekebwewo mu kwagala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "era ku yo kutuuleko omufuzi ow'omu nnyumba ya Dawudi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "alamula mu bwesigwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "era anoonya obwenkanya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "era ayanguwa okukola eby'obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuwulidde amalala ga Mowaabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "nga bw'ajjudde okwemanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "n'amalala ge n'okuvuma;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "naye okwemanya kwe tekugasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo leka Mowaabu akaabe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "leka buli muntu akaabire ku Mowaabu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "Mukungubage,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "musaalirwe obugaati bw'emizabbibu egy'e Kirukalesesi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennimiro ez'e Kesuboni zikaze,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "n'emizabbibu gy'e Sibuma giweddewo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Abafuzi b'amawanga batemeddewo ddala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "emiti gyabwe egyasinganga obulungi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "egyabunanga ne gituuka e Yazeri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "nga giggukira mu ddungu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "n'emitunsi nga gibuna",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "nga gituukira ddala mu nnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo kyenva nkaaba amaziga nga Yazeri bw'akaaba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "olw'omuzabbibu ogw'e Sibuma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Nakufukirira nkutobye n'amaziga gange,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "ggwe Kesuboni ne Ereyale:",
          "type": "text",
