    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "\"Mukolenga obwenkanya era ebituufu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "kubanga obulokozi bwange bunaatera okujja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "n'obutuukirivu bwange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
