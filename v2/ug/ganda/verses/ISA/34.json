                "verseId": "ISA.34.2",
                "verseOrgIds": [
                  "ISA.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "anyiigidde amawanga gonna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "ekiruyi kye kiri ku magye gaabwe gonna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "Alibazikiririza ddala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "alibawaayo okuttibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baabwe abattibwa balisuulibwa ebweru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "n'emirambo gyabwe giriwunya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "n'ensozi zirinnyikira omusaayi gwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmunyeenye zonna ez'omu ggulu zirisaanuuka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "n'eggulu liryezingako ng'omuzingo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "n'eggye ery'omu ggulu lirigwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "ng'ebikoola ebiwotose ebiva ku muzabbibu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "ng'ebirimba ebyayongobera ebiva ku mutiini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
