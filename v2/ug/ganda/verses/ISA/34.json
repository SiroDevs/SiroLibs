            "number": "1",
            "style": "v",
            "sid": "ISA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musembere mmwe amawanga muwulirize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "Musseeyo omwoyo mmwe abantu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "Ensi ewulirize, ne byonna ebigirimu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "ensi ne byonna ebigivaamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
