      "attrs": {
        "style": "q2",
        "vid": "ISA 34:8"
      },
      "items": [
        {
          "text": "omwaka ogw'okwesasuza, olw'ensonga eya Sayuuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
