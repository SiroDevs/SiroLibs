            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.34.6",
                "verseOrgIds": [
                  "ISA.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kisaabye omusaayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
