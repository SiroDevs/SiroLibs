          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emigga gya Edomu girikalira ne gifuuka bulimbo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "n'enfuufu ye erifuuka ng'obuwunga bwa salufa ayokya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "Ensi ye erifuuka ng'obulimbo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        },
        {
          "text": "obuggya omuliro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
