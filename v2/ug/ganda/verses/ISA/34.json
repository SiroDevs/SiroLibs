          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embogo zirifiira wamu nazo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "n'obute obulume, ne ziseddume zirifiira wamu nazo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "Ensi yaabwe erijjula omusaayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "n'enfuufu erinnyikira amasavu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
