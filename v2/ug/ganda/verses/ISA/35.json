      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "Balifuna essanyu lingi nnyo n'okujaguza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "okunakuwala n'okusinda nga biggweereddewo ddala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
