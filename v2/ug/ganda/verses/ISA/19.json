          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku luli Abamisiri balibeera ng'abakazi. Balikankana n'entiisa olw'omukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.16",
                "verseOrgIds": [
                  "ISA.19.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye ogugoloddwa gye bali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ensi ya Yuda erifuuka ntiisa eri Misiri, buli muntu anagibuulirwangako anatyanga, olw'okuteesa kwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.17",
                "verseOrgIds": [
                  "ISA.19.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye kw'ateesa ku yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo walibaawo ebibuga bitaano mu nsi y'e Misiri ebyogera olulimi lwa Kanani, era birirayira okwekwata ku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.18",
                "verseOrgIds": [
                  "ISA.19.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye. Ekimu kiriyitibwa Ekibuga Ekyokuzikirira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku olwo waliteekebwawo ekyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.19",
                "verseOrgIds": [
                  "ISA.19.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wakati mu nsi y'e Misiri, era n'ekijjukizo kya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.19",
                "verseOrgIds": [
                  "ISA.19.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kiteekebwe ku nsalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaliba kabonero era bujulizi eri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.20",
                "verseOrgIds": [
                  "ISA.19.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye mu nsi y'e Misiri. Kubanga balikoowoola",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.20",
                "verseOrgIds": [
                  "ISA.19.20"
                ]
              }
            }
          ]
        },
        {
          "text": "nga balumbiddwa, naye alibaweereza omulokozi, era abalwanirira, era alibalokola.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.21",
                "verseOrgIds": [
                  "ISA.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "alimanyibwa mu Misiri, n'Abamisiri balimanya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.21",
                "verseOrgIds": [
                  "ISA.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "era bamusinze ne ssaddaaka, n'ebirabo era balyeyama obweyamo eri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.21",
                "verseOrgIds": [
                  "ISA.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ne babutuukiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.22",
                "verseOrgIds": [
                  "ISA.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": "alibonereza Misiri, ng'akuba, ate ng'awonya. Nabo balidda gy'ali, balimwegayirira era alibawonya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku olwo walibaawo oluguudo olugazi oluva mu Misiri olugenda mu Bwasuli, n'Omwasuli alijja mu Misiri, n'Omumisiri n'agenda mu Bwasuli; n'Abamisiri balisinziza wamu n'Abaasuli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku olwo Isirayiri eriba yakusatu wamu ne Misiri n'Obwasuli, baliweesa ensi omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.25",
                "verseOrgIds": [
                  "ISA.19.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye abawadde omukisa, ng'ayogera nti, \"Baweebwe omukisa Misiri abantu bange, n'Obwasuli omulimu gw'emikono gyange, ne Isirayiri obusika bwange.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
