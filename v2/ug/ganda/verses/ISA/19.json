          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obunnabbi Obukwata ku Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunnabbi obukwata ku Misiri:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "Laba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.1",
                "verseOrgIds": [
                  "ISA.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "yeebagadde ku kire ekidduka ennyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "ajja mu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "Ne bakatonda b'e Misiri balijugumira mu maaso ge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "n'emitima gy'Abamisiri girisaanuukira munda mu bo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndiyimusa Abamisiri okulwana n'Abamisiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "balwane buli muntu ne muganda we,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "na buli muntu ne muliraanwa we;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "ekibuga n'ekibuga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "obwakabaka n'obwakabaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamisiri baliggwaamu omwoyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "era entegeka zaabwe zonna ndizitta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "era baliragulwa ebifaananyi ebibajje, n'abasamize,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "n'abaliko emizimu n'abalogo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndigabula Abamisiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "mu mukono gw'omufuzi omukambwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "era kabaka ow'entiisa alibafuga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "bw'ayogera Mukama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.4",
                "verseOrgIds": [
                  "ISA.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugga gulikalira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:5"
      },
      "items": [
        {
          "text": "n'entobo y'omugga ekale ejjemu enjatika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'emikutu giriwunya ekivundu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:6"
      },
      "items": [
        {
          "text": "n'emyala egiyiwa mu mugga omunene nagyo gikale;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:6"
      },
      "items": [
        {
          "text": "ebitoogo n'essaalu nabyo biwotoke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebimera ebiri ku Kiyira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "ku lubalama lwa Kiyira kwennyini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "ne byonna ebyasimbibwa ku Kiyira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "birikala, birifuumuulibwa ne biggweerawo ddala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'abavubi balisinda ne bakungubaga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "n'abo bonna abasuula amalobo mu Kiyira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "balijjula ennaku, abatega obutimba baliggweeramu ddala amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nate n'abo abakozesa obugoogwa obusunsule balinafuwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:9"
      },
      "items": [
        {
          "text": "n'abo abaluka engoye enjeru mu linena nabo bakeŋŋentererwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakozi balikwatibwa ennaku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:10"
      },
      "items": [
        {
          "text": "bonna abakolera empeera ne baggwaamu omwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulu ab'e Zowani basiruwalidde ddala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "n'abagezigezi ba Falaawo bye boogera tebiriimu nsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "Mugamba mutya Falaawo nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "\"Ndi mwana w'abagezi, omwana wa bassekabaka ab'edda\"?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno abasajja bo ab'amagezi bali ludda wa?",
