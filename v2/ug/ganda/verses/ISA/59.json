  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "ISA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekibi, Okwatula Ebibi, n'Okusonyiyibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulabe, omukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.59.1",
                "verseOrgIds": [
                  "ISA.59.1"
                ]
              }
            }
          ]
        },
        {
          "text": "teguyimpawadde n'okuyinza ne gutayinza kulokola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:1"
      },
      "items": [
        {
          "text": "era si muzibe wa matu nti tawulira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye obutali butuukirivu bwammwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "bwe bubaawudde ku Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "Ebibi byammwe bye bimukwesezza amaaso ge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "n'atawulira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga emikono gyammwe gibunye omusaayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "n'engalo zammwe zibunye obutali butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "emimwa gyammwe gyogedde eby'obulimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "n'ennimi zammwe z'ogedde eby'ekko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewali awaaba bya nsonga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "so tewali awoza mu mazima;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "Beesiga ensonga ezitaliimu, ne boogera eby'obulimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "ne baleeta emitawaana ne bazaala obulabe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalula amagi ag'essalambwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "ne balanga ewuzi za nnabbubi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "alya ku magi gaabwe afa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "n'eryo eriba lyatise livaamu mbalasaasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye enkwe zaabwe ze bakola tezibayamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "ziri ng'engoye enkole mu wuzi za nnabbubi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "Tebasobola kuzeebikka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "Emirimu gyabwe mirimu gya kwonoona, n'ebikolwa byabwe bulabe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigere byabwe byanguyirira bikole ebibi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "era bapapirira bayiwe omusaayi ogutalina musango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "Ebirowoozo byabwe birowoozo bya bubi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "n'okuzika n'okuzikiriza bye biba buli we bagenda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkubo ery'emirembe tebalimanyi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "wadde okukozesa obwenkanya mu makubo gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "Beekubidde amakubo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "tewali n'omu agayitamu afuna emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazima gatuli wala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "n'obutuukirivu tetubufunye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "Tunoonyezza omusana naye ekizikiza kitwesibyeko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "we tusuubira obutangaavu, tutambulidde mu bisiikirize byereere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuwammantawammanta bbugwe ng'abazibe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "ne tukwatakwata ng'abatalina maaso;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "twesittala mu ttuntu ng'ekiro mu abo abalina amaanyi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "ne tuba ng'abafu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ffenna tuwuluguma ng'eddubu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "ne tusinda nga bukaamukuukulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "Tusuubira okuggyibwa mu kunyigirizibwa naye nga bwereere,",
