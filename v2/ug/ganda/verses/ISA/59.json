                "verseId": "ISA.59.21",
                "verseOrgIds": [
                  "ISA.59.21"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Omwoyo wange ali ku ggwe era n'ebigambo byange bye ntadde mu kamwa ko, tebiivenga mu kamwa ko, oba mu kamwa k'abaana bo, wadde mu kamwa k'abaana b'abaana bo, okuva kaakano okutuusa emirembe n'emirembe,\" bw'ayogera",
          "type": "text",
          "attrs": {
