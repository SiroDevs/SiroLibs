      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:11"
      },
      "items": [
        {
          "text": "bw'aliraba ku ebyo ebiva mu kubonaabona kwe, omutima gwe gulitereera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.11",
            "verseOrgIds": [
