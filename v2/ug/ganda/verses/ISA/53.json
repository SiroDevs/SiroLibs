                "verseOrgIds": [
                  "ISA.53.10"
                ]
              }
            }
          ]
        },
        {
          "text": "yafuula obulamu bwe, okuba ekiweebwayo olw'ekibi, aliraba ezzadde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
            "verseOrgIds": [
