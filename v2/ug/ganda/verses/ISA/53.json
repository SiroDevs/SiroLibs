      "attrs": {
        "style": "q1",
        "vid": "ISA 53:11"
      },
      "items": [
        {
          "text": "Era olw'ebyo bye yayitamu omuweereza wange omutuukirivu alireetera bangi okubalirwa obutuukirivu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.11",
