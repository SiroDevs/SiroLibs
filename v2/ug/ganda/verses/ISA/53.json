      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "obutali butuukirivu bwaffe ffenna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 53:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanyigirizibwa era n'obonyaabonyezebwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "naye talina kye yanyega,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "yali ng'omwana gw'endiga ogutwalibwa okuttibwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "era ng'endiga bwesirika obusirisi mu maaso g'abo abagisalako ebyoya bwesirika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "bw'atyo bwe yasirika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
