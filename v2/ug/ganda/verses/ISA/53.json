          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kunyigirizibwa n'okusalirwa omusango yatwalibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "Ani amanyi ku bye zadde lye?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "Yaggyibwa mu nsi y'abalamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "ng'akubiddwa olw'okusobya kw'abantu, bange.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 53:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamussa mu ntaana n'abakozi b'ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "n'aziikibwa n'abagagga mu kufa kwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "newaakubadde nga teyazza musango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "wadde akamwa ke okwogera eby'obulimba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
