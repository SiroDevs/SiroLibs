      "attrs": {
        "style": "q2",
        "vid": "ISA 53:11"
      },
      "items": [
        {
          "text": "era alyetikka obutali butuukirivu bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.11",
            "verseOrgIds": [
              "ISA.53.11"
