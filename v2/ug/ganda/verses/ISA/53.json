            "sid": "ISA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akkiriza ebigambo byaffe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:1"
      },
      "items": [
        {
          "text": "era ani abikkuliddwa omukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.1",
                "verseOrgIds": [
                  "ISA.53.1"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga yakulira mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.2",
                "verseOrgIds": [
                  "ISA.53.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'ekisimbe ekigonvu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "era ng'omulandira oguva mu ttaka ekkalu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "Teyalina kitiibwa wadde obulungi obutusikiriza tulage gy'ali;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "tewaali kalungi mu ye katumwegombesa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanyoomebwa n'agaanibwa abantu; omuntu eyagumira ennaku n'obuyinike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "Tetwayagala na kumutunulako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "ng'omuntu gwe wandikubye amabega ng'ayitawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "bwe twamunyooma ne tutamuyitamu ka buntu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazima ddala yeetikka obuyinike bwaffe, n'atwala ennaku yaffe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "obulumi obwanditulumye bwe bwamunyiga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "Ate nga twalowooza nti okubonaabona kwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "kyali kibonerezo okuva eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye yafumitibwa olw'okusobya kwaffe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "Yabetentebwa olw'obutali butuukirivu bwaffe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "Yeetikka ekibonerezo ffe tusobole okubeera n'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "Ebiwundu bye, bye bituwonya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ffenna twawaba ng'endiga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "buli omu ku ffe n'akwata ekkubo lye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.6",
                "verseOrgIds": [
                  "ISA.53.6"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuteekako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
