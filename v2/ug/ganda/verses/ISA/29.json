    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zikusanze Ekibuga kya Dawudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikusanze ggwe Alyeri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "Alyeri ekibuga Dawudi kye yabeeramu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "yongera omwaka ku mwaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "n'entuuko zo ez'embaga zigende mu maaso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula ndizingiza Alyeri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "alikuba ebiwoobe era alikungubaga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "era aliba gye ndi ng'ekyoto kya Alyeri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikuba olusiisira okukwetooloola wonna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "era ndikwetoolooza eminaala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "ne nkusaako ebifunvu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olikkakkanyizibwa era olyogera ng'oli mu ttaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "n'ebigambo byo biriwulikika nga biri wansi nnyo ng'oli mu nfuufu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "Eddoboozi lyo liriba ng'ery'oyo aliko akazimu nga liva mu ttaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "n'ebigambo byo biriba bya kyama nga biva mu nfuufu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abalabe bo abangi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "baliba ng'enfuufu eweweddwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "n'ebibinja by'abakozi b'ebibi abasingayo obubi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "bibe ng'ebisasiro ebifuumuuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago mu kaseera katono",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.29.6",
                "verseOrgIds": [
                  "ISA.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye alikukyalira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "mu kubwatuuka ne mu musisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "ne mu ddoboozi ery'omwanguka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "ne mu kibuyaga ne mu nnimi z'omuliro omukambwe oguzikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ebibinja by'amawanga gonna ebirwana ne Alyeri birimulumba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "birirumba n'ekigo kye ne bimutaayiza;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "kiriba ng'ekirooto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "ng'okwolesebwa mu kiro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'omuntu alumwa enjala bw'aloota ng'alya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "naye bw'agolokoka n'asigala ng'akyalumwa enjala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "oba ng'omuntu alumwa ennyonta bw'aloota ng'anywa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "naye n'agolokoka nga munafu ng'akyalumwa ennyonta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "Ekyo kye kirituuka ku bibinja by'amawanga gonna",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "agalwana n'Olusozi Sayuuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwuniikirire era mwewuunye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "Muzibirire era muzibe amaaso;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "Batamiire, naye si na nvinnyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "batagala, naye si lwa mwenge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.29.10",
                "verseOrgIds": [
                  "ISA.29.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akuwadde otulo tungi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "azibye amaaso gammwe bannabbi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "era abisse emitwe gyammwe abalabi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
