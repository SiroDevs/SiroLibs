{
  "id": "GEN.48",
  "number": "48",
  "bookId": "GEN",
  "reference": "Olubereberye 48",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "GEN 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Asabira Batabani ba Yusufu Omukisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma Yusufu n'ategeezebwa nti, \"Laba, kitaawo mulwadde.\" Bw'atyo n'atwala batabani be Manase ne Efulayimu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.1",
            "verseOrgIds": [
              "GEN.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo n'ategeezebwa nti, \"Mutabani wo azze okukulaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.2",
            "verseOrgIds": [
              "GEN.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 48:2"
      },
      "items": [
        {
          "text": "Awo Yakobo ne yeekakaba ku kitanda kye n'atuula.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.2",
            "verseOrgIds": [
              "GEN.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba Yusufu nti, \"Katonda Ayinzabyonna yandabikira e Luzi mu nsi ya Kanani n'ampa omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.3",
            "verseOrgIds": [
              "GEN.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'aŋŋamba nti, 'Laba, ndikwaza n'osukkirira ne nkufuula abantu abangi, era ensi eno ndigiwa ezzadde lyo okuba obutaka bwabwe ennaku zonna.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.4",
            "verseOrgIds": [
              "GEN.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kale kaakano batabani bo bombi abaakuzaalirwa mu Misiri nga sinnajja, bange; Efulayimu ne Manase baliba bange nga Lewubeeni ne Simyoni bwe bali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abo abaakuzaalirwa oluvannyuma lwabwe baliba babo, banaayitibwa amannya ga baganda baabwe mu mugabo gwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.6",
            "verseOrgIds": [
              "GEN.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bwe najja ng'ava e Paddani, ne ndaba ennaku Laakeeri n'anfiirako mu kkubo mu nsi ya Kanani, nga nkyagenda Efulasi; ne mmuziika eyo mu kkubo erigenda Efulasi, ye Besirekemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri bwe yalaba batabani ba Yusufu n'abuuza nti, \"Bano be baani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.8",
            "verseOrgIds": [
              "GEN.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu n'addamu kitaawe nti, \"Be batabani bange, Katonda b'ampeeredde wano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 48:9"
      },
      "items": [
        {
          "text": "N'amugamba nti, \"Nkusaba obansembereze mbasabire omukisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera kino amaaso ga Isirayiri gaali gayimbadde olw'obukadde, nga takyasobola kulaba. Awo Yusufu n'abamusembereza, Yakobo n'abagwa mu kifuba n'abanywegera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.10",
            "verseOrgIds": [
              "GEN.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri n'agamba Yusufu nti, \"Saasuubira kulaba maaso go; era laba Katonda ansobozesezza okulaba n'abaana bo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.11",
            "verseOrgIds": [
              "GEN.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yusufu n'abaggya ku maviivi ge n'avuunama wansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.12",
            "verseOrgIds": [
              "GEN.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu n'abatwala bombi, Efulayimu ng'ali mu mukono gwe ogwa ddyo, okwolekera ogwa Isirayiri ogwa kkono, ne Manase ng'ali mu mukono gwe ogwa kkono okwolekera ogwa Isirayiri ogwa ddyo, n'abamusembereza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.13",
            "verseOrgIds": [
              "GEN.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri n'agolola omukono gwe ogwa ddyo n'aguteeka ku mutwe gwa Efulayimu eyali omuto, n'omukono gwe ogwa kkono n'aguteeka ku mutwe gwa Manase, n'ayisiŋŋanya emikono gye, kubanga Manase ye yasooka okuzaalibwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.14",
            "verseOrgIds": [
              "GEN.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'awa Yusufu omukisa, n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 48:15"
      },
      "items": [
        {
          "text": "\"Katonda wa jjajjange",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 48:15"
      },
      "items": [
        {
          "text": "Ibulayimu ne kitange Isaaka gwe baatambulira mu maaso ge,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 48:15"
      },
      "items": [
        {
          "text": "Katonda oyo ankulembedde obulamu bwange bwonna",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 48:15"
      },
      "items": [
        {
          "text": "okutuusa leero,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malayika oyo eyannunula okuva mu bizibu byonna,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 48:16"
      },
      "items": [
        {
          "text": "owe omukisa abalenzi bano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 48:16"
      },
      "items": [
        {
          "text": "Erinnya lyange lyeyongerenga okutuumibwa mu bo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 48:16"
      },
      "items": [
        {
          "text": "era n'erya Ibulayimu n'erya Isaaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 48:16"
      },
      "items": [
        {
          "text": "Era bafuuke ekibiina ekinene",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 48:16"
      },
      "items": [
        {
          "text": "mu maaso g'ensi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu bwe yalaba nga kitaawe atadde omukono gwe ogwa ddyo ku Efulayimu n'atakyagala, n'akwata omukono gwa kitaawe okuguggya ku mutwe gwa Efulayimu aguzze ku mutwe gwa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba kitaawe nti, \"Kireme kuba kityo, kitange, kubanga ono ye mubereberye, teeka omukono ogwa ddyo ku mutwe gwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.18",
            "verseOrgIds": [
              "GEN.48.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kitaawe n'agaana n'agamba nti, \"Mmanyi, mwana wange, mmanyi nti alifuuka eggwanga era aliba mukulu; kyokka muto we aliba mukulu okumusinga era alivaamu amawanga mangi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.19",
            "verseOrgIds": [
              "GEN.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'abasabira omukisa ku lunaku olwo ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 48:20"
      },
      "items": [
        {
          "text": "\"Abaana ba Isirayiri basabiragane omukisa nga bagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 48:20"
      },
      "items": [
        {
          "text": "'Katonda akuyise nga Efulayimu ne Manase.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "GEN 48:20"
      },
      "items": [
        {
          "text": "Bw'atyo n'ateeka Efulayimu mu maaso ga Manase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate Isirayiri n'agamba Yusufu nti, \"Laba, nnaatera okufa, kyokka Katonda alibeera naawe era alikuzzaayo mu nsi ya bajjajjaabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.21",
            "verseOrgIds": [
              "GEN.48.21"
            ]
          }
        },
        {
          "name": "verse",
