{
  "id": "GEN.28",
  "number": "28",
  "bookId": "GEN",
  "reference": "Olubereberye 28",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "GEN 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isaaka Asindika Yakobo eri Labbaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Isaaka n'ayita Yakobo n'amuwa omukisa, n'amukuutira nti, \"Towasanga, wadde omu ku bakazi Abakanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golokoka ogende e Padanalaamu mu nnyumba ya Besweri kitaawe wa nnyoko, ofune omukazi omu ku bawala ba Labbaani mwannyina nnyoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda Ayinzabyonna akuwe omukisa, akwaze, weeyongere, era obeerenga n'abantu ab'enjawulo bangi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuwe emikisa gya Ibulayimu, era agiwe n'ezzadde lyo, olyoke ofune ensi mw'otambulira, Katonda gye yawa Ibulayimu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Isaaka n'asiibula Yakobo, Yakobo n'agenda e Padanalaamu ewa Labbaani, mutabani wa Besweri Omusuuli mwannyina Lebbeeka, nnyina wa Esawu ne Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu n'ategeera nga Isaaka awadde Yakobo omukisa, era ng'amusindise e Padanalaamu afuneyo omukazi, era nga bwe yamuwa omukisa yamukuutira nti, \"Towasanga ku bakazi Abakanani,\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nga Yakobo agondedde kitaawe ne nnyina n'agenda e Padanalaamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'ategeera nti abakazi Abakanani tebaasanyusa kitaawe Isaaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu n'agenda eri Isimayiri n'awasa omukazi erinnya lye Makalasi, muwala wa Isimayiri, mutabani wa Ibulayimu, mwannyina wa Nebayoosi, n'amwongera ku bakazi be yalina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekirooto kya Yakobo ng'ali e Beseri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yakobo n'ava e Beeruseba n'ayolekera Kalani. N'atuuka mu kifo ekimu, n'asula awo ekiro ekyo, kubanga obudde bwali buzibye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'addira erimu ku mayinja agaali mu kifo ekyo, n'alyezizika ne yeebaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'aloota ng'alaba eddaala eggwanvu nga liva ku nsi okutuuka mu ggulu, era nga bamalayika ba Katonda balikkirako era nga balinnyirako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "atudde waggulu waalyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yakobo nti, \"Nze",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Ibulayimu jjajjaawo, era Katonda wa Isaaka; ensi kw'ogalamidde ndigikuwa ggwe n'ezzadde lyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ezzadde lyo liriba ng'enfuufu y'oku nsi, era olibuna obugwanjuba n'obuvanjuba era n'obukiikakkono n'obukiikaddyo. Mu ggwe ne mu zadde lyo amawanga gonna ag'oku nsi mwe galiweerwa omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.14",
            "verseOrgIds": [
              "GEN.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba ndi wamu naawe, era nnaakukuumanga buli gy'onoogendanga yonna, era ndikukomyawo mu nsi eno, kubanga sirikuleka okutuusa nga mmaze okukola ekyo kye nkugambye.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.15",
            "verseOrgIds": [
              "GEN.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yakobo n'ava mu tulo n'agamba nti, \"Mazima ddala",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.16",
                "verseOrgIds": [
                  "GEN.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ali mu kifo kino, nze mbadde ssimanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'atya nnyo, n'agamba nti, \"Ekifo kino nga kyantiisa! Ekifo kino ye nnyumba ya Katonda, era guno gwe mulyango gw'eggulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.17",
            "verseOrgIds": [
              "GEN.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yakobo n'agolokoka ku makya, n'addira ejjinja lye yali yeezizise n'alisimba okuba empagi n'ayiwa amafuta ku mutwe gwalyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.18",
            "verseOrgIds": [
              "GEN.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo ekyo n'akituuma Beseri, songa ekibuga ekyo kyayitibwanga Luzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yakobo ne yeerayirira ng'agamba nti, \"Katonda bw'alibeera nange, n'ankuuma mu lugendo luno lwe ndiko, n'ampa emmere okulya era n'ebyokwambala ne nkomawo mirembe mu nnyumba ya kitange,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.20",
            "verseOrgIds": [
              "GEN.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.21",
                "verseOrgIds": [
                  "GEN.28.21"
                ]
              }
            }
          ]
        },
        {
          "text": "n'aba Katonda wange.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ejjinja lino lye nsimbye okuba empagi liriba nnyumba ya Katonda, era n'ebyo byonna by'ompa ndikuwaako ekimu eky'ekkumi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.22",
            "verseOrgIds": [
              "GEN.28.22"
            ]
          }
        }
      ]
    }
  ],
