  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "GEN 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baganda ba Yusufu Bajja e Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo bwe yategeera nga mu Misiri eriyo emmere, n'agamba batabani be nti, \"Lwaki mutunula butunuzi?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpulidde nti mu Misiri eriyo emmere, muserengete mutugulireyo emmere, tube balamu, tuleme okufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo baganda ba Yusufu ekkumi ne baserengeta e Misiri okugula emmere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.3",
            "verseOrgIds": [
              "GEN.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka Yakobo n'atasindika Benyamini, muto wa Yusufu wamu ne baganda be kubanga yatya nti akabi kayinza okumutuukako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe batyo batabani ba Isirayiri ne bajja mu Misiri wamu n'abalala abajja okugula emmere, kubanga ensi ya Kanani yali ejjudde enjala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusufu Asanga Baganda be",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo Yusufu ye yali afuga Misiri; nga y'aguza abantu emmere. Awo baganda be ne bajja ne bamuvuunamira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.6",
            "verseOrgIds": [
              "GEN.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu n'abalaba n'abategeera, wabula n'abayisa nga b'atamanyi n'ayogera nabo n'obukambwe. N'ababuuza nti, \"Muva wa?\" Ne bamuddamu nti, \"Tuva mu nsi ya Kanani, tuzze kugula mmere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Yusufu n'ategeera baganda be kyokka bo ne batamutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.8",
            "verseOrgIds": [
              "GEN.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yusufu n'ajjukira ebirooto bye ku bo. N'abagamba nti, \"Muli bakessi; muzze kuketta nsi yaffe mulabe bw'eri ennafu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.9",
            "verseOrgIds": [
              "GEN.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamuddamu nti, \"Nedda mukama waffe; abaddu bo tuzze kugula mmere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.10",
            "verseOrgIds": [
              "GEN.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ffenna tuli batabani ba musajja omu, tuli basajja ba mazima. Abaddu bo tetuli bakessi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye n'abaddamu nti, \"Nedda muzze kulaba obunafu bw'ensi yaffe bwe buli.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.12",
            "verseOrgIds": [
              "GEN.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamuddamu nti, \"Abaddu bo tuli kkumi na babiri, tuli baana ba muntu omu mu nsi ya Kanani, laba muto waffe n'olwa leero ali ne kitaffe, n'omulala yafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu n'alumiriza nti, \"Kiri nga bwe mbagambye, muli bakessi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.14",
            "verseOrgIds": [
              "GEN.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzija kubategeerera ku kino, ndayidde obulamu bwa Falaawo temujja kuva wano, okuggyako nga muto wammwe aleeteddwa wano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.15",
            "verseOrgIds": [
              "GEN.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutume omu ku mmwe, aleete muganda wammwe, mwe mubeere mu kkomera, ebigambo byammwe byetegerezebwe obanga ddala bye mwogedde bya mazima. Oba si ekyo ndayidde obulamu bwa Falaawo, muli bakessi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.16",
            "verseOrgIds": [
              "GEN.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'abateeka bonna mu kkomera okumala ennaku ssatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwokusatu Yusufu n'abagamba nti, \"Mukole bwe muti okuwonya obulamu bwammwe, kubanga ntya Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
              "GEN.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "obanga ddala muli basajja b'amazima, omu ku baganda bammwe asigale ng'asibiddwa mu kkomera, abalala mugende mutwalire abantu bammwe emmere,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.19",
            "verseOrgIds": [
              "GEN.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mundeetere muto wammwe, olwo ebigambo byammwe bikakasibwe muleme okufa.\" Awo ne bakola bwe batyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne bagambagana nti, \"Ddala tuliko omusango gwa muganda waffe, kubanga twalaba nga mweraliikirivu, bwe yatwegayirira ne tutamuwuliriza; akabi kano kyekavudde katutuukako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewubeeni kwe kubaddamu nti, \"Nnabagamba muleme kukola kabi ku mulenzi, nga mmwe temumpuliriza; kale omusaayi gwe kyeguva gutuwalanwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.22",
            "verseOrgIds": [
              "GEN.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne batamanya nti Yusufu ategedde bye boogedde, kubanga bayogeranga naye nga bayita mu mutaputa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.23",
            "verseOrgIds": [
              "GEN.42.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yusufu n'atunula ebbali n'akaaba, ate n'akyuka gye bali n'ayogera nabo. Awo n'atwala Simyoni n'amusiba nga balaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.24",
            "verseOrgIds": [
              "GEN.42.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'alagira bajjuze ensawo zaabwe eŋŋaano, era bazze ensimbi za buli omu mu nsawo ye, baweebwe n'entanda; ne bibakolerwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 42:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne batikka endogoyi zaabwe eŋŋaano ne bagenda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.26",
            "verseOrgIds": [
              "GEN.42.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 42:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omu ku bo bwe yasumulula ensawo ye okuliisa endogoyi ye nga bali mu kifo mwe baasula, n'alaba ensimbi ze ku mumwa gw'ensawo;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.27",
            "verseOrgIds": [
              "GEN.42.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 42:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'agamba baganda be nti, \"Ensimbi zange baazinzirizza, ziizino mu kamwa k'ensawo yange!\" Ekyo ne kibeeralikiriza, buli omu n'atandika okutya, nga bwe bagamba nti, \"Kiki kino Katonda ky'atukoze!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Batabani ba Yakobo Bamutegeeza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 42:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baakomawo mu nsi ya Kanani eri Yakobo kitaabwe ne bamutegeeza byonna ebyababaako, nga bagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.29",
            "verseOrgIds": [
              "GEN.42.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 42:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja omufuzi w'ensi y'e Misiri yayogera naffe n'obukambwe era n'atuyisa nga abaali bagenze okuketta ensi ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.30",
            "verseOrgIds": [
              "GEN.42.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 42:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ne tumugamba nti, Tuli basajja b'amazima, tetuli bakessi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.31",
            "verseOrgIds": [
              "GEN.42.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 42:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuli abooluganda kumi na babiri, baana ba muntu omu, munnaffe yafa, ne muto waffe olwa leero ali ne kitaffe mu nsi ya Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.32",
            "verseOrgIds": [
              "GEN.42.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 42:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Awo omusajja oyo omufuzi w'ensi n'atugamba nti, 'Ku kino kwennaategeerera nga muli beesigwa: muleke wano omu ku baganda bammwe, mutwale eŋŋaano olw'enjala eri mu maka gammwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 42:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundeetere muto wammwe, kwe nnaategeerera nga temuli bakessi, muli basajja b'amazima, olwo ne ndyoka mbawa muganda wammwe, mulyoke mugule emmere mu nsi eno.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 42:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka eka, buli eyafukumulanga ensawo ye, laba ng'omuvumbo gw'ensimbi ze mweziri. Awo bo ne kitaabwe bwe baalaba emivumbo gy'ensimbi ne batya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 42:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo kitaabwe n'abagamba nti, \"Munzigyeko abaana bange: Yusufu taliiwo, ne Simyoni taliiwo ne kaakano mwagala muntwaleko Benyamini!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 42:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Lewubeeni n'agamba kitaawe nti, \"Ottanga batabani bange bombi, bwe sirikomyawo Benyamini gy'oli; mumpe, nange ndimukomyawo gy'oli.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 42:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yakobo n'agamba nti, \"Mutabani wange tajja kuserengeta nammwe, kubanga muganda we yafa, era ye y'asigalawo yekka. Akabi bwe kalimutuukako mu lugendo lwe mugendako, muliserengesa envi zange emagombe nga nkyali munakuwavu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.38",
            "verseOrgIds": [
              "GEN.42.38"
            ]
          }
        }
      ]
    }
  ],
