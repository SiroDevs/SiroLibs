  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "GEN 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuzaalibwa kwa Isaaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.21.1",
                "verseOrgIds": [
                  "GEN.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akwatirwa Saala ekisa nga bwe yagamba Ibulayimu, era n'akolera Saala kye yasuubiza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saala n'aba olubuto, n'azaalira Ibulayimu omwana owoobulenzi mu bukadde bwe, mu kiseera Katonda kye yamugamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'atuuma omwana owoobulenzi, eyamuzaalirwa Saala, erinnya Isaaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'akomola mutabani we Isaaka ow'ennaku omunaana ez'obukulu nga Katonda bwe yamulagira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu yali aweza emyaka kikumi mutabani we Isaaka bwe yazaalibwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saala n'agamba nti, \"Katonda andeetedde okusekererwa, buli anaawulira anansekerera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'agamba nti, \"Ani yandirowoozezza nti Saala alifuna omwana? Naye, laba mmuzaalidde omwana wabulenzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agali ne Isimayiri Bagobwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaka n'akula, n'aggyibwa ku mabeere, Ibulayimu n'afumba embaga ennene ku lunaku Isaaka lwe yaggyibwa ku mabeere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saala yalaba nga mutabani wa Agali Omumisiri, gwe yazaalira Ibulayimu ng'azannya ne mutabani we Isaaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'alyoka agamba Ibulayimu nti, \"Goba omuweereza ono ne mutabani we, kubanga omwana w'omuweereza ono talisikira wamu na mwana wange Isaaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ekyo Ibulayimu n'atakisiima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'agamba Ibulayimu nti, \"Tonakuwala olw'omulenzi n'olw'omuweereza wo omukazi, buli Saala ky'akugamba kikole; kubanga mu Isaaka mwe ndituukiririza ebyo byonna bye nakusuubiza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'omwana w'omuweereza wo omukazi ndimufuula eggwanga, kubanga ava mu ggwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'agolokoka ku makya ennyo, n'addira omugaati n'ensawo ey'amazzi n'abiwa Agali n'omwana gwe yazaala ng'abiteeka ku kibegabega kye, n'amusiibula. Agali n'agenda ng'atambulatambula mu ddungu lya Beeruseba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agali ne Isimayiri mu Ddungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo amazzi ag'omu ddiba bwe gaggwaamu, Agali n'ateeka omwana we wansi w'ogumu ku miti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agali ne yeeyongerayo ebbanga ng'awalasibwa akasaale, nga mita kikumi, n'atuula okumwolekera, kubanga yayogera nti, \"Nneme okulaba omwana ng'afa.\" Naye bwe yali ng'atudde, omwana n'ayimusa eddoboozi n'akaaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'awulira eddoboozi ly'omulenzi ng'akaaba, malayika wa Katonda n'ayita Agali ng'asinziira mu ggulu n'amugamba nti, \"Kiki ekikuteganya? Totya, kubanga Katonda awulidde eddoboozi ly'omulenzi w'ali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golokoka, situla omwana omunyweze mu mikono gyo, kubanga ndimufuula eggwanga eddene.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Katonda n'azibula amaaso g'Agali, n'alaba oluzzi, n'agenda n'ajjuza ensawo ey'eddiba amazzi, n'anywesa omulenzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Katonda n'aba n'omulenzi n'akula n'abeera mu ddungu n'aba mwatiikirivu mu kulasa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.20",
            "verseOrgIds": [
              "GEN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabeeranga mu ddungu lya Palani: nnyina n'amufunira omukazi okuva mu nsi y'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibulayimu Alagaana n'Abimereki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo Abimereki ng'ali ne Fikoli omukulu w'eggye lye n'agamba Ibulayimu nti, \"Katonda ali naawe mu buli ky'okola:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale kaakano ndayirira mu maaso ga Katonda nga tolinkuusakuusa, wadde okukuusakuusa omwana wange oba omwana w'omwana wange. Naye nga nze bwe nkukoze obulungi nga naawe bw'olinkola nze n'ensi mw'ozze.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Ibulayimu n'amuddamu nti, \"Nkulayiridde.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulayimu ne yeemulugunya eri Abimereki olw'oluzzi lwe abaddu be lwe baamunyagako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimereki n'amugamba nti, \"Simanyi n'omu eyakola ekintu ekyo, ggwe tewambulira era sikiwulirangako okutuusa ggwe lw'okintegeezeezza olwa leero.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.26",
            "verseOrgIds": [
              "GEN.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulayimu n'addira endiga n'ente n'abiwa Abimereki, ne balagaana endagaano bombi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.27",
            "verseOrgIds": [
              "GEN.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulayimu n'ayawulako endiga enduusi musanvu okuva mu kisibo kye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.28",
            "verseOrgIds": [
              "GEN.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimereki n'abuuza Ibulayimu nti, \"Endiga ezo omusanvu enduusi z'oyawuddeko amakulu gaazo ki?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amuddamu nti, \"Endiga ezo enduusi omusanvu onoozitwala okuva gye ndi kalyoke kabe obukakafu nti nze nasima oluzzi olwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo ekyo kyekyava kiyitibwa Beeruseba, kubanga eyo bombi gye baalagaanira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baamala okukola endagaano e Beeruseba, Abimereki ne Fikoli omukulu w'eggye lye ne basitula ne baddayo mu nsi y'Abafirisuuti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
            "verseOrgIds": [
              "GEN.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'asimba omuti omumyulimu mu Beeruseba n'akaabiririra eyo erinnya lya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.21.33",
                "verseOrgIds": [
                  "GEN.21.33"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda Ataggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
