          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu ne yeeyongera okutambulatambula mu nsi y'Abafirisuuti okumala ennaku nnyingi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.34",
