        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avumirira Okusiiba okw'Obulimba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo olwatuuka mu mwaka ogwokuna ogw'obufuzi bwa kabaka Daliyo, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.1",
                "verseOrgIds": [
                  "ZEC.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Zekkaliya, ku lunaku olwokuna olw'omwezi ogw'omwenda oguyitibwa Kisuleevu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya mu Beseri baali batumye Salezeeri omukungu wa kabaka ne Legemumereki n'abantu baabwe mu Yerusaalemi okwogerako ne bakabona babegayiririre eri",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.2",
                "verseOrgIds": [
                  "ZEC.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okusaba bakabona b'omu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.3",
                "verseOrgIds": [
                  "ZEC.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye ne bannabbi nti, \"Nkaabe era nsiibe mu mwezi ogwokutaano nga bwe mbadde nkola okumala emyaka gino gyonna?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.4",
                "verseOrgIds": [
                  "ZEC.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye ne kinzijira nga kigamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gamba abantu bonna abali mu nsi, ne bakabona nti, 'Bwe mwasiiba ne mukungubaga mu mwezi ogwokutaano ne mu gw'omusanvu mu myaka gino ensanvu, mwali musiibira nze?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.5",
            "verseOrgIds": [
              "ZEC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe mulya ne munywa, muba temulya ku lwammwe era n'okunywa ku lwammwe?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.6",
            "verseOrgIds": [
              "ZEC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino si bye bigambo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.7",
                "verseOrgIds": [
                  "ZEC.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yalangirira mu bannabbi ab'edda, Yerusaalemi bwe kyali kikyalimu abantu era nga kikyakulaakulana, nga n'ebibuga byakyo bikyetoolodde, nga ne mu bukiikaddyo ne mu bitundu eby'ensenyi mukyalimu abantu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.8",
                "verseOrgIds": [
                  "ZEC.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Zekkaliya nate nti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.9",
                "verseOrgIds": [
                  "ZEC.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, 'Musalenga emisango egy'ensonga, mukwatirweganenga ekisa n'okusaasiragananga buli muntu eri muganda we.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temutulugunyanga bannamwandu, n'abatalina bakitaabwe, n'abatambuze wadde abaavu, era tewateekwa kubaawo muntu n'omu ku mmwe alowooza mu mutima gwe okukola obulabe ku muganda we!'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.10",
            "verseOrgIds": [
              "ZEC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye baagaana okuwuliriza ne bakakanyaza emitima gyabwe ne baziba n'amatu gaabwe baleme okuwulira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.11",
            "verseOrgIds": [
              "ZEC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakakanyaza emitima gyabwe ng'ejjinja, ne batawuliriza mateeka wadde ebigambo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.12",
                "verseOrgIds": [
                  "ZEC.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye bye yaweereza n'Omwoyo we mu mukono gwa bannabbi ab'edda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.12",
                "verseOrgIds": [
                  "ZEC.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye kyeyava abanyiigira ennyo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bwe nabakoowoola ne batafaayo, nange ne ŋŋaana okufaayo nga bankowodde,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.13",
                "verseOrgIds": [
                  "ZEC.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nabasaasaanya n'omuyaga ogukunta mu mawanga ge baali batamanyi. Ensi gye baaleka n'ebeera matongo nga tewali agibeeramu, ensi ennungi esanyusa, kyeyava efuuka eddungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.14",
            "verseOrgIds": [
              "ZEC.7.14"
            ]
          }
        }
      ]
    }
  ],
