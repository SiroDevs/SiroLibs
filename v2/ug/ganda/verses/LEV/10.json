{
  "id": "LEV.10",
  "number": "10",
  "bookId": "LEV",
  "reference": "Ebyabaleevi 10",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "LEV 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okufa kwa Nadabu ne Abiku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo olwatuuka, batabani ba Alooni, Nadabu ne Abiku ne beetwalira buli omu ekyoterezo kye, ne bateekamu omuliro, ne bassaako obubaane, ne bawaayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.1",
                "verseOrgIds": [
                  "LEV.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda omuliro ogutali mutukuvu, ne basobya ekiragiro kye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.1",
            "verseOrgIds": [
              "LEV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuliro ne guva eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.2",
                "verseOrgIds": [
                  "LEV.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ne gubookya, ne bafiira awo mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.2",
                "verseOrgIds": [
                  "LEV.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'agamba Alooni nti, Kino",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.3",
                "verseOrgIds": [
                  "LEV.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kye yayogerako bwe yagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "\" 'Nzija kweyolekanga nga bwe ndi omutukuvu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "eri abo abansemberera,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "era nassibwangamu ekitiibwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "abantu bonna.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "LEV 10:3"
      },
      "items": [
        {
          "text": "Alooni n'asirika busirisi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.3",
            "verseOrgIds": [
              "LEV.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'ayita Misayeri ne Erizafani, abaana ba Wuziyeeri kitaawe omuto owa Alooni, n'abagamba nti, \"Mujje wano musitule emirambo gya baganda bammwe mugiggye wano awatukuvu mugitwale ebweru w'olusiisira.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.4",
            "verseOrgIds": [
              "LEV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe batyo ne bajja ne basitula baganda baabwe abo nga bwe baali bayambadde ne babatwala ebweru w'olusiisira nga Musa bwe yabagamba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'agamba Alooni, ne Eriyazaali ne Isamaali, batabani ba Alooni, nti, \"Mmwe temusumulula nviiri zammwe okuzita ne zireebeeta era temuyuza byambalo byammwe nga mukungubaga, kubanga muyinza okufa, n'obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.6",
                "verseOrgIds": [
                  "LEV.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda buyinza okubuubuukira abantu bonna. Naye baganda bammwe, ye nnyumba yonna eya Isirayiri, babakaabire abo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.6",
                "verseOrgIds": [
                  "LEV.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda b'azikirizza n'omuliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era temuva ku mulyango gwa Weema ey'Okukuŋŋaanirangamu, temulwa kufa; kubanga muliko amafuta ag'omuzeeyituuni ga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.7",
                "verseOrgIds": [
                  "LEV.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ag'okwawula.\" Ne bakola nga Musa bwe yabalagira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakabona bye Basaana Okwegendereza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.8",
            "verseOrgIds": [
              "LEV.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.8",
                "verseOrgIds": [
                  "LEV.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agamba Alooni nti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.8",
            "verseOrgIds": [
              "LEV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ggwe ne batabani bo bwe muyingiranga mu Weema ey'Okukuŋŋaanirangamu temunywanga envinnyo oba ekyokunywa ekirala kyonna ekitamiiza; bwe mulikikola temulirema kufa. Eryo linaabanga tteeka ery'enkalakkalira ne mu mirembe gyonna egigenda okujja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.9",
            "verseOrgIds": [
              "LEV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwawulengamu ebitukuvu n'ebyabulijjo, ebirongoofu n'ebitali birongoofu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.10",
            "verseOrgIds": [
              "LEV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "era kibasaanidde okuyigirizanga abaana ba Isirayiri amateeka gonna",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.11",
                "verseOrgIds": [
                  "LEV.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda g'abawadde ng'agayisa mu Musa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.11",
            "verseOrgIds": [
              "LEV.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etteeka ery'Okulya Emmere Entukuvu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'agamba Alooni ne Eriyazaali ne Isamaali, batabani ba Alooni abaali basigaddewo, nti, \"Mutwale ekiweebwayo eky'emmere ey'empeke ekyasigaddewo ku biweebwayo ebyokebwa eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.12",
                "verseOrgIds": [
                  "LEV.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nga si kizimbulukuse, mukiriire okumpi n'ekyoto kubanga kitukuvu nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukiriire mu kifo ekitukuvu, kubanga gwe mugabo gwo, era gwe mugabo gw'abatabani bo, nga guva ku kiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.13",
                "verseOrgIds": [
                  "LEV.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ekyokebwa; bwe ntyo bwe ndagiddwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ekifuba ekiwuubibwa n'ekisambi ekiweebwayo munaabiriira mu kifo kyonna kye munaalaba ekirongoofu; mubirye, ggwe ne batabani bo ne bawala bo b'oli nabo; kubanga bibaweereddwa ng'omugabo gwammwe, ggwe n'abaana bo, nga biva ku biweebwayo olw'emirembe ebiweereddwayo abaana ba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisambi ekiweereddwayo n'ekifuba ekiwuubibwa, binaaleetebwa awamu n'amasavu ag'oku biweebwayo ebyokebwa, ne biwuubibwawuubibwa nga kye kiweebwayo ekiwuubibwa awali",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.15",
                "verseOrgIds": [
                  "LEV.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", era kinaabeeranga mugabo gwo awamu ne batabani bo emirembe gyonna; nga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.15",
                "verseOrgIds": [
                  "LEV.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda bw'alagidde.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
