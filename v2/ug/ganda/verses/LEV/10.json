          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Alooni n'addamu Musa nti, \"Laba, olwa leero bawaddeyo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.19",
                "verseOrgIds": [
                  "LEV.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ekiweebwayo olw'ebibi byabwe n'ekiweebwayo kyabwe ekyokebwa; naye era ebintu nga bino ne bingwako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.10.19",
                "verseOrgIds": [
                  "LEV.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda yandisanyuse singa leero ndidde ekiweebwayo olw'ekibi?\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa bwe yawulira ebigambo ebyo n'amatira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.20",
            "verseOrgIds": [
              "LEV.10.20"
            ]
          }
        }
      ]
