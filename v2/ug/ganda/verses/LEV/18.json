          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Abantu bonna abanaakolanga ebintu ebyo ebibi ebikyayibwa ennyo, abantu ng'abo banaagobwanga ne bagaanibwa okukolagana ne bannaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwatenga amateeka gange, nga mwewalanga okukola ebyonoono ebyo ebikyayibwa eby'amayisa amabi, abo abaabasooka ge beeyisanga si kulwa nga gabafuula abatali balongoofu. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.30",
                "verseOrgIds": [
                  "LEV.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.' \"",
          "type": "text",
