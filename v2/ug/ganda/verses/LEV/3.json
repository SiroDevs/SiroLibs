              "attrs": {
                "verseId": "LEV.3.16",
                "verseOrgIds": [
                  "LEV.3.16"
                ]
              }
            }
          ]
        },
        {
          "text": ". Amasavu gonna ganaabanga ga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
