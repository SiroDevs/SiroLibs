          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "anaagikwatanga omutwe gwayo, n'agittira mu maaso ga Weema ey'Okukuŋŋaanirangamu. Kale batabani ba Alooni banaamansiranga omusaayi gwayo ku kyoto n'okukyebunguluza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
              "LEV.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo anaawangayo ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.3.14",
                "verseOrgIds": [
                  "LEV.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyokeddwa mu muliro ng'akiggya okwo: amasavu agabikka ebyenda, n'amasavu gonna agaliraanye ebyenda,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ensigo zombi n'amasavu agaziriko okuliraana ekiwato, n'ekibikka ku kibumba nga biggyibwako wamu n'ensigo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.15",
            "verseOrgIds": [
              "LEV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabona anaabyokeranga ku kyoto okubeera ekyokulya ekiweebwayo nga kyokebwa mu muliro okuvaamu evvumbe eddungi erisanyusa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
