    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okukungubagira Abalangira ba Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungubagira abalangira ba Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.1",
            "verseOrgIds": [
              "EZK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyogere nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "\" 'Maama wo nga yali mpologoma nkazi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "mu mpologoma!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "Yagalamiranga wakati mu mpologoma ento,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "n'erabirira abaana baayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ekuza emu ku baana baayo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "n'efuuka empologoma ey'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "n'eyiga okuyigga ebisolo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "n'okulya abantu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga gaawulira ebimufaako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "n'akwatirwa mu kinnya kye yali asimye,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "ne bamusibamu amalobo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "ne bamuleeta mu nsi y'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Awo bwe yalaba essuubi lye nga terituukiridde,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "ne bye yali alindirira nga biyise,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "n'eddira emu ku baana baayo ab'empologoma endala,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "n'egifuula empologoma ey'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'etambulatambula mu mpologoma,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "kubanga yali efuuse empologoma ey'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "era n'eyiga okuyigga ensolo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "n'okulya abantu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'emenyaamenya ebifo byabwe eby'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "n'ezikiriza n'ebibuga byabwe;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "ensi n'abo bonna abaagibeerangamu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "ne batya olw'okuwuluguma kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo amawanga gonna ne gagirumba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "okuva mu bitundu ebyali byetooloddewo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "ne bayanjuluza ekitimba kyabwe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "ne bagikwatira mu kinnya kyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakozesa amalobo okugisikayo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "ne bagiteeka mu kayumba ak'ebyuma,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "ne bagitwala eri kabaka w'e Babulooni;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "n'eteekebwa mu kkomera,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "n'etaddayo kuwulikika nate ku nsozi za Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Maama wo yali ng'omuzabbibu mu nnimiro",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "ogwasimbibwa okumpi n'amazzi;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "ne gubala ebibala ne bijjula amatabi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "kubanga waaliwo amazzi mangi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatabi gaagwo gaali magumu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:11"
      },
      "items": [
        {
          "text": "era nga gasaanira okukolebwamu omuggo gw'obwakabaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
