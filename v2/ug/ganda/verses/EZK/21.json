  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "EZK 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katonda Akozesa Babulooni ng'Ekitala kye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.1",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.1",
                "verseOrgIds": [
                  "EZK.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne kinzijira, n'aŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.1",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omwana w'omuntu tunuulira Yerusaalemi oyogere ku bifo ebitukuvu. Wa ekigambo ky'obunnabbi eri ensi ya Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.2",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyogere nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.3",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.3",
                "verseOrgIds": [
                  "EZK.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, nnina oluyombo naawe, era ndisowola ekitala kyange okuva mu kiraato kyakyo ne nzikiriza abatuukirivu n'abatali batuukirivu abali mu ggwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.3",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ndiba nzikiriza abatuukirivu n'abatali batuukirivu, kyendiva nnema okuzza ekitala kyange mu kiraato kyakyo, ne ntabaala buli muntu nakyo okuva Obukiikaddyo okutuuka Obukiikakkono.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.4",
            "verseOrgIds": [
              "EZK.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abantu bonna balimanya nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.5",
                "verseOrgIds": [
                  "EZK.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nsowodde ekitala kyange okuva mu kiraato kyakyo, era tekiriddayo mu kiraato kyakyo nate.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omwana w'omuntu, kyonoova okaabira mu maaso gaabwe ng'omutima gwo gujjudde ennaku n'obuyinike.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe balikubuuza nti, 'Okaabira ki?' Oliddamu nti, 'Olw'amawulire ge nfunye, kubanga ebyo bwe birijja, buli mutima gulisaanuuka, na buli mukono ne gulemala, n'emyoyo ne gizirika, n'amaviivi gonna ne ganafuwa ne gafuuka ng'amazzi.' Bijja era birituukirira, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.7",
                "verseOrgIds": [
                  "EZK.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.8",
                "verseOrgIds": [
                  "EZK.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kinzijira, n'aŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omwana w'omuntu, wa obunnabbi oyogere nti, 'Bw'ati bw'ayogera Mukama nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:9"
      },
      "items": [
        {
          "text": "\" 'Ekitala, ekitala, kiwagaddwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:9"
      },
      "items": [
        {
          "text": "era kiziguddwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiwagaddwa okutta, kiziguddwa, era kimasamasa ng'okumyansa kw'eggulu!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.10",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:10"
      },
      "items": [
        {
          "text": "Tulisanyukira obuyinza bw'omwana wange Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.10",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 21:10"
      },
      "items": [
        {
          "text": "\" 'Ekitala kinyooma buli muggo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.10",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ekitala kiweereddwayo okuzigulwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.11",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:11"
      },
      "items": [
        {
          "text": "kiryoke kinywezebwe mu mukono;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.11",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:11"
      },
      "items": [
        {
          "text": "kiwagaddwa era kiziguddwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.11",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:11"
      },
      "items": [
        {
          "text": "kiryoke kiweebwe omussi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.11",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaba era wowoggana, omwana w'omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.12",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:12"
      },
      "items": [
        {
          "text": "kubanga ekyo nkikola bantu bange,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.12",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:12"
      },
      "items": [
        {
          "text": "era nkikola abalangira bonna aba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.12",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:12"
      },
      "items": [
        {
          "text": "Mbawaddeyo eri ekitala wamu n'abantu bange,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.12",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:12"
      },
      "items": [
        {
          "text": "noolwekyo weekube mu kifuba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.12",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Okugezesebwa kuteekwa okujja. Kiba kitya ng'omuggo gw'obufuzi bwa Yuda ekitala gwe kinyooma, tegulabika nate? bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.13",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.21.13",
                "verseOrgIds": [
                  "EZK.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.13",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kyonoova owa obunnabbi, omwana w'omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:14"
      },
      "items": [
        {
          "text": "n'okuba ne mu ngalo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:14"
      },
      "items": [
        {
          "text": "Leka ekitala kisale emirundi ebiri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:14"
      },
      "items": [
        {
          "text": "oba emirundi esatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:14"
      },
      "items": [
        {
          "text": "Kitala kya kutta,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:14"
      },
      "items": [
        {
          "text": "okutta okunene,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:14"
      },
      "items": [
        {
          "text": "nga kibataayiza enjuuyi zonna,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
