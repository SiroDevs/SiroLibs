    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:15"
      },
      "items": [
        {
          "text": "Kiwagaddwa era kimyansa ng'okumyansa kw'eggulu",
