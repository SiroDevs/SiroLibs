          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nange ndikuba mu ngalo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 21:17"
      },
      "items": [
        {
          "text": "n'ekiruyi kyange kirikkakkana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:17"
      },
      "items": [
        {
          "text": "Nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
