          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.1.1",
                "verseOrgIds": [
                  "ZEP.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyajjira Zeffaniya mutabani wa Kuusi, muzzukulu wa Gedaliya, muzzukulu wa Amaliya, muzzukulu wa Keezeekiya, mu mirembe gya Yosiya mutabani wa Amoni, Kabaka wa Yuda.",
