        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezera Akomawo e Yerusaalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo oluvannyuma lw'ebyo, mu biro eby'obufuzi bwa Alutagizerugizi kabaka w'e Buperusi, Ezera mutabani wa Seraya, muzzukulu wa Azaliya, muzzukulu wa Kirukiya,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "muzzukulu wa Sallumu, muzzukulu wa Zadooki, muzzukulu wa Akitubu,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "muzzukulu wa Amaliya, muzzukulu wa Azaliya, muzzukulu wa Merayoosi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muzzukulu wa Zerakiya, muzzukulu wa Uzzi, muzzukulu wa Bukki,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "muzzukulu wa Abisuwa, muzzukulu wa Finekaasi, muzzukulu wa Eriyazaali, muzzukulu wa Alooni kabona asinga obukulu,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ava e Babulooni. Yali munnyonnyozi w'amateeka mukugu mu mateeka,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.6",
                "verseOrgIds": [
                  "EZR.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri ge yawa Musa. Kabaka n'amuwa buli kintu kye yasaba kubanga omukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.6",
                "verseOrgIds": [
                  "EZR.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda we gwali wamu naye.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu ku bantu ba Isirayiri, omwo nga mwe muli bakabona, n'Abaleevi, n'abayimbi, n'abaakuumanga wankaaki, n'abaaweerezanga mu yeekaalu, ne bagenda wamu naye e Yerusaalemi mu mwaka ogw'omusanvu ogw'obufuzi bwa kabaka Alutagizerugizi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'atuuka mu Yerusaalemi mu mwezi ogwokutaano ogw'omwaka ogw'omusanvu ogw'obufuzi bwa kabaka oyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasitula okuva e Babulooni ku lunaku olw'olubereberye olw'omwezi ogw'olubereberye, n'atuuka e Yerusaalemi ku lunaku olw'olubereberye olw'omwezi ogwokutaano, kubanga omukono gwa Katonda we omulungi gwali wamu naye.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezera yali amaliridde mu mutima gwe okusoma n'okukuuma Etteeka lya",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.10",
                "verseOrgIds": [
                  "EZR.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", era n'okuyigirizanga amateeka n'ebiragiro byalyo mu Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebbaluwa Kabaka Alutagizerugizi gye yawandiikira Ezera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno ye kopi ey'ebbaluwa kabaka Alutagizerugizi gye yawa Ezera kabona era omusomesa, omusajja eyali omukugu mu nsonga ez'amateeka n'ebiragiro bya",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.11",
                "verseOrgIds": [
                  "EZR.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "eri Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alutagizerugizi, kabaka wa bakabaka,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Eri Ezera kabona era omunnyonnyozi w'amateeka ga Katonda w'eggulu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Nkulamusizza.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nteeka etteeka nga buli muntu ow'omu ggwanga lya Isirayiri, omwo nga mwe muli bakabona n'Abaleevi, awulira okugenda e Yerusaalemi naawe, ayinza okugenda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otumiddwa kabaka n'abakungu be omusanvu ab'oku ntikko okugenda okunoonyereza ku bikwata ku Yuda ne Yerusaalemi nga mugoberera etteeka lya Katonda wammwe, lye mumanyi obulungi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe muba nga mugenda mutwale effeeza ne zaabu kabaka n'abakungu be bye bawaddeyo ku bwabwe eri Katonda wa Isirayiri, atuula mu Yerusaalemi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "awamu n'effeeza ne zaabu yonna gye muliggya mu ssaza lya Babulooni, n'ebiweebwayo eby'obuwa abantu ne bakabona bye baliwaayo ku lwa yeekaalu ya Katonda waabwe mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensimbi ezo mulizikozesa okugula ente ennume, n'endiga ennume, n'abaana b'endiga, n'ebiweebwayo byako eby'obutta, n'ebiweebwayo byako ebyokunywa era munaabiweerangayo ku kyoto eky'omu yeekaalu ya Katonda wammwe mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe ne baganda bo Abayudaaya, kye mulisiima okukolamu effeeza ne zaabu erifikkawo kiriva gye muli ng'okusiima kwa Katonda wammwe bwe kuli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byonna ebibaweereddwa okukozesa mu yeekaalu ya Katonda wammwe mubiwangayo olw'okusinza Katonda wa Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ekintu ekirala kyonna kye muliba mwetaaze okukozesa mu yeekaalu ya Katonda wammwe, kinaggyibwanga mu ggwanika lya kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano, nze kabaka Alutagizerugizi nteeka etteeka nga ndagira abawanika bonna abali mu ssaza eriri emitala w'omugga Fulaati okuwanga Ezera kabona era omunnyonnyozi w'amateeka ga Katonda w'eggulu, by'anaabasabanga",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okutuusa ku ttani ssatu n'ekitundu eza ffeeza, oba kilo enkumi bbiri mu bibiri ez'eŋŋaano, oba lita enkumi bbiri mu bibiri ez'envinnyo, oba lita enkumi bbiri mu bibiri ez'amafuta, oba n'omunnyo gwe baliba baagala gwonna.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu kyonna ekyalagirwa Katonda w'eggulu, kiribaweebwa mu bungi, ku lwa yeekaalu ya Katonda w'eggulu. Kale kiki ekirimuleetera okusunguwalira kabaka ne batabani be?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era mutegeere nga temusaana kuwooza musolo, oba empooza ey'engeri yonna ku kabona yenna newaakubadde Abaleevi newaakubadde abayimbi newaakubadde abakuumi ab'oku nzigi newaakubadde abaweereza ab'omu yeekaalu newaakubadde abaddu abalala ab'omu nnyumba ya Katonda eyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
