  "reference": "Yokaana 1",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JHN 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kigambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigambo yaliwo ng'ensi tennatondebwa. Kigambo",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.1",
            "verseOrgIds": [
              "JHN.1.1"
            ]
          }
        },
        {
          "text": "yali ne Katonda, era Kigambo yali Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.1",
            "verseOrgIds": [
              "JHN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo, okuva ku lubereberye yaliwo ne Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.2",
            "verseOrgIds": [
              "JHN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu byonna byatondebwa ku lulwe, era tewaliiwo kintu na kimu ekyatondebwa nga taliiwo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.3",
            "verseOrgIds": [
              "JHN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ye mwe mwali obulamu; era obulamu buno ne buba ekitangaala eri abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.4",
            "verseOrgIds": [
              "JHN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusana ne gwaka mu kizikiza, naye ekizikiza tekyaguyinza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.5",
            "verseOrgIds": [
              "JHN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne walabika omuntu ng'ayitibwa Yokaana, Katonda gwe yatuma,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.6",
            "verseOrgIds": [
              "JHN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyajja okutegeeza abantu ebifa ku musana, bonna bakkirize nga bayita mu ye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.7",
            "verseOrgIds": [
              "JHN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana si ye yali Omusana, wabula ye yatumibwa ategeeze eby'Omusana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.8",
            "verseOrgIds": [
              "JHN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo ye yali Omusana, omusana ogw'amazima, ogujja mu nsi, okwakira buli muntu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka newaakubadde Kigambo oyo ye yatonda ensi, bwe yajja mu nsi, ensi teyamutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.10",
            "verseOrgIds": [
              "JHN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yajja eri abantu be, naye abantu be ne batamusembeza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.11",
            "verseOrgIds": [
              "JHN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bonna abaamusembeza, yabawa obuyinza okufuuka abaana ba Katonda; be bo abakkiriza erinnya lye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.12",
            "verseOrgIds": [
              "JHN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abataazaalibwa musaayi, oba okwagala kw'omubiri, wadde okwagala kw'omuntu, naye abaazaalibwa okwagala kwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigambo n'afuuka omubiri, n'abeera mu ffe, ne tulaba ekitiibwa kye, ng'eky'oyo omu yekka eyava eri kitaffe ng'ajjudde ekisa n'amazima.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana Omubatiza yamwogerako, ng'alangirira nti, \"Ono ye oyo gwe nayogerako nti, 'Waliwo ajja emabega wange, eyansoka okubaawo, kubanga yaliwo nga sinnabaawo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.15",
            "verseOrgIds": [
              "JHN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku kujjula kwe ffenna kwe twagabana ekisa ekisukiridde ekisa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.16",
            "verseOrgIds": [
              "JHN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amateeka gaatuweebwa nga gayita mu Musa, naye Yesu Kristo ye yaaleeta ekisa n'amazima.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.17",
            "verseOrgIds": [
              "JHN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewali n'omu eyali alabye ku Katonda, okuggyako Omwana we omu yekka, abeera mu kifuba kya kitaffe, oyo ye yatutegeeza byonna ebimufaako.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yokaana Omubatiza Ategeeza nga bw'Atali Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bye bigambo Yokaana Omubatiza bye yategeeza abakulembeze b'Abayudaaya bwe baamutumira bakabona n'Abaleevi okuva mu Yerusaalemi ne bamubuuza nti, \"Ggwe ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.19",
            "verseOrgIds": [
              "JHN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teyagaana kubaddamu, wabula yayatulira ddala nti, \"Si nze Kristo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.20",
            "verseOrgIds": [
              "JHN.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamubuuza nti, \"Kale ggwe ani? Ggwe Eriya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "Yokaana Omubatiza n'addamu nti, \"Nedda, si nze ye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "Ne bongera okumubuuza nti, \"Ggwe Nnabbi ayogerwako?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "N'addamu nti, \"Nedda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne bamugamba nti, \"Abatutumye tunaabagamba nti, Ggwe ani? Weeyita otya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.22",
            "verseOrgIds": [
              "JHN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JHN 1:23"
      },
      "items": [
        {
          "text": "\"Nze ndi ddoboozi ly'oyo ayogerera mu ddoboozi ery'omwanguka ng'asinziira mu ddungu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JHN 1:23"
      },
      "items": [
        {
          "text": "'Mutereeze ekkubo lya Mukama mweteekereteekere okujja kwe, nga nnabbi Isaaya bwe yayogera.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaatumibwa baava eri Abafalisaayo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.24",
            "verseOrgIds": [
              "JHN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne babuuza Yokaana nti, \"Kale lwaki obatiza, obanga si ggwe Kristo oba Eriya oba nnabbi oli?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.25",
            "verseOrgIds": [
              "JHN.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana n'addamu nti, \"Nze mbatiza na mazzi, naye waliwo ayimiridde wakati mu mmwe gwe mutamanyi,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.26",
            "verseOrgIds": [
              "JHN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "anvaako emabega, nze sisaanira na kusumulula buguwa bwa ngatto ze.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.27",
            "verseOrgIds": [
              "JHN.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byali Besaniya, emitala w'omugga Yoludaani, Yokaana Omubatiza gye yabatirizanga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Omwana gw'Endiga owa Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwaddirira, Yokaana Omubatiza n'alaba Yesu ng'ajja, n'agamba nti, \"Mulabe Omwana gw'Endiga owa Katonda aggyawo ebibi by'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.29",
            "verseOrgIds": [
              "JHN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye wuuyo gwe nayogerako, bwe nagamba nti, 'Waliwo omuntu anvaako emabega ye ansinga obuyinza, kubanga ye yaliwo nga nze sinnabaawo.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.30",
            "verseOrgIds": [
              "JHN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nange nnali simumanyi, wabula nze najja okubatiza n'amazzi, ndyoke mulage eri abantu ba Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.31",
            "verseOrgIds": [
              "JHN.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yokaana Omubatiza n'abategeeza nga bwe yalaba Mwoyo Mutukuvu ng'akka okuva mu ggulu ng'ali ng'ejjiba n'abeera ku Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.32",
            "verseOrgIds": [
              "JHN.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abagamba nti, \"Nze saamutegeera, kyokka Katonda bwe yantuma okubatiza yaŋŋamba nti, 'Bw'olabanga Mwoyo Mutukuvu ng'akka n'abeera ku muntu, nga oyo, ye Kristo abatiza ne Mwoyo Mutukuvu.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.33",
            "verseOrgIds": [
              "JHN.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nkirabye era nkiweerako obujulirwa nti Ye Mwana wa Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abayigirizwa ba Yesu Abaasooka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ku lunaku olwaddirira nate Yokaana bwe yali ayimiridde n'abayigirizwa be babiri,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.35",
            "verseOrgIds": [
              "JHN.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'ayitawo ng'atambula. Yokaana n'amutunuulira enkaliriza n'agamba nti, \"Mulabe Omwana gw'Endiga wa Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.36",
            "verseOrgIds": [
              "JHN.1.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abayigirizwa abo ababiri bwe baawulira ekyo ne bagoberera Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.37",
            "verseOrgIds": [
              "JHN.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yakyuka n'abalaba nga bamugoberera n'ababuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwagala ki?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.38",
                "verseOrgIds": [
                  "JHN.1.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:38"
      },
      "items": [
        {
          "text": "Ne bamuddamu nti, \"Labbi\" (ekitegeeza nti: \"Omuyigiriza\"), \"obeera wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mujje mulabeyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.39",
                "verseOrgIds": [
                  "JHN.1.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:39"
      },
      "items": [
        {
          "text": "Awo ne bagenda naye gye yali abeera, olunaku olwo ne baluzibiza eyo nga bali naye, obudde bwali ng'essaawa kkumi ez'olweggulo okutuusa akawungeezi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ku abo ababiri abaawulira Yokaana ng'ayogera ne bagoberera Yesu, yali Andereya, muganda wa Simooni Peetero.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.40",
            "verseOrgIds": [
              "JHN.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Andereya n'agenda anoonya muganda we Simooni n'amugamba nti, \"Tulabye Masiya\" (amakulu nti Kristo).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.41",
            "verseOrgIds": [
              "JHN.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andereya n'atwala Simooni eri Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:42"
      },
      "items": [
        {
          "text": "Yesu bwe yeetegereza Simooni, n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ggwe Simooni omwana wa Yokaana, kale onooyitibwanga Keefa,\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.42",
                "verseOrgIds": [
                  "JHN.1.42"
                ]
              }
            }
          ]
        },
        {
          "text": "amakulu nti Peetero.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Ayita Firipo ne Nassanayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwaddirira, Yesu n'agenda e Ggaliraaya, bwe yasanga Firipo n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngoberera.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.43",
                "verseOrgIds": [
                  "JHN.1.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firipo yali wa mu kibuga Besusayida ewaabwe wa Andereya ne Peetero.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.44",
            "verseOrgIds": [
              "JHN.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firipo bwe yalaba Nassanayiri, n'amugamba nti, \"Tulabye Yesu mutabani wa Yusufu ow'e Nazaaleesi, Musa ne bannabbi gwe baawandiikako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.45",
            "verseOrgIds": [
              "JHN.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nassanayiri n'amuddamu nti, \"Mu Nazaaleesi musobola okuvaamu ekintu ekirungi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:46"
      },
      "items": [
        {
          "text": "Firipo kwe kumuddamu nti, \"Jjangu weerabireko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nassanayiri bwe yali asemberera Yesu, Yesu n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Laba, Omuyisirayiri wawu ataliimu bukuusa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.47",
                "verseOrgIds": [
                  "JHN.1.47"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nassanayiri kwe kumuddamu nti, \"Ontegedde otya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:48"
      },
      "items": [
        {
          "text": "Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Firipo bw'abadde tannakutuukako, nkulabye ng'oli wansi w'omutiini.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.48",
                "verseOrgIds": [
                  "JHN.1.48"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nassanayiri n'amuddamu nti, \"Labbi, oli Mwana wa Katonda, gwe Kabaka wa Isirayiri!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.49",
            "verseOrgIds": [
              "JHN.1.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Okkiriza kubanga nkugambye nti nkulabye ng'oli wansi w'omutiini? Oliraba n'ebisinga awo obukulu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.50",
                "verseOrgIds": [
                  "JHN.1.50"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala nkugamba nti oliraba eggulu nga libikkuse ne bamalayika ba Katonda nga balinnya era nga bakkira ku Mwana w'Omuntu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.51",
                "verseOrgIds": [
                  "JHN.1.51"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
