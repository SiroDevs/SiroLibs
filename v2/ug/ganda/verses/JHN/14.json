{
  "id": "JHN.14",
  "number": "14",
  "bookId": "JHN",
  "reference": "Yokaana 14",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JHN 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Agumya Abayigirizwa be",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omutima gwammwe tegweraliikiriranga. Mukkiriza Katonda, era nange munzikirize.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.1",
                "verseOrgIds": [
                  "JHN.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu nnyumba ya Kitange mulimu ebisenge bingi, era ŋŋenda okubateekerateekera ekifo. Singa tekiri bwe kityo nandibagambye.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.2",
                "verseOrgIds": [
                  "JHN.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe ndimala okubateekerateekera ekifo ndikomawo, ne mbatwala gye ndi, Nze gye ndi nammwe gye muba mubeera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.3",
                "verseOrgIds": [
                  "JHN.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era gye ŋŋenda ekkubo mulimanyi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.4",
                "verseOrgIds": [
                  "JHN.14.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ly'Ekkubo Erituusa Abantu eri Kitaawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomasi n'amugamba nti, \"Mukama waffe, tetumanyi gy'olaga, kale tuyinza tutya okumanya ekkubo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nze kkubo, n'amazima n'obulamu. Tewali n'omu ajja eri Kitange wabula ng'ayita mu Nze.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.6",
                "verseOrgIds": [
                  "JHN.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Singa muntegedde ne Kitange mwandimutegedde. Era okuva kaakano mumulabye era mumutegedde.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.7",
                "verseOrgIds": [
                  "JHN.14.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firipo n'amugamba nti, \"Mukama waffe, tulage Kitaffe, kinaatumala.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.8",
            "verseOrgIds": [
              "JHN.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Firipo, kasookedde mbeera nammwe ebbanga lino lyonna era tontegeeranga? Buli alaba Nze aba alabye Kitange! Kale lwaki ate oyogera nti, 'Tulage Kitaffe?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.9",
                "verseOrgIds": [
                  "JHN.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tokkiriza nga Nze ndi mu Kitange era ne Kitange ali mu Nze? Ebigambo bye mbategeeza si byange ku bwange, wabula biva eri Kitange abeera mu Nze, era akola emirimu ng'ayita mu Nze.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.10",
                "verseOrgIds": [
                  "JHN.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.10",
            "verseOrgIds": [
              "JHN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale munzikirize nti ndi mu Kitange era nga ne Kitange ali mu Nze. Oba si ekyo munzikirize olw'emirimu gyokka.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.11",
                "verseOrgIds": [
                  "JHN.14.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ddala ddala mbagamba nti buli anzikiriza alikola emirimu egyo gye nkola, era alikola egisinga egyo, kubanga Nze ŋŋenda eri Kitange.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.12",
                "verseOrgIds": [
                  "JHN.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.12",
            "verseOrgIds": [
              "JHN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era buli kye munaasabanga mu linnya Lyange nnaakibakoleranga, Kitange alyoke agulumizibwe mu Mwana.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.13",
                "verseOrgIds": [
                  "JHN.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.13",
            "verseOrgIds": [
              "JHN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe munaasabanga ekintu kyonna mu linnya lyange nnaakikolanga.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.14",
                "verseOrgIds": [
                  "JHN.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusuubizibwa Mwoyo Mutukuvu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kale obanga munjagala mugonderenga ebiragiro byange,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.15",
                "verseOrgIds": [
                  "JHN.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.15",
            "verseOrgIds": [
              "JHN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nange ndisaba Kitange n'abawa Omubeezi omulala anaabeeranga nammwe emirembe n'emirembe,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.16",
                "verseOrgIds": [
                  "JHN.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.16",
            "verseOrgIds": [
              "JHN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mwoyo ow'Amazima ensi gwe teyinza kufuna, kubanga temulaba era temumanyi. Naye mmwe mumumanyi kubanga abeera nammwe, era anaabeeranga mu mmwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.17",
                "verseOrgIds": [
                  "JHN.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.17",
            "verseOrgIds": [
              "JHN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Siribaleka nga bamulekwa, ndikomawo gye muli.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.18",
                "verseOrgIds": [
                  "JHN.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.18",
            "verseOrgIds": [
              "JHN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu bbanga ttono, ensi eneeba tekyandaba, naye mmwe nga mundaba. Kubanga Nze ndi mulamu, era nammwe muliba balamu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.19",
                "verseOrgIds": [
                  "JHN.14.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.19",
            "verseOrgIds": [
              "JHN.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ku lunaku olwo mulitegeera nga Nze ndi mu Kitange, era nga muli mu Nze, nga nange ndi mu mmwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.20",
                "verseOrgIds": [
                  "JHN.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.20",
            "verseOrgIds": [
              "JHN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buli anjagala anaagonderanga ebiragiro byange; era kubanga anjagala, ne Kitange anaamwagalanga. Era nange nnaamwagalanga, era nnaamulabikiranga.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.21",
                "verseOrgIds": [
                  "JHN.14.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, atali Isukalyoti n'amugamba nti, \"Mukama waffe, lwaki oyagala okweraga eri ffe so si eri ensi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.22",
            "verseOrgIds": [
              "JHN.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omuntu yenna anjagala anaagonderanga ekigambo kyange, ne Kitange anaamwagalanga, era Nze ne Kitange tunajjanga ne tubeera mu ye era tunaatuulanga mu ye.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.23",
                "verseOrgIds": [
                  "JHN.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oyo atanjagala tagondera bigambo byange. Ate ebigambo bye njogera si byange ku bwange wabula bya Kitange eyantuma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.24",
                "verseOrgIds": [
                  "JHN.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.24",
            "verseOrgIds": [
              "JHN.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ebyo mbibabuulidde nga nkyali nammwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.25",
                "verseOrgIds": [
                  "JHN.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.25",
            "verseOrgIds": [
              "JHN.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye Omubeezi, Mwoyo Mutukuvu, Kitange gw'alituma mu linnya lyange, bw'alijja alibayigiriza ebintu byonna era alibajjukiza byonna bye nabagamba.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.26",
                "verseOrgIds": [
                  "JHN.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.26",
            "verseOrgIds": [
              "JHN.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbalekera emirembe, era mbawa emirembe gyange. Emirembe gye mbawa tegiringa egy'ensi. Noolwekyo temutyanga era temweraliikiriranga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.27",
                "verseOrgIds": [
                  "JHN.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mujjukire kye n'abagamba nti ŋŋenda era ndikomawo gye muli. Singa ddala mubadde munjagala mwandisanyuse kubanga ŋŋenda eri Kitange, kubanga Kitange y'ansinga ekitiibwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.28",
                "verseOrgIds": [
                  "JHN.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.28",
            "verseOrgIds": [
              "JHN.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kaakano mbabuulidde ebintu bino nga tebinnabaawo, bwe birituukirira mulyoke munzikirize.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.29",
                "verseOrgIds": [
                  "JHN.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.29",
            "verseOrgIds": [
              "JHN.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sikyayogera bintu bingi nammwe, kubanga omufuzi omubi ow'ensi eno ajja. Naye Nze tanninaako buyinza.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.30",
                "verseOrgIds": [
                  "JHN.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.30",
            "verseOrgIds": [
              "JHN.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kyokka ensi eryoke emanye nti njagala Kitange, nzija kukola Kitange ky'andagidde.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.31",
                "verseOrgIds": [
                  "JHN.14.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
