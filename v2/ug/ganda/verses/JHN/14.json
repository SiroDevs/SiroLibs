        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Musituke tuve wano.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.31",
                "verseOrgIds": [
                  "JHN.14.31"
                ]
              }
