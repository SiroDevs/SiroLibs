  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "LUK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yokaana Omubatiza Alongoosa Ekkubo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'ekkumi n'ettaano ogw'okufuga kwa Kayisaali Tiberiyo, Pontiyo Piraato bwe yali nga ye gavana wa Buyudaaya, Kerode nga y'afuga Ggaliraaya, muganda we Firipo nga y'afuga Italiya ne Tirakoniti, ne Lusaniya nga y'afuga Abireene,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ne Kayaafa nga be Bakabona Abasinga Obukulu, Yokaana, mutabani wa Zaakaliya ng'ali mu ddungu, n'afuna obubaka obuva eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana n'atambulanga ng'agenda abuulira mu bitundu ebyetoolodde Yoludaani, ng'ategeeza abantu obubaka obw'okubatizibwa obw'okwenenya olw'okusonyiyibwa ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.3",
            "verseOrgIds": [
              "LUK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga bwe kyawandiikibwa mu kitabo eky'ebigambo bya nnabbi Isaaya nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "\"Eddoboozi ly'oyo ayogerera mu ddungu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "Mulongoose ekkubo lya Mukama,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "Muluŋŋamye amakubo ge;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kiwonvu kirijjuzibwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "na buli lusozi n'akasozi birisendebwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "na buli ekyakyama kirigololwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "n'obukubo obulimu obugulumugulumu bulifuuka enguudo ez'omuseetwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalina omubiri bonna baliraba obulokozi bwa Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.6",
            "verseOrgIds": [
              "LUK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyeyava agamba abantu abajjanga gy'ali okubatizibwa nti, \"Mmwe abaana b'emisota, ani eyabalabula okudduka obusungu obugenda okujja?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale mubale ebibala ebiraga nga mwenenyezza, so temwogera munda zammwe nti tulina jjajjaffe Ibulayimu. Kubanga mbagamba nti Katonda asobola, mu mayinja gano, okuggyiramu Ibulayimu abazzukulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kaakano embazzi eteekeddwa ku kikolo ky'emiti. Noolwekyo buli muti ogutabala bibala birungi gujja kutemebwawo gusuulibwe mu muliro.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibiina ne kimumubuuza nti, \"Kale tukole ki?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana n'abaddamu ng'agamba nti, \"Alina ekkooti ebbiri, emu agigabire atalina, n'oyo alina emmere aweeko oyo atalina kyakulya.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abasolooza b'omusolo nabo, ne bajja babatizibwe. Ne babuuza Yokaana nti, \"Omuyigiriza tukole ki?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana n'abaddamu nti, \"Temusoloozanga muwendo gusukka ku ogwo ogwalagibwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaserikale nabo ne babuuza Yokaana nti, \"Ate ffe, tukole tutya?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 3:14"
      },
      "items": [
        {
          "text": "Yokaana n'abagamba nti, \"Temuggyangako bantu nsimbi zaabwe. So temubawaayirizanga, n'empeera ebaweebwa ebamalenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baali balindirira nga basuubira, era nga buli muntu yeebuuza obanga Yokaana ye Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana n'addamu bonna ng'agamba nti, \"Nze mbabatiza na mazzi, naye waliwo ajja, alina obuyinza okunsinga, n'okusaanira sisaanira na kusumulula lukoba lwa ngatto ze. Oyo alibabatiza n'omuliro ne Mwoyo Mutukuvu;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'olugali luli mu mukono gwe okulongoosa egguuliro lye n'okukuŋŋaanyiza eŋŋaano mu tterekero lye, naye ebisusunku alibyokya n'omuliro ogutazikira.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana n'abuulirira abantu ebigambo bingi ebirala, nga bw'ababuulira Enjiri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yokaana bwe yanenya Kerode, omufuzi, olw'okutwala Kerodiya eyali muka muganda we, n'olw'ebibi ebirala Kerode bye yali akoze,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate ku ebyo byonna Kerode n'ayongerako na kino: n'akwata Yokaana n'amuggalira mu kkomera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okubatizibwa kwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku lumu, abantu bonna abaaliwo nga babatizibwa, ne Yesu n'abatizibwa. Yesu n'asaba, eggulu ne libikkuka,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo Mutukuvu n'amukkako mu kifaananyi eky'ejjiba. Eddoboozi ne liva mu ggulu ne ligamba nti, \"Ggwe Mwana wange omwagalwa gwe nsanyukira ennyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olulyo lwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yali awezezza emyaka ng'amakumi asatu bwe yatandika omulimu gwe. Yesu nga bwe kyalowoozebwa, yali mwana wa Yusufu:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "LUK 3:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "LUK 3:23"
      },
      "items": [
        {
          "text": "ne Yusufu nga mwana wa Eri,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
