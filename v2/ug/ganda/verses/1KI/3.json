              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnyina w'omwana omulamu n'ajjula ennaku olw'omwana we, n'agamba kabaka nti, \"Nkwegayiridde mukama wange, omwana omulamu mumuwe! Tomutta!\" Naye omukazi oli n'agamba nti, \"Tajja kuba wange oba wuwo. Mumusalemu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
