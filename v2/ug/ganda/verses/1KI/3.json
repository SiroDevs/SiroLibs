              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'asalawo ng'agamba nti, \"Omwana omulamu mumuwe omukazi ow'olubereberye, so temumutta, kubanga oyo ye nnyina.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
