    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yekoyakini kabaka wa Yuda nga yakamala emyaka amakumi asatu mu musanvu mu buwaŋŋanguse mu busibe, nga Evirumerodaki kyajje afuuke kabaka w'e Babulooni, Evirumerodaki n'ata Yekoyakini kabaka wa Yuda okuva mu kkomera ku lunaku olw'amakumi abiri mu omusanvu mu mwezi ogw'ekkumi n'ebiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayogera naye ebigambo ebyekisa, n'amuwa n'ekitiibwa ekya waggulu okusinga ne bakabaka abalala abaali awamu naye mu buwaŋŋanguse mu busibe e Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yekoyakini n'aggyamu ebyambalo bye eby'ekkomera n'aliiranga wamu ne kabaka w'e Babulooni ku mmeeza ya kabaka ennaku zonna ez'obulamu bwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'awanga Yekoyakini omugabo ogwa buli lunaku ennaku zonna ez'obulamu bwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
