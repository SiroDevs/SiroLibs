            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.18"
              },
              "items": [
                {
                  "text": "Dan 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedaunia ŋesi atemar eoŋ kwape ejaatar akiro ŋun, ketulur akakonye, kelilin, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.15",
            "verseOrgIds": [
              "DAN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.7"
              },
              "items": [
                {
                  "text": "Isa 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.9"
              },
              "items": [
                {
                  "text": "Yer 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, abu ediopet loeputos kwape idwe luka ituŋa kotiro aitukuka; kasodi kaoon akakituk, kener, kabala ŋol loabwoi kakonyeneka ebe, “Wu ekaiakait, kanuka aitapoet kabonok eoŋ ariebo kodaun agogoŋ; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.16",
            "verseOrgIds": [
              "DAN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai ikoni epedori ai ekejaanakinan loka ejakaitika lo einer kejakaitika lo? Naarai kanukan, atipet kodaun agogoŋuka, mam da abu kosal eiyeŋane kotomaka.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.17",
            "verseOrgIds": [
              "DAN.10.17"
            ]
          }
        }
      ]
    },
