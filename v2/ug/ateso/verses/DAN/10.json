          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi abu ediopet loesubit bala etuŋanan katiro bobo, ketogogon ŋesi eoŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.18",
