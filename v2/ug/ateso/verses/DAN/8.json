          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.20"
              },
              "items": [
                {
                  "text": "Yob 34:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.6"
              },
              "items": [
                {
                  "text": "Aku 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kanuka apirianutuke itekeriani aimod kakanike; itopolooro bon kotauke, eturiaikin amudiar luipu: ebwoikini da asurokin ekapolon loka ikapolok; konye ebilio komam akan. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.25",
            "verseOrgIds": [
              "DAN.8.25"
            ]
          }
        },
