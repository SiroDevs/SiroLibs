              "items": [
                {
                  "text": "2 Sam 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kepuput ituŋa akiro ŋun nueroko, kitururwoto; komamuun ituŋanan yenisirit akekuan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.23"
              },
              "items": [
                {
                  "text": "Sab 139:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT Musa atiar, “Kolimok idwe luka Isirael ebe, ‘Iraas yesi lueninik imurisiŋa: arai kiupakin eoŋ kayes karaida apak naedit noi, kamudiari eoŋ yes: asa do kolaca luisirito, kasodi konyet ajenun nukeswamakini yes.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolacasi idwe luka Isirael luesirito kesi ageun komoru Koreb kaiyatakin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
    },
