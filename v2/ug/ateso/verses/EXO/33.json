              "items": [
                {
                  "text": "2 Sam 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ayananari Musa ewema asiponokin kina kiidukurun; kolwanikina koidukurun; komaik Ewema loka airiamunun. Kosodi ŋinituŋanan yenekoto EJAKAIT alosenen owema laka airiamunun, loajai kina kiidukurun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
