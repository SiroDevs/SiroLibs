            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT Musa atiar, “Konyoutu koloto kane, ijo ka ituŋa lukitolomuni kakwap nako Misiri, kolomasi yesi akwap nakolo esiyapokinit eoŋ Aburaam, ka Isaak, ka Yakob ebe,, Ainakini akoniwur.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
