              "items": [
                {
                  "text": "1 Yok 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kiswamau akalaya naka aisinit, ka aigaŋeteke naka aisinit, naka aroeta nuka aŋor kanuejaanakinete kokek loka ewema loka airiamunun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
