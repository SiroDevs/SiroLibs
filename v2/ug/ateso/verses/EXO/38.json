            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋininnjanan ebeka, ŋes atutubet naka esekel, kwape ajaar esekel loka aibois nakalaunan, kanuka ŋinitunanan yenabu kotubor mama ejaas luemarar, ageun kaluka ikar akaisaarei ka luedeparito, kes ituŋa ilukumin akwat akanykape ka ilukumin iuni, ka akwat akany ka akaisakany, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
