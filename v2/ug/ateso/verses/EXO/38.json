            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Araas atalatan akwatat nuka epuesa nutataunct aigaŋeta nuka aibois nakalaunan, ka aigaŋcta nuka aigalisit; aigaŋeta akwatat nuka atalatan akwatat, atalata kanuka aigaŋet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
