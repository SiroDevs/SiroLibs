            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Korio Musa akekan akuj; kojaun amuton naejesi cucucuc akwap kere nako Misiri apaarasia auni; ",
          "type": "text",
          "attrs": {
