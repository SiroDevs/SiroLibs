        },
        {
          "text": " Kotema EJAKAIT Musa atiar, “Koloma mama ejai Parao: naarai etininik eketau, ka itauon da luka ikekejaanakinak, tetere etoduni aanyunetaka nu kamakec: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
