                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.1"
              },
              "items": [
                {
                  "text": "Sab 44:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.18"
              },
              "items": [
                {
                  "text": "71:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.3"
              },
              "items": [
                {
                  "text": "Yok 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tetere ilimokini aki nuka okokukon, ka ikoku yenika ikokukon, akiro nueswamak eoŋ Misiri, ka aanyunetaka nueswama kamakec; tetere ijenunete ebe Eoŋ EJAKAIT.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.29"
              },
              "items": [
                {
                  "text": "1 Ika 21:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
