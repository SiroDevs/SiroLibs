              "items": [
                {
                  "text": "Any 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT Musa atiar, “Korio akonikan akwap nako Misiri kanuka emaase, tetere ebuni akwap nako Misiri, anyamar nolikiot loka akwap, kes kere luabu akaka kideu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korio Musa ekebela akwap nako Misiri, kitukut EJAKAIT ekwam lokokide toma akwap apaaran ŋin kere, ka akuare kere; kiwala akwap koyau ekwam lokokide emaase. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
