              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Naisidoenenoto aŋor Nuburanian, kianyutu idounete; arai erai ikoku yenitelepat, iarete; konye arai erai yenipese, ejari.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.16",
            "verseOrgIds": [
