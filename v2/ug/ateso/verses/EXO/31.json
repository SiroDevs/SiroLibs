              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun idarete idwe luka Isirael asabato aricit asabato anatar aturiokec, araun aitutuket namam enaŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
