            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iswamao aswam apaarasia akanykape: konye apaaran nakikanyetekaarei erai nakasabato naka aibworar, nakalaunan naka EJAKAIT: ijinitunanan yeniswamai adioswam kapaaran nakasabato, abeit eario. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
