            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai naekoto Edeke ŋes nata, aitalauniokus: kinacata adoteu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
