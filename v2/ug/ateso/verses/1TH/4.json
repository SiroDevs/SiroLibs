          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ijenete kwape ejaatar aicorakineta nukipou kainakis yes kanuka Ejakait Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
