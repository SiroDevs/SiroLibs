            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye do oni kirai luka apaaran, kenyeis amer, kanapa yenikatorob yenika aiyuun ka amin, akopira da korai amun naka aitajario. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
