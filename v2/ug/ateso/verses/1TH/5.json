          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "koyoŋito kes noi kamin kanuka aswamukec, Kojaas kainapakina kotomakus, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
