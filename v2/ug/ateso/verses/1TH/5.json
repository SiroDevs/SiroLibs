            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam Edeke kibwaikinit oni kanuka anyunyura, dimarai adumun aitajario kanuka Ejakaitiwok Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
