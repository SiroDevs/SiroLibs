            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " loabu kotwanik oni tetere kijari nepepe kaŋes, arai kikwenyi, arai bo kijotoi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
