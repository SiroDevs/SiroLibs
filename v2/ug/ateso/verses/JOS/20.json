              "items": [
                {
                  "text": "Yer 38:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekereari ore ediopet koreria kanul, ebwoi korute loka ere, kosodi alimokin imakio luka ere kanol akekiro; itolomarete kesi ŋes ore mamakee, einakinete ŋes aibois, tetere iboikin mamakec. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
