        },
        {
          "text": "“Kolimok idwe luka Isirael ebe, Koseutu yesi ireria lukuianara, luabu kalimok yes kama ka Musa: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tetere ikaaran yeneari ituŋanan komam epeleikinit, komam ejeŋi da, ekereari nina: eraunos kamakus luikuianarete kaneejai ekenyaŋaran aokot. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
