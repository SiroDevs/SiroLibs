              "items": [
                {
                  "text": "Mar 35:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iboikin ore ŋol aitodol naebwoia atubokinio kakonyen nuka ekodet, aitodol da naetwania esasedoti lopeti lokejai kapaarasia kanun: ŋes konyet ebonunio ekaaran, ebunio da oreke, togoke, ore Ioakerca.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
