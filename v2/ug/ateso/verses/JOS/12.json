              "items": [
                {
                  "text": "Ikis 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.20"
              },
              "items": [
                {
                  "text": "Yos 13:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka Araba kiton aŋolol naka Kinerot, kari nakokide, ido kiton aŋolol naka Araba, ŋes aŋolol naka Abalaŋ, kari nakokide, orot loebei Bet-yesimot; ari da naka eŋalakimak, kwap neiiululuoro Pisiga: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
