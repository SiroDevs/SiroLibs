              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekabaka loka Yerusalem, ediopet; ekabaka loka Keburon, ediopet; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
