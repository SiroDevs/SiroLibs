                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu Musa ekejaanakinan Ioka EJAKAIT ka idwe luka Isirael kodanyata kes: koinak da Musa ekeiaanakinan loka EJAKAIT akwap nin araun airumet naka Ireubcnin, ka Igadin, ka atutubet naka ateker naka Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
