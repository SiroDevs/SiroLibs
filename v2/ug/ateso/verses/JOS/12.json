                {
                  "text": "Ikis 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eikor da loka Og ekabaka loka Basan, loka luedeuna luka Irepaim, loeboie koAsitarot ka Ederei, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        },
