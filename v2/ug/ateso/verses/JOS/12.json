        },
        {
          "text": " Lu kes ikabakan luka akwap, luapotu idwe luka lsirael kodanyata, kirumata akeeekwap kokekwa loka Yorodan kama eniunia akoloŋ, ageun kaditot naka Arunon kiton moru Kerumon, ka Araba kere kari nakokidc: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikon ekabaka loka lmorain, loeboie koKesibon, koyaite ageun koAroer, loejai osiep loka aditot naka Arunon, ka ere loejai kidiŋ aditot, ka atutubet naka Gilead, kiton ocor Yabok, eikor loka idwe luka Amon; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.17"
