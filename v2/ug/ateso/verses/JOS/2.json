              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kilimo ijo akosikiro nu, emamuunete do nukibeikinete sio kanuka aiyapositikon nakisiyapo sio.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
