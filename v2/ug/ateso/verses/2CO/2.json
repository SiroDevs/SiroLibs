          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kimalai Edeke lokisipikonori tir kotoma Kristo, ido loitodiari aures naka aijen ŋes kaŋiniibois kotomakosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.18"
              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kirai isio asakat naka Kristo kama ejai Edeke, kotoma kaŋul kaluitaiario, kaŋul da lueoliorito, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
