            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.34"
              },
              "items": [
                {
                  "text": "Luk 2:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mama ejaas lukiareit, aures naka atwanare naeyauni atwanare, konye mama ejaas ŋul lusodit aures naka aijar naeyauni aijar. Iŋai kereka ilosikino ŋun? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
