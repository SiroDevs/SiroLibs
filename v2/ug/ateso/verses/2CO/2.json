        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.1"
              },
              "items": [
                {
                  "text": "1 Kor 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai itakadikinit ituŋanan, mam ketakadikinit eoŋ bon, dimarai yes kere nepetai, kenyek ainuar. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.5",
            "verseOrgIds": [
              "2CO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilosikino aiticanet ŋin yenikoni nen naedumuni kama ejaas luipu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.6",
            "verseOrgIds": [
              "2CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋes ibusakinitor yes gwai aitim ka aitalakar ituŋanan yenikoni nen, kinyek diat yenikoni nen ailikorio kotoma akadakinike naedeparit. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.7",
            "verseOrgIds": [
              "2CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun keŋaiŋait yes aitogogoŋ amin kamakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.8",
            "verseOrgIds": [
              "2CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.15"
              },
              "items": [
                {
                  "text": "2 Kor 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai abu kewadik kanuka ŋun, tetere ketemi yes, wolo bo irimasi kotoma akiro kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.9",
            "verseOrgIds": [
              "2CO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.16"
              },
              "items": [
                {
                  "text": "Luk 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai isioniete ituŋanan akirot kere, eoŋ da esioniei ŋes. Naarai arai esionit ituŋanan akirot, esionit kanukus, kakonyen nuka Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.10",
            "verseOrgIds": [
              "2CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.31"
              },
              "items": [
                {
                  "text": "Luk 22:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kinye Satan aipikor oni; naarai mam kiswakit aijen iboteike.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
            "verseOrgIds": [
              "2CO.2.11"
            ]
          }
        }
