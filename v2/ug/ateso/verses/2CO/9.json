              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam epuda aiwadikakin yes nuka aijaanakin lukalaunak. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.1",
            "verseOrgIds": [
              "2CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ajeni akusikapakina naaolobobotor kanukus mama ejaas Imakedonian, ebe etemokino Akaia ameun kokaru kaje; abu akukuranutukus da kisidik luipu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.2",
            "verseOrgIds": [
              "2CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye ejuku iinacan kinyek aolobobotekosi kanukus araun atitai kakirot kaŋin, tetere itemokino yesi, kwape abu kenerar; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.3",
            "verseOrgIds": [
              "2CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kosodete arai epote Imakedonian nepepe keoŋ kodumut da yes mam itemokino, kinyeis ilek airum sio, komam kinera yes da, kamuno kaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.4",
            "verseOrgIds": [
              "2CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso abu kaomit ebe kebusakinit aicor iinacan koliŋa aponare mamakus, kogeut kesi aitemokin arereŋ ŋin naipotu kisumunoto, tetere etemokin, mere kwape naitelemunitai kwabo nakarereŋ,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.5",
            "verseOrgIds": [
              "2CO.9.5"
            ]
          }
        }
      ]
    },
