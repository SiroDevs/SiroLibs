              },
              "items": [
                {
                  "text": "1 Tim 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na ŋes irwan nakiwuniet naabunio mamakus. Itogogoŋio ŋinikirot kaituke nuka ikajenak iarei arai iuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kekwenya ŋul kere luadiakasi sek, ka luce kere da, ido ekwenyari kes kwana naamamear, kwape nakijaar kayes nakiareit, ebe arai abuni bobo mam etimi kes, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai imootos naitogogoŋi ebe inera Kristo kotomakaŋ. Mam ŋes ekalanyana, konye lokapedor kotomakus. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.7"
              },
              "items": [
                {
                  "text": "Pil 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aponi kibubukinoi kotoma akalanyanut, konye ejari kotoma apedor naka Edeke, Naarai kikalanyaka isio kotomakeŋ, konye kijari nepepe kaŋes toma apedor naka Edeke mamakus.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        }
      ]
    },
    {
