              "attrs": {
                "loc": "ROM.15.33"
              },
              "items": [
                {
                  "text": "Rom 15:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nukawasia, iinacan, yoga do. Kitodolikinos, kitalakanaros, koomitos adiopekirot, kinapakinos, kosodi ejaun Edeke loka amin ka ainapakin kayes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.20"
              },
              "items": [
                {
                  "text": "1 Kor 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyoganakinos kainu nakalaunan. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyogaete yes Iukalaunak kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asianut naka Ejakait Yesu Kristo, ka amin naka Edeke, ka eidicane loka Emoyo Lokalaunan, kojai kayes kere.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
            "verseOrgIds": [
              "2CO.13.14"
            ]
          }
        }
      ]
