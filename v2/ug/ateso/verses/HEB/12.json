                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso naarai kilukunit oni kere elisina loepol loetia nen, loka ikajenak, kalacasi ŋinibore kere yenelaŋir; adiakar da naepatanikinit aigogo leonor oni, kaboloboloto katitiŋ epeget loibwaikinitai kakonyenewok, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.1",
            "verseOrgIds": [
              "HEB.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
