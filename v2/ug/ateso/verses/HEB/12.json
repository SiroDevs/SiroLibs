                  "text": "Any 19:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam apotu kopedosi atitiŋikin akirot naecorakinio ebe, “Arai ketiro itiaŋ emoru ŋol ibiribirio kamor.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
            "verseOrgIds": [
              "HEB.12.20"
            ]
