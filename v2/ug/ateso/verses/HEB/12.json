                  "text": "Asw 8:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyanasi ebe emamei yeneolikinit asianut naka Edeke; kinyek “Aliasit naka adwaris” alibun ka aitican yes, kosodete luipu amunaar; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.29+GEN.25.30+GEN.25.31+GEN.25.32+GEN.25.33+GEN.25.34"
