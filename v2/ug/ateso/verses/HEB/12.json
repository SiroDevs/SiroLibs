            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupata ainapakin nepepe kituŋa kere, ka alaunite da, neemamea ŋin emamei yeneanyuni Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
