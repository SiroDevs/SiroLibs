          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Age 27:30-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ijenete ebe akaulo kaŋun, naakotor airum arereŋ, aponi kogiroi, naarai mam abu kodum apak naka aitoronikin, karaida abu komoote noi kakiyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
