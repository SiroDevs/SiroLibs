              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun koriosi yesi akusikanin nuekalanyaka, kitogogoŋoto da akusikuŋin nuilejekekas, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
