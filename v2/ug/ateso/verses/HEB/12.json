            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka aruo naka arupepe, ka eporoto loka akiro, luapupete apotu kiŋaiŋaata sirikelimokin kes bobo acekirot. ",
          "type": "text",
          "attrs": {
