          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun naarai kidumuni ajakanut namam itamaranio, kajaas kasianut, nakijaanakinia Edeke aijaanakin naitoiokit ŋesi, nepepe kayoŋit ka acoit; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
