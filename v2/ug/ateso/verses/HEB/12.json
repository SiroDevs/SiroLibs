              "items": [
                {
                  "text": "Age 25:29-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kinyek idiotuŋanan araun yenidote arai yenimam eyonit Edeke kwape Esau, loabu kogwela apolouke naka ekiyai kanuka adutunet adiopet naka inyamat. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
