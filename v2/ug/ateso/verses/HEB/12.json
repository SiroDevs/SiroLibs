                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiswamakis akusikejen irotin luitenara, kinyek yenenwalit aitapaario, konye gwai kitaŋaleunoi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
