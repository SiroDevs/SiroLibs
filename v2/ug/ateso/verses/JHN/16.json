              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.21"
              },
              "items": [
                {
                  "text": "Yok 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai Papa elopet kimina yes, naarai kiminasi yesi eoŋ, ido iyuunito ebe abu kabu kama ejai Papa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kabu kama ejai Papa, kabu toma akwapin; bobo da enyeini akwapin, alosi mama ejai Papa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
