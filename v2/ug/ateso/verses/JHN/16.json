              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi ikekesisiak atiar, “Kwana do inera kaitebeikin, kwabo mam bobo inera kawaragan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
