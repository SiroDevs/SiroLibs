                "loc": "JHN.7.33"
              },
              "items": [
                {
                  "text": "Yok 7:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam abu kalimok yes nu ameun kageunet, naarai ajai nepepe kayes. “Konye kwana alosi mama ejai je lokejukunit; emamei edio kayesi lokeŋisi ebe, ‘Ilosi bo ai?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye naarai kalimokis yes akiro nu, elelebunos ican otauonokus, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.16"
              },
              "items": [
                {
                  "text": "Yok 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye eoŋ kalimokini yes abeit; ejok kamakus arai kalot eoŋ, naarai arai mam alosi mam ebuni Ekayuunan mama ijaas; konye arai alosi ejukuni ŋes mamakus. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.24"
              },
              "items": [
                {
                  "text": "1 Kor 14:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.12"
              },
              "items": [
                {
                  "text": "Bur 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kebu ŋol, ilepilepi ŋesi akwapin kanuka aronis ka adolit, ka etube da, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.18"
              },
              "items": [
                {
                  "text": "Yok 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.18"
              },
              "items": [
                {
                  "text": "Rom 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aronis, naarai mam keyuunito eoŋ; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.31"
              },
              "items": [
                {
                  "text": "Asw 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.25"
              },
              "items": [
                {
                  "text": "Rom 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " adolit, naarai alosi mama ejai Papa, mam bobo kianyunete; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
