          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaaran kaŋin ilipete kokirorika; kwabo mam kabala ebe eoŋ kelipakini yes kama ejai Papa; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
