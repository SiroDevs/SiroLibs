                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijeni do kwana ebe ijeni akiro kere, mam bobo ipuda ituŋanan aiŋit jo; kanuka ŋun kiyuunit ebe ibu kobu kama ejai Edeke.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
