                  "text": "Yok 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiton kwana mam ipotu kilipata akirot kokirorika; kilipa, idumunete tetere itodolikin akusiilel.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
