              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.31"
              },
              "items": [
                {
                  "text": "Yok 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.30"
              },
              "items": [
                {
                  "text": "14:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka etube da, naarai adaun lokapolon loka akwapin kanu atubokinio.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        }
      ]
