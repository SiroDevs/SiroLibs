        },
        {
          "text": " “Abu kalimok yes akiro nu, kinyeis aitiguikinio, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
