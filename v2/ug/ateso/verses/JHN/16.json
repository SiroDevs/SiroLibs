              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Yesu kes ebe, “Aso iyuunito do kwana? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
