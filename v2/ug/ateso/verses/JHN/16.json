                  "text": "Mk 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran kaŋin mam kiŋisete eoŋ adiokirot. Abeit, abeit, katemari yes atiar, Arai kilipa Papa akirot kere kiinakini kokirorika. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
