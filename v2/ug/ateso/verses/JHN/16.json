                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Enera eoŋ ŋun kayes kawaragasia; konye ebunit esawa lomam kinerar bobo kayes kawaragasia, konye kalimokinete kaitebeikin nuka Papa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
