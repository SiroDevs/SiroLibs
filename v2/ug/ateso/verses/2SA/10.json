                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyaŋa do Kanun ikejaanakinak luka Daudi, kobaren atutubet naka ipenekakec, kotuboto ikecenapen kokidiŋ, kiton oosikec, kotwara kes. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kelimokin Daudi ŋun, kijuka airiamakin kakes; naarai eleicikinito noi ituŋa, Kotema ekabaka atiar, “Kopaikis Yeriko aitodol neecekuniata ipenekakus, kosodete konyet aboŋun,”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
