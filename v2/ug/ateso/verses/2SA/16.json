          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kedol Kusai Earikit opapero loka Daudi mama ejai Abisalom, kotema Kusai Abisalom atiar, “Kidar Edeke ekabaka, kidar Edeke ekabaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
              "2SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
