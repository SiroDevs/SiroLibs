          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiner Simei kwana ilami ebe, “Irwa, irwa, ijo etuŋanan loka aokot, etuŋanan da loka Belial: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
