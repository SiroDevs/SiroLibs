          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu Abisalom, ka ituŋa kere ikiliok luka Isirael Yerusalem, ka Akitopel da kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
            "verseOrgIds": [
