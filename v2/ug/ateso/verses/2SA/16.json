          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibiribir ŋesi Daudi kamor, ka ikejaanakinak kere luka ekabaka Daudi; kojaas da ituŋa kere ka ikiliok lukagogoŋ kakanike nakoteten ka nakokediany. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
