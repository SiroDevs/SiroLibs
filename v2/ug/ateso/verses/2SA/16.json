                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kopesikis Abisalom ewema kuju togo; koloma Abisalom mama ejaas abusian nuka papake kakonyen nuka Isirael kere. ",
          "type": "text",
          "attrs": {
