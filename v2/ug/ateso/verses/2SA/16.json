            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodokis Daudi ka iketuŋa alosit: kitor Simei moru kitiirianikina kaŋes, kilami elosi, kibiribiriei ŋes kamor, kituanakini apua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopotu ekabaka ka ituŋa kere luajaas kaŋes epasito; kikwar kaŋina.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
