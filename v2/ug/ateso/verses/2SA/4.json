                {
                  "text": "3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apiesi aberu naedari ekek loka etogo akima, kiluranar, kojotoi; koceda iinaean Rekab ka Baana kaiyeiyea kolomasi togo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.6",
            "verseOrgIds": [
              "2SA.4.6"
            ]
          }
        },
        {
