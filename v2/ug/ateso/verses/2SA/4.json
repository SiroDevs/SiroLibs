              "items": [
                {
                  "text": "Mat 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kelomasi togo koperi Is-boset koitadake kagolake naperot, kinomata ŋes, koarata, kojepasi akouke, koyaŋaasi akouke, kitoroto orot loka Araba akuare kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.7",
            "verseOrgIds": [
              "2SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
