                "loc": "1SA.25.29"
              },
              "items": [
                {
                  "text": "25:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyaut akou naka Is-boset mama ejai Daudi Keburon, kotemasi ekabaka atiar, “Koany akou naka Is-boset okoku loka Saul lokasurupikon, loakoto aijarakon; enyaŋaki EJAKAIT ekajakait ekabaka kanuka Saul ka aurike lolo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.8",
            "verseOrgIds": [
              "2SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
