                "loc": "GEN.9.5"
              },
              "items": [
                {
                  "text": "Age 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakeariata ituŋa lukarokok etuŋanan loedolit kotogoke koitadake, mam eyatakini noi aitepesen aokotoke kakanikus, alemari yes kakwap?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.11",
            "verseOrgIds": [
              "2SA.4.11"
            ]
          }
        },
