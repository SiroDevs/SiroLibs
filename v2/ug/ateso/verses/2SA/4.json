              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋok Daudi Rekab ka Baana onaceke, odwe luka Rimon Ebeerorit, ebe, “Kwape ejaria EJAKAIT, loalakuni aijaraka koean kere, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.9",
            "verseOrgIds": [
              "2SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 4:10"
          },
