              "items": [
                {
                  "text": "18:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajaas Is-boset okoku loka Saul ituŋa iarei luapolokinito irioŋeta: ekiror loka ediopet Baana, ekiror loka ece Rekab, odwe luka Rimon Ebeerotit, loka idwe luka Benyamin: (naarai imarakinitai Beerot da araun loka Benyamin: ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.2",
            "verseOrgIds": [
              "2SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 4:3"
          },
          "items": [
