            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kejai Yonatan okoku loka Saul okoku loaŋwalito akejeke kere. Kerai loka ikar ikany kedolut akiro nuka Saul ka Yonatan koYesereel, kodak akasaanike ŋes kokerearia: kosodi kanen, kisunyak ŋin akerit, kibiror ikoku, koraun eŋwalas, Ekekiror Mepiboset.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.4",
            "verseOrgIds": [
              "2SA.4.4"
            ]
          }
        }
