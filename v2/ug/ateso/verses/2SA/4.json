        },
        {
          "text": "Kepupu Is-boset okoku loka Saul ebe atwaniki Abiner Keburon, kokalanyakata akaninike, kiyaloŋoŋ oto luka Isirael kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.1",
            "verseOrgIds": [
