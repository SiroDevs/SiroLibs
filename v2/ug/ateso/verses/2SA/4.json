                  "text": "Nek 11:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokerata Ibeerotin Gitaim, apotu kiboiororoto kanen kiton lolo.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.3",
            "verseOrgIds": [
              "2SA.4.3"
            ]
          }
        }
