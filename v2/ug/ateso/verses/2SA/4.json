            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.1+2SA.1.2+2SA.1.3+2SA.1.4+2SA.1.5+2SA.1.6+2SA.1.7+2SA.1.8+2SA.1.9+2SA.1.10+2SA.1.11+2SA.1.12+2SA.1.13+2SA.1.14+2SA.1.15+2SA.1.16"
              },
              "items": [
                {
                  "text": "2 Sam 1:1-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakalimokinia kolo etuŋanan eoŋ ebe, ‘Koany, atwana Saul,’ koomite ebe kainunit akiro nukajokak, kekam ŋes, kaara ŋes koSikilag, ŋes eropitike loabu kainak ŋes kanuka akiroke. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.10",
            "verseOrgIds": [
              "2SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 4:11"
