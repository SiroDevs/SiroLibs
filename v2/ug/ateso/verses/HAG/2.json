            "style": "v",
            "sid": "HAG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolimok Serubabel okoku loka Sealutiel, ekayaiton loka Yuda, ka Yosua okoku loka Yekosadak, esasedoti lopeti, ka luedeuna kotuŋa ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
            "verseOrgIds": [
              "HAG.2.2"
            ]
          }
        },
