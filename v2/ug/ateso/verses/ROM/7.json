              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaŋin adumuni ekisil ebe naakotor eoŋ aswam nuejok, kaapikin aronis. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
