          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai alelakinit ikisila luka Edeke kotoma otuŋanan lokotoma, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.22",
            "verseOrgIds": [
