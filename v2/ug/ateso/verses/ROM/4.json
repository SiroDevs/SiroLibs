                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai eyaŋaunete ikisila anyunyura, konye naemameatar ikisila emamei apaar.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
