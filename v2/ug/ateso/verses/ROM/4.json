                {
                  "text": "Gal 3:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aisumunet ŋin mama ejai Aburaam ka aurike da ebe eraun ekeruman loka akwapin, mam kebuni kokisila, dimarai kanuka adolit naka aiyuun, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
