              "items": [
                {
                  "text": "Gal 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai luka ikisila kes ikerumak, eraun aiyuun atitai, aisumunet da itapalaunio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
