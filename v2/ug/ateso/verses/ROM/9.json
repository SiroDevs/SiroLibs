            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kes luka Isirael, lukeinakinio araut odwe, ka aibuses, ka aitutuketa, ka ainakinio ikisila, ka aijaanakin Edeke, ka aisumuneta da; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
