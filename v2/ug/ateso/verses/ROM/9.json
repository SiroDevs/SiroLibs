                {
                  "text": "Any 32:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai tikapedo ailip eoŋ elopet aikenio atiakario kama ka Kristo kanuka ikainacan, lukatekerika kwape ejaar akuan, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
