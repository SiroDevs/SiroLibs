          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enera abeit kotoma Kristo, mam eŋalai; itejenunete akaomisio kotoma Emoyo Lokalaunan, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebe kakadakinit noi ka ariebo da namam enaŋi kotauka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
