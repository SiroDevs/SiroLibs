                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.1"
              },
              "items": [
                {
                  "text": "Yok 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " eraas lukapapaa lukec, ido kotomakec alomunia Kristo kwape ejaar akuan. Kituritete Edeke loeyait kere ikar ka ikar. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        }
      ]
