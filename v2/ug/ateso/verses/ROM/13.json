              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalosenenete kebusak kwape paaran, mere kotoma aboliasio ka emeret, mere kotoma adoteu ka abenyanut, mere kotoma aŋolopa ka ekokote, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
