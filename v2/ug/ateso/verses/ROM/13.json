            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirijaas kapesen mama ejai ituŋanan kere, dimikito aminanara; naarai yenemina aupake etodol ikisila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.8",
