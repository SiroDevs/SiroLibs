              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai na ebe, “Siridote, Siriari, Sirikokoi, Siriŋobelei,” ka aceicorakinet kere, imorikikinitai toma akirot na ebe, “Komina ikoniidunyet kwape iminar bon.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
