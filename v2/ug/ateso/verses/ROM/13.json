                "loc": "MAT.22.21"
              },
              "items": [
                {
                  "text": "Mat 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotacanakisi kere nuebeito, loitelemi esolo loka ituŋa, esolo loka ituŋa; loitelemi esolo da loka iboro, esolo loka iboro; kotacanakisi ayoŋit luebeito ayoŋit, aibuses da mama ejaas lukaibuses.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
