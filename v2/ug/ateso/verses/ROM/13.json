                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aeka akuar, eapie da apaaran. Aso kalacasi aswamisio nuka amuton, kanapa lujiis luka aica, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
