              "items": [
                {
                  "text": "Mat 22:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amin mam ikonakini iidunyet erono; kwaŋin amin ŋes aitodolikinet naka ikisila.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
