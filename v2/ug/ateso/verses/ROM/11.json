                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.10"
              },
              "items": [
                {
                  "text": "Isa 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwape iwadikatere ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.8",
            "verseOrgIds": [
              "ROM.11.8"
            ]
          }
        }
      ]
