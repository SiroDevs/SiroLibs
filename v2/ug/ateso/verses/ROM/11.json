              "items": [
                {
                  "text": "Bur 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso koany ajokis ka adedeŋ naka Edeke; adedeŋ mama ejaas luibiroros, konye aiokis naka Edeke mamakon, arai kisalak ajokis ŋin; arai mere kwaŋin jo da kijepario. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.22",
            "verseOrgIds": [
              "ROM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.16"
              },
              "items": [
                {
                  "text": "2 Kor 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka ŋul da, arai mam esalito toma amamus aiyuun, iraikinio, naarai epedori Edeke airaikin kes bobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.23",
            "verseOrgIds": [
              "ROM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai arai kijepunitai jo katorom naka eseitun loka ais, kiraikinitai oseitun lokoriot lomam erai einono, itelekarito cama atenieik akulepek airaikinio ainyakakin oseitunikec.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.24",
            "verseOrgIds": [
              "ROM.11.24"
