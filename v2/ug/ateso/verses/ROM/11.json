              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.10"
              },
              "items": [
                {
                  "text": "1 Ika 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam Edeke enerit iketuŋa luabu kogeu ajenun, Mam kereka ijenete nuineras nuiwadikatai kanuka Eliya, kwape iwosaa luka Isirael kakonyen nuka Edeke? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.2",
            "verseOrgIds": [
              "ROM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.10"
              },
              "items": [
                {
                  "text": "1 Ika 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebe, “Ejakait, aarata inabinokon, atiyanakis da itemwanakon, eoŋ bon asal, ido emoete akaijar.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.3",
            "verseOrgIds": [
              "ROM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.18"
              },
              "items": [
                {
                  "text": "1 Ika 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye aboŋokinet naka Edeke ebala biai? Ebe, “Etasalit kanukaŋ ikiliok ilukumin ikanykaarei, lumam ekukokinos Baal.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.4",
            "verseOrgIds": [
              "ROM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Rom 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kwape kwaŋin apak na, naka kwana, ejai aatoŋot naeseunitai kanuka asianut. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.5",
            "verseOrgIds": [
              "ROM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gal 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai erai kanuka asianut, mam bobo elomuni kanuka aswamisio; arai timam asianut eroko erai asianut.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.6",
            "verseOrgIds": [
              "ROM.11.6"
            ]
          }
        }
