                {
                  "text": "Rom 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso abala ebe, eguikis kereka kiton aibiror cut? Madi akuj! Konye kanuka aibucarikec adolok aitajario Imo, tetere isurumio luka Isirael ekokote. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.11",
            "verseOrgIds": [
              "ROM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso arai eraun aibucarikec abar naka akwapin, atwaniarikec da araun abar naka Imo, itelekarit cama aitodolikiniokec!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.12",
            "verseOrgIds": [
              "ROM.11.12"
            ]
          }
        }
      ]
    },
