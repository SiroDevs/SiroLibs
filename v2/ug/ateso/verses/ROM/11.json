                {
                  "text": "Rom 9:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Biai bo do? Ibore ŋin yenikemoot Isirael, mam edumuna. Luseuna apotu kodumut, konye ice kere aponi kitininikai, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.7",
            "verseOrgIds": [
              "ROM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
