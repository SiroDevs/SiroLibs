                {
                  "text": "Yer 31:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso abala ebe, Aŋer kereka Edeke iketuŋa? Madi akuj! Naarai arai eoŋ da loka Isirael, loka aur naka Aburaam, loka ateker naka Benyamin. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.1",
            "verseOrgIds": [
              "ROM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 11:2"
          },
          "items": [
            {
