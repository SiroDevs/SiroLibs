              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kapaarasia kanun apotu isotia luka Yuda kiyakiasi ibaluan luipu mama ejai Tobia, luka’ Tobia da kopotu mama ajaas kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
