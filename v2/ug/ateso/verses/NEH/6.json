            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi aiyakikin ŋes ebe, “Mam iswamaunitai akiro ŋun kwape inerar ijo, konye isabi ijo elopet kotaukon.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        },
