                "loc": "EZK.13.17"
              },
              "items": [
                {
                  "text": "Esk 13:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wu Ekadeke, kiitu Tobia ka Sanabalat kwape ajaatar aswamisiokec nu, ka anabi Noadia da, ka inabin ice, luti ketukurianata.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.14",
            "verseOrgIds": [
              "NEH.6.14"
            ]
