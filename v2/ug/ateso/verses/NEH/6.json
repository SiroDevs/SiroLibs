                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kalot togo loka Semaia okoku loka Delaia okoku loka Meketabel, loagolokinitoi; kotema nesl atiar, “Keriamakinos oni togo loka Edeke, toma oyekalu; ido kagolokis ikekia luka eyekalu: naarai epote aiar jo; eebo, epote aiar jo kuare.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.10",
            "verseOrgIds": [
              "NEH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.1"
              },
              "items": [
                {
                  "text": "Awa 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Katema atiar, “Etuŋanan loetia ne bala eoŋ tikeker? Iŋai da loetia ne bala eoŋ yeni ti keloma oyekalu aitajar akeijar? Mam alomari.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.11",
            "verseOrgIds": [
              "NEH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.22"
              },
              "items": [
                {
                  "text": "Esk 13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kamisiik, ido koany, mam abu Edeke kijukunite ŋes: konye abu ŋesi kolimite adwaretait na nakaluikin: naarai aropitos Tobia ka Sanabalat ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.12",
            "verseOrgIds": [
              "NEH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keropio kakirot kana tetere akurianari eoŋ kasodi aswam ŋun, kadiaka, kosodete kesi adumun akirot naerono kasodete amoromoroo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.13",
            "verseOrgIds": [
              "NEH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 6:14"
          },
          "items": [
