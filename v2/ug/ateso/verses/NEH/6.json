            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keyakikis bobo kwaŋin irwan aoŋon; kabonok kwape kwaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        },
        {
          "name": "verse",
