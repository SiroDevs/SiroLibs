                  "text": "Awa 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi aijukar ikiyakia mama ejaas kesi ebe, “Eswamai eoŋ aswam naepol, mam apedori alosit: inyo bo ti kitanania aswam, eoŋ ajalakin ŋes abunore mama ijaas?” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
