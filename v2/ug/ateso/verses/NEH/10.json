          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraia, ka Asaria, ka Yeremia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.2",
