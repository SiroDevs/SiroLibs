              "type": "text"
            }
          ]
        },
        {
          "text": " Ikiroria da luka Ilebin kes lu: Yesua okoku loka Asania, ka Binui lokodwe luka Kenadad, ka Kadumiel; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.9"
            ]
