          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ikeceinacan, Sebania, ka Kodia, ka Kelita, ka Pelaia, ka Kanan; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.10"
