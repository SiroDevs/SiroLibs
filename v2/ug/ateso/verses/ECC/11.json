            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyeenenei ikonikinyom tupuruc, eboŋ da sirikitikok akonikan; naarai mam iieni kakesi luikemerete, arai lu arai nul, elemuni eriakakinos kere araun luejok.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
