          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eebo, kebut ituŋanan ikar luipu, kisiyalamikina kakes kere; konye kiitunite kereka apaarasia nuka amuton, naarai eraunos nuipu. Kere nuepote eraas aamameak.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
