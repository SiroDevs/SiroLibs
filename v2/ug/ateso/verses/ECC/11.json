            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwape mam ijenia erot loka ekwam kwape ejaar, karaida akoio kwape epolooto kotoma aliliget naka akapotion; kwape kwaŋin mam ijenia aswam naka Edeke loiswamai kere.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
