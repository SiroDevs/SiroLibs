                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Apu 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi naaboŋoria, koany, kojaas ikito luipu noi koitolima loka ecor epuwai ka epuwai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.11"
              },
              "items": [
                {
                  "text": "Sek 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.11"
              },
              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.15"
              },
              "items": [
                {
                  "text": "Apu 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi katema eoŋ atiar, “Elelearete akip nu owai lokokide, ijesaros toma Araba; elosete aŋolol; aŋololŋes elosete akip nukitolomunio; ido itaŋaleunio akipi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.25"
              },
              "items": [
                {
                  "text": "Yok 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.63"
              },
              "items": [
                {
                  "text": "6:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.45"
              },
              "items": [
                {
                  "text": "1 Kor 15:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen ejari ŋinibore yenikajaran yenilweki, kaŋiniibois naedolete icorin; idilaros lukecor noi; naarai adolut akip nu, itaŋaleunio akipi nuka aŋolol, ido ejari ŋinibore kere kaneedolenenei ecor kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
