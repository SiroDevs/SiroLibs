                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma etuŋanan kobei kide kitiŋite auno kakanike, kitem ikubitin elukumit, ketotor akipi, akipi nuasaŋito okuurunya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitem bobo elukumit, ketotor akipi, akipi nuasaŋito akuŋin. Kitem bobo elukumit, ketotor akipi, akipi nuasaŋito aŋabet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kitem elukumit; korau ecor lomam apedori aitor: naarai amukururas akipi, akipi nukiduis, ecor lomam epedorio aitor. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema eoŋ atiar, “Okoku loka etuŋanan, iany nu?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
