                "loc": "EZK.47.15"
              },
              "items": [
                {
                  "text": "Esk 47:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen ebwoete ikalokak koitolimake: anyoun ko En-gedi kiton En-egilaim eraun aibois naeakanakinet iboyan; eiaunete lukecor lukipoŋesio luipu noi, kwape lukecor luka Aŋolol Nakapolon, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye aiboisio nukerit, ka isamake da mam itanaleunio; inyeinio eraas nukabalaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
