                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.3"
              },
              "items": [
                {
                  "text": "Sab 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.3"
              },
              "items": [
                {
                  "text": "Isa 61:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Apu 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koitoliman luka ecor, epuwai ka epuwai, ebwaŋunete ikito lukipoŋesio kere luenyamio, lumam erinyorete akuikee, ido mam araitokee inonooros. Eraenenete araito nukitetiak nolilap, naarai apote akeeekipi kaibois nakalaunan. Eraunete akeeeraito inyamat, akeeekui da eraunete ekia lokitanaleunet.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
