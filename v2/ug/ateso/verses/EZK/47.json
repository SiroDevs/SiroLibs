        },
        {
          "text": " Kenyaka okek loka etogo; ido koany, koleleut akip alomun kokwap kariri ketogo kari nakokide, naarai koseseni etogo kide; koleleas akip alomun kokwap, kowai lokoteten loka etogo, kari naka eŋalakimak naka etem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ketolom korot lokorute loka agolitomei, kayaŋa kesirimo orot lokokiŋa kiton orute 10 kokiŋa, korot lokorute loeseseni kide; ido koany koleleete akip kowai lokoteten.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
    },
