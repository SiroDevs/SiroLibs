                {
                  "text": "Kbk 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes ayaunia lukaeekwapin luitelekarito aronis, kiruma itogoikec: etanaŋi da aiwoŋonut naka ikagogoŋok; emunaario aiboisiokec nukalaunak. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.24",
            "verseOrgIds": [
              "EZK.7.24"
            ]
