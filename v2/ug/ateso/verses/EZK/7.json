          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebunit amudiar, emoete ainapakin, komam edumunete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.25",
            "verseOrgIds": [
              "EZK.7.25"
            ]
