                  "text": "Sab 55:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido enapete ipukoi, erapari asogim kes; irumete ileje akonyenekee kere, ejaunos ipatai akwesikee kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.18",
            "verseOrgIds": [
              "EZK.7.18"
            ]
          }
        },
