                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebuni ameŋeranut kameneranut, nukabe da nukabe; emoete aitapoet kaneejai enabi; konye eoliorete ikisila kama ejai esasedoti, ka ainerun da kama ejaas imakio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.26",
            "verseOrgIds": [
              "EZK.7.26"
            ]
          }
        },
        {
          "name": "verse",
