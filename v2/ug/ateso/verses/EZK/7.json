            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswama erikot: naarai ileleba akwap iarito, ileleba da ere akaje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.23",
            "verseOrgIds": [
