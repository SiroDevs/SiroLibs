                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala Ejakait EDEKE ebe, Ainak ŋes akwap nako Misiri ataeia aitaaritoike, naarai keswamakis eoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
