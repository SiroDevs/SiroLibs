            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.17"
              },
              "items": [
                {
                  "text": "Aku 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam bobo eraun amun naka ekek loka Isirael kisiitununei numam adolitekec, naibelokinotor asesen kes. Ejenunete do ebe arai eoŋ Ejakait EDEKE.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
      ]
