        },
        {
          "text": "Kosodi kanen kokaru loka akaisaarei ka lukanykaarei kolap losodit, kapaaran nasodit naka elap, kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
