            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.7"
              },
              "items": [
                {
                  "text": "Esk 26:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, abu Nebukadaresar ekabaka loko Babulon koinak ajoreke aitaaritoi naepol asurokinia Turo: adum ninikou epata, abuluear ŋolikeper: kwabo mam eropio ŋes karaida ajoreke koTuro, kanuka aitaaritoike naetaaritoi asurokin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun inera kwanata Ejakait EDEKE ebe: Koany, ainakini Nebukadaresar ekabaka loko Babulon akwap nako Misiri; eyaŋaari ŋesi ekodeteke, eŋasi, emejai da; eraun eropit loka ajoreke, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
