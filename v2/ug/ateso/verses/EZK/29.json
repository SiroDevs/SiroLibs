                {
                  "text": "Yer 25:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, kite Parao ekabaka loko Misiri, kodwarak ŋes, ka Misiri da kerc, ",
          "type": "text",
          "attrs": {
