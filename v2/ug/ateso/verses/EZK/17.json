              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.6"
              },
              "items": [
                {
                  "text": "Yok 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.12"
              },
              "items": [
                {
                  "text": "Yud 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eebo koany, kiraikin, isirerenio? Mam kereka erinyori cut, kijaŋ ekwam lokokide? Erinyori kotoma apanya nuapolokini.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
