            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolimok ekek lokepali ebe, Mam kereka iienete apolou naka akiro kanun? Kolimok ebe, Koany, abu ekabaka loko Babulon kobu Yerusalem, kikama ekabakake, ka ikapolokoke, koyanau kes neajai Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 17:13"
          },
          "items": [
