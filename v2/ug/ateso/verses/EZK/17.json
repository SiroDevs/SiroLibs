                "loc": "MAT.21.19"
              },
              "items": [
                {
                  "text": "Mat 21:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.20"
              },
              "items": [
                {
                  "text": "Mk 11:20",
                  "type": "text"
