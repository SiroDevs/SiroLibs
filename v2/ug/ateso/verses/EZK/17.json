              "items": [
                {
                  "text": "2 Siit 36:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyana ediopet kaur naka ekabaka, kitutukoto kaŋes aitutuket; ido kisiyapo ŋes. (Koyana ikagogoŋok luka akwap: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
