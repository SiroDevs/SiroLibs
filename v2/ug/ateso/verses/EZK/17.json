              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " aitisil ajakanut, kinyek adakara, konye kicat kanuka airie aitutuketeke.) ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
