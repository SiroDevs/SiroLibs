            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keswamakini jo numam eswamat apeŋo, mam bobo abuni aswam kwaŋin, kanuka italesiokon kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.9",
            "verseOrgIds": [
              "EZK.5.9"
            ]
