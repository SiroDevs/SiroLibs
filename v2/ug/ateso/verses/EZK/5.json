            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun enyamete lukapapa idwe kokidinikon, idwe da enyamete lukapapakec; etodolikini itubesia kamakon, eweliweli da aatonotokon kere mama ejaas ikwamin kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.10",
            "verseOrgIds": [
              "EZK.5.10"
            ]
          }
        },
