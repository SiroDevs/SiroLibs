                {
                  "text": "Esk 44:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ijo da, okoku loka etuŋanan, kolem ekileŋ loekwana, kitwasam bala ebarenit loka ekabarenon, kitorio akoukon kopenekekon da: kosodi kolem aitemis aitemio, kotiak itim. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.1",
            "verseOrgIds": [
              "EZK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.1"
              },
              "items": [
                {
                  "text": "Esk 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iewei atutubet nakiwuniet kakim kokidiŋ ore, naitodolikinere apaarasia nuka airigaun; kolem atutubet nakiwuniet kireb kekilen airimor ere; atutubet nakiwuniet da kiwelana neejai ekwam, autuni eoŋ ekileŋ loetupari kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.2",
            "verseOrgIds": [
              "EZK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.6"
              },
              "items": [
                {
                  "text": "Yer 40:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilemuni idis, koen kanapitokon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.3",
            "verseOrgIds": [
              "EZK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.1"
              },
              "items": [
                {
                  "text": "Yer 41:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilemuni kanul da, icakakini kidin akim, icwei kes; namakec elomuni akim nailosikini ekek kere loka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.4",
            "verseOrgIds": [
              "EZK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inera kwanata Ejakait EDEKE ebe: Ŋin ŋes Yerusalem: ebwaik kidiŋ atekerin ka akwapin da nuirimorito. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.5",
            "verseOrgIds": [
              "EZK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.25"
              },
              "items": [
                {
                  "text": "Rom 1:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.4"
              },
              "items": [
                {
                  "text": "Yud 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kipaliik ikatubesia kiswamaenenei nukaronok adepar atekerin, ido epaliiki ikakisila adepar akwapin nuirimorito: naarai agiro ikatubesia, mam da elosenenete kotoma okisilaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.6",
            "verseOrgIds": [
              "EZK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.10"
              },
              "items": [
                {
                  "text": "Yer 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.12"
              },
              "items": [
                {
                  "text": "Esk 11:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka nun ŋes inerar kwanata Ejakait EDEKE ebe: Naarai iloliaka yesi adepar atekerin nukirimorito, kwabo mam ilosikinito ikakisila, komam iricito ikatubesia, karaida aswam kwape elaatar itubesia luka atekerin nukirimorito; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.7",
            "verseOrgIds": [
              "EZK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋes inerar kwanata Ejakait EDEKE ebe:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.8",
            "verseOrgIds": [
              "EZK.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
