              "items": [
                {
                  "text": "11:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala Ejakait EDEKE ebe, Aso, kwape ajaria, abeit, naarai imunaa akaibois nakalaunan kanuka iborokon kere luasacit, ka italesiakon kere, kanuka nun kenonari jo: mam akakoŋu isionie, ido mam etimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.11",
            "verseOrgIds": [
