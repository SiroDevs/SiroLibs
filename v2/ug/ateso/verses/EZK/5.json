          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany, eotj, eoŋ obe, arai lokasurupikon, etodolikini ikatubesia kamakon kakonyen nuka atekerin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.8",
            "verseOrgIds": [
              "EZK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
