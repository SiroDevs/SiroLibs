                "loc": "DEU.4.27"
              },
              "items": [
                {
                  "text": "Ikis 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kesiarisiari jo katekerin, keweliweli kakwapin; etanaŋi da amodokokokon kotomakon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
            ]
          }
        },
        {
