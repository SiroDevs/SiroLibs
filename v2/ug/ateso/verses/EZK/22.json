        {
          "text": " Igwaunit akirot naka aokot nuibukoo, imunaar kaputosiakon nuiswama; isukuny apaarasiakon, ido idolok okarukon, ŋes kainakini ketuluori amorosit katekerin, ka yenikisekelo kakwapin kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.4",
            "verseOrgIds": [
              "EZK.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukiapiatar, ka luelwaka, kisekelete, ijo loejai ekiror lokamunaara, ido ileleba autaar.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.5",
            "verseOrgIds": [
              "EZK.22.5"
            ]
          }
