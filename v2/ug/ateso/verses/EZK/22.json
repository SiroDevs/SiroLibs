          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.22"
              },
              "items": [
                {
                  "text": "Any 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Sab 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi imunaar kanukon, kakonyen nuka atekerin; ijenuni ebe arai eoŋ EJAKAIT.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
            "verseOrgIds": [
              "EZK.22.16"
            ]
