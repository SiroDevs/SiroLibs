                "loc": "MIC.6.16"
              },
              "items": [
                {
                  "text": "Mik 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinera ebe, Inera kwanata Ejakait EDEKE ebe: Ere loebukokini aokot kidinike, tetere edolokini apakike, loiswamai aputosia amunaaror! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.3",
            "verseOrgIds": [
              "EZK.22.3"
            ]
          }
        },
