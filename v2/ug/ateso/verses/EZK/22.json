                  "text": "Sep 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enerut inabinoke kokidinike, kwape eŋatuny loegat naepoopoaa imejauna: anyamata aiiar naka ituŋa; anatata iboro luka akais nuipu ka luka etiai loepol; etupuata apuserunuke kokidinike, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.25",
            "verseOrgIds": [
              "EZK.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.8"
              },
              "items": [
                {
                  "text": "Mal 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.29"
              },
              "items": [
                {
                  "text": "1 Sam 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.10"
              },
              "items": [
                {
                  "text": "Leb 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Epaliikis isasedotinike ikakisila, amunaasi ikaboro lukalaunak; mam etiakitos iboro lukalaunak ka luka apakio kere, mam isisianakinito atiaketait kotoma lumam elaete ka Iuelaetc, ebwaata akecekonye kasabatonoka, kamoromoroo eoŋ da kamakec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.26",
            "verseOrgIds": [
              "EZK.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.23"
              },
              "items": [
                {
                  "text": "Isa 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Esubito ikapolokoke kokidinike bala ipeen luepoopoete imeiauna; abukor aokot, ka amudiar aijar, tetere imakiraete kaimod. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.27",
            "verseOrgIds": [
              "EZK.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.10"
              },
              "items": [
                {
                  "text": "Esk 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido eladaata inabinoke kanukee aitwakaŋ, eanyunete aamameak, edwarakinete kes nukainal, kobalas ebe, “Inera kwanata Ejakait EDEKE,’ kwabo mam EJAKAIT inerit. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.28",
            "verseOrgIds": [
              "EZK.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.26"
              },
              "items": [
                {
                  "text": "Yer 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu ituŋa luka akwap komwana, kotupasi aiŋat; eebo, esiyaloŋoŋoto lukican ka luilwaritos, ido amwanata imoit atitai, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.29",
            "verseOrgIds": [
              "EZK.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.1"
              },
              "items": [
                {
                  "text": "Yer 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.23"
              },
              "items": [
                {
                  "text": "Age 18:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kamoote ituŋanan kotomakec, yeniketetean abwas, yenebwoi karorwa kakonyeneka kanuka akwap, kenyek amudiar; konye mam abu kaany imodio da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.30",
            "verseOrgIds": [
              "EZK.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ejakait EDEKE ebe, Kanuka nun ijes abukokinia kes akaisiop; kadau kes kakim naka akanyunyura: etebeik ekecerot akwesikee.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.31",
            "verseOrgIds": [
              "EZK.22.31"
            ]
          }
        }
