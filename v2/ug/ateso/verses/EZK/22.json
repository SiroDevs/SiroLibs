            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imwan ikaboro lukalaunak, imunaa da akasabaton. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
              "EZK.22.8"
            ]
