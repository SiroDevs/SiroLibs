            "number": "2",
            "style": "v",
            "sid": "EZK 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŋo da, okoku loka etuŋanan, itubokini, itubokini kereka ijo ere loka aokot? Aso kitejenik ŋes italesiake kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.2",
            "verseOrgIds": [
              "EZK.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
