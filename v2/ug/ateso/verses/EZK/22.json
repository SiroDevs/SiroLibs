          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.23",
            "verseOrgIds": [
              "EZK.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoku loka etuŋanan, kolimok ŋes ebe, Irai ijo akwap namam itesegario ido mam itetepio akiru kapaaran naka aisiop. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.24",
            "verseOrgIds": [
              "EZK.22.24"
            ]
          }
        },
        {
