              "items": [
                {
                  "text": "1 Kor 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Epedori kereka ekonitau atitiŋikin, arai akonikanin ajaut kagogon, kapaarasia nukeswamakinia? Eoŋ EJAKAIT ener, eswamai da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.14",
            "verseOrgIds": [
              "EZK.22.14"
            ]
