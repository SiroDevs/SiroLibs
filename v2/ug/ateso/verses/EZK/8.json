            "sid": "EZK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kokaru lokikanyetekape, toma olap lokikanyetekape, kapaaran nakikanyet naka elap, naeboio kotogoka, kibojete da imakio luka Yuda kakonyeneka, kadoik eoŋ akan naka Ejakait EDEKE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.1",
            "verseOrgIds": [
              "EZK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Dan 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.27"
              },
              "items": [
                {
                  "text": "Esk 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi kasesen, ido koany, aputo naesubit bala akim; ageun kaneasubit bala aŋabeteke kiton kwap, akim: ageun da kaneasubit bala aŋabeteke kiton kuju, bala amwekimwek, bala eiese loka esabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 8:3"
          },
          "items": [
            {
