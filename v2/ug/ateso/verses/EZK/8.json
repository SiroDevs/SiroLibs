            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kayau alaro nakotoma naka etogo loka EJAKAIT, ido koany, kidin agola nalomaret ka etem, kejaas ituŋa kwaka akaisaarei ka lukany, lukibelokinitos asebon oyekalu loka EJAKAIT, ka ireetakec kide; komaete kesi akoloŋ kokide. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        },
