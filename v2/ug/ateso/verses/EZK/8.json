                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.4"
              },
              "items": [
                {
                  "text": "Any 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Korio naasubit bala akan, ketin eeuude; kadaku emoyo kokidin kakwap ka akuj, kayana Yerusalem kotoma aitapoeta nuka Edeke, mama ejai ekirigi loka erute loka alaro nakotoma joeseseni agolitomei: neajai eicoloŋ loka aput naka ekolo, naitokokoli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.3",
            "verseOrgIds": [
              "EZK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Esk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, kojai nen aibuses naka Edeke loka Isirael, kwape ajaar aitapoer naabu kaany kapuuton.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kabala ebe, “Okoku loka etuŋanan, kiteluo kwana akonikonye orot loebei agolitomei.” Kasodi keteluo akakonye orot loebei agolitomei, ido koany, keiai aput nin naka ekolo, neelomarere orute loka etem ari nakagolitomei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.5",
            "verseOrgIds": [
              "EZK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.16"
              },
              "items": [
                {
                  "text": "Ikis 31:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.14"
              },
              "items": [
                {
                  "text": "2 Siit 36:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Katema eoŋ atiar, “Okoku loka etuŋanan, iany kereka nuiswamaete? Italesia luepolok luiswamai ekek loka Isirael kane, tape ekunyari neelwana anyoun kaiboisika nakalaunan? Konye iyatakini bobo aanyun nukitalesia ace nuepolok.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodi kayau okirigi loka alaro; kasodi kete, ido koany, kojai apedot arwatat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.7",
            "verseOrgIds": [
              "EZK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi atemar atiar, “Okoku loka etuŋanan, kobok arwatat”: ido kadau aibok arwatat, koany, kojai ekirigi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.8",
            "verseOrgIds": [
              "EZK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema atiar, “Koloma, koany italesia lukaronok luiswamaete kane.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.9",
            "verseOrgIds": [
              "EZK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaloma, kaany; ido koany, aponi kinomitete aputosia nuka nolipone loka lueliatos, ka itian luketal, ka aputosia kere nuka ekek loka Isirael, toma arwatat iwaitin kere, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.10",
            "verseOrgIds": [
              "EZK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.8"
              },
              "items": [
                {
                  "text": "2 Ika 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.24"
              },
              "items": [
                {
                  "text": "Yer 26:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.17"
              },
              "items": [
                {
                  "text": "Mar 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobwoete kakonyenekee ituŋa akaisakanykaarei komakio luka ekek loka Isirael, kobwoi Yaasania okoku loka Sapan kokidinikec, Kokodite nolituŋanan aisupuruuneteke; kopuru asakat naka lukisupurununo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.11",
            "verseOrgIds": [
              "EZK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.14.1"
              },
              "items": [
                {
                  "text": "Sab 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.15"
              },
              "items": [
                {
                  "text": "Isa 29:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.10.11"
              },
              "items": [
                {
                  "text": "Sab 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ŋesi atemar atiar, “Okoku loka etuŋanan, iany kereka nuiswamaete imakio luka ekek loka Isirael kamuton, nolitunanan kagolaike nuka aputosia? Naarai ebalas ebe, ‘Mam EJAKAIT kianyuni oni; enyek EJAKAIT akwap.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema bobo atiar, “Iyatakini bobo aanyun nukitalesia ace nuepolok nuiswamaete,”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
