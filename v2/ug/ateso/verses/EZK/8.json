            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kayau okek loka erute loka etogo loka EJAKAIT loitei agolitomei; ido koany, kibojete aŋor kokuudianete Tamus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema atiar, “Iany kereka nu, ijo okoku loka etuŋanan? Iyatakini bobo aanyun nukitalesia ace nuepolok adepar ŋun.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        }
      ]
    },
