                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kere lueraas luka aswamisio nuka ikisila ikenitoi; naarai iwadikatai ebe, “Kikenoi ŋin kere yenimam ericenenei akiro kere nuiwadikatai oitabo loka ikisila, aiswamaenen kes.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 3:11"
          },
          "items": [
