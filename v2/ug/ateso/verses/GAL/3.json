              },
              "items": [
                {
                  "text": "24:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi kolimokinai Aburaam aisumuneta, ka aurike da. Mam inera ebe, Auriarikon, bala keraas luipu, dimarai bala kerai ediopet, “Aurikon”, ŋes Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
