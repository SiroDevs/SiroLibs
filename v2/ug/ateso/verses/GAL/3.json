              "items": [
                {
                  "text": "Any 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye naenera nata ebe, mam ikisila itapalaunito aitutuket naitogogoŋit Edeke sek ikaru akwat aoŋon ka akaisauni eriŋa ikisila ejauna, ŋes mam itamamauniata da aisumunet. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
