                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.3"
              },
              "items": [
                {
                  "text": "Rom 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.21"
              },
              "items": [
                {
                  "text": "2 Kor 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu Kristo kolaku oni kama kekenit loka ikisila, nakeraunia ekenit kanuwok, naarai iwadikatai ebe, “Kikenoi ŋin kere yenikajakinitai okitoi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tetere edoikini Imo arereŋ naka Aburaam toma Yesu Kristo, tetere kidumuni aisumunet naka Emoyo kanuka aiyuun.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
