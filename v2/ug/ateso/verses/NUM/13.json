              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye ituŋa luaupara kaŋes kotemasi atiar, “Mam kipedori asurokin ituŋa; naarai egogoŋ kesi adepar oni,” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
