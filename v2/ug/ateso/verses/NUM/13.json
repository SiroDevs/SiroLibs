            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.23"
              },
              "items": [
                {
                  "text": "9:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kijuka ituŋa, korota akwap naka Kanaan, naainakini idwe luka Isirael: ijukari etuŋanan loka ninireker naka lukapapaakee, nclidiopet loepol kamakec.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijuka Musa kes anyoun kamodiŋ naka Paran kwape ajaar aicorakinet naka EJAKAIT: kes kere ituŋa luapolokinito idwe luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikecekiroria da lu: loka ateker naka Reuben ŋes Samua okoku loka Sacur, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loka ateker naka Simeon, Sapat okoku loka Kori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
