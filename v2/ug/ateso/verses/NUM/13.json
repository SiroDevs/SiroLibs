              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobonosi kairot akwap kedaunos apaarasia akaisaoŋon, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
