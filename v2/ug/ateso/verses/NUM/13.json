            "number": "23",
            "style": "v",
            "sid": "NUM 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodolut aditot naka Esukot, kojeput kanen atenut naajai aibuŋet adiopet naka emusabibu, kidielata iarei kakitoi; koyautu da araito nuka ekamamaga, ka nuka etini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komaikinai aibois ŋin aditot naka Esukol,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:24",
              "type": "text"
            },
            {
              "text": "Esukol Apolouke Aibuŋet.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kanuka aibuŋet naajeparete idwe luka Isirael kanen.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        }
      ]
