              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka Musa kes airot akwap naka Kanaan, kotema kes atiar, “Kodokasi korot loka ari naka Eŋalakimak, kodokasi oroŋan: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koanyut akwap, kwape eputor; ka ituŋa luibojete kotoma, arai eraas luegogon arai enonok, arai ikidioko arai ipu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.18",
            "verseOrgIds": [
              "NUM.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kwape eiaar akwap naiboioto kesi kotoma, arai ejok arai erono; kwape ejaatar da ireria luiboioto kesi kotoma, arai ludukurun, arai luebwaunitai kabwas; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.19",
            "verseOrgIds": [
              "NUM.13.19"
            ]
          }
        },
