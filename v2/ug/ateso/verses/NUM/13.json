            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul kes ikiroria luka ituŋa luejukari Musa airot akwap. Komaik Musa Kosea okoku loka Nun Yosua.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
