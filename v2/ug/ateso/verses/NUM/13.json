              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete kodokasi korota akwap anyoun kamodiŋ naka Sin aitodol Rekob kiton alomaret Kamat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
            "verseOrgIds": [
              "NUM.13.21"
            ]
          }
        },
        {
          "name": "verse",
