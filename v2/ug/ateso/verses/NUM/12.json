              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou da edou kokuju owema; ido koany, ebokoror akuan naka Miriam atapon: kite Aaron Miriam, ido koany, korai nakatapon, ",
          "type": "text",
          "attrs": {
