              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋirikinit amin, esiana amin; mam amin ikokoteono, mam epogana, mam edakunun, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
