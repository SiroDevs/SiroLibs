              },
              "items": [
                {
                  "text": "Mk 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bobo da arai ajai kaidwar, ajenuni da nukaiyeiyea kere, ka aijen kere, arai da ajai kaiyuun kere naepedori aitwobot iroŋan, komamei eoŋ amin, mam arai ibore. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
