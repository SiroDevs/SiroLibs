                {
                  "text": "1 Yok 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kwana esalete aiyuun, ka amun, ka amin, ŋun auni; konye naepol aitelekarit kaŋun ŋes amin.",
          "type": "text",
          "attrs": {
