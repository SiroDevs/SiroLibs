              "items": [
                {
                  "text": "Pil 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mam iswamai numam ibusakinito, mam emoot nuke bon, mam itunyunyurikinio, mam eliliei, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        },
