              "items": [
                {
                  "text": "1 Pet 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam amin enaŋi cut; konye kejai aidwar itapalaunio; kejaas aŋajepa, enaŋete; kejai aijen, itapalaunio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kijeni nuikidioko, kidwari da nuikidioko, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "konye naejaunia naitekoro, itapalaunio do nuikidioko ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaraar ikoku, abu kenera bala ikoku, kajeni bala ikoku, kaomoomoi bala ikoku; naapolooror ketapalau nukeiditeu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.7"
              },
              "items": [
                {
                  "text": "2 Kor 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.23"
              },
              "items": [
                {
                  "text": "Yak 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kwana kiseseni karoet kowariwari, konye kapak kaŋin kisesena kakonyen; kwana ajeni nuikidioko, konye kapak kaŋin ajenuni noi kwape kajenunere noi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
