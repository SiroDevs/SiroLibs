              },
              "items": [
                {
                  "text": "Mat 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bobo da arai kakorak ikaboro kere aitanyamia lukican, bobo da arai kainak akakuan aicweikinio, komamei eoŋ amin, emamei adiojokis,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        }
