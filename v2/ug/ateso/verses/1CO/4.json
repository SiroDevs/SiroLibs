              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.13",
            "verseOrgIds": [
              "1CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam ewadikai nu aisurumia yes ileic, konye aikwenyar yes kwape idweka luminan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.14",
            "verseOrgIds": [
              "1CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.19"
              },
              "items": [
                {
                  "text": "Gal 4:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Karaida kejaas yes ikesisianakinak ilukumin itomon kotoma Kristo, konye emameete lukapapa luipu. Naarai eoŋ ŋes kaurit yes kotoma Kristo Yesu kanuka alimonokin Akiro Nukajokak. ",
          "type": "text",
