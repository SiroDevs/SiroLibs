              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kitaaritoi aswam kakaninikosi. Nakimoromoroere, kilipanakini arereŋ; nakiticanere, kititiŋikinit; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.12",
            "verseOrgIds": [
              "1CO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
