                "loc": "REV.3.17"
              },
              "items": [
                {
                  "text": "Apu 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idaut aimonikin! Idaut adumun abar! Iyaitos kamameete isio!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.8",
            "verseOrgIds": [
              "1CO.4.8"
            ]
          }
        }
      ]
