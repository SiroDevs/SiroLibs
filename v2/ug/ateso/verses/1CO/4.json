        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.7"
              },
              "items": [
                {
                  "text": "Ikis 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.24"
              },
              "items": [
                {
                  "text": "22:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " nakisabanakinere, kiŋaiŋai; kitusubi bala asusuj nuka akwap, ediirit da loka iboro kere, kiton kwana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.13",
            "verseOrgIds": [
              "1CO.4.13"
            ]
          }
        }
