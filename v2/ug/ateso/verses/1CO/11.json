              "type": "tag",
              "attrs": {
                "loc": "MAT.26.29"
              },
              "items": [
                {
                  "text": "Mat 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso irwan kere nuinyamenenata emugati ŋol, arai imasenenata akoli ŋin, ilimorete atwanare naka Ejakait, aitodol naebunio ŋesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
