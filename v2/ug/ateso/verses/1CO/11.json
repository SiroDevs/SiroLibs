          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "arai ejai yeneriebi eteŋei, konyam korekeŋ; kinyek atukonokinikus atubokinio. Etetemi acekiro kere naabunio.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
