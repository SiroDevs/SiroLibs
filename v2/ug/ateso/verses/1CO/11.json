                  "text": "Sek 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwape kwaŋin da kedaut ainyam, kirum akoli, kobala ebe, “Akoli na erai aitutuket nakitetet kotoma akaokot. Kiswamaenenete ŋun naimasiananata kere, aiitunitor eoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
