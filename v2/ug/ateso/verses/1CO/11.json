          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai yenenyami ka aimat komam imisiikini akuan, enyami emasi da atubokinio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
              "1CO.11.29"
            ]
          }
        },
