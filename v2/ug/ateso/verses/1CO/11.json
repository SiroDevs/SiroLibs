          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kedau aimal, kobilibil; kotema atiar, “Lo ŋes akakuan naerai kanukus. Kiswamaenenete ŋun aiitunitor eoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
