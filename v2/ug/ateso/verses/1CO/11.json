            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nakitubokini oni Ejakait, kilecorio, kenyeis aitelekario nepepe kakwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
