              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.15"
              },
              "items": [
                {
                  "text": "2 Pet 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwape ejaar asianut naka Edeke nakainakinitai eoŋ, abu kapesik apetetait kwape ekadukon lokapolon lokacoa, konye eduki ece. Konye kocoite ŋinidiopet kwape edukio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.10",
            "verseOrgIds": [
              "1CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.4+1PE.2.5+1PE.2.6"
              },
              "items": [
                {
                  "text": "1 Pet 2:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai emamei yenepedori apesikin apetetait ace, dimarai ŋin naedaunitai apesikin, ŋes Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.11",
            "verseOrgIds": [
              "1CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai keduk ituŋanan toma apetetait ŋin esabu, arai epuesa, arai amor nuketiai, arai akito, arai anya, arai ariaŋ da, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.12",
            "verseOrgIds": [
              "1CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.5"
              },
              "items": [
                {
                  "text": "1 Kor 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 Ses 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " etakanuni aswam naka ŋinituŋanan; naarai isideleleuni Apaaran, naarai epukorio kotoma akim, itemi da akim aswam naka ŋinituŋanan kwape ejaar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.13",
            "verseOrgIds": [
              "1CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai esalit aswam naedukit ituŋanan toma apetetait, edumuni ŋesi eropit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.14",
            "verseOrgIds": [
              "1CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kidopoo aswam naka ituŋanan, etwaniari, kwabo itajario ŋes, konye bala kotoma akim.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.15",
            "verseOrgIds": [
              "1CO.3.15"
            ]
          }
        }
      ]
    },
