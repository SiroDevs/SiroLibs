                {
                  "text": "Yok 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ da, iinacan, mam apedorit einer kayes kwape luka emoyo, dimarai luka akuan, kwape imukerun kotoma Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.1",
            "verseOrgIds": [
              "1CO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.12+HEB.5.13"
              },
              "items": [
                {
                  "text": "Bur 5:12-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.2"
              },
              "items": [
                {
                  "text": "1 Pet 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu ketamata yes akile, kwabo mere inyamat; naarai mam ipedorito; eebo, kiton kwana da mam ipedorito, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.2",
            "verseOrgIds": [
              "1CO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.10+1CO.1.11+1CO.1.12"
              },
              "items": [
                {
                  "text": "1 Kor 1:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.18"
              },
              "items": [
                {
                  "text": "11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai iriŋa iraas luka akuan. Naarai naejaar ekokote ka aŋolopa, mam kereka iraas ituŋa luka akuan, ilosenenete kwape ituŋa atai? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.3",
            "verseOrgIds": [
              "1CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.12"
              },
              "items": [
                {
                  "text": "1 Kor 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai naebalar idiopet ebe, “Arai eoŋ yenika Paul,” ice da ebe, “Arai eoŋ yenika Apolo,” mam kereka iraas ituŋa atai?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.4",
            "verseOrgIds": [
              "1CO.3.4"
            ]
          }
        }
      ]
    },
