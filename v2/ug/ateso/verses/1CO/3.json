                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso iŋai bo Apolo? Iŋai bo da Paul? Kes ikejaanakinak lukiyuunete yesi kamakec, ka ŋin diopet da kwape keinakinia Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.5",
            "verseOrgIds": [
              "1CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.4+ACT.18.5+ACT.18.6+ACT.18.7+ACT.18.8+ACT.18.9+ACT.18.10+ACT.18.11"
              },
              "items": [
                {
                  "text": "Asw 18:4-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24+ACT.18.25+ACT.18.26+ACT.18.27+ACT.18.28"
              },
              "items": [
                {
                  "text": "24-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu eoŋ kera, kicoco Apolo, konye kitopolo Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.6",
            "verseOrgIds": [
              "1CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaŋin ekeraan mam erai ibore, karaida ekecocoan, dimarai Edeke loitopoloi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.7",
            "verseOrgIds": [
              "1CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso loirai ka loicocoi eraas ipe, ido edumuni ŋinituŋanan ekeropit kwape ajaar akeitaaritoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.8",
            "verseOrgIds": [
              "1CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.3+MAT.13.4+MAT.13.5+MAT.13.6+MAT.13.7+MAT.13.8+MAT.13.9"
              },
              "items": [
                {
                  "text": "Mat 13:3-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.20"
              },
              "items": [
                {
                  "text": "Pes 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kirai isio ikeswamak nepepe ka Edeke; iraas yesi amana naka Edeke, aduket naka Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.9",
            "verseOrgIds": [
              "1CO.3.9"
            ]
          }
        }
      ]
    },
