            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.29"
              },
              "items": [
                {
                  "text": "Asw 15:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuka asuban nueinakinitai aputosia; kijeni ebe, “Ejai sio kere aijen.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.1",
            "verseOrgIds": [
              "1CO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edakunun aijen, konye do eduki amin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.1",
            "verseOrgIds": [
              "1CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.3"
              },
              "items": [
                {
                  "text": "Gal 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai eomit ituŋanan ebe ejeni akirot, eriŋa ejenuna kwape ibusakinitor ajenun, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.2",
            "verseOrgIds": [
              "1CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.9"
              },
              "items": [
                {
                  "text": "Gal 4:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai emina ituŋanan Edeke, ejeni Edeke ŋin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.3",
            "verseOrgIds": [
              "1CO.8.3"
            ]
          }
        }
      ]
    },
    {
