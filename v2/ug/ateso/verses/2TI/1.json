                "loc": "ROM.8.15"
              },
              "items": [
                {
                  "text": "Rom 8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam Edeke abu koinak oni emoyo loka akurian, dimarai loka apedor ka loka amin, ka loka aiyapaarit da.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        }
