        },
        {
          "text": " konye kwana etakanun asianut ŋin kanuka aitodikinio naka Eketajaraniwok Kristo Yesu, loabu kitapalau atwanare, kitacau da aijar ka amamus aibos kanuka Akiro Nukajokak, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
