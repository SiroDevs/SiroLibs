              "items": [
                {
                  "text": "Tit 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojau kaanyunet naka akiro nuka aijar nuibu kopup kamakaŋ, kotoma aiyuun ka amin naejai toma Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
