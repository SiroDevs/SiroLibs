                  "text": "1 Tim 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidarenenei ibore yenejok yenikititiŋitai kanuka Emoyo Lokalaunan loiboie kotomawok.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
