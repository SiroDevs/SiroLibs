                  "text": "Asw 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakesiitunere aiyuun namam esoswai naejai kotomakon, naageuni aiboi kotoma tataakon Lois, ka totokon Eunike; ido etogogoŋit ebe ejai kotomakon da, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
