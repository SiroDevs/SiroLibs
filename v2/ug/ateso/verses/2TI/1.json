                "loc": "1TH.5.19"
              },
              "items": [
                {
                  "text": "1 Ses 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.14"
              },
              "items": [
                {
                  "text": "1 Tim 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes kesiitunio jo aitunyonokin ainakinet naka Edeke naejai kotomakon, kanuka aidokokinio akaninika, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
