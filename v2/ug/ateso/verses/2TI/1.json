                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " loabu kitajar oni, konyarau da anyarit nakalaunan, mere kwape ejaatar aswamisiowok, dimarai kwape ejaar alosikiniteke elopet ka asianut, naabu koinak oni kotoma Kristo Yesu eriŋa apakio nuka ikar, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
