              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lumam eminanara, Iuiketara, ikasabak, lumam itikokinos, ikadedeŋak, lumam eminas ajokis, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
