        },
        {
          "text": "“Kosodi rwaru, nailomaria akwap nakiinakini EJAKAIT Ekonideke araun airumet, irumi, iboikin nen: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
