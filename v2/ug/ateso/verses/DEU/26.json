            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Ikis 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilemuni nugeet nuka araito kere nuka alup, nuidwenyi kakwapukon nukiinakini EJAKAIT Ekonideke; kipikak odita kolot aibois naeseuni EJAKAIT Ekonideke aisiboikin ekekiror. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ilosi mama ejai esasedoti loejai kapaarasia kaŋun, kolimok ebe, ‘Alimo eoŋ lolo EJAKAIT Ekonideke ebe alom akwap nakolo eyapoik EJAKAIT lukapapaawok ainakin oni.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elemuni da esasedoti edita kakanikon, kipikak kiŋaren ketem loka EJAKAIT Ekonideke.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        }
      ]
    },
