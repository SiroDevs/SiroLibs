            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mam ekajenan ediopet enyoikini ituŋanan kanuka numam adolit, karaida kanuka adiakaret, kadiakaret kere naediakari: kakiro nuka ikajenak iarei arai kakiro nuka ikajenak iuni ŋes itogogoŋere akirot. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
