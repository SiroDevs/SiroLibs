                  "text": "Dan 6:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes konyet ikwaikiniata ŋes kwape aomitor ŋesi aikwaikin onaceke: ilemari kwaŋin aronis kamakon. ",
          "type": "text",
          "attrs": {
