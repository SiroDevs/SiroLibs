            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kiwadika amor kwape ajaatar aiwadikaeta nusodit, aicorakineta atomon, nuabu EJAKAIT kolimok yes komoru kokidiŋ kakim kapaaran naka atukokin: kainak EJAKAIT eoŋ kes. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "verse",
