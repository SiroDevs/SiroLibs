          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyout kanen kolototo Gudugoda; konyout koGudugoda kiton Yotobata, akwap naka aguurun nuka akipi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
