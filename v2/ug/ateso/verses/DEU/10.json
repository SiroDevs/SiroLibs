                "loc": "1KI.8.9"
              },
              "items": [
                {
                  "text": "1 Ika 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kebelokin, kejesun komoru, kebwaik da amor toma asaduku naabu kekeu; ejaas nepenen, kwape abu EJAKAIT kecorakinia eoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
