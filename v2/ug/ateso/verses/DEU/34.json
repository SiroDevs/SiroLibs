        },
        {
          "text": " Kwaŋin kotwanik Musa ekejaanakinan loka EJAKAIT akwap naka Moab, kwape ajaar akirot naka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
