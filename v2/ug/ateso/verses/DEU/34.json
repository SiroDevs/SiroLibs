              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka Eŋalakimak, ka Apuuton naka aditot naka Yeriko ere loka idukudukun kiton Soar. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.3",
            "verseOrgIds": [
