            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam bobo ejauna enabi koIsirael loeputos ka Musa, loanyununos ka EJAKAIT: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotoma aanyuneta kere ka nukaumokin, nuejukari EJAKAIT ŋes aiswamakin Parao, ka ikekejaanakinak kere, ka akwapuke kere, kakwap nako Misiri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotoma akan nakagogoŋ, ka etasuro kere loepol, loabu Musa kiswama kakonyen nuka Isirael kere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
