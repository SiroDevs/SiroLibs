              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidaik ŋes aditot akwap naka Moab naitei Bet-peor: konye emamei ituŋanan yenejeni atesike kiton lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
