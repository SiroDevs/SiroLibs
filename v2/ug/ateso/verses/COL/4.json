          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai etejenaara kanukeŋ ebe itaaritoi ŋesi noi kanukus, kanuka luko Laodikia da, kanuka luko Kierapoli da. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
