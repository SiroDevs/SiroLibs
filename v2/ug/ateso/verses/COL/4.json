          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido naidauniata yesi asoman ebalua lo, kosiomata da kotoma okanisa loka Laodikia; kosiomata yesi da loebuni koLaodikia. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
