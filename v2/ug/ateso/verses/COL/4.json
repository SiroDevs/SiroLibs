              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyogai yes Epapurasi, loerai lokobukus, ebulesit loka Kristo Yesu, euta apaarasia kere kanukus kotoma ailipike, tetere ibwoenenete kopolok, kitogogoŋito da kere nuekot Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
