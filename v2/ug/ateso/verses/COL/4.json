            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyogai yes Luka emurwon lominat, ka Dema da. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
