              },
              "items": [
                {
                  "text": "1 Ika 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojotoor do Abiya kalukapapaake, aponi kidaikinai ore loka Daudi, kirum Asa okokuke aiboisike: kapaarasiake kiyamakin akwap ikar itomon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.1",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswama Asa nuejok ka nuedolito kakonyen nuka EJAKAIT Ekedeke: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.14"
              },
              "items": [
                {
                  "text": "1 Ika 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.17"
              },
              "items": [
                {
                  "text": "2 Siit 15:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.13"
              },
              "items": [
                {
                  "text": "Any 34:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.7"
              },
              "items": [
                {
                  "text": "1 Ika 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai kolema ŋesi itemwan lumo, ka aiboisio nuiceleleete, kobilibil ipirin, kojepejep Aserim: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kicorak Yuda amoot EJAKAIT, Edeke loka lukapapaakec, ka aricenen ikisila ka aicorakineta, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolema da koreria kere luka Yuda aiboisio nuiceleleete ka aputosia nuka akoloŋ: kiyamakina ajakanut kakonyeneke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koduk ireria luebwaitai koYuda: naarai eyamakina akwap, amamei ejie kokar kaŋul; naarai abu EJAKAIT kisiyeŋu ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kotema ŋesi Yuda atiar, “Kadukoto ireria lu, kerigaut karwatatin, ka itogoi lueojak, ikirigin ka atiketa; eriŋa akwap ejai kakonyenewok, naarai kimoot oni EJAKAIT Ewokodeke; kimoot ŋes, abu ŋesi da kisiyenu oni kaŋoliwai.” Kosodete kodukoto, kokeriakaros. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejaas Asa kajore nakedakit ibukui ka akwaras, ilukumin akwat auni koYuda; koBenyamin da, lukedakitos ibukui ka aiket akabwai, ilukumin akwat aarei ka ilukumin akaisakanykauni: ŋul kere keraas ituŋa lukirigin luetitiŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.8",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.8"
              },
              "items": [
                {
                  "text": "2 Siit 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.44"
              },
              "items": [
                {
                  "text": "Yos 15:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.15"
              },
              "items": [
                {
                  "text": "Mik 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolom Sera Etiopiat asurokin kes ejaas kajore naka ilukumin elukumit, ka agalin akwat auni; kobu ŋesi Maresa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koloma do Asa airiamakin, kiderakinos ejie kaditot naka Sepata koMaresa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
