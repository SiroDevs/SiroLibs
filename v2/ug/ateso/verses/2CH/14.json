                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Korukitor Asa ka ituŋa lukejaas kaŋes kiton Gerar: kibiroros luipu noi luka Itiopian komam epedorete ajtaiara bonik; naarai amudiaros kakonyen nuka EJAKAIT, kakonyen nuka ajoreke da; koyaŋaasi luŋatuna luipu noi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
