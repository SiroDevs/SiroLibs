                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodanyata lukoreria kere luirimorito Gerar; naarai kobunoki kes etasuro loka EJAKAIT: koŋata ireria kere; naarai kejaas luŋatuna luipu tomakec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        },
        {
