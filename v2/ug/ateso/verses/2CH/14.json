            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komonyak Asa EJAKAIT Ekedeke, kotema atiar, “EJAKAIT, emamei lokiŋarakini kilema ijo, kidin ka lokagogon ka loemamei agogoŋ; kiŋarakinai sio, wu EJAKAIT Ekosideke; naarai kigonakina jo, kokirorikon ŋes kilomunia asurokin ekodet lo loepol. Wu EJAKAIT, irai ijo Ekosideke; kinyek etuŋanan aipikor jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.15"
              },
              "items": [
                {
                  "text": "2 Siit 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodany do EJAKAIT Itiopian kakonyen nuka Asa, kakonyen nuka Yuda da; kokerata Itiopian. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
