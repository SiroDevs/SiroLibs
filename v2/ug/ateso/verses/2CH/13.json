              "items": [
                {
                  "text": "2 Siit 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete ituŋa luka Yuda eibwoŋ: napibwoŋas ituŋa luka Yuda, kosodi kanen, kodany Edeke Yeroboam ka Isirael kere kakonyen nuka Abiya ka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokerata idwe luka Isirael kakonyen nuka Yuda: kijaik Edeke kes akanikec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
