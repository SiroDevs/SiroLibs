            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye konyou Yeroboam okoku loka Nebat, ekejaanakinan loka Solomon okoku loka Daudi, kipaliik ekejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
