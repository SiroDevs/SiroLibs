          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koar Abiya ka ituŋake kes kearit loepol: kibiroros luaaritai luka Isirael ituŋa ilukumin akwat akany lueseunitai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
