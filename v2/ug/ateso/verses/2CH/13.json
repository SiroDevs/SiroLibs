                "loc": "JOS.18.22"
              },
              "items": [
                {
                  "text": "Yos 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobwo Abiya komoru Semaraim loejai kakwap nakiukon naka Epuraim, kotema atiar, “Kopupokinai jo Yeroboam ka Isirael kere; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
