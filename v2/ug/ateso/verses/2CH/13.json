              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kitolot Yeroboam ikaperunok kokaukec: kojaas kes kiŋaren ka Yuda, ka ikaperunok kaukec, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenoliasi luka Yuda kau, koany, keiai ejie kinaren, kokaukec da: kiworoto mama ejai EJAKAIT, kokuta isasedotin arupepen. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
