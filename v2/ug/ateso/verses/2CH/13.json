            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokaru lokitomonet kakanykauni loka ekabaka Yeroboam kogeu Abiya airum Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.20"
              },
              "items": [
                {
                  "text": "2 Siit 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kirumak ikar iuni koYerusalem: ekiror loka totoke kerai Mikaia akoku naka Uriel loka Gibea. Kejai ejie kidiŋ Abiya ka Yeroboam,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
