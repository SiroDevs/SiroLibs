        },
        {
          "text": " Mam bobo abu Yeroboam kogogoŋor kapaarasia nuka Abiya: kinom EJAKAIT ŋes, kotwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
