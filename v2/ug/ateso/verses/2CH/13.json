            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolot Abiya kajore naka ikajiok luetitiŋ, kes ituŋa ilukumin akwat aoŋon lueseunitai asurokin: kiderakin Yeroboam ejie kaŋes kituŋa ilukumin akwat akanykauni lueseunitai, lukeraas ikirigin luetitiŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
