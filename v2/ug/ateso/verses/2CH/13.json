              "items": [
                {
                  "text": "Asw 17:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukonokinos ituŋa luutai mama ejai, odwe luka Belial, lukitogogoŋete asurokin Rekoboam okoku loka Solomon, korai Rekoboam esapat, loka etau loenonok, komam kepedori aitikokin kes.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
