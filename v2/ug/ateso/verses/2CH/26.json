              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kibwaik etau amoot Edeke kapaarasia nuka Sekaria, lokituutoori aiyoŋ Edeke: kapaarasia nuamootor EJAKAIT kitekerian Edeke ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
      ]
