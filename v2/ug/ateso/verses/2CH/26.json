            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma ŋesi, kitiji Ipilisitian, kotiyatiya arwatat naka Gat, ka arwatat naka Yabane, ka arwatat naka Asudod; koduk ireria kakwap naka Asudod, kaneejaas Ipilisitian da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
