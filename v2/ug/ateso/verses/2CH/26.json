                {
                  "text": "Sek 14:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koduk Usia itogoi lueojak Yerusalem, korute loka agor, korute da loka aditot, ka neekudokinia arwatat da, kitogogoŋ kes, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.16"
              },
              "items": [
                {
                  "text": "2 Siit 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koduk itogoi lueojak kamodiŋ, kobok ataparin nuipu, naarai ajaas ŋes kibaren nuipu ajesa kapuutona da; ajaas ikakoriok ka ikacapak emusabibu koroŋan komanikoria lupusuk da; naarai komina ŋesi noi akoru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ajai Usia ajore naka ikajiok lualomanarete ojie korioŋeta, kwape ajaar etiai loka aimarakec loemari Yeiel ekewadikan ka Maaseia ekapolokiton, kakan naka Kanania, ediopet kokapolok luka ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiai kere loka ikapolok luka ikekia luka lukapapaakec, ituŋa lukirigin luetitiŋ emwaasi ilukumin iarei ka akwat akanykape. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakanikec ajai ajore naetuutooro ilukumin akwat auni ka lukanykaarei ka akwat akany, luajiononos kagogoŋ naepol, aiŋarakin ekabaka asurokin lukasurup. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitemok Usia ibukui, ka akwaras, ka ikopiran, ka ikootin lukasua, ka akabwai, ka alica nuporoca kanukec, ŋes ajore kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamau koYerusalem acuman, nuapwakunete ituŋa luepiriaka, ajaut kotogoi Iueojak karwatatin nuitogogoŋio, agumia imalia ka amor nuepolok. Kisiarakin ekekiror kama ejwana; naarai kiŋarakinitai noi noi, aitodol nakegogonoror,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
