                {
                  "text": "Yer 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Epol etogo loaduki eoŋ: naarai epol Ekosideke adepar idekesio kere, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.5",
            "verseOrgIds": [
              "2CH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.27"
              },
              "items": [
                {
                  "text": "1 Ika 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.18"
              },
              "items": [
                {
                  "text": "2 Siit 6:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.1"
              },
              "items": [
                {
                  "text": "Isa 66:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye iŋai epedori adukokin ŋes etogo, naarai mam akuj, ka akuj naka akuj epedori ailosikin ŋes? Aso iŋai bo eoŋ, adukokin ŋes etogo, dimarai aisupuruun lueuru maa kakonyeneke? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.6",
            "verseOrgIds": [
              "2CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.15"
              },
              "items": [
                {
                  "text": "1 Siit 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do kijukakinai eoŋ etuŋanan loepiriana aswam kesabu, kepuesa, kaisinin, kasua, ka lomuge, ka Iokareŋan, ka lobululu, loepiriana aigir iponesio kere luigirio, ajaun kituŋa luepiriaka luejaas keoŋ ko Yuda ka Yerusalem, luabu Daudi papaka kodumunite. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.7",
            "verseOrgIds": [
              "2CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.6"
              },
              "items": [
                {
                  "text": "1 Ika 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.11"
              },
              "items": [
                {
                  "text": "19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijukakinai da ikito luka eres, ka ikito luka eberos, ka ikito lukajokak koLebanon: naarai ajeni ebe epiriaka ikonikejaanakinak aijep ikito koLebanon; ido koany, ejaununos ikakejaanakinak kaikonikejaanakinak, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.8",
            "verseOrgIds": [
              "2CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "aitemonokin akito nuipu noi: naarai etogo loakoto aiduk eraun loepol lokaumokin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.9",
            "verseOrgIds": [
              "2CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.11"
              },
              "items": [
                {
                  "text": "1 Ika 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, ainakini ikonikejaanakinak, luejepete ikito, aitemisio alukumin akaisaarei nuka alos nuecomom, ka aitemisio alukumin akaisaarei nuka esairi, ka akaalakanya alukumin akaisaarei nuka ebino, ka akaalakanya alukumin akaisaarei nuka akinyet.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.10",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        }
      ]
