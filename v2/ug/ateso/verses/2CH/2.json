              },
              "items": [
                {
                  "text": "1 Ika 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidenyak do Solomon adukokin ekiror loka EJAKAIT etogo, ka etogo loka ajakanutuke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.15"
              },
              "items": [
                {
                  "text": "1 Ika 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotiaku Solomon ituŋa ilukumin akaisakanykaarei aibwok abwokon, ka ituŋa ilukumin akaisakanykauni luajepete koroŋan, ka ilukumin iuni ka akwat akanykape luayaito kes. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.14.1"
              },
              "items": [
                {
                  "text": "1 Siit 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka Solomon mama ejai Kuram ekabaka loka Turo ebe, “Kwape kikonakinia ijo Daudi papaka, kijukak nes iresia adukokin etogo aiboio kotoma, kikonak eoŋ da kwaŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.7"
              },
              "items": [
                {
                  "text": "Any 30:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.30"
              },
              "items": [
                {
                  "text": "25:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.8"
              },
              "items": [
                {
                  "text": "Leb 24:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.4"
              },
              "items": [
                {
                  "text": "Mat 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.38+EXO.29.39+EXO.29.40+EXO.29.41+EXO.29.42"
              },
              "items": [
                {
                  "text": "Any 29:38-42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.3"
              },
              "items": [
                {
                  "text": "Mar 28:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, adukokini eoŋ ekiror laka EJAKAIT Ekadeke etogo, atiakun kanuke, aicweenen kakonyeneke lukisupurununo lueuru maa, kanuka emugati lokaitodikin lotir, kanuka ainakineta nuicweio tupuruc ka eboŋ, kasabaton, ka napilamununei elap, kopucin da lueseunitai luka EJAKAIT Edekekosi. Erai ŋin aicorakinet naka ikar kere koIsirael. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.4",
            "verseOrgIds": [
              "2CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
