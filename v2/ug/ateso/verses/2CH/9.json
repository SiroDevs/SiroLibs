                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " adepar luainunete ikemutunok ka ikagwelanarak; apotu ikabakan kere luka Arabia ka ikayaitok luka akwap koinut Solomon esabu ka epuesa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamau ekabaka Solomon ibukui lukapolok akwat aarei luka esabu loerukuk: ŋolibuku lokapolon abu koya isekelin akwat akanykape luka esabu loerukuk. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamau ŋesi ibukui akwat auni luka esabu loerukuk; ŋolibuku abu koya isekelin akwat auni luka esabu: kibwaik ekabaka kes togo loka ikito luka Lebanon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo da kiswamau ekabaka eicoloŋ lokapolon loka ikel luka etom, kiladaa ŋes kesabu loelai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejaas adoketa akanykape oicoloŋ, kojai da iicoloŋ yenika akeje yenika esabu, yenirotakinio keicoloŋ, keŋaas akanin epuai kepuai kaibois neiboiere, ka iŋatunyo iarei luabwoete kawaitin nuka akanin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
