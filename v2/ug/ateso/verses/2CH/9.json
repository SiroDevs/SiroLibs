          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komoata ikabakan kere luka akwapin aanyun Solomon, akiirar acoake, nakibwaikinit Edeke otauke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
