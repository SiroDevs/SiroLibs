              "items": [
                {
                  "text": "1 Ika 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibulesin da luka Kuram, ka ibulesin luka Solomon lukeyaununete esabu koOpir, koyaut da ikito lukajokak ka amor nuka akais nuipu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekabaka kiswamau itutio luka etogo loka EJAKAIT, ka luka etogo loka ekabaka, ka adeudeun ka isabulin luka ikayook: mam apeŋo eanyuna lueputos kaŋul kakwap nako Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
