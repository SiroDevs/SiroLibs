              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobwaata iŋatunyo itomon ka luarei epuai kepuai kadoketa akanykape; amamei loaputos kaŋol kajakanut kere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
