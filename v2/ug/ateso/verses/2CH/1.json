            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kakuare kaŋin kitaanyikin Edeke Solomon, kotema ŋes atiar, “Kilipai nakainakini jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
