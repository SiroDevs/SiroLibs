            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiner Solomon ka Isirael kere, ikapolok luka ilukumin ka luka akwat, ikatubok, ka ŋolikapolon koIsirael kere, ikapolok luka ikekia luka lukapapaakec, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 1:3"
          },
          "items": [
