              "items": [
                {
                  "text": "Ikis 31:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso koinakinai do acoa ka aijen, tetere alomanari alomununei da kakonyen nuka ituŋa kalu: naarai iŋai epedori atubokin ikonituŋa lu luipu?” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        },
