          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.5"
              },
              "items": [
                {
                  "text": "1 Siit 28:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Solomon Edeke atiar, “Ibu ijo kitodik Daudi papaka asianut naepol, kitarau eoŋ ekabaka aiboisike, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.7"
              },
              "items": [
                {
                  "text": "1 Ika 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwana, wu EJAKAIT Edeke, kicat aisumunetckon mama ejai Daudi papaka: naarai kidakak eoŋ araun ekabaka loka ituŋa luesubito bala apua naka alup kaipues. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
