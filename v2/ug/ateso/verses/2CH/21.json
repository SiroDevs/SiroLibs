              "items": [
                {
                  "text": "Sab 132:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye mam EJAKAIT akoto amudiar ekek loka Daudi, kanuka aitutuket naetutukit ka Daudi, kwape kisumunio da ainakin ŋes ka odweke atala ikar kere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        }
