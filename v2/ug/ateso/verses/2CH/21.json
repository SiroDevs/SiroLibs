              "type": "text"
            }
          ]
        },
        {
          "text": "Akaulo kaŋun kere kinom EJAKAIT ŋes akoikike kadek namam epedor aŋaleun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
