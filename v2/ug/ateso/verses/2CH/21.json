                "loc": "NEH.13.26"
              },
              "items": [
                {
                  "text": "Nek 13:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolosenenei korot loka ikabakan luka Isirael, kwape kalukokek loka Akab: naarai amanyit akoku naka Akab: kiswama nueroko kakonyen nuka EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
