            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisidik EJAKAIT emoyo loka Ipilisitian ka Iarabun luidunyas ka Itiopian asurokin Yekoram. ",
          "type": "text",
