                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka Baalat, ka ireria kere lukaiŋad lukejaas ka Solomon, ka ireria kere luka agalinike, ka ireria luka ikebwanenokoke, ka kere luakoto Solomon aiduk aisiyalamikinor kotoma Yerusalem, ka Lebanon, ka akwap kere naka airumuke, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
