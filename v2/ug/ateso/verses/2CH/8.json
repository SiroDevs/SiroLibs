              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, ketuboros ikar akaisaarei luadukio Solomon etogo loka EJAKAIT, ka etogoke da elopet, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
