          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "luka idwekec luedeunos kakes kakwap, lumam idwe luka Isirael emudiara, kolemununei Solomon ikitubusiana kamakee, kiton lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
