            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koduk da Bet-koron Ioimukurur, ka Bet-koron loijesara, ireria luabwaitai, lukejaas arwatatin, ka ikirigin, ka atiketa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
