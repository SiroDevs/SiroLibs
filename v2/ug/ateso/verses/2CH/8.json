          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ireria luabu Kuram koinak Solomon, koduk Solomon kes, kisiboik idwe luka Isirael ŋina.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
