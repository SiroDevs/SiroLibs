                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodukok Tadumor amodiŋ, ka ireria kere lukaiŋad luadukokini Kamat, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
