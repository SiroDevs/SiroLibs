        },
        {
          "text": " Ituŋa kere da luedeunos luka Ikitin, ka Imorain, ka Iperisin, ka Ikibin, ka Iyebusin, lumam keraas luka Isirael; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
