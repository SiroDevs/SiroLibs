                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kobu akirot naka EJAKAIT mama ejai Semaia etuŋanan loka Edeke ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolimok Rekoboam okoku loka Solomon, ekabaka loka Yuda, ka Isirael kere luejaas koYuda ka Benyamin, ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.3",
            "verseOrgIds": [
              "2CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Inera EJAKAIT kwanata ebe, Mam ilosete, ido mam ijiikinos kikusiinacan; koboŋo ŋolituŋanan togoke; naarai erai akirot na nakaŋ.’’’ Kosodete kopuput akiro nuka EJAKAIT, koboŋosi kasurokin Yeroboam.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        }
      ]
    },
