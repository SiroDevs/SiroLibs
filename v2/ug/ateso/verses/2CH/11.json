            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koduk do Ber-lekem, ka Etam, ka Tekoa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.6",
            "verseOrgIds": [
              "2CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
