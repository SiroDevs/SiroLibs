          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Adoraim, ka Lakis, ka Aseka, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.9",
            "verseOrgIds": [
              "2CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Sora, ka Aiyalon, ka Keburon, luejaas ko Yuda ka Benyamin, ireria luebwaitai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitogogoŋ ireria lukagogon, kibwaik ikapolok toma, ka imono, ka akinyet ka ebino. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibwaik ibukui ka akwaras toma ŋolire kere, kitogogoŋ kes noi noi. Koraas Yuda ka Benyamin luke.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        }
      ]
    },
