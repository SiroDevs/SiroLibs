          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komina Rekoboam Maaka akoku naka Abisalom adepar akeŋor kere ka akebusian: (naarai komany aŋor atomon ka nukanykauni, ka abusian akaisakanykape, kouri idwe lusap akaisaarei ka lukanykauni ka lupesur akaisakanykape.) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.21",
            "verseOrgIds": [
              "2CH.11.21"
            ]
          }
        },
