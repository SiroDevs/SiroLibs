                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kourik ŋes odwe; Yeus, ka Semaria, ka Sakam. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
