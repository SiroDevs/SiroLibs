            "sid": "2CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Bet-sur, ka Soko, ka Adulam, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.7",
            "verseOrgIds": [
              "2CH.11.7"
            ]
