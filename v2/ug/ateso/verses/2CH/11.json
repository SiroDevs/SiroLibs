                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kotoma atekerin kere nuka Isirael, luebwaikinito itauonokec amoot EJAKAIT, Edeke loka Isirael, apotu kotupasi Ilebin, kopotu Yerusalem ainakin asuban mama ejai EJAKAIT, Edeke loka lukapapaakec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
