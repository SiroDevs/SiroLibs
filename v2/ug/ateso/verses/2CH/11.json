          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Gat, ka Maresa, ka Sip, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.8",
            "verseOrgIds": [
              "2CH.11.8"
            ]
          }
        },
