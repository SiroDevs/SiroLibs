          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "aŋolol adiopet, ka imoŋin itomon ka luarei kwapuke, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
