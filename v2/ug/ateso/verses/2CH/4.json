              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kiswamau da aicegeria, kiswamau akalayan nuka aicegeria; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
