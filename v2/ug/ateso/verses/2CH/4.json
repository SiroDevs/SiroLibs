                {
                  "text": "1 Ika 7:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamau Kuram amoti, ka initia, ka atanyia. Kodau do Kuram aswam naabu kiswamak Solomon ekabaka kotogo laka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.41"
              },
              "items": [
                {
                  "text": "1 Ika 7:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ipirin iarei, ka atiboi, ka akwes aarei nukeiaas kuju opirin; ka iboyan iarei arapia atiboi aarei nukejaas kuju opirin; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
