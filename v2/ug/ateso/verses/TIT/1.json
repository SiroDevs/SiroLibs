            "sid": "TIT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka nu ŋes kenyeinia jo koKurete, tetere iteteni nuideuna, kodakak da imakio kaŋolire kwape kecorakinia jo, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.2+1TI.3.3+1TI.3.4+1TI.3.5+1TI.3.6+1TI.3.7"
              },
              "items": [
                {
                  "text": "1 Tim 3:2-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " arai ejai loemamei aitoronet, ekiliokit loka aberu adiopet, loiyuunito ikedwe, komam iwosatai ebe eraas luka iponesio lutai, ka luetumaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
