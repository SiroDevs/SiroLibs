            "number": "2",
            "style": "v",
            "sid": "TIT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotoma amun naka aijar naka ikar kere, naabu Edeke, lomam iŋalai, kisumun eriŋa apakio nuka ikar, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.2",
            "verseOrgIds": [
