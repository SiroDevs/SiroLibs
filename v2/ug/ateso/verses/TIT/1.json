                "loc": "2TI.3.5"
              },
              "items": [
                {
                  "text": "2 Tim 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elimorete ebe ejenete Edeke, konye eŋerito ŋes kaswamisiokec; eraas luesacitai, luiulaka, luegiritoi da kaŋiniswam kere naejok.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
            "verseOrgIds": [
              "TIT.1.16"
            ]
          }
        }
      ]
