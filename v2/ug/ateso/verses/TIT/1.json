            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asianut ka ainapakin nuepote kama ejai Edeke Papa, ka Kristo Yesu da Eketajaraniwok.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
