              "items": [
                {
                  "text": "2 Tim 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " loericit akirot naka aiyuun kwape ejaar aisisianakin, tetere epedori aicor kotoma aisisianakin naka aijar, bobo da aitoron luirebirebete. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ejaas luetumaaka luipu, luinerasi aamameak, ka luiŋalas da, aitelekarit lueraas luekepitai. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.6"
              },
              "items": [
                {
                  "text": "Tit 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.12"
              },
              "items": [
                {
                  "text": "Yok 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.2"
              },
              "items": [
                {
                  "text": "1 Pet 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibusakinit aisililiŋ kes, naarai itotolikinete ituŋa kere lukokalia, isisianakinete numam ibusakinit kes aisisianakin, kanuka ameda nakileic. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ediopet kakesi, enabikec kikulepek, kobala ebe, “Eraas Ikureton ikeŋalak apaarasia kere, itiaŋ lueroko, ikeraŋak lueloŋwaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.2"
              },
              "items": [
                {
                  "text": "2 Tim 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aitejenunet ŋin erai nakabeit da, Kanuka ŋun kitoron kes kadedeŋ, tetere eŋaleete kotoma aiyuun, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kinyeis acoit awaragasia nutai nuka Iyudayan, ka aicorakineta da nuka ituŋa luepaarete ainyein abeit, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.11"
              },
              "items": [
                {
                  "text": "Mat 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.20"
              },
              "items": [
                {
                  "text": "Rom 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elaete iboro kere mama ejaas luelaete. Konye emamei ibore yenelai mama ejaas luemunaara ka lumam iyuunito; konye emunaara do adamakec ka aomisiokec da. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
