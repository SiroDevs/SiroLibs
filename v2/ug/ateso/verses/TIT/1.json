                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.24"
              },
              "items": [
                {
                  "text": "2 Tim 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ibusakinit ekaanyanaran araut loemamei aitoronet, kwape ekeŋadan loka Edeke; mere loisiyalamikina bon, mere loenyunyurana, lomam emer, lomam ibuŋai, lomam iŋobelei apesan, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "konye loisukunyikini ipejok, loemina ajokis, loecoit, loedolit, lokalaunan, loitikokina da; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
