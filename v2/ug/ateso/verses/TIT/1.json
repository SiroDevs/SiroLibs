            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.10"
              },
              "items": [
                {
                  "text": "1 Tim 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.3"
