              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ainakini ikoniboro, ka abarakon anatario komamei etiai, kanuka aronisiokon kere, koikorunokon kere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
