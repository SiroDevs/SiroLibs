                  "text": "Apu 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen arai kiremarete jo atiar, ‘Ai bo kilomaria?’ Ŋes konyet ilimokinia kes ebe, ‘Ebala EJAKAIT kwanata ebe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
