        },
        {
          "text": "“Ebala EJAKAIT ebe, Aseikini kes iponesio iwonon: ekileŋ aaria, iŋokwo apoopoia, akweny nuka apak ka itiŋŋ luka akwap aipinyaria ka amudiaria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
