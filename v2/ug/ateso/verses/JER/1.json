            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akiro nuka Yeremia okoku loka Kilikia, lokonabin luajaas Anatot akwap naka Benyamin, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
