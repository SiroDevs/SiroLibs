              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13+2CH.36.14+2CH.36.15+2CH.36.16+2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "11-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu da kapaarasia nuka Yekoiakim okoku loka Yosia, ekabaka loka Yuda, kiton osaŋe loka ekaru lokitomonet kalodiop loka Sedekia okoku loka Yosia, ekabaka loka Yuda; kiton neejoreorere luko Yerusalem olap lokikanyet,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
