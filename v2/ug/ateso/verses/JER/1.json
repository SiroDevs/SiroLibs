            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.3"
              },
              "items": [
                {
                  "text": "Yer 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Ika 22:3–23:27; 2 Siit 34:8–35:19.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Loabuni akirot naka EJAKAIT mamakeŋ kapaarasia nuka Yosia okoku loka Amon, ekabaka loka Yuda, kokaru lokitomonet kauni loka airumuke. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
