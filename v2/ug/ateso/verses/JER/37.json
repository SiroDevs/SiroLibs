              "attrs": {
                "loc": "2KI.24.19"
              },
              "items": [
                {
                  "text": "2 Ika 24:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.20"
              },
              "items": [
                {
