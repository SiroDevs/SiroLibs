        },
        {
          "text": " Kirum Sedekia okoku loka Yosia ekabaka, aibois naka Konia okoku loka Yekoiakim, loesurumi Nebukadaresar ekabaka loko Babulon akwap naka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
