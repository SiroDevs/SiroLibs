                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi keloma Yeremia togo loka aipany, kiton igolai, kiboi Yeremia kaŋina apaarasia nuipu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kosodi kijuk ekabaka Sedekia aomare ŋes: kinit eka baka ŋes kaiyeiyea kotogoke, atiar, “Ejai tope adiokirot naka EJAKAIT?” Kobala Yeremia ebe, “Ejai bo.” Kobala bobo ebe, “Kiinakinio jo akan naka ekabaka loko Babulon.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema bobo Yeremia ekabaka Sedekia atiar, “Nunyoika adiakaa kamakon, arai kokejaanakinakakon, arai kotuzja lu, tape kigolokinete aenis? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.18",
            "verseOrgIds": [
              "JER.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alu bo kwana inabinokus lukiidwarakinete ebe, ‘Mam ebuni ekabaka loko Babulon asurokin yes, karaida akusikwap’? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.19",
            "verseOrgIds": [
              "JER.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso kwana, kiirarai, wu ekaiakait ekabaka, kenainair: kodolok akailip mamakon, kenainait; sirikiinyakak togo loka Yonatan ekewadikan, kenye atwanikin ŋina.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.20",
            "verseOrgIds": [
              "JER.37.20"
            ]
          }
        },
        {
