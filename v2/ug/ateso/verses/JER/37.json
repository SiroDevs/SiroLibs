              "items": [
                {
                  "text": "Yer 38:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.6"
              },
              "items": [
                {
                  "text": "Asw 12:6",
