                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.10"
              },
              "items": [
                {
                  "text": "Apu 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyunyurikis ikapolok Yeremia, kibunata, kogolokis aenis togo loka Yonatan ekewadikan; naarai etuluoritai etogo ŋol aenis.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
