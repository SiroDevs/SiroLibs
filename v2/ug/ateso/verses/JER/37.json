              },
              "items": [
                {
                  "text": "Awa 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye mam ŋes, ka ikekejaanakinak, ka ituŋa luka akwap, mam apotu kiirasi akiro nuka EJAKAIT nuenera kama ka Yeremia enabi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
