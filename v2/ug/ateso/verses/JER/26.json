              "type": "text"
            }
          ]
        },
        {
          "text": " aso etuluori rwaru etogo lo aiput kwape Silo, ido etuluori ere lo araun ekenit kotoma atekerin kere nuka akwap.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
