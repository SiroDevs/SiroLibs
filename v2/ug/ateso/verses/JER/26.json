                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.8"
              },
              "items": [
                {
                  "text": "18:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Diat iirarete, kibelokin ninitunanan ainyein ekerot loerono; kasodi keitu ainyein aronis, naalosikinit aiswamakin kes kanuka aronis naka aswamisiokec. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
