                "loc": "MAT.26.61"
              },
              "items": [
                {
                  "text": "Mat 26:61",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete isasedotin ka inabin kobalasi ikapolok ka ituŋa kere ebe, “Ibusakinit ekesa lo atwanare; naarai adwaraki ere lo kwape iirariata yesi da ikulepek kakusiki.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        }
