            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakiirariata ikapolok luka Yuda mm, kodokasi enyounete kotogo loka ekabaka, kopotu togo loka EJAKAIT; kiboikinos neelomarere kokek lokitetet loka etogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
