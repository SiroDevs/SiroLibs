                "loc": "JER.7.13"
              },
              "items": [
                {
                  "text": "Yer 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " apuponokini akiro nuka ikabulesin inabin, lukejukanakini yes, kadilonokini tupuruc sek aiiukunun, konye mam yes ipupununete; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
