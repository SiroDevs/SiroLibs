          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kobala Yeremia ikapolok kere ka ituŋa kere ebe, “EJAKAIT ŋes kejukuni aidwar nuka etogo kala ka ere lo akiro kere nuiirasi yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
