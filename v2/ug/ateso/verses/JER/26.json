            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kolimonokini kes atiar, ‘Inera kwanata EJAKAIT atiar: Arai mam kipupete eoŋ, alosenen kokisilaka, luebwaikinit kakonyenekus, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
