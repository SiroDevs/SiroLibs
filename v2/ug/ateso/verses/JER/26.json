          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu isasedotin ka inabin ka ituŋa kere da kiirasi Yeremia inera akiro ŋun kotogo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
