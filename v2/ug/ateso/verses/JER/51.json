          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananata akiro nuka Yeremia ne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
