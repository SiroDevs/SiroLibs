            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ebala EJAKAIT ebe, Atacakini Babulon ka luibojete koKaludea kere kakonyenekus aronisikec kere naapotu kiswamakis Sion.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
