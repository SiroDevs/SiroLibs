            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen ketuboros apaarasia atomon, kobu akirot naka EJAKAIT mama ejai Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi konyarau ŋesi Yokanan okoku loka Karea, ka ikapolok kere luka irioneta luajaas kaŋes, ka ituŋa kere ageun ka ludidik kiton Iukapolok. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Inera kwanata EJAKAIT, Edeke loka Isirael, lokiijukaritos mama ejai alimor akusiilip kakonyeneke ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
