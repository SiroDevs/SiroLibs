            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai ibalas ebe, ‘Mam kiboikin akwap na’; komam irimarete eporoto loka EJAKAIT Ekusideke; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
            "verseOrgIds": [
              "JER.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibalas ebe, ‘Mam; konye kilosi akwap nako Misiri, nemam kianyuni ejie, kwabo mam kiirari eporoto loka arupepe, ido mam kiriebi eteŋei loka inyamat; ŋina ŋes kiboikin,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
