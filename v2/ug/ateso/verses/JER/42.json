            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido ainakini yes aitimio, tetere kitimi ŋesi yes, kisiboik akwapukus. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        },
