              "items": [
                {
                  "text": "Yer 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai ejok, arai erono, kirimari eporoto loka EJAKAIT Ewokodeke, lokijukarit isio jo mama ejai; tetere kiiaun ejok, arai kiirima eporoto loka EJAKAIT Ewokodeke.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
