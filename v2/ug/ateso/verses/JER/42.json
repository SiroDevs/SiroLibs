            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kotema enabi Yeremia atiar, “Keira yes; koany, elipi EJAKAIT Edekekus kwape ejaatar akusikiro; kosodi kanen akirot kere nakibonokini yes EJAKAIT, kalimokinete; mam kemunonikin adiokirot kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete kotemasi Yeremia atiar, “Korau EJAKAIT ekajenan lokabeit lomunot kamawok, arai mam kiswamai kwape ejaar akirot kere nakijukunia EJAKAIT Ekonideke mamakosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
