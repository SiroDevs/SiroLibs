                "loc": "ZEC.7.11"
              },
              "items": [
                {
                  "text": "Sek 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lolo da keteienu yes; konye mam ipotu korimasi eporoto loka EJAKAIT Ekusideke kakiro kere nukejukunia mama ijaas. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
