              "type": "text"
            }
          ]
        },
        {
          "text": " Kitodik EJAKAIT Ekonideke sio erot lokibusakinit aitorenen, ka akirot da nakibusakinit aiswamaenen.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
