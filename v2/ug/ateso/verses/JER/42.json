            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai iswamata nukaimod kotauonokus, yes ikulepek; naarai ipotu kijukasi eoŋ mama ejai EJAKAIT Ekusideke, ibalas ebe, ‘Kilipakinai kama ejai EJAKAIT Ewokodeke: kere da nueremari EJAKAIT Ewokodeke, kolimok sio, kiswamai isio da.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
