            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kicamutu aiboi kakwap kana, aso kaduki yes, kwabo mam kebirorete, kerai yes, kwabo mam karutorete; naarai eitok aronis naabu keswama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.10",
