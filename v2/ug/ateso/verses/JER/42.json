            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT ebe, Sirikikuriakata ekabaka loko Babulon, loikuriaka; sirikikuriakata ŋes, Naarai ajai eoŋ nepepe kayes aitajar, ka ayuun da yes kakanike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
