            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.10"
              },
              "items": [
                {
                  "text": "25:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.23"
              },
              "items": [
                {
                  "text": "Apu 18:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ebala kwanata EJAKAIT loka aioresio, Edeke loka Isirael ebe: Koany, etanaŋi kaibois kana, kakonyenekus, ido kotoma apaarasiakus, eporoto loka aitac, ka eporoto da loka aiyalama, eporoto loka eteran ka eporoto da loka ateran.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        }
      ]
    },
