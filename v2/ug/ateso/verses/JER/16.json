                  "text": "2 Tim 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iswamata yesi da nukaronok adepar lukapapaakus; naarai koany ituparete yesi ŋinituŋanan aninik naka eketau loerono, ineroto apupun eog. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
