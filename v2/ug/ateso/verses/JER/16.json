            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ijo atemar kes atiar: ‘Naarai ebala EJAKAIT ebe, Apotu lukapapaakus kajalata eoŋ, kotupata idekesio ice, kijaanakis kes, komaata kes, kaialata eoŋ, komam ericito ikakisila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
