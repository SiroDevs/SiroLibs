              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kobu akirot naka EJAKAIT mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.14"
              },
              "items": [
                {
                  "text": "Age 19:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sirikimany aberu, kwabo mam iwurikini idwe lusap ka lupesur aibois na. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ebala kwanata EJAKAIT nuka idwe lusap ka lupesur lukeurikinio aibois na, ido nuka nukatotokec nukeuriete kes, ido nuka lukapapakec lukeurikinete kes kakwap kana ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "etwakete kanuka adekesia nueroko. Emamuunete luekuudianete kes, karaida aida kes; eraunos kwape aoret kakwap. Ekileŋ ka eteŋei kes epiarete kes; eraunos atesinakec inyamat luka akweny nuka apak, ka itian da luka akwap.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
