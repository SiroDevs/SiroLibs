            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.40"
              },
              "items": [
                {
                  "text": "Yer 50:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.11"
              },
              "items": [
                {
                  "text": "Amo 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT ebe, Kwape amudiarere Sodom ka Gomora ka ireria kere luidunyatar, emameun ituŋanan yenejaun ŋina, kwabo emameun ikoku yenika ituŋanan yeniboikin nen. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
