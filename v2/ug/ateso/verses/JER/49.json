            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ebala EJAKAIT ebe, Eyapoikin elopet ebe eraun Bosura aumokinet, ka amorosit, ka ameie, ka ekenit da; eraunete ikereria kere amejei nutir.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.13",
            "verseOrgIds": [
              "JER.49.13"
            ]
          }
        }
