          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ainuni Elam ikwamin iwonon anyoun kariino aoŋon nuka akuj, ido eweliwelari mama ejaas ikwamin ŋul kere; emameun areker namam edolete luerenearitai luka Elam, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
