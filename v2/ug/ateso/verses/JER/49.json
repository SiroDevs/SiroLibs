              "items": [
                {
                  "text": "Yob 41:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, edokari kwape eŋatuny loebuni kamoni naka Yorodan asurokin aibois naegogoŋ: konye etekeri ŋes katipet; ido adakakini nin yenaseuni ayait ŋes, Naarai iŋai bo eputosi keoŋ? Ido iŋai bo kebwaikini apak? Iŋai da ekeeokon lokabwoikini eoŋ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.19",
            "verseOrgIds": [
              "JER.49.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.45"
              },
              "items": [
                {
                  "text": "Yer 50:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kiirasi ainerun naka EJAKAIT, naeneru kanuka Edom; kanun nuelosikinit mama ejaas luibojete koTeman: abeit iriarete kesi ludidik luka esipan; abeit eburunete anukiakee kanukee. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.20",
            "verseOrgIds": [
              "JER.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emarani akwap kanuka epororo loka aibirorikec; ejai acalanari, epupunio eporotoke kAŋolol Nakarenan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.21",
            "verseOrgIds": [
              "JER.49.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.13"
              },
              "items": [
                {
                  "text": "Yer 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, edokari eporori kwape kemorukaalet, loeterari akebebenoka asurokin Bosura: eraunos itauon luka ikirigin luka Edom kapaaran kaŋin kwape etau laka aberu naerieba aidoun.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        }
      ]
    },
