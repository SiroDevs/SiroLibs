              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.2"
              },
              "items": [
                {
                  "text": "Esk 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Esiarakini kes toma atekerin, numam lem kes ejenete karaida lukapapaakec: ejukari da ekileŋ atupakin kes, aitodol neamudiaria.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
