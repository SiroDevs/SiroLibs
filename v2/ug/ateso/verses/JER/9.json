                {
                  "text": "2 Kor 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye yeneolobobot koolobobote kana ebe kamisiikinit, ido kajeni eoŋ, ebe arai eoŋ EJAKAIT loeswamai nukasianut, nuketube, ka nukadolit da kakwap: naarai ebala EJAKAIT ebe, Kesiyalamikinito akiro ŋun.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        }
