            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT ebe, “Koany, epote apaarasia nueticania ŋul kere luekepep kotoma numam ekepepukec: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
