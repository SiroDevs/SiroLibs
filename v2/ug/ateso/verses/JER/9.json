            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT kwanata ebe, “Kinyek yenikacoa aolobobot kotoma acoake, kinyek da lokirigi aolobobot kotoma agogoŋuke, kinyek ekabaran da aolobobot kotoma abarake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        },
