            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabala EJAKAIT eoŋ atiar, “Isirael nakabononoran kau itodiara araun naedolit aitelekar Yuda naemodana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.22"
              },
              "items": [
                {
                  "text": "Isa 44:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.1"
              },
              "items": [
                {
                  "text": "Yer 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolot kolimonok akiro nu koseseni agolitomei, kiner atiar,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
