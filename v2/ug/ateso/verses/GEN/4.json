                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.3"
              },
              "items": [
                {
                  "text": "52:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou Kain kakonyen nuka EJAKAIT. Kiboienenei kakwap naka Nod, kari nakokide naka Eden. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.49.11"
              },
              "items": [
                {
                  "text": "Sab 49:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojenu Kain akeberu; kopotuu, kouru Enok: koduk ere, komaik ekiror loka okokuke Enok, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.17",
            "verseOrgIds": [
              "GEN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kouru Enok Irad: Irad kouru Mekuyael: Mekuyael kouru Metusael; Metusaelkouru Lamek. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.18",
            "verseOrgIds": [
              "GEN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komany Lamek aŋor aarei, nasodit ekekiror Ada, nakiareit ekekiror Sila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.19",
            "verseOrgIds": [
              "GEN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kouru Ada Yabal: ŋol ŋes papakec kanul kalueboienenete koweman, koiaas kibaren. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.20",
            "verseOrgIds": [
              "GEN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiror loka onaceke ŋes Yubal: ŋolŋes papakec kanul kalueramete adeudeun ka ŋul luekusete alamarun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.21",
            "verseOrgIds": [
              "GEN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sila da, abu kouru Tubal-kain, ekatatan loka ibore kere yenetubi yenikaisinit ka yenikasuat: kinacike ka Tubal-kain ŋes Naama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        }
      ]
