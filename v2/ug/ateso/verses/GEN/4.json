        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojenu Adam akeberu Keba; kopotuu, kouru Kain, kotema atiar, “Kainakin eoŋ ekes kama ejai EJAKAIT.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kouruunai bobo onaceke Abel. Ido koraun Abel ekecokon amerekekin, konye Kain koraun ekakorion alup. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen ketuboros apaarasia koyau Kain amio naka alup ainakin EJAKAIT asubanit. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.12"
              },
              "items": [
                {
                  "text": "Any 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.19"
              },
              "items": [
                {
                  "text": "34:19",
                  "type": "text"
                }
              ]
            },
            {
