          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.16"
              },
              "items": [
                {
                  "text": "Age 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ketuboros apaarasia akaisaoŋon konaa Noa adirisa naka ataker nakikei ŋesi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.6",
            "verseOrgIds": [
              "GEN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.4"
              },
              "items": [
                {
                  "text": "1 Ika 17:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka ekuruk, kirim aitodol nekeonikinioto akip kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.7",
            "verseOrgIds": [
              "GEN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijuka ajele aanyun arai eŋoŋaros akip kokwap; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.8",
            "verseOrgIds": [
              "GEN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.65"
              },
              "items": [
                {
                  "text": "Ikis 28:65",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye mam ajele kedumuna neisibworaria akekeje, kobono neejai ŋesi toma ataker, naarai ajaas akip akwap kere; korio ŋesi akekan kitiŋ ŋes kitolom toma ataker. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidarek apaarasia ace akanykaarei; kijuka bobo ajele alomar kataker; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.10",
            "verseOrgIds": [
              "GEN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.14"
              },
              "items": [
                {
                  "text": "Luk 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kobono ajele neejai ŋesi eboŋ; ido koany, etodit akiot naka eseitun nakedenuni: kosodi kojen Noa ebe eŋoŋaros akip kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.11",
            "verseOrgIds": [
              "GEN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidarek bobo apaarasia akanykaarei; kijuka ajele; mam bobo abu kobonu neejai.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kokaru lokakwat akanykape ka lodiopet, toma olap Iosodit, kapaaran nasodit naka elap, koonikis akip kakwap. Kopuko Noa arapetait naka ataker kite, ido koany, eonit akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotoma olap lokiareit, kapaaran nakakaisaarei kanukanykaarei naka elap, koono akwap.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
