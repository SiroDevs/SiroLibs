              "items": [
                {
                  "text": "Sab 104:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiitu Edeke Noa, ka ibore kere yenikajaran, ka ibaren kere lukeiaas nepepe kaŋes toma ataker: kitukut Edeke ekwam kitor akwap, kinoŋaros akip. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.11"
              },
              "items": [
                {
                  "text": "Age 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.35"
              },
              "items": [
                {
                  "text": "1 Ika 8:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.38.37"
              },
              "items": [
                {
                  "text": "Yob 38:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kogolokinoi akonyen nuka ataroi, ka apedon nuka akuj, kitikokinai da akiru nakokuju. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.24"
              },
              "items": [
                {
                  "text": "Age 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobononorete akip dueudue anyoun kokwap. Kedaunos apaarasia akwatat ka akaisakany kiŋoŋaros akip. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolap lokikanyetekaarei, kapaaran nakitomonet kakanykaarei naka elap, kidokokin ataker oroŋan luka Ararat. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.4",
            "verseOrgIds": [
              "GEN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinonaros akip aitodol olap lokitomonet: kotoma olap lokitomonet kapaaran nasodit naka elap, kotakanut aidiasia nuka ironan,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
