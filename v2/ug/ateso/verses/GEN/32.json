                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.10.14"
              },
              "items": [
                {
                  "text": "Kos 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kenainait, koyuunai kakan naka onaceka, kakan naka Esau; naarai akuriana ŋes, kinye abunore aitiji eoŋ, toto ka idwe da. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.11",
            "verseOrgIds": [
              "GEN.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
