          },
          "items": [
            {
              "text": "32:30",
              "type": "text"
            },
            {
              "text": "Penuel Apolouke Akonyen nuka Edeke.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kobala ebe, “Naarai aany Edeke kasesenas, akaijar da ajar.” ",
          "type": "text",
