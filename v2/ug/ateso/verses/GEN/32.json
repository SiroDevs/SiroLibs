            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Yakob atiar, “Wu Edeke loka papaaka Aburaam, Edeke loka papaka Isaak, wu EJAKAIT, lokatemari ebe, ‘Kobono akwap nakobukus ido mama kiinacanakon, eoŋ da kasubanakini jo ejok’; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.9",
            "verseOrgIds": [
              "GEN.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 32:10"
          },
          "items": [
