              },
              "items": [
                {
                  "text": "Kos 12:3-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosalak Yakob bon; koutata etuŋanan kaŋes aitodol neacilar kide. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.24",
            "verseOrgIds": [
              "GEN.32.24"
            ]
          }
        },
        {
