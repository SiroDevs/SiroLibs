                  "text": "Tub 13:17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinit Yakob ŋes kobala ebe, “Kenainait kolimokinai ekonikiror.” Kobala ebe, “Inyo inisitor ekakiror?” Kisireren ŋes kanen. ",
          "type": "text",
