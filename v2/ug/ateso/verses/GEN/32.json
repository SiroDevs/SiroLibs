          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koya kes, kitutub ecor, kitutub kere luaiaatar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.23",
            "verseOrgIds": [
              "GEN.32.23"
            ]
          }
