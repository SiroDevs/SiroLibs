                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keany Yakob kes kobala ebe, “Na ŋes ajore naka Edeke.” Komaik aibois nin Makanaim.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        },
        {
