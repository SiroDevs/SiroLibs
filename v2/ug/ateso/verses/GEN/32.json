              },
              "items": [
                {
                  "text": "Yob 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam kebusakinit nepetai da aitimesia kere, ka nuka abeit da kere, nuibu kitodianak ekonibulesit; naarai abu katub Yorodan lo, kajai kebela bon; kwape kwana da aluor atukon aarei. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.10",
            "verseOrgIds": [
              "GEN.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
