              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Ekonikiror mam bobo enyaritai Yakob, dimarai Isirael: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
