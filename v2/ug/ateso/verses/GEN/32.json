                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Koosikinai, naarai acila kide.” Kotema atiar, “Mam kaosikin, dimikiinak arereŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
