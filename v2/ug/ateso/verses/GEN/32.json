              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komaik Yakob aibois nin ekekiror Penuel; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
