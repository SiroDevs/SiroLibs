              "items": [
                {
                  "text": "Age 33:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobonut ikiyakia mama ejai Yakob kotemasi atiar, “Kipou kadoloto mama ejai onacekon Esau, ido ebunit ŋesi airiamun kajo; ka ituŋa akwat aoŋon eupas kaŋes.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.6",
            "verseOrgIds": [
              "GEN.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.3"
              },
              "items": [
                {
                  "text": "Age 35:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.2.11"
              },
              "items": [
                {
                  "text": "Awa 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.15"
              },
              "items": [
                {
                  "text": "Pes 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kokurianar Yakob noi, kiyalonon; kotiak ituŋa luajaas kaŋes, ka isipanin, ka aituk, ka akaalai araun atukon aarei. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala ebe, “Arai kedolok Esau atukot adiopet kitiji, ekui atukot naesali.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        }
      ]
    },
