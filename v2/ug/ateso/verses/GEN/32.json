          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema ŋes atiar, “Ekonikiror iŋai?” Kobala ebe, “Eoŋ Yakob.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
