            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:28",
              "type": "text"
            },
            {
              "text": "Isirael Apolouke Loepegas ka Edeke arai Epeg Edeke.",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai ipegata nepepe ka Edeke ka ituŋa, ido iteleka.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
          "name": "verse",
