              "items": [
                {
                  "text": "2 Kor 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keany ebe mam epedori aibirokin, kotiro etul; kinunyakin etul loka Yakob eutas kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
