            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:2",
              "type": "text"
            },
            {
              "text": "Makanaim Apolouke Irioneta iarei.",
              "type": "text"
            }
          ]
        }
      ]
    },
