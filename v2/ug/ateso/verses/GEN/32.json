            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou akuare nin, koya akenor aarei, ka akebulesin aarei, ka ikedwe itomon ka lodiopet, kotubor kodoket loka Yabok. ",
          "type": "text",
          "attrs": {
