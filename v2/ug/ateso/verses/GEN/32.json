                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13+GEN.28.14+GEN.28.15"
              },
              "items": [
                {
                  "text": "Age 28:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka jo da ibu kobala ebe, ‘Abeit kasubanakini jo ejok; ido etuluori akoniwur kwape kasine naka aŋolol namam imarun.’’’",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        }
