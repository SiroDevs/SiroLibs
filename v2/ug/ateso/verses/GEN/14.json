              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotiakas asurc kin kes kuare, ŋes ka ikekejaanakinak kitijioto, kotupasi aitodol Koba, loejai akan nakokediany nakoDamasek. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
