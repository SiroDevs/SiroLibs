        },
        {
          "text": " Kotema Aburam ekabaka loka Sodom atiar, “Ario akakan mama ejai EJAKAIT, Edeke Loejai kuju kakuj, elopet akuj ka akwap, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
