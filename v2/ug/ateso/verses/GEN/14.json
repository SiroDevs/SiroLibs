            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ebe, Mam ayaŋaari auno karaida irukan yenikamuk, karaida ŋinibore kere yenijaatar, kinyek einer ebe, ‘Etabar Aburam’. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.23",
            "verseOrgIds": [
              "GEN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimarai ŋulluanyamata ikatumunak, ka akorakinet naka ituŋa lukilosi keoŋ, Aner, ka Esukol, ka Mamure, koyanaasi ŋul akorakinetakec.”",
          "type": "text",
