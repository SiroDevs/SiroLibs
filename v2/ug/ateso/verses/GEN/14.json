          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilipak ŋes arereŋ, kotema atiar,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        }
      ]
