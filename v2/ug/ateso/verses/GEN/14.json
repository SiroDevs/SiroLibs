            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Melukisedek da, ekabaka loka Salem koyanau inyamat ka ajon: ido kerai esasedoti loka Edeke Loejai kuju kakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
