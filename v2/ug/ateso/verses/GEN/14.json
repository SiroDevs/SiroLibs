          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koinak Aburam ŋes idiopet kotomon yenika kere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekabaka loka Sodom kotema Aburam atiar, “Koinakinai eoŋ ituŋa, koyana ijo iboro.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
