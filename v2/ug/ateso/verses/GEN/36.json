          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejakait Kenas, ejakait Teman, ejakait Mibisar; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejakait Magudiel, ejakait Iram: nul kes ijaka luka Edom; kwape ejaatar akeceiboisio kakwap naka airumetekec. Ŋol ŋes Esau papakec loka Iyedomin,",
          "type": "text",
