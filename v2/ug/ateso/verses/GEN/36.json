            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na ŋes aur naka Esau (ŋes Edom). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        },
        {
