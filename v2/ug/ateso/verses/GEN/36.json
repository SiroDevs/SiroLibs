              },
              "items": [
                {
                  "text": "Age 32:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiboienenei Esau komoru Seir: Esau ŋes Edom.",
          "type": "text",
          "attrs": {
