              "attrs": {
                "loc": "GEN.26.34"
              },
              "items": [
                {
                  "text": "Age 26:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komany Esau akenor kotoma apesur nuka Kanaan; Ada akoku naka Elon Ekitit, ka Okolibama akoku naka Ana, akoku naka Sibeon Ekibit. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.9"
              },
              "items": [
                {
                  "text": "Age 28:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka Basemat akoku naka Isimael, kinac naka Nebaiot. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
