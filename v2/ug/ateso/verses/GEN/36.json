                "loc": "EXO.17.8"
              },
              "items": [
                {
                  "text": "Any 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.20"
