            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lu kes ikiroria luka ijaka lualomunete kama ka Esau; kwape ejaatar ajenakec, kwape cjaatar akeceiboisio, kwape kikiroriakec: ejakait Timuna, ejakait Aluba, ejakait Yetet; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
