            }
          ]
        },
        {
          "text": " Lu kes odwe luka Seir Ekorit, lueboienenete kakwap; Lotan ka Sobal ka Sibeon ka Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
