                "loc": "1CH.1.35"
              },
              "items": [
                {
                  "text": "1 Siit 1:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ada da kourik Esau Elipas; ka Basemat kourik Reuel; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okolibama kouri Yeus, ka Yalem, ka Kora: nul kes odwe luka Esau lukeurikinio ŋes kakwap naka Kanaan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        }
      ]
    },
