          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ŋes aur naka Esau papakec loka Iyedomin komoru Seir. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.9",
            "verseOrgIds": [
              "GEN.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.35"
              },
              "items": [
                {
                  "text": "1 Siit 1:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lu kes ikiroria luka odwe luka Esau; Elipas okoku loka Ada aberu naka Esau, ka Reuel okoku loka Basemat aberu naka Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwe luka Elipas kes Teman, ka Omar, ka Sepo, ka Gatam, ka Kenas. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
