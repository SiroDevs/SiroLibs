            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiiras eporoto loka EJAKAIT Edeke itorit omanikor ariripet naka apaaran, konopata etuŋanan ka akeberu kakonyen nuka EJAKAIT Edeke kokidiij okito lukomanikor. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
