                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ibusakinit ber ŋes aiticanio nuipu, kogir atur na. ",
          "type": "text",
          "attrs": {
