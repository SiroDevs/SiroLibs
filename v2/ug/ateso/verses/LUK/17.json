            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye kapaaran nakelomunia Lot koSodom, kotep akim ka acukuman abunore kakuj, komudia kere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
