              "type": "text"
            }
          ]
        },
        {
          "text": " Inituŋanan yenekoto aitajar akeijar, itooliori; ka ŋin da yenitooliori akeijar itajari. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
