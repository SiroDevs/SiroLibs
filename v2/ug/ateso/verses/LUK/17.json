                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kilimokinete ebe, ‘Koany, ejai laije!’ ‘Koany, ejai lailo!’ Sirikiloto, kwabo sirikitupasi da. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.23",
            "verseOrgIds": [
              "LUK.17.23"
            ]
          }
        },
