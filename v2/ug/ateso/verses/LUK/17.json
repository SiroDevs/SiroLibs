            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyama, komata, komanya, ka amanyio da, kiton apaaran nakelomaria Noa toma ataker, kijesun akalele komudia kere. ",
          "type": "text",
          "attrs": {
