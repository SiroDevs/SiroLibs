                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kwape imiliaunia eimilia ameun kowai ediopet loka akuj, inwakit kiton owai ece loka akuj, kwape kwaŋin ejaunia Okoku loka etuŋanan kotoma apaaranike. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
            "verseOrgIds": [
