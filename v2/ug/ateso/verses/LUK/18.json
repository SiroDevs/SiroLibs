                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.13+MRK.10.14+MRK.10.15+MRK.10.16"
              },
              "items": [
                {
                  "text": "Mk 10:13-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinunai idwe ludidik da tetere etirori kes; konye nakeanyuniata ikesisiak, kitorona kes. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye Yesu konyarau kes kotema atiar, “Kocamutu idwe ludidik abunore mama ajai, kwabo sirikisimika kes; naarai lueputosi kalu ajakanut naka Edeke erai nakec, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.3"
              },
              "items": [
                {
                  "text": "Mat 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abeit katemari yes atiar, ŋin yenimam iyuuni ajakanut naka Edeke kwape kikoku yenididi, mam cut elomari toma.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
