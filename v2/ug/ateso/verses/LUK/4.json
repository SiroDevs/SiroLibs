              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojaas da lukatapon luipu koIsirael kapaarasia nuka Elisa enabi; mam yenaponi kiswagarai, dimarai Naaman Esuriat.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        },
        {
