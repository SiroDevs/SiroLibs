          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye ŋes kitoro kidiŋikec kolot.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        }
