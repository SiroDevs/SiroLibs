              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋ Yesu kapedor naka Emoyo, kolot Galilaya: kisiarakin ekeemutu anatar akwapin kere nuidunyatar. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisisianakinenei kotoma atukosiakec, kitopolooritos ituŋa kere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
