            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koumokis noi ituŋa akeisisianakin; naarai kejai akekirot apolou, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.32",
