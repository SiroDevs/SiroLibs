            }
          ]
        },
        {
          "text": " mam aponi kijukarai Eliya mama ejai adiopet kakesi, dimarai Sarapeta, kakwap naka Sidon, mama ejai aberu nakerai apuserut, ",
          "type": "text",
          "attrs": {
