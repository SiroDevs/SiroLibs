            "sid": "LUK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiirariata kesi akiro ŋun kotoma atukos, kilelebunos kere anyunyura. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.28",
            "verseOrgIds": [
              "LUK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyoutu, koremosi kiŋa ka ere, koyaŋaasi neetukum koukot loadukokinitai ekecere, tetere eremorete ŋes kwap cut. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.29",
            "verseOrgIds": [
              "LUK.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
