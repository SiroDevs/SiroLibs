                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyatanakin asianut ka ainapakin mamakus toma ajenun Edeke ka Ejakaitiwok Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
