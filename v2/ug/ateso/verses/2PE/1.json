                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes ecebokinitor apaarasia kere aisiitun yes ŋun, karaida ijenete kicata da kotoma abeit naijaatar, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.1"
              },
              "items": [
                {
                  "text": "2 Kor 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye aomit eoŋ ebe edolit, aroko ajai toma oidukuru lo aisinyikokin yes kaisiitun, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.18"
              },
              "items": [
                {
                  "text": "Yok 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai ajeni ebe eapie apak naka alacar eidukuruka kwape ketejenunia Ejakaitiwok Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adunyakini da aisipedor yes ŋinipak aiitun ŋun kadau atwanare.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
