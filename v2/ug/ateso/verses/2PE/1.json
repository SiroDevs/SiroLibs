        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai mam kipou katupenenete awaragasia nuepwakunitai kacoa, nakitejenunia yes apedor ka abunore naka Ejakaitiwok Yesu Kristo, konye kipou kaanyutu akepolou kakonyenekosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
