              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mama ejaas ŋul luadumutu aiyuun naketiai loepol naeriakas kanakosi kotoma adolit naka Edekewok, Eketajaran da Yesu Kristo:",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        }
      ]
