                "loc": "PSA.25.14"
              },
              "items": [
                {
                  "text": "Sab 25:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.6"
              },
              "items": [
