                {
                  "text": "Sab 107:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai inera EJAKAIT kwanata ebe, ‘Mam ianyunete ekwam karaida akiru, konye ilelebunos akip aditot; imasete yesi da, yes, ka ibarenekus, ka itianikus.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.17",
            "verseOrgIds": [
              "2KI.3.17"
            ]
          }
        },
