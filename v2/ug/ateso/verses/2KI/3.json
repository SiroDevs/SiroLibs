              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.28+2KI.10.29+2KI.10.30+2KI.10.31"
              },
              "items": [
                {
                  "text": "2 Ika 10:28-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30+1KI.12.31+1KI.12.32"
              },
              "items": [
                {
                  "text": "1 Ika 12:28-32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kiketakin karonisio nuka Yeroboam okoku loka Nebat, nuetidiakaria Isirael; mam abu konyou kakesi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        }
