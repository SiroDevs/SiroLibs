            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kogeu Yekoram okoku loka Akab airum Isirael koSamaria kokaru lokitomonet kakanykauni loka Yekosapat ekabaka loka Yuda, kirumak ikar itomon ka luarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
