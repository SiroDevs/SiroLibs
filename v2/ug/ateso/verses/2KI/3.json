              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye erai na akirot naedit kakonyen nuka EJAKAIT: ijaikini da ŋesi Imoabin akaninikus, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
