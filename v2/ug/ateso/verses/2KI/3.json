              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kotema Yekosapat atiar, “Emamei kereka kane enabi loka EJAKAIT, ainitunia EJAKAIT?” Koboŋok ediopet loka ikejaanakinak luka ekabaka loka Isirael cbe, “Ejai Elisa okoku loka Sapat kane, loalianakini akipi akanin nuka Eliya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.25"
              },
              "items": [
                {
                  "text": "2 Ika 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Yekosapat atiar, “Ejai akirot naka EJAKAIT kaŋes.” Kolot ekabaka loka Isirael ka Yekosapat ka ekabaka loka Edom mama ejai,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        }
      ]
