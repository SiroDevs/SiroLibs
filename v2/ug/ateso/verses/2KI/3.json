            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Inera EJAKAIT kwanata ebe,, Kilelebata alelesia aditot na.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
