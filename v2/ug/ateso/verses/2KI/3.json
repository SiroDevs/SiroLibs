                "loc": "ISA.16.7"
              },
              "items": [
                {
                  "text": "Isa 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.16.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotiyatiyata ireria; kocakanakis nolinujanan akemoru ninimana naejok, kilelebun; konukata atanin kere nuka akipi, kojepata ikito kere lukajokak; aitodol needeuniata amor nuko Kir-kareset ban; konye kirimirimoto lukaporoceta, atiyatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.25",
            "verseOrgIds": [
              "2KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keanyu ekabaka loka Moab ebe ipikorit ejie ŋes, koyaŋa ituŋa akwat akanykaarei lukedakito ikileŋa kaŋes, acilar mama ejai ekabaka loka Edom: konye mam apotu kopedosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
