            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, tupuruc, kapak naka ainakin ainakinet, koany, kopotu akipi elomunito korot loka Edom, kilelebun akwap akipi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
