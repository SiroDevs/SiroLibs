              },
              "items": [
                {
                  "text": "1 Sam 15:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idanyete luka ŋolire loebwaitai, ka nolire Ioititatai, ijepete nolikitoi loejok, inukete atanin kere nuka akipi, imunaarete kamor ŋinimana naejok.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 3:20"
          },
          "items": [
