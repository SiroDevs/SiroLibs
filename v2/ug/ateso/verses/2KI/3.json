              "items": [
                {
                  "text": "Any 11:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kolot ekabaka loka Isirael, ka ekabaka loka Yuda, ka ekabaka loka Edom: kirimosi alosit naka apaarasia akanykaarei: komamikis ajore akip, karaida itian luketupito kes. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
