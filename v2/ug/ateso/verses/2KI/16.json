              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koiotoor Akas kalukapapaake, aponi kidaikinai kalukapapaake ore loka Daudi: kirum Kesekia okokuke aiboisike. ",
          "type": "text",
          "attrs": {
