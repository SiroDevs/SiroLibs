              },
              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaarasia kanun ŋes enyakunia Resin ekabaka loka Suria Elat oSuria, kirenea Iyudayan anyoun koElat: kopotu Isurian Elat, kiboikinos nen, kiton lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.22"
              },
              "items": [
                {
                  "text": "2 Ika 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijuka Akas ikiyakia mama ejai Tigilatpileser ekabaka loka Asuria ebe, “Arai eoŋ ekonikeiaanakinan, ka okokukon: kobia kitajarai kakan naka ekabaka loka Suria, kakan da naka eka baka loka Isirael, lukanyoikis eoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
