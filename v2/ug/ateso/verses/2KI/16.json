          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiewe ainakineteke naicweio, ka ainakineteke naka akiria, kobuk ainakineteke namatat, kobwatanak aokot nuka ainakinetake nuka ainapakin, kotem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
