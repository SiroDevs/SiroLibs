              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aswamisio ace nuka Akas nuabu kiswama, mam kereka iwadikatai oitabo loka aisiitonokin nuka ikabakan luka Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
