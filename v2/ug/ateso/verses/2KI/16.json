        {
          "text": "Kokaru lokitomonet kakanykaarei loka Peka okoku loka Remalia kogeu Akas okoku loka Yotam ekabaka loka Yuda airum. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
