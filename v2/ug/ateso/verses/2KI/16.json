          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete Resin ekabaka loka Suria ka Peka okoku loka Remalia ekabaka loka Isirael kopotu Yerusalem aitiji: kirigaut Akas, konye mam apotu kopedosi aipikor ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
