          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolem Akas epuesa ka esabu loadumuna togo loka EJAKAIT, ka lukoboro luka akais nuipu lukotogo loka ekabaka, kiiukak ekabaka loka Asuria araun ainakinet. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
