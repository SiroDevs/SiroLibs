          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyau etem loka aisinit loajai kakonyen nuka EJAKAIT alemun koinaren ketogo, kidin kotemuke ka etogo loka EJAKAIT, kibwaik ari naka agolitomei naka etemuke. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
