                {
                  "text": "2 Siit 22:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.26"
              },
              "items": [
                {
                  "text": "2 Ika 8:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye Yekoseba, akoku naka ekabaka Yoram, kinacike ka Akasia, koyana Yoas okoku loka Akasia, kokokwa ŋes kodwe luka ekabaka luaario, ŋes ka akasaanike, kibwaik kes agola naenadio ikitadan; kimunonikis ŋes Atalia tetere mam eario. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojai kaŋes ibwaitai kotogo loka EJAKAIT ikar ikanykape; kirum Atalia akwap, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.12"
              },
              "items": [
                {
                  "text": "2 Siit 22:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
