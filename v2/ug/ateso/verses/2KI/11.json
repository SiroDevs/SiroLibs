              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keanyu Atalia toto naka Akasia ebe atwana okokuke, konyou komudia aur kere naka ekabaka, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
