            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepupu Atalia ecelet laka ikedarak ka loka ituŋa, kobu mama ejaas ituŋa togo loka EJAKAIT: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.23.12"
              },
              "items": [
                {
                  "text": "2 Siit 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosesen, ido koany, ebwoi ekabaka neejai epir, kwape ejaar epone, ka ikapolok ka arupepen kidunyas kekabaka; kibwonasi ituŋa kere luka akwap, kokuta arupepen. Kosodi Atalia aicil ikenapen, kiworo ebe, “Ebotet, ebotet lokibilakinito.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        },
