        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobwaata ikedarak, kitiŋite ŋolituŋanan lujiisike kakanike, ameun kowai lokoteten loka etogo kiton owai lokokediany loka etogo, eiduny ketem ka etogo, elukunito ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi ŋesi aitolomun okoku loka ekabaka, kidokok aboko akouke, koinak aitejenunet; kitaraut ŋes ekabaka, kinyonyoikinai akinyet; kibapakis akanin kotemasi atiar, “Kidari Edeke ekabaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        },
