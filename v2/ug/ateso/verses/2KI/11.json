        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamata ikapolok luka akwat kwape ajaatar kere nuecorakini Yekoiada esasedoti: koyana nolitunanan iketuŋa, ŋul luelomunete kanakasabato, ka luelomarete da kanakasabato, kopotu mama ejai Yekoiada esasedoti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.23.8"
              },
              "items": [
                {
                  "text": "2 Siit 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijaik esasedoti ikapolok luka akwat akwaras ka ibukui lukeraas sek luka ekabaka Daudi, luajaas togo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
