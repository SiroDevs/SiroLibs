            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu ŋesi ketodik eoŋ Yosua esasedoti lopeti, ebwoi kakonyen nuka emalaika loka EJAKAIT, ebwoi Satan da kakekan nakoteten araun loka surupike. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
