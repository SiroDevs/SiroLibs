        },
        {
          "text": "Keteluo bobo akakonye, kete, ido koany, kopotu agalin aoŋon kokidin kironan iarei; ironan da keraas ironan luka aisinit. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.1",
            "verseOrgIds": [
              "ZEC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
