                "loc": "ZEC.5.10"
              },
              "items": [
                {
                  "text": "Sek 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi eoŋ aboŋokin emalaika lokinera keoŋ ebe, “Ekajakait, inyoika bo lu?” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.4",
            "verseOrgIds": [
