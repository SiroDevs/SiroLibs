                  "text": "Any 28:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kiiau kes epuesa ka esabu, kiswamaunia abokoi, kitanapik kes akou naka Yosua okoku loka Yekosadak, esasedoti lopeti; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.11",
            "verseOrgIds": [
              "ZEC.6.11"
            ]
          }
