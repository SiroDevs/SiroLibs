                {
                  "text": "Sek 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.4"
              },
              "items": [
                {
                  "text": "Apu 6:4",
