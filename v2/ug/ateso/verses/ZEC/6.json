                "loc": "EZR.2.1"
              },
              "items": [
                {
                  "text": "Esr 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Koyana kakesi kaluejoreoritai, kes Kelidai, ka Tobiya, ka Yedaia, luadolut anyoun koBabulon, kolot ijo da kapaaran kaŋin, koloma togo loka Yosia, okoku loka Sepania. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.10",
            "verseOrgIds": [
              "ZEC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 6:11"
          },
          "items": [
