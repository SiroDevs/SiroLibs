        },
        {
          "text": " Abu kewadik eitabo losodit, wu Teopilo, kotoma akiro kere nukegeuni Yesu aswam ka aisisianakin da, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.1",
