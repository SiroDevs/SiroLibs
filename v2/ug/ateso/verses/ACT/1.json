        },
        {
          "text": "Kapaarasia kaŋun kobwo Petero kokidiŋ kiinacan, (etiai loka ekodet kerai bala akwatat ka akaisaarei) kobala ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
            "verseOrgIds": [
              "ACT.1.15"
            ]
          }
        },
        {
