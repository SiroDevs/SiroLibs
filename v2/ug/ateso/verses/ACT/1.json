          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kimaritai nepepe kaoni, kodum ekewai kotoma aijaanakin kana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
