            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema kes atiar, “Mere nakus ajenun apakio karaida ikar luabu Papa kitemok kapedorike. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
