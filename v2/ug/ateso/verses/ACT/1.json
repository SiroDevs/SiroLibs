            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakiriamunotor kakes kicorak kinyeis anyoun koYerusalem, konye kidarata aisumunet naka Papa. Kobala ebe, “Ipotu kiirasi ŋun kamakaŋ; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.4",
            "verseOrgIds": [
              "ACT.1.4"
            ]
          }
        },
        {
