                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iinacan, ibusakinit kodolo nakiwadikatai, nakinerit kolo Emoyo Lokalaunan kaituk naka Daudi, nuka Yuda lokiŋarenikinit ŋul lukikamunete Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
