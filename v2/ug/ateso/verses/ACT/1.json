            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye idumunete agogoŋ kedau Emoyo Lokalaunan adoikin yes; iraunete yesi ikakajenak kotoma Yerusalem, ka Yudaya kere, ka Samaria, kiton osaŋe da loka akwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
