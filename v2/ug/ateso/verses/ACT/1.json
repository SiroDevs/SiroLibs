          "text": " Ŋul kere kinyikokinito ailip ketau ediopet, nepepe kaŋor ka Mariam toto naka Yesu, ka ikeinacan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        }
      ]
