            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai abu Yokana kibatis kakip, konye yes kibatisao kEmoyo Lokalaunan eriŋa etuboro apaarasia nuipu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.5",
