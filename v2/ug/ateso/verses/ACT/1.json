            "number": "3",
            "style": "v",
            "sid": "ACT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakedaunia aiticanio kitodikin kes ejari kanuka nuitogogoŋete nuipu, kitakananakin kes apak naka apaarasia akaisaoŋon, ka ainerenen akiro nuebeito ajakanut naka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.3",
            "verseOrgIds": [
              "ACT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
