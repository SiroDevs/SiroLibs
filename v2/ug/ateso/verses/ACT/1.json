          ]
        },
        {
          "text": " Napesesenete noi akuj naalosio ŋesi, koany kobwaata ikiliok iarei aapu kakes enapito lukakwaŋak, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.10",
