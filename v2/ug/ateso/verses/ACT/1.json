            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiton apaaran naayaŋarere ŋes toma akuj, naadaunitor aicorakin ikiyakia luaseunit kanuka Emoyo Lokalaunan, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.2",
            "verseOrgIds": [
              "ACT.1.2"
            ]
          }
        },
        {
