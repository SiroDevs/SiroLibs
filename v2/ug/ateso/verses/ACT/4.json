          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai keraas ikar luka etuŋanan lokiswamakinio naanyunet ŋin naka aitaŋaleun luedeparito akaisaoŋon,",
          "type": "text",
          "attrs": {
