          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai aomit eoŋ ebe mam ejok aijukar eenat komam itodiara nuiwosatere ŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.27",
