    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinapakin ailoŋiloŋa, konyarau Paul ikesisiak, kicor, kotwar kes, konyou kolot Makedonia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.1",
            "verseOrgIds": [
              "ACT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakedaunia aitor atutubeta ŋun, ka aitalakar kakiro nuipu, kodol Yonan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.2",
            "verseOrgIds": [
              "ACT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosalak nen ilapio iuni, ido nakineruniata Iyudayan asurokin ŋes edwar aikwaŋar alosit Suria, kopeleik aboŋor korot loko Makedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.3",
            "verseOrgIds": [
              "ACT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.10"
              },
              "items": [
                {
                  "text": "Asw 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "19:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.21"
              },
              "items": [
                {
                  "text": "Rom 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kouparos kituŋa kalu, Sopater loka Beroea, okoku loka Puro, ka Arisitariko ka Sekundo Isesalonikan; ka Gaio loka Derube, ka Timoteo; ka Tukiko ka Toropimo luko Asia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.4",
            "verseOrgIds": [
              "ACT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.8"
              },
              "items": [
                {
                  "text": "Asw 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye keliŋara ituŋa ŋul, kidareut sio koTiroa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.5",
            "verseOrgIds": [
              "ACT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kekwaŋaros isio anyoun koPilipi akaulo kapaarasia nuka imugatin lumam itubuunitoi, kadolokis kes koTiroa kalosit naka apaarasia akany; kasalakis nen apaarasia akanykaarei.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
