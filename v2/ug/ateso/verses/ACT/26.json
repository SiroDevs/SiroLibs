            "number": "25",
            "style": "v",
            "sid": "ACT 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kobala Paul ebe, “Mam kekerepikinit, wu Pesito lokaibuses, dimarai enera akiro nukabeit ka nukapirianut da obe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.25",
            "verseOrgIds": [
              "ACT.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 26:26"
          },
          "items": [
