            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes kekamuniata Iyudayan kotoma oyekalu, katamakis aiar da. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
