              },
              "items": [
                {
                  "text": "22:4-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abeit abu eoŋ elopet kaomite ebe kebusakinit aswam nuipu airebokin ekiror loka Yesu Enasarayot. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.1+ACT.9.2+ACT.9.3+ACT.9.4+ACT.9.5+ACT.9.6+ACT.9.7+ACT.9.8+ACT.9.9+ACT.9.10+ACT.9.11+ACT.9.12+ACT.9.13+ACT.9.14+ACT.9.15+ACT.9.16+ACT.9.17+ACT.9.18+ACT.9.19+ACT.9.20+ACT.9.21+ACT.9.22+ACT.9.23+ACT.9.24+ACT.9.25+ACT.9.26+ACT.9.27+ACT.9.28+ACT.9.29"
              },
              "items": [
                {
                  "text": "Asw 9:1-29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3+ACT.22.4+ACT.22.5+ACT.22.6+ACT.22.7+ACT.22.8+ACT.22.9+ACT.22.10+ACT.22.11+ACT.22.12+ACT.22.13+ACT.22.14+ACT.22.15+ACT.22.16+ACT.22.17+ACT.22.18+ACT.22.19+ACT.22.20+ACT.22.21"
              },
              "items": [
                {
                  "text": "22:3-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu keswama ŋun ko Yerusalem; abu kaen ice kalukalaunak aidaris, kadau ainakinio apedor kaneejaas isasedotin lupeti, ido da abu kekeik akan luaario. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido irwan ipu abu keticanenenei kes katukosia kere, ketiŋaikinite ainyanakin Edeke; kareite kes kaibworit kiton oreria Iukokiŋa da.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
