                "loc": "EZK.2.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye konyou, kobwo kakejekon; naarai ketakanikin jo kanuka nu, adakakin jo araun ekejaanakinan ka ekajenan loka akiro nuibu koanyunia eoŋ, ido kaŋun nuketakanikinor, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
