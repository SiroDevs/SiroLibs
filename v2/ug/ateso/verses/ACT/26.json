              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.20"
              },
              "items": [
                {
                  "text": "Yok 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ejeŋi ekabaka nuka akiro kaŋun, eoŋ da enera kaŋes katitiŋ; naarai etogogoŋit ebe emamei akirot kotoma kaŋun naimunonikinitai ŋes, naarai mam nu eswamas kagor. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.26",
            "verseOrgIds": [
              "ACT.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekabaka Agiripa, iyuunit tope ijo inabin? Ajeni ebe iyuunit.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.27",
            "verseOrgIds": [
              "ACT.26.27"
            ]
          }
        },
        {
