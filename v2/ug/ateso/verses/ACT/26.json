              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kobwo ekabaka, ka ekayaiton ka Berenike, ka ŋul lukiboiete kakes; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
