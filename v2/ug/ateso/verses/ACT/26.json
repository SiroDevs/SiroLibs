          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "napenyounete, kineranakinos ebe, “Mam etuŋanan lo iswamat akirot naibusakinitor atwanare karaida aenio.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
