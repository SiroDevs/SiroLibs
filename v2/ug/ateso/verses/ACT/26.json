              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi nakeiyaror kwaŋin, kotema Pesito keporoto loepol atiar, “Kikerepiki cama ijo, Paul, kijulaki jo aisisiakon naepol.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.24",
            "verseOrgIds": [
              "ACT.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
