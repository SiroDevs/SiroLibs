                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kiton lolo adum aisigalikinio naebuni kama ejai Edeke, abwoi aitejenun ludidik ka lukapolok da, kwabo mam eneri akirot dimarai ŋun nukinerasi Musa ka inabin ebe ejaunete: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
