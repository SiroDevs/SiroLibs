                  "text": "1 Pet 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Agiripa Paul atiar, “Kanaesupaana ikoto aituluor eoŋ da Ekristayot!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.28",
            "verseOrgIds": [
              "ACT.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Paul ebe, “Arai kanaesupaana, arai kanaepol elipi Edeke mere ijo bon, konye kaŋul da kere lukapupete lolo, koraut kwape keoŋ-dimarai aeneta nu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        }
