              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala Agiripa Paul ebe, “Kinup jo einer kanukon.” Kosodi korio Paul akekan, koiyar, kobala ebe:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        }
      ]
    },
    {
