            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kayuuni jo kama kituŋakon ka Imo da-lukeyakiari mamakec, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
