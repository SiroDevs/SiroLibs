        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.11",
            "verseOrgIds": [
              "ACT.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
