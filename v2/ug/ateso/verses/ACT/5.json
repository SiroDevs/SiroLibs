                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Asw 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye etuŋanan ediopet, Eparisayot ekekiror Gamaliel, ekesisianakinan loka ikisila, lokeyonito ituŋa kere, kobwo kaurianet, kicorak kitolomarai ber ikiyakia kiŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.34",
            "verseOrgIds": [
              "ACT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema kes atiar, “Yes ikiliok luka Isirael, kocoito nuiswamakinete ituŋa ŋul. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.35",
            "verseOrgIds": [
              "ACT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.38"
              },
              "items": [
                {
                  "text": "Asw 21:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai eroko apaarasia nu edoluno abu Teudas konyou, kituro ebe erai lokapolon; kimorikikinos ŋes kituŋa bala akwat aoŋon; konye koarai ŋes, kere da lukerimarete ŋes kisiarakinos, mam eraun ibore. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.36",
            "verseOrgIds": [
              "ACT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.2"
              },
              "items": [
                {
                  "text": "Luk 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo kaŋol konyou Yuda Egalilayat, kapaarasia nuka aibil akwes, kiria ice kotuŋa atupar ŋes; ŋes da abu koolio; kere da lukerimarete ŋes kisiarakinos. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.37",
            "verseOrgIds": [
              "ACT.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.13"
              },
              "items": [
                {
                  "text": "Mat 15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwana da katemari yes atiar, Kinaca ituŋa ŋul, kinyeisi kes; naarai akirot na arai aswam na, arai erai naka ituŋa, eoliori; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.38",
            "verseOrgIds": [
              "ACT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.5"
              },
              "items": [
                {
                  "text": "Asw 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye arai erai naka Edeke, mam ipedorete aitoolior kes; kinyeis diat atakanun bala itijiete Edeke.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.39",
            "verseOrgIds": [
              "ACT.5.39"
            ]
          }
        }
