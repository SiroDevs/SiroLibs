                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kirai isio ikajenak luka akiro kaŋun, nepepe ka Emoyo Lokalaunan, loainak Edeke kere luerimasi ŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.32",
