                "loc": "ACT.4.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye konyou losasedoti lopeti ka lukejaas nepepe kaŋes kere, ŋes erioŋet loka Isadukayon, ileleba ekolo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.17",
            "verseOrgIds": [
              "ACT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikamut ikiyakia koenikis aidaris naka ituŋa kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.18",
            "verseOrgIds": [
              "ACT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.7"
              },
              "items": [
                {
                  "text": "Asw 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kuare koŋaa emalaika loka Ejakait ikekia luka aidaris, kitolom kes kotema atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.19",
            "verseOrgIds": [
              "ACT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Koloto, kobwaata koyekalu kolimokis ituŋa akiro kere nuka Aijar kana.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.20",
            "verseOrgIds": [
              "ACT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiirariata kesi, kolomasi oyekalu tupuruc sek, kisisianakis.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.21",
            "verseOrgIds": [
              "ACT.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kobu losasedoti lopeti, ka ŋul lukejaas nepepe kaŋes, konyaraut aurianet, ka imakio kere luka idwe luka Isirael, kiyakiasi ituŋa aidaris tetere eyaunete kes. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.21",
            "verseOrgIds": [
              "ACT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye nakedolioto ikejaanakinak mam eanyuna kesi kaidaris; koboŋut kolimokis kes ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.22",
            "verseOrgIds": [
              "ACT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kidum aidaris eenen ejok, ebwoete ikedarak da kokekia; konye nakiŋaaria mam edumuna idiotuŋanan kotoma.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.23",
            "verseOrgIds": [
              "ACT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiiraria ekapolokiton loka eyekalu ka isasedotin lupeti akiro ŋun, kobuonokinos noi kanukec ebe, “Ikonakini bo do akirot na ai?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.24",
            "verseOrgIds": [
              "ACT.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu etuŋanan kolimok kes ebe, “Ituŋa ŋul lukienikinito yesi aidaris ejaas toma oyekalu, ebwoete isisianakinete ituŋa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.25",
            "verseOrgIds": [
              "ACT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kolot ekapolokiton nepepe ka ikejaanakinak koomata kes, konye mere kagogoŋ, naarai kekuriaka ituŋa kinyeis aibiribir kes kamor.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.26",
            "verseOrgIds": [
              "ACT.5.26"
            ]
          }
        }
      ]
    },
    {
