              "ACT.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.11"
              },
              "items": [
                {
                  "text": "Asw 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamai aanyuneta ka nukaumokin nuipu kotuŋa kakanin nuka ikiyakia. Kojaenenas kere nepepe kediopetau alomaret naka Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.12",
            "verseOrgIds": [
              "ACT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ice da mam apotu kotitiŋikis aimorikikin kakes, konye ituŋa kitopoloorito kes. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.13",
            "verseOrgIds": [
              "ACT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.47"
              },
              "items": [
                {
                  "text": "Asw 2:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.7"
              },
              "items": [
                {
                  "text": "6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.20"
              },
              "items": [
                {
                  "text": "21:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyatanakinos lukiyuunito mama ejai Ejakait, ikepuak, ikiliok ka aŋor; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.14",
            "verseOrgIds": [
              "ACT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.11"
              },
              "items": [
                {
                  "text": "Asw 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.56"
              },
              "items": [
                {
                  "text": "Mk 6:56",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kodakununete lukadekak orotin, ka aiperionokin ojam ka opalisin, tetere naitorio Petero kodolokini etoribeke ice kakesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.15",
            "verseOrgIds": [
              "ACT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotukonokinos da ituŋa lukoreria lukeapias ko Yerusalem, koyaununete lukadekak ka ŋul lukiticanenete ajokin nueroko; kitaŋaleunoi kes kere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.16",
            "verseOrgIds": [
              "ACT.5.16"
            ]
          }
        }
      ]
    },
    {
