                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye alimori kamakon nu ebe kwape ejaar Erot, loenyarito kesi erioŋet, kwaŋin amaia Edeke loka lukapapaakosi, eyuunit kere nuelimito ikisila, ka nuiwadikatai oitabon luka inabin, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.14",
            "verseOrgIds": [
              "ACT.24.14"
            ]
          }
        },
        {
