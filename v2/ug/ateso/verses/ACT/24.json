          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwosata Iyudayan da kobalas ebe, “Ikote nepenen.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.9",
            "verseOrgIds": [
              "ACT.24.9"
            ]
