                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun enyikokinit ajaut ketau lomam itoronio mama ejai Edeke ka ituŋa da apaarasia kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.16",
            "verseOrgIds": [
