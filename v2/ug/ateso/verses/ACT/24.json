          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naarai ajeni ebe irai ijo ekatubon loka ateker kana ikar luipu, atubo elop ketau kaloelakara, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.10",
            "verseOrgIds": [
              "ACT.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.17"
              },
              "items": [
                {
                  "text": "Asw 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai ipedori ajenun ebe eroko apaarasia edepara atomon kanuarei ageun naadokaria eoŋ Yerusalem aima; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.11",
            "verseOrgIds": [
              "ACT.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mam ituŋa lu apotu kadumut koyekalu kipega kidiotunanan, karaida aituwutaar atukot, karaida katukosia, karaida kore. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.12",
            "verseOrgIds": [
              "ACT.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabo mam epedorete aitogogoŋ akiro ŋun nuiwosaete kwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.13",
            "verseOrgIds": [
              "ACT.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 24:14"
          },
          "items": [
