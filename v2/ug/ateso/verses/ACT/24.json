          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kokwet ekayaiton Paul einer, Koboŋok ebe:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.10",
            "verseOrgIds": [
              "ACT.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
