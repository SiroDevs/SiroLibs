              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodoloto Epeso, kinye kes kaŋina; konye koloma ŋesi elopet atukos, kopeta ka Iyudayan akiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.19",
