                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.18"
              },
              "items": [
                {
                  "text": "Gal 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kosodi kanen nakadaunia aboŋun Yerusalem, elipi koyekalu, kogelakin ekamoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kaany ŋes, katema eoŋ atiar, ‘Kisunyite, konyou atipet koYerusalem, naarai mam ecamunete akoniitejenun kamakaŋ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "Asw 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kabala ebe, ‘Ejakait, ejenete kesi ebe abu eoŋ kaenenenei ka aibuŋ da ŋul lukiyuunito jo kaŋinitukos kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
