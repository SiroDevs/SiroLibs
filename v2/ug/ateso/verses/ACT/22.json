                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu kopupokis ŋes kiton akirot ŋin; kosodete kodelosi kiworoto ebe, “Kicutasi oloŋai ŋol kakwap. Naarai mam ibus ŋes aijar.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napecelasi, ka acakanar ikecenapen ka aiwelanar da apua kuju, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kicorak ekapolon aitolomar ŋes ore loka iserikalei, kotema ŋes aŋicio kadaio, tetere ejenuni nuainakinit kes ecelas kwaŋin kanukeŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.37"
              },
              "items": [
                {
                  "text": "Asw 16:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.27"
              },
              "items": [
                {
                  "text": "23:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedauniata aien ŋes kaunoi, kobala Paul ekapolokiton lokebwoi eapie ebe, “Ibus kereka yes aida etuŋanan loerai Eromayot komam etubokinitai?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiiraria ekapolokiton kolot kitejen ekapolon kobala ebe, “Nunyoika ikoto ijo aswam? Naarai erai etuŋanan ŋol Eromayot.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu ekapolon kiŋit ŋes ebe, “Kolimokinai, irai teni ijo Eromayot?” Kobala ebe, “Eebo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok ekapolon ebe, “Abu eoŋ kagwel araut Eromayot karupian nuipu.” Kobala Paul ebe, “Konye eoŋ euriat.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atipet kobwata lukekapakina aiŋit ŋes; kokuriana ekapolon da, naarai ajenu ebe erai Eromayot ido abu koen ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
      ]
