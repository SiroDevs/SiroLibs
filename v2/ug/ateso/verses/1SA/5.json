                  "text": "Sep 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka nun isasedotin luka Dagon, karaida ninidiopet yenelomari togo loka Dagon mam ieakakinete akecekeje okek loka Dagon kotoma Asudod, aitodol lolo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
