        {
          "text": "Apotu Ipilisitian konatarito asaduku naka Edeke, koyanaut anyoun koEbeneser kiton Asudod. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
