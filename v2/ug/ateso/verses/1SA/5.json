        },
        {
          "text": " Kosodete kenyout tupuruc sek, koany, ebirokina Dagon kwap kakonyen nuka asaduku naka EJAKAIT: ajepara da akou naka Dagon ka akaninike kibelibelos kokek; akuan naka Dagon bon abu kosal. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
