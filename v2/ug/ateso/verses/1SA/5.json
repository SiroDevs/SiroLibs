            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyanaasi Ipilisitian asaduku naka Edeke, kibwaikis togo loka Dagon, kosipokis eiduny ka Dagon. ",
          "type": "text",
          "attrs": {
