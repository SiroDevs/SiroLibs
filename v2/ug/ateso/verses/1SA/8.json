            "number": "4",
            "style": "v",
            "sid": "1SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete imakio kere luka Isirael atukokin, kopotu Rama neaiai Samuel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.4",
            "verseOrgIds": [
              "1SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.14"
              },
              "items": [
                {
                  "text": "Ikis 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.13"
              },
              "items": [
                {
                  "text": "1 Sam 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.10"
              },
              "items": [
                {
                  "text": "Kos 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.21"
              },
              "items": [
                {
                  "text": "Asw 13:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimokis ŋes atiar, “Koany, imoion ijo, odwekon da mam etupito ikoniponesio: asa koseikinai sio ekabaka atubonokin sio kwape katekerin kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.5",
            "verseOrgIds": [
              "1SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.31"
              },
              "items": [
                {
                  "text": "Any 32:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.11"
              },
              "items": [
                {
                  "text": "1 Sam 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.5"
              },
              "items": [
                {
                  "text": "Awa 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kitakadik akirot Samuel, naalimunioto ebe, “Koseikinai sio ekabaka atubonokin sio.” Kilip Samuel mama ejai EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.8"
              },
              "items": [
                {
                  "text": "Any 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.24"
              },
              "items": [
                {
                  "text": "Mat 10:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.16"
              },
              "items": [
                {
                  "text": "Luk 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.16"
              },
              "items": [
                {
                  "text": "Yok 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.19"
              },
              "items": [
                {
                  "text": "1 Sam 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT Samuel atiar, “Kopupok eporoto loka ituŋa kakiro kere nukilimokinete: naarai mam kinerito jo, konye kaŋeroto eoŋ, kenyek araut ekabakakee. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape ejaatar aswamisio kere nueswamata ageun kapaaran naetolomunia kes koMisiri aitodol lolo, kwape kajaliata eoŋ, ejaanakiniata ieedekesio, kikonakis jo kwaŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso do kopupok ekeceporoto: konye iteienikini kes kaitebeikin, itodikini da epone loka ekabaka loeyai kes.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolimok Samuel ituŋa luelipitos ŋes ekabaka akiro kere nuka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Ikis 17:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.25"
              },
              "items": [
                {
                  "text": "1 Sam 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.52"
              },
              "items": [
                {
                  "text": "14:52",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.10+2CH.26.11+2CH.26.12+2CH.26.13+2CH.26.14+2CH.26.15"
              },
              "items": [
                {
                  "text": "2 Siit 26:10-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Ikoni neta ekabaka lokiyai yes: eyaŋaari odwekus, eseuni kes kanuka agalinike, araun ikebwanenok ibalasinike; ekerete da koinaren kagalinike: ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eseuni kes araun ikapolok luka ilukumin, ka ikapolok luka akaisakany; eseuni ice akor akelup, ka aisak ikenyamat, aiswamaun da iboroke lujiis, ka iboro luka agalinike. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaŋaari adwekus araun nuinyalete nueur maa, araun da akepook, araun akapeok imugatin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.7"
              },
              "items": [
                {
                  "text": "1 Ika 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eyaŋaari da imanikoriakus, ka amanatakus nuka emusabibu, ka amanatakus nuka iseitunin, nuitelekarit ajokis kakesi, einakini kes ikekejaanakinak. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaŋaari idiopet kotomon yenika ikinyomokus, yenika amanatakus da nuka emusabibu, einakini ijakake ka ikekeiaanakinak. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaŋaari ibulesinikus, ka abulesinikus, ka ikatumunakakus luejok noi, ka asigiriakus, aitwasam akeswam. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaŋaari idiopet kotomon yenika isipaninikus: yesi da iraunos ikebulesin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
