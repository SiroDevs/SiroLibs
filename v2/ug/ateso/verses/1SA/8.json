              "items": [
                {
                  "text": "Sab 15:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam odweke apotu kotupasi ikeponesio, konye apotu kopaasi adumun apesan, apotu kijaut ainakineta nuitumudakete akonye, kitirioto etube.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        }
