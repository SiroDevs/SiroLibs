              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Daudi ebe, “Koany akwara, wu ekabaka Aso do kobu ediopet kokatumunak koom. ",
          "type": "text",
          "attrs": {
