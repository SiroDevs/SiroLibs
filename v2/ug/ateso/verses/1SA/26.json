          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, kwape abu kayonia akoniijar lolo, koyonai do akaiiar da kakonyen nuka EJAKAIT, kayuu da eoŋ koean kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
