            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Daudi Abiner atiar, “Mere jo etuŋanan loititin? Iŋai da iputotor ijo koIsirael? Aso kanukinyo mam jo idaritor ekoniiakait ekabaka? Naarai abu ediopet koruna kobu aiar ekabaka ekonijakait. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.15",
            "verseOrgIds": [
              "1SA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam ejok ibore nin yeniswama ijo, Kwape eiaria EJAKAIT, ibusakinit yes atwakare, naarai mam ipotu kidara ekusijakait, loinyonyoikinit EJAKAIT akinyet. Aso do koany, neejai akwara naka ekabaka ka etuo loka akipi loajai akouke.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        }
