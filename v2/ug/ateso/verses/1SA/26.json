              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Daudi alosit oitela je, kobwo kaidi naka eronat kama elwana; kojai apak naelal noi kidinikec, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
