                "loc": "1SA.12.25"
              },
              "items": [
                {
                  "text": "1 Sam 12:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.6"
              },
              "items": [
                {
                  "text": "1 Siit 10:6",
                  "type": "text"
