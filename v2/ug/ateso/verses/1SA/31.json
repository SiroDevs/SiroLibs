              "items": [
                {
                  "text": "2 Sam 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Saul atemar loadakit lujiisike atiar, “Kout ekonikilen, kieumia eoŋ; kinyeis lumam ekepep lu abunore aicum eoŋ, aitisil eoŋ,” Konye koner loadakit lujiisike; naarai akuriana noi. Kanuka ŋun kolem Saul ekekileŋ, kicumakinor. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keanyu loadakit lujiisike ebe atwana Saul, kieumakin ŋesi da kekekilen, kotwana nepepe kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.5",
            "verseOrgIds": [
              "1SA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
