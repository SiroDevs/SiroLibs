              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen tupuruc kepotu Ipilisitian aiŋat lukearitai, kodumut Saul ka odweke iuni etwakikinito moru Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
