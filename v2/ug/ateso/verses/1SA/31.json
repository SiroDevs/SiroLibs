              "items": [
                {
                  "text": "Rom 6:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kotwana Saul, ka odweke iuni, ka loadakit luiiisike, ka iketuŋa kere, kapaaran kaŋin kere nepepe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keanyut ituŋa luka Isirael luajaas juwai naka aditot, ka ŋul luajaas juwai naka Yorodan ebe akerata ituŋa luka Isirael, atwana da Saul ka odweke, koialata ireria, kokerata; kopotu Ipilisitian kiboikinos toma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        }
      ]
    },
