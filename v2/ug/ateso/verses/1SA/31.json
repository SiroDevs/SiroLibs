        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepuput lueboienenete koYabes-Gilead nuken nuapotu Ipilisitian kiswamakis Saul. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
              "1SA.31.11"
            ]
          }
