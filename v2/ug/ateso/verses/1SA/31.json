              "type": "text"
            }
          ]
        },
        {
          "text": " Kibwaikis lujiisike togo loka Asitarot: koenikis akekuan arwatat naka Bet-san, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
