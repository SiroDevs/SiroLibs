                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koiepasi akekou, konatasi Iuiiisike, kijukasi akwap naka Ipilisitian naerimorit, ayaŋaar akiro togo loka aputosiakee nuegerer, kotuna da. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
