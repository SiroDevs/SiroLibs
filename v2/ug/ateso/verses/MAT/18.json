                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arai kediak onacekon kamakon, kolot, kikwenya kadiakareteke, ijo ka ŋes bon: arai kiira, idum onacekon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
