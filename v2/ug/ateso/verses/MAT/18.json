          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.15"
              },
              "items": [
                {
                  "text": "Mk 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.17"
              },
              "items": [
                {
                  "text": "Luk 18:17",
