            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.3+JHN.3.4+JHN.3.5"
              },
              "items": [
                {
                  "text": "Yok 3:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kotema atiar, “Abeit, katemari yes atiar, Arai mam ibelokinos koluoros bala idwe, mam ilomarete cut toma ajakanut naka akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso ŋinituŋanan yenitasonikin ilopet kwape kikoku kayen, ŋin ŋes erai yenikapolon kotoma ajakanut naka akuj.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        }
      ]
    },
    {
