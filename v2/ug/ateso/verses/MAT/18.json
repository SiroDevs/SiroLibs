            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyarau ikoku kisibwo kokidiŋikec; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
