                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kicor jokan ikesisiak sirikelimokis idiotuŋanan ebe erai ŋesi Kristo.",
          "type": "text",
