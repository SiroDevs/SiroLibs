              "items": [
                {
                  "text": "Mat 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Yok 20:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kainakini jo ilaceta luka ajakanut naka akuj, kere nuieni ijo kakwap, eenio kokuju, kere da nuilacakini ijo kakwap, elacakinio kokuju.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
