                  "text": "Pes 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ da kalimokini jo ebe irai ijo Petero, adukokini ekakanisa toma atiida na, ikirigin da luka okatwak mam ipikorete, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "verse",
