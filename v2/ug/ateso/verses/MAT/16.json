              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyaŋa Petero Yesu, kogeu aitoron ŋes, kobala ebe, “Madi akuj, Ejakait! Mam kiponikinete jo ŋun.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kibelokin kotema ŋesi Petero atiar, “Koboŋo kaukaŋ, Satan! Irai ijo ekomio kamakaŋ; naarai mam iwomit nueraas nuka Edeke, dimarai nuka ituŋa.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        }
