            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Amos aboŋokin Amasia ebe, “Mam arai enabi, karaida okoku loka enabi; konye arai ekeeokon, ido eketemonokinon ikito luka esukumor. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
