          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ebala Amos kwanata ebe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
