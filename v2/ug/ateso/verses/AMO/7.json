              "items": [
                {
                  "text": "Mik 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Katema EJAKAIT eoŋ atiar, “Amos, iany inyo?” Kabala ebe, “Ebiriji.” Kosodi EJAKAIT atemar atiar,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
