                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Amasia esasedoti loka Bet-el aiyakiar mama ejai Yeroboam ekabaka loka Isirael ebe, “Inerunit Amos asurokin jo kokidin kekek loka Isirael: mam akwap epedori atitiŋikin akekiro kere. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
