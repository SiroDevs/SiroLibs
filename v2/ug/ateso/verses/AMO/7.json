          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ŋesi ketodik kwanata: ido koany, ebwoi EJAKAIT eiduny karwatat naadukio kebiriji, itiŋit ebiriji kakanike. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
