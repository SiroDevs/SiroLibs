            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edaunos da akwapin, ka aiŋobelekec; konye yeniswamai nuekot Edeke esalenenei kiton ikar kere,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
