                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwana da, idwe ludidik, kosalata tomakeŋ, tetere naetakanunia ŋesi kajaas katitiŋ, kinyeis ileic airum oni kakonyeneke naebunio ŋesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
