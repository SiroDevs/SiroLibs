                {
                  "text": "Yer 31:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yes da, esalit tomakus ainyonyoikinio akinyet naidumut kamakeŋ, komam ipudasi ituŋanan aisisianakin yes; konye kwape kisisianakinia yes ainyonyoikinike akinyet akiro kere, erai da nakabeit, kwabo mam erai aiŋal, ido kwape kisisianakinitor yes, kosalata tomakeŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        },
