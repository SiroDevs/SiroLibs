                {
                  "text": "1 Kor 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idwe, adolu esawa lokawasia, ido kwape ipotu kopupunioto ebe ebuni lokasurup loka Kristo, adolut kwana lukasurup luipu luka Kristo; ŋes kijenunia ebe adolu esawa lokawasia. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.18",
