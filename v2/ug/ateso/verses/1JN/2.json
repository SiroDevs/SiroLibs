                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ibore kere yenejai toma akwapin, aiŋobel naka akuan, aiŋobel naka akonye, ka eitur da loka aijar kana, mam elomunete kaneejai Papa, dimarai elomunete kakwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
