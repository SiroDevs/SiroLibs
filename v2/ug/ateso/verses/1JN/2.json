                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.16"
              },
              "items": [
                {
                  "text": "Yok 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikadwe ludidik, kewadikakini yes nu kinyeis adiakar. Arai kediaka ituŋanan ejai oni Ekapuron neejai Papa, Yesu Kristo ekadoliton. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.1",
            "verseOrgIds": [
              "1JN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.20"
              },
              "items": [
                {
                  "text": "Kol 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.51"
              },
              "items": [
                {
                  "text": "Yok 11:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Erai ŋesi alucet naka adiakanaretawok, kwabo mere kanuwok bonik, konye kanuka akwapin kere da. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
              "1JN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana da ŋes kijenunia ebe kijeni ŋes, arai kiricit aicorakinetake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.3",
            "verseOrgIds": [
              "1JN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.8"
              },
              "items": [
                {
                  "text": "1 Yok 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yeninera ebe, “Ajeni ŋes,” komam ericit aicorakinetake erai ikeŋalan, emamei da abeit kotomakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.4",
            "verseOrgIds": [
              "1JN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.21"
              },
              "items": [
                {
                  "text": "Yok 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.3"
              },
              "items": [
                {
                  "text": "1 Yok 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ŋin yenericit akekirot abeit apoloo amin naka Edeke kotomakeŋ. Kana ŋes kijenunia ebe kija tomakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.5",
            "verseOrgIds": [
              "1JN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.15"
              },
              "items": [
                {
                  "text": "Yok 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋin yeninera ebe esalenenei tomakeŋ, iburao ŋin alosenen kwape alosenenoo ŋesi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.6",
            "verseOrgIds": [
              "1JN.2.6"
            ]
          }
        }
      ]
    },
    {
