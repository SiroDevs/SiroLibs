            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋin nakejai ameun kageunet, nakipou kapuput, nakianyunit kakosikonye, nakipou kasesenata, katirosi da kakosikanin, naka akirot naka aijar,— ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 1:2"
          },
          "items": [
            {
