    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu Kristo, ka atukonokiniwok nepepe kaŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kinyeis aisunyit airiaŋiriaŋa kotoma aomisiokus, karaida aiyaloŋoŋ, karaida komoyo, karaida kakirot, karaida kobalua loebuni kamakosi, ebe adolu apaaran naka Ejakait, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.1"
              },
              "items": [
                {
                  "text": "1 Tim 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.12"
              },
              "items": [
                {
                  "text": "Yok 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.18"
              },
              "items": [
                {
                  "text": "1 Yok 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.3"
              },
              "items": [
                {
                  "text": "4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinyek idiotuŋanan aitapaar yes kopone kere; naarai mam apaaran ŋin ebuni, dimarai isiauni atiakatiakaun ajaun, epukorio da etuŋanan ŋol lokepali, okoku loka amudiar, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Esk 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " loirebirebi, ido loitopoloor bon aitelekarit ibore kere yenenyaritai edeke, arai yenemaio; kosodi iboikin oyekalu loka Edeke, kitodiara ebe ŋes Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam kereka iitunito ebe nakijaar kayes abu kalimok yes ŋun? ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido ijenete yenitikokinit kwana, tetere epukorio ŋes kapakike. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.6",
            "verseOrgIds": [
              "2TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.29"
              },
              "items": [
                {
                  "text": "Asw 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ageu aiyeiyea naka epali aswam; konye loitikokinit kwana iswamai aitodol naelemarere ŋol awai. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.7",
            "verseOrgIds": [
              "2TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isa 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.9"
              },
              "items": [
                {
                  "text": "Yob 4:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.15"
              },
              "items": [
                {
                  "text": "Apu 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi konyet epukorio lokepali, eari Ejakait Yesu ŋes keiyeŋane loka aitukuke, ka amudiar da kotoma atakanun naka abunoreke. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
            "verseOrgIds": [
              "2TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.24"
              },
              "items": [
                {
                  "text": "Mat 24:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.11+REV.13.12+REV.13.13"
              },
              "items": [
                {
                  "text": "Apu 13:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abunore naka ŋol lokepali naiswamai Satan ejaun kapedor kere, kaanyuneta ka nukaumokin da nukeŋalak, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
            "verseOrgIds": [
              "2TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.15"
              },
              "items": [
                {
                  "text": "2 Kor 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.3"
              },
              "items": [
                {
                  "text": "4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka aitapaar kere namam adolit mama ejaas ŋul lueoliorito, naarai mam apotu kocamut amin abeit, kosodete aitajario. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
            "verseOrgIds": [
              "2TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.4"
              },
              "items": [
                {
                  "text": "2 Tim 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ijukakini kes Edeke aswam naka apaar, tetere iyunete nuka aiŋal, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.11",
            "verseOrgIds": [
              "2TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tetere etubokinio kere lumam iyuunito abeit, konye luisiyalamikinito amamus adolit,",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        }
      ]
    },
