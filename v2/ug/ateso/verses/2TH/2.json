            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.11+1TH.3.12+1TH.3.13"
              },
              "items": [
                {
                  "text": "1 Ses 3:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Ejakaitiwok Yesu Kristo elopet, ka Edeke Papawok, lokimina oni, loabu koinak da aitalakar naka ikar kere, ka amun naejok kotoma asianut, ",
