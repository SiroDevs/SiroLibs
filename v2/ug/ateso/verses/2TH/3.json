        },
        {
          "text": " Nuesalito, iinacan, kilipanakinai sio, tetere ekeri akirot naka Ejakait, koinakinai aibuses, kwape kotomakus, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
            "verseOrgIds": [
