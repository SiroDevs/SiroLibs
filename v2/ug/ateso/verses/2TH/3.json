                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kija kamun kotoma Ejakait kakirokus, ebe iswamaete, ido ipote aswam nukicorakini. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kiteten Ejakait ikusitauon toma amin naka Edeke, ka atitiŋikin da naka Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
