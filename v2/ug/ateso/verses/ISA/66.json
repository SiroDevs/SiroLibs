                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebwaikini eoŋ aanyunet kamakec, ejukari iceke kakes luakuete mama ejaas atekerin, Tarusis, Pul ka Lud, luikesete akabwai, Tubal ka Yaban, apujana nuelwaka, lumam epupunito iemutoka, karaida aanyun aibusesuka; elimonokinete akaibuses mama ejaas atekerin, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
