              },
              "items": [
                {
                  "text": "50:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi ŋes atiar, “Inera Kesekia kwanata ebe, Apaaran na erai apaaran naka ican, naka aitoronio, ka naka amoromoroo; naarai adol idwe aurio, emamei da agogoŋ nakaidoun. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.3",
            "verseOrgIds": [
              "ISA.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 37:4"
          },
          "items": [
