                "loc": "JAS.5.14"
              },
              "items": [
                {
                  "text": "Yak 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Motoko iirari EJAKAIT Ekonideke akiro nuka Rabasake, loejukuni ekabaka loka Asuria ejakaitike amoromor Edeke lokajaran, ka aitoron akiro nuapupu EJAKAIT Ekonideke: aso kitonyou ailipikon kanuka aatoŋot naedeun.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
