                "loc": "2KI.19.3"
              },
              "items": [
                {
                  "text": "2 Ika 19:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.9"
              },
              "items": [
                {
                  "text": "Kos 5:9",
