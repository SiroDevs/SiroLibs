        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopotu do ikeiaanakinak luka ekabaka Kesekia neejai Isaia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.5",
            "verseOrgIds": [
              "ISA.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Isaia kes atiar, “Kolimokis ejakaitikus kwanata ebe, ‘Inera EJAKAIT kwanata ebe, Sirikiyoŋ akiro nuipup, nukamoromorooto eoŋ ikejaanakinak luka ekabaka loka Asuria. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.6",
            "verseOrgIds": [
              "ISA.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany, ebwaikin emoyo tomake, epupuni ŋesi eemut, eboŋori bukee; ebirokini eoŋ da ŋes kekileŋ akwapuke.’’’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.7",
            "verseOrgIds": [
              "ISA.37.7"
            ]
          }
        }
      ]
    },
