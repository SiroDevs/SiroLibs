            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.6"
              },
              "items": [
                {
                  "text": "2 Ika 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.3"
              },
              "items": [
                {
                  "text": "Isa 27:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai egaŋi eoŋ ere lo aitajar, kanukaŋ, ido kanuka ekakejaanakinan Daudi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
