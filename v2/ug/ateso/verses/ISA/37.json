        },
        {
          "text": " Kosodi kanen, kepupu ekabaka Kesekia, kocil inapeneke, konap epuko, koloma togo loka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.1",
            "verseOrgIds": [
              "ISA.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.14"
              },
              "items": [
                {
                  "text": "2 Ika 22:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka Eliakim, loapolokinit ekal, ka Sebuna ekewadikan, ka imakio luka isasedotin, konapitos ipukoi, mama ejai Isaia enabi okoku loka Amos. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.2",
            "verseOrgIds": [
              "ISA.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 37:3"
          },
