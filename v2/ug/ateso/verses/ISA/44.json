              "items": [
                {
                  "text": "Sab 115:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋul luesubete aput naegerer eraas kere aamameak; emamei ameda kotoma oborokec luisiyalamikinete: ikajenakakec da mam eanyunete karaida ajenun; tetere irumete ileic. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.5"
              },
              "items": [
                {
                  "text": "Yer 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.18"
              },
              "items": [
                {
                  "text": "Kbk 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iŋai bo asubi edeke, arai kecalari aput naetatao naemamei ameda? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.7"
              },
              "items": [
                {
                  "text": "Sab 97:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.17"
              },
              "items": [
                {
                  "text": "Isa 42:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, irumete ileic ipaupake kere; ikasubak da eraas ituŋa: kotukonokinai kere nepepe, kobwaata; ekuriakaros, irumete kere ileic.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
