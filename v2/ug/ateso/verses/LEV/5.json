              "type": "text"
            }
          ]
        },
        {
          "text": " Arai ketiro yenimam elai yenika ituŋanan, yenimam elai kere kere, yenituluori ŋes yenimam elai, komam ejeni; nakejenun, egwauni akirot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
