              "items": [
                {
                  "text": "Esr 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi naegwaunia adiopet kaŋun, elimori do ŋesi akirot ŋin naabu kodiaka: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyauni ainakineteke naka aronis mama ejai EJAKAIT kanuka adiakareteke naabu kodiaka, yeniberu yenikosipan, imerekek arai akalol, araun ainakinet naka adiakaret; ituluci esasedoti ŋes kanuka adiakareteke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
