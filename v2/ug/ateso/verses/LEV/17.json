        },
        {
          "text": "Kotema EJAKAIT Musa atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
