                {
                  "text": "Leb 15:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kolimok idwe luka Isirael ebe, Arai kepotuu aberu, kidou ikoku yenitelepat, eraun namam elai apaarasia akanykaarei; kwape kapaarasia nuka atiakarioke naibamia eraun namam elai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
