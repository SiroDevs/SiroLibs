            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naedolioto apaarasia nuka aitesegaarioke, kanuka esapat, arai kanuka apese, eyauni ŋesi imerekek yenika ekaru ediopet araun ainakinet naicweio, ka iluke yenididi arai ajele, araun ainakinet naka adiakaret, okek loka ewema loka airiamunun, mama ejai esasedoti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
