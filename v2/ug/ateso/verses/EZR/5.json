                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kokau kitunyunyurikis lukapapaakosi Edeke loka akuj, kijaik kes akan naka Nebukadanesar ekabaka loko Babulon Ekaludayat, loabu komudia etogo lo, koŋata da ituŋa Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
