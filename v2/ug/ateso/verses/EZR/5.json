                "loc": "EZR.1.1"
              },
              "items": [
                {
                  "text": "Esr 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kokaru losodit loka Kuro ekabaka loko Babulon, abu ekabaka Kuro kibwaik ekisil aiduk etogo lo loka Edeke. ",
          "type": "text",
          "attrs": {
