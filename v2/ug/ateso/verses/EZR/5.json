            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete inabin, Kagai enabi, ka Sekaria okoku loka Ido, kodwarakis Iyudayan luajaas koYuda ka Yerusalem: kokiror loka Edeke loka Isirael ŋes adwarakiniata kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
