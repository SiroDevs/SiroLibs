              "attrs": {
                "loc": "HAG.2.4+HAG.2.5+HAG.2.6+HAG.2.7+HAG.2.8+HAG.2.9"
              },
              "items": [
                {
                  "text": "Kag 2:4-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Serubabel okoku loka Sealutiel ka Yesua okoku loka Yosadak anyoun, kogeutu aiduk etogo loka Edeke loejai Yerusalem; kojaas da nepepe kakes inabin luka Edeke kiŋarakinito,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
