                {
                  "text": "Esr 4:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aikopunet naka ebalua loejukakinete Tatenai ekayaiton loka ekekwa juwai, ka Setar-bosenai, ka lukaupake Iparasakain luajaas okekwa juwai, mama ejai Dario ekabaka: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kijukasi ebalua loewadikatai kwanata ebe:” Mama ejai ekabaka Dario ainapakin kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojenu ekabaka ebe kipou kapotu obuku loka Yuda, togo loka Edeke lokapolon loedukitai kamor nuepolok, ido ibwaikinitai akito toma arwatatin, aswam na da elosi iyatanakin kakukuranut ka arereŋ kotoma akaninikec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.8",
            "verseOrgIds": [
              "EZR.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodete aiŋit imakio ŋul katemasi kes atiar, ‘Iŋai bo kiinakini yes ekisil aiduk etogo lo, ka adaun da arwatat na?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.9",
            "verseOrgIds": [
              "EZR.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keŋitata da ikiroriakec, aitejenun jo, tetere kiwadikai ikiroria luka ituŋa lueyaitos kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.10",
            "verseOrgIds": [
              "EZR.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
