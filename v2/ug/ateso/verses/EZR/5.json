              "items": [
                {
                  "text": "1 Pet 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye itei akoŋu naka Edekekec imakio luka lyudayan, komam itanaŋio aswamukec, aitodol neitodolikinere akiro neejai Dario, kosodi adumun aboŋokinet kobalua kanuka akiro kaŋun.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        }
      ]
