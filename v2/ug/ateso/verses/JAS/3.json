                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.12"
              },
              "items": [
                {
                  "text": "1 Pet 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iŋai bo kayes ejai acoa ka ajenun? Kitodu cani aswamisioke koponesioke luejok kotoma aiyapepera naka acoa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.31"
              },
              "items": [
                {
                  "text": "Pes 4:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai kijaunos kekokote loedwar ka aŋolopa toma otauonokus, siriwoloboboete, siriŋalaete da asurokin abeit. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.5"
              },
              "items": [
                {
                  "text": "Yak 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam acoa ŋin erai naebuni kokuju, konye erai naka akwap, naka auruunet, naka Satan. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai neejai ekokote ka aŋolopa, nepenen da ejai aitotolikin, ka ŋiniswamisioit kere da naerono. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.11"
              },
              "items": [
                {
                  "text": "Bur 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye acoa naebuni kokuju nasodit erai naesegara, kosodi nakainapakin, nakaiyapepera, naenonokikinit, ileleba aitim ka araito nuejok, emamei abuonokin, emamei da esoswai. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.32.17"
              },
              "items": [
                {
                  "text": "Isa 32:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.9"
              },
              "items": [
                {
                  "text": "Mat 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eyeitai araito nuka adolit toma ainapakin mama ejaas ŋul luiswamaete nukainapakin.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.18",
            "verseOrgIds": [
              "JAS.3.18"
            ]
