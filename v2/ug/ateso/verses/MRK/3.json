            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.12+LUK.6.13+LUK.6.14+LUK.6.15+LUK.6.16"
              },
              "items": [
                {
                  "text": "Luk 6:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoka oroŋat, konyarau lukipuda elopet; kopotu mamakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.13",
            "verseOrgIds": [
              "MRK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koseu itomon kaluarei ajaenena kaŋes, ido aiyakienen alimonokin; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "koiaas da kapedor aireŋear ajokin. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.15",
            "verseOrgIds": [
              "MRK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yok 1:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koseu lutomon kaluarei lu: Simon, komaik ekekiror Petero; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.54"
              },
              "items": [
                {
                  "text": "Luk 9:54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka Yakob okoku loka Sebedayo, ka Yokana onaceke (komaik kes ekiror Boanerege, apolouke ebe, Idwe luka airetun); ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Anderea, ka Pilipo, ka Batolomayo, ka Matayo, ka Tomas, ka Yakob okoku loka Alupayo, ka Tadayo, ka Simon Ekanaanit ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Yuda Isikariot, ŋes lokebilakini ebotet.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋo ore. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotukokin bobo ekodet, komam epedorete ainyam idisinyamat. ",
          "type": "text",
          "attrs": {
