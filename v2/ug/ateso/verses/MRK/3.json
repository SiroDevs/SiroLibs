                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kogitar Yesu nepepe kikekesisiak, kolot aŋolol, kotupa ekodet loapol lokebuni koGalilaya; koYudaya da, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.7",
            "verseOrgIds": [
              "MRK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.25"
              },
              "items": [
                {
                  "text": "Mat 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ko Yerusalem ka Idumea, ka okekwa Yorodan, ka ariino da nuka Turo ka Sidon, ekodet loapol, lokiirarit akiro kere nukiswamat, kobu mamakeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.8",
            "verseOrgIds": [
              "MRK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "Mk 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.1+LUK.5.2+LUK.5.3"
              },
              "items": [
                {
                  "text": "Luk 5:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok ikekesisiak aitemokinit ataker aidaret ŋes, kanuka ekodet, kinyeis aridakin ŋes; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.9",
            "verseOrgIds": [
              "MRK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai kitaŋaleunit luipu, tape da kere Iukiticanete adekesia ebelaros atiror ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.10",
            "verseOrgIds": [
              "MRK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.41"
              },
              "items": [
                {
                  "text": "Luk 4:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakeanyuniata ŋes imoyon lueroko, kibiroros kakonyeneke, kiworoto kobalas ebe, “Irai ijo Okoku loka Edeke.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
            "verseOrgIds": [
              "MRK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.34"
              },
              "items": [
                {
                  "text": "Mk 1:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kicorenenei kes jokan kinyeis aitejenun ŋes.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        }
      ]
    },
