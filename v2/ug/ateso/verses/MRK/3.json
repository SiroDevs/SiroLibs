              "type": "text"
            }
          ]
        },
        {
          "text": " Nakiirariata lukeŋ, kolomasi aikamun ŋes, naarai kobalas ebe, “Amunaar.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.21",
