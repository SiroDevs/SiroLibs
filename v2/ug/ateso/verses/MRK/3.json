              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abeit katemari yes atiar, Isionio adiakanareta kere nuka ituŋa, ka ainyanakineta da kere nueinyanakinete; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
