                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye yeneinyanakini Emoyo Lokalaunan mam isionio cut; konye egwaunete akiro nukadiakar naka ikar kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
            "verseOrgIds": [
              "MRK.3.29"
            ]
          }
        },
