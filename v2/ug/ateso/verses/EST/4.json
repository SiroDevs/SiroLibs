            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ejenete ikejaanakinak kere luka eka baka, ka ituŋa da luka ibukui luka ekabaka, ebe, ŋinituŋanan kere, arai ekiliokit arai aberu, yenelomari alaro nakotoma mama ejai ekabaka, yenimam enyaritai, ejai ekisil ediopet neejai ŋesi, ebe, eario, dimikito yen yenidodit eka baka kesas loka esabu, ŋes ejari: konye mam eoŋ kanyararitai mama ejai ekabaka apaarasia nu akaisauni.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolimokinai Morudekai akiro ŋun nuka Esita. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
