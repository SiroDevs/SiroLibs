        },
        {
          "text": " Keienu Morudekai nueswamao kere, kocil Morudekai ikenapen, konap epuko kekurwon, koloma kidin ore, kodelo eporoto loepol lokican.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        }
