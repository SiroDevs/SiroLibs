            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Karabona ediopet kobwaein luajaas kakonyen nuka ekabaka atemar atiar, “Ido koany, akito nueojak ikubitin akaisakany, nueswamakinit Kaman Morudekai loabu kiner nuejok kanuka ekabaka, ebwoete kotogo loka Kaman.” Kotema ekabaka atiar, “Kikajakis ŋes nen.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
