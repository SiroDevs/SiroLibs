              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalot mama ejai emalaika, kalimok ŋes ainakin eoŋ iitabo. Kabala ŋesi eoŋ ebe, “Kolem, konyam ŋes; edwaruni kakoikikon, konye kaitukukon ewinyuni kwape esik loka ao,” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalem iitabo kakan naka emalaika, kanyam, kowiny kotoma aitukuka kwape esik loka ao, konye kadau ainyam, kodwaru akoikika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
