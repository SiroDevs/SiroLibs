                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiworo keporoto loepol kwape loka eŋatuny loegat, Napiworoi, kinerata agirokineta akanykaarei ikeceporotoi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
