              },
              "items": [
                {
                  "text": "Yud 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ejaas jo ikiroria luikidioko koSarudio, ituŋa lumam emunaarito inapenekec; elosenenete kesi nepepe keoŋ enapito lukakwaŋak, naarai ibusakinito. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.4",
            "verseOrgIds": [
              "REV.3.4"
            ]
          }
        },
