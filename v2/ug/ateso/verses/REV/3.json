            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ajeni akoniswamisio; ebe ejai jo ekiror ebe ijari, konye irai lokatwan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
