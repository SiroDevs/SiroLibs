                "loc": "EZK.34.4"
              },
              "items": [
                {
                  "text": "Esk 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokweny, kitogogoŋ da nuesalito nuekotosi atwakare, Naarai mam abu kadum akoniswamisio nuedolito kakonyen nuka Edekeka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.2",
            "verseOrgIds": [
              "REV.3.2"
            ]
          }
        },
