                {
                  "text": "Yud 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojau ejie toma akuj, kitiji Mikael ka ikemalaikan apiu. Koji apiu ka ikemalaikan, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
