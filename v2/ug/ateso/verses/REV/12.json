              "items": [
                {
                  "text": "Apu 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidou ŋesi ikoku yenisapat, yenekoto acok atekerin kere kebela loka asuat, konye kouruporoi ikokuke mama ejai Edeke, ido mama ejai eicoloŋoke. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
