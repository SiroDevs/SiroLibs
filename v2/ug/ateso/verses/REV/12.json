                "loc": "MIC.4.10"
              },
              "items": [
                {
                  "text": "Mik 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kepotiei, kodelo karieboke naka aidoun, kikilianar aidoun. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.2",
            "verseOrgIds": [
              "REV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotakan aanyunet ace toma akuj, ido koany, apiu naepol naereŋ, kojaas kakwes akanykaarei ka amumwara atomon, kojaas da amekemeken akanykaarei akwesike, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.3",
            "verseOrgIds": [
              "REV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.10"
              },
              "items": [
                {
                  "text": "Dan 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiria ekorike atutubet nakiwuniet naka aacer nuka akuj, kocakak kes toma akwap, Kobwo apiu kakonyen nuka aberu naekoto aidoun, tetere naedounio ikokuke konyamari. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.4",
            "verseOrgIds": [
              "REV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.7"
              },
              "items": [
                {
                  "text": "Isa 66:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.9"
              },
              "items": [
                {
                  "text": "Sab 2:9",
