            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kocakarai apiu ŋin naapol, emun ŋol lokolo sek, loenyaritai Ekejodijodon, ka Satan da, ekeŋalaaran loka akwapin kere, kocakakinai toma akwap, kocakakinai da ikemalaikan nepepe kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        },
        {
