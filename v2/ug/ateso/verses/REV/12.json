                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koker aberu toma amodiŋ, naejai aibois naitemokinit Edeke ŋes, tetere itanete ŋes kanen apaarasia alukumit ka akwat aarei ka akaisakanykape.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
