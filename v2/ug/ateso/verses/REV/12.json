              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotakan aanyunet naepol kotoma akuj, aberu naenapit akoloŋ, kojai elap kwap kakejeke, kojai da aboko naka aacer atomon ka nuarei akouke; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.1",
            "verseOrgIds": [
              "REV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
