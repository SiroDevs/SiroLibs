          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "komam ipikorete, kwabo mam bobo etakanuna aiboisikec kotoma akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
