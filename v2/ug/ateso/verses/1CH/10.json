                "loc": "1SA.28.7"
              },
              "items": [
                {
                  "text": "1 Sam 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kotwana Saul kanuka adiakarike naabu kodiak ka ma ejai EKAKAIT, kanuka akirot naka EJAKAIT, namam abu koric; bobo da naarai abu ŋesi kiner kadio nakejai aiokit, aiŋitun, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
