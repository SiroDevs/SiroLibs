          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai abala Daudi ebe, “Abu EJAKAIT, Edeke loka Isirael kisinapik iketuŋa; iboienenei ŋesi koYerusalem ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
            "verseOrgIds": [
