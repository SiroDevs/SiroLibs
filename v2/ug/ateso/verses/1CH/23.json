          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwe luka Keburon; Yeria lokapolon, Amaria lokiareit, Yakasiel lokiwuniet, ka Yekameam lckiwononet. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        },
        {
          "name": "verse",
