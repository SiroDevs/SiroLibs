        },
        {
          "text": "Kotukonok ikapolok kere luka Isirael, ka isasedotin ka Ilebin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
