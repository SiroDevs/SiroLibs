              "items": [
                {
                  "text": "Mar 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam bobo ipudas Ilebin adakar ewema lokalaunan ka iboroke kere luka aijaanakiniken.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kakiro nukawasia nuka Daudi aponi kimarai idwe luka Lebi, ageun kaluka ikar akaisaarei ka adepar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai aswamukec ŋes aijaanakin odwe luka Aaron toma aijaanakin naka etogo loka EJAKAIT, alaroi, ka agolai, ka aiteseg iboro lukalaunak kere, ŋes aswam naka aijaanakin naka etogo loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
