                  "text": "Mar 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi kimarai Ilebin ageun kaluka ikar akaisauni ka adepar; etiaikec kakwesikec, ŋinituŋanan, emwaasi ilukumin akaisauni ka lukanykauni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        },
