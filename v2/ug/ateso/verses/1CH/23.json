                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka nul, koanyanarcte ilukumin akaisaarei ka luonon aswam naka etogo loka EJAKAIT: ilukumin ikanykape kes ikapolokitok ka ikatubok: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
