            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilukumin iwonon keraas ikagolok; kituritos da ilukumin iwonon EJAKAIT kiboro luabala Daudi ebe, “Abu eoŋ keswama kes aituritor.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        },
