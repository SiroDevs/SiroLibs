            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Odwe luka Amuram; Aaron ka Musa: aponi Aaron kotiakai tetere etalauni iboro lukalaunak noi, ŋes ka odweke, ikar kere, aisupuruunun lukisupurununo kakonyen nuka EJAKAIT, aijaanakin ŋes, ka ailipenen arereŋ kokirorike ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye Musa, etuŋanan loka Edeke, aponi odweke komaikinai ateker naka Lebi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.14",
            "verseOrgIds": [
              "1CH.23.14"
            ]
          }
        },
