          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwe luka Usiel; Mika lokapolon, ka Isia lokiareit.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        }
