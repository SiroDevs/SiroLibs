          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwe luka Elieser kes Rekabia lokapolon. Amameete Elieser icedwe lusap; konye epu noi odwe luka Rekabia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        },
