              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.36+LUK.24.37+LUK.24.38+LUK.24.39+LUK.24.40+LUK.24.41+LUK.24.42+LUK.24.43+LUK.24.44+LUK.24.45+LUK.24.46+LUK.24.47+LUK.24.48+LUK.24.49"
              },
              "items": [
                {
                  "text": "Luk 24:36-49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azio’du alu ’dari ma ondresi, jotileni de ovuria opizaru pari ’ba erini imbale ’diyini yi okuzuria yini ’ba Yahudini rulerisi, Yesu emu pa so yi eselia, nga ’yo yi tia, Asi anzuru ma ovu emi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.1"
              },
              "items": [
                {
                  "text": "1 Yoh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka e’yo ’diri ’yo ’bo, eri ece yi dri i ma dri piyi i ma eje be. ’Ba erini imbale ’diyi nga ovu ayikosi ani yini Opini ndrelerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.20",
            "verseOrgIds": [
              "JHN.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.18"
              },
              "items": [
                {
                  "text": "Yoh 17:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga di ’yo yi tia dika ani, Asi anzuru ma ovu emi vu. Ekile Atani ma ti epelerile, ma pe emi ti ’dinile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
              "JHN.20.21"
            ]
          }
        },
