              "items": [
                {
                  "text": "Kal 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini amani ovuria atalau amboru edeta edepi jo Mungu­ni ma driliari be; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
