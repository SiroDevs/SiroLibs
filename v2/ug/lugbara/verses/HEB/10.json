              "items": [
                {
                  "text": "Ebra 13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini ama alu alu ma dro asisile ama agyi ma e’yo dria, jezu leta pini zozu azi onyiru ’diyi be; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
