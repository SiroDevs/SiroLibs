                "loc": "EPH.5.26"
              },
              "items": [
                {
                  "text": "Efe 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ama ma esi ogogo asi adarusi a’ita gapi treri be, de oya ari asi amani ma dria, asisile amani e’yo onzi nizuri ’bazu alaru ’bo, oji vini ama rua yi alarusi ’bo indi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
