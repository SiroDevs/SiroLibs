              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Ebra 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ma bi e’yo e’daza asi teza amani e’dazuri ci ojakokoru, a’disiku ’ba aziza azipiri ovu asi adaru be; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
