              },
              "items": [
                {
                  "text": "Ebra 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ovuni atalau edeta edepi agapi ra ecopi okpoako amani ma candi nipi kuri be ku, te atalau amani ovu ndra obezaru e’yo driasi ekile amale, te ezani ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
