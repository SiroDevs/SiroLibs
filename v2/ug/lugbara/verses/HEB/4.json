          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ama ma nda asi driasi fizu ava liza nderi ma alia, ’ba aluni kazu e’dezu eritaako ndra ecele ’darilerisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
