                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amani ovuria atalau edeta edepiri agapi ra fipi ’bua ’bori be, eri Yesu Mvi Munguniri’i, ama ma bi e’yo e’daza amani ci. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
