            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ama ma ovu urisi, aziza ’bani efizu ani ava liza erini ma aliarini nga aceria indi, ’ba alu emi eseliari kazu e’dazu ekile eri ece rarile ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba olu e’yo bari ama tia ’bo, ekile ndra olule yi ma tiarile tro tro; te e’yo nde yini erileri koni ndra yi ma aza ku, a’disiku e’yo nde ecini i tualu a’ita be ’ba eripi ’diyi ma asia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.11"
              },
              "items": [
                {
                  "text": "Zab 95:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ama’i, ’ba e’yo a’ipi ’diyi, ama fi ava liza nde ma alia ra, ekile erini ’yole ’borile, kini,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
