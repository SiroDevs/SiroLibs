              "HEB.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.17+GEN.14.18+GEN.14.19+GEN.14.20"
              },
              "items": [
                {
                  "text": "E’do 14:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Melekizedeki ’diri, opi Salemua, atalau edeta edepi Mungu Uru Turini, dri fupi Iburahimu be erini emviria yini ’ba opiru ’diyi ofuzu ’bori ma vutia, asi ndriza fepi eri dri, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimuni vini afa dria ma esele mudri ma azi aluri awazu eri driri. Okorisi eri opi e’yo kililirurini (ru erini ma efi ’dini) azini vini eri opi Salemuari, efini opi asi anzuruni; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.2",
            "verseOrgIds": [
              "HEB.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ata kokoru, ayia: kokoru, a’bi kokoru, ovupi o’du erini e’dozuri be ku, azini asiza idriniri be ku indi, te ovupi ekile Mvi Mungu­nileri, eri ovu atalau edeta edepiriru ’dani.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te emi ega nga, ’ba ’diri ovu amboru tu ngopi, Iburahimu ama a’bi amboruni afa opaza ma esele mudri ma azi aluri fezu eri driri ya ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.4",
            "verseOrgIds": [
              "HEB.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Kal 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adaru Levi ma anziyi azi edeta fedezuri bipi ’diyi ovu azita be afa ma esele mudri ma azi alu a’izu ’ba vu, adaru adripi yini vu, ekile azitani ’yolerile, ’ba nde ’diyi ka ovu Iburahimu ma orini ti. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.5",
            "verseOrgIds": [
              "HEB.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba yini eri ma a’bi lazu yi ma eselia kuri, eri a’i afa ma esele mudri ma azi alu Iburahimu vu, azini fe asi ndriza ’ba ovupi aziza beri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.6",
            "verseOrgIds": [
              "HEB.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba econi agata gazaru e’yo ’dirisi ku, ’ba wereri adri asi ndriza isu ’ba ambo eri agapi rari vu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.7",
            "verseOrgIds": [
              "HEB.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Doa ’ba ecopi drapi ’diyi adri afa ma esele mudri ma azi aluri a’i ra; te ’dale, ’ba yini eri ma e’yo eti nzele kini eri idriruri a’ini. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.8",
            "verseOrgIds": [
              "HEB.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini ama eco ’yozaru, Levini indi, ’ba afa ma esele mudri ma azi alu a’ipiri fe afa ma esele mudri Ira azi alu ’bo, geri Iburahimu ma aliarisi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.9",
            "verseOrgIds": [
              "HEB.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri ovu ndra nga i a’bi ma rua alia, de Melekizedekini dri furia eri beria.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te azi ’ba Levini edeta edezuri ka ndra eco ’ba ’bazu dri fuzu ci (te ’ba isu ndra azita azi nde ’dirisi), ika’dini atalau edeta edepi azini efupi ekile peza Melekizedekini pezurile, i ovupi omvezaru peza Aronini pezu­rile kuri ma enga a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.11",
            "verseOrgIds": [
              "HEB.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di­ ni azi atalauni edeta edezuri ka ovu ’ojazaru, azita ma oja i indi ada. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.12",
            "verseOrgIds": [
              "HEB.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku ’ba yini e’yo ’diri ’yozu erisiri eri suru andini, te ’ba aluni engapi suru nde ’diri ma aliari azi pari edeta edezuriari ngapini yo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.13",
            "verseOrgIds": [
              "HEB.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.10"
              },
              "items": [
                {
                  "text": "E’do 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isa 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ’ba dria ni adaru kini Opi amani enga Yuda alia; te Musa ’yoni atalau edeta edepi ’diyi ma e’yo suru nderi ma tia aluni ku.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo ’diri ovu nizaru onyiru aga ra, atalau edeta edepi aziniri ka enga ekile peza Melekizedekini pezurile, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.15",
            "verseOrgIds": [
              "HEB.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ovupi ’bazaru azita e’yo ruani azizurisi ku, te okpo idri ecopi depi kurinisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.16",
            "verseOrgIds": [
              "HEB.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.6"
              },
              "items": [
                {
                  "text": "Ebra 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku yi nze e’yo erini ma eti ’dini,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovuni oyo soza kokoru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ’dayi oro ’bazaru atalau edeta edepi ’diyiru oyo soza kokoru, te eri’i ovu ’bazaru oyo soza be, ekile ’ba e’yo ’yopi eri ma tiarini ’yolerile, kini,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaru atalau edeta edepi ’dayi ovu kakau, a’disiku dra oga yini ovu­ko ’dani ’danini; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri’i, erini ovule ’dani ’danirisi, eri ovu azi edeta edezu ecopi i depi kuri be., ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.24",
            "verseOrgIds": [
              "HEB.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.34"
              },
              "items": [
                {
                  "text": "Rum 8:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.1"
              },
              "items": [
                {
                  "text": "1 Yoh 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi indi eri eco ’ba sipi Mungu vu ogogo erisi ’diyi opazaru teke teke, erini ovule idriru ’dani ’dani Mungu zizu yi dririsi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.25",
            "verseOrgIds": [
              "HEB.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
