              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi amani opi nyaza ecopi oyapi kuri isulerisi ama ma ovu ’yeta anzutiri be, amani ecozu ani azi ngazu Mungu dri erini lelerile, inzita pisi ruta be; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
