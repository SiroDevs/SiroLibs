                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’duko eriniri oya ndra nyaku etu ’darisi; te curu’do eri azi kini, Ace nga pale alu dika ma nga ni kiri nyakuni oya a’dule ku, te ’bu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
