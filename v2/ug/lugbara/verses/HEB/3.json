                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi, adripi alatararu omveta ’buari a’ipi tualu ’diyi, lemi ma ega Yesu ’ba ti epele azini atalau edeta edepi agapi ra a’ita amani e’daleriniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "Kal 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ovu asi be ’ba eri ’bapi atalaururi vu, kile Musani ovule asi adaru be jo Munguni ma alia driarile. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.2",
            "verseOrgIds": [
              "HEB.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te la leri onyiru diza isuzu aga Musa ra, ekile ’ba jo sipirini inzita isule tu jo nde agazurile. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku jo dria alu alu ovu afa ’bani sileniri’i, te ’ba afa dria ’bapiri eri Mungu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.7"
              },
              "items": [
                {
                  "text": "Kal 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Musa ovu ndra asi adaru be jo Munguni ma alia dria ekile ati’bole, e’yo yini ngale ’yole etu vilerisi ’diyi ’ma e’yo eti nzezu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
              "HEB.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 3:6"
          },
          "items": [
