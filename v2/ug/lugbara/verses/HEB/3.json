              "items": [
                {
                  "text": "Efe 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.23"
              },
              "items": [
                {
                  "text": "Kol 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te Kristoni, ekile mvile, ovu asi adaru be jo Munguni ma drilia. Jo nderi ama’i, ama ka asi okporu amaniri pi bi ci, ayiko e’yo tezaniri be, kpere ewu asizuria.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
          }
        }
