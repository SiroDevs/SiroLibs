          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa dria mi drini isule ’yezaruri, mi ’ye eri okpo minisi; a’disiku azi pi, egata pie, nita pie, ondua pie, ovuni dria ’bile drani mini muzu vuniari ma alia ku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
