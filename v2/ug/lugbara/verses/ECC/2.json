                  "text": "1 Pet 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndru e’yo ma asia, geri ayiko fezu rua mani dri patiefi ma su mvuzasi-de ma asi ma dri ce onduasi-nizu e’yo ondua kokoru bizu indi, de nga ma ndreni e’yo ovupi onyiru anzi ’bani dri, yini eri ’yezu ’bu ma etia ewu dria yini ovuzu idrirurisiri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
