        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.23"
              },
              "items": [
                {
                  "text": "1 Opi 4:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma je ati’ba agupiru ati’ba ezoanziru ’diyi be, azini yi oti mani ati’ba anzi ma vile joa; ma ovu lonyi be amboru, anyapa pie anyapa nyiri nyiri ’diyi be, aga ’ba dria ovupi ma drilia oko Yerusalemua ’diyi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
