              "attrs": {
                "loc": "2CH.9.22+2CH.9.23+2CH.9.24+2CH.9.25+2CH.9.26+2CH.9.27"
              },
              "items": [
                {
                  "text": "2 Sur 9:22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’ye ma dri azi amboru ’diyi ra; ma si mani jo ra; ma esi mani zabibu pati amvua ra; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.4",
            "verseOrgIds": [
              "ECC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma oli mani angu patifu pini, irindi onyiru ’diyi be, yi ma alia ma esi pati efi kapi suruti ndu ndu ’diyi karakarau. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ede pari yi atizani, yi ma fe yi pari oceru mani pati nyiri nyiri ’diyi; sazuri dri ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
