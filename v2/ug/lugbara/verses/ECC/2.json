            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma oku! vini mani dahabu pi, mele pie, lonyi opiniri pie, lonyi angu amve ’diyini pie; ma nda mani ’ba agupiru ongo ngopi ’diyi pi ezoanzi ongo ngopi ’diyi be, azini oku ati’baru kara­karau, ayiko fepi ’ba ma ori dri ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        }
