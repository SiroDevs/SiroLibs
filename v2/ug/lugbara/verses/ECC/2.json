              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.3"
              },
              "items": [
                {
                  "text": "Ekl 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ’bani a’di isu azi okporu erini ma e’yosi, candi eri ma asiari pi ma e’yosi, azi erini ngale okposi etu etiari be ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
