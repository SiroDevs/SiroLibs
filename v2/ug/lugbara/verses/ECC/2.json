                  "text": "Ekl 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ma ovu di ’ba amboni,ma ezu amboru aga ’ba dria ma drilia Yerusalemua ’diyi ra; azini indi ondua mani ovu nga ma be ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.22"
              },
              "items": [
                {
                  "text": "Ekl 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa dria ma mileni ndrele ayikoruri ma gani yi ku; ma ogani ayiko ma asi dri aluni ku, ma asini ovule ayikosi azi mani dria-ri sirisi; e’yo ’diri ovu ndra orodri mani azi okporu mani dria ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga di azi ma drini ’yele: ’diyi pi ma e’yo olu, azi okporu mani ngale okposi ’diyi be, re mi ndre, afa dria yi e’yo tokoru, eri asi ’bazu oli bizuriru, te orodri etu ma etia aluni yo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
