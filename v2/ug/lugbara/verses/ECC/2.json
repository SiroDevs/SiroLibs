        },
        {
          "text": "Ma ’yo oguta oguza ma e’yosi kini, Eri azani; azini oguta ayikoruri ma e’yosi kini, Eci a’di ’ye ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
