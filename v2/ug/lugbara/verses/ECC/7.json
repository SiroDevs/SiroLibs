                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ada, ’ba kililiru nyakua e’yo! onyiru ’yepi e’yo ezapi kuni yo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
