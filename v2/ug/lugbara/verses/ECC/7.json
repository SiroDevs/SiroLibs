                "loc": "1TI.6.16"
              },
              "items": [
                {
                  "text": "1 Tim 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa ovupi ziri aliru ruri, a’dini eco eri isuzaruni? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma oja ma ra, ma imba ma asi e’yo nizu, e’yo ndazu, ondua pi ndruzu e’yo ndu ndu ma efi be nizu kini e’yo onzi eri e’yo ondua kokoroni, azini e’yo ondua kokoruri eri e’yo azazaruni. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma isu afa azini aga drata okangaliri ra, ada, eri okuni asini ovuzu kuruso pile emba beri, eri ma dri anzirikeleri’i; ’ba ayiko fepi Mungu driri nga apa erisini, re eri nga ’ba e’yo onzi ’yepiri bi ci. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ECC 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ndre, ma isu e’yo ’diri ra, ’Ba e’yo olupiri ’yo ra, mani e’yo alu o’biria e’yo aziniri be, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ECC 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kalafe ma: asisileni ndale nga ’dani te mani isule nga kuri ndaria. Ma isu ’ba alu ’ba alifu alu ma eselia, te ’ba ’diyi ma eselia dria ma isuni oku ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ECC 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
