          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du afani efuzu trerisi mi ma ovu ayikosi, te o’du ocokonisi mi ega e’yoni; Mungu oti o’du ’diyi iri tro oti oti, ’ba ma eco ani e’yo ngapi ovupi eri vutiari ndazu nizu ku beni.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
