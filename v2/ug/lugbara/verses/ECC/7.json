              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o’bi e’yo ’diyi onduasi; ma ’yo ra, Ma nga onduaru; te eri ovo ma vu ziri ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
