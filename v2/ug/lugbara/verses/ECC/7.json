              "items": [
                {
                  "text": "Rum 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ovu onyiru aga, tu ku, mi ma ovu onduaru aga ku indi; mi le mi ngulupi dri ja a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.15.32"
              },
              "items": [
                {
                  "text": "Yob 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ovu onzirikanyaru tu ku, azini mi ma ovu onduai kokoru ku indi; mi le dra de nga: ewu mini cani ku a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri onyiru mi ma bi e’yo ’dini ra, ada mi ma nze mi dri e’yo ’dari ma aliasi, ku; a’disiku ’ba Mungu rupiri nga efu e’yo ’diyi ma aliasi dria.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
