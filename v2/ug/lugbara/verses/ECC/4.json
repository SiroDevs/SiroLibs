          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga di asi omvi, nga e’yo tokoru etu etiari ndre: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.7",
            "verseOrgIds": [
              "ECC.4.7"
            ]
          }
        },
        {
