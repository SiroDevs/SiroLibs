                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.6"
              },
              "items": [
                {
                  "text": "Zab 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.20"
              },
              "items": [
                {
                  "text": "Luk 12:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba azini lindi ovupi a’duleri, ’ba eri ma iriru yo, ada, mvani yo, adriazini yo, te azi okporu erini deni i ku, lonyi cani milenia ku indi. Eri kini, Ma di azi okporu nga afa onyiru ogazu ’orindi mani dri, kuzu a’dini nyazuni ya? E’yo ’diri eri e’yo tokoni indi, ada eri azi ocokoruni.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba iri yi ba aga ’ba aluri ra, yini ovule orodri onyiruri be azi okporu yini ma e’yosirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku yi ka o’de va, aluri nga i agyini enga raj te candi ’ba ovupi a’duleri dri erini; e’deria, te ’ba azini eri engapini yo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dika, ’ba iri ka la tualu yi ma ruani dri dri; te ’ba alu ma ruani nga dri ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ka ’ba ovupi a’duleri aga okposi ra ti, te ’ba iri nga eri nde ra. Baka mile be nari ceni i mbele ku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karilau alioru onduaruri aga opi dezaru ondua kokoru imbatani fizu drinia dika kuri onyisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku agu nde efu ndra arujoa muzu angu nyazu opiru; ada, angu eriniri ma alia osi ndra eri alioru. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndre ’ba idriru acipi etu etia ’diyi dria ra, ma ndre karilau fipi ’ba iriru pa sopi opi ma pariari indi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba nde dria, erini ovuzu opiru yi drilia ’diyi ma kalafe lakokoru; te ’ba eri vutia vile ’dele ’diyi ngani ovu ayikosi erisi ku. Ada, e’yo ’diri indi eri e’yo tokoni, azini asi ’bazu oli bizuriru.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
      ]
    }
