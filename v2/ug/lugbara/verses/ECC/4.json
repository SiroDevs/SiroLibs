            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ondua kokoruri ombe i dri ci, nga ani za i ngulupi ma ruaari inya’i.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
