              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga di azi okporu ndre dria, jazi onduouniri be, kini e’yo ’dirisi ’ba jo ejeleari nga ma’yala ’ba i agyi ma ruaa ani. E’yo ’diri indi eri ’le’yotokoni,asi ’bazu oli bizuriru indi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
