                "loc": "ECC.2.17"
              },
              "items": [
                {
                  "text": "Ekl 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ma nga di ’ba draza drapi ’bo ’diyi inzi aga ’ba idriru ovupi nga idri yini be ’diyi ra; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        },
        {
