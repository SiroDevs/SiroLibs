            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia ma nga ma oja inzata yini ’ba inzazu etu etia ’diyi ndrezu; te mi ndre, ’ba yini inzale ’diyi ma mindre ra ’dani, te ’ba yi ma asi omipini yo! ’Ba yi inzapi ’diyi ovu okpo be, te ’ba yi ma asi omipini yo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
