            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.29"
              },
              "items": [
                {
                  "text": "Luk 23:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ada, ma ega ’ba ovupi nga yori ovu onyiru yi iri tro agazu, azi onzi ovupi ’yezaru etu ma etiari nipi kuri’i.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
