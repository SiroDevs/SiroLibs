            "sid": "ECC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.17"
              },
              "items": [
                {
                  "text": "Yob 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
