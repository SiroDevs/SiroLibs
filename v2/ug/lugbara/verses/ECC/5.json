                }
              ]
            }
          ]
        },
        {
          "text": "Mi ka inzata ’bani ’ba aliarioru ’diyi inzazuri ndre angu azini ma alia, ’bani e’yo liza kililiruri pi asuzu okposi e’yo adaru be, mi ma osu e’yonisi ku; a’disiku ’ba uru drile tu ’ba uruleru ’diyi agapi rari adri e’yoni ne ra; ’ba uruleru ’ba ’diyi agapiri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
