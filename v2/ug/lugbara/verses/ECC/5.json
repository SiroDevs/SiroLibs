            }
          ]
        },
        {
          "text": "’Ba dahabu lepiri ngani tra dahabusi ku; ’ba afa o’biru lepiri ngani tra afa erezasi ku indi: e’yo ’diri e’yo tokoni indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa ka ezu tre, ’ba yi nyapi ’diyi ezu alu indi; e’ini ani a’di orodri isu ya? Eri lu kiri yi one milesi a’dule.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
