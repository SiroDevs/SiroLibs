              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "vutinia lonyi nde avi drile onzisi; eri ka mva ti ’bo, drinia afa aluni yo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
