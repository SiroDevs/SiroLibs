              "items": [
                {
                  "text": "1 Tim 5:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ku mi tile ma fe mini e’yo onzi ’yezu ku, vini indi mi ma ’yo malaika ma tia kini, Ma avi avi, ’dini ku; Mungu ma ovu adrasi erini o’duko mini eriria, azi mi drini ’yeleri ezazu a’disi ya?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
