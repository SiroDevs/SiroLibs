          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini indi, afa nyakuni kaleri ma orodri eri ’ba driani, ka tro opini ti, amvuni eri ma aza koni.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
