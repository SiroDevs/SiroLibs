        {
          "text": "A’disiku orobini ’ba obi azi kakau ma e’yosi, azini ’ba ondua kokoruri ma o’dukoni efu e’yo o’biru ’diyisi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
