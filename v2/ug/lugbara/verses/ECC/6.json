              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ka ovu ngoni ti, ’da runi andra drio, ni ra kini eri ’bani, eri econi agata gazu ’ba okpo be eri ndepi rari be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te afa karakarau indi e’yo tokoru ezupi tre ’diyi, ’bani ani a’di isu ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.14"
              },
              "items": [
                {
                  "text": "Yak 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.6"
              },
              "items": [
                {
                  "text": "Zab 39:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku a’di ni e’yo ovupi ’ba dri onyiru idri erini ma alia, ada, idri erini tokoru erini ’a’azu endri­lendrileri ma o’du ma alia driarini ya? A’di eco e’yo ngapi ovupi eri ma vutia etu etiari oluzaru ’ba ma tiani ya?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
        }
