                "loc": "PSA.58.8"
              },
              "items": [
                {
                  "text": "Zab 58:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini ka anzi oti turu alu, ka adri idriru eli kakau, o’du eri ma elini ’diyini ecazu kakau ani, te eri, ma asi ka tra afa onyirusi ku, ka awi eri sa ku; ma kini, mva e’bepi e’beri aga eri onyisini. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku eri emu e’yo tokoru ma alia, eri mu angu bizasi, angu biza a’bu runi ci; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "drinisi ndreni nga etu ku, nini e’yo ku indi; ’diri isu ava liza aga aziri ra, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada eri ka tro ovu, idriru eli alifu alu pale iri ti, te ovuni ayikosi e’yo onyirusi ku-’ba dria muni pari alua ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
