                "loc": "NUM.16.22"
              },
              "items": [
                {
                  "text": "Kal 16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "de nga irifura mvini nyakua kile erini ovule ndra okorile ku, de nga orindi mvini Mungu eri fepiri vu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo toko e’yo tokoniri, ’Ba e’yo Olupiri ’yo ra; kini, e’yo dria eri e’yo tokoni.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
