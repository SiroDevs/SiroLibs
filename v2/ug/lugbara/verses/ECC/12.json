              "items": [
                {
                  "text": "E’do 27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "o’du nde ’dasi ’ba jo agei tepi ’diyi ma ruani nga ya ya, ’ba okporu ’diyi nga avu va, ’ba anya ’ipi ’diyi nga yi de ra yini ovule lamirurisi, ’ba angu lupi derisasi ’diyi nga bi iniciciru indi, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
