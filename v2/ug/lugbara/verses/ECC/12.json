              "items": [
                {
                  "text": "Mik 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.35"
              },
              "items": [
                {
                  "text": "2 Sam 19:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "jotile yi nga ovu ecizaru ci geri tia; awu anya ’izuri ka nga ovu were, ’ba ka nga enga aria ma awusi ra, ka nga ezoanzi ongo ngopi ’diyi ji dria va; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.32"
              },
              "items": [
                {
                  "text": "Lev 19:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ada, yi nga ovu urisi afa izururi ma e’yosi, azini e’yo uriuriru ’diyi nga ovu geria ci, ofunzeni nga fu zo ra, ombini nga ovu teriru, avani nga oti ra; a’disiku ’ba mu jo ini ’daniria, azini ’ba lulu gapi ’diyi yi geria ci; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "de nga ayuni anziriku dahabururi ku, de nga awala meleruri nyoni i ku, de nga imvu drani yi a’di ma tia ku, de nga afa trale omberuri nyoni i ’bile yi ta mbazuria ku, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
