          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini indi ’Ba e’yo Olupirini ovule onduarurisi, eri imba ’ba onita onizu ’dani; ada eri ega e’yoni i asia, eri ndru e’yo o’beza yi otizu kililiru. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba e’yo Olupiri o’bi e’yo ayiko fepi ’diyi ndazu, ovupi sizaru kililiru, e’yo adaru ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
