          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo asiza eri ’di’i; e’yo dria ovu erizaru ’bo Mi ru Mungu, mi mba azita erini ’diyi ma ta; e’yo ’diri eri azi ’bani dria. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.36"
              },
              "items": [
                {
                  "text": "Mat 12:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku Munguni nga azi dria ji e’yo liza ma alia, e’yo zizaruri be dria, kani eri onyiru, kani onzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
