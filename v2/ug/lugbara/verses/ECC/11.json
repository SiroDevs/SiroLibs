                  "text": "2 Kor 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’be mikate mini yi mirini ma dria, mini ngale eri isule dika o’du kakau ma vutiarisi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
