              },
              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi mi ofu candi mi asiari amve, mi nze e’yo onzi mi ruaasi; te ewu karilauniri pi yi toko, ewu ’ba ruani ovuzu okporu turi be.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
