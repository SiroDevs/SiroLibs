            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ri ori mini o’bitisi, ondresi mi nze mi dri ku; a’disiku mi nini ku afa ngori nga i ’ye drilebasi, kani ’diri, kani ’dari, kani yi iritro nga ’ye onyiru yani.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
