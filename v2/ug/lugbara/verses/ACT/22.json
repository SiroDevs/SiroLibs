              },
              "items": [
                {
                  "text": "’Yeta 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.2"
              },
              "items": [
                {
                  "text": "13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ma tia, Mi mu, a’disiku ma nga mi ti pe ziri ’ba Jururu vu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        }
