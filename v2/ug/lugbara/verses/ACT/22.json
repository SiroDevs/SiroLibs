        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Drusi ’dini, erini leria e’yo ’ba Yahudini eri esuzu ma efi adari nizu, eri tru eri ra, azi kuhani amboru ’diyi ’ba ’wara e’yo amapi ’diyi be dria yi okuzu tualu. Eri eji Pauloni, ’ba eri yi drilia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
        }
      ]
