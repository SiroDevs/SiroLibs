                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.18"
              },
              "items": [
                {
                  "text": "Gal 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri eca ’dini, ma ka mvi Yerusalemua ’bo, mani Mungu ziria hekalua, ma ava oti ra, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ne eri erini e’yo ’yoria ma tia kini, Mi nga mbelekocici, mi fu Yerusale­muasi, a’disiku yi ngani e’yo mini etini nzele masiri eri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "’Yeta 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma, ’yo, Opi, yi ma ngulupi ni ra kini ma adri ndra ’ba mi a’ipi ’diyi obi ’ba jo arunia yi cozu, jo ’ba Yahudini yi okuzu ’diyi vusi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
