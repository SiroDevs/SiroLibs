            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ka eri erini ’yoria Ebrania tisi, yi ovu ciri aga ra. Eri ’yo ra: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        },
        {
