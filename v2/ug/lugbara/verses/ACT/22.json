                  "text": "8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini yini Setefano ’ba e’yo mini ma eti nzepiri ma ari adaria, ma’i ma ngulupi so de pa ’daa indi e’yoni a’izu, ’ba eri fupi ’diyi ma bongo ta mbazu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
