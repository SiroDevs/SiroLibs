        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.20"
              },
              "items": [
                {
                  "text": "’Yeta 19:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Munguni nga ku wakaka; ’ba Yesu vuti bipi Yerusalemua ’diyi ma kalafe nga ezu tu; ’ba kuhaniru ’diyi kakau nga a’ita ma vuti bi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Setefano’i erini garia ’yeta anzutirisi okpo be tre, eri ’ye tali osutaru azini eceta amboru ’ba ongulumuru ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.8",
            "verseOrgIds": [
              "ACT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba azini ibipi engapi pari ’ba omvele Liberitinoru ’diyini yi okuzuri ma alia ’diyi, ’ba Kurenea ’diyi pie, ’ba Alegezandariaa ’diyi pie, ’ba Kilikiaa ’diyi pie, ’ba Asiaa ’diyi pie, yi enga agata gazu Setefano be. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.9",
            "verseOrgIds": [
              "ACT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.15"
              },
              "items": [
                {
                  "text": "Luk 21:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi econi ondua erini azini Orindi fepi eri dri e’yo ’yozuri ogazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.10",
            "verseOrgIds": [
              "ACT.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.60+MAT.26.61+MAT.26.62+MAT.26.63+MAT.26.64+MAT.26.65+MAT.26.66"
              },
              "items": [
                {
                  "text": "Mat 26:60-66",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di ’ba inzo lipi ’diyi ofe zizaru, yi ma ’yo ani kini, Ama eri erini e’yo ’yoria Musa pi o’dazu Mungu be. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.11",
            "verseOrgIds": [
              "ACT.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi fe ’ba kakau ma asi enga dria aokosi, ’ba ’wara pie, ’ba waraga sipi ’diyi pie, yi eca dria venia, yi bi eri, ji eri ’ba e’yo amapi ’diyi ma drilia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.12",
            "verseOrgIds": [
              "ACT.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.11"
              },
              "items": [
                {
                  "text": "Yer 26:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi enga ’ba inzo lipi ’diyi urulesi, yi ’yo ra, ’Ba ’dori kuni e’yo saaru ’yozu pari alatararu ’dori ma ruaa azita be ku; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.13",
            "verseOrgIds": [
              "ACT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ama eri erini ’yoria ’dini, kini Yesu ’ba Nazare­tiari nga pari ’do ma dri ja ra, indi vini eri nga e’yo ’yeza Musani ndra fele ama driri oja ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba dria ripi ti nzeria ’diyi yi nga eri ndre okposi, yi ndre mile erini ekile malaikanirile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.15",
            "verseOrgIds": [
              "ACT.6.15"
            ]
          }
        }
      ]
    }
