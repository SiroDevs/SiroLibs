                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ’yo ’dini yini Turofimo ’ba Efesoari ndrele tualu Paulo be aku amboru nderi alia ’borisi, yi ega yi ma asisilea Paulo ji eri hekalu alia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
