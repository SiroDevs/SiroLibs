              "items": [
                {
                  "text": "Luk 23:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’ba ongulumuru bi vutini, otrezu uru kini, Ma ja eri dri ra!",
          "type": "text",
