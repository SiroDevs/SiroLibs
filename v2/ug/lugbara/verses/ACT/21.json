              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ovuni Misiriou ndra omba ’bapi o’du agapi ’dasi, ’ba ’ba fupi alifu su ’diyi dri cepi roko driari’i ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
