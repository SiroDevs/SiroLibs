              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini indi eri ma pe Kristo ndra erini pele okokele emi driri ma ti, eri Yesu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.20",
            "verseOrgIds": [
              "ACT.3.20"
            ]
          }
        },
