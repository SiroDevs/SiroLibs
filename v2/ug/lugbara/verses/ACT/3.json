                }
              ]
            }
          ]
        },
        {
          "text": "Te eli, ma adripi, ma ni ra emi ’ye e’yo ’diri aniakosi, opi emini ’ye ’dini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.17",
