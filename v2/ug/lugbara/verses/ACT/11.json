              "ACT.11.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.1+ACT.8.2+ACT.8.3+ACT.8.4"
              },
              "items": [
                {
                  "text": "’Yeta 8:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ovupi erezaru inzata engapi Setefano ma e’yosirisi ’diyi, yi ca kpere Foenikia azini Kuporoa azini Antiokiaa, yi olu e’yo kiri ’ba Yahudini dri a’dule. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.19",
            "verseOrgIds": [
              "ACT.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba azini yi eselia, ’ba engapi Kuporoa azini Kurenea ’diyi, yini ecaria Antiokiaa yi ’ba e’yo ’yo ’ba Girikiru ’diyi tia indi, Opi Yesuni oluzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.20",
            "verseOrgIds": [
              "ACT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.47"
              },
              "items": [
                {
                  "text": "’Yeta 2:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dri Opini ovu yi be, ’ba ongulu­muru kakau a’ipi ’diyi yi oja yi Opi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.21",
            "verseOrgIds": [
              "ACT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.36"
              },
              "items": [
                {
                  "text": "’Yeta 4:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo yini ku cazu kpere kanisa ovupi Yerusalemuari ma bilia, yi pe Baranaba ma ti Antiokiaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.22",
            "verseOrgIds": [
              "ACT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.43"
              },
              "items": [
                {
                  "text": "’Yeta 13:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Erini ecaria, erini asi ndriza Mu­nguni ndreria, eri ovu ayikosi;eri omi asi yini dria yi ma ’ba asi yini okporu yi ebizu Opi vu ’dani; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.23",
            "verseOrgIds": [
              "ACT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.14"
              },
              "items": [
                {
                  "text": "’Yeta 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.5"
              },
              "items": [
                {
                  "text": "6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "erini ovule ’ba onyi be, gazaru Orindi Alatara­rusi azini a’itasi trerisi. Te ’ba kakau lo’ba yi Opi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.24",
            "verseOrgIds": [
              "ACT.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
