                  "text": "Yoh 15:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yini yi okuria tualu eri be eri fe yi dri azita kini yi ma nga Yerusalemuasi ku, te yi ma te aziza Atani; Aziza nde, eri kini, emini ndra erile ma vu ’bori; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.4",
            "verseOrgIds": [
              "ACT.1.4"
            ]
          }
        },
