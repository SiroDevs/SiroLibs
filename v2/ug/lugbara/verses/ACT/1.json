                  "text": "Luk 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ecazu kpere o’du erini tuzu ururia ’diyi; de nga eri tuni ku eri fe azita Orindi Alatararusi ’ba erini ti opele ’diyi dri oko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.2",
            "verseOrgIds": [
              "ACT.1.2"
            ]
          }
        },
        {
