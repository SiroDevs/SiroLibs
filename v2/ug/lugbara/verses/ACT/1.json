                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adripi mani, e’yo siza ma ’ye i tro­tro ekile e’yo Orindi Alatararuni ecele ndra oko Daudi ma tisi Yudasi ’ba Yesuni bipi ’diyi ma dri cepirisirile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
