                  "text": "Mar 13:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri omvi e’yo yi tia, ’Di e’yo emini yo, ewu kani eli Atani pele ovuzu okpo ini ma alia ini lelerile ’diyi nizu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
