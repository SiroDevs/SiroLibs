              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu ndra lazaru ama be, azini eri isu azi ’dori ma esele indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
