                  "text": "Luk 24:47-48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi nga okpo isu Orindi Alatararu ka eca emi dria ra, emi nga e’yo mani ma eti nze Yerusalemua, Yudiaa dria, azini Samariaa, cazu kpere nyaku ma kalatini asiria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
        },
        {
