              "items": [
                {
                  "text": "Yoh 6:62",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka e’yo ’diyi ’yo ’bo, yini eri ndreria eri ovu ’duzaru uru, iriti a’bu eri yi milia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.9",
            "verseOrgIds": [
