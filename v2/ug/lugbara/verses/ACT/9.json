              "attrs": {
                "loc": "ACT.16.9"
              },
              "items": [
                {
                  "text": "16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini indi Damasikia Yesu ma vuti bipiri, runi Anania’i. Opi ’yo eri tia eceta erini ndrelerisi kini, Anania. Eri ’yo ra, Ma ’do’i, Opi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.39"
              },
              "items": [
                {
                  "text": "’Yeta 21:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi ’yo eri tia, Mi enga, mi mu geri ’bani omvele Kililiruria, mi zi jo Yudasinia ’ba engapi Tarisoa omvele Saulo’iri ci ya; mi ne, eri ovu Mungu ziria, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ndre ’ba azini runi Ananiani efiria dri tiria i dria, i ma mile ma ndre angu ani dika, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.12",
            "verseOrgIds": [
              "ACT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Anania eri omvi e’yo tinia, Opi, ma eri e’yo ’ba ’dirini ’ba kakau ma tia, e’yo onzi kakau erini ’yele ’ba mini alatararu Yerusalemua ’diyi vuri; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.13",
            "verseOrgIds": [
              "ACT.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.2"
              },
              "items": [
                {
                  "text": "1 Kor 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.16"
              },
              "items": [
                {
                  "text": "’Yeta 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.22"
              },
              "items": [
                {
                  "text": "2 Tim 2:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’doa eri ovu okpo kuhani amboru ’diyini fele eri driri be, ’ba dria mi ma ru i omvepi ’diyi o’izu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.5"
              },
              "items": [
                {
                  "text": "Rum 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.25.13"
              },
              "items": [
                {
                  "text": "’Yeta 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.24"
              },
              "items": [
                {
                  "text": "27:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.7"
              },
              "items": [
                {
                  "text": "2 Kor 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Opi ’yo eri tia, Mi mu, a’disiku eri ovu afazu mani pele ru mani ojizu suru ndu ndu vu, azini opi vu, azini anzi i Israelini vu indiri; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.29"
              },
              "items": [
                {
                  "text": "’Yeta 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Kor 1:23-28",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ma nga inzata amboru erini ngale isule ma rusiri ece eri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.16",
            "verseOrgIds": [
              "ACT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini Anania nga di mu ra, eri fi jo nderia, erini dri tiria eri dria eri ’yo kini, Ma adripi Saulo,Opi Yesu, eri’i i e’dapi mi vu geria mini emuriari pe ma u mi vu ’dini mi ma ndre angu dika azini mi ma ovu gazaru tre Orindi Alatararusi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.17",
            "verseOrgIds": [
              "ACT.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Coti afa e’de eri miliasi va ekile ongoro’bole, eri ndre angu dika. Te eri enga, eri bi baputizi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.18",
            "verseOrgIds": [
              "ACT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini eri ka nyaka nya ’bo eri isu okpo ra.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu ’ba Yesu vuti bipi Damasikia ’diyi be o’du were. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Coti eri olu Yesu pari ’bani yi okuzuria, kini, Eri Mvi Munguniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        },
