                {
                  "text": "’Yeta 23:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te Saulo eri ni e’yo yini otule i ma ruaari ra. Yi re kalitile agei etu zu ini rra, lezu eri fuzu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
