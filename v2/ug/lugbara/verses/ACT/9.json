          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.20"
              },
              "items": [
                {
                  "text": "’Yeta 9:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Baranaba ’du eri, ii ’ba ti opele ’diyi vu, ece yi dri e’yo erini Opini ndrezu, azini Opini e’yo ’yozu eri be etiari, azini e’yo erini e’yo oluzu uri kokoru Damasikia ru Yesunisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini eri ovu yi be Yerusalemua fizu azini fuzu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini e’yo oluzu Opi ma rusi uri kokoru. Eri ’yo e’yo, eri ga agata ’ba Yahudini Giriki ti ’yopi ’diyi be; te yi nda eri fuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.25"
              },
              "items": [
                {
                  "text": "’Yeta 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.21"
              },
              "items": [
                {
                  "text": "Gal 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adripi yi ka e’yo nderi ni ra, yi ji eri Kaisariaa, tini pezu Tarisoa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
