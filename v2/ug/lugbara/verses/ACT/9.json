              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba voti bipi ’diyi yi ’du di eri inisi ra, yi osi eri abi ruaasi va acalaka alia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
