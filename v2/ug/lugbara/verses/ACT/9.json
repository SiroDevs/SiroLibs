              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ka eca Yerusalemua eri o’bi fizu tualu ’ba Yesu voti bipi ’diyi be, te yi dria ru eri tu, yi a’ini leu kini eri ovu ’ba Yesu vuti bipiriru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
            "verseOrgIds": [
              "ACT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
