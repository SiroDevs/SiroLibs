              },
              "items": [
                {
                  "text": "Rum 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’diyi ma vutia, Paulo ’ba i ma asi agazu Makedoniaasi azini Akayaasi, muzu Yerusalemua, ’yozu kini, Ma ka ovu ’dale ’bo, ma ma ne Rumini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
