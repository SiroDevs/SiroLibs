                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.17"
              },
              "items": [
                {
                  "text": "2 Kor 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.10"
              },
              "items": [
                {
                  "text": "2 Yoh 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’ba azini yi ma eselia ovu asi mbaza be, yi a’ini ku, te yi o’da Geri nderi ’ba ongu­lumuru ma milia; e’yo ’disi eri nga fu yi ma eseliasi, nga ’ba Yesu vuti bipi ’diyi ma esele co ndu, eri imba etuzu jo ’bani ondua imbazu Tura­norima, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.9",
            "verseOrgIds": [
              "ACT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye ’dini eli iri ma alia dria, ’dini ’ba dria ovupi Asiaa ’diyi yi eri e’yo Opini, ’ba Yahudini ’diyi ’ba Girikini ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        }
      ]
    },
