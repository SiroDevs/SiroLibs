                "loc": "LUK.22.52"
              },
              "items": [
                {
                  "text": "52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini nga e’yo ’yoria ’ba nde ’diyi tia, kuhani azini asikari ambo hekaluari nga eca yi vu ’ba Sadukayoni ’diyi be; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.1",
            "verseOrgIds": [
              "ACT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.8"
              },
              "items": [
                {
                  "text": "’Yeta 23:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ovu aokosi tu yini ’ba nde ’diyi imbale­risi, azini yini engata ’ba draza eselia Yesusiri ma eti nzelerisi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.2",
            "verseOrgIds": [
              "ACT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.1"
              },
              "items": [
                {
                  "text": "’Yeta 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi obi yi ci, yi ofi yi arujoa cazu kpere o’bitisi, anguni ovule ondre­runirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.3",
            "verseOrgIds": [
              "ACT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.47"
              },
              "items": [
                {
                  "text": "’Yeta 2:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba karakarau e’yo eripi ’diyi yi a’i ra; kalafe agupini eca ekile alifu towile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri eca drusi ’dini, ’ba ’ba dri cepi ’diyi pi oku yi tualu Yerusa­lemua ’ba ’wara pie, ’ba waraga sipi ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.5",
            "verseOrgIds": [
              "ACT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anasi kuhani amboruri pi indi, Kaifa pie, Yohana pie, Alegezanda pie, ’ba ovupi ori’ba kuhani amboruni ma alia ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.6",
            "verseOrgIds": [
              "ACT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.23"
              },
              "items": [
                {
                  "text": "Mat 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka yi ’ba yi eselia ’boo yi zi yi tia, Emi ’ye e’yo ’diri okpo ngorisi ya, kani ru ngorisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.7",
            "verseOrgIds": [
              "ACT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.19"
              },
              "items": [
                {
                  "text": "Mat 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi Petero gapi Orindi Alatararusi treri nga di ’yo yi tia, Emi’i ’ba ’ba dri cepi ’diyi azini ’ba i ’wara, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.8",
            "verseOrgIds": [
              "ACT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ka ama ozi andru azi lonyiru ’ba acozaru ’diri vurisi, eri isu atiza ngoni ngoni ya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.9",
            "verseOrgIds": [
              "ACT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.6"
              },
              "items": [
                {
                  "text": "’Yeta 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.13+ACT.3.14+ACT.3.15+ACT.3.16"
              },
              "items": [
                {
                  "text": "13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emi dria ma ni, azini ’ba Israelini ’diyi dria ma ni eri ovu Yesu Kristo ’ba Nazaretiari ma rusi, eri’i emini dile pati ruaa te Munguni engale ’ba draza eseliari; eri ma rusi ’ba ’dori so pa emi milia rua alaru be ’do. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.10",
            "verseOrgIds": [
              "ACT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Zab 118:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.42"
              },
              "items": [
                {
                  "text": "Mat 21:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diri ovu oni emi ’ba jo sipi ’diyini ’bele amve te eri eca curu’do jo kalati ma oni driruri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.21"
              },
              "items": [
                {
                  "text": "Mat 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba econi yi pazaru ’ba azini ma e’yosi ku, te ru andini ’bu etia ovupi fezaru ’ba eselia, amani ama pazu aniri aluni yo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi ka Petero pi ndre Yohana be yini ovuria uri kokoru, ni ra yi ovu ’ba ’bani imbale tu ku, ’ba tokoni ’diyi, yi osu ani tu; yi va ani yi ovu ndra Yesu be ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.13",
            "verseOrgIds": [
              "ACT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.8"
              },
              "items": [
                {
                  "text": "’Yeta 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini ’ba ovupi atizaruri ndreria erini pa soria tualu yi be, yi econi e’yo ’yozaru agataru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.14",
            "verseOrgIds": [
              "ACT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi fe yi dri azita yi ma fu nga amve were, yi ega e’yo tualu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.15",
            "verseOrgIds": [
              "ACT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.47"
              },
              "items": [
                {
                  "text": "Yoh 11:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’yozu, Ama nga ’ye ’ba ’diyisi ngoni ya? Adaru yi ’ye tali kuzaru yi ma drisi; ’ba dria adripi Yerusalemua ’diyi ni ra, te ama econi ’yozaru kini eri inzoni, ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.16",
            "verseOrgIds": [
              "ACT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.28"
              },
              "items": [
                {
                  "text": "’Yeta 5:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ma ega yi dria, yi ma olu ru nderi dika ’ba aluni tia ku, e’yo nderi kazu kuzu ’ba ma eselia dika ku, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.17",
            "verseOrgIds": [
              "ACT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi omve yi, yi azi yi ma tia yi ma olu kani imba ru Yesunisi dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.18",
            "verseOrgIds": [
              "ACT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.29"
              },
              "items": [
                {
                  "text": "’Yeta 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Petero pi Yohana be yi omvi e’yo yi tia kini, Emi ma li e’yo ’diri emi’i, kani eri onyiru Mungu ma milia ama ma eri emi aga Munguni ra ya; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.19",
            "verseOrgIds": [
              "ACT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ama econi e’yo amani ndreleri azini erileri kuzaru ’yokokoru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.20",
            "verseOrgIds": [
              "ACT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ka ega yi dria dika, yi fe geri yi dri, yi econi yi inzazaru dika ku ’ba ongulumuru ma e’yosi; ’ba driani Mungu inzile e’yo nderisirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.21",
            "verseOrgIds": [
              "ACT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
