                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vutinia Asa ovu di adrasi ’ba e’yo ndreza ndrepiri be, ’ba ani eri arujoa, aokoni eri nyale kai eri ma ruaa e’yo ’dirisirisi. Asa inza vini ’ba nde ’diyi ma azi ewu ndesi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini mi ndre, ’yeta Asani ’yele, oko azini vile ’diyi, mi lu, yi ovu sizaru buku opi Yudani azini Israelini ’diyini ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.22"
              },
              "items": [
                {
                  "text": "Azi 28:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.5"
              },
              "items": [
                {
                  "text": "Yer 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eli kali na drini oromi Asani opi nyazu­risi, azo bi eri paa, azo erini ndra ovu okporu tu; te azo erini ma alia eri ndani ani Yehovani ku, te lu ’ba ojouru ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Asa la i a’bipi be, dra de eli erini opi nyazuri ca di kali su drini alu ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
