                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di e’yo omvi eri tia kini, Mi ka ovu asi ndrizasi ’ba ’diyi vu, mi kal ayiko fe yi dri, e’yo onyiru ’yozu yi be, ka’dini yi nga ovu ati’ba mini ’dani’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.7",
            "verseOrgIds": [
              "2CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
