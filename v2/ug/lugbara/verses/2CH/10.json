        },
        {
          "text": "Te Rehoboamu mu Sekemua, a’disiku Israeli dria ca Sekemua eri ’bazu opiru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.1",
            "verseOrgIds": [
