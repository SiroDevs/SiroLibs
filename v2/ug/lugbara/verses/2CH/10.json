              "items": [
                {
                  "text": "32:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Rehoboamu nga di e’yo nderi ama tualu ’ba mbazaru pa sopi ndra i ati Sulemani drilia ewu erini ovuzu nga idrirurisi ’diyi be, kini, Emi ama e’yo ngoni eminingale fele ma driri omvizu ’ba ’doyi ma tia ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.6",
            "verseOrgIds": [
              "2CH.10.6"
            ]
          }
        },
        {
