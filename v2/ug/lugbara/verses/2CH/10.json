                "loc": "1KI.11.40"
              },
              "items": [
                {
                  "text": "1 Opi 11:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, Yeroboamu Nebati mvi ka e’yo nderi eri ra (a’disiku eri de Misiria, pari erini apazu nzuzu opi Sulemani ma miliarisi), Yeroboamu nga dri atri engazu Misiriasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi pe ’ba tileri omvezu; Yeroboamu pi emu, ’ba ongulumuru Israelini be dria’i nga ’yo Rehoboamu tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
