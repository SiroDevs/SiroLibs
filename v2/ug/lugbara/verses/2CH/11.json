                  "text": "1 Opi 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "oku nde ti agupianzi eri dri, Yeusi pi, Semaria pie, Zahamu be. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
            ]
          }
