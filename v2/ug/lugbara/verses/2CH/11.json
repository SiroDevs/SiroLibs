          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku ’diri ma vutia eri nga vini Maaka Abisalomu zini je, oku nde ti eri dri Abiya pi, Atai pie, Ziza pie, Selomiti pie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
              "2CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
