              },
              "items": [
                {
                  "text": "2 Sur 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "De isu Ahazia ma eli kali su drini iri erini e’doria opi nyazurisi, nya opi Yerusalemua eli alu. Andri ma ru Atalia, Omiri zi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aci vini indi geri suruti Ahabuni ’diyinisi, a’disiku eri ma andrini adri e’yo ama eri imbazu onzi ’yezuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
