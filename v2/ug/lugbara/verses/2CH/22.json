          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Atalia Ahazia andrini ndre­ria kini i mvi dra di ’bo, eri enga di karianzi suru Yudani ’diyi ofu dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.2"
              },
              "items": [
                {
                  "text": "2 Opi 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi zi Yehosabeati nga Yoasi Ahazia mvi ’du, nga eri ogu opianzi ’bani ofule ’diyi ma eseliasi ra, nga eri ’ba pari ’bani lazuri ma alia endria eriniri be. ’Dini opi Yehoramu zi Yehosabeati, atalau Yehoyada ma oku (a’disiku eri ndra Ahazia ma amvi) zi eri Ataliasi ra, ma fu eri ku beni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ovu di zizaru yi be jo Munguniri ma alia eli azia; te Atalia nga di angu nyani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
