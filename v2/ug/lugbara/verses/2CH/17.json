                  "text": "1 Opi 12:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te eri nda Mungu eri a’bipiniri’i, acizu azita erini ’diyi ma alia, te ’yeni ekile Israelini ’yele ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
