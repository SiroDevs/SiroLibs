                "loc": "2CH.15.3"
              },
              "items": [
                {
                  "text": "2 Sur 15:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eli erini opi nyazuri ka ca na, ope ’ba ’wara erini opiru ’diyi ma ti, ada yi Beni-haili pi, Obadia pie, Zekaria pie, Netaneli pie, Mikaya pie, ’ba imbazu aku ambo ambo Yudaa ’diyi ma alia; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini tualu yi be ’ba Levini ’diyi Semaya pi, Netania pie, Zebadia pie, Asaheli pie, Semiramoti pie, Yehonatani pie, Adoniya pie, Tobiya pie, Tobadoni­ya pie, yi ’ba Levini; azini yi be indi Elisama pi, Yehoramu be, ’ba edeta edepi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
