              "attrs": {
                "loc": "2CH.15.8"
              },
              "items": [
                {
                  "text": "15:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri o’ba asikari aku ambo ambo dria abi kaliru be Yudaa ’diyi ma alia ci, o’ba asikari angu agei tepi ’diyi angu Yudani pi ma alia aku ambo ambo Efiraimuni ’diyi be, ndra eri ma ati Asani opale ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        },
        {
