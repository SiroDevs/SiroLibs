                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ovu ndra Yehosafati be, erini acile geri oko i a’bi Daudini ’diyi ma aliarisi; eri ndruni adrou Baaliru ’diyi ku, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
