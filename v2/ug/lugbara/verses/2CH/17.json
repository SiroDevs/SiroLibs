              "items": [
                {
                  "text": "2 Sur 14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uri Yehovani ’de suru nyaza angu Yudani ma ageia ’diyi ma dria dria, ka’dini yi ’bani ani omba Yehosafati be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.2"
              },
              "items": [
                {
                  "text": "2 Sam 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Filisitiaa ’diyi ma azi eji afa feza Yehosafati dri, dahabu be musororu; ’ba Arabua ’diyi indi eji eri dri anyapa nyiri ’diyi ’o’biru, eji kabiloago alifu aziri drini turu aziri, ndriago alifu aziri drini turu aziri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehosafati idri i ovuzu amboru tu. Eri si jo okporu Yuda ma alia kakau, aku ambo ambo afa ta mbazu ’diyi be, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ovu azi be kakau aku ambo ambo Yudaa ’diyi ma alia. Eri ovu asikari ombani, ’ba okporu asi teza be ’diyi be Yerusalemua indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma kalafe ekile yi ma a’bipi ma ori’ba vusi ndra ’dini: Yuda eselia ’ba asikari alifu alu dri cepi ’diyiru: Adina ’ba asikari dri cepiri pi, ’ba okporu asi teza be ’diyi be alifu turu na; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba eri vutiari Yehohanani ’ba asikari dri cepiri pi, ’ba eri be ’diyi pie alifu turu iri drini kali aro; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.15",
            "verseOrgIds": [
              "2CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 17:16"
          },
          "items": [
