                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi imba ’ba Yudaa, de buku azita Yehovanirini yi ma dria ci; yi aci aku dria Yudaa ’diyi ma alesi dria, ’ba imbazu ’ba nde ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
