        },
        {
          "text": "Ati’ba erini ’diyi eci yi ti e’yo otuzu ruania, nga eri fu eri ma ngulupi ma joa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
