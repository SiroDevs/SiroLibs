                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri si vini pari edeta edezu ’diyi jo Yehovaniri ma alia, ndra Yehovani ’yozu kini, Ma nga ma ru ’ba Yerusalemu ma alia ’dani ’daniri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
