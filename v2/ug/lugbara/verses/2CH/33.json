              "items": [
                {
                  "text": "2 Sur 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Si vini pari nde edeta edezu ’diyi ongulumu ’bua ’diyi dri dria, jo Yehovani ma iriidri iri ’diyi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
