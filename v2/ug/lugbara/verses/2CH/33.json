              },
              "items": [
                {
                  "text": "2 Tim 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri doni i e’yere Yehova ma milia, ekile i ati Manaseni dolerile ku, te Amoni nde ’diri dro e’yo eza drile drile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
