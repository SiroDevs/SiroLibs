        },
        {
          "text": "Eli aziririsi Yehoyada imba i ma ngulupi okporu, nga ti efi ambo asikari turu alu ma dri cepi ’diyi be, yi Azaria Yerohamu mvi pi, Isimaeli Yehohanani mvi pi, Azaria Obedi mvi pi, Maaseya Adaya mvi pi, Elisafati Zikiri mvi pie dria, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
