          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.2"
              },
              "items": [
                {
                  "text": "’Yeta 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emi ’ba na ma esele aluri ma azini nga ovu opi vile akua; emi ’ba na ma esele aluri nga ovu jotile jo ma eti e’dozuria; te ’ba nde dria ’diyi nga ovu irii Yehova vile joari ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
