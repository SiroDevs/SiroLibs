        },
        {
          "text": "’Diri e’yo emini ngale ’yeleri: emi ’ba na ma esele aluri efipi etu sabatonisi, ’ba atalauru azini ’ba Leviniru ’diyi, emi nga ovu ’ba azi ngapi jotilea ’diyiru; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
