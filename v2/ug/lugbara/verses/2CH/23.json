        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.112.5"
              },
              "items": [
                {
                  "text": "Zab 112:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga aci angu Yudani ma alesi, nga ’ba Levini oku aku Yudani ma aliasi dria, ’ba Israelini ori’ba yi ma a’bipini ma dri cepi ’diyi be dria, yi nga di emu Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
