        },
        {
          "text": "Azita ’dini ’baria i ereriaria indi­kindi, anzi Israelini nga anya kapi okori pi fe fudri ci, afa mvuza pie, odu pie, anyusu pie, afa dria kapi amvua ’diyi pie dria; yi eji afa dria ma esele mudri ma azi aluri fudri ci. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
