        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Lev 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.28"
              },
              "items": [
                {
                  "text": "Azi 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Israelini piyi anzi Yudani be, ovupi aku Yudani ma alia ’diyi, yi eji alu indi ti pi ma esele mudri ma azi aluri, kabilo be, eji vini afa feza fele alaru Yehova Mungu yiniri dri ’diyi ma esele mudri ma azi aluri indi, yi oda di yi nguru nguru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi e’do afa yini okule nguru nguru ’diyi ma eti odazu mba narisi, yi de di mba azirmsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
