                  "text": "29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa feza opini engapi afa eri vile ’diyi ma eseliari eri edeta vezaru ’diyi, adani yi edeta vezaru o’bitisiri, pi ondreniri be, azini edeta vezaru sabatosi ’diyi pi, mba o’dirusi ’diyi pie, omu azile ’diyisi ’diyi pie, ekile sile Yehova vile azita ma aliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
