                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hezekia pi ’ba ’wara ’diyi be ka di emu afa odale nguru nguru ’diyi ndre dria ’bo, yi inzi ani Yehova, fe asi ndriza ’ba erini Israe­liru ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nga di ’ba atalauru ’diyi pi ozi ’ba Levini be, afa ’bani odale nguru nguru ’diyi ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.19"
              },
              "items": [
                {
                  "text": "Hag 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azaria atalau ambori ovupi ori’ba Zadokiniri, nga e’yo omvi eri tia kini, Engazu ’bani e’dozu afa feza ejizu jo Yehovani ma aliarisi, ama nya ra, ama tra ra, joloni ace ekpete ekpete; a’disiku Yehovani asi ndriza fele ’ba erini dririsi, te afa ta mbale amboru ’diyi joloko kuleri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nga di e’yo azi jo aliza edezu jo Yehovaniri ma alia; yi ede di yi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.13"
              },
              "items": [
                {
                  "text": "Neh 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi eji di afa fele Mungu dri ’diyi pi, o’ba yi alenia asi adasi, afa yini ma esele mudri ma azi aluri pie, afa feza fele alaru ’diyi pie dria. Konania ’ba Leviniri ovu afa feza nde ’diyi ma drilia, vunisiri adri Simei’i; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehieli pi, Azazia pie, Nahati pie, Asaheli pie, Yerimoti pie, Yozabadi pie, Elieli pie, Isimakia pie, Mahati pie, Benaya pie dria, yi ovu ndra ’ba ma drilia Konania pi ma palaa adri Simei be, ekile opi Hezekia pini yi opele Azaria jo Munguniri ma driliari berile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kore Imina mvi ’ba Levini, kalitile etuni efurialeruri ma agei tepiri, ovu ndra afa feza ceni fele Mungu dri ’diyi ma drilia, afa feza Yehovani ’diyi pi awazu afa alatararu tu ’diyi be. ",
          "type": "text",
          "attrs": {
