                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo nga di eca ’dini, opi erini ka okpo isu ’bo, eri nga ati’ba erini ndra ati opiruri fupi ’diyi ofu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
