              },
              "items": [
                {
                  "text": "2 Sur 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.1"
              },
              "items": [
                {
                  "text": "22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yoasi opi Israeli­niri bi di Yoasi Yehoahazi mvi ma mvi Amazia opi Yudaari Beti­semesia ra, nga eri eji Yerusalemua asu abi kaliru Yerusalemuari va engazu kalitile Efiraimuniria cazu kalitile kalaaria, wuale turu su ’dipi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri wu mele pi, dahabu pie, afazu dria jo Munguni ma alia Obedi-edomu be ’diyi pie, lonyi opi vile joari pie, ’ba obile aruru ’diyi pie, mvi Yi be Samariaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
