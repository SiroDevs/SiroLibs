              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini ’di ma vutia omba e’dani di ku, trua eli Asani opi nyazu kali na drini towiri ma alia dria.",
          "type": "text",
          "attrs": {
