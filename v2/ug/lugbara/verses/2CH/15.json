                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te pari uruleru ’diyi eri nzeni angu Israelini ma alia ku. Te ti, Asa ma asi ovu dria onyiru ewu erinisi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
