        },
        {
          "text": "Isu de ewu izurusi Israeli ovuni Mungu adaruri be ku, kani kuhani ’ba imbazu be ku, kani azita be ku indi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
