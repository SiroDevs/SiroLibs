                  "text": "Azi 4:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ocoko yiniri ma alia yi ka yi oja Yehova Mungu Israeliniri vu, ka eri ndru ra, yi isu eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
