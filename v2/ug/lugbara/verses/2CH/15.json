          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ofi jo Yehovania afa i ma atini opele ndu ’diyi pi, afa i ma ngulupini opele ndu ’diyi be, afa dahaburu pi, afa meleru pie, imvu pie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        },
        {
