                "loc": "1KI.15.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Asa nze i ma andri Maa­ kani pari inzizaru opi andriniriasi, a’disiku erini wura ngule onzi Ase­, raniri edelerisi. Asa ga wura erini va, ’i eri irifuraru, ve eri yi raza Kidroni ma tia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
