        {
          "text": "Ewu nde ’darisi asi anzuru ndra aluni yo ’ba fupi amveri pi dri ’ba fipi aleniari be, te inzata amboru ovu ’ba ovupi angu nde ’diyia ’diyi ma dria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
