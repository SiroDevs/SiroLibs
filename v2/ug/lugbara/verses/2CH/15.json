        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.16"
              },
              "items": [
                {
                  "text": "2 Sur 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri oku ’ba Yudani ’diyi pi dria ’ba Benyaminini pie, ani’ba ovupi yi be engapi Efiraimu pia Manase pie, Simeoni be ’diyi pie dria, a’disiku ’ba yi ojapi ’ba eriniru engapi Israeli eselia ’diyi yi o’biru tu, yini ndrele kini Yehova Mungu eriniri ovu eri berisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini yi oku yi tualu Yerusa­lemua eli mudri drini towi ma mba na Asani opi nyazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
