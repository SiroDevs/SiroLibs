                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini kini ma fu ’ba Yehova Mungu Israe­liniri ndrupi kuri ra, ka tro ’ba wereniri ka ’ba amboru ti, ka agupini, ti, ka okuni ti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi so oyo ’diri Yehova vu o’duko amboru pisi cere o’beza pie, guka vuza pie, ejeleko i pie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba Yudani dria ovu ayikosi tu oyo soza ’di ma e’yosi; yini oyo sole yi ma asi driasi rarisi, yini eri ndrule ava yini driasirisi; te yi isu eri ra, Yehova fe di ani yi dri ava liza yi ma kalaasi kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
