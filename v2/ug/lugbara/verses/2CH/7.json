          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.66"
              },
              "items": [
                {
                  "text": "1 Opi 8:66",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mba aziri ma o’du kali iri drini nasi eri fe ’ba nde dri geri mvizu hema yiniria, de yi ayikosi azini nyonasi asi yini ma alia, onyi Yeho­vani ecele Daudi pi dri, Sulemani pie, ’ba erini Israelini ’diyi pie ’borisi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
