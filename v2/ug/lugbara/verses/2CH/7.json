                  "text": "2 Sur 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba kuhaniru ’diyi econi ani fizaru jo Yehovaniria ku, diza Yehovanirini gale jo Yehovani ma alia trerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
