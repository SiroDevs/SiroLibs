              },
              "items": [
                {
                  "text": "1 Opi 8:62",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini opi pi tualu ’ba be dria yi ofe edeta Yehova ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi Sulemani fe ti alifu kali iri drini iri, azini kabilo alifu turu alu drini kali iri, edetaru. ’Dini opi pi tualu ’ba dria be fe jo nderi Mungu dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
