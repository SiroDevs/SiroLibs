                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.5.12"
              },
              "items": [
                {
                  "text": "2 Sur 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba kuhaniru ’diyi oso pa, azi yini ’yele ’diyi vusi; anzi Levini ’diyi oso pa indi, o’di ’bani ongo ngozu Yehova dri ’diyi be yi ma dria, ndra opi Daudini edele awa’difo fezu Yehova dri-yiki erinirini ovule ’dani ’danirisi-’diyi, Daudini ndra Mungu inziria afa nde ’diyisi; ’ba edeta edepi ’diyi vu guka yi ma drilia; ’ba Israelini dria oso pa ani uru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
