                }
              ]
            }
          ]
        },
        {
          "text": "’Ye e’yo ovupi onyiru Yehova ma miliari, ekile trotro ati Uziani ’velerile-te fini hekalu Yehovani ma lia ku. Te kiri ’ba nde yi e’yo onzi ’ye ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
