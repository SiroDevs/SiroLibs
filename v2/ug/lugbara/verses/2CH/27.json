              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.14"
              },
              "items": [
                {
                  "text": "2 Sur 33:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.26"
              },
              "items": [
                {
                  "text": "Neh 3:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eci si;o Yehovaniri ma kalitile uruleruri, azini abi Ofeliniri ma dria eri si fudri ci indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eci si vini aku azini angu oni be Yudaaria, azini angu oce talaasi ’diyia eri o’ba jo amboru ’diyi pi jo izu izu ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
