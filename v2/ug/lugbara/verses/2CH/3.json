            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3"
              },
              "items": [
                {
                  "text": "Ebra 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede bongo jo ale alizuri bongo blururi pisi, okalakokalaruri pie, ekaruri pie, bongo mile be nyiriari pie, ede kerubi ma wura bongo nde ma ruaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
