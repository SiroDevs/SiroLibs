              },
              "items": [
                {
                  "text": "Yer 52:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede azini afa pa sopi piriru jo ma drilia ’diyi iri, oco yini edrezari wuale kali na drini towi, drini erini o’bale drinia uru ’diyi yi alu alu wuale towi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ede anziriku pari e’yo ecezaniri ma alia, o’ba di yi afa pa sopi piriru ’diyi ma dria; ede azini patiefi pomegranateni ma wura turu alu, o’i di yi anziriku ma ruaa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edre afa piriru ’diyi hekalu ma drilia, aluri kala dri ndialeruria, aziniri kala dri ejialeruria; da kala dri ndialeruri ma ru Yakini’i, kala dri ejiari ma ru Boazi’i.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
