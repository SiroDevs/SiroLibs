            }
          ]
        },
        {
          "text": "Te emi ma ovu emi atapi piyile, emi adripi be ’dini ku, yi ’ye onzi Yehova Mungu yi ma a’bipiniri vu, ’dini eri ce yi ma angu fu andruru ani, ekile emini ndrelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
