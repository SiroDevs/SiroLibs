              "items": [
                {
                  "text": "2 Sur 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka tro ngoni ti, ’ba Aseri pia, Manase pie, Zebuluni be ’diyi ma azi do yi e’yere, emu Yerusalemua ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
