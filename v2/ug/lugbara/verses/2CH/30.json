        },
        {
          "text": "Azini dika, dri Munguni ovu indi Yudaa, asi alu fezu yi dri azita opi pini ’ba ’wara be e’yo Yehovanisiri ’yezu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
