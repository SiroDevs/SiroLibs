            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini ’ba o’biru nga yi oku Yerusalemua omu mikate akufi koko­runiri ’bazu mba iririsi, ada ’ba ongulumuru amboru tu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
