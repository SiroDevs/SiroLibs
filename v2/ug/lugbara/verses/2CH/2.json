        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.14.1"
              },
              "items": [
                {
                  "text": "1 Sur 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sulemani nga di ojio ti pe Huramu opi Turoari vu, ’yozu tinia kini, Ekile andra mini ’yele ma ati Daudi dri, mini ndra mario pati ma ti pezu jo ndra erini ovuzu aleniari sizurile, mi ’ye ma be ’dini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        },
