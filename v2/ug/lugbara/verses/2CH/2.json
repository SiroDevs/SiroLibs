        },
        {
          "text": "Jo mani ngale sileri eri amboru, a’disiku Mungu amani eri amboru Mungu dria ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.5",
            "verseOrgIds": [
              "2CH.2.5"
            ]
          }
        },
