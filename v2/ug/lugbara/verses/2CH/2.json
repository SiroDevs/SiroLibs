                "loc": "1KI.5.15"
              },
              "items": [
                {
                  "text": "1 Opi 5:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Su­lemani nga ani ’ba ola alifu kali aziri teri ojizu, ’ba azini alifu kali aro oni onzezu oni ruaa, ope ’ba azini alifu na drini turu azia ovuzu yi ma drilia azi ndrezu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 2:3"
          },
          "items": [
