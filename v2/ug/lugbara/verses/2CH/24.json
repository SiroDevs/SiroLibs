              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.8"
              },
              "items": [
                {
                  "text": "34:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga atalau oku ’ba Levini be, nga ’yo yi tia kini, Emi ma fu mu aku ambo ambo Yudani ’diyi ma alia, emi ma oku silingi ’ba Israelini vusi dria, ngazu jo Mungu eminirini edezu eli vusi eli vusi; emi ma ’ba emi asi e’yo nde ’yezu mbele. Te ’ba Levini ’yeni e’yo nde mbele ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
