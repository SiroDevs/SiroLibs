        },
        {
          "text": "Te yi eci yi ti e’yo otuzu eri ma ruaa, nga eri o’be onisi ra, azita opini azilerisi, jo Yehovani ma irii ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
