          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini opi Yoasi egani di asi ndriza ati Yehoyadani ndra ’yele eri driri aluni ku, te fu eri ma mvini ra. Erini draria ’yo ’dini, Yehova ma lu e’yo ’diri ma dria, ma a’i ariotini fa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
