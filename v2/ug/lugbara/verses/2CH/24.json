                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi nga di Yehoyada yi ma driliari omve, nga ’yo tinia kini, Mi etuni ’ba Levini musoro Musa ati’bo Yehovanirini azile ’ba ongu­lumuru Israelini ’diyi be hema e’yo eti nzezanisiri ejizu engazu Yuda pia Yerusalemu be ku a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
