              "items": [
                {
                  "text": "Zab 118:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dario opi nga di i ma dri ri e’yo siza ’di ma alia, e’yo aziza ’diri be. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.9"
            ]
