        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi la, mi eri ama; Opi la, mi wu e’yo onzi amani; Opi la, mi eri, mi ’ye; mi ci dri ku fo,mi ma e’yosi a’dule, Mungu mani la, a’disiku aku miniri azini ’ba mini ’diyi yi mi ru e’da’i fo!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
