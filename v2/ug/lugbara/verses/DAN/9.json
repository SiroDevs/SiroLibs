            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’ba ma mile Opi Mungu vu, e’yo zizu eri tia azini matu ’bazasi. Ma ’da nyaka ra, koliba suzu ma ruaa ofuta be. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ri Yehova Mungu maniri zi, ma e’da ezata ra, ma kini, Opi Mungui amboru ’bani rule turi la, mi adripi e’yo aziza ma ta mbapi ra, ovupi yiki aleru be ’ba mi lepi azini ’ba azita mini ta mbapi ’diyi vuri, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
