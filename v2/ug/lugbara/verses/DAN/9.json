                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Efu 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
