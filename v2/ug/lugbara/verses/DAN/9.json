                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.13"
              },
              "items": [
                {
                  "text": "Yoe 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Mungu amaniri eri yiki amboru be, eri e’yo onzi wu tu; amani mbule eri ma ruaa amverisi ti, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini ama inzini vini Yehova Mungu amaniri ma o’duko ku, acizu azita erini, erini ’bale ama milia ati’ba erini nabiru ’diyi ma tiarisi ’diyi ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
