                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ama erini vini ati’ba mini nabiru ’diyi ma e’yo ku, yi’i adripi ndra e’yo olupi mi rusi opi ama vile, ’diyi pi ma tia opianzi amani ’diyi: pie, ama a’bipi pie, ’ba dria ovupi: angu ’doria ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi la, mi mini alatararu, te ama amani mile be drinzaru ’diyi, ekile andru­rile; ama’i ’ba ovupi Yudaa ’diyi pi ’ba ripi Yerusalemua ’diyi pie, ’ba Israelini dria ovupi ogogo ’diyi, kani ripi ziri, pari dri dria mini yi drozu aleniaria ’diyi be, yini e’yo onzi ’yele mi vurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi la, drinzani ama mile fuzuri e’yoni amani, opi amani pi, opianzi pie, ama a’bipi pie, a’disiku ama eza mi vu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
