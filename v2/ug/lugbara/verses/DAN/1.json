                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Danieli imba i ma asi eri kazu i ezazu nyaka alupi tu opinirisi ku, kani patiefi ma su erini mvulerisi ku indi; nga ani ambo ’ba nzele ranyaru ’diyi vileri zi, kini, i ma eza ani i nyaka opinirisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.21"
              },
              "items": [
                {
                  "text": "E’do 39:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.50"
              },
              "items": [
                {
                  "text": "1 Opi 8:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu nga di fe Danieli ma isu asi ndriza azini asi anzuru ambo ’ba nzele ranyaru ’diyi vileri ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambo ’ba nzele ranyaru ’diyi ma driliari ’yo Danieli ma tia, Ma ru opi mani inzileri, eri’i afa emini nyaleri azini mvuleri azipi ’bori ra; eri nga emi mile ndre ovuzu oyizaru aga karile ovupi eriniri zoaziru ’diyi ma mile ra a’di e’yosi ya? ’Dinilerisi emi nga fe opini ma ombe li ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli ’yo agu ambo ’ba nzele ranyaru ’diyi ma driliarini ’bale Danieli pi Hanania pi Misaeli pi Azaria pie ma agei tepiri ma tia, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi o’bi nga ati’ba mini ’diyi o’du mudri, ama zi mi tia; kirikiri mi fe nga ama dri tibi ini nya, yi mvuza be fo! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilerisi mi fe ’ba ma o’bi ama mile mi drilia, karile adripi nyaka alupi tu opi vileri nyapi ’diyi be; ka’dini mi ma ’ye ati’ba mi vile ’diyi vu mini ndrelerile ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini eri eri e’yo yini ’yole ’diri ra, eri nga di yi o’bi o’du mudrisi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du mudri ka yi de ’bo mile yini ndri tu, yi rua a’bu tu aga karile nyaka alupi tu opi vileri nyapi ’diyi dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi agu ambo nderi ’du nyaka alupi tu yini ra, patiefi ma su yini azile yi driri be, eri nga yi dri tibi ini fe’i. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
