          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.18"
              },
              "items": [
                {
                  "text": "Lev 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
