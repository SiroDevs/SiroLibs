                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.22"
              },
              "items": [
                {
                  "text": "’Yeta 7:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Karile ’diyi sutro, Mungu fe yi dri nita pi e’yo vaza be e’yo dria ’bani yi imbale ’diyi onizu onduasi; te Danieli va ini afa ndreza piyi ma efi orobi dria be. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini o’du ndra opini azile yi ofizurini i deria, ’ba ambo ’ba nzele ranyaru ’diyi driliari nga yi ofi opi Nebukadineza ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi nde olu e’yo yi be, te ’ba ’diyi dria ma eselia yi ndru ’ba azini Danieli pile, Hanania pi, Misaeli pi, Azaria pie ti; e’yo ’disi ’ba ’diyi oso pa opi ma milia ani. ",
          "type": "text",
