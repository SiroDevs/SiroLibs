                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi karile nyibile kokoru, te ’ba mile alaru be, ’ba e’yo vapi ondua dria be ’diyi, ’ba nita ma e’yo vapi tu, ’ba e’yo imbaleri nipi ra, ecopi pa sopi opi vile joa onyiru ’diyi; eri ma imba yi ’ba Kalideyaa ’diyi ma onduasi, ti yinirisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi azi yi ma fe yi dri etuzu nyaka alupi tu opi vileri ma esele azini, patiefi ma su erini mvuleri be, ma ezo yi eli na; eli na ka yi de ra yi ma nga pa so opi ma milia beni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’diyi ma eselia ’ba engapi anzi Yudaa ’diyi, yi Danieli pi, Hanania pi, Misaeli pi, Azaria pie. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.45"
              },
              "items": [
                {
                  "text": "E’do 41:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.12"
              },
              "items": [
                {
                  "text": "Dan 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambo ’ba nzele ranyaru ’diyi vileri o’da yi ma ru ’dini: Danieli ma ru Belitesaza’i Hanania ma ru Sadaraka’i, Misaeli ma ru Mesaka’i, Azaria ma ru Abedinego’i. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
