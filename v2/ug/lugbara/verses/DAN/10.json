        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.17",
            "verseOrgIds": [
              "DAN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia ’ba i sipi wura be ’baleri nga ma rua elo dika, nga okpo fe ma dri. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.18",
            "verseOrgIds": [
              "DAN.10.18"
            ]
          }
        },
        {
