                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.31"
              },
              "items": [
                {
                  "text": "Rum 8:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Yo ma tia kini, Mi agu lele turi, mi ru ku, asi anzuru ma ovu mi vu; mi ma ovu okpo be, awa’dini, mi ma ovu okpo be. Eri ka ’yo ma be ’dini ’bo, fe ma dri okpo ra, ma ’yo eri tia, Opi mani inzileri ma ’yo e’yo, a’disiku mi fe ma dri okpo ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.19",
            "verseOrgIds": [
              "DAN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.36"
              },
              "items": [
