                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Yoh 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ’ba draza o’du kopi irifura nyakuari ma alia ’diyi ma azi kakau nga enga ra, azini nga fi iri ri i ci epi kuria, azini ’diyi nga fi drinza pi ma alia edematara ’dani ’daniri be. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.41"
              },
              "items": [
                {
                  "text": "1 Kor 15:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ondua be ’diyi nga di ekile diza dipi ’buarisirile; te ’ba ’ba kakau ojapi onyi vu ’diyi nga di ekile ’bi’biole ewu vusi ewu vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Eceza 22:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi’i Danieli, mi opi e’yo ’diyi ma ti ci, mi ma ’ba eceta buku ruaa tini opizu, cazu kpere ewuni asizuria. ’Ba kakau yi nga nzu ’dile azini ’dole, nitani nga zo indi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’diri ma vutia, ma’i Danieli, ma asi angu lu, te mi ndre, ’ba azini iri oso pa oso oso, aluri yi ara ma ti ’doleruria, aziniri yi ara ma ti ’aa’daleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.9"
              },
              "items": [
                {
                  "text": "Zab 74:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.12"
              },
              "items": [
                {
                  "text": "1 Pet 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.10"
              },
              "items": [
                {
                  "text": "Eceza 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ’ba alu zi agu bongo emve supiri ma tia, eri yi ara ma dria uru, kini, E’yo osutaru ’diyi ma asizani nga eca a’dungari ya? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "Dan 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luk 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.10.5"
              },
              "items": [
                {
                  "text": "Eceza 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "12:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agupi bongo emve supi ripi yi ara dria ururi eju i ma dri ndiri ’bua dri eji ini be, ma eri erini oyo soria eri’i ovupi idriru ewu vusi ewu vusiri ma rusi, kini, eri nga ewu alu nya pi, ewu iri ’diyi pie, ewu ma ali be; azini yi ka nga okpo ’ba alatararu ’diyiniri onyo de dria ’bo, afa ’diyi dria ma nga yi de ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erizaruni, ma eri ra, te ma vani efini ku. Ma nga di ’yo kini, Opi mani la, e’yo ’diyi ma asizani nga ovu ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo ma tia kini, Mi mu leti minia, Danieli la, a’disiku yi opi e’yo nderi ma ti ci, azini o’ba eceta ruania ’bo cazu kpere angu tini asiria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.9",
            "verseOrgIds": [
              "DAN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.9"
              },
              "items": [
                {
                  "text": "Zek 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.17"
              },
              "items": [
                {
                  "text": "Yoh 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.11"
              },
              "items": [
                {
                  "text": "Eceza 22:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba kakau nga yi ede alaru, yi nga yi ’ba emveru, nga yi ma ayaze nze dria; te ’ba onziru ’diyi yi nga onzi ’ye ’dani; ’dini ’ba onzi ’diyi ma eselia ’ba ngapi e’yo vaza vapi ’diyi yo; kiri ’ba ondua be ’diyi nga vani, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.10",
            "verseOrgIds": [
              "DAN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.31"
              },
              "items": [
                {
                  "text": "11:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.15"
              },
              "items": [
                {
                  "text": "Mat 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.14"
              },
              "items": [
                {
                  "text": "Mar 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Engazu yini ngazu afa veza vele etuzuri fezu asizu, azini yini afa onzikanyaru dri jazaniri edrezu ururia, o’duni nga ovu alifu alu turu iri drini kali oromi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba tepi kpere ecapi o’du alifu alu drini turu na drini kali na drini towiriari, eri drilebaru. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.2"
              },
              "items": [
                {
                  "text": "Isa 57:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.5"
              },
              "items": [
                {
                  "text": "Zab 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi’i, mi mu eti minia cazu kpere o’du asizurini ngaria ecaria; a’disiku mi nga ava li, mi nga pa so pari pele mi driri ma alia o’du ka nga yi asi ’boria.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
      ]
