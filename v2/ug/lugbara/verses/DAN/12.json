                }
              ]
            }
          ]
        },
        {
          "text": "Te ewu ’darisi Mikaelini nga pa so, eri opimva amboru pa sopi suru mini ma anzipi ma e’yosiri. Azini ewu ocokoni nga eca ra, ovupi andra o’du suru ’bazurisi ecazu ewu ’dasi oku drio ’dini kuri; te ewu ’dasi ’ba mini yi nga yi pa ra, ’ba dria alu alu yi ma ru sile buku ma alia ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Isa 26:19",
