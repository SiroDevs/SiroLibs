              },
              "items": [
                {
                  "text": "Dan 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli oko Belisaza opi Babuloni­arini e’dozu angu nyazurisi, orobi obi Danielini erini laria gbolo erini ma dria, afa ndreza e’da yi eri ma dria indi; nga di orobi ma e’yo si bukua, nga e’yo nderi ma kalafe e’da dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.1",
            "verseOrgIds": [
              "DAN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli nga ’yo kini, Ma ndre afa ndreza i e’dapi inisiri ma alia ’dini, azini mi ndre, oli engapi ’bu ma kalaa ’diyi su adi miri amboruri ma ale adi adi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.2",
            "verseOrgIds": [
              "DAN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.1+ZEC.6.2+ZEC.6.3+ZEC.6.4"
              },
              "items": [
                {
                  "text": "Zek 6:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Eceza 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini nguru ’wara ’wara su efu miri ma aliasi tu uru, yi ma wura sini yi agyi be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.3",
            "verseOrgIds": [
              "DAN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Azi 28:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.7"
              },
              "items": [
                {
                  "text": "Yer 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.13"
