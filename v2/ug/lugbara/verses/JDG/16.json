              "items": [
                {
                  "text": "Yos 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu de agupi oku pie ga jo ndea tre; opi ’ba Filisitiaa ’diyini dria ’dale indi, te jo nde ma dri senderuri ma dria isu de ’ba ekile alifu nale, agupi oku pie, ecapi Samisonini ndrezu erini oguta feria yi dri ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
