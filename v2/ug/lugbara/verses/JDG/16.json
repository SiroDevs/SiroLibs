              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Filisitiaa ’diyi bi eri ra, onze eri ma mile ra, yi eji eri andraleru Gazaa, ombe eri anziriku molarusi; eri di nga anya ’i arujoa ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
              "JDG.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te dribi eri ma driari ’bani ndra ofale rari e’do du dika ra.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        }
