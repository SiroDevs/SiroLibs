                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.18"
              },
              "items": [
                {
                  "text": "’Yeta 18:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini eri olu e’yo i asiari eri ma tia dria, ’yo eri ma tia, Yi ofani nga dribi ma driari idrisi ku; mani ibile ovule ’ba Naziriru Mungu vu engazu ma andri ma opojoarisi. Yi ka ma dribi ofa ra, ma okponi nga fu ma ruaarisi ra, ma nga di eca okpo kokoru, ovuzu ekile ’ba azini ’diyile ani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
