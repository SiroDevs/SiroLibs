        },
        {
          "text": "Te nabi Debora Lapidoti vile okururi eri li ’ba Israelini ma e’yo ewu’dasini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.4",
            "verseOrgIds": [
              "JDG.4.4"
            ]
          }
