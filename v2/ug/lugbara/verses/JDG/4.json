              "items": [
                {
                  "text": "E’do 35:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ovu ndra itu pati Deborani Rama pi ma eselia Beteli be, angu oni ruaa Efiraimuniriari ma etia; azini anzi Israelini yi adri etu eri vu e’yo lizasi ’daa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.5",
            "verseOrgIds": [
              "JDG.4.5"
            ]
          }
        },
        {
