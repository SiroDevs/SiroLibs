              "items": [
                {
                  "text": "1 Opi 20:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baraki nga Zebuluni pi omve Nafutali be tualu Kadesia ra; ’ba tupi eri vutisi ’diyi yi ’ba alifu mudri; Debora tu uru eri be indi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.10",
