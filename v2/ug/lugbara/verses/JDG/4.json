          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraki nga di ’yo eri ma tia, Mi ka nga mu ma be ra, ma nga mu ra; te mi ka nga mu ma be ku, ma ngani mu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.8",
            "verseOrgIds": [
              "JDG.4.8"
