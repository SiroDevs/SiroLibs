        {
          "text": "Te ma nga Sisera ’ba asikari ongulumuru Yabinini ma dri cepiri osi mi vu ogogo yi raza Kisoni ma tia, eri’i gari ombani erini pie, ’ba ongulumuru erini pie; ma nga eri fe mi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.7",
            "verseOrgIds": [
              "JDG.4.7"
            ]
          }
        },
