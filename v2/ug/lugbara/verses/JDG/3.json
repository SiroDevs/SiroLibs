          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ovu ’daa bani Israelini amaze, nizu kani yi nga azita Yehovani, erini ndra azile a’bipi yini dri Musa ma driasi ’diyi eri ra yani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
