              "type": "text"
            }
          ]
        },
        {
          "text": "pe lu a’bianzi anzi Israeliniri ma ni, ma imba yi a’di ’diza ma e’yosi, ma imba ’ba e’yo ’diri nipi oku ku ’diyi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
