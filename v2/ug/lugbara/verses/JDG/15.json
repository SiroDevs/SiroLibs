          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Filisitiaa ’diyi nga di mu hema yini aso Yudaa, ere yi ndu ndu Lema. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Yudani nga di ’yo, Emi etu a’di ’dizu ama be a’disi ya? Te yi ’yo, Ama etu emu Sami­sonini ombezu, azini eri ’yezu ekile emi ama ’yele ’borile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        },
