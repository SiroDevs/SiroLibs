                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini eri isu akanya ma siso o’elini, eri eju i ma dri e’du eri ra,ofu ’ba alifu alu ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.15",
            "verseOrgIds": [
              "JDG.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Samisoni ’yo ra, Akanya ma sisosi amu amu azini ma dria, akanya ma sisosi ma ofu ’ba alifu alu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, eri ka e’yo ’yo de ’bo, eri ’be siso i ma driarisi ra; yi nga angu ’dari ma ru ’da Ramati­lehi’i ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 15:18"
          },
          "items": [
            {
