              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini ovuria Yebusia ogogo etu ace were ’ye ’de ’de; ati’bo nga di ’yo ambo iniri ma tia, Mi emu, ma zi mi tia, ama ma oja ama kalaa aku amboru ’ba Yebusini ’diria, ama ma la alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
