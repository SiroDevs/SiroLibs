                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ’yo tinia, Ama zo engazu Betelehemu­yudaasi muzu angu oni ruaa Efirai­muniri ma kala ’aa’dasiria; ma enga ndra ’dale. Ma mu Betelehemu­yudaa; te ma curu’do mu jo Yehova­nia; te ’ba aluni yo ma ofipi i vile joari. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
