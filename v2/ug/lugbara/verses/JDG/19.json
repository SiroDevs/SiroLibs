              "items": [
                {
                  "text": "Lip 20:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ka fi i vile joa ’bo, eri e’du eli, bi i vile oku ati’boru ’diri ma avu ra, oli eri ma ale, pa pi dri pie, esele be mudri drini iri, pe tini kala angu Israelini ma aliasi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
