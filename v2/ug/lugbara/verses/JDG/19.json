                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.8"
              },
              "items": [
                {
                  "text": "Hos 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ambo eriniri ’yo eri ma tia, Ama ngani ama oja kalaa fizu aku amboru juruni ’diria ku, aku ovupi anzi Israelinini kuri; te ama nga aga mu Gibeaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ’yo ati’bo ini ma tia, Mi emu, ama osi ama ogogo aku ’diyi ma azi alu vu, ama nga la kani Gibeaa, kani Ramaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dinile yi aga aga, mu geri yinia; etu nga ’de yi ma dria yini ovuria va Gibeaa ovupi Benyamininiri vu ogogo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.43"
              },
              "items": [
                {
                  "text": "Mat 25:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Ebra 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di yi oja kalaa ’daa, muzu lazu Gibeaa. Te eri fi ra, ri va aku nderi ma gboko tia; ’ba alunini ovule ’daa yi ofizu lazu i vile joa kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.23"
              },
              "items": [
                {
                  "text": "Zab 104:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi lu, mbazau alu ibi emu engazu i vile amvu azia ondresi; agu nderi enga ndra angu oni ruaa Efiraimuniri ma alia, te eri la Gibeaa; te ’ba angu nde ma e’ipi ’dayi ’ba Benyaminini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.16",
            "verseOrgIds": [
              "JDG.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri enga i ma mile uru, eri ndre ’ba engapi aciari aku nde ma gboko tia; mbazau kini, Mi mu ngoa ya? te mi ibi enga ngoa ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.17",
            "verseOrgIds": [
              "JDG.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 19:18"
