          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini eri ma ati si oku nde vu andraleru; ’dale Samisoni ’ba omu, ekile karileni adrile ’yelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.10",
            "verseOrgIds": [
              "JDG.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, yi ka eri ndre ’bo, yi eji ’ba azini kali na ovuzu eri be. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.11",
            "verseOrgIds": [
              "JDG.14.11"
            ]
          }
        },
        {
