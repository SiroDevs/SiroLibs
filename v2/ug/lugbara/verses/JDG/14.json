              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.6"
              },
              "items": [
                {
                  "text": "1 Sam 11:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te Orindi Yehovani eca eri ma dria okpo be, eri osi eri ekile erini te ecole ndrimva osilerile; eri ma dria afa azini yo. Te eri oluni i ati pi ma tia i andri be afa ini ’yeleri aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri si andraleru mu o’yozu zamva nde be; eri fe ayiko Samisoni dri tu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.7",
            "verseOrgIds": [
              "JDG.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te o’du azini ma vutia eri emvi oku nde ’duzu; eri oja i kalaa kami ma avu ndrezu, te mi lu, anyu­efi ongulumuru fi ovu kami avu ma ruaa, anyuoso be. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.8",
            "verseOrgIds": [
              "JDG.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eri ’du i ma dria, eri ji mu mbe si erini muria; eca i ati pi vu i andri be, fe yi dri, yi mbe indio Te eri oluni yi ma tia kini i bi te anyuoso ’di, enze kami avu ma ruaari ku.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        }
      ]
    },
    {
