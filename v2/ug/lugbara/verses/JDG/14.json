        },
        {
          "text": "Samisoni nga di si Timinaa, eri ndre zamva alu Timinaa ’dale, ezoanzi ’ba Filisitiaa ’diyini ma azi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
