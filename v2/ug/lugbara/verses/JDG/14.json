            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.4"
              },
              "items": [
                {
                  "text": "34:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri etu emu olu i ati pi ma tia i andri be, kini, Ma ndre zamva Timinaa, ezoanzi ’ba Filisitiaa ’diyini ma azi; e’yo ’disi emi eji eri ma dri okuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
        {
