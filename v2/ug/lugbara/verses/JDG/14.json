            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.20"
              },
              "items": [
                {
                  "text": "Yos 11:20",
                  "type": "text"
                }
              ]
            },
