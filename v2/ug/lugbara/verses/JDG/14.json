              "items": [
                {
                  "text": "2 Opi 5:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Samisoni ’yo yi ma tia, Emi fe ma ma zi e’yo o’beza emi tia; emi eco kani efini ece ma dri de nga o’du aziri omuni deni yi ku, eri isuzu ra yani, ma di nga emi dri bongo mile be nyiri ’diyi fe kali na,bongo ojaza kali na ’diyi be; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "te emi ka eco efini ecezu ma dri ku, emi nga ma dri bongo mile be nyiri ’diyi fe kali na, bongo ojaza kali na ’diyi be. ’Dini yi ’yo eri ma tia, Mi zi di e’yo o’beza miniri, ama ma eri nga eri ani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
