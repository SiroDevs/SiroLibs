              "items": [
                {
                  "text": "Lip 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Efiraimuni oku yi tualu, yi zo muzu angu andraleruria; yi ’yo Yefita ma tia, Mi zo ndra mu a’di ’dizu anzi Amonini be ra, mi omveni ndra ama muzu mi be ku a’disi ya? Ama mi vile jo eve mi dria ’dia acisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.1",
            "verseOrgIds": [
              "JDG.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita ’yo yi ma tia, Ma’i ’ba ma vile ’diyi be, ama ’di a’di ambo anzi Amonini be; te mani emi omveria emi pani ndra ma yi ma dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.2",
            "verseOrgIds": [
              "JDG.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
