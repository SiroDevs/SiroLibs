              "items": [
                {
                  "text": "Yos 19:49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa eri angu erini ’dule awurusoruri ma kalatia Timinati­heresia, angu oni ruaa Efiraimua, oni Gaasi ma kala andraleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
