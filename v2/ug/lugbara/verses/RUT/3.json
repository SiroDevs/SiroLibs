                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adaru ma ovu ori’ba mini ovupi mi be ogogori ra ’bo, te di, ’ba azini ovupi ogogo to ma agapi rari indio ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.12",
