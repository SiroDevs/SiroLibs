              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di si akuma dria ani, nga e’yo dria i ma edrini azileri ’ye ra. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.6",
            "verseOrgIds": [
              "RUT.3.6"
            ]
          }
