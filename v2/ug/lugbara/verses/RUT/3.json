        },
        {
          "text": "Naomi edri erini nga ’yo eri tia, Ma zia, ma ma nda pari mini ava lizuri, e’yo mini ma ovu ani onyiru beni ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.1",
            "verseOrgIds": [
              "RUT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
