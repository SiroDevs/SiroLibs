                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu adriza a’bini andra driorisi ’ ’ba Israelini ma eselia ovu ’dini, ’bani angu jeria dika, kani afa aleria: yi ka le e’yo ma ti efi okporu, kini ’ba adri enyiriko paari tru fe i ma agyi dri; e’yo a’izu adaru asi driasiri ’ba ece ndra ani ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dinile ori’ba nde nga ’yo Boazi ma tia, Mi je mi’i ka. Eri nga di enyiriko paari tru ra. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
              "RUT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boazi nga di ’yo ’ba ’wara ’diyi ma tia ’ba dria be, kini, Emi ovu andru ’ba e’yo eti ndrepi ’diyiru, kini, ma je ma’i Naomi dri afa ovupi ndra Elimeleki vile ’diyi dria ’bo, azini afa dria ndra ovupi Kiliona pi vile Malona be ’diyi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.9",
            "verseOrgIds": [
              "RUT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 4:10"
