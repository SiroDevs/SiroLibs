        },
        {
          "text": "Eri nga ’ba ’wara aku ndea ’diyi omve mudri, nga ’yo yi tia, Emi ri va ’dia. Yi nga ri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
