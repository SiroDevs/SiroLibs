          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di ’yo ori’ba tekari ma tia kini, Naomi emvipi angu Moabuasiri fe angu esele ndra ovupi adripi amani Elimeleki vileri je. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
