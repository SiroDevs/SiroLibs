          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi nga mva ’du ’ba i ma agatia, nga ofu eri ma endriaru. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
