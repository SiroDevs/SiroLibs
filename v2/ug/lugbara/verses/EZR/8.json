              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama o’bi afa ’diyi dria kalafe yini vusi, nziza yini vusi indi, te ’ba si nzizani dria etu ’dasi ci.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
