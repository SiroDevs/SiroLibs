              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma o’biyima dria, ma la onzi dahaburu turu azia drini kali towi, azini afazu dahaburu onzi turu alu, azini onzi meleru turu alu indi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
