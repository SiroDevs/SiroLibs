                  "text": "Neh 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama nga di eca Yerusalemua ra, ama ovu ’daa pale na. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
