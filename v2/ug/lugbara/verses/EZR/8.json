            }
          ]
        },
        {
          "text": "Te ekile Mungu amani ma drini ovule ama dria onyirurile, eji ama dri ’ba alu ovupi e’yo vaza beri, eri anzi Mahili Levi Israeli mvi ma mvini ma eseliari, azini Serebia, anzi erini pie, adripi erini pie dria, mudri drini aro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eji vini Hasabia pi, Yesaya be, anzi Merarini ma eselia, adripi erini pie, anzi yini pie, yi kali iri; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
