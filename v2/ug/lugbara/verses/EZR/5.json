                }
              ]
            }
          ]
        },
        {
          "text": "Te atapi amani yi ka fe Mungu ’buarini ovuzu adrasi ’bo, eri nga yi fe Nebukadineza opi angu Babuloniari ma dria, eri ’ba Kalideyani jo ’diri ma dri japi, azini ’ba obipi jipi ’dale angu Babuloniari’i, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
