              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.1"
              },
              "items": [
                {
                  "text": "Ezr 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eli oko Kuro opi Babuloniarini opi nyazurisi, opi Kuro azi azita jo Munguni ’diri sizuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
