              },
              "items": [
                {
                  "text": "2 Kor 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini ezoanzi yini jele okuru yi ma ngulupi dri, azini anzi yini dri indi­risi; ’dini ori alatararuri osa i ’ba angu ndea ’diyi be. Ada, opianzi ’ba ambo ambo angu dri cepi ’diyi be, su yi dri oko ezata ’diri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.2",
            "verseOrgIds": [
              "EZR.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
