              "items": [
                {
                  "text": "Zab 143:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mani afa ’diri eriria, ma osi bongo mani, bongo mani amveri be, ma si dri’bi ma driari, azini ma ti’bi indi, ma nga di ri va osuta be tu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.3",
            "verseOrgIds": [
              "EZR.9.3"
            ]
          }
        },
