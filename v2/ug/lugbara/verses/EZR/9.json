                "loc": "DAN.9.7"
              },
              "items": [
                {
                  "text": "Dan 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma nga di ’yo:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.6",
            "verseOrgIds": [
              "EZR.9.6"
            ]
          }
        }
