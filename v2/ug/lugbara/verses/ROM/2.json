                "loc": "JAS.2.19"
              },
              "items": [
                {
                  "text": "Yak 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi’i, mi ka mi omve ’ba Yahudini, mi ka vini ega mi nga mi pa mini azita ma vuti bilerisi, ovuzu asi afu be mini Mungu a’ilerisi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.17",
            "verseOrgIds": [
              "ROM.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.10"
              },
              "items": [
                {
                  "text": "Fil 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mi ka e’yo Munguni leleri ni, azini e’yo onyiru agapi dria ’diyi a’i, azitani mi imbalerisi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.18",
            "verseOrgIds": [
              "ROM.2.18"
            ]
          }
        },
        {
