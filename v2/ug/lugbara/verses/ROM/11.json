                "loc": "ROM.12.16"
              },
              "items": [
                {
                  "text": "Rum 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tandi! Onyo yi a’itaakosi, te mi pa so a’itasi. Mi ma ovu egata asi afusiri be ku, te mi ovu urisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.20",
            "verseOrgIds": [
              "ROM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Mungu ka ndra arakala adari ku ku, eri ngani mi ku ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.21",
            "verseOrgIds": [
              "ROM.11.21"
            ]
          }
        },
