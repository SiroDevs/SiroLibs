                {
                  "text": "Ebra 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini emi ndre asi ndriza Mu­nguni pi asi oka erini be: ’ba e’depi va ’diyi vu asi okani, te mi vu asi ndrizani mi ka te ’dani asi ndriza nderi ma alia; te ka ’dini yo eri nga mi li va indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.22",
            "verseOrgIds": [
              "ROM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
