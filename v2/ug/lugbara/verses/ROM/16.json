              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’ba Fibi amvipi amani emi milia, ovupi kanisa Keniki­reari ma aza kopiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini emi ma a’i eri onyiru Opi ma alia, ekile dri fupi ’ba alatararu ’diyi dririle, eri aza kozu e’yo erini ngale lelerisi, ka ovu ngoni ti, a’disiku eri ngulupi ko ’ba kakau ma aza, ko vini ma ngulupi ma aza indi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
