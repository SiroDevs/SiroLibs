                "loc": "ACT.18.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi zi Pirisika pi Akula be ci ci, yi ’ba azi ngapi ma be tualu Kristo Yesu ma alia ’diyi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "adi yi dra dri idri mani ma e’yosi, ma fe awa’difo yi dri, kiri ma’i a’dule ku te ’ba kanisani dria ovupi suru dria ma eselia ’diyi fe awa’difo indi; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "1 Kor 16:19, 15",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi zi ’ba kanisani ovupi jo yini ma alia ’diyi ci ci indi. Emi zi Epaineto agyi mani leleri, eri oriefi Kristoni kapi Asiaa okori. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Mariamu ndra azi ngapi emi dri okposiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.23"
              },
              "items": [
                {
                  "text": "2 Kor 8:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi zi Androniko pi ci ci Yuniasi be, yi ori’ba mani lapi jo arunia tualu ma be ’diyi; yi ’ba endrezani ’ba ti opele ’diyi ma eselia, yi ovu ndra Kristo alia mani oko. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.7",
            "verseOrgIds": [
              "ROM.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Ampiliato ’ba mani lele Opi ma aliari. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Urubano, ’ba azi ngapi ama be Kristo ma aliari, azini Sitakusi ’ba mani leleri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Apelesi ’bani a’ile Kristo aliari. Emi zi ’ba ovupi jo Aristobuluni ma alia ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Herodionini ori’ba mani. Emi zi ’ba ovupi Narikiso vile akua Opi ma alia ’diyi ci ci. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Turufena pi Turufosa be ci ci, yi ’ba azi ngapi Opi ma alia okposi ’diyi. Emi zi Perisisi amviazi mani leleri, eri ’ye azi tu Opi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.21"
              },
              "items": [
                {
                  "text": "Mar 15:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi zi Rufusi Opini peleri pi ci ci, andri erini ovupi mani indiri be. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.13",
            "verseOrgIds": [
              "ROM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Asunikirito, Filegoni, Herime, Patroba, Herima, adripi ovupi yi be ’diyi pie dria ci ci. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi Filologo pi Yulia be, Nerea pi amvi be, azini Olumpa pi, ’ba alatararu ovupi yi be ’diyi pie dria ci ci. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.15",
            "verseOrgIds": [
              "ROM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.20"
              },
              "items": [
                {
                  "text": "1 Kor 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.14"
              },
              "items": [
                {
                  "text": "1 Pet 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi zi emi emi eselia o’deza ava alatararunisi. ’Ba kanisa dria Kristoni yi zi emi ci ci.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
