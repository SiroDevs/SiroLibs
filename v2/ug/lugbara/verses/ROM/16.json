                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ’ba ’dinile ’diyi ngani azi Opi amani Kristo dri ku, te abiri yi ma anyajoarisi, azini yi ici ’ba e’yo onzi kokoru ma asi yini e’yo ayikoru ’yoria e’yere ti aluzasi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
