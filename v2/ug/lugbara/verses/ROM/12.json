                  "text": "1 Kor 12:4-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te amani ovuria afa feza be ndu ndu ekile fele ama dri ’yeta anzutirisirile, kani e’yo oluzu, ama ma olu ekile esele a’ita amanirini ovulerile; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
