                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dinile eri asi ndriza fe ’ba erini lele asi ndriza fele vuniari vu, te eri asi mbaza fe ’ba erini lele asi mbaza fele vuniari vu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
            "verseOrgIds": [
              "ROM.9.18"
            ]
