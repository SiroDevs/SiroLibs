                "loc": "EPH.1.3+EPH.1.4+EPH.1.5+EPH.1.6+EPH.1.7+EPH.1.8+EPH.1.9+EPH.1.10+EPH.1.11+EPH.1.12"
              },
              "items": [
                {
                  "text": "Efe 1:3-12",
                  "type": "text"
