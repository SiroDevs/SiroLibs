                "loc": "EXO.9.16"
              },
              "items": [
                {
                  "text": "Efu 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo siza ’yo Farau tia, Kiri e’yo ’dirisi a’dule ma ’ba mi uru, ’dini ma eco okpo mani ecezu mi alia, ru mani ojizu ani angu dri dria. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
