                  "text": "Isa 8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’di e’yosi ya? A’di­siku yi ndruni eri a’itasi ku, te yi ndru eri azisi. Te yi ’de va oni ’ba pa sipirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
            "verseOrgIds": [
