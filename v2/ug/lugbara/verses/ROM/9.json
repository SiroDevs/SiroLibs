                  "text": "Rum 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isaya indi eri owu suru Isra­elinisi: Anzi Israelini yi ka ovu kakau ekile cinya ovupi miri ma tiarile ti, joloko a’dule yi nga yi pani; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
