                "loc": "NUM.23.19"
              },
              "items": [
                {
                  "text": "Kal 23:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ovuni kini e’yo Munguni oja i toko ’dini ku. Te ’ba dria Israelini ’diyi ovuni Israelini ku, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.6",
            "verseOrgIds": [
              "ROM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.12"
              },
              "items": [
                {
                  "text": "E’do 21:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "vini indi ka tro ndra enga ori Iburahimuni ma alia ti yi ovuni dria a’bianziru ku; te, ’Ba yi nga ori Isakani omve a’bianzi miniru’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.23"
              },
              "items": [
                {
                  "text": "Gal 4:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Efini ’dini, anzi tile e’yo ruanisi ’diyi yi ovuni anzi Mu­nguni ku, te anzi tile e’yo azizanisi ’diyi, omve yi oriru’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.8",
            "verseOrgIds": [
              "ROM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.10"
              },
              "items": [
                {
                  "text": "E’do 18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’yoza aziza ndeniri eri ’di’i, O’du ’dorisi ma nga emu, te Sarani nga agupirova isu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.21"
              },
              "items": [
                {
                  "text": "E’do 25:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’dini a’dule ku, te Rebeka indi o’du erini ’a isuzu ama ati Isaka dririsi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.10",
            "verseOrgIds": [
              "ROM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "0’du erini osizu nga kuria, te anzi nde ’diyi de nga yi ’yeni onyiru kani onzi kuria, ’dini e’yo Munguni edele ndra oko­kele ’ba opezuri ma so pa ci ani, ayuna ’bani ’yelerisi ku te Munguni yi omvelenirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.11",
            "verseOrgIds": [
              "ROM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.23"
              },
              "items": [
                {
                  "text": "E’do 25:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’yo ndra eri tia, Mva ambori nga azi nga wereri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.2+MAL.1.3"
              },
              "items": [
                {
                  "text": "Mal 1:2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile erini ovule sizarurile, Ma le Yakoboni ra, te ma ngu Esauni onzi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        }
