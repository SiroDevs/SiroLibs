              "items": [
                {
                  "text": "Isa 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile Isayani ’yole ndra okorile indi,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
