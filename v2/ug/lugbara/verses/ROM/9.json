              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.4"
              },
              "items": [
                {
                  "text": "Rum 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.29"
              },
              "items": [
                {
                  "text": "8:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini eri ma ece ani diza erini ma lonyi imvu ngapi yiki isupi erini ndra drio edele diza isuzu ’diyi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvu nde ’diyi jama ’ba erini omvele ’diyi, engazu kiri ’ba Yahudini eselia a’dule ku, te engazu ’ba suru azini ’diyi dria ma eselia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
            "verseOrgIds": [
              "ROM.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.23"
              },
              "items": [
                {
                  "text": "Hos 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile erini ’yole indi",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
