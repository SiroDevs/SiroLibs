                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "Efu 32:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma eco te lezaru Kristo ma tri ma ma ngulupi, adripi mani e’yo ruanisi, amani ovuzu yi be suru aluri ’diyi ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
