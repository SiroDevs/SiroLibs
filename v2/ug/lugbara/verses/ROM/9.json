              "items": [
                {
                  "text": "Yoh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te a’bipi ’diyi ’ba yini, azini Kristo enga yi eselia e’yo ruanisi, eri’i ovupi afa dria drilia, Mungu ovupi inzizaru ewule ewuleri. Amena.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
