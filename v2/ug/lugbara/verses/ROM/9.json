            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ama ’yo ngoni ya? Adaru suru dria onyi ma vuti bipi ku ’diyi yi isu onyi ra, onyi nderi eri onyi a’itaniri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.30",
            "verseOrgIds": [
