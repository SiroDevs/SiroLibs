                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "inini ’ye i de de, anguni ’ye ati ati. ’Dini ama ma tru,azi inini ra, ama ma su afa suza om­bani etuniri’i; ",
          "type": "text",
          "attrs": {
