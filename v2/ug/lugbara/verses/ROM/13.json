                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te azita ’diyi kini, Mi ’ba ali ku, Mi ’di ’ba ku, Mi ogu ku, Mi ’ba li afasi ku, te azita azini ka ovu indi, yi dria oku yi tualu e’yo ’di ma alia, kini, Mi ma le mi agyini mini mi lelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
