              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.6"
              },
              "items": [
                {
                  "text": "Zab 82:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.19"
              },
              "items": [
                {
                  "text": "Rum 12:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te eri azi Munguni nga mi ’yezu onyiru. Te mi ka onzi ’ye, mi ma ovu urisi, te eri ovuni sei be toko ku; te eri azi Munguni nga, adra omvizu ’ba onzi ’yepi ’diyi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.4",
            "verseOrgIds": [
              "ROM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi emi ma inzi yi e’yo adranisi a’dule ku, te e’yo niza emi aliarisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.21"
              },
              "items": [
                {
                  "text": "Mat 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.17"
              },
              "items": [
                {
                  "text": "Mar 12:17",
