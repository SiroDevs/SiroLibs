            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.25"
              },
              "items": [
                {
                  "text": "Luk 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi emi adri musoro fe indi, te yi ovu ’ba azi Munguni ngapi ’diyi e’yo ’diri ’yezu ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
