                  "text": "3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ’ba dri cepi ’diyi yi feni uri ’ba azi onyiru ’yepi ’diyi dri ku, te ’ba azi onzi ’yepi ’diyi dri. Mi le ovu opi ma milia uri kokoru ya? Mi ’ye onyiru, ’dini eri nga mi inzi beni, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.3",
            "verseOrgIds": [
              "ROM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 13:4"
          },
