      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta anzutiri pi, yiki pie, asi anzuru be, engapi Mungu Ata vu azini Yesu Kristo Mvi Atani vuri nga ovu ama be, e’yo adaru azini leta avasiri ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        }
      ]
    },
