              "items": [
                {
                  "text": "3 Yoh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atalau, oku ovupi pezaruri pi vu anzi erini be, mani lele e’yo adaru ma alia ’diyi; ma’i a’dule ku, te ’bale dria e’yo adaru nipi ’bo ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.1",
            "verseOrgIds": [
              "2JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "e’yo adaru ovupi ama aliari ma e’yosi, eri nga ovu ama be ’dani ’dani:",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
