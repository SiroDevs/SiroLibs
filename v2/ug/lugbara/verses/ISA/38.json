          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.7"
              },
              "items": [
                {
                  "text": "2 Opi 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu de Isaya ’yo ra, ’Ba ma’du elioefi ’bani ombale ngulururi, ma ombe eri apipi ma dria, eri nga ati ani ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia ’yo ndra vini, kini, Eceta mani nizu kini ma nga tu uru jo Yehovania ani adari eri a’dini ’ ya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
              "ISA.38.22"
            ]
          }
        }
      ]
    }
