                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri pe Eliakimu, ’ba ’ba opi ma loa ’diyi ma driliari pi ma ti nabi Isaya Amozi mvi vu, Sebina ’ba waraga sipiri pie, ’ba ’wara ’ba edeta edepi ’diyi ma eselia ’diyi pie, su dria koliba yi ruaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.2",
            "verseOrgIds": [
              "ISA.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
