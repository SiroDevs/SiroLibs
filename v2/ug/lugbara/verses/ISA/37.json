        },
        {
          "text": "Eri eca ’dini, opi Hezekia ka e’yo nderi eri ra, eri asi bongo ini ra, su koliba i ruaa, mu fi Yehova ma joa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.1",
            "verseOrgIds": [
              "ISA.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
