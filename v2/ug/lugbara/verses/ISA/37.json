                "loc": "JAS.5.14"
              },
              "items": [
                {
                  "text": "Yak 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kani Yehova Mungu miniri nga e’yo Rabisake, opi erini opi Asuriaa­rini tini epele Mungu idriru o’dazu­rini ’yole ’diyi eri ra, kani eri nga e’yo okporu omvi e’yo nde Yehova Mu­ngu minirini erile ’diyi ma e’yosi; e’yo ’disi mi zi Mungu ’ba joloko acepi ’diyi ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.4",
            "verseOrgIds": [
              "ISA.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi opi Hezekia ma ati’ba eca Isaya vu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.5",
            "verseOrgIds": [
              "ISA.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya nga di ’yo yi tia kini, Emi ma ’yo opi emini tia, Yehova ’yo ’dini kini, Mi ru ku e’yo mini erile ’diyisi, e’yo nde ati’ba opi Asuriaarini ’diyini ma o’dazu ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.6",
            "verseOrgIds": [
              "ISA.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ndre, ma nga orindi ’ba eri ma alia, eri nga di e’yo kuza azini eri ra, eri nga mvi ani angu inia; te ma nga fe eri ma dra sei sia, angu i ma ngulupini ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.7",
            "verseOrgIds": [
              "ISA.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.39"
              },
              "items": [
                {
                  "text": "Yos 15:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.42"
