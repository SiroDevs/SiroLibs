                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga ani ’yo eri tia, Hezekia ’yo ’dinile kini, O’du andruri eri o’du ocokoni, eri o’du egazu ’ba driarini, azini o’du drinzani; a’disiku etu anzi osizuri eca ’bo, te okpo yi osizuri yo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.3",
            "verseOrgIds": [
              "ISA.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.8"
              },
              "items": [
                {
                  "text": "1 Sam 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
