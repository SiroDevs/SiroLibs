            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.9"
              },
              "items": [
                {
                  "text": "2 Sur 11:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.11.30"
