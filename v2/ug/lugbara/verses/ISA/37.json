                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.7"
              },
              "items": [
                {
                  "text": "Yer 34:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi Rabisake mvi di ra, isu opi Asuriaari erini omba ’baria Libina be; te eri eri ndra kini eri ku Lakisini ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.8",
            "verseOrgIds": [
              "ISA.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini eri eri e’yo kuza e’yo Tirihaka opi Etiopiaarinisi kini, Eri efu omba ’bazu mi be. Te eri ka e’yo ’diri eri ra, eri pe ojio ma ti Hezekia vu, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.9",
            "verseOrgIds": [
              "ISA.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ’yo ’dini Hezekia opi Yudaari ma tia kini, Mi fe Mungu mini a’ileri ma ici mi ku, kini, ’Ba ngani Yerusale­muni fe opi Asuriaari ma dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.10",
            "verseOrgIds": [
              "ISA.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ndre, mi eri ’bo e’yo opi Asuriaa ’diyini ’yele angu dria dri, yi ezazu teketekeri. Te yi nga lu mi pa’i ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.11",
            "verseOrgIds": [
              "ISA.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.31"
              },
              "items": [
                {
                  "text": "E’do 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Efu 27:23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adrou suru ndu nduni, ma a’bipini yi dri jale, yi Gozani pi, Harani pie, Rezefu pie, anzi Edeni ovupi ndra Telasaria ’diyi pie ’diyi, yi opa yi ndra ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.12",
            "verseOrgIds": [
              "ISA.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.23"
              },
              "items": [
                {
                  "text": "Yer 49:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Hamatiniri pi, opi Aripadiniri pie, opi aku Sefarivaimuari pie, opi Henaniri pie, opi Ivaniri pie dria yi ngoa ya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.13",
            "verseOrgIds": [
              "ISA.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nga di waraga a’i ’ba ojioru ’diyi ma dria, nga eri la ra; te Hezekia nga di tu fi Yehova vile joa, nga waraga nde aja Yehova milia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.14",
            "verseOrgIds": [
              "ISA.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Hezekia nga zita zi Yehova ma tia, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.15",
            "verseOrgIds": [
              "ISA.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Efu 25:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongu­lumuruni, Mungu Israelini, ripi ’Kerubi ma driari, mi ovu Mungu, adaru mi’i a’dukule, suru nyakuni dria ’diyi ma driliari’i; mi ’ba ndra ’bu pi nyaku be. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.16",
            "verseOrgIds": [
              "ISA.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.18"
              },
              "items": [
                {
                  "text": "Dan 9:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi co mi bile, Yehova la, mi eri; mi zi mi mile, Yehova, mi lu; mi eri e’yo Senakeri­buni ’yole ’diyi dria, erini tini epele Mungu idriruri o’dazu ’diyi fo! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.17",
            "verseOrgIds": [
              "ISA.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaru, Yehova, opi Asuriaa ’diyi eza suru dria angu yini be ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.18",
            "verseOrgIds": [
              "ISA.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi o’be adrou yini acia ’bo; a’disiku yi ovuni Munguni ku, te kiri afa ’ba drini edele patisi azini onisi ’diyi; e’yo ’disi yi ja yi dri ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.19",
            "verseOrgIds": [
              "ISA.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Yehova Mungu ama­niri la, mi ari ama eri ma dria fo, ’dini suru nyakuni dria ma ni ani mi ovu Yehova’i, mi’i a’dule.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.20",
            "verseOrgIds": [
              "ISA.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.20",
            "verseOrgIds": [
              "ISA.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu ’dasi Isaya Amozi mvi nga ’ba ti pe Hezekia vu, ’yozu kini, Yehova Mungu Israeliniri ’yo ’dini kini: Mini e’yo zile ma tia Senakeribu opi Asuriaari ma e’yosi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.21",
            "verseOrgIds": [
              "ISA.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "e’yo Yehovani ’yole eri ma driari eri ’di’i:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.22",
            "verseOrgIds": [
              "ISA.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.29",
            "verseOrgIds": [
              "ISA.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di nga ovu ecetaru mi dri: eli ’dorisi emi nga nyaka zopi i ma drisi ceniri nya’i, eli irisi emi nga anya angangaru engapi ori ndraka ’darisiri nya’i; te eli narisi emi ma ri ori, emi lo anya, emi sa amvu zabibuni, emi nya efini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.30",
            "verseOrgIds": [
              "ISA.37.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba jolokoru acepi yi papi suru Yudani ma eselia ’diyi, yi nga ola yini so va dika, yi nga vini efi ’ya uru indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.31",
            "verseOrgIds": [
              "ISA.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.31"
              },
              "items": [
                {
                  "text": "2 Opi 19:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba acepi ’diyi nga fu Yerusalemuasi, ’ba apapi ’diyi nga fu Zioniasi. Asi aciru Yehovani nga e’yo ’di ’yeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.32",
            "verseOrgIds": [
              "ISA.37.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Yehova ’yo ’dini opi Asuriaari ma e’yosi, kini: Eri ngani di efi aku ’diria ku, eri ngani vini ’ye gbi ’dia ku, ngani vini eca aku ’dori ma drilia gombere ombani be ku, ngani nyaku oku apiferu ageinia ombasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.33",
            "verseOrgIds": [
              "ISA.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geri erini emuzuri, geri ndesi eri nga mvi ra, te eri ngani efi aku ’doria ku, Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.34",
            "verseOrgIds": [
              "ISA.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ISA 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.6"
              },
              "items": [
                {
                  "text": "2 Opi 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.3"
              },
              "items": [
                {
                  "text": "Isa 27:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga a’di ’di aku ’diri pazu, ma ngulupi ma e’yosi azini ati’bo mani Daudi ma e’yosi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ISA 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.35"
              },
              "items": [
                {
                  "text": "2 Opi 19:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te malaika Yehovani nga di efu, eri fu ’ba alifu turu alu kali aro drini towi, pari ’ba Asuriaa ’diyini hema asozuri ma eselia; te ’ba ka enga o’bitisi, mi ne, ’ba nde ’diyi dria ovu avuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Senakeribu opi Asuriaari nga di enga dri kozu, mvizu ovuzu Ninevea. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ISA 37:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, erini inziria adrou ini Nisiroki ma joa, anzi ini Adrameleki pi Sarezeri be yi nga eri ’di seisi,te yi apa angu Araratia, Te Ezari­hadoni mvi erini nga di opi nya eri ma pariani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.38",
            "verseOrgIds": [
              "ISA.37.38"
            ]
          }
        }
      ]
    }
