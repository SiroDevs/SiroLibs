              "items": [
                {
                  "text": "Rum 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.11"
              },
              "items": [
                {
                  "text": "2 Tes 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri of uta nya’i; yi ici eri ma asi eri oja i kalaa ani, eri econi ani i ma orindi arizaru ku, eri econi vini ’yozaru ku kini, E’yo inzoru ovuni ma dri ndia ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        }
