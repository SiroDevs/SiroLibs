            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.8+ROM.11.9+ROM.11.10"
              },
              "items": [
                {
                  "text": "Rum 11:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
