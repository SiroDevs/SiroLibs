              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi ’ba nga geri amboru ofa gbokoru engazu Misiria cazu angu Asuriaa, ’ba Asuriaa ’diyi nga emu Misiria, ’ba Misiria ’diyi nga ca Asuriaa indi, azini ’ba Misiria ’diyi nga Mungu inzi tualu ’ba Asuriaa ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi Israeli pi nga ovu Misiri pie, Asuria pie, suru nariru, asi ndriza fezu nyaku ma eselia, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
