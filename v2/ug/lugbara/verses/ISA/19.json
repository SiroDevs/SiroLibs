              "items": [
                {
                  "text": "Isa 55:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ovu di ecetaru, e’yo Yehova asikari ongulumuruni ma e’yo eti nzezu angu Misiria; te yi nga wu Yehova vu ’ba ’ba inzapi ’diyi ma e’yosi, azini eri nga ’ba ’ba papiri, ’ba ’ba agei tepiri, ma ti pe ani, eri nga di yi ari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.11"
              },
              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehovani nga di ovu nizaru Misiria; ’ba Misiria ’diyi nga Yehovani ni o’du ’dasi ani, ada yi nga eri inzi edeta edezasi, afa feza be, azini yi nga oyo so Yehova dri, yi nga ’ye yini oyoni solerile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehovani nga vini Misiri co fa, cozu azini atizu, yi nga di mvi Yehova vu, eri nga zita yini a’i ra, nga ani yi ma rua ati ra.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
