                  "text": "1 Pet 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku Yehova ’yo ’dini: ’Ba fe ndra emi je toko, azini yi vini nga emi onze silingi kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku Opi Yehova ’yo ’dini: Suru mani is ndra okorisi Misiria, yi ma ’a’a ’dale ani, te ’ba Asuriani inza yi toko e’yo ikokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.24"
              },
              "items": [
                {
                  "text": "Rum 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di, Yehova ’yo ra, ima ’ye ’doa a’duni, yini suru mani jile ’dale tokorurisi ya? ’Ba adripi yi drilia opiru ’diyi owu tu, Yehova ’yo ra, azini ’ba o’da ma ru ’dani o’du dria. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi suru mani yi nga ru mani ni ra; e’yo ’disi yi nga ni o’du ’dasi kini, ’ba e’yo ’yopiri eri ma’i; mi ndre, ma ’do’i.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
