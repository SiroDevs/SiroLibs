            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.14"
              },
              "items": [
                {
                  "text": "Isa 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.23"
              },
              "items": [
                {
                  "text": "Mat 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga ra drile okposi kpere Yu­daa, eri nga ti ra, nga aga geri angu ma aliarisi, eri nga ovu aliru kpere ombele vusi; erini i ma opile oj aria, eri nga ga angu mini ma wala dria, Imanueli la",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
