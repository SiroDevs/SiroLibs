            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.24"
              },
              "items": [
                {
                  "text": "Luk 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.33"
