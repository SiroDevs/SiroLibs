              "items": [
                {
                  "text": "Rum 9:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.8"
              },
              "items": [
                {
                  "text": "1 Pet 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ovu ekile pari alatararule; te ekile kumu ’bani pa sizuri, kani ekile oni abazanile ori’ba Israelini ’diyi dri iri­tro, ese pile emba be ’ba ovupi Yerusalemua ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.18"
              },
              "items": [
                {
                  "text": "Luk 20:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba kakau nga yi ma pa si drinia; yi nga e’de va, yi nga yi onyo ra nga yi bi embasi, nga yi ’du",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        }
      ]
    },
