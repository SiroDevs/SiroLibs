                "loc": "DAN.12.4"
              },
              "items": [
                {
                  "text": "Dan 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ombe e’yo eti nzeza mi ebi eceta azita ma dria ci ’ba ma vuti ’bipi ’diyi ma eselia, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.3"
              },
              "items": [
                {
                  "text": "Hab 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.25"
              },
              "items": [
                {
                  "text": "Luk 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Ebra 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga ’Yehova i ma mile zipi ori’ba Yako­’bonisi rari te, ma oga lu eri vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.8"
              },
              "items": [
                {
                  "text": "Zek 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Ebra 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ndre, ma’i, anzi Yehovani fele ma dri ’diyi be, ama ovu ecetaru ,azini taliru Israeli ma alia, engazu Yehova asikari ongulumuruni ovupi ’oni Zioniari vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.28"
              },
              "items": [
                {
                  "text": "Zab 106:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te etu yini ’yozu mi tia, Mi nda ’ba ovupi orindi andri ndripiri be ’diyi, ’ba ojouru e’yo o’yopi o’duko urusi azini o’duko nyiriasi ’diyi be-risi, te onyiruni suru ma nda Mungu yini ku ya? Yi ma nda ’ba idriru ’diyi ma e’yo ’ba ’bilia ’diyi vu ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma nda azita ma alia e’yo eti nzeza be fo! yi ka e’yo ’yo e’yo ’yoza ’diri vusi ku, adaru angu ngani ati yi ma dria o’bitisi ku, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi nga aga alenia e’yo ewaru ocokoru be azini abiri be; te eri nga di eca ’dini, etu yini ngazu ovuzu abiri berisi yi nga agata ga yi ma eselia, yi nga ’ba o’da opi yini ma rusi, Mungu yini ma rusi indi, te yi nga yi ma mile enga uri; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
