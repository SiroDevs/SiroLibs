                "loc": "MAT.20.15"
              },
              "items": [
                {
                  "text": "Mat 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo nde feni ayiko Yona dri aluni ku, eri ovu ani aokosi tu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Efu 34:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri zi Yehova tia kini, Ma zi mi tia, Yehova la! de ma ovu ma vile angua ma ’yoni ndra ’dini ku ya? Ma ’ye ndra bani apa mbe1e Tara­sisia ani ’da; a’disiku ma ni ra mi Mungu asi ndriza e’ini, yiki aleru turi’i be; aoko nyani mi mbe1e ku, te mi yiki be amboru, mi adri mi asi omvi e’yo onzi kuzu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.4"
              },
              "items": [
                {
                  "text": "1 Opi 19:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dinile Yehova la! ma zi mi tia, mi nze di idri mani curu’do ra; a’disiku mani drazuri ba, aga mani ovuzu idriruri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga di ’yo eri La, Aokoni mi nyazu ’diniri onyiru ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Yona nga di fu akuasi amve, nga ri va aku ma kala etuni efurialeruria, nga boroko si i dri ’daa, nga ri va endrinia, de nga ndreni e’yoni nga i ’ye aku amboru nderia ngoni yari ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mungu nga di nzu ede, eri fe erini razu Yona ma dria uru, ovuzu di endriru eri ma dri dri beni, azani kozu ocoko erini onzikanyarori ma alia. E’yo ’disi Yona nga di ovu ayikosi tu nzu ma e’yosi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te drusi ’dini anguni atiria Mungu nga eriaka ede, eriaka nde nga di nzu nde mbe ra, onyu ani ra, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.121.6"
              },
              "items": [
                {
                  "text": "Zab 121:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, etu ka ca uru a’iyoru ’bo, Mungu ede oli aciru engapi woko etuni efurialeruria, etu nga di Yona ma dri ve, kpere icimakoroni eri ’beria, eri le te di i ma dra ra, ’yo ra, Mani drazuri ba aga mani ovuzu idriruri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Mungu nga di ’yo Yona tia, Aokoni mi nyazu e’yo nzunisiri onyiru ya? Eri kini, Mani ovuzu aokosi kpere mani drazu kairi ba. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo ra, Te mi ovu yikisi e’yo nzunisi ra, mini azini ngale kuri, mi feni vini erini idizuni ku; afa nde idi mbele ini alusi, ja dri vini mbele ini alu azirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.11"
              },
              "items": [
                {
                  "text": "Eze 33:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.39"
              },
              "items": [
                {
                  "text": "Azi 1:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.36.6"
              },
              "items": [
                {
                  "text": "Zab 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dinile ma ka ovu yikisi Nineve aku amboruri vu, onzi ya? Aku nde ma alia ’ba yi ovu alifu turu alu drini kali iri, ’ba ecopi yi ma dri ndiri pi ma esele copi dri ejiri be ku ’diyi; azini alenia anyapa tu.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
