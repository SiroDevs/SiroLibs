              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani nga eca Yona vu pale iririsi kini, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi enga, mi mu Nineve aku amboru ’daria, mi olu eri tia oluta mani azile mi tiari. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Yona enga di ra, mu Ninevea Yehovani ’yolerile. Te Nineveni aku amboru tu, ’bani ani acizu alenia o’du na ’dipiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.3",
            "verseOrgIds": [
              "JON.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.22"
              },
              "items": [
                {
                  "text": "Azi 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mat 12:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.32"
              },
              "items": [
                {
                  "text": "Luk 11:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dinile Yona e’do di fizu aku ma alesi acizu o’du alu, Eri oyu o’duko urusi kini, Ace nga o’du kali su, Nineveni nga dri ja ra! ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.4",
            "verseOrgIds": [
              "JON.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mat 12:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.32"
              },
              "items": [
                {
                  "text": "Luk 11:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Ninevea ’diyi nga ani Mungu a’i ra; yi azi nyaka ’dazu, yi nga di koliba osu yi ma ruaa, e’dozu ’ba ’warasi kpere cazu ’ba nyiri vu indi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        }
      ]
    },
