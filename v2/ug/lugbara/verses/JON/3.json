            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Sur 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.15"
              },
              "items": [
                {
                  "text": "Yoe 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo kuza eku Nineve ma eselia dria, azita opi pini ’ba ’wara eri ma palaa ’diyi berisi, kini: ’Ba dria alu alu ma o’bi afa azini ma aji aluni ku, kani ’ba agupiru, kani anyapani, kani tini, kani kabiloni; yi ma nya nyaka ku, ma mvu yi ku indi; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
