                  "text": "Mik 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yoni ku kpere opi Nineveari ma bilia ra, eri nga di enga ogua erini opiniri ma driarisi, nga bongo ini tru i ma ruaarisi ra, nga koliba su, nga ri va ofuta ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
        {
          "name": "verse",
