              "JON.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu ndre ’yeta yini, yini yi ojazu geri yini onziri kuzu ra te Mungu nga di asi omvi, nga e’yo onzi nde erini ’yole kini i nga ’ye yi vu rari ’ye ku.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
            "verseOrgIds": [
              "JON.3.10"
            ]
          }
