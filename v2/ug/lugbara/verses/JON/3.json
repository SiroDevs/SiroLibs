            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.27"
              },
              "items": [
                {
                  "text": "Dan 4:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te yi dria ma su koliba yi ma ruaa, ’ba piyi anyapa pie dria, yi ma wu Mungu vu asi driasi; adaru yi alu alu ma oja yi e’yo onzi yini kuzu, e’yo eganaru yini ’yele yi ma drisiri kuzu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.8",
            "verseOrgIds": [
              "JON.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’di nini, kani Mungu ngani i oja, ngani i ma asi omvi dika ku, i ma aoko vepi okporuri kuzu, ama ma ja dri ani ku beni yani?",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
          }
        }
      ]
    },
