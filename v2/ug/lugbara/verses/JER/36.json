          ]
        },
        {
          "text": "Baruki nga e’yo omvi ’yo yi tia, Eri olu e’yo ’diyi dria ma tia tilesi kililiru, ma si ani e’yo nde yi vinosi buku ma alia ’di’i. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        },
        {
