                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dasi e’yo Yehovani eca Yeremia vu, opi ka enyi traza e’yo Barukini sile Yeremiani olule eri tia ’diyi be ruaniari ve de ’bo: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
