          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba opiru nga di ’yo Baruki tia, Mi mu, mi zi ra, emi Yeremia be, ’ba aluni ma ni pari emini ovuzuri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
