          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia yi fi opi vu irii dria, de isu yi mba enyi traza nderi ma ta Elisama ’ba waraga sipiri vile jo aliza ma alia; yi olu e’yo dria opi ma bilia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
