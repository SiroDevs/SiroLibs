                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.45.1"
              },
              "items": [
                {
                  "text": "45:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dasi Yeremia nga Baruki Neria mvini omve ra, te Baruki nga di e’yo dria Yehovani ’yole Yeremia ma tia efupi Yeremia ma tilia ’diyi si enyi traza bukururi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye­remia nga di e’yoni azi Baruki ma tia kini, Oga ma ’bo; ma econi fizaru jo Yehovaniria ku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.29"
              },
              "items": [
                {
                  "text": "Lev 16:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.4"
              },
              "items": [
                {
                  "text": "23:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.14"
              },
              "items": [
                {
                  "text": "Neh 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e’yo ’disi mi mu mi’i, mi ma la e’yo Yehovani efupi ma tilia mini sile enyi traza bukururi ma aliari, ’ba dria ovupi Yehova vile joa o’du nyaka ’dazurisi ’diyi ma bilia. Mi ma la vini e’yo nderi ’ba Yudani efupi yi ma aku ambo ambo ’diyiasi ’diyi ma bilia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.15"
              },
              "items": [
                {
                  "text": "Azi 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.18"
              },
              "items": [
                {
                  "text": "29:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kani yi nga matu ’ba Yehova ma drilia yani, yi ma emvi ’ba dria alu alu geri yini onziri kuzu ani, a’disiku aoko pi adra aciru be Yehovani olule suru ’dori ma driari eri amboru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baru­ki Neria mvi nga e’yo dria ’ye ekile nabi Yeremiani azile eri tiarile, eri la e’yo Yehovani bukua jo Yehovaniri ma alia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.26"
              },
              "items": [
                {
                  "text": "Lip 20:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.6"
              },
              "items": [
                {
                  "text": "1 Sam 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Sur 20:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini eli towi Yehoyakimu Yosia mvi opi Yudaa­rini opi nyazurisi, mba oromi ma alia, ’ba dria ovupi Yerusalemua ’diyi, ’ba dria efupi aku ambo ambo Yudani ’diyiasi, fipi Yerusalemua ’diyi, nga o’du nyaka ’dazu Yehova ma driliari eku ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi Baruki nga e’yo Yeremiani la buku alia jo Yehovani ma alia ’ba dria ma bilia, jo aliza Gemaria Safani mvi ’ba waraga sipiri vile ovupi irii uruleruri ma dria, pari fizu kalitile o’diru jo Yehovaniaria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gemaria Safani mvi ma mvi Mikaya ka e’yo Yehovani yini lale buku aliari eri dria ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga di fi opi vile joa kpere ’ba waraga sipiri ma jo aliza ma alia; te mi ne, ’ba opiru dria ri ’dale: yi Elisama ’ba waraga sipiri pi, Delaya Semaya mvi pie, Elinatani Akibori mvi pie, Gemaria Safani mvi pie, Zedekia Hanania mvi pie, ’ba opiru ’diyi be dria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nga di e’yo dria erini erile Barukini buku laria ’ba nde ma biliari olu yi ma tia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.6"
              },
              "items": [
                {
                  "text": "Eze 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ’ba opiru ’diyi dria nga Yehudi ma ti pe Baruki vu-Yehudi nderi ovu Selemia Kusi mvi ma mvi Netania ma mvi’i-kini, Mi ’du enyi traza mini lale ’ba nde ma biliari mi dria, mi emu. Baruki Neria mvi nga di enyi traza ’du i ma dria, nga emu yi vu ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ’yo tinia, Mi ri va, mi la eri ama ’bilia fo! Ka’dini Baruki nga e’yo nde la yi ma bilia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.11"
              },
              "items": [
                {
                  "text": "1 Sam 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.24.25"
              },
              "items": [
                {
                  "text": "’Yeta 24:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, yi ka e’yo dria eri ’bo, yi olu yi milia milia urisi; yi ’yo Baruki tia, Ada ama nga e’yo ’diyi olu opi tia dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi zi vini Baruki tia kini, Mi olu nga amani, mi si e’yo efupi eri ma tiliari ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        },
