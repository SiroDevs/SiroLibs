        },
        {
          "text": "Kani ori’ba Yudani nga e’yo onzi dria mani egale ma asia ’yezu yi ma ruaari ma e’yo eri ra yani, yi ma emvi dria alu alu geri yini onziri kuzu ani; ma ma wu e’yo onzi yini pi ezata yini be beni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
