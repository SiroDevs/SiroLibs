              },
              "items": [
                {
                  "text": "29:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ope ati’ba erini nabiru ’diyi ma ti emi vu dria, erini engaria o’biti drio drio, erini yi ti peria (te emi erini ku, emi; coni emi bile e’yo erizu ku) ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
