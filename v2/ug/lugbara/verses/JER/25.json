              "items": [
                {
                  "text": "16:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.22+REV.18.23"
              },
              "items": [
                {
                  "text": "Eceza 18:22-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini vini indi ma nga o’duko acece o’bezuri nze yi ma eseliarisi ra, o’duko ayikoni pie, o’duko izioni pie, o’duko amu­ruani pie, oni awu anya ’izuri pie, aci ma diza pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
