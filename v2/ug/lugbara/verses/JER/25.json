                "loc": "LUK.13.3+LUK.13.4+LUK.13.5"
              },
              "items": [
                {
                  "text": "Luk 13:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’yozu kini, Emi emvi curu’do, emi dria alu alu, engazu geri emini onzikanyaru ’diyiasi, e’yo onzi emini ’yele ’diyi kuzu ja, emi ma adri di angu Yeho­vani fele emi dri emi a’bipi be, engazu drio cazu ’dani ’daniri ma alia ani; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ma mu adrou azini ’diyi ma vutia azi ngazu yi dri ku, yi inzizu, fezu adrani engazu ma asia afa emi drini edele ’diyisi. Ka’dini ma ngani emi ’ye onzi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.19"
              },
              "items": [
                {
                  "text": "Yer 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.30"
              },
              "items": [
                {
                  "text": "32:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ti, emi erini nga ma ku, Yehova ’yoni, fezu adrani engazu ma asia ani afa emi drini edele ’diyisi, e’yo onzi ejizu emi ngulupi ruaa ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Yehova asikari ongu­lumuruniri ’yo ’dini: Emini e’yo mani erile kurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.15"
              },
              "items": [
                {
                  "text": "Yer 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.2"
              },
              "items": [
                {
                  "text": "40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.16"
              },
              "items": [
                {
                  "text": "18:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mi ndre, ma nga ’ba ti pe ori’ba angu andraleruria ’diyi pi omvezu dria, Yehova ’yo ra, Nebukadreza opi Babulonia ati’bo maniri be, ma nga yi eji omba ’bazu angu ’dori be, ’ba ovupi alenia ’diyi pie, suru ndu ndu yi ma ageia ’diyi be; te ma nga yi ma dri ja teketeke, ma nga yi ’ba ovuzu osutaru, onziaru, andruru ’dani ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
