              "type": "text"
            }
          ]
        },
        {
          "text": "opi dria Turoa ’diyi pie, opi dria Zidonia ’diyi pie, opi angu miri ma ti ’aa’da­siria ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
