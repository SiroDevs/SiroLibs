                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga eri mvu ra, yi nga aba aha ’dole azini ’dale, yi nga aza aza, sei mani ngale tini pele yi ma eseliari ma e’yosi. ",
          "type": "text",
          "attrs": {
