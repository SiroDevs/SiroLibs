                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ecapi Yeremia vu, ’ba dria Yudaa ’diyi ma e’yosi, eli su Yehoyakimu Yosia mvini opi nyazu Yudaarisiri, eli ’da ovu eli oko Nebukadreza opi Babuloniarini e’do­zu opi nyazuri’i, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "e’yo nde ’diri nabi Yeremia olu ’ba dria Yudaa ’diyi pi ma tia ’ba dria ovupi Yeru­salemua ’diyi be, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.2"
              },
              "items": [
                {
                  "text": "Yer 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Engazu eli mudri drini na Yosia Amoni mvi opi Yudaarini opi nyazurisiria, ecazu kpere andru, eli kali iri drini na ’diyisi, e’yo Yehovani eca ma vu, azini ma olu emi tia, mani engaria o’biti drio drio, e’yo ’yoria emi tia; te emi erini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
