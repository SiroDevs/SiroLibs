              "items": [
                {
                  "text": "Yer 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma nga mi fe ’ba ndrupi mi fupi ’diyi ma dria, ’ba mini rule ’diyi, adaru Nebukadreza opi Babuloniari pi ma dria ’ba Kalideyani ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
