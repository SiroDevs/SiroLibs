              },
              "items": [
                {
                  "text": "2 Opi 24:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga mi ’be amve mi andri mi osipiri be, angu azini mini osizu alenia kuria; emi nga odra ’dale. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
