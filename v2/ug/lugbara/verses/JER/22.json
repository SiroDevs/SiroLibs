                "loc": "JER.17.25"
              },
              "items": [
                {
                  "text": "Yer 17:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku emi ka e’yo ’diyi ’ye adadaru, ka’dini opi ripi oguna Daudini ma dria, tupi gari dria azini nzupi akanya ma dria ’diyi nga efi jo ’dori ma tilia ra, eri’i ati’ba erini pie, ’ba erini ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
