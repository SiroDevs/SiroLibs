            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ’yo, Mi eri e’yo Yehovani, opi Yudaari la, ripi oguna Daudini ma driari, mi’i ati’ba mini ’diyi pie, ’ba mini fipi jotile ’diyiasi ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
          }
