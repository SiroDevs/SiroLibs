              "items": [
                {
                  "text": "2 Sur 34:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di e’yoni omvi kini, Yini Yehova Mungu yini ma aziza kule, yini Mungu andini inzile, azi ngazu yi dririsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
