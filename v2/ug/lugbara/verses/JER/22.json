                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo ’dini: Emi li e’yo liza kililiru, azini e’yo onyiru, azini emi ma ari ’ba yini yi ma afa opazu ra ’diyi ’ba yi inzapi ’diyi ma driasi. Emi ma ’ye ’ba onzi ku, emi ma ecocua ani’bo pi okposi ku, imvoa pie, awuzio pie, emi ma ada ’ba e’yo kokoru ’diyi ma ari pari ’dori ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.3",
            "verseOrgIds": [
              "JER.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
