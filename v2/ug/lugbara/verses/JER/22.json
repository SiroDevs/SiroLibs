        {
          "text": "Mani ovule idrirurile, Yehova ’yo ra, Konia Yehoyakimu opi Yudaari mvi ka te ovu driadriamva eceta be ruaa ma dri ndiari ti, ma te mi nze ’diarisi ra; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
