        },
        {
          "text": "Yehova ’yo ’dini: Mi si andra ’dale opi Yudaari ma joa, mi ’yo e’yo ’diri ’dale, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
              "JER.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
