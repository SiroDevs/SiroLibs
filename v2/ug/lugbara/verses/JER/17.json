                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo ’dini: Emi te emi agei, emi ma ’du afa ji o’du sabatonisi aluni ku, emi ma ofi eri kalitile Yerusalemua ’diyiasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
