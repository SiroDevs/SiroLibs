              "items": [
                {
                  "text": "Yer 16:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini mi adaru mi ma ngulupi nga awita ndra mani fele mi driri ku ra, azini ma nga fe mi ma nga azi ari’ba mini dri angu mini nile kuri ma alia; a’disiku emini adra mani ma ad ngapi vepi ’dani ’daniri edulerisi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
