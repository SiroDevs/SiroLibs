              "items": [
                {
                  "text": "Mat 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.79.3"
              },
              "items": [
                {
                  "text": "Zab 79:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba nde yini e’yo ondrile yi ma tia ’diyi, yi nga yi ma avu o’be amve geri Yerusalemuni ma alia, abiri pisi sei be, ’ba ngapi yi sapini yo--yi’i, oku yini pie, agupianzi yini pie, ezoanzi yini pie; a’disiku ma nga e’yo onzi yini osu yi ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.16",
            "verseOrgIds": [
              "JER.14.16"
            ]
