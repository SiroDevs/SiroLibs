              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.10"
              },
              "items": [
                {
                  "text": "Isa 30:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.21"
              },
              "items": [
                {
                  "text": "Yer 23:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.9+2TH.2.10+2TH.2.11"
              },
              "items": [
                {
                  "text": "2 Tes 2:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vutinia Yehova ’yo ma tia kini: Nabi yi e’yo nze inzosi ma rusi; ma peni yi ma ti ma’i ku, ma azini vini e’yo yi ma tia ma’i ku, ma ’yoni e’yo yi be ku indi. Yi afa ndreza inzoruri ma e’yo nze emi tia, andri ndriza be, afa tokori pie, lokiri yi ma ngulupi ma asiari pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.15"
              },
              "items": [
                {
                  "text": "Yer 23:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi, nabi e’yo nzepi nabiru ma rusi de isu ma peni yi ma ti ma’i ku, te ti yi ’yo ra, Sei pi abiri be ngani ovu angu ’dori ma alia ku-’diyi ma e’yosi Yehova ’yo ’dini: Nabi ’diyi nga dri ja sei pisi liki be ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
