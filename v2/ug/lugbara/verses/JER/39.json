              "items": [
                {
                  "text": "1 Sur 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.7"
              },
              "items": [
                {
                  "text": "Zab 32:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ma nga mi pa ada, mi ngani dra sei ma sia ku; te mi nga mi idri pa afa pale ombaarile, mini mi asi ’bale ma a’izurisi, Yehova ’yo ra.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.18",
            "verseOrgIds": [
              "JER.39.18"
            ]
          }
        }
      ]
    }
