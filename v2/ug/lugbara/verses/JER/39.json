              },
              "items": [
                {
                  "text": "Yer 52:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te asikari ongulu­muru ’ba Kalideyaa ’diyini nzuria yi ma vutia, isu Zedekiani angu senderu Yerikoaria raj ka eri bi ’bo, yi ji eri furu Nebukadreza opi Babuloniari vui Ribila angu Hamatiniaria; eri li e’yo ’drini a’daa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.5",
            "verseOrgIds": [
              "JER.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi opi Babu­loniari ofu anzi Zedekia vile ’diyi Ribilaa, va eri ma milia ra; opi Babuloniari ofu vini ’ba ’wara Yudani dria indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.6",
            "verseOrgIds": [
              "JER.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia oso Zedekia ma mile ra, oti eri anzirikusi, ji eri Babulonia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.7",
            "verseOrgIds": [
              "JER.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Kalideyaa ’diyi eve opi ma jo acisi, jo ’bani indi, yi asu abi kaliru Yerusalemuari va. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.8",
            "verseOrgIds": [
              "JER.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi Nebuzaradani, ’ba asikari opi agei tepi ’diyi ma driliari, ji ’ba acepi jolokoru aku amboru ma alia ’diyi ati’baru Babulonia, ’ba mbupi amve ’diyi yi ojapi eri vu ’diyi pie, ’ba nde acepi jolokoru ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.9",
            "verseOrgIds": [
              "JER.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Nebuzaradani ’ba asi­kari opi ma agei tepi ’diyi ma driliari nga ’ba alioru, ’ba ma eselia ovupi afa kokoru ’diyi, ku angu Yudania ’dani, fe vini amvu zabibuni yi dri amvu azini be o’du ’dasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu Nebukadreza opi Babulo­niari nga e’yo azi Nebuzaradani ’ba asikari opi ma agei tepi ’diyi ma driliari ma tia e’yo Yeremianisi, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ’du eri, mi te eri agei onyiru, mi ’ye eri onzi ku, te mi ma ’ye eri vu erini ngale ’yole mi tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Nebuzaradani nga ’ba ti pe eri’i, Nebusazibani ’ba Rabisarisirisiruri pie, Nerigali-sareza ’ba Rabimagiruri pie, ’ba amboru ’ba dri cepi opi Babuloniari vile ’diyi pie dria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.28"
              },
              "items": [
                {
                  "text": "Yer 38:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.5"
              },
              "items": [
                {
                  "text": "40:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.24"
              },
              "items": [
                {
                  "text": "26:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi pe ’ba ti, Yeremiani e’duze asikari opi agei tepi ’diyi ma irii driasi, eji eri fe Ahikamu Safani mvi ma mvi Gedalia dri, eri ma ji eri akua ani. ’Dini eri ovu ’ba ma eselia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo Yehovani nga eca Yeremia vu, de isu eri ovu ombezaru asikari opi agei tepi ’diyi ma irii dria aruru, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
              "JER.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.42"
              },
              "items": [
                {
                  "text": "Mat 10:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.12"
              },
              "items": [
                {
                  "text": "Dan 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi mu, mi ’yo Ebedi-meleki ’ba Etiopiani ma tia kini, Yehova asikari ongulumuruni Mungu Israeliniri ’yo ’dini: Mi ndre, ma nga e’yo mani ’yoleri ji aku amboru ’dori ma dria, e’yo onzi ejizu, te e’yo onyiru ejizu ku, te e’yo nde ’diyi nga yi ’ye mi milia o’du nde ’dasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te o’du nde ’dasi ma nga mi ari ra, Yehova ’yo ra, te mi ngani ovu fezaru ’ba nde mini rule ’diyi ma dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.17",
            "verseOrgIds": [
              "JER.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.9"
              },
              "items": [
                {
                  "text": "Yer 21:9",
                  "type": "text"
                }
