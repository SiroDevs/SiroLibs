                "loc": "JER.52.4+JER.52.5+JER.52.6+JER.52.7"
              },
              "items": [
                {
                  "text": "Yer 52:4-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, yini, Yerusalemuni ’duzu ’boria, (eli oromi ma mba mudri Zedekia opi Yudaarini opi nyazurisi, Nebuka-’dreza opi Babuloniari emu asikari ongulumuru erini pie dria, omba ’bazu Yerusalemu be, yi ace eri kuru; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eli mudri drini aluri ma mba su ma o’du oromi Zedekiani opi nyazu­risi, yi olu di aku amboru nde ma abi talaa hu hu), ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba opiru opi Babuloniari vile ’diyi efi dria, ri va kalitile agaduaria: yi Nerigali-sareza pi, Samigari-nebo pie, Sarisekimu Rabisarisiruri pie, Nerigali-sareza Rabimagiruri pie, ’ba opiru opi Babuloniari vile ’diyi ma azi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Zedekia opi Yudaari ’ba ombaru ’diyi pie dria ka yi ndre ra, yi apa ra, yi fu akuarisi amve inisi, geri opi ma amvuarisi, kalitile abi iri ma eseliarisi; eri fu geri Arabaarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.10"
              },
              "items": [
                {
                  "text": "Yos 5:10",
                  "type": "text"
                }
              ]
            },
            {
