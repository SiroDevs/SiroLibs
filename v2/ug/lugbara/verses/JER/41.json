        },
        {
          "text": "Te Yohanani Karea mvi, ’ba amboru asikari ongulumuru ma dri cepi ovupi eri be ’diyi be, ka e’yo onzi Isimaeli Netania mvini ’yele ’bori ma e’yo eri dria ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
