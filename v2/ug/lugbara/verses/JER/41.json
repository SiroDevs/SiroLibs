                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Isimaeli Netania mvi apa Yohanani vurisi, ’ba aro ’diyi be tuale, yi mu Amoni anziyi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
