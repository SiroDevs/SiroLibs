              },
              "items": [
                {
                  "text": "Rum 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isimaeli ofu vini indi ’ba Yahudini ovupi eri be ’diyi dria, adaru ’ba ovupi Gedalia be Mizipaa, ofu vini ’ba ombaru Kalideyaa ’diyi yini isule ’dale ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini o’du iri erini Gedaliani fuzu ’boria, ’bani nga; e’yoni nizu kuria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
