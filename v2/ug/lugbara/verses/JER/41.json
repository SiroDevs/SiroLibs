              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.13"
              },
              "items": [
                {
                  "text": "2 Sam 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi nga ’ba ’du dria, nga mu omba ’bazu Isimaeli Netania mvi be, yi nga eri isu yi amboru Gibeoniari ma tia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, ’ba dria ovupi Isimaeli be ’diyi ka Yohanani Karea mvini ndre ra, ’ba asikari ma drilia ovupi eri be ’diyi be, yi nga di ovu ayikosi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        }
      ]
