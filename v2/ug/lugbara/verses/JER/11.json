            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi eri e’yo ’yoza aziza ’dorini ’diyi, te emi ma ’yo e’yo ’ba Yudaa ’diyi pi ma tia ’ba ovupi Yerusalemua ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
