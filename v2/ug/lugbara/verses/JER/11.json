              "items": [
                {
                  "text": "Gal 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ’yo yi tia kini, Yehova Mungu Israeliniri ’yo ’dini: ’Ba aziza ’diri ma e’yo eripi kuri ma ovu trizaru; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
