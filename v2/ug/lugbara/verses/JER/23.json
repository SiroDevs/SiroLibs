              "items": [
                {
                  "text": "1 Kor 1:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du erinisi Yudani nga ovu pazaru azini Israelini nga adri e’yo ’yaasi. Ru erini yini eri omvezuri ’di: Yehova onyi amaniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi, emi ndre, o’duni nga emu ra, Yehova ’yo ra, o’du ndesi yi ngani ’yo, Ekile Yehova anzi Israelini ofupi angu Misiriasirini ovule idri­rurile, ’dini ku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.7",
            "verseOrgIds": [
              "JER.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
