          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.5"
              },
              "items": [
                {
                  "text": "Isa 43:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te, Ekile Yehova ori’ba Israelini ma anzi ofupi yi dri cepi angu andraleruriasi, azini angu dria mani yi drozuriasirini ovule idrirurile. Te yi nga adri yi vile angua.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        }
