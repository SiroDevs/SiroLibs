              "items": [
                {
                  "text": "Kal 32:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo Moabu ma e’yosi. Yehova asikari ongulumuruni Mungu Israeliniri ’yo ’dini: Candi Nebo dri, erini ovule ezazarurisi Kiriataimu isu drinza, ’du eri ’bo; Misigabu isu drinza, anzu eri va ’bo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.11",
            "verseOrgIds": [
              "JER.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi, mi ndre, o’duni nga emu ra, Yehova, ’yo ra, o’du ndesi ma nga ’ba tini elapi ’diyi ma ti pe eri vu, yi nga eri ma ti ela ra, yi nga obi erini ’diyi ma ale osu ku pirini, yi nga kerea erini ’diyi oco nyingiriki ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.12",
            "verseOrgIds": [
              "JER.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.24"
              },
              "items": [
                {
                  "text": "Lip 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
