            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.4+ISA.15.5+ISA.15.6"
              },
              "items": [
                {
                  "text": "Isa 15:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engazu awu Hesiboniarisi kpe­re Elealea, kpere Yahazia indi, yi ma o’duko efu; engazu Zoariasi kpere Horonaimua, cazu kpere ­selisiyaa, yi Nimirimuarini ngale ojale tokorurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.34",
            "verseOrgIds": [
              "JER.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Isa 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ’yo ra, ma nga vini ’ba edeta edepi pari uruleruari pi fe dezu Moabua, ’ba obiese vepi adrou erini ’diyi driri be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 48:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
