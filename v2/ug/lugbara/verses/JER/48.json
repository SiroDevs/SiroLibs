                "loc": "1KI.12.29"
              },
              "items": [
                {
                  "text": "1 Opi 12:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.5"
              },
              "items": [
                {
                  "text": "Amo 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moabuni nga ovu ani dri­nzasi Kemosi ma e’yosi, ekile suru Israelinini ndra ovule drinzasi Beteli asi teza yiniri ma e’yosirile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.13",
            "verseOrgIds": [
              "JER.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.20",
            "verseOrgIds": [
              "JER.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo liza eca angu senderu ma dria ’bo, Holoni pi ma dria, Yaaza pie, Mefaati pie, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.21",
            "verseOrgIds": [
              "JER.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diboni pi ma dria, Nebo pie, Beti-dibilataimu pie, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.22",
            "verseOrgIds": [
              "JER.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriataimu pi ma dria, Beti­gamuli pie, Beti-meoni pie ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.23",
            "verseOrgIds": [
              "JER.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.2"
              },
              "items": [
                {
                  "text": "Amo 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kerioti pi ma dria, Bozira pie, aku ambo, ambo angu Moabua ’diyi, kani ziri kani ogogo ’diyi pie dria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.24",
            "verseOrgIds": [
              "JER.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Li o’yu Moabuni ’bo, nyo eri ma wu ra, Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.15"
              },
              "items": [
                {
                  "text": "Yer 25:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi fe eri ma ati ati ewasi, a’disiku eri enga i afuru Yehova ma ruaa; Moabuni nga i ogu ogbe ini ma alia, ’ba yi nga eri ’ba onzoaru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.26",
            "verseOrgIds": [
              "JER.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.17"
              },
              "items": [
                {
                  "text": "O’be 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.8"
              },
              "items": [
                {
                  "text": "Zef 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.26"
              },
              "items": [
                {
                  "text": "Yer 2:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi onzoni ndra Israelini ku ya?Isu eri ’ba oguouru ’diyi ma eselia ya? A’disiku etuzu mini e’yo erini ’yoria, mi dri oya oya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.27",
            "verseOrgIds": [
              "JER.48.27"
            ]
          }
        }
      ]
    },
