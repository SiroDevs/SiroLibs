                  "text": "Yer 21:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.2"
              },
              "items": [
                {
                  "text": "38:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi e’yo ambo ambo nda mi ngulupini ya? Mi nda yi ku; a’disiku, mi ne, ma nga e’yo onzi eji ’ba rua ari be ’diyi ma dria dria, Yehova ’yo ra; te ma nga idri mini fe mi dri afa pale ombaarile pari dria mini muzu alenia ’diyia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.5",
            "verseOrgIds": [
              "JER.45.5"
            ]
