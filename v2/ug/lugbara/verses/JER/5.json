              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te o’du nde ’dayisi ti, ma ngani emi de teketeke ku, Yehova ’yoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, emi ka ’yo ra, Yehova Mungu amaniri ’ye e’yo ’diyi dria ama vu a’di e’yosi ya? mi nga ani e’yoni omvi yi tia ’dini, kini, Ekile emini ma kule ra, Mungu andini inzile angu emi vileri ma aliarile, ’dinile indi emi nga azi nga suru andini dri angu ovupi emini kuri ma alia ra,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.19",
            "verseOrgIds": [
              "JER.5.19"
            ]
          }
        }
