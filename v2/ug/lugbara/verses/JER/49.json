                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.2"
              },
              "items": [
                {
                  "text": "Dan 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuru­niri ’yo ’dini: Emi ndre, ma nga osu Elamuni nyo ra, okpo yini ovupi; okpo yiniru agapiri’i; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma nga oli su engapi ’bu ma kala suria ’diyi eji Elamu ma dria, azini ma nga yi ere oli su ’diyi vusi dria; suru azini ’ba drole Elamuarisi ’diyini ngale cale vunia kuni yo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.2"
              },
              "items": [
                {
                  "text": "Yer 48:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga fe ’ba Elamuni nga ovu urisi ari’ba yini ma drilia, ’ba ndapi yi fupi ’diyi ma drilia indi; ma nga e’yo onzi eli yi ma ruaa, adani adra mani okporuri’i, Yehova ’yo ra. Te ma nga sei ma ti pe yi ma vutisi de nga ma jani yi ma dri teketeke ku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.10"
              },
              "items": [
                {
                  "text": "Yer 43:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Dan 7:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga oguna mani ’ba Elamua, ma nga vini opi piyi ma dri ja aleniarisi ’ba opiru ’diyi be, Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini o’du vilerisi, ma nga ’ba Elamua bile ati’baru ’diyi omvi vile dika, Yehova ’yo ra.",
          "type": "text",
          "attrs": {
