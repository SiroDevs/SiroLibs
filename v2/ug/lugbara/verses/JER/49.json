                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo Yehovani ecapi nabi: Yeremia vu, e’yo Elamunisi, o’du Zedekia opi Yudaarini e’dozu opi nyazurisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
