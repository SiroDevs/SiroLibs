                  "text": "Amo 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile yini Sodoma pi ogule va Gomora be, aku amboru ovupi yi ma ageia ’diyi pierile, Yehova ’yo ra, ’ba azini ngani oro ’dale ku, ’ba ma ori aluni ngani la ’dale ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
