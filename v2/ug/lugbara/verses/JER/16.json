                "loc": "ISA.22.12"
              },
              "items": [
                {
                  "text": "Isa 22:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’wara ’diyi pi nga odra angu ’doria ’ba nyiri ’diyi be; ’ba ngani yi sa ’bilia ku, ngani vini yi owu ku, ngani yi ma rua li, kani yi ma dri’bi fa yi ma e’yosi ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
