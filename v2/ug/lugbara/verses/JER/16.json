                "loc": "PRO.3.6"
              },
              "items": [
                {
                  "text": "O’be 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ngani vini ta awa dra ma tia ku, asi yini omizu ’ba drapi ’bori ma e’yosi; yi ngani vini okelea asi anzuruniri fe yi dri ku mvuzu ata yini ma e’yosi kani andri yini ma e’yosi ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini mi ma fi jo omunia rizu yi pie, nyaka nyazu azini afa mvuzu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
