                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te emi’i, emi ’ye e’yo onzi aga emi a’bipiniri ra; a’disiku, emi ne, emi dria alu alu ad ambo asi onzi eminirini vusi, ’dini emi erini ma ku; ",
          "type": "text",
          "attrs": {
