          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "te Yehova ’yo ’dini opi ripi oguna Daudiniri ma driari ma e’yosi, azini ’ba dria ovupi aku ambo ’dori ma alia, emi adripiru fupi mupi ati’baru emi be ku ’diyi ma e’yosi indi: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
