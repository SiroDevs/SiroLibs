                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Sur 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waraga nabi Yeremiani tini pele engazu Yerusalemua ’ba ’wara ’bani jile ati’baru acepi;olokoru ’diyi pi vuri ma e’yo eri ’di; pe tini ’ba edeta edepi ’diyi pi vu indi ’ba nabiru ’diyi pie, ’ba Nebukadi­nezani jile ati’baru engazu Yerusa­lemuasi cazu Babulonia ’diyi Pie dria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "opi Yekonia pi ka nga Yerusalemuasi andri pie, ’ba ranyaru ’diyi pie, opianzi Yudaa ’diyi pie ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe waraga nderi ma ti Elasa Safani mvi pi ma dria Gemaria Hilikia mvi be, yi ’ba Zedekia opi Yudaarini ti pele Babulonia Nebukadineza vu ’diyi. Waraga kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova asi­kari ongulumuruni Mungu Israeliniri ’yo ’dini, ’ba dria mani fele obile ati’baru engazu Yerusalemuasi cazu Babulonia ’diyi ma tia: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi si jo emi dri, emi la yi ma alia; emi ma ’ya amvu, emi nya afa kapi aleniari beni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi je oku emi dri, emi oti agupianzi ezoanzi be; emi ma je oku agupia emini ma mu agupia yi ma oti agupianzi ezoanzi be; emi ma ezu di ’dale tre beni, emi ma anu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
