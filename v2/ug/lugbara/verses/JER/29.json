                "loc": "JER.14.14"
              },
              "items": [
                {
                  "text": "Yer 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.21"
