            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.6"
              },
              "items": [
                {
                  "text": "Efe 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruni Mungu Israe­liniri ’yo ’dini: Emi ku nabi emini ovupi emi eselia ’diyi pi ma ici emi ku, ’ba emini acife ndripi ’diyi be, emi ma eri vini orobi emini, emini fele ma obi emi ’diyi ku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yini e’yo inzoru ondrile emi tia ma rusirisi; ma peni yi ma ti ma’i ku, Yehova ’yoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
