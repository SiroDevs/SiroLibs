                "loc": "1TI.2.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ma nda aku amboru mani emi fele jizu alenia ati’baruri ma asi anzu, emi zi Yehova tia eri dri indi, a’disiku asi anzuru erini ma alia emi nga ovu asi anzu be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
