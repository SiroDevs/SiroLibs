          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.3"
              },
              "items": [
                {
                  "text": "Dan 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi nga ma omve, emi nga mu e’yo zi ma tia, te ma nga emi eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
