        },
        {
          "text": "A’disiku emi ’yo kini, Yehova fe nabi efu amani Babulonia ’bo,- ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
