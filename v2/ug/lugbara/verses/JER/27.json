        },
        {
          "text": "Te curu’do ma fe angu ’diyi dria Nebukadineza opi Babulonia ati’bo maniri ma dria, ma fe vini anyapa asea ’diyi azi ngazu eri dri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
