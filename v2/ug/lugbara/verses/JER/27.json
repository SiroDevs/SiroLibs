                  "text": "Efe 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi, emi ma eri nabi emini ku, kani ’ba emini acife ndripi ’diyi ku, kani orobi emini ku, kani ’ba emini ojouru ’diyi ku, kani ’ba oleru ’diyi ku, ’ba nde ’yopi emi tia, Emi ngani azi nga opi Babulo­niari dri ku, ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku yi olu emi tia inzo, ’dini emi ofuzu emi vile anguasi re ani, mani emi drozu amve emi dri jazu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te suru ngapi yi ma ombe ’bapi opi Babu­loniari ma kulumbu alia, azi ngapi eri driri, ma nga suru nderi ku ovuzu yi vile angua ra, yi nga angu nde ’ya ra, yi nga ovu alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.28.1"
              },
              "items": [
                {
                  "text": "Yer 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.17"
              },
              "items": [
                {
                  "text": "38:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga di ’yo Zedekia opi Yudaari ma tia e’yo ’diyi vusi dria, kini: Emi ’ba emi ombe kulumbu opi Babuloniarini ma alia, emi ma nga azi eri dri ’ba erini ’diyi be, emi ma ovu idriru ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.8.36"
              },
              "items": [
                {
                  "text": "O’be 8:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.31"
              },
              "items": [
                {
                  "text": "Eze 18:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi le dra sei pisi, liki pie, azo muani pie a’disi ya, mi’i, ’ba mini’diyi be, ekile Yehovani ’yole suru lepi azi ngapi opi Babu­loniari dri kuri ma e’yosirile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.14"
              },
              "items": [
                {
                  "text": "Yer 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.21"
              },
              "items": [
                {
                  "text": "23:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma eri nabi e’yo ’yopi emi tia kini, Emi ngani azi nga opi Babuloniari dri ku, ’diyi ma e’yo ku, te yi emi tia inzo olu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’di­siku ma peni yi ma ti ma’i ku, Yehova ’yo ra, te yi e’yo inzoru ondri ma rusi, ma ma dro emi amve emi ma ja dri ra beni, emi’i, nabi e’yo ondripi emi tia ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
