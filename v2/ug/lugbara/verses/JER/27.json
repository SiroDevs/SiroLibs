                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.26"
              },
              "items": [
                {
                  "text": "Dan 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.12"
              },
              "items": [
                {
                  "text": "Yer 25:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.27"
              },
              "items": [
                {
                  "text": "50:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suru dria nga azi nga eri dri, mvi erini pie, mvi erini ma mva pie, de nga angu erini ma ewu ecani ku; ka eca ra, suru kakau opi amboru ’diyi be nga eri ’ba ati’bo yiniru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, suru azini kani opi nyaza azini ka le azi nga Nebukadineza opi Babuloniari dri ku, ka le yi ma ombe ’ba opi Babu­loniari ma kulumbu alia ku, Yehova ’yo ra kini, ma nga suru nde ’diyi co seisi, azini abirisi, azini azo muanisi, de nga ma jani yi ma dri teketeke eri ma drisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
