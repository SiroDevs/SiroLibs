                "loc": "2TH.2.10+2TH.2.11+2TH.2.12"
              },
              "items": [
                {
                  "text": "2 Tes 2:10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Yeremia ka de e’yo Yehova Mungu yinini oluzu ’ba dria ma tia ’bo, e’yo nde Yehova Mungu yinini eri ti pezu yi vu oluzu ani ’diyi, eri dria e’yo ’diyi’i, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.1",
            "verseOrgIds": [
              "JER.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria Hosaya mvi pi Yohanani Karea mvi pie, ’ba afuru ’diyi pie dria nga ’yo Yeremia tia kini, Mi inzo li. Yehova Mungu amaniri peni mi ti ’yozu, Emi ma mu Misiria ovuzu ani’baru ’dale ku, ’dinini ku; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.2",
            "verseOrgIds": [
              "JER.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "te Baruki Neria mvi osu mi bile ama nguzuni, eri ma fe ama ’ba Kalideyaa ’diyi ma dria, yi ma fu ama ani, azini yi ma ji ama ati’baru Babulonia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.3",
            "verseOrgIds": [
              "JER.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Yoha­nani Karea mvi pi, ’ba dria asikari ma drilia ’diyi pie, ’ba nde ’diyi pie dria, inzini Yehova ma o’duko ku yini adrizu angu Yudani ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.11"
              },
              "items": [
                {
                  "text": "Yer 40:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yohanani Karea mvi pi ’ba dria asikari ma drilia ’diyi be nga ’ba Yudani acepi jolokoru emvipi engazu suru dria ’bani yi drozu ’bo ’diyiarisi dini yi ma ovu angu Yudania ani ’diyi o’du ra- ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.10"
              },
              "items": [
                {
                  "text": "Yer 39:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "agupi piyi, oku pie, anzi pie, opi amboru ma ezopi pie, ’ba dria Nebuzaradani asikari opi agei tepi ’diyi ma dri cepirini kule Gedalia Ahikamu Safani mvi ma mvi vu ’diyi pie; o’du vini nabi Yeremia pi, Baruki Neria mvi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.6",
            "verseOrgIds": [
              "JER.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.16"
              },
              "items": [
                {
                  "text": "Yer 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.1"
              },
              "items": [
                {
                  "text": "44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di fi angu Misiria, a’disiku yi inzini Yehova ma o’duko ku. Te yi nga ca kpere Tapanihesia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani nga di eca Yeremia vu Tapanihesia kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.8",
            "verseOrgIds": [
              "JER.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ’du oni ambo ambo mi dria, mi ozi yi ’ba Yudaa ’diyi ma milia odri biriki ma talaari ma alia, pari yini fizu Farau vile jo Tapanihesiaria,o’dale, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.9",
            "verseOrgIds": [
              "JER.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.21"
              },
              "items": [
                {
                  "text": "Dan 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.9"
              },
              "items": [
                {
                  "text": "Yer 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.18+EZK.29.19+EZK.29.20"
              },
              "items": [
                {
                  "text": "Eze 29:18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te mi ’yo yi tia, Yehova asikari ongulumuruni Mungu Israe­liniri ’yo ’dini: Emi ne, ma nga ’ba ti pe ati’bo mani Nebukadreza opi Babuloniari ejizu, ma nga oguna erini ’ba oni mani ozile ’diyi ma dria, eri nga hema erini opiniri aso yi ma ndria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.13"
              },
              "items": [
                {
                  "text": "Yer 44:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.11.9"
              },
              "items": [
                {
                  "text": "Zek 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga emu, nga angu Misirini co ra; drani ’diyi nga odra drasi ra, ovupi ati’baru ’diyi nga ovu ati’baru, seini ’diyi nga odra seisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.12"
              },
              "items": [
                {
                  "text": "Efu 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.1"
              },
              "items": [
                {
                  "text": "Isa 19:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.25"
              },
              "items": [
                {
                  "text": "Yer 46:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga aci edu adrou Misiria ’diyi ma joa; eri nga yi eve ra, nga yi ji ati’baru indi; eri nga i ngulupi su angu Misirinisi ekile ’ba kabilo ocepirini i ma bongo sulerile; eri nga fu aleniasi asi anzuru be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga vini pati i’diza inzile inzi Beti­semesi ovupi angu Misiriaria ’diyi onyo mi eri nga adrou Misiria ’diyi ma jo eve acisi ra.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
            "verseOrgIds": [
              "JER.43.13"
            ]
          }
        }
      ]
