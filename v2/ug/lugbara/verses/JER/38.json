                  "text": "1 Sam 31:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi amboro Zedekia nga di ’yo Yeremia tia kini, Ma ru ’ba Yahudini apapi ra fipi ’ba Kalideyaa ’diyiniru ’diyi ra, yi kazu ma fezu yi ma dria ku,yi kazu ma ’bazu aparakaru ku, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        },
