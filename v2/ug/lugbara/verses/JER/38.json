                }
              ]
            }
          ]
        },
        {
          "text": "mi nga di ’yo yi tia, Ma ’ba matu opi vu eri ma omvi ma Yonatani vile joa ku, ma kazu drazu ’dasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
        {
