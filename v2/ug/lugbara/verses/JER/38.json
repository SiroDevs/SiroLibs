                  "text": "Yer 32:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ka fi ’ba opiru opi Babu­loniani ma palaa ’diyiniru ku, yi nga aku amboru ’dori fe ’ba Kalideyaa ’diyi ma dria, yi nga eri ve acisi ra, te mi ngani apa yi ma dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        },
