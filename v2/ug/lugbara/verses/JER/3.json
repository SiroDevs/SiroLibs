        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehova ’yo ma tia kini, Israeli asipi vileri e’da i ovuzu onyiru aga Yuda lokiri beri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.22"
              },
              "items": [
                {
                  "text": "Isa 44:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.1"
              },
              "items": [
                {
                  "text": "Yer 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi mu, mi olu e’yo ’diyi angu andraleruri vu, ’yozu kini, Mi emvi, mi Israeli asipi vileri, Yehova ’yoni. Ma ngani lu mi vu adrasi ku, mani ovule yiki berisi, Yehova ’yoni; ma ngani ovu adrasi ’dani ku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
