                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e’yo yini nga anya ekile bele gbogboru­irile. Humenaya pi Fileto be ovu ’ba ’diyi ma eselia; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
