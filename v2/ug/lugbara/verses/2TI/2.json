                  "text": "Kol 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ma a’i candi ’diyi dria ’iasi tezasi ’ba Munguni opele ’diyi ma e’yosi, ’dini yi indi ma isu pata ovupi diza ’dani ’daniri be ovupi Kristo Yesu ma aliari. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
