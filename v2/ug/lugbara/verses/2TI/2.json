                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ma ku e’yo ’yoza toko toko inzita kokoru ’diyi la, te yi nga aga, tu e’yo ala tara kokoruri alia, ",
          "type": "text",
          "attrs": {
