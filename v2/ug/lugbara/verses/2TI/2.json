              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ma ga zita zile azazaru azini ondua kokoru ’diyi si, mini nile yi nga omba ejinirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
