              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ni e’yo ’ba dria ovupi Asiaa ’diyini ma kuzuri ra; Figelo pi ovu ’ba ’diyi ma eselia Heremogene be. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
