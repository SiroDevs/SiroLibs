              "items": [
                {
                  "text": "’Yeta 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ega a’ita lokiri kokoru ma e’yo ovupi mi alia, te ovupi ndra okorisi mi idi Loisi ma alia azini mi andri Eunike ma aliari, te ma ni adaru a’ita i nde ’diri ovu mi alia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
