                  "text": "Rum 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku Mungu feni ama dri orindi asi urioururini ku, te orindi asi okpo beri pini leta avasiri pie, asi e’yere­ruri pie.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
