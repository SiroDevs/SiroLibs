              "items": [
                {
                  "text": "1 Tim 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ’ba ma ovuzu ’ba e’yo nde bari olupiriru, azini ’ba ti peleriru, azini ’ba ’ba imbapiriru; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
