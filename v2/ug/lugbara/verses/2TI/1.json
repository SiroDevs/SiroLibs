            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma le mi ndre avasi, mani mindre mini ma e’yo egaria, ayiko ma ga ma asia tre ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        },
