              "items": [
                {
                  "text": "Tit 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi bi eceta e’yo ’yoza onyiru ’diyi ecepi, mini erile ma vuri ci, a’itasi azini leta avasi ovupi Kristo Yesu ma aliarisi; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
