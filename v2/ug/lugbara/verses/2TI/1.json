              "items": [
                {
                  "text": "1 Tim 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ma fe di egata mi dri, mi ma fe ani feta Munguni ovupi mi alia mani ndra ma dri ’bale mi driarisiri ma enga dizu acile dika; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
