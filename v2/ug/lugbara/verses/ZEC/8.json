        },
        {
          "text": "Yehova asikari ongulumuruniri ’yo ’dini: Eri ka ovu osutaru ’ba joloko acepi’diyi ma milia o’du ’dayisi ti, eri te nga ovu osutaru ma milia indi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "verse",
