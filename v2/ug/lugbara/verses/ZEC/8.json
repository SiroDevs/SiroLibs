          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruni ’yo ’dini: Eri nga kiri eca ’dini kini, suru azini ’diyi nga emu ra, azini ’ba ovupi aku ambo ambo kakau ma alia ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
              "ZEC.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
