              },
              "items": [
                {
                  "text": "Isa 65:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruniri ’yo ’dini ra: Mbaza yi nga adri dika oku dezaru ’diyi be gboko Yerusalemunia ’dale ra, ’ba dria alu alu lote ini be dria, deza ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini gboko aku amboru ndea ’diyi nga ga tre agupi­anzisi ezoanzi be, yini avita aviria gboko nde ’diyi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        },
