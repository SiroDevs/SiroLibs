            "number": "7",
            "style": "v",
            "sid": "ZEC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruni ’yo ’dini: Mi lu, ma nga ’ba mani opa engazu angu etuni efurialeruri piasi angu etuni ’derialeruri be; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
