              "items": [
                {
                  "text": "Isa 35:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruni ’yo ’dini: Nyaka ’daza mba susiri pi, nyaka ’daza mba towisiri pie, nyaka ’daza mba azirisiri pie, nyaka ’daza mba mudrisiri pie dria nga yi oja suru Yudani dri ayiko pi nyona pie, azini omu ayiko be turiru; e’yo ’disi emi ma le di e’yo ada pi e’yo asi anzururi be. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
