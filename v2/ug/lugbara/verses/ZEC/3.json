                "loc": "REV.19.8"
              },
              "items": [
                {
                  "text": "Eceza 19:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga e’yo omvi, nga ’yo ’ba pa sopi eri ma drilia ’diyi ma tia kini, Emi otru bongo ondiru ’diyi eri ruaarisi ra. ’Yo eri ma tia, Mi lu, ma wu onzi mini mi vurisi ’bo, ma nga mi osu bongo aje be tu ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
