              "items": [
                {
                  "text": "Mik 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruni kini, o’du nde ’dasi emi dria alu alu nga ’ba i vile jo ejeleari omve zabibu pati etia azini elio pati etia indi.",
          "type": "text",
          "attrs": {
