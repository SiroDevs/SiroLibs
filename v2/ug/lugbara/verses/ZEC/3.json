                "loc": "ISA.64.6"
              },
              "items": [
                {
                  "text": "Isa 64:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "De Yosua su i ruaa bongo ondiruri’i, so pa malaika ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
