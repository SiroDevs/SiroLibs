              "items": [
                {
                  "text": "Efu 29:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga ’yo ra, Yi ma su oku onyiruri eri ma dria indio ’Dini yi su oku onyi­ruri eri ma dria ra, su bongo eri ma ruaa indi; de malaika Yehovani so pa ageinia ogogo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
