            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.30"
              },
              "items": [
                {
                  "text": "Mat 24:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga orindi asi ndrizaniri pi osu matu ’bazaniri be, jo Daudiniri pi ma dria ’ba ovupi Yerusalemua ’diyi be; azini yi nga ma’i yini soleri ndre ra; yi nga owu erisi kile aguni i ma mva alu kodi­kodiri wulerile, azini yi nga ovu candisi erisi kile ’ba ovupi candisi i ma amurumva ma drasirile. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.37"
              },
              "items": [
                {
                  "text": "’Yeta 2:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.24"
              },
              "items": [
                {
                  "text": "2 Sur 35:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dasi awu amboruni nga ovu Yerusalemua kile awu Hadadri­monini e’bu Megidonini ma aliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu nde nga wu wu, ori’ba dria alu alu ndu ndu; ori’ba Daudini ’diyi ndu, oku yini ndu; ori’ba, Natanini ’diyi ndu, oku yini yi ndu indi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini ori’ba Levini ’diyi ndu, oku yini ndu; ori’ba ’ba Simeini ndu, oku yini yi ndu indi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ori’ba dria acepi ’diyi, ori’ba dria ndu ndu, oku yini pie ndu ndu indi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
