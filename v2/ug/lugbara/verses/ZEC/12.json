              "items": [
                {
                  "text": "1 Kor 1:27-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehovani nga hema Yudani pa oko, ’dini diza; Daudinirini, azini ’ba Yerusalemua ’diyini ma ovu ’bazaru ambo aga Yudaniri ra ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.10"
              },
              "items": [
                {
                  "text": "Yoe 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dasi Yehovani nga ’ba ovupi Yerusalemua ’diyi ari ra, azini ’ba ovupi okpo kokoru yi ma eselia o’du ’dasiri nga ovu kile Daudile, te; Daudiniri nga ovu kile Mungule, adani kile malaika Yehovanirile yi ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca o’du ’dasi ’dini, ma nga suru dria emupi a’di ’dipi Yerusalemu be ’diyi ma dri ja ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
