                "loc": "HEB.12.9"
              },
              "items": [
                {
                  "text": "Ebra 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo eceza Yehovani Israeli ma e’yosiri: Yehova ’bu ajapi, nyaku ma eti e’dopi, orineli ’bani ’bapi eri ma aliari ’yo ’dini: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi lu, ma nga Yerusalemuni ’ba okelea atizu ani paraparariru, ’ba dria ageinia kuru ’diyi ma dria; e’yo ’diri nga ovu Yuda ma dria indi o’du ari’bani Yerusalemuni acezu kururisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.2",
            "verseOrgIds": [
              "ZEC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.44"
              },
              "items": [
                {
                  "text": "Mat 21:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga emu eca o’du ’dasi ’dini, ma nga Yerusalemuni ’ba oni nzizaru teriru suru dria dri; ’ba dria teri ’diri ’dupi ’diyi nga ebi isu yi ma ruaa onzi tu. Te suru dria nyakua ’diyi nga yi oku tualu eri ma ruaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.3",
            "verseOrgIds": [
              "ZEC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.76.6"
              },
              "items": [
                {
                  "text": "Zab 76:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du nde ’dasi, Yehova ’yo ra, ma nga akanya dria oco osutasi, ma nga ’ba nzupi driniari fe aza ra. Te ma nga ma mile zi suru Yudani ma dria, ma nga akanya ’bani dria ma mile ofu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’wara Yudaa ’diyi nga ’yo yi ma asia, ’Ba ovupi Yerusalemua ’diyi ovu okpo mani, Yehova asikari ongulumuruni Mungu yiniri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi ma nga ’ba ’wara Yudaa ’diyi ’ba ekile ajikoa aciolu be eja ma etiarile, kile alaka aci ’izurini anyapati ombele tualu ’diyi ma ti ’balerile; yi nga ’ba dria ovupi ageiniasi kuru ’diyi ove ra, dri ndia azini dri ejia, te Yerusalemuni nga kiri ovu dika ma paria ’dani Yerusalemua.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        }
      ]
    },
    {
