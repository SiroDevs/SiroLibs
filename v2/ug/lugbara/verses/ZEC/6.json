                "loc": "JER.1.14"
              },
              "items": [
                {
                  "text": "Yer 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gari ombani akanya iniru ’diyi beri fu mu angu andra­leruria; emve ’diyi mu yi ma vutisi; te funyi funyiru ’diyi fu mu angu uruleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.6",
            "verseOrgIds": [
              "ZEC.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
