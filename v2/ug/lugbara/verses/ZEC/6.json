                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oku nde ’diyi nga ovu Helemu pi dri Tobiya Pie ’Yedaya pie, Heni Zefania mvi pie, fezu e’yo nde egazu hekalu Yehovani ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
