              },
              "items": [
                {
                  "text": "Ezr 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi a’i afa ’ba obile ati’baru ’diyi vu, yi Helidai pi, Tobiya pie, Yedaya pie, mi emu coti o’du ndesi, mi fi Yosia Zefania mvi vile joa, pari yini ecazu alenia engazu Babuloniasiri’i, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.10",
            "verseOrgIds": [
              "ZEC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
