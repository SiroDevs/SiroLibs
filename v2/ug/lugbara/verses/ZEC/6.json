                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gari ombani okori ma alia akanya ekaru ’diyi indi; gari iriri ma alia aka­nya iniru ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.2",
            "verseOrgIds": [
              "ZEC.6.2"
            ]
