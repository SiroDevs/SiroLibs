              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.17"
              },
              "items": [
                {
                  "text": "E’do 13:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eka ’diyi fu ra, nga o’hi muzu, ’dini yi ma ad ’dale ’dole nyaku ma eselia beni. Eri ’yo yi tia, Emi nga ’diarisi ra, emi ad ’dale ’dole nyaku ma eselia. Yi nga di aci ’dale ’dole nyaku ma eselia ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.7",
            "verseOrgIds": [
              "ZEC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
