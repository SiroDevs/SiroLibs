                {
                  "text": "Eceza 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "gari nari ma alia akanya emveru ’diyi; gari suri ma alia akanya funyi funyi okporu ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.3",
            "verseOrgIds": [
              "ZEC.6.3"
            ]
