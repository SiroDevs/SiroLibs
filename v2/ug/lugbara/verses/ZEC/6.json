              "items": [
                {
                  "text": "Ekl 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini eri wu ma vu, ’yo ma tia kini, Mi lu, ’ba mupi angu andra­leruria ’diyi fe ma orindini ovuzu ndi angu andraleruria ’bo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.8",
            "verseOrgIds": [
              "ZEC.6.8"
            ]
