              },
              "items": [
                {
                  "text": "Zab 46:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.20"
              },
              "items": [
                {
                  "text": "Hab 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.19"
              },
              "items": [
                {
                  "text": "Rum 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ’ba rua be ’diyi dria, emi; adri ciri Yehova ma milia; erini engale uru angu ini alatararuri ma alia ’borisi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
