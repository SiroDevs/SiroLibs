              "items": [
                {
                  "text": "Efu 12:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.33"
              },
              "items": [
                {
                  "text": "Eze 33:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suru kakau nga yi eci Yehova vu o’du nde ’dasi, yi nga ovu suru mani; ma nga adri mi eselia, te mi nga ni ani kini Yehova asikari ongulumuruni epe ma ti mi vuni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.9"
              },
              "items": [
                {
                  "text": "Azi 32:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehovani nga Yudani ’du i ma yilaru angu ala­tararu ma alia, te eri nga kiri ’ Yerusalemuni pe ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
