                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo liza ovu yiki kokoru ’ba yiki ’bapi kuri ma dria; yikini i enya ayikosi erini e’yo liza ndelerisi,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.13",
