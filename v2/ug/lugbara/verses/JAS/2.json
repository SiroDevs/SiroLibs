              "items": [
                {
                  "text": "1 Kor 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma adripi, a’ita emini Yesu Kristo Opi amani dizaniri a’izuri ma alia, emi ma ope ’ba ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.1",
            "verseOrgIds": [
              "JAS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
