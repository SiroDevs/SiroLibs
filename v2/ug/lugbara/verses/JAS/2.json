                {
                  "text": "21:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma adripi la, orodrini ngoni ya, ’ba ka ’yo i ovu a’ita be, te ’yeta erini yo? A’ita ’diri eco eri pazaru ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.14",
            "verseOrgIds": [
              "JAS.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adripi kani amvipi ka ovu pililiru, ka ovu nyaka kokoru o’du dria, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.15",
            "verseOrgIds": [
              "JAS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.17"
              },
              "items": [
                {
                  "text": "1 Yoh 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’ba azini emi eseliari ka ’yo yi tia, Emi mu asi anzuru be, emi mu ad yu, emi tra nyakasi indi; te emi ka afa yini ndale yi ma rua ma aza kozuri fe ku, orodrini ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.16",
            "verseOrgIds": [
              "JAS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa’dini a’ita ovu ’dinile: ka ovu a’dule ’yeta kokoru, eri ovu idri kokoru.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.17",
            "verseOrgIds": [
              "JAS.2.17"
            ]
          }
        }
      ]
    },
