              ]
            }
          ]
        },
        {
          "text": "Mi a’i kini Mungu eri alu; mi ’ye onyiru, Te orindi onzi yi a’i ale indi-yi rua ya ya ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.19",
