              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ’yopi, Mi ’ba ali kuri, eri ’yo vini indi, Mi ’di ’ba ku. Mi ka ali ’ba ku ti, te ka ’ba ’di ra, mi ofu ovuzu ’ba azita ezapiriru, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.11",
            "verseOrgIds": [
              "JAS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
