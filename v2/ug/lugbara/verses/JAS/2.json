                "loc": "DEU.1.17"
              },
              "items": [
                {
                  "text": "Azi 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ka ’ba ope, emi ’ye onzi, azini azita nderi nde emi, emini e’yoni ezale rarisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.9",
            "verseOrgIds": [
              "JAS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
