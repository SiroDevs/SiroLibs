              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ’ba ondtra kokoruri la, mi leni ni kini a’ita ’yeta kokoruri ovu toko, ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.20",
