                "loc": "MAT.5.19"
              },
              "items": [
                {
                  "text": "Mat 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba azini ka azita inzi dria ra, te ka mu eza e’yo alosi, eri eca ovuzu ’ba azita dria ezapiniru, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.10",
            "verseOrgIds": [
              "JAS.2.10"
            ]
