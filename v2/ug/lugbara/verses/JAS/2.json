                "loc": "JAS.1.25"
              },
              "items": [
                {
                  "text": "Yak 1:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ’yo azini emi ma ’ye ekile ’ba yini ngale yi ma e’yo lile azita trotaniri vosi ’diyile. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.12",
            "verseOrgIds": [
              "JAS.2.12"
            ]
          }
        },
