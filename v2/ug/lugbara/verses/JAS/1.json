              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ka ovu ’ba e’yo eripi bilesi toko ’yepi kuriru, eri ovu ekile ’ba i ma ngulupi ma mileti ndrepi mandara ma aliarile; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
