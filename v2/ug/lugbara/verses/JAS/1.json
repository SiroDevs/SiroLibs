            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba azini emi eselia ka ece onduasi ra, eri ma zi Mungu afa fepi ’ba dria dri avasi, egapi ’ba dria kuri ma tia, eri nga ovu fezaro eri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
