            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.24"
              },
              "items": [
                {
                  "text": "1 Pet 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini ’ba afa e’iruri ma ovu vini ayiko be yini eri ’bale valerisi, erini ngale lule va ekile ase fulerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te etuni adri efu oli aciru be, eri fe aseni onyu onyu; funi nga lu va, wura ndriza erini nga avi ra. ’Dinile alu indi ’ba afa e’iruri nga dri ja acita erini ma alia ra.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
            ]
          }
        }
