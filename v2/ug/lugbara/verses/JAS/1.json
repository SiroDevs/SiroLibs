        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mar 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ma zi a’itasi, abaza kokoru, te ’ba asisile abaza beri si ekile yi mbuza mirini olini drole azini adile ’dale’dolerile. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agu nderi ma ega, i asia kini i nga afa azini isu Opi dri, ’dini ku; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.7",
            "verseOrgIds": [
              "JAS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ’ba asi iri be, oyapi oya geri ini ma aliasi driari’i.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
            "verseOrgIds": [
              "JAS.1.8"
            ]
          }
        }
      ]
