                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka ovu obeta ndu ndu ma alia, ma adripi, e’yo ’diri ma ovu emi dri ayikoru, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
              "JAS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
