              "attrs": {
                "loc": "1PE.1.7"
              },
              "items": [
                {
                  "text": "1 Pet 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emini niria o’biza a’ita emini o’bizuri eri asi teza eji. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ku asi teza ma de azi ini dri fuzu ’yeke, emi ma ovu ani fudri ci afa dria be ’yeke, emini ani ecezu e’yo alunisi ku.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        }
      ]
