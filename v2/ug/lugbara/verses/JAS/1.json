            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te adripi valeruri ma ovu ayiko be yini eri ’bale ururisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        },
