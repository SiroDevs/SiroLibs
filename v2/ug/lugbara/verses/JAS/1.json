                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba pa sopi obeta ma alia ci asi tezasiri eri drilebaru, a’disiku eri ka nga o’bita eri o’bizuri aga ’bo, eri nga ekilaza idrini Opini ndra azile ’ba eri lepi ’diyi driri isu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.12",
            "verseOrgIds": [
              "JAS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ovupi obezaruri ma ’yo kini, Mungu obe mani, ’dini aluni ku; te ’ba econi Mungu obezaru e’yo onzisi ku, Mungu obeni vini ’ba ku indi; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.13",
            "verseOrgIds": [
              "JAS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.7.7+ROM.7.8+ROM.7.9+ROM.7.10"
              },
              "items": [
                {
                  "text": "Rum 7:7-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’ba alu alu ovu obezaru li erinini eri sele jile bileni ewilerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.14",
            "verseOrgIds": [
              "JAS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia, li ka mva isu i alia ’bo, eri ti ezatani; te ezata nde ka mba ra, eri osi dratani.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.15",
            "verseOrgIds": [
              "JAS.1.15"
            ]
          }
        }
      ]
