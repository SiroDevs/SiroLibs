            }
          ]
        },
        {
          "text": "Se­keli ma ovu sente omvele gerari be kali iri; silingi omvele maneruri emini ma ovu sekeli kali iri, kali iri drini towi, mudri drini towi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
