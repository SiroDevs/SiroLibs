              "items": [
                {
                  "text": "Lev 19:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa nziza o’bizu emini ’diyi ma ovu kililiru, afazu abakaru ma ovu kilili, obi ma ovu kilili indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
