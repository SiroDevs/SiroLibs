            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa feza emini ngale feleri eri ’di’i: afazu abakaru ma esele azia ’diyi ma azi alu emi ma fe ero nga­nuni vusi, azini afazu abakaru ma esele azia ’diyi ma azi alu emi ma fe ero onduni vusi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
