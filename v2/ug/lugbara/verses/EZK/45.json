              "items": [
                {
                  "text": "48:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te esele opi driri nga ovu afa feza alatararuri azini aku nde vile angu ma kala aluria azini kala azinia, afa feza alatararori ma drilia aku nde ma angu ma drilia indi, woko etuni ’derialeru eri etuni ’derialeru, woko etuni efurialeru eri etuni efurialeru, oconi ovu esele alu ma oco vusi engazu kalati etuni ’derialeruriasi cazu kpere kalati etuni efuzurialeruria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
