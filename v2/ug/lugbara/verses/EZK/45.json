            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa­zu abakaru obi be ma ovu afa o’biza be alu, obi nde ma eco ero ma esele mudri ’diyi ma ji alurisi, afazu abakaru ma eco ero ma esele mudri ’diyi ma azi alurisi indi; o’biza erini ma ovu ero ma o’biza vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
