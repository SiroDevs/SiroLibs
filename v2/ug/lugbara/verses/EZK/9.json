          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba acepi ’diyi ma tia de mani eriria, eri ’yo ’dini, Emi aga aku ma alesi eri ma vutia, emi co; emi mile ma ku ku, emi ma ovu yikisi ku indi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.5",
            "verseOrgIds": [
              "EZK.9.5"
            ]
          }
        },
