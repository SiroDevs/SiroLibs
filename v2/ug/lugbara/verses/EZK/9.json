              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo yi tia, Emi eza jo ma alatara, emi ga irii erini ’diyi ’ba ma avusi. Emi fu di. Yi nga di fu ra, yi nga ’ba o’di akua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.7",
            "verseOrgIds": [
              "EZK.9.7"
            ]
          }
