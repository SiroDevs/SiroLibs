              "items": [
                {
                  "text": "Azi 32:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma’i indi, ma mile ngani ku ku, ma ngani ovu yikisi ku, te ma nga geri yini omvi be yi ma ngulupi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
