                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du nde ’dasi ojio nga fu ma driliasi acizu oguru ma alia uri fezu ’ba Etiopiaa e’yo egapi ku ’diyi dri; asi otiza okporuni nga ovu yi ma dria, ekile o’du Misirinisirile; te mi ndre, eri emu ra!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
