        },
        {
          "text": "Te e’yo Yehovani nga eca ma vu, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.1",
            "verseOrgIds": [
              "EZK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvi bani, nu o’bi e’yo etiru, mi o’be e’yo o’beza suru Israelini ma tia; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.2",
            "verseOrgIds": [
              "EZK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
