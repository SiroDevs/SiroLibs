                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga vini yi rua osu kolibasi, rua yazani nga yi a’bu ci; ’ba dria ma mileni nga ovu drinzasi, ’ba dria ma dri yi nga ovu tuaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.18",
            "verseOrgIds": [
