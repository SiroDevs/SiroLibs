                "loc": "JER.6.7"
              },
              "items": [
                {
                  "text": "Yer 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.16.5"
              },
              "items": [
                {
                  "text": "16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Egana zo ’bo, ofu kali e’yo onziniriru ’bo; ’ba aluni yi ma eselia ngani ace ku, kani ongulumu yini, kani lonyi yini; ’ba aluni ngani ovu amboru yi ma drilia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.11",
            "verseOrgIds": [
              "EZK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewuni eca ’bo, o’duni ovu ogogo. ’Ba afa jepiri ma ovu ayikosi ku, ’ba afa ozipiri ma ovu vini candisi ku indi, a’disiku adra ovu ’ba erini ongulumuru ’diyi ma dria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.12",
            "verseOrgIds": [
              "EZK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku ’ba afa ozipiri ngani emvi afa ozileri vu ku, ka tro yi ovu idriru ti. A’disiku e’yo ndreza ’diri ovu ’ba ongulumuru yini dria ma e’yosi; ’ba aluni ngani emvi ku; te ’ba aluni ngani i ’ba okporu adriza ini onzikanyaru ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi vu guka ’bo, yi ’ba afa dria ngonde ’bo; te ’ba aluni funi omba ’bazu ku, a’disiku adra mani ovu ’ba ongulumuru yini ma dria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.14",
            "verseOrgIds": [
              "EZK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
