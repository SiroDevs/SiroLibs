                  "text": "Zab 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ede anziriku; anguni gale tre ezata yini ari ’bani adazu ’diyisi­risi, akuni gale tre eganasirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.23",
