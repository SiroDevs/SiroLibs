          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ndre, o’duni Mi ndre, eri emu emu! Dra mini efu ’bo; kali zo fu ’bo, afu egbi ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.10",
            "verseOrgIds": [
              "EZK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
