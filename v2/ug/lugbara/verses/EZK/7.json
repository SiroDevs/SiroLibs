                "loc": "EZK.6.8"
              },
              "items": [
                {
                  "text": "Eze 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba apapi yi ma eselia ’diyi nga apa ovuzu oni dria uru, ekile a’balau e’bua ’diyile, yi dria alu alu nga owu e’yo onzi yinisi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
