              "items": [
                {
                  "text": "Azi 32:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amveleru semi, alialeru azo muani pi liki be; ’ba nyamukoa amveri nga dra seisini; ’ba ovupi aku amboru ma aliari nga dri ja liki pisi azo muani beni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.15",
            "verseOrgIds": [
              "EZK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
