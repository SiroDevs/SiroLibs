                "loc": "ISA.13.7"
              },
              "items": [
                {
                  "text": "Isa 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria ma drini nga aka aka, ’ba dria ma kumutini nga ca corokolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.17",
            "verseOrgIds": [
              "EZK.7.17"
            ]
          }
        },
