              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dri jazani emu emu; yi nga asi anzuru nda ra, te eri nga ovu yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.25",
