              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.8"
              },
              "items": [
                {
                  "text": "Eze 20:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga di ma adra osu mi dria cucuru’do, ma nga adra mani fe dezu mi ruaa, ma nga e’yo mini li geri mini vusi; ma nga e’yo ngule onzi mini ’yele ’diyi omvi mi ruaa be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.8",
            "verseOrgIds": [
              "EZK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mile ngani mi ku ku, ma ngani ovu yikisi ku; te ma nga e’yo eji mi ruaa geri mini vusi, e’yo ngule onzi mini ’yele ’diyi nga ovu mi alia. Emi nga ni kini Yeho­vani coni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.9",
            "verseOrgIds": [
              "EZK.7.9"
            ]
          }
        }
      ]
    },
    {
