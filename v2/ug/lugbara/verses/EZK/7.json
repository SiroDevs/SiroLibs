            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.23+EZK.12.24+EZK.12.25"
              },
              "items": [
                {
                  "text": "Eze 12:23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dra mini eca mi vu, mi ’ba ovupi angu ma aliari la! Ewu peleri eca ’bo, o’duni ogogo; eri o’du otre etani oni ma dria ururi’i, te ovuni otreta ayikoniri’i ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.7",
            "verseOrgIds": [
              "EZK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
