                  "text": "Zab 10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga di ’yo ma tia, Mvi ’bani la, mi ndre e’yo ’ba ’wara Israelinini ’yele angu inirua, yi alu aluni ’yele; yini wura inzile inzi ’diyi ma ta mbazuri ma aliari ra ya? Yini ’yole kini, Yehova ndreni ama ku, Yehova ku nyaku ’borisi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo vini ma tia indi, Mi nga afa ngule onzi ambo ambo yini ’yele ’diyi ma azi ndre dika indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di ma eji jo Yehovani ma kalitile kala andraleruriari vu; te mi ndre, oku yi ori ’dale yini Tamuzini owuria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo ma tia, Mi ndre e’yo ’diri ’bo ya, mvi ’bani la? Mi nga afa ngule onzi ’diyi ma azi agapi ra ’diyi ndre ra indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        },
