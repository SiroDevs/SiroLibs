              "items": [
                {
                  "text": "Kal 16:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’wara Israelini ma azi kali aziri ’diyi osopa yi drilia, ’ba ’diyi ma eselia agaduari Yaazania Sefani mvi’i. Yi dria alu alu ovu ajiko obiese vezu ’diyi be yi ma dria; obiese nde ma acika arikariruri nga nyi tu uru ’duu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.11",
            "verseOrgIds": [
              "EZK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
