              },
              "items": [
                {
                  "text": "Eze 21:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ezoanzi mini ofu seisi amvua; eri nga jo ombani si mi ageia, eri nga nyaku oku mi ageia, eri nga gombere ’du a’di ’dizu mi be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga afa erini abi osizu ’diyi ’ba abi mini ma ageia, eri nga jo izuru mini ’diyi oga ogarasi va. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanya erini yini ovule o’biru turisi, yi ma irifurani nga nga mi i ruaa; abi mini kaliru ’diyi nga oya oya ’ba nzupi akanyasi ’diyi pi ma ididisi, gari akanyani sele ’diyi pie, gari ombani ’diyi pie, eri ka fi kalitile minia ekile ’bani file aku abini olule huri ma aliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanya erini ma onyofini nga geri mini otu dria; eri nga ’ba mini ofu seisi; agofe mini okporu ’diyi nga o’de va nyakua ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga lonyi mini opa ra, yi nga afa oziza mini ’ba afa opale ombaa-ji rile; yi nga abi mini ’diyi ogu va, nga jo mini ayikoru ’diyi eza ra; yi nga oni mini piyi o’be yia, pari osiza mini pie, irifura mini be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
