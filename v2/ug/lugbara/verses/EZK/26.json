                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ovu pari ’bani emba ajazu miri ma eselia­ri’i; mani e’yo nde ’yolerisi, Opi Yehova ’yo ra; eri nga ovu afa opale ombariru suru ’diyi dri; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
