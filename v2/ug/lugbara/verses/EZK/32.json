                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvi ’bani, mi ngo awuongo Farau opi Misiria­risi, mi ’yo eri ma tia:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
