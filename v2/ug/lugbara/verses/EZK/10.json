                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Eze 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.5"
