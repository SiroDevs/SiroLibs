                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi ma lu ra, azini mi ndre, angu azini tokoru kerubi ma driari ma alia, afa azini e’da i yi ma drilia oni safirarule, ekile wura ogunani ma e’dazale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
