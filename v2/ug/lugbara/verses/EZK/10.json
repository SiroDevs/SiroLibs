                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Eceza 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi alu alu ovu andreti be su: andreti okori kerubi ma andretini, andreti iriri ’ba ma andre­tini, andreti nari kami ma andretini, andreti suri aji ma andretini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        }
      ]
