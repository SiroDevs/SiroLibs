          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvi ’bani la, mi ’yo Farau opi Misiriari pi ma tia ’ba ongulumuru erini ’diyi be, kini:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
