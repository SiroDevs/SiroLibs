            }
          ]
        },
        {
          "text": "Yi nga mi andri o’du kakau ma vutia; eli vile ’diyi ma alia mi nga fi angu omvile sei ma driasi, okule suru kakau ma eseliasiria, emuzu kpere oni Israelini ovupi andruru ’dani ’dani ’diyi ma dria; te yi ofu eri suru ma eseliasi ’bo, yi nga ovu ’dale e’yo ’yaasi, yi dria alu alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.8",
            "verseOrgIds": [
              "EZK.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.2"
              },
              "items": [
                {
                  "text": "Isa 28:2",
                  "type": "text"
                }
