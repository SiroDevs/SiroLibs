                  "text": "23:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma nga mi oja vile, ma nga ewia ’ba mi tilia, ma nga mi ofu amve asikari mini ongulu­muru ’diyi pie dria, akanya pie, ’ba nzupi akanyasi ’diyi be, yi dria su afa ombani esele ndu ndu dria yi ma ruaa, yi ’ba ongulumuru kakau gombere nyiri ’diyi pi osuzu amboru ’diyi be, yi dria alu alu ovu sei be dria; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.4",
            "verseOrgIds": [
              "EZK.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perisia pi Kusi pie Puti pie: ovu yi be, yi dria osu gombere pi biri be; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.5",
            "verseOrgIds": [
              "EZK.38.5"
            ]
          }
        },
