                "loc": "ISA.8.9"
              },
              "items": [
                {
                  "text": "Isa 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ede di mi ngonde, ada mi ede mi ngonde, mi’i ’ba ongulu­muru yi okupi mi be ’diyi be, mi ma ovu yi dri ’ba dri cepiriru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.7",
            "verseOrgIds": [
              "EZK.38.7"
            ]
          }
        },
        {
          "name": "verse",
