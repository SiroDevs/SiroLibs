              },
              "items": [
                {
                  "text": "Eze 27:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gomeri pi ’ba erini ongulu­muru ’diyi be dria; suru Togarimani ovupi kala andraleru kalati asizuriari pi ’ba erini ongulumuru ’diyi be dria; ada suru kakau ovu mi be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
