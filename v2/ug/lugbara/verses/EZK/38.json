        },
        {
          "text": "Mvi ’bani, mi ’ba mi mile okporu Gogi angu Magogia, opi Rosi pi ma drilia Meseki pie Tubali beri vuleru, mi ondri e’yo eri ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.2",
            "verseOrgIds": [
              "EZK.38.2"
            ]
          }
        },
