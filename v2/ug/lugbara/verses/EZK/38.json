          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ’yo, Opi Yehova ’yo ’dini: Mi ndre, ma mi dri aru, Gogi, opi Rosi pi ma drilia Meseki pie Tubali beri la; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.3",
            "verseOrgIds": [
              "EZK.38.3"
            ]
          }
        },
