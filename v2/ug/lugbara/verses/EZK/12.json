                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.8"
              },
              "items": [
                {
                  "text": "Eze 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga ’ba ku yi dri were, sei pini kule liki be, azo ’ muani pie ’diyi, yi ma olu afa ngule onzi yini ’yele ’diyi ma e’yo dria, suru yini ecazu yi vu ’diyi ma eselia ’dale; te yi nga ni ma Yehova’i.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
      ]
