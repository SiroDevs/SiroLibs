                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.18"
              },
              "items": [
                {
                  "text": "Mar 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvi ’bani, mi ovu suru lepi mbupi ma ruaarisi amveri ma eselia. ’Ba nde ma mile afa ndrezu ’diyi indi, te yi ndreni ku, yi ma bile e’yo erizu ’diyi indi, te yi erini ku; yini ovule suru lepi mbupi amveri’irisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.2",
            "verseOrgIds": [
              "EZK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi, Mvi ’bani la, mi ombe mi teri ’ba mupi angu andinia ’diyinirile, mi ma ombe afa ombeza nde etusi yi ma milia ayii; mi nga afa mini oli engazu pari miniarisi muzu yi be pari azinia yi ma milia ayii; kani yi nga e’yoni ega ra yani, ka tro yi suru lepi mbupi amveri’i ti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.3",
            "verseOrgIds": [
              "EZK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nga afa mini ofu joarisi amve yi ma milia etusi, ekile afa ’bani ngale jile angu azinia ’diyile; te mi ngulupini nga fu yi ma milia ondresi, ekile ’ba mupi ati’baru angu aziniarile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.4",
            "verseOrgIds": [
              "EZK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma alu jo ma abi yi ma milia, mi ofu afa nde amve geri ’dasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.5",
            "verseOrgIds": [
              "EZK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.18"
              },
              "items": [
                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.3"
              },
              "items": [
                {
                  "text": "Eze 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga afa nde o’du mi ombetia yi ma milia, mi nga eri ofu amve inisi; mi ma a’bu mi andreti ci, mi kazu nyaku ndrezu ku; a’disiku ma ’ba mi ecetaru suru Israelini dri ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga di ’ye erini azile ma tiarile. Ma ofu afa mani joarisi etusi ekile afa ’bani ngale jile angu azinia­rile, ondresi ma lu jo abi ma ngulupi ma drisi; ma ofu afa nde inisi, ma ’du eri ma ombetia yi ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani nga di eca ma vu i o’bitisi kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.19"
              },
              "items": [
                {
                  "text": "Eze 24:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvi ’bani, suru Israelini, suru nde lepi mbupi amve­ri ’yoni te mi tia, Mi a’di ’ye ya, ’dinini ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.9",
            "verseOrgIds": [
              "EZK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.1"
              },
              "items": [
                {
                  "text": "Mal 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo yi tia kini, Opi Yehova ’yo ’dini: E’yo eceza ’diri ece opi Yerusalemuari pi ma e’yo suru Israelini ovupi yi ma eseliari be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma ’yo, Ma leceta eminiru ma’i: yi nga fe yi ma ’ye mani ’yele ’borile; yi nga mu ati’baru angu azinia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.4"
              },
              "items": [
                {
                  "text": "Yer 39:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi yi ma eseliari nga afa ’du i ma ombetia inisi, eri nga fu ra; yi nga jo abi lu, afa e’duzu ani geri ’dasi; ’dini eri nga mile ini a’bu ci, erini ngale angu ndrele i milesi kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.12",
            "verseOrgIds": [
              "EZK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
