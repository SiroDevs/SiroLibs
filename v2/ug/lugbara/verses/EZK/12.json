        },
        {
          "text": "E’yo Yehovani eca vini ma vu dika, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
