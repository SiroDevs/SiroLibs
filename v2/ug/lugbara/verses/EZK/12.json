            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.9"
              },
              "items": [
                {
                  "text": "Isa 26:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga ni ma Yehova’i, ma ka nga yi awa suru ma eselia, ma ka nga yi ere angu ndu ndu ma eselia ’boria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
