              "type": "text"
            }
          ]
        },
        {
          "text": "Te suru joloko acepi ’diyi ma e’yo ’dini: engazu kala etuni efuria­leruria cazu kala etuni ’derialeruria, Benyaminini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benya­mini vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, Simeonini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeoni vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, Isaka­rini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
