            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isakari vile kala­tiri ma ageia engazu kala etuni efurialeruria cazu kala etuni ’de­rialeruria, Zebulunini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
