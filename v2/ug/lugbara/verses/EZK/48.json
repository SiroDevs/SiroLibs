              "items": [
                {
                  "text": "Isa 60:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.12"
              },
              "items": [
                {
                  "text": "Eceza 21:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aku amboru ma kalitile yi nga ovu suruti Israelini ma ru vusi, kala andraleruria kalitile na: kalitile Rubeni vileri alu, kalitile Yuda vileri alu, kalitile Levi vileri alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala etuni efurialeruria, ozu alifu su drini turu towi, kalitile vini na: adani kalitile Yusufu vileri alu, kalitile Benyamini vileri alu, kalitile Dani vileri alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala uruleruria, ozu o’bizaru alifu su drini turu towi, kalitile vini na: kalitile Simeoni vileri alu, kalitile Isakari vileri alu, kalitile Zebuluni vileri alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala etuni ’deriale­ruria, ozu alifu su drini turu towi, kalitile yini be na: kalitile Gadi vileri alu, kalitile Aseri vileri alu, kalitile Nafutali vileri alu. ",
          "type": "text",
          "attrs": {
