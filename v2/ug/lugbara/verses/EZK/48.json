                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Diri nga ovu ’ba edeta edepi o’bale nde alatararu Zadoki anzipiru, azi mani ma ta mbapi ’bo ’diyi dri; anzi Israelini ka ndra geri kura, ’ba ’diyi kuni ndra geri adari ’ba Levi­nini kulerile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga ovu yi ekifa fezale engazu angu fele afa fezaleri ma eselia; eri afa alatararu turi, eri ’ba Levini ma kalati ma ageia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba edeta edepi ’diyi maliari: kalati vusi, ’ba Levini nga ovu esele yini be, oconi alifu kali iri drini towi, walani alifu mudri. Oco driari alifu kali iri drini towi, walani alifu mudri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.29"
              },
              "items": [
                {
                  "text": "Efu 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.10"
              },
              "items": [
                {
                  "text": "Lev 27:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ma fe eri ozi ku, ma ale eri angu azinisi vini ku; angu ma efi kaza okori ma ovu fezaru ’ba azini dri nyazu ku, erini ovule alatararu Yehova dririsi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
