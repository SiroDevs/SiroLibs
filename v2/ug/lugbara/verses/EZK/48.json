                  "text": "Eze 47:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suruti ma ru yi ’di: Engazu kala andraleruria, geri Hetilo­niari ma ageia kpere pari ’bani fizu Hamatiaria, azini Hazari-enani Da­masiki ma kalatiaria, andraleru Hamati ma ageia (kala yini nga ovu etuni efurialeru azini etuni ’deria­leru), Danini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Dani vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, Aserini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseri vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, Nafutalini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafutali vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, Mana­seni, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase vile kala­tiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’deria­leruria, Efiraimuni, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efi­raimu vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, Rubenini, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubeni vile kalatiri ma ageia, enga­zu kala etuni efurialeruria cazu kala etuni ’derialeruria, Yudani, esele alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.1"
              },
              "items": [
                {
                  "text": "Eze 45:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuda vile kalatiri ma ageia, engazu kala etuni efurialeruria cazu kala etuni ’derialeruria, nga ovu afa feza emini ngale feleri, walani ozu alifu kali iri drini towi, oconi esele azini ma ocole trotro, engazu kala etuni efurialeruria cazu kala etuni ,derialeruria; pari alatararuri nga ovu eri ma eselia agadua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa feza nde emini ngale fele Yehova driri ma oconi ma ovu ozu alifu kali iri drini towi, walani alifu mudri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa feza alatararu nde ma ovu ’ba ’diyi dri, ada ’ba edeta edepi ’diyi dri, kala andraleruria oconi alifu kali iri drini towi, kala etuni ’deria­leruria walani alifu mudri, kala etuni efurialeruria walani alifu mudri, kala vini uruleruria oconi alifu kali iri drini towi; pari alatararu Yehovaniri nga ovu eri ma eselia agadua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
