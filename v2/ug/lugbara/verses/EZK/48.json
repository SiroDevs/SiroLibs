              "items": [
                {
                  "text": "Eceza 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azi ngapi aku nde ma alia engapi suru Israelini ma alia dria ’diyi nga angu ’diri ’ya ra, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
