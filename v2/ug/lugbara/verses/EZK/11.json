                  "text": "Yer 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ’yo ra, Etu jo sizuri nga ogogo yo; aku ’dori eri otekuani, ama’i ama za aleniari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.3",
            "verseOrgIds": [
              "EZK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi mi ondri e’yo yi ma ruaa, mi ondri e’yo, mvi ’bani la!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
              "EZK.11.4"
            ]
          }
        }
