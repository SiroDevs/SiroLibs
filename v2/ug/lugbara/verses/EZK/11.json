              "items": [
                {
                  "text": "Zab 106:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ma nga emi ofu aleniasi ra, ma nga emi fe juru ma dria, ma nga e’yo liza ’ye emi ’eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.9",
            "verseOrgIds": [
