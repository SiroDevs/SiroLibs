                "loc": "MIC.3.3"
              },
              "items": [
                {
                  "text": "Mik 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi Opi Yehova ’yo ’dini: ’Ba emini ofule emini o’bale eri ma alia ’diyi yi zani, aku ’dori eri otekuani; te yi nga emi ofu amve aku nde ma aliasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.7",
            "verseOrgIds": [
              "EZK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
