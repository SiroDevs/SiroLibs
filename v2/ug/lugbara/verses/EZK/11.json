              "items": [
                {
                  "text": "Eze 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga di eca ’dini, de mani e’yo ondriria, Pelatia Benaya mvi dra ra, Ma nga e’de ani o’bukuru va, ma oyu uru o’duko urusi, ma ’yo ra, Eyawaye, Opi Yehova la! mi nga Israeli ma joloko de teketeke ra ya?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.13",
            "verseOrgIds": [
