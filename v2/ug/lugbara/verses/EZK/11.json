              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ’yo ma tia, Mvi ’bani, ’ba ’diyi yi ’ba e’yo onzi egapi, e’yo onzi amapi aku ’dori ma alia ’diyi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.2",
            "verseOrgIds": [
              "EZK.11.2"
            ]
          }
        },
