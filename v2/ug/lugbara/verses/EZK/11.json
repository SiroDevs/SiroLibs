            "number": "15",
            "style": "v",
            "sid": "EZK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvi ’bani, mi adripi, adaru mi adripi ori’ba mini ma eselia ’diyi pi ’ba dria suru Israelini ’diyi be dria, yi ’ba ’ba ovupi Yeru­salemua ’diyini ’yozu yi ma tia kini, Emi da emi Yehova vurisi ziri; yi fe angu ’dori ama dri afa amaniru, ’dini diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.15",
            "verseOrgIds": [
              "EZK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
