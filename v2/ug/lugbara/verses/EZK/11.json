              "items": [
                {
                  "text": "Zab 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga o’de sei ma sia; ma nga e’yo eminiri li angu Israeli­niri ma kalatia; emi nga ni ma Yeho­va’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
              "EZK.11.10"
            ]
