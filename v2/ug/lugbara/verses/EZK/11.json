          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.24"
              },
              "items": [
                {
                  "text": "O’be 10:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ru ndra sei ra, te ma nga sei eji emi ruaa’i, Opi Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.8",
            "verseOrgIds": [
              "EZK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 11:9"
          },
          "items": [
            {
              "text": "9",
