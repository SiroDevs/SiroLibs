        },
        {
          "text": "Te e’yo Yehovani nga eca ma vu kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.14",
            "verseOrgIds": [
              "EZK.11.14"
            ]
          }
        },
