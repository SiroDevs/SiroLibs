                {
                  "text": "Mat 7:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma fe adra ma enga ani arioti ofezu, ma ’ba ari erini oni kataru piriniri ma dria, ma ovu a’buzaru ku beni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
