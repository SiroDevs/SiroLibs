              "items": [
                {
                  "text": "Hab 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi opi Yehova ’yo ’dini: Eyawaye, aku ari ’bani adapiri ye! Ma aga afa odro amboru indio ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi o’ba eja drinia drinia, emi fe aci ma ve okposi, ma a’di za onyiru, a’isu ma ku ani, fala ma ve ra, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
