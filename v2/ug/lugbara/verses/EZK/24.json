              "items": [
                {
                  "text": "Eze 22:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vutinia mi ’ba eri pirini ’dani acioluni ima dria, ma dri aciru, mola erini ma ve beni, ondini ma aka acisi yiru, urizaniri ma ve teketeke ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ande azi eri­nisi ’bo; te uriza erini amboru turi funi eri ma alia ku, ka acisi ti, urizani funi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
