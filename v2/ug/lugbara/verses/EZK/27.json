          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.13"
              },
              "items": [
                {
                  "text": "E’do 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.29"
              },
              "items": [
                {
                  "text": "1 Sur 1:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Arabua pi ’ba opiru Kedaria ’diyi be dria, yi ’ba afa ozipi mi dri ’diyiru, ozi mi dri kabiloanzi piyi, kabiloago ’diyi pie, ndri pie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
        {
