              },
              "items": [
                {
                  "text": "Isa 60:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba afa ozipi Seba pia Rama be ’diyi yi ovu mi afa ozipi ’diyiru; yi ole afa oziza mini afa, larikariru esele onyiru ’diyi pisi, oni dria aje amborusi ’diyi pie, mele pie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
