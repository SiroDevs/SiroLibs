              "items": [
                {
                  "text": "’Yeta 7:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Harani pi, Kane pie, Edeni pie, ’ba afa ozipi Sebaa ’diyi pie, Asuri pie, Kilimadi pie, yi ’ba afa mini ozipi ’diyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ozi yini afa onyiru opele ope ’diyi pi, bongo ombeza edele blururi pisi bongo wura be ’diyi pie, sanduku bongo onyiruri be ombele bakasi edele mario patisi ’diyi pie, afa oziza mini ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        },
        {
