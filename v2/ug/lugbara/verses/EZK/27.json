                "loc": "GEN.11.31"
              },
              "items": [
                {
                  "text": "E’do 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.3"
