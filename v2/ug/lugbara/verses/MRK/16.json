              "attrs": {
                "loc": "LUK.24.13+LUK.24.14+LUK.24.15+LUK.24.16+LUK.24.17+LUK.24.18+LUK.24.19+LUK.24.20+LUK.24.21+LUK.24.22+LUK.24.23+LUK.24.24+LUK.24.25+LUK.24.26+LUK.24.27+LUK.24.28+LUK.24.29+LUK.24.30+LUK.24.31+LUK.24.32+LUK.24.33+LUK.24.34+LUK.24.35"
              },
              "items": [
                {
                  "text": "Luk 24:13-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilerisi eri nga i rua ece wura andinisi ’ba iri yi ma eselia ’diyi dri, yini aciria geria, muna aseari. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba nde ’diyi nga fu mu e’yo olu ’ba acepi ’diyi ma tia, te yi a’ini vini ’ba ’diyi ku indi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        }
      ]
    },
