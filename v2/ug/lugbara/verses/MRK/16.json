                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.18+MAT.28.19+MAT.28.20"
              },
              "items": [
                {
                  "text": "Mat 28:18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo yi tia kini, Emi mu angu wudrikuru drisi dria, emi olu e’yo bari ’ba Munguni ’bale ’diyi ma tia dria, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.38"
              },
              "items": [
                {
                  "text": "’Yeta 2:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’ipi baputizi bipiri nga i pa ra; te a’ipi kuri, e’yo lizani nga eri nde ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
