            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.11+JHN.20.12+JHN.20.13+JHN.20.14+JHN.20.15+JHN.20.16+JHN.20.17+JHN.20.18"
              },
              "items": [
                {
                  "text": "Yoh 20:11-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka enga ’bo, o’du alu sabatonirisi o’biti drio drio, eri nga li rua ece oko Mariamu Magadaleni idri, ndra erini orindi onzi odrozu ’eri ma alia aziriri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nderi inga mu e’yo olu ’ba ndra ovupi eri be ’diyi ma tia, yini otaria candisi awu be. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba nde ka eri kini eri idriru, azini eri ece di i rua oku nde dri ’bo, yi a’ini ku.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        }
      ]
    },
