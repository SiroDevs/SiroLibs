                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vilerisi eri nga i rua ece ’ba mudri drini alu ’diyi dri yini riria nyaka nyaria; eri nga ega yi dria a’itaako yini pisi asi mbaza yini be, yini ’ba eri ndrepi de erini engaria ’boria ’diyi ma e’yo a’ile kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
