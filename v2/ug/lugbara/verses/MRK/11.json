              "items": [
                {
                  "text": "Mat 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.13"
              },
              "items": [
                {
                  "text": "Yoh 14:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.23"
              },
              "items": [
                {
                  "text": "16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ma ’yo emi tia ndi ndi, e’yo dria emini zile emini a’ile Mungu tiari, emi ma a’i emi asia kini emi bi e’yo nde ’bo, te yi nga ovu emini ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.14+MAT.6.15"
              },
              "items": [
                {
                  "text": "Mat 6:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.23"
              },
              "items": [
                {
                  "text": "5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te etu dria emini pa soria e’yo ziria Mungu tia, emi ka ovu e’yo be ’ba azini vu, emi ku e’yo nde ja; Ata emini ’buari ma ku ezata emini ja ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.25",
            "verseOrgIds": [
              "MRK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te emi ka e’yo ku ja ku, Ata emini ’buari ngani vini ezata emini ku ku indi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.26",
            "verseOrgIds": [
              "MRK.11.26"
            ]
          }
        }
      ]
