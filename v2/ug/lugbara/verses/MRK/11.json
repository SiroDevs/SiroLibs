                "loc": "JHN.12.12+JHN.12.13+JHN.12.14+JHN.12.15+JHN.12.16"
              },
              "items": [
                {
                  "text": "Yoh 12:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ka eca Yerusalemu pi vu ogogo, Betefage pie, Betani pie, oni Mizeituni ma etia, eri nga ’ba erini imbale ’diyi ma azi iri ’diyi ma ti pe, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.1",
            "verseOrgIds": [
              "MRK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’yo yi tia kini, Emi mu fi aku ovupi emi driliaria; coti emini firia eri ma alia emi nga akanyamva lisu ’izaru, ’ba aluni nga rizu drinia kuri’i; emi etru eri, eji eri. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.14"
              },
              "items": [
                {
                  "text": "Mar 14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba lazini ka ’yo emi tia, Emi ’ye ’dini la’disi ya? emi nga ’yo kini, Opi le erini, eri nga eri ti pe coti dika ’doa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.3",
            "verseOrgIds": [
              "MRK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga mu, nga akanyamva isu ’izaru jotilia, geri aritia amve; yi nga leri tru ra, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.4",
            "verseOrgIds": [
              "MRK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba pa sopi ’daa ’diyi ma azi nga ’yo yi tia kini, Emi a’di ’ye, emi akanyamva tru a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.5",
            "verseOrgIds": [
              "MRK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga ’yo yi tia Yesuni te ’yolerile; yi nga a’i yi dri ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.6",
            "verseOrgIds": [
              "MRK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga akanyamva nderi eji Yesu vu, nga bongo yini o’be eri ngukua, eri nga ri drinia ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.7",
            "verseOrgIds": [
              "MRK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba kakau nga bongo yini aja va geria; ’ba azini nga pati arakala bi be yini gale va nga alia ’diyi aja. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.8",
            "verseOrgIds": [
              "MRK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25+PSA.118.26"
              },
              "items": [
                {
                  "text": "Zab 118:25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba mupi drilenia ’diyi pi ’ba mupi vutinisi ’diyi be nga oyu uru kini, Hosana! Asi ndriza ’ba emupi Opi ma rusiri dri! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndriza suru emupi a’bi amani Daudiniri dri! Hosana ’bua tu!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
