                "loc": "MRK.11.14"
              },
              "items": [
                {
                  "text": "Mar 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’bitisi yini agaria, yi ndre elio pati nde ’wi ’bo, olani be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peteroni e’yo egaria i asia nga ’yo tinia kini, ’Ba ’ba Imbapiri, mi lu! Elio mini trile ajeri ’wi teketeke ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.1"
              },
              "items": [
                {
                  "text": "Yoh 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesuni e’yo omviria, nga ’yo yi tia kini, Emi ovu a’ita be Mungu vu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.22",
            "verseOrgIds": [
              "MRK.11.22"
            ]
          }
        },
        {
