            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.14+JHN.2.15+JHN.2.16"
              },
              "items": [
                {
                  "text": "Yoh 2:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga eca Yerusalemua, Eri nga fi hekalua, eri ’ba ’ba afa ozipi ’diyi pi ofu amve, ’ba afa olepi hekalua ’diyi be, eri nga ’ba silingi ofupi ’diyi ma mesa pi ogu va, ’ba a’balau ozipi ’diyi ma kiti be; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.15",
            "verseOrgIds": [
              "MRK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri a’ini ’ba azinini afazu jizu agazu yi be hekalu alesi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.16",
            "verseOrgIds": [
              "MRK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Isa 56:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’ba imba, nga ’yo yi tia kini, Yi sini ndra ’dini ku ya, kini, Yi nga jo mani omve jo Mungu zizu suru dri driari’i? Te emi ’ba eri oji ’ba afa opapi diyiniru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani amboru piyi karani pie nga e’yo ’diri eri ra, yi nga ’ba geri ndru eri dri jazu; yini ovule erisi urisirisi, te ’ba ongulu­muru dria osu tu eri ma imbatasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etuzu ondre vusi ondre vusi eri adri fu aku amboruasi amve.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.19",
            "verseOrgIds": [
              "MRK.11.19"
            ]
          }
        }
      ]
    },
