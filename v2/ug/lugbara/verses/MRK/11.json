              "type": "tag",
              "attrs": {
                "loc": "LUK.17.6"
              },
              "items": [
                {
                  "text": "Luk 17:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia ndi ndi, ’ba azini ka ’yo oni ’diri ma tia, Mi nze mi ra, mi ’be mi miri alia; ka e’yo nduni ega i asia kuria, te ka a’i e’yo erini ’yoleri nga i ’ye ra, e’yo nde nga i ’ye eri dri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.23",
            "verseOrgIds": [
              "MRK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
