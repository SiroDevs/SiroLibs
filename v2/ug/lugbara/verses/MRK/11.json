                "loc": "LUK.19.45+LUK.19.46+LUK.19.47+LUK.19.48"
              },
              "items": [
                {
                  "text": "Luk 19:45-48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga fi Yerusalemua heka­lua; eri ka afa olu dria ’bo, etuni ’yeria ’deria ’boria eri nga fu mu Betania, ’ba mudri drini iri ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dru ’dini, yi ka fu Betaniasi ’bo, abiri nga eri fu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.12",
            "verseOrgIds": [
              "MRK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.9"
              },
              "items": [
                {
                  "text": "Luk 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6+LUK.13.7+LUK.13.8+LUK.13.9"
              },
              "items": [
                {
                  "text": "13:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Erini elio pati bi beri ndreria re ’dani, eri mu ra, kani eri nga afa isu ruania yani, Eri ka eca vunia ogogo, eri isuni afa ku, kiri pati bini a’dule, erini ovule ewu elioni kazuri’i kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.13",
            "verseOrgIds": [
              "MRK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.20"
              },
              "items": [
                {
                  "text": "Mar 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo ’yo tinia kini, ’Ba aluni ma nya efi mini dika ’dani ’dani ku. ’Ba erini imbale ’diyi nga e’yo eri ra.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        }
      ]
    },
