                  "text": "12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka afa ngule onzi ’ba dri jazuri ndre erini pa soria pari ogale siria (’ba waraga lapiri ma va e’yo ’diri), ’ba angu Yudiaa ’diyi ma apa oni eselia; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.31"
              },
              "items": [
                {
                  "text": "Luk 17:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba ovupi jo driari ma si va fizu afa ’duzu joarisi ku; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba ovupi nga aliari ma atri dri vile koti erini ’duzu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Candi oku okporovuru ’diyi dri, odekua endrupi ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma zi Mungu e’yo nderi ma ovu ewu egbenisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
