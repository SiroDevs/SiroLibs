              "items": [
                {
                  "text": "’Yeta 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’bi’bio yi nga o’de ’buarisi va, okpo ’bua ’diyi nga oya oya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
