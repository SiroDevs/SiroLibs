              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "0’du ’dari pi ma e’yo, etuniri be, ’ba aluni nini ku, kani malaika ’bua ’diyi Mvi be ti, kiri Ata’i a’dule, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ovu mile be, emi ko o’du ku, emi zi Mungu tia; emini,ewuni ovuzu a’dungareari nile kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
