            }
          ]
        },
        {
          "text": "O’du nde ’dayisi, inzata ’dari ma vutia, etuni nga ovu bizaru iniru, mba ngani angu mve ku, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
