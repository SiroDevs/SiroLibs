              "items": [
                {
                  "text": "Mat 13:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga malaika erini ti pe, yi nga ’ba opeza erini oku tualu engazu oli su ’diyi ma alia, engazu angu ma kalatini asizuria cazu kpere ’bu ma kalatini asizuria.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
