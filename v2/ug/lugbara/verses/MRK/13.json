              "items": [
                {
                  "text": "19:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.14"
              },
              "items": [
                {
                  "text": "Mat 25:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ovu ’ba mupi angu andinia­ rile, erini jo erini kuria, erini e’yo ’taziria ati’ba erini ma tia, azi awazu yi vusi alu alu yiniru, eri nga ’ba jotile agei tepiri azi ma te angu ma agei mile be, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.38"
              },
              "items": [
                {
                  "text": "Luk 12:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ovu: mile be ani-emini jo e’ini eca a’dungareari nile kurisi, kani ondre be, kani iniayii, kani a’uatani cere ’beria, kani o’biti be yani- ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri kazu emuzu rugbu emi isuzu o’du koria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mani ’yole emi tiari, ma ’yo ’ba tia dria ’dini: Emi ma! ovu ndrile be.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.37",
            "verseOrgIds": [
              "MRK.13.37"
            ]
          }
        }
