              "items": [
                {
                  "text": "Eceza 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di Mvi ’bani ndre erini emuria iriti ma alia, okpo amboru be, diza be tu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
