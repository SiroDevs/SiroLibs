          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi oni e’yo eti o’beza elioni arakalani efuria aroru ’bo, bini ka idi ra, emi ni kini ewu lozuri eca ogogo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dinile emi alu indi, emi ka e’yo ’diyi ndre, yini yi ’yeria, emi nga ni kini eri ovu ogogo, va jotilia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia ndi ndi, a’bianzi ’diyi ngani yi de ku de nga e’yo ’diyi dria ’yeni yi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Bu pi nyaku be, nga yi de ra, te e’yo,mani ngani i de ku.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        }
      ]
