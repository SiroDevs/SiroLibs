              "items": [
                {
                  "text": "Luk 12:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo zizaruni yo, pe lu eri ma ece indo; e’yo ndrozaruni vini yo, pe lu eri ma nga i e’da ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
