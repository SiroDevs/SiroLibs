                  "text": "31:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te yini eri riria ’boria, eri zo ra, eri eca amboru aga afa amvua ’diyi dria ca, eri arakala aja amboru, aria ’bua ’diyi nga emu ori endrinia ani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.32",
