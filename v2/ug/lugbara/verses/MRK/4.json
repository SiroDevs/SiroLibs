              "items": [
                {
                  "text": "Luk 6:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo yi tia kini, Emi ndre onyiru e’yo emini erileri; yi nga o’bi emi dri o’biza nde emini o’bileri vusi, ereni yi nga fe emi dri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
