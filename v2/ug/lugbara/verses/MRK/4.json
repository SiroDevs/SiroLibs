              "items": [
                {
                  "text": "Yak 5:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ka nga o’du ko linisi, ka nga oru etu be dria; ori enga ra, zo ra, te agu nde nini ngoni ngoni yari ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
