                  "text": "Luk 19:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba afa beri dri yi nga afa fe: dika; te ’ba afa kokoruri ma driasi yi nga afa erini opa dria ra.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
