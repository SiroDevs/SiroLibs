              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo ra kini, Suri Munguni eri Ovu ’dini, ekile ’ba ka nga ori o’be inyakua; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
