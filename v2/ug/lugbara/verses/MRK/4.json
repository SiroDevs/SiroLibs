          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu haradali efile; yini eri riria nyakua eri gakandiaru, ori dria nyakua ’diyi aga eri ombosi ra, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
