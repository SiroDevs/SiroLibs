          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaku eri nyaka eji eri drisi; eri bi so raka, eri nga vini ayi ra, eri nga efi ’ya tre ayiza nde ma alia ndo; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
