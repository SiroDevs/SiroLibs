              "items": [
                {
                  "text": "Yoe 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ka di ka dria ’bo, coti yi eli ’du ra, ewu lozanirini ecalerisi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.29",
            "verseOrgIds": [
