            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi fe Yehovani ande e’yo ’yoza emini ’diyisi ’bo. Te kiri emi i ’yo nga kini, Ama fe eri ande e’yo ngosi ya? E’yo ’diri ma alia, emi ’kini, ’Ba dria alu alu onzi ’yepi ’diyi yi onyiru Yehova ma milia, eri ovu vini ayikosi ’ba ’diyi ma e’yosi. Kani, Mungu e’yo lipi kililiruri eri ngoa ya?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
    }
