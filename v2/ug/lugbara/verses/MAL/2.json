              },
              "items": [
                {
                  "text": "Yak 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azita e’yo adaruniri ovu ndra eri ma tilia indi, azini yi isuni e’yo onyi kokoruri eri ma tia ku. Eri aci ndra ma be asi anzuru pi ma alia onyi be, azini eri oja ndra ’ba kakau onzi yini kuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.6",
            "verseOrgIds": [
              "MAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 2:7"
          },
          "items": [
