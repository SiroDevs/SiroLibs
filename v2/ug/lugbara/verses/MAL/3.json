                  "text": "Dan 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suru dria nga emi omve ayiko’baru, emini ngale ovule angu ayikoru turisi, Yehova asikari ongulumuruniri ’yoni.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
