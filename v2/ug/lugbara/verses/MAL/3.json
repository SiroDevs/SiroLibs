              "type": "text"
            }
          ]
        },
        {
          "text": "Ewu ndesi edeta Yuda pini fele Yerusalemu beri eri nga di ovu ayikoru Yehova ma milia, ekile o’du ndra drio ’diyisirile, ekile eli ndra drio ’diyisirile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        },
