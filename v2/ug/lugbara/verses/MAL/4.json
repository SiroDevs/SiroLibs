              "items": [
                {
                  "text": "2 Pet 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ru mani rupi ’diyi dri, etu onyiniri nga efu, atiza be eri ma opilia. Emi nga fu amve avizu ekile kojana koloteni avile licoasirile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
