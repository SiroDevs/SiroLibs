        },
        {
          "text": "eri ku Yehova Mungu i a’bipiniri, acini geri Yehovani ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        },
