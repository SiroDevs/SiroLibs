              "items": [
                {
                  "text": "2 Sur 33:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Manase la i a’bipi be tualu, yi sa eri amvu jo eri ma ngulu­pini ma ageiaria, amvu Uzaniria; te mvi erini Amoni nya opi eri ma pariani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
