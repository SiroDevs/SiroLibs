                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ati’ba Amonini otu e’yo eri ruaa, fu opini jo eri ngulupini ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba angu ndea ’diyi ofu ’ba dria e’yo otu­pi opi Amoni ma ruaa ’diyi ra, te ’ba angu ndea ’diyi ’ba Yosiani opiru eri ma paria’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
              "2KI.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta azini dria Amonini ’yele diyi, yi sini yi buku opi Yudaa ’diyi ma e’yo ecezuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 21:26"
          },
          "items": [
