                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli Amonini ovu kali iri drini iri erini e’dozu opi nyazurisi, te eri nya opi eli iri Yerusalemua. Andri erini ma ru Mesulemeti, Haruzi Yotibaari ma zi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye e’yo ovupi onzi Yehova ma miliari, ekile i ati Manaseni ’yelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri aci geri i atini acizuri ma aliasi dria, eri ’ye azi wura i atini azi ’yezu yi dri ’diyi dri, inzi yi indi; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
