        {
          "text": "Eli Manaseni ovu mudri drini iri erini e’dozu opi nyazurisi, eri nya opi eli kali towi drini towi Yerusalemua. Andri erini ma ru Hefiziba’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
