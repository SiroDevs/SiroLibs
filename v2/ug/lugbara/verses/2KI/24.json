                  "text": "2 Sur 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehoyakimu la i a’bipi be, te mvi erini Yehoyakini nya opi eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
