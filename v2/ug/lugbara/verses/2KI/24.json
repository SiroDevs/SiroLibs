            }
          ]
        },
        {
          "text": "indi vini erini ari adale e’yo kokoru akarisi; a’disiku eri ga Yerusalemuni tre ari ’ba e’yo koko ’diyinisi, te Yehova leni i e’yo onzi erini wuzu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
