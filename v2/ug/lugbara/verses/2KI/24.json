              },
              "items": [
                {
                  "text": "Dan 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ewu nderisi ati’ba Nebukadi­neza opi Babuloniarini ’diyi etu uru Yerusalemua, ace eri ombasi kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Nebukadineza nga eca aku nderia, ati’ba erini ’diyini eri acezu ombasiria; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
