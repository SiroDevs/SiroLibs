              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta azini Yehoyakimuni, e’yo erini ’yele ’diyi pie dria, yi sini yi buku opi yudaa ’diyi-me’eyo ecezuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
