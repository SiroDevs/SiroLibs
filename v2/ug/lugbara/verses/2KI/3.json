              },
              "items": [
                {
                  "text": "1 Sam 15:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga aku abi kali be okporu eza dria, aku dria onyiru tu ’diyi be, emi nga pati onyiru ’diyi ga dria, emi nga yi a’di ase dria, nga vini angu onyiru ’diyi dria eza onisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
