              "items": [
                {
                  "text": "Isa 8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi Israeliniri ’yo ra, Eyawa­ye! Yehova omve opi na ’diyi yi fezu Moabu dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
