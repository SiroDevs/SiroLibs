              },
              "items": [
                {
                  "text": "Zab 15:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elisa nga ’yo, Ekile Yehova asikari ongulumuruni mani pa sozu eri driliarini ovule indirile, ma ka te Yehosafati opi Yudaari ru ku, te’do ma luni mi ku, ma neni mi ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
