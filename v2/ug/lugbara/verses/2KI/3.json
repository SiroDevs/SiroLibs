                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mesa opi Moabuari ovu kabilo kakau ma eri’i; eri fe opi Israelini dri kabiloanzi alifu turu alu ’ ma ’biko, azini kabiloago alifu turu alu ma ’biko indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.1"
              },
              "items": [
                {
                  "text": "2 Opi 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca dini, Ahabu ka dra ra, opi Moabuari nga mbu opi Israeliniri ma ruaasi amve, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewu nderisi opi Yehora­mu nga fu Samariaasi, eri oku Israeli dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.6",
            "verseOrgIds": [
              "2KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.4"
              },
              "items": [
                {
                  "text": "1 Opi 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri mu, eri pe ’ba ti Yeho-i safati opi Yudaari vu kini, Opi Moabuari mbu ma ruaasi ’bo; mi nga mu ma be tualu a’di ’dizu Moabu be ra ya? Kini, E, ma nga mu ra; ma ovu ekile mile, ’ba mani ovu ekile ’ba minile indi, azini akanya mani ovu ekile akanya minile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo vini, Ama nga mu geri ngorisi ya? Yehoramu omvi e’yo kini, Geri angu roko Edomuariasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        }
      ]
    },
