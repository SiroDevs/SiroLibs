            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini opi Israelini pi mu opi Yudaari pie, opi Edomuari pie. Yi ka aci kalaasi o’du aziri ’bo, yi mvuza asikari ongulumuru ’diyi pi dri anyapa yi ma vuti bipi ’diyi be yo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
