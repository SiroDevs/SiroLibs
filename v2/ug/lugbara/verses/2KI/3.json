                  "text": "2 Opi 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga di ’yo, Yehova ’yo ’dini, Emi osi ’bile kakau e’bu ’diri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
