                  "text": "Zab 107:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku Yehova ’yo ’dini, Emi ngani oli pi ne ozoo be ku, te e’bu nderi nga ga tre yisi, emi nga mvu, ti emini be, anyapa emini be ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.17",
            "verseOrgIds": [
