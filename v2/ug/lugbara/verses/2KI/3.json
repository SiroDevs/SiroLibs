        },
        {
          "text": "Te e’yo ’di ovu Yehova ma milia e’yo wereni; eri nga vini ’ba Moabua ’diyi fe emi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
