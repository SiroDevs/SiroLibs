              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu Ahabu mvi e’do opi nyazu Israeli ma drilia Samariaa, eli mudri drini aro Yehosafati opi Yudanirini opi nyazurisi, eri nya opi eli mudri drini iri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
