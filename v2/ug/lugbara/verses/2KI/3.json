                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30+1KI.12.31+1KI.12.32"
              },
              "items": [
                {
                  "text": "1 Opi 12:28-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ebi i e’yo onzi Yeroboamu Nebati mvini ’yele erini fele Israeli ma ’ye ’diyi be; eri kuni yi ku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        }
