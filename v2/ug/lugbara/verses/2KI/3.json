              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.31"
              },
              "items": [
                {
                  "text": "1 Opi 16:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’ye e’yo ovupi onzi Yehova ma miliari, te tro­tro ekile i ati pini ’yele andri berile ku, a’disiku eri nze pati Baalini i atini i’dile inzizaruri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
        },
        {
