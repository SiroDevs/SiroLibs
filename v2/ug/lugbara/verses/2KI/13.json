        {
          "text": "Yehoahazi Yehu mvi e’do opi nyazu Samariaa Israeli ma drilia, eli kali iri drini na Yoasi Ahazia mvi opi Yudaarini opi nya­zurisi, eri nya opi eli mudri drini aziri, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
