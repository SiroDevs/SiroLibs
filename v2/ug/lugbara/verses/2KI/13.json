                  "text": "2 Sur 25:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Yeta azini Yoasini, e’yo erini ’yele ’diyi pie dria, okpo erini a’di ’dizu Amazia opi Yudaari beri be, yi sini yi buku opi Israelini ’diyi ma e’yo ecezuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yoasi la i a’bipi be, te Yeroboamu ri oguna erini opiniri ma dria; te sa Yoasini Samariaa tualu opi Israelini ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
