                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo vini, Mi ’du ’ye; eri ’du ra. Eri ’yo opi Israeliniri tia, Mi co nyaku yisi; eri co nyaku ani pale na, ku ja. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
