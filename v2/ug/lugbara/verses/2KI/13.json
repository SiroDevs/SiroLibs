        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.3"
              },
              "items": [
                {
                  "text": "Amo 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ku Yehoa­hazi dri asikari akanyani ’diyi kiri kali towi, azini gari mudri ’diyi pie, asikari acipi pasi alifu alu ’diyi pie, a’disiku opi Suriaari ja yi dri ’bo, ’ba yi ekile anya drilekole. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta azini dria Yehoahazini, e’yo erini ’yele ’diyi pie dria, yi sini yi buku opi Israelini ’diyi ma e’yo ecezuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehoahazi la i a’bipi be, yi sa eri Samariaa, te mvi erini Yoasi nya opi eri ma pariani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
