          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba Munguni ovu aokosi eri vu, ’yo kini, Onyiru mi ka te co pale towi kani azia; te’do mi co Suria cazu mini yi dezuria, te curu’do mi nga Suria co kiri pale na. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        },
