          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Elisa nga ’yo eri tia kini, Mi ’du osu pi ’ye be; ’dini eri ’du osu pi ’ye be ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
