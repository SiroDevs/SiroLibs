                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ti, yi kuni e’yo onzi suruti Yeroboamuni ’yele, erini fele Israelini ’yele ’diyi ku, te yi aci alenia ’dani, azini Asera ovu ’dani Samariaa.) ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
