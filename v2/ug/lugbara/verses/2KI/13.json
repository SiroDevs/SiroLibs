        {
          "text": "Vu­tinia eri ’yo opi Israeliniri ma tia kini, Mi ’ba mi dri osu dria; eri ’ba dri drinia. Te Elisa nga dri ini ’ba opi ma dri dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
