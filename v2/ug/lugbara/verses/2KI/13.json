            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye e’yo ovupi onzi Yehova ma miliari, eri bi e’yo onzi Yeroboamu Nebati mvini ’yele, erini fele Israelini ’yele ’diyi ma vuti; eri kuni e’yo onzi nde ’diyi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
