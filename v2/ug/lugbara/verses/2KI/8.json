        },
        {
          "text": "Yehoramu Ahazia mvi opi Yudani e’do opi nyazu eli mudri drini iri Yoramu Ahabu mvi opi Israelinirini opi nyazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
