                  "text": "2 Sur 21:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Edomumbu Yuda ma ruaasi amve kpere ecazu andru. Libina mbu amve ewu nderisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta azini dria Yoramuni, e’yo erini ’yele ’diyi pie dria, yi sini yi buku opi Yudani ’diyi ma e’yo sizuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
