                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri su mile ruania, ni eri ’dani kpere te drinza nga eri bi ani. Te ’ba Munguni nga wu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        },
