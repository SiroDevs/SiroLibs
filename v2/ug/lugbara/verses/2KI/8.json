              "items": [
                {
                  "text": "2 Sur 22:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.17"
              },
              "items": [
                {
                  "text": "21:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yoramu la i a’bipi be, yi sa eri tualu i a’bipi be aku Daudiniri ma alia; te mvi erini Ahazia nya opi eri ma pariani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
