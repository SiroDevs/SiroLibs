              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.43"
              },
              "items": [
                {
                  "text": "1 Sam 17:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.15"
              },
              "items": [
                {
                  "text": "1 Opi 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Hazae­li ’yo kini, Ati’bo mini ovupi oce toko ’diri eri a’dini e’yo amboru ’dori ’yezu ya? Elisa omvi e’yo eri tia kini, Yehova ece ma dri, mi nga ovu opi Suriaariru mi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga nga Elisa vu ’diarisi, eca opi ini vu, opi ’yo eri tia ’dini kini, Elisa ’yo mi tia ngoni ya? Te eri omvi eri tia kini, Eri ’yo ma tia kini, mi nga ati ada. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini dru, eri ’du bata­nia, su yi alia, aja eri opi ma andretia, te eri dra ra. Te Hazaeli nga opi nya eri ma pariani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
