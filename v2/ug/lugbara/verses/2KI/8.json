                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eli erini ovu kali iri drini iri erini e’dozu i opi nyazurisi, eri nya opi eli alu Yerusalemua. Andri erini ma ru Atalia, Omiri opi Israeliniri ma zi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
