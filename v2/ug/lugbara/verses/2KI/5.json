            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Naamani nga di ’yo, Ka’dini yo, mi fe nyaku akanya irini ecole ejileri ati’bo mini dri; a’disiku engazu curu’do ati’bo mini ngani edeta ve kani ede adrou azini dri aluni ku, pe kiri Yehova dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
