            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yob 23:25",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.27"
              },
              "items": [
                {
                  "text": "Luk 4:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga di si va, nga fi Yoridani alia pale aziri, ekile ’ba Mungunirini ’yolerile; rua erini eca dika onyiru ekile mva ganaru ma ruale, eri ovu alaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
