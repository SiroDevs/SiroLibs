                }
              ]
            }
          ]
        },
        {
          "text": "Ewu ’dasi opi Herode nga e’yo kuza Yesuni eri ra ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga ’yo ati’ba ini ma tia, ’Ba dari Yohana baputizi fepiri’i, enga ’ba draza eselia ’bo; tali ’diyi yi ’ye erisi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.2",
            "verseOrgIds": [
              "MAT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.19+LUK.3.20"
              },
              "items": [
                {
                  "text": "Luk 3:19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.2"
              },
              "items": [
                {
                  "text": "Mat 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku Herode bi ndra Yohanani, ombe eri, ’ba arujoa Herodiasi i adripi Filipo ma oku ma e’yosi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.3",
            "verseOrgIds": [
              "MAT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.16"
              },
              "items": [
                {
                  "text": "Lev 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.21"
              },
              "items": [
                {
                  "text": "20:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te Yohana ’yo ndra eri tia, Azita a’ini mini ovuzu eri be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.4",
            "verseOrgIds": [
              "MAT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.26"
              },
              "items": [
                {
                  "text": "Mat 21:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri le eri fu ra, te ovu urisi ’ba ongulumuru ma e’yosi, yini a’ile eri ovu nabinirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.5",
            "verseOrgIds": [
              "MAT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te omu Herodeni osizuri ka eca ra, Herodiasi zi nga ongo tu yi eselia, nga ayiko fe Herode dri, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.6",
            "verseOrgIds": [
              "MAT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini eri nga e’yo azi eri tia oyo sozasi kini i nga afa dria erini a’ileri fe eri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.7",
            "verseOrgIds": [
              "MAT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri’i, andrini eri bile imbaria, nga ’yo ra, Mi fe ma dri ’doa koyia alia Yohana baputizi fepiri ma dri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.8",
            "verseOrgIds": [
              "MAT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi nga ovu candisi; te oyo erini soleri ma e’yosi, azini ’ba ripi eri be nyaka ria ’diyi ma e’yosi, eri azi yi ma fe eri dri; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.9",
            "verseOrgIds": [
              "MAT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.12"
              },
              "items": [
                {
                  "text": "Mat 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga ’ba ti pe Yohana ma dri lizu jo arunia, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.10",
            "verseOrgIds": [
              "MAT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi nga drini eji koyia alia fezu zamva dri, eri nga eji andru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.11",
            "verseOrgIds": [
              "MAT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Yohanani imbale ’diyi nga emu avuni ’du sazu; yi nga mu e’yoni olu Yesu tia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.12",
            "verseOrgIds": [
              "MAT.14.12"
            ]
          }
        }
      ]
    },
