                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.1+JHN.6.2+JHN.6.3+JHN.6.4+JHN.6.5+JHN.6.6+JHN.6.7+JHN.6.8+JHN.6.9+JHN.6.10+JHN.6.11+JHN.6.12+JHN.6.13"
              },
              "items": [
                {
                  "text": "Yoh 6:1-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu ka eri ra, eri nga enga ’daarisi ogurusi, muzu angu ’ba kokorua ndindiru. ’Ba ongulumuru ka eri ra, yi nga eri ma vuti bi pasi engazu aku ambo ’diyia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.13",
            "verseOrgIds": [
              "MAT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mat 9:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Erini furia, eri nga ’ba ongulu­muru kakau ndre, eri nga ovu asi ’ndrizasi yi vu, eri nga ’ba yini azoru ’diyi ati ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.14",
            "verseOrgIds": [
              "MAT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka eca ondresi, ’ba erini imbale ’diyi nga emu eri vu, kini, Pari ’dori rokoru, etu ’de vini ’bo; mi pe ’ba ongulumuru ma ti mvizu, yi ma mu aku were ’diyi vusi nyaka jezu yi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.15",
            "verseOrgIds": [
              "MAT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yesu nga ’yo yi tia, Leni yi ma mvi ku; emi fe nyaka yi dri emi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga ’yo eri tia, Ama afa ’do yo, pe lu mikate towi e’bi iri be a’dule. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.17",
            "verseOrgIds": [
              "MAT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo ra, Emi eji yi ma vu ’doa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga azi ’ba ongulumuruni rizu va ase dria, eri nga mikate towi piyi ’du e’bi iri be, eri nga lu ’bua uru, nga asi ndriza a’i eri nga mikate nyo fa, fe ’ba erini imbale ’diyi dri, ’ba erini imbale ’diyi nga fe ’ba ongulumuru dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.19",
            "verseOrgIds": [
              "MAT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.44"
              },
              "items": [
                {
                  "text": "2 Opi 4:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi dria nga nya ra, nga tra ra. Yi nga onyole ’diyi ma joloko oku evu mudri drini iri tre. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.20",
            "verseOrgIds": [
              "MAT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba nyapi ’diyi alifu towi ’diyi agupini oku piyi anzi be lani ku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.21",
            "verseOrgIds": [
              "MAT.14.21"
            ]
          }
        }
      ]
    },
