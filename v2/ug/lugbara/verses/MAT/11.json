        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.17"
              },
              "items": [
                {
                  "text": "Mat 13:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo emi ria ndi, ’ba okuni osile ’bo ’diyi ma eselia ’ba Yohana baputizi fepire agapi rani yo;te ’ba werea tu suru ’buaria eri amboru aga eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.16"
              },
              "items": [
                {
                  "text": "Luk 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.24"
              },
              "items": [
                {
                  "text": "13:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.15"
              },
              "items": [
                {
                  "text": "Yoh 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Engazu o’du Yohana baputizi fepirinisi ecazu curu’do, ’ba suru ’buari ari, ’ba aripi ’diyi eri pa okposi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.12",
            "verseOrgIds": [
              "MAT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te nabi dria azita be yi olu ndra e’yo ecazu Yohana vu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.13",
            "verseOrgIds": [
              "MAT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Mal 3:23",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.10+MAT.17.11+MAT.17.12+MAT.17.13"
              },
              "items": [
                {
                  "text": "Mat 17:10-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.11+MRK.9.12+MRK.9.13"
              },
              "items": [
                {
                  "text": "Mar 9:11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te emi ka le e’yo ’diri a’i ra ’ba ’diri eri Eliya ngapi emupiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.14",
            "verseOrgIds": [
              "MAT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ovupi bile beri ma eri e’yo ra ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.15",
            "verseOrgIds": [
              "MAT.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga ’ba ewu ’dosi ’diyi o’bi a’di be ya? Yi ovu ekile anzi nyiri ripi cuua yi agyi omvepi ’diyile",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.16",
