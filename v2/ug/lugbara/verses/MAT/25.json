              "items": [
                {
                  "text": "Ebra 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Me­leki nga e’yo omvi, nga ’yo yi tia, Ma ’yo emi tia ndi, emini eri ’yele adripi mani nyiria ’diyi ma azi alu dririsi, emi ’ye ndra eri ma dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
