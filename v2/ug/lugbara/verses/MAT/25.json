          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi’du talanto eri driarisi, emi fe eri ’ba ovupi talanto mudri beri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
