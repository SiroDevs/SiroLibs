                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.10"
              },
              "items": [
                {
                  "text": "Eceza 20:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vilerisi eri nga di ’yo ’ba ovupi eri dri ejia ’diyi ma tia indi, Emi nga ma ageiarisi ra, emi dria ovupi otrizaru ’diyi, emi ma fi aci ’dani ’dani ovupi edezaru ngonde ’ba ’ba obepiri pi dri malaika erini beria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku ma ovu ndra abirisi, te emi feni nyaka ma dri ku; ma ovu ndra yi avijosi, te emi feni afa mvuza ma dri ku; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ovu ndra ani ’boru, te emi feni jo lazu ma dri ku; ma ovu ndra pililiru, te emi feni afa suza ma dri ku; ma ndra azoru azini arujoa, te emi emuni ma ndrezu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’diyi nga di e’yo omvi, nga ’yo eri tia, Opi, ama ndre mi ovuzu abirisi, kani yi avijosi, kani ani’boru, kani pililiru, kani azoru, kani arujoa, azini ama koni mi aza azi ngazasi ku o’du ngosi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di e’yo omvi yi tia kini,Ma’yo emi tia ada,ekile ndra emini eri ’yele ’ba nyiria ’diyi ma azi alu dri kurile emi ’yeni eri ma dri ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
