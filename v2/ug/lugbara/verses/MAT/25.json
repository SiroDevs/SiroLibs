              "items": [
                {
                  "text": "Eze 34:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga kabilo ’ba eri ma dri ndiria, te eri nga ndri ’ba dri ejia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        },
        {
