                "loc": "ISA.58.7"
              },
              "items": [
                {
                  "text": "Isa 58:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ma ovu ndra abirisi, emi fe ndra nyaka ma dri ra; ma ovu ndra yi avijosi, emi fe ndra ma dri yi mvu ra; ma ovu ndra ani’boru, te emi fe ma dri jo lazu ra; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ovu ndra pililiru, te emi fe ndra afa suza ma dri ra; ma ovu ndra azoru, te emi emu ma ndrezu ra; ma ovu ndra arujoa, te emi emu ndra ma vu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
