              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.3"
              },
              "items": [
                {
                  "text": "Mat 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba kililiru ’diyi nga di e’yo omvi eri tia kini, Opi, ama ndre mi ovu abirisi, ama fe mi dri nyaka a’dungare ya? azini yi avijosi, te ama fe mi dri afa mvuza a’dungare ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ndre mi ovu ani’boru, ama fe pari mi dri lazu a’dungare ya? kani mi ovu pililiru, ama fe afa suza mi dri a’dungare ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ndre mi ovu azoru, kani arujoa, te ama emu mi ndrezu a’dungare ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
              "MAT.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
