              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.2"
              },
              "items": [
                {
                  "text": "Dan 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Yoh 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi naa mu fi panga onzi ’dani ’daniria, te ’ba kililiru ’diyi nga mu fi idri ’dani ’daniria.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
