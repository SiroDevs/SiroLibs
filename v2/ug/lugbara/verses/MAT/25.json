                  "text": "Rum 14:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suru dria yi nga yi oku eri milia,eri nga yi ma esele co ekile ’ba kabilo ocepirini kabilo pi ma esele cole ndri berile; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
