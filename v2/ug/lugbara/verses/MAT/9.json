              "attrs": {
                "loc": "LUK.5.27+LUK.5.28+LUK.5.29+LUK.5.30+LUK.5.31+LUK.5.32"
              },
              "items": [
                {
                  "text": "Luk 5:27-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesuni agaria ’dasi, eri nga ’ba ndre erini riria pari ’bani musoro ’bezuria, runi Matayo’i; nga ’yo tinia, Mi bi ma vuti. Eri nga enga ra, nga eri ma vuti bi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        }
      ]
