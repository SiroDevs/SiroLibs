                  "text": "Luk 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Farisaini nga ’yo ra, Eri orindi onzi odro opi orindi onzi ma driliarisi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
