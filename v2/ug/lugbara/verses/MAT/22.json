        },
        {
          "text": "O’du ’darisi ’ba Sadukayoni,, ’yopi kini engata yo ’diyi, nga emu eri vu, nga zi eri tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
