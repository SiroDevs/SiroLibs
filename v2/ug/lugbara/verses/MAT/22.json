              "items": [
                {
                  "text": "Luk 10:25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba alu yi eselia, ’ba azita nipiri, nga e’yo zi eri tia eri o’bizu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
