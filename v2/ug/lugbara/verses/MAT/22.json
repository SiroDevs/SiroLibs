                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Farisaini ka eri kini eri ombe ’ba Sadukayoni ma ti ci, yi nga yi oku tualu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
