                  "text": "Gal 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo aziza dria pi nabi be oti yi azita iri ’diyi ma ruaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
