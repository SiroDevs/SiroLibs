              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iriri ovupi erileri ’di’i, Mi ma le mi agyi ekile mini mi ngulupi lelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
