    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nga e’yo omvi, ’yo yi tia dika e’yo o’bezasi, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.16+LUK.14.17+LUK.14.18+LUK.14.19+LUK.14.20+LUK.14.21+LUK.14.22+LUK.14.23+LUK.14.24"
              },
              "items": [
                {
                  "text": "Luk 14:16-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.29"
              },
              "items": [
                {
                  "text": "Yoh 3:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suru ’buari ovu ekile ’ba melekiru; omu oku bizaniri ’hapi mva ini dririle, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri pe ati’ba erini ma ti ’ba ndra erini omvele omu oku bizani nyazu ’diyi omvezu; te yi ga emuko si. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.3",
            "verseOrgIds": [
              "MAT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.36"
              },
              "items": [
                {
                  "text": "Mat 21:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri pe ati’ba azini ma ti dika, eri ’yo ra, Emi olu ’ba omvele ’bo ’diyi ma tia, Mi ndre, ma a’di nyaka mani ’bo, oli ranya mani piyi anyapa osoru ’diyi be ’bo, afa dria ovu ngonde; emi ma emu omu oku bizaniria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.4",
            "verseOrgIds": [
              "MAT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ’diyi ’bani asi drinia ku, yi mu ra, ’ba alu amvu inia, aziniri afa oziza inia; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba acepi ’diyi bi ati ba erini ci, nga drinza fe yi dri, nga yi fu ra, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.2"
              },
              "items": [
                {
                  "text": "Mat 24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te meleki ovu adrasi; eri pe asikari, ini ma ti, ja ’ba ’ba fupi ’dayi ma dri, eve aku yini acisi dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.7",
            "verseOrgIds": [
              "MAT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di ’yo ati’ba ini ma tia, Omu oku bizaniri ovu edezaru, te ’ba ndra omvele ’bo ’diyi ovuni onyiru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.47"
              },
              "items": [
                {
                  "text": "Mat 13:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.43"
              },
              "items": [
                {
                  "text": "21:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi mu geri gbokoni yi ecizuria, azini ’ba dria emini isule ’diyi, emi ma omve yi emuzu omu oku bizaniria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati’ba ’dayi nga di fu mu gbokoa, nga ’ba dria yini isule ’diyi oku, ’ba onzi piyi ’ba onyiru ’diyi be; ’dini omu ga tre ’ba ripi ’diyisi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.10",
            "verseOrgIds": [
              "MAT.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.10",
            "verseOrgIds": [
              "MAT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te melekini firia ’ba ripi ’diyi andrizu, eri nga ’ba alu ndre ’daa afa suza omuni kokoru; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga ’yo eri tia, Ma agyi, mi efi ’doa afa suza omuniri kokoru ngoni ya? Te eri adri ciri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.12",
            "verseOrgIds": [
              "MAT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.12"
              },
              "items": [
                {
                  "text": "Mat 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.30"
              },
              "items": [
                {
                  "text": "25:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.28"
              },
              "items": [
                {
                  "text": "Luk 13:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meleki nga di ’yo ’ba azi ngapi ’diyi ma tia, Emi ombe eri ma pa pi dri be ci, emi ’be eri angu inicicirua amve; ’daa awu pi sikala nyaza be nga ovuni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.13",
            "verseOrgIds": [
              "MAT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba kakau ovu omvezaru, te ’ba opele ’diyi were.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.14",
            "verseOrgIds": [
              "MAT.22.14"
            ]
          }
        }
      ]
    },
