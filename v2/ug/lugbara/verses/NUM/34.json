        },
        {
          "text": "Lokiri nde nga i oja engazu Azimoniasi cazu Yi Ara Misiriaria, asizaniri nga ovu Miri ma tia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        },
        {
