          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokiri emini etuni ’derialeruri nga ovu Miri Amboruri ma kuti; ’di lokiri emini kala etuni ’deriale­ruriari’i.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
