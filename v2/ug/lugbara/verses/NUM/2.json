              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba hema asopi eri ma ageia ’diyi yi suru Simeonini; opi Simeoni anziyi ma driliari nga ovu Selumieli Zurisadai mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
