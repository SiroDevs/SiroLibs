        },
        {
          "text": "ongulumu erini, ’ba yi ma eselia yini yi ma kalafe lale ’diyi yi alifu kali towi drini oromi, drini turu na. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
