        {
          "text": "Manase mvi Makiri ma mvi Gileadi ma mvi Heferi ma mvi Zelofehadi ma ezopi nga esi ogogo, yi ori’ba Yusufu mvi Manaseni ’diyi. Eri ma ezopi ma ru yi ’di: Mala pi, Noa pi, Hogila pi, Milika pi, Tiriza pie. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.1",
            "verseOrgIds": [
              "NUM.27.1"
            ]
          }
        },
