                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nga dri ko ’daarisi acizu Beeria, ’diri yi a’di Yehovani ndra e’yoni ’yole Musa ma tia, kini, Mi oku ’ba tualu, ma nga yi fe yi driri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        },
