          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Hesi­bonini aku Sihoni opi ’ba Amorini ma driliarini, Sihoni nde ’di ndra a’di opi ndraka Moabu ma driliari be, opa angu erini dria eri ma driarisi, ada kpere Arinonia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
