              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi ’ba e’yo o’beza o’bepi ’diyi ’yo ndra ’dinile,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
