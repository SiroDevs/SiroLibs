                "loc": "JHN.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa nga di uri ede molasi, nga eri ’ba pati lokoru ma sia; te eri eca ’dini, uri ka ’ba azini ga ra, agu nde ka uri edele molasiri lu ra, eri nga i pa ra ovuzu idriru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
