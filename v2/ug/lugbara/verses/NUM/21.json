            }
          ]
        },
        {
          "text": "Yeho­va nga uri aciru ’diyi ma ti pe ’ba ma eselesi, yi nga ’ba oga ra, ’ba Israelini karakarau nga odra ani ra. ",
          "type": "text",
          "attrs": {
