              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli nga aku ’diyi opa dria; Israeli nga ovu aku ambo ambo ’ba Amorini ’diyini ma alia dria, Hesiboni pia, aku erini ambo ambo ’diyi be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
