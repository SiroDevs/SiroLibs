                "loc": "NUM.9.6"
              },
              "items": [
                {
                  "text": "Kal 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma eza i ovuzu alatara kokoru i atisi, kani i andrisi, kani i adrisi, kani i amvisi ku, yini odrazu rari ti, e’yo i esele cozu ndu Yehovanirurini ovule eri ma driarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du erini i esele cozu ndu ’diyisi dria eri alatararu Yehova vu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.18"
              },
              "items": [
                {
                  "text": "’Yeta 18:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini ka dra mbeleru eri ma ageia ogogo ’daa, erini ani i ma dri erini i esele cozu nduri ezazu alatara kokoru, ka’dini eri ma fa i dri o’du i ’bazu alatararurisi; eri ma fa i dri o’du aziririsi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
