            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.7"
              },
              "items": [
                {
                  "text": "Imv 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du oyo erini i esele cozu ndurini ’diyisi dria, idri ma elo drini ku; kpere o’du nde erini i esele cozu ndu Yehovaniru ’diyini yi dezu ’borisi dria, eri nga ovu alatararu; eri ma ku dri’bi i driarini duzu izuru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        }
