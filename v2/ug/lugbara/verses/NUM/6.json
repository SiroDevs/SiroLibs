                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du erini i esele cozu ndu Yehova vu ’diyisi dria ma esi ’ba avu vu ogogo ku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
