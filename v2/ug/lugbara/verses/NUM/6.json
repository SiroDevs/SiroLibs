              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.7"
              },
              "items": [
                {
                  "text": "Lev 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.22"
              },
              "items": [
                {
                  "text": "14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te o’du arorisi eri ma eji a’balau angarakaru ’diyi iri, kani a’balau o’buru ma anzi iri kuhani dri hema ti ecizaniri ma tilea. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhanini nga di aluri ede edeta e’yo onzi edezuriru, aziniri edeta vezaruriru e’yo onzi erini edezu, erini ezale ’ba drapiri ma e’yosirisi, nga eri ma dri ’ba alatararu dika o’du nde ’darisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma co i esele ndu Yehova vu o’du erini i esele cozu ’diyisi, eri ma eji vini kabiloago eli be aluri edetaru e’yo eri ndepiri edezu; te o’du oko ’dayi ngani la ku, e’yo erini i esele cozu ndurini i ezalerisi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
