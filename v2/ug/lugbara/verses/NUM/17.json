                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa nga kali ’diyi o’ba tani mbazu Yehova ma drilia hema e’yo eti nzezaniri ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
