                "loc": "EXO.16.32"
              },
              "items": [
                {
                  "text": "Efu 16:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.19+NUM.31.20+NUM.31.21+NUM.31.22+NUM.31.23+NUM.31.24+NUM.31.25+NUM.31.26"
              },
              "items": [
                {
                  "text": "Kal 31:19-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’Yehova ’yo Musa ma tia, Mi omvi kali Aronini eri ’bazu e’yo eti nzeza ma drilia dika, tani mbazu ecetaru anzi mbupi Yehova ma ruaasi amve ’diyi dri, mi ma fe ani yi ma ku onoza onozu ma driari ja, yi kazu odrazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nga di ’ye ’dini, eri ’ye ekile Yehovani azile eri dririle ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Israelini nga ’yo Musa tia kini, Mi ndre, ama odra odra, ama dri ja ja, ama dri ja dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
