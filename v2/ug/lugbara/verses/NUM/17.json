              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo Musa tia, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ’yo e’yo anzi Israelini ma tia, mi ma a’i kali yi dri yi ma a’bipi ma suruti vusi alu alu, mi ma a’i kali mudri drini iri ’ba opiru yi ma drilia ’diyi dri, yi ma a’bipi ma suruti vusi. Mi ma si ’ba alu alu ma ru kali erini ma ruaa ci. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma si Aroni ma ru kali Leviniri ma ruaa; a’disiku ’ba yi ma a’bipi ma suruti drilia ’diyi alu alu ma ovu kali yini be. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
