                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Kal 16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga i ’ye ’dini, ’ba mani peleniri ma kalini nga egbi ra; te ma mani nga fe ’ba Israelini ma ku onoza yini onole mi driari ja. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nga di e’yo ’yo anzi Israelini ma tia ani; te ’ba opiru yi ma drilia, ’diyi dria nga kali fe eri dri, kali alu opi alu alu vusi, yi ma a’bipi ma suruti vusi, kali nde dria mudri drini iri; kali yini ’diyi ma eselia kali alu Aroniniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
