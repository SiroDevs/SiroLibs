            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba alu alu esipi ogogo, capi bere Yeho­vani vu ogogo ’diyi adri odra dria ra. Ama dria nga dri ja ra ya?",
          "type": "text",
