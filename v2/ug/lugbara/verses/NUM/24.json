                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balamu ka ndre Yehova le asi ndriza fe Israeli dri ra, eri muni ekile ndra okorile andri ndrizasi ku, te eri ’ba i mile angu roko driari vuleru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu nga i mile enga uru, nga Israeli ndre yini riria suru yini vusi suru yini vusi; Orindi Munguni nga di eca eri ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki nga di ovu adrasi Balamu be, eri nga i dri sa sa; Balaki nga ’yo Baramu ma tia, Ma omve mi ari’ba mani otrizu, te mi ndre, mi fe yi dri asi ndriza teketeke pale na ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te curu’do mi ma apa mi paria vile; ma ega te ma nga mi idri inzita isuzu amboru tu, te mi ndre, Yehova oga mi inzita isuko si. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu nga di ’yo Balaki ma tia, Ma ’yoni vini ndra ojio mini, mini ti pele ma vu ’diyi ma tia, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki ka te tro i ma jo gapi dahabu pisi mele be treri fe’i ti, ma econi agazaru e’yo Yehovani ’yoleri drisi ku, mani ani e’yo onyiru kani e’yo onzi ’yezu ma drisi, te e’yo Yehovani ’yoleri ma nga ’yo’i­’diniri ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Curu’do ma di mvi ’ba mani vu mvi mvi; te di, ma nga e’yo suru ’dorini ngale ’yele suru mini vu ewu vilerisiri olu mi tia ra.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
    },
    {
