                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Levini nga yi ma dri o’ba monio ’diyi ma dria; mi nga ani aluri fe edeta e’yo onzi edezuriru, aziniri edeta vezaruriru Yehova ma drilia, ’ba Levini ma e’yo onzi edezu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nga ’ba Levini ’ba Aroni pi ma milia anzipi be, nga yi fe Yehova dri edeta oyale oyariru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 8:14"
          },
          "items": [
