        {
          "text": "Mi olu Aroni ma tia, mi ’yo tinia, Mi ka tala ’i ra, tala aziri ma di tala pati ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
