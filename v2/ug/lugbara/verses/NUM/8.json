          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni nga di ’ye ’dinile; eri talani ra, diza fezu ani tala pati ma drilia beni, Yehovani azile Musa ma tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
