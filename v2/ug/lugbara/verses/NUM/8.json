              "items": [
                {
                  "text": "Efu 29:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga ’ba Levini ’ba alaru yi ofezu, edeta oyale oyariru raka, yi nga di fi hema ti ecizaniri ma azi ngazu ndo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.15",
            "verseOrgIds": [
              "NUM.8.15"
            ]
          }
        },
        {
