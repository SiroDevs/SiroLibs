              "items": [
                {
                  "text": "Lev 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga ’ba Levini ji fe e’dazu hema ti ecizaniri ma drilia; mi nga anzi Israelini ongulumuru ’diyi oku dria. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 8:10"
          },
          "items": [
