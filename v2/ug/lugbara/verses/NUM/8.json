              "items": [
                {
                  "text": "Mal 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga ’ba Levini ma esele co anzi Israelini be ndu ’dinile; ’ba Levini ’diyi nga ovu mani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
