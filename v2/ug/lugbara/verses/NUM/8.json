          "items": [
            {
              "text": "Efu 25:31, 18, 40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala pati ma edezari ’dini, ede eri mele dile dirisi kpere etinialeru trua funialeru, di eri di di, ekile eceta Yehovani ecele Musa dri ’borile, yi ede eri ’dinile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
