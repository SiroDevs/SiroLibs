              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.27"
              },
              "items": [
                {
                  "text": "14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi dria anzi Daudini ’diyi, drinia oku erini azini ’diyi ma anzi yi indi; Tamarini yi ma amvi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
