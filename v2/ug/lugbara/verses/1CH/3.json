                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oti anzi eri dri azia Hebironia; ’daa eri ovu opiru eli aziri drinia mba azia, te Yerusalemua ovu opiru eli kali na drini na indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
