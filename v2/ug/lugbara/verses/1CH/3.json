              },
              "items": [
                {
                  "text": "2 Sam 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "towiri Sefatia, Abitalini tileri; aziari Itireamu, oku erini Egilani tileri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
