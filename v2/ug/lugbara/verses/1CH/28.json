                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini anzi mani dria ’diyi ma eselia (Yehovani anzi fele ma dri kakaurisi) eri pe ma mvi Sulemani’i rizu oguna opi Yehovaniri ma dria i Israelini ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
