          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’bi vini indi mele nzizasi talapati meleru ’diyisi, tala yini were ’diyi be, nziza yiniri vusi nziza yiniri vusi, talapati driasi tala erini were ’di yi be; azini ’dinile indi talapati dahaburu ’diyisi eri o’bi dahabu nzizasi nzizasi, talapati dria alu aluni, tala erini were ’diyi be, ayuza tala nde alu aluni ma azita vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
