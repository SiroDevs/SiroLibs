                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga opi nyaza erini fe pa sozu kirikiri ’dani, eri ka nga ovu asi adarusi azita mani piyi ’yezu e’yo liza mani ’diyi be, ekile o’du ’disirile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
