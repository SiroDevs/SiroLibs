          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri o’bi mele afazu meleni ’diyisi nziza yiniri vusi, afazu dria azi ndu ndu ngazu ’diyisi; eri o’bi dahabu afazu edele dahabusi ’diyisi nziza yiniri vusi, afazu dria azi ndu ndu ngazu ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
