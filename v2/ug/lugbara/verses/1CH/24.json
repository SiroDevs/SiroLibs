            }
          ]
        },
        {
          "text": "Musi anzipi: Mali pi, Ederi pie, Yerimoti pie. ’Ba ’diyi ndra anzi Levini atapi yini ma ori’ba vusi ori’ba vusi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
