                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mali anzipi ma eselia: Eleazari agupianzi kokoruri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
