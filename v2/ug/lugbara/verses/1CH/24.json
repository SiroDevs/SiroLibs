                }
              ]
            }
          ]
        },
        {
          "text": "Me­rari anzipi yi ’di: Mali pi Musi be. Yaazia anzipi: Beno piyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
