        {
          "text": "’Dinile ’ba awa yi odrisi ’bezasi suruti alu suruti aziniri be; ’ba azini yi opianzi pari alatararuni ’diyi, azini ’diyi opianzi Munguni, yi iri tro enga Eleazari anzipi ma eselia Itamari anzipi be. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        },
