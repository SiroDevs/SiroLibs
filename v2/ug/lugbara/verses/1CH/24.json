                  "text": "26:61",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Nadabu pi Abihu be odra ndra yi ma atini oko, anzi yini yo, e’yo ’disi Eleazari pi Itamari be nga azi atalau edeta edepirinini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi pi Zadoki Eleazari anzipi ma eseliari pie, Ahimeleki Itamari anzipi ma eseliari be, awa yi ndu ndu amutisi amutisi azi yini alia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu de yi isu ’ba ’wara Eleazari anzipi ma eselia ’diyi ma kalafe aga ’ba Itamari anzipi ma eselia ’diyi ma kalafe ra; awa yi ’dinile ani. Eleazari anzipi ma eselia anzi mudri drini azia, ’ba atapi yini ma ori’ba dri cepi ’diyi; azini Itamari anzipi ma eselia atapi yini ma ori’ba vusi yi aro, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
