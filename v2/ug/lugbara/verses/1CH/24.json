              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mudri dririi towiri Biliga dria, mudri drini aziari Imeri dria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.14",
            "verseOrgIds": [
