        },
        {
          "text": "Aroni anzipi: Nadabu pi, Abihu pi, Eleazari pi, Itamari pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
