              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisi vile ’diyi ma eselia, Kisi anzipi: Yera­meeli piyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
