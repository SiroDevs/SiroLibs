                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hebironi anzipi ma eselia: ’ba ambori Yeria’i, iriri Amaria’i, nari Yahazieli’i, suri Yeka­meamu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
