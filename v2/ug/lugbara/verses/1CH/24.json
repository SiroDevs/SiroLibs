          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzieli anzipi, Mika piyi; Mika anzipi ma eselia, Samiri piyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
