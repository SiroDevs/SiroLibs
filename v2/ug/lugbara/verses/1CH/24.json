          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika adrini, Isia’i; Isia anzipi ma eselia, Zekaria’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
