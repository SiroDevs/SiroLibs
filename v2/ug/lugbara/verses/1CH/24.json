          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mera­ri anzipi: Yaazia vile ’diyi, Beno pi, Sohamu pie, Zakuri pie, Ibiri pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
