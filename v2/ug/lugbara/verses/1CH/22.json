                "loc": "1CH.29.1"
              },
              "items": [
                {
                  "text": "1 Sur 29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi ’yo ra, Ma mvi Sule­mani ovu nga mvani, ruani nga ’bele­’beleru, te jo ’bani ngale sile Yehova driri ma ovu inzita be amboru tu, ru kuza be, azini dizani ma ca angu ndu ndu ma alia dria; ma nga di ani edeta ede erisi ngonde beni. E’yo ’disi Daudi ede di afa tu de nga eri drani ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di i ma mvi Sulemanini omve, azi tinia jo sizu Yehova dri, eri Mungu Israeliniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
