                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi ’yo i mvi Sulemani ma tia kini, Ka te mani egale ma asiarisi, ma le te ma ma si jo ru Yehova Mungu manini dri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
