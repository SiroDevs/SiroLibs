                "loc": "1KI.7.47"
              },
              "items": [
                {
                  "text": "1 Opi 7:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini Daudi ede aya kakau musumariru jotile kalitilea ’diyini, azini afa eciza ’diyisi, azini mola kakau kalafe kokoru, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
