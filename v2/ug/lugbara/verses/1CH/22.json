                "loc": "1KI.5.6"
              },
              "items": [
                {
                  "text": "1 Opi 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini mario pati kalafe lakokoru; ’ba Zidonini, azini ’ba ovupi Turoa ’diyini mario pati ejile Daudi vu kakaurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
        {
