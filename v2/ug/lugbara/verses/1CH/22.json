            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.3"
              },
              "items": [
                {
                  "text": "1 Sur 28:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Te e’yo Yehovani eca ma vu ’yozu kini, Mi ada ari ’bani tu ambamba, mi’di a’di tu; mi ngani jo si ru mani dri ku, a’disiku mini ’ba ma ari adale nyaku dria ma ma milia turisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
