                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do, ma mvi, Yehova ma ovu mi be, mi ma ’ye drilebasi, mi si; Yehova Mungu minini, ekile erini e’yo ’yole misi ’borile fo! ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
