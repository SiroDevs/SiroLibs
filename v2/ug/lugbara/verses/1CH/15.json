          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi nga Aroni anzipi piyi oku ’ba Levini be dria tualu: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.4",
            "verseOrgIds": [
              "1CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 15:5"
