                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yob 42:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Mungu ka ’ba Levini sanduku aziza Yehovanirini ejipi ’diyi ma aza ko ra, yi oso monio aziri kabiloago aziri be edetaru Yehova dri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi su bongo ndrizaru mile be nyiriri, ’ba Levini sanduku ejipi ’diyi pie dria, ’ba ongo ngopi ’diyi pie, Kenania ’ba ongo imbapiri pie, ’ba ongo ngopi ’diyi be; Daudi su de koti alinaru edele bongo mile be nyiririsiri i ma ruaa ci. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
