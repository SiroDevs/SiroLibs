        },
        {
          "text": "Daudi oku ’ba Israelini dria Yerusalemua sanduku Yehovani ejizu i pari erini edele eri driria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
