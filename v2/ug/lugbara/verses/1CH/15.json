              },
              "items": [
                {
                  "text": "68:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi nga ’yo ’ba ’wara ’ba Levini ma dri cepi ’diyi ma tia adripi yini ongo ngopi ’diyi azizu afa yini ongo ngozu ’diyi be, afa zaburi ngozuri pi, o’di pie, aya cole cori pie, yi ma otre o’dukosi uru azini yi ma enga o’duko yini uru ayikosi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
