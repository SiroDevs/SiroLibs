                "loc": "EXO.6.16+EXO.6.17+EXO.6.18"
              },
              "items": [
                {
                  "text": "Efu 6:16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "engazu anzi Kohatini ma eseiia, Urieli ’ba yi dri cepiri pi adripi erini ’diyi be turu alu drini kali iri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "engazu anzi Merarini ma eselia, Asaya ’ba yi dri cepiri pi adripi erini diyi be turu iri drini kali iri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
