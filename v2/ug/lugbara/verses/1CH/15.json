            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.8"
              },
              "items": [
                {
                  "text": "1 Sur 13:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dinile ’ba Israelini dria eji di sanduku aziza Yehovanirini oyuta pisi, o’duko ejelekoni pie, guka amboru ’diyi pie, aya cole cori pie, otrezu o’duko urusi, afa zaburi ngozuri cozu okposi o’di pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
