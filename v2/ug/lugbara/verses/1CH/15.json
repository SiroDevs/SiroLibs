                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ’ba Levini yi pe Hema­ni Yoeli mvi pi; azini adripi erini ma eselia Asafu Berekia mvi pie; azini adripi yini ma eselia anzi Merarini Etani Kusaya mvi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba ’diyi be tualu yi pe adripi yini tindi iriri Zekaria pi, Beni pie, Yaazieli pie, Semiramoti pie, Yehieli pie, Uri pie, Eliabu pie, Benaya pie, Maaseya pie, Matitia pie, Elifelehu pie, Mikineya pie dria, azini Obedi-edo­mu pi Yeyeli be, ’ba jotile agei tepi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini yi pe di ’ba ongo ngopi ’diyi Hemani pi Asafu pie, Etani be, aya molaru cozu o’duko urusi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini yi pe Zekaria pi, Azieli pie, Semiramoti pie, Yehieli pie, Uri pie, Eliabu pie, Maaseya pie, Benaya pie, ongo ngozu afa zaburi ngozu o’duko Alamotini vusirisi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi ’ba Matitia pi, Eli­felehu pie, Mikineya pie, Obedi­edomu pie, Yeyeli pie, Azazia pie, ’ba dri cezu o’di o’duko Seminitini vusirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenania ’ba ambo ’ba Levini so pa ongo ma driliani; eri ’ba imba ongosini, erini ovule ondua­rurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berekia pi Elikana be, azi yini lotile ma agei tezu sanduku ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
