              "items": [
                {
                  "text": "Zab 81:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sebania pi, Yosafati pie, Netaneli pie, Amasai pie, Zekaria pie, Benaya pie, Eliezeri pie, yi atalau edeta edepi ’diyi, yi guka vu sanduku Munguni ma driliani. Obedi-edomu pi Yehia be yi jotile ma agei te sanduku ma e’yosini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        },
