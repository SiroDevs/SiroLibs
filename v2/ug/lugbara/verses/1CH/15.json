          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "engazu anzi Gerisomuni ma eselia, Yoeli ’ba yi dri cepiri pi adripi erini ’diyi be turu alu drini kali na; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
