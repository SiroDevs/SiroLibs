        },
        {
          "text": "Sebueli Musa mvi Gerisomu ma mvi ovu ’ba dri cezu pari lonyi ta mbazu ’diyi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
