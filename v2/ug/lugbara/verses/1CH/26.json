                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Su­pimu pi dri Hosa be, woko etuni ’derialeruri, kalitile Saleketini vu ogogo, geri tuzaru ’bani e’dulule uru pari tezuri vusi pari tezuri vusiria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etuni efurialeru ’ba Levini azia, kala andraleruria ’ba su o’du alu alu vusi, uruleruria ’ba su o’du alu alu vusi, jo afa ta mbazurisi ’ba iri iri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paribari kala etuni ’derialeru geri ’bani e’dulule ururia ’ba su, azini Paribaria ’ba iri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuti aziniri ’ba jotile agei tepi ’diyini, yi ndra ’diyi; amuti nde ’diyi ovu Kora anzipi piyini Merari anzipi be. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        },
