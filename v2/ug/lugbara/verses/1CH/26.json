              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehieli anzipi, Zetamu pi adripi Yoeli be, yi ovu pari lonyi jo Yehovaniari ma ta mbazu ’diyi ma dria. ",
          "type": "text",
          "attrs": {
