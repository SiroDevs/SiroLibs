                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adripi erini ’diyi: Eliezeri ti mvi erini Rehabia, Rehabia ma mvi Yesaya’i, Yesaya mvi Yoramu’i, Yoramu mvi Zikiri’i, Zikiri mvi Selomoti’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
