            "number": "7",
            "style": "v",
            "sid": "1CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo ’diri ovu onzi Mungu ma milia, eri ofu ’ba Israelini ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.7",
            "verseOrgIds": [
