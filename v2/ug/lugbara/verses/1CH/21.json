        },
        {
          "text": "Daudi omvi e’yo Gadi ma tia kini, Ma aba tu, ma ma ’ye ngoni yani; bani ma ma e’de di Yehova ma dria ani, yiki erinirini ovule amboru turisi; ma ma e’de ’ba ma dria ku fo! ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
