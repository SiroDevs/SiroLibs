        },
        {
          "text": "Te eri lani ’ba Levini piyi ’ba Benyaminini ’diyi be indi ku, a’disiku opi ma e’yoni ovule anguonziru Yoabu ma miliarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
