              "items": [
                {
                  "text": "2 Sur 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku hema Yehovani Musani ndra edele angu roko driari, pari edeta vezaruni be, yi ovu o’du ’dasi pari uruleru Gibeoniaria; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
