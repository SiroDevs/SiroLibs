          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini Yehova fe azo muani ’de ’ba Israelini ma dria; ’ba Israelini o’depi odrapi ra ’diyi kalafeni alifu kali aziri. ",
          "type": "text",
          "attrs": {
