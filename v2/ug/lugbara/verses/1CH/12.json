        {
          "text": "Isimaya ’ba Gibeonini, eri ’ba okporu alu ’ba kali na ma eseliari, eri ’ba kali na nde ’diyi ma driliari’i; Yeremia pi, Yahazieli pi, Yohanani pi, Yozabadi ’ba Gederatini pi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
