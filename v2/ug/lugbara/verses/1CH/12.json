                  "text": "49:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi ’ba zopi mba okorisi Yoridania ’aa’dasi ’diyi, o’du yi ndeni tizu cirisi, yi fe ’ba ovupi e’bu alia ’diyini apazu dria ra, kala etuni efurialeruri pia etuni ’derialeruri be iri tro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te anzi Benyaminini pi ma eselia Yudani be, ’ba azini emu pari okporua Daudi vu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
