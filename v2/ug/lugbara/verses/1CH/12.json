            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eluzai pi, Yerimoti pi, Bealia pi, Semaria pi, Sefatia ’ba Harufini pi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elikana pi, Isia pi, Azareli pi, Yoezeri pi, Yasobeamu pi, yi ’ba Koranini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoela pi, Zebadia be, yi anzi Yerohamu ’ba Gedoriarini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        },
