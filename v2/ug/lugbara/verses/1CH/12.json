            }
          ]
        },
        {
          "text": "Azini ’ba Gadini ’diyi ma eselia ’ba azini co yi ma esele muzu Daudi vu pari okporu roko driaria, ’ba okporu asi teza be, ’bani imbale a’di ’diza ma e’yosi ’bo ’diyi, ’ba ecopi gombere ombani ayupi aju be ra, yi ma andretini ovuzu ekile kami ma andretile ’diyi, yi ovu ongu be ekile oborojo oni dria ’diyi1e. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezeri ’ba amboru yi driliari, ’ba iriri Obadia, nari Eliabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "suri Misimana, towiri Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aziari Atai, azi­riri Elieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "arori Yohanani, oro­miri Elizabadi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mudriri Yere­mia, mudri drini aluri Makibanai’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’diyi anzi Gadini ma eselia yi asikari ongulumuru ma dri cepi ’diyiru, ’ba werearu si ’ba turule, ’ba amboru turi si ’ba alifu alule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
