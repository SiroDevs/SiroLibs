              },
              "items": [
                {
                  "text": "Lip 20:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ’ba osu be ’diyi, azini yi eco yi ma dri ayuzaru irile irile, dri ndi dri eji be, oni ’bani ’bele bakasiri yazu, ’ye gbizu osusi indi; yi ’ba Saulo ma adripiru, suru Benyaminini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
