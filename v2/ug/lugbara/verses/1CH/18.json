              },
              "items": [
                {
                  "text": "Azi 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi fu vini Hadarezeri opi amboru Zobaari cazu kpere Hamatia, erini siria i ma suru ’baria okporu yi ara Ufirate ma tia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.4"
              },
              "items": [
                {
                  "text": "2 Sam 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi opa gari ombani eri vu alifu alu, azini ’ba nzupi akanyasi ’diyi alifu aziri, asikari acipi pasi ’diyi alifu kali iri pie; Daudi oli akanya garini dria ma pa isu, te eri ku azini turu alu gari ombani sezu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Suriaa ovupi Damasikia ’divi ka emu Hadarezeri opi amboru Zobaari ma aza kozu, Daudi ofu ’ba Suriani ’diyi alifu kali iri drini iri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
