              "items": [
                {
                  "text": "2 Sam 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini Benaya Yehoyada mvi ovu ’ba Keretini piyi ma drilia ’ba Peletini be; azini anzi Daudini yi ovu ’ba amboru opi ma ageia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
