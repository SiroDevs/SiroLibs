                "loc": "2CH.25.11"
              },
              "items": [
                {
                  "text": "2 Sur 25:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu de vini Abisai Zeruya mvi ofu ’ba Edomuni E’bu A’inia ’ba alifu mudri drini aro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
