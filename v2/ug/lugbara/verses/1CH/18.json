              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’diri ma vutia eri nga eca ’dini, Daudi ofu ’ba Filisitiaa ’diyi ra, nde yi ombasi indi, eri opa Gatu pi aku erini ambo ambo ’diyi be dria ’ba Filisitiaa ’diyi ma driarisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.17"
              },
              "items": [
                {
                  "text": "Kal 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ofu ’ba Moabuni indi; ’ba Moabuni nga ani yi oja ati’baru Daudi dri, nga afa feza fe indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
