              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.31"
              },
              "items": [
                {
                  "text": "O’be 21:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Daudi o’ba di asikari aku agei tepi ’divi Suria Damasikiaria ci; azini ’ba Suriani ’diyi oja yi ati’baru Daudi dri, eji afa feza. Azini Yehova fe Daudini agazu pari erini muzuria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi opa gombere ombani edele melesi ndra ovupi ati’ba Hadarezerini ma ruaa ’diyi dria ejizu Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
