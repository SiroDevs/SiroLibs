              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15"
              },
              "items": [
                {
                  "text": "1 Opi 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Sur 4:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini engazu Tibihatia, azini Kunia, aku ambo ambo Hadarezerini ’diyi, Daudi o’du mola kakau tu; mola ndesi Sulemani ede ani miri molaru pi, idiafe pie, afazu molaru ’diyi be dria.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        }
      ]
