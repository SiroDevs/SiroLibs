            }
          ]
        },
        {
          "text": "Inzi ndra Yabezini aga adripiyi ra; andri ’da ndra ani runi Yabezi’i, kini, Mani eri osile candi berisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
