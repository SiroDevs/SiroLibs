                "loc": "1SA.15.8"
              },
              "items": [
                {
                  "text": "1 Sam 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.17"
              },
              "items": [
                {
                  "text": "30:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.12"
              },
              "items": [
                {
                  "text": "2 Sam 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ofu ’ba joloko Amalekini andra apapi ’diyi ra, yi ovu ’dale ecazu kpere andru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
