                }
              ]
            }
          ]
        },
        {
          "text": "Te Yabezi wu Mungu Israelini vu kini, Mi ma fe drileba ma dri adaru, mi ere kalati mani, azini mi dri ma ovu ma be ani, ’dini mi ma mba ma ta azi onzisi, eri ma ovu candi maniru ku fo! Ka’dini Mungu fe eri dri e’yo erini zileri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelubu Suha ma adri ti Mehiri ovupi ndra Esitoni ma atirurini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esitoni ti Beti-rafa pi, Pasea pie, Tehina Irinahasi ma ati pie. ’Ba ’diyi ovu ’ba Rekani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.17"
              },
              "items": [
                {
                  "text": "Yos 15:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kenazi anzipi: Otinieli pi Seraya be; Otinieli anzipi: Hatati piyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.11.35"
              },
              "items": [
                {
                  "text": "Neh 11:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meonotai ti Ofira­ni; Seraya ti Yoabu Geharasimu ma atini, yini ovule onduou afa edepi ’diyirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu Yefune mvi ma anzipi: Iru pi, Ela pi, Naamu pie; Ela anzipi pie, Kenazi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye­haleleli anzipi: Zifi pi, Zifa pi, Tiria pi, Asareli pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezira anzipi: Yeteri pi, Meredi pi, Eferi pi, Yaloni pie; oku erini ti vini Miriamu pi, Samai pi, Isiba Esitemoa ma ati pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku erini Yahudi zaruri ti Yeredi Gedori ma ati pi, Heberi Soko ma ati pie, Yekutieli Zanoa ma ati pie. Anzi ’diyi ovu anzi Bitia Farau zi, Mere­dini ’dulerini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahamu ma amvi, Hodiani ’dule okururi ma anzi yi Keila ’ba Garimuni ma ati pi, Esitemoa ’ba Maakatini be. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si­moni anzipi: Aminoni pi, Rina pi, Beni-hanani pi, Tiloni pie, si anzipi: Zoheti pi Beni-zoheti be. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.1"
              },
              "items": [
                {
                  "text": "E’do 38:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sela Yuda mvi ma anzipi: Eri Leka ati pi, Laada Maresa ma ati pi, ’ba bongo mile be nyiriari edepi ’diyi ma ori’ba, ovupi Asebea ma ori’baru ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.2"
              },
              "items": [
                {
                  "text": "2 Sam 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yokimu pi, ’ba Kozebaa ’diyi pie, Yoasi pi, Sarafi ndra angu nyapi Moabuari pi, Yasubi-lehemu pie. Te e’yo ’diyi e’yo drioni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ’ba imvu sipi ’diyi, ’ba Netaimu pia Gedera be ’diyi pie; yi ovu ’daa opi pie azi eriniri ’yezu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
