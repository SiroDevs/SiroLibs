          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini vini suru ’ba Israelini ma drilia, ’ba Rubenini ma eseliari eri ndra Eliezeri Zikiri ’ba ’ba dri cepiri ma mvi’i; ’ba Simeonini ina eselia Sefatia Maaka mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        },
        {
