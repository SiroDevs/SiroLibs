          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba towiri ’ba dri cepi mba towisiri ndra Samihuti ’ba Izirani’i; amuti erini ma alia ’ba ndra alifu kali iri drini su. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
