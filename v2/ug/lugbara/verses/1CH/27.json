            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "anzi Efiraimuni ma eselia Hosea Azazia mvi’i; suru ali Manaseni ma eselia Yoeli Pedaya mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru ali Manaseni Gileadi aliari ma eselia Ido Zekaria mvi’i; ’ba Benyaminini ma eselia Yaasieli Abineri mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba Danini ma eselia, Azareli, Yerohamu mvi’i. ’Ba ’diyi ndra suru ’ ’ba Israelini ma dri cepi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
