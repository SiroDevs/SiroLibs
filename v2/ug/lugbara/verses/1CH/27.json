                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba suri ’ba ma dri cepi mba susiri ma aliari ndra Asaheli Yoabu adri’i, eri ma vutia eri ma mvi Zebadia’i; amuti erini ma alia ’ba; ndra alifu kali iri drini su. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
