        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.29"
              },
              "items": [
                {
                  "text": "E’do 38:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ovu Perezi anzipi ma eselia, ’ba amboru ’ba asikari ongulumuru ma dri cepi ’diyi ma drilia mba okori ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.9"
              },
              "items": [
                {
                  "text": "2 Sam 23:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuti mba iririni ma drilia ndra Dodai ’ba Ahohini’i, eri’i amuti erini pie, opi Mikiloti pie; amuti erini; ’ba alifu kali iri drini su. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
