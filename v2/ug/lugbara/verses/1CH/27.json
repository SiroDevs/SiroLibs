              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba Zebulunini ma eselia Isimaya Obadia mvi; ’ba Nafutalini ma eselia Yeremoti Azirieli mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
