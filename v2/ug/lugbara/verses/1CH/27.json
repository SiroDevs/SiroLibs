                  "text": "1 Sam 16:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba Yudani ma eselia Elihu’i, adripi Daudini ma azi; ’ba Isakarini ma eselia Omiri Mikaeli mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
