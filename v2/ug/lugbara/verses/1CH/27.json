                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amuti okori mba okorisiri ma drilia ndra Yasobeamu Zabidieli mvi’i; amuti eri vileri ma alia ’ba ndra alifu kali iri drini su. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 27:3"
          },
          "items": [
