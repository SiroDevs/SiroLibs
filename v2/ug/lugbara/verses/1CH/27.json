              "items": [
                {
                  "text": "1 Opi 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba nari asikari ongulumuru ma dri cepi mba narisiri ndra Benaya, Yehoyada atalau edeta edepiri ma mvi, ’ba amboruni; amuti erini ma alia ’ba alifu kali iri drini su. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
