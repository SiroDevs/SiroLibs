                "loc": "ISA.37.4"
              },
              "items": [
                {
                  "text": "Isa 37:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi ’yo ’ba Israelini yi okupi ’diyi ma tia dria kini, Eri ka ovu emi milia ba, azini e’yoni ka enga Yehova Mungu amani vu, ama pe di e’yoni ma ti pari dria adripi amani kule angu Israelini dria ma alia ’diyi vu, yi’i ovupi atalau edeta edepi ’ba Leviniru ’diyi be, aku ambo ambo aku nyiri nyirini ovuzu yi ma ageia ’diyi ma alia ’diyi, ’dini yi ma oku yi ama vu ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
