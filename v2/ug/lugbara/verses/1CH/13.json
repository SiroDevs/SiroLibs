              "attrs": {
                "loc": "1SA.4.4"
              },
              "items": [
                {
                  "text": "1 Sam 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi tu di ani ’ba Israelini be dria uru Baala vu, angu nde Kiriati-yearimu ovupi Yudani­ri’i, muzu sanduku Munguni ejizu engazu ’dale, eri Yehova ripi kerubi ma dria uru, yini omvele Ru ndesiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.4.15"
              },
              "items": [
                {
                  "text": "Kal 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ni nga ani sanduku Munguni ’du gari o’diru ma dria, yi ofu eri engazu Abinadabu vile joarisi; Uza pi Ahio be dro gari ndeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.5"
              },
              "items": [
                {
                  "text": "2 Sam 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi pi ’ba Israelini be dria nga avi okposi tu Mungu ma drilia, adani yi avi ongo pisi, o’di pie, zaburi ngoza pie, ari were ayioro beri pie, aya cole co ’diyi pie, guka pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.6"
              },
              "items": [
                {
                  "text": "2 Sam 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ka eca akuma anya dizu Cidoniaria, Uza eju i ma dri sanduku Munguni bizu, ranya ma pani nzolerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
