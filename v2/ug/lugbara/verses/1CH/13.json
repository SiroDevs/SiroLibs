              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ma mu sanduku Mungu amanirini omvizu ama vu dika ani; amani ndra mule vunia e’yoni zizu ewu Saulo ngare kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria ndra yi okupi ’diyi a’i kini yi nga ’ye ’dinile ra, e’yo ndeni ovule kililiru ’ba dria ma miliarisi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
