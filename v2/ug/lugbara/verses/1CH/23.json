                  "text": "1 Sur 24:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musi anzipi: Mali pi, Ederi pie, Yeremoti be, yi na. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
