        },
        {
          "text": "Daudi nga di ’ba ’wara Israelini ’diyi oku dria, atalau edeta edepi ’diyi pie, ’ba Levini pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
        },
        {
