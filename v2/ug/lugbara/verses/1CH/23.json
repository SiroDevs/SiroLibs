          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "te e’yo Daudini ’yole asizurisi ’ba la ndra anzi Levini ma kalafe, e’dozu ’ba capi eli be kali iri ’diyisi muzu drile- ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "te azi yini ovu anzi Aronini ’diyi ma aza kozu jo Yehovaniri ma azi ngazasi, iriidri ma alia azini jo aliza ’diyi ma alia, afa alatararu dria ’bazu alatararu, adani azi ngaza azi jo Munguniri ma aliarisi dria; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
