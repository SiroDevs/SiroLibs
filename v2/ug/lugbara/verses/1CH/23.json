                  "text": "4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi anzi Levini atapi yini ma ori’ba vusi, atapi yini ma ori’ba vusi, ’ba atapi yini ma ori’ba dri cepi ’diyi, ’ba ’bani lale ra ru yini ma kalafeni ovuzu dri ’bani vusi, yi’i azi jo Yehovani ma aliari ngapi ’diyi, e’dozu ’ba capi eli be kali iri ’diyisi muzu drile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini ’yolerisi kini, Yehova Mungu Israeliniri fe ava liza ’ba ini ’diyi dri ’bo; eri adri Yerusalemua ’dani ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
            "verseOrgIds": [
              "1CH.23.25"
            ]
          }
        },
