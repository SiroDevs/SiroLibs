              "attrs": {
                "loc": "NUM.4.5"
              },
              "items": [
                {
                  "text": "Kal 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini indi ngani le ’ba Levini ma ’du hema pi afazu erini ’bani lele azinirisi ’diyi be dria dika ku- ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
