                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amani ndra nga ovuria emi be indi, ama azi e’yo ’diri emi tia, kini: Agu ka le azi nga ku, ma nya nyari ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.10",
            "verseOrgIds": [
              "2TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 3:11"
