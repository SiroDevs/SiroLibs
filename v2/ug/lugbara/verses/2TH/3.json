              "items": [
                {
                  "text": "2 Kor 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ’ba ama asi Opi ma dria e’yo eminisi ’bo, nizu kini emi e’yo amani azile emi tia ’diyi ’ye, azini emi nga yi ’ye ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi ma ce asi emini ma dri kililiru leta emini Mung lezuri ma alia, cazu asi teza Kristoniri vu.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
      ]
