                {
                  "text": "1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ngulupi ni geri onyiru emini te ngazu ovuzu amaleri; a’disiku ama acini ndra emi eselia saaru ku, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.7",
            "verseOrgIds": [
              "2TH.3.7"
