            }
          ]
        },
        {
          "text": "Ovuni kini ama ovuni okpo be ’yezu ’dinile ku, ’dinirii ku, te ama le ama ma ngulupi ’bazu ecetaru emi dri, emini ani ’yezu amani ’yelerile beni. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.9",
            "verseOrgIds": [
              "2TH.3.9"
            ]
          }
        },
        {
