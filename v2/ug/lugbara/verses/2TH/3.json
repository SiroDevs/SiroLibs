              "attrs": {
                "loc": "1TH.4.11"
              },
              "items": [
                {
                  "text": "1 Tes 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama e’yo azi ’ba ’dinile ’diyi ma ria, matu ’bazu yi vu Opi Yesu Kristo ma alia, yi ma nga azi asi e’yeresi, yi ma nya nyaka yi ma ngulupiniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        },
        {
