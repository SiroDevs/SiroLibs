                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama eri kini ’ba azini emi eselia acipi saaru ’diyi indi, te yi ovuouru, ngani azi aluni ku, te yi ri e’yo osu ’ba ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.11",
            "verseOrgIds": [
              "2TH.3.11"
            ]
          }
        },
        {
