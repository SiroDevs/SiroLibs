            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini Mungu ma ari ama ani ’ba e’yo ’yepi saaru ’diyi pi ma dria ’ba asi onzi be ’diyi pie; a’disiku ’ba dria ovuni a’ita be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.2",
            "verseOrgIds": [
              "2TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 3:3"
          },
          "items": [
