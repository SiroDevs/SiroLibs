              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ma ’ba eri ari’boru ’dini ku, emi ma imba eri adripile.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
