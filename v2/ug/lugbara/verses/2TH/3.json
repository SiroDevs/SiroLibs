                {
                  "text": "Gal 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te adripi, emi ma ande e’yo ’yaa onyirisi ku.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
