                "loc": "1TH.5.24"
              },
              "items": [
                {
                  "text": "1 Tes 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Opini asi adaru be, emi ’bazu okporu, emi egei tezu ’ba onziri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
          }
        },
