                }
              ]
            }
          ]
        },
        {
          "text": "Ama azi di emi tia, adripi, Opi amani Yesu Kristo ma rusi, kini emi ma ona emi adripi dria alu alu acipi saaru, e’yo amani idrile emi vu emini a’ile ’diyi ma vuti bipi ku ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.6",
            "verseOrgIds": [
              "2TH.3.6"
            ]
          }
        },
        {
