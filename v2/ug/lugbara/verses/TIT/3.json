                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama’i indi, ama ovu ndra ondua kokoru, bile kokoru, icizaru e’yosi, ovuzu au’baru li ruani pi ma alia ayiko ndu ndu ’diyi be, adrizu asi onzi pi ma alia ma’yala be, ’ba ngu ndra ama onzi, ama ngu ndra ’ba onzi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.3",
            "verseOrgIds": [
