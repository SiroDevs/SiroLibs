              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ma ku zita toko efi kokoru ’diyi pi ja, a’bianzi ma ru olazu ’diyi pie, agata gaza pie, awata awazu e’yo azitanisi ’diyi pie; a’disiku e’yo ’diyi ovu toko orodri kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
