                "loc": "1TI.3.11"
              },
              "items": [
                {
                  "text": "1 Tim 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma azi oku wara ’diyi ’dinile indi, acita yini ma si i ekile ’ba alaru ’diyinirile, yi ma di ’ba ma aji ku, yi, ma ovu ewa ma ati’baru ku; te yi ma ovu ’ba e’yo onyiru imbapi ’diyiru; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
