                "loc": "1TI.5.1"
              },
              "items": [
                {
                  "text": "1 Tim 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma imba ’ba ’wara agupiru ’diyi ovuzu mile be yi agei tezu e’yo driasi, inzita i be, asi e’yere be, ovuzu okporu a’itai pi ma alia, leta pie, asi teza pie. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
