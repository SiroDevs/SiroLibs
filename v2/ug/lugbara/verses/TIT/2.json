              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma imba agupi o’diru ’diyi ’dinile indi oyuzu asi e’yere be. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.6",
