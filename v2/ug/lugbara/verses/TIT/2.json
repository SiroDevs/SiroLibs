                "loc": "EPH.5.22"
              },
              "items": [
                {
                  "text": "Efe 5:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ma ovu asi e’yere be, alaru, ’ba aku yini ma azi ngapi ’diyi, ovuzu asi onyiru be, agupi yi ma ngulupini ma e’yo inzizu, ’ba kazu e’yo Munguni o’dazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
