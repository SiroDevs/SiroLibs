                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma kalatia Nehemia Azibuki mvi, ’ba amboru Betizuri ma woko alu ma driliari nga edeni, cazu pari nyadri Daudini ’diyi vuleruria, azini cazu yi bile biria, kpere ’ba okporu ’diyi ma joa indi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
