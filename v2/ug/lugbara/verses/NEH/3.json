                  "text": "Yoh 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Onduou meleni ’diyi pi ’ba afa ozipi ’diyi be, yi ede yini engazu pari tuzu uru ojiaria cazu Kalitile Kabiloniria.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
