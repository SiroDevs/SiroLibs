                "loc": "NEH.8.1+NEH.8.2+NEH.8.3"
              },
              "items": [
                {
                  "text": "8:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Ba Netiniadri ovu Ofelia, cazu pari ovupi Kalitile Yiari ma drilia etuni efurialeruria, azini jo izuru sile jo azini ma ruaaria). ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma kalatia ’ba Tekoa ’diyi nga esele azini ede, jo nde izuru amboru sile jo azini ma ruaari vuleruria, cazu kpere abi kaliru Ofeliaria. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        },
