                "loc": "JER.32.2"
              },
              "items": [
                {
                  "text": "Yer 32:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Palali Uzai mvi nga ede pari abi kalirurini i agozuri vuleru, jo izu sile jo uruleru opiniri ma ruaa, ovupi irii asikari opi agei tepi ’diyiniri ma ageiari be. Eri ma kalatia Pedaya Parosi mviedeni, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
