              "items": [
                {
                  "text": "Fil 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma kalatia Salumu Halohesi mvi,’ba amboru Yerusalemu ma woko alu ma driliari pi nga ede ezopi be.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
