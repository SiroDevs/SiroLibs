              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.6.1"
              },
              "items": [
                {
                  "text": "Neh 6:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Hasenaa anzipi nga Kalitile E’biniri sini; yi nga pati erini o’ba, nga tiko erini edre, nga vini aya erini pi eci katala erini be. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma kalatia Meremoti, Uriya Hakozi mvi ma mvi edeni. Yi ma kalatia Mesulamu, Berekia Mesezabeli mvi ma mvi’i. Yi ma kalatia Zadoki Baana mvi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.23"
              },
              "items": [
                {
                  "text": "Lip 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ma kalatia ’ba Tekoa ’diyi nga edeni; te ’ba ’wara yini afa azi ngazu Opi yini driri yi ma ombetia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.39"
              },
              "items": [
                {
                  "text": "Neh 12:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yoyada Pasea mvi pi nga Kalitile Okuri ede Mesulamu Beso­deya mvi be; yi nga pati erini o’ba, nga tiko erini-edre, nga vini aya erini pi eci katala erini be. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.9.3"
              },
              "items": [
                {
                  "text": "Yos 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.8"
              },
              "items": [
                {
                  "text": "Neh 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ma kalatia Melatia ’ba Gibeoniari pi nga edeni, Yadoni ’ba Meronotiari be, ’ba Gibeonia ’diyi pie ’ba Mizipaa ’diyi be. Yi ovu ’ba amboru Yi Ara tia ’aa’dasiri ma palaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.38"
              },
              "items": [
                {
                  "text": "Neh 12:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eci ma kalatia Uzieli Harihaya mvi edeni, onduou meleni ’divi. Eri ma kalatia Hanania, ’ba afa ji be arikariruri edepi ’diyi ma azi edeni; ’ba nde ’diyi yi ede abi kaliru Yerusalemuniri okporu cazu abi walaruri vu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma kalatia Refaya, Huri mvi, ’ba amboru Yerusalemu ma woko alu ma driliari edeni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma kalatia Yedaya Harumafu mvi nga edeni, jo erini vualeru; eri ma kalatia Hatusi Hasabineya mvi nga edeni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.32"
              },
              "items": [
                {
                  "text": "Ezr 2:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma­likiya Harimu mvi pi nga pari azini pi ede jo izuru pari aci eduzuriari be, Hasubu Pahati-moabu mvi be. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
