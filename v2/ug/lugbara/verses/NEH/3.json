              },
              "items": [
                {
                  "text": "1 Sam 23:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma kalatia adripi yini nga edeni: Bavai Henadadi mvi, ’ba amboru Keila ma woko aziniri ma driliari’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
