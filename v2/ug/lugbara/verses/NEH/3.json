              },
              "items": [
                {
                  "text": "2 Sur 26:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ma kalatia Ezeri Yesua mvi, ’ba amboru Mizipaari nga vini esele azini ede pari abi kalirurini i agozuria jo afa ombani ma ta mbazuriari vuleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
