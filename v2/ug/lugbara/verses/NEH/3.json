              },
              "items": [
                {
                  "text": "Neh 7:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma kalatia ’ba Yerikoa ’diyi sini, Yi ma kalatia Zakuri Imiri mvi sini. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
