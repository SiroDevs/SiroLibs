              "items": [
                {
                  "text": "Yer 31:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuhani ’diyi nga ede Kalitile Akanya vileri ma drile ururia, yi dria alu alu jo yi ngulupini vualeru. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
