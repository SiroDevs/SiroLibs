            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma’i ma ’ye ’dinile indi, adripi mani pie, ati’ba mani ’diyi pie, ama adri silingi pi fe anya be yi dri mariru. Te kirikiri ama ma ku ereni ’bazu ’diri ja. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma matu ’ba emi vu, emi ma omvi yi dri andru amvu yini, amvu zabibuni pie, amvu mizeituni pie, jo yini pie, azini emi omvi silingi pi ma esele alu turuni, anya pie, patiefi ma su pie, odu pie, emini nyale yi dri erezasiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
