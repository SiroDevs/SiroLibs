              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma azi ’yo vini kini, Ama a’i mari e’yo musoro opinirisi amvu amani pi ofezu tinia’i amvu zabibuni be. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
