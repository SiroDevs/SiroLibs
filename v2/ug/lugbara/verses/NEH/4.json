                }
              ]
            }
          ]
        },
        {
          "text": "De Tobia ’ba Amoniari ovu eri be, eri ’yo ra, Afa yini sileri-obalako ka tu drinia, eri nga abi kaliru yini sile onisi nderi asu va ra! ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
