                }
              ]
            }
          ]
        },
        {
          "text": "Te ama’i, ama zi Mungu amaniri vu, ama ’ba ’ba angu agei tepi etu vusi ini vusi ’diyi ci, yi ma e’yosi.",
          "type": "text",
          "attrs": {
