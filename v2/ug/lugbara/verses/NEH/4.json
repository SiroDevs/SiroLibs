                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pari ngoni ngori emini ngaria guka eriria, emi etru emi ama vu. Mungu amaniri nga a’di ’di ama dri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.20",
