              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini ama nga azi’i, azini ’ba, ’diyi ma esele aluri bi aju engazu etuni efuria cazu ’bi’bioni e’daria. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.21",
