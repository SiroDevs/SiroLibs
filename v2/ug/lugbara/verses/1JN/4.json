              },
              "items": [
                {
                  "text": "Mat 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba mani lele ’diyi, emi ma a’i orindi dria ku, te emi ma o’bi orindi nizu kani yi ibi enga Mungu vu yani; nabi inzoru kakauni efule mule nyakua ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.1",
            "verseOrgIds": [
              "1JN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 4:2"
          },
          "items": [
            {
              "text": "2",
