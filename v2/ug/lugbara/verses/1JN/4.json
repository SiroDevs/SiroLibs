              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.5"
              },
              "items": [
                {
                  "text": "Rum 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ni ra ama ovu eri alia, azini eri ovu ama alia e’yo ’disi, erini Orindi ini fele ama dri ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.13",
            "verseOrgIds": [
              "1JN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.17"
              },
              "items": [
                {
                  "text": "Yoh 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama lu vunia ’bo, ama e’yo eti nze kini Atani pe Mvi ini ma ti ’bo ovuzu ’Ba ’ba Opapi nyakuariru. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.14",
            "verseOrgIds": [
              "1JN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.5"
              },
              "items": [
                {
                  "text": "1 Yoh 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Yesuni e’dapi eri Mungu ma Mvi’iri, Mungu ovu eri alia, eri ovu Mungu ma alia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.15",
            "verseOrgIds": [
              "1JN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ni ra azini ama a’i leta Munguni ovupi ama vuri ’bo Mungu eri etani; ’ba ovupi leta ma aliari eri ovu Mungu ma alia, Mungu ovu eri ma alia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.16",
            "verseOrgIds": [
              "1JN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.28"
              },
              "items": [
                {
                  "text": "1 Yoh 2:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leta zo ama alia tre e’yo ’disi, ama ma ovu ani ad uri kokorori be o’du e’yo lizurisi; a’disiku ekile erini ovulerile, ama’i ama ovu alu indi ’dinile nyaku ’diria. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.17",
            "verseOrgIds": [
              "1JN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leta ma alia uri yo, te leta zopi tre ’bori eri uri ’be amve ra. Te urini bani candi fe; ’ba ovupi urisiri ma alia leta zoni nga tre ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.18",
            "verseOrgIds": [
              "1JN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama eri le ra erini ama lele okorisirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.19",
            "verseOrgIds": [
              "1JN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
