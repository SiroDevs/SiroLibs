              },
              "items": [
                {
                  "text": "1 Kor 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ni Orindi Munguniri e’yo ’disi: orindi dria alu alu e’yo e’dapi kini Yesu Kristo emu rua ’bani be rari enga Mungu vuni, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.2",
            "verseOrgIds": [
              "1JN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.18"
              },
              "items": [
                {
                  "text": "1 Yoh 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.17"
              },
              "items": [
                {
                  "text": "Yoh 8:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te orindi dria Yesuni e’dapi kuri engani Mungu vu ku. Orindi ’diri eri orindi ari’bo Kristonirini, emini erile ’bo kini eri emu rari; te curu’do eri efi nyakua ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.3",
            "verseOrgIds": [
              "1JN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.29"
              },
              "items": [
                {
                  "text": "Mat 12:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi nyiri nyiri mani, emi ovu ’ba Munguni, emi aga yi ’bo; a’disiku ’ba ovupi emi aliari eri amboru aga ’ba ovupi nyakuari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.4",
            "verseOrgIds": [
              "1JN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "Yoh 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ’ba nyakuni, yi e’yo nyakuni ’yo ani, nyakuni e’yo yini eri ra, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.5",
            "verseOrgIds": [
              "1JN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.47"
              },
              "items": [
                {
                  "text": "Yoh 8:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama’i ama ’ba Munguni. ’Ba Mungu nipi furi adri e’yo amani eri ra, ’ba ovupi ’ba Munguni kuri erini e’yo amani ku. Ama orindi e’yo adaruni pi ni orindi e’yo inzoruni be e’yo’disi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.6",
            "verseOrgIds": [
              "1JN.4.6"
            ]
          }
        }
      ]
    },
