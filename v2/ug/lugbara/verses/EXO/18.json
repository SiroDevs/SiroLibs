      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yetero kuhani Midianiari, Musa anyi, eri e’yo dria Mun­guni ’yele Musa pi vu, Israeli ’ba eri vile ’diyi beri, e’yo Yehovani Israeli ofuzu Misiriasi ngoni ngoniyari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.21+EXO.2.22"
              },
              "items": [
                {
                  "text": "Efu 2:21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yetero Musa anyi ’du Zipora Musa vile okuri, Musani ndra tini pele tezu o’dipiari, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "’Yeta 7:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "agupianzi erini iri ’diyi be; aluri ma ru Geri­somu’i2 (a’disiku Musa kini, Ma ovu ndra ani’boru angu azinia), ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "azi­niri ma ru Eliezeri’i (a’disiku eri kini, Mungu ma atiniri ko ndra ma aza ra, pa ma sei Farauni ma siasi ra). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetero Musa anyi ca Musa vu, anzi erini piyi oku erini be, pari erini hema asozu roko dria oni Mungunia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo Musa tia, Ma Yetero mi anyi, ma eca mi vu oku mini be, agupianzi erini iri ’diyi eri be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Musa fu dri fuzu anyi ini be, eri osi kumuti eri drilia, eri o’de eri ombelekoa inzitasi; yi ozi yi eselia e’yo ngoni ngoni yari, yi fi hema alia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini Musa olu anyi tia e’yo dria Yehovani ’yele Farau pi vu ’ba Misiria ’diyi be Israeli ma e’yosiri, azini candi okporu dria yi isupi geria ’diyi, azini e’yo Yehovani yi pazu ngoni ngoni yari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yetero ma asi ovu ayikosi e’yo onyiru dria Yehovani ’yele Israeli vurusi, a’disiku erini yi pale ’ba Misiria ’diyi ma driarisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        }
      ]
    },
