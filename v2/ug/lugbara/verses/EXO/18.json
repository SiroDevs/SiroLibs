                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ka ovu e’yo be yi emu ma vu, te ma e’yo yi ma eselia agyi beri li, azini ma yi imba azita Mungunisi, e’yo erini azile ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa anyi ’yo eri tia, E’yo mini ’yeleri ovuni onyiru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
