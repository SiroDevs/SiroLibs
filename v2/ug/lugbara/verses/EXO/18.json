            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yetero Musa anyi ’du afa veza edeta edezuri, edeta edeza azini be fezu Mungu dri; te Aroni eca ’ba ’wara Israelini ’diyi be dria nyaka nyazu Mungu drilia tualu Musa anyi pie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
