                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Okpo mini nga de ra ada, mi’i ’ba nde ovupi tualu mi be ’diyi be, e’yo nderi ovu mi dri nzizaru aga ra; mi econi eri ’yezaru a’dule ’ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
        {
