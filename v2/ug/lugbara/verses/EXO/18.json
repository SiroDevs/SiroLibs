              "items": [
                {
                  "text": "Luk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Curu’do ma ni Yehova ovu amboru aga adrou dria ra, adaru eri aga yi e’yo yini ’yele yi ruaa dri mbazasiri ma alia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
