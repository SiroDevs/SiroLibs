            "number": "10",
            "style": "v",
            "sid": "EXO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yetero ’yo, Yehova ma ovu inzizaru, eri’i emi papi ’ba Misiria ’diyi ma dria, azini Farau ma dria ’bori; eri’i ’ba nde ’diyi papi ’ba Misiria ’diyi ma dria ’bori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
            "verseOrgIds": [
              "EXO.18.10"
            ]
          }
        },
