              "items": [
                {
                  "text": "Efu 24:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ’yo Musa be milia milia, ekile ’bani e’yo ’yole i agyi berile. Te Musa oja i dika fizu pari ’bani hema asozuria, te Yosua Nuni mvi, karilau eri aza kopiri, funi hema aliasi amve ku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
