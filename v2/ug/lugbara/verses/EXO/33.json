            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Musa adri hema ’du aso amve, pari ’ba ongulumuruni hema yini asozuri be re; ’da runi hema ti ecizaniri’i. Te eri nga eca ’dini, ’ba dria alu alu Yehovani ndrupiri yi adri fu muzu hema ti ecizani ovupi amve pari ’bani hema asozuri be reria, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
