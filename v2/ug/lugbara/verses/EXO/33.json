            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ongulumuru ka e’yo kuza onzi ’diri eri ra, yi nga ovu candisi; ’ba aluni suni onyiafa i ruaa ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.23"
              },
              "items": [
                {
                  "text": "Zab 139:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ’yo Musa tia, Mi ’yo anzi Israelini ’diyi ma tia, Emi ovu suruti ombe mbazaniri; ma ka te tu emi eselia etu were ti, ma te emi dri ja ra, E’yo ’disi emi tru di onyiafa emini, ’dini ma ma ama ani e’yo mani ngale ’yele emi ruaari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli anzi yi otru di onyiafa yi ruaa ra, engazu oni Horebua asini su dika ku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
