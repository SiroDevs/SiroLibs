        },
        {
          "text": "Te eri ’yo tinia, Drusi. Musa ’yo ra, Ma ovu mini ’yolerile, ’dini mi ma ni Mungu azini i sipi Yehova Mungu amanileri aluni yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odrudru nga mi ku, jo mini ’diyi pie, ati’ba mini pie, azini ’ba mini ’diyi pie dria; yi nga ace kiri yi ara alia a’dule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
        {
