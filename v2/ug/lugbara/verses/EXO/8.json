              "items": [
                {
                  "text": "105:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Aroni nga di i dri eju yi Misirini dria ra; odrudru efu ani, a’bu angu Misirini ma dri dria ci. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
