              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "odrudru nde ’diyi nga ombu mi ruaa, azini ’ba mini ma ruaa, azini ati’ba mini dria ma ruaa indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
