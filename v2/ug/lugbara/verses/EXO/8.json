                {
                  "text": "Efu 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ojouru yi ’ye ’dini indi ondua yini olenirisi, yi ofu odrudru angu Misirini ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
