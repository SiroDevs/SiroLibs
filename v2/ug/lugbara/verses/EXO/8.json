              "items": [
                {
                  "text": "O’be 21:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Farau ka ndre oli li i ruaa were ’bo, asini mba kongoloko, eri erini yi ku; ekile Yeho’vani ’yolerile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
