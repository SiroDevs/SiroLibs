                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ka ga yi dri geri feko si, mi ne, ma nga angu mini co dria odru­drusi traa kalatinia; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.2",
            "verseOrgIds": [
