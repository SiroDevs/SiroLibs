                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Musa pi Aroni be yi fu Farau vusi; Musa owu Yehova vu odrudru erini ofule Farau vu ’diyi Ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehova ’ye ekile Musani ’yo­lerile; te odrudru odra dria jo aliasi, dri driasi, azini amvuasi dria, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi otro yi ma avu tualu ngulu ngulu, angu nga ani ngu onzi tu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
