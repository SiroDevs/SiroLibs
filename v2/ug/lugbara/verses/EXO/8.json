          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa fu Farau vusi, zi Yehova tia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
