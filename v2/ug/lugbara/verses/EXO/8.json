          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga ’ba mani esele co ’ba mini be. Eceta ’diri nga i ’ye drusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
