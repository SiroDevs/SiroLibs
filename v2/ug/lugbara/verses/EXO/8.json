                  "text": "Efu 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo Musa tia, Mi ’yo Aroni tia, Mi eju mi dri kali be yi ara ’diyi ma dria, yi nyiri ’diyi pie, azini yi atipi ati ’diyi pie, odrudru ofuzu angu Misirini ma dri dria ani ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
