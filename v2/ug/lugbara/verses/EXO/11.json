                  "text": "Mal 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te anzi, Israelini vu oce aluni ngani andre ini mbe ku, kani ’ba vu kani anya pa vu; emi ma ni geri Yehovani ’ba Misirini piyi ma esele cozu ’ba Israelini beri ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ati’ba dria mini ’diyi nga esi ma vu, nga kumuti osi ma drilia ’yozu, Kiri kiri emi fu, ’ba dria mi vuti bipi ’diyi be fo! ’Di ma vutia ma di nga fu ra. Eri fu Farau vusi adra acirusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehova ’yo Musa tia kini, Farau ngani emi eri ku; ’dini tali osutaru mani ’yele ’diyi ma ezu kakau angu Misirini ma alia ani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        }
