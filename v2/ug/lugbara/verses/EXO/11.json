              "items": [
                {
                  "text": "12:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo curu’do ’ba ongulumuru ma bilia, kini agupi dria alu alu ma zi yi agyi aku ejeliari tia, azini oku dria alu alu ma zi yi agyi aku ejeliari tia afa onyiafa dahaburu azini onyiafa meleru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
