                  "text": "Amo 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awu amboruni nga ovu angu Misirini ma alia dria, awu azini andra oko ’dinileni yo, ngani ovu ’dinile dika ku indio ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
