                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ’yo Musa tia, Mi ’yo e’yo ama be mi’i, ama nga eri ra; te Mungu ma ’yo ama beni ku, ama kazu odrazu ku. ",
          "type": "text",
          "attrs": {
