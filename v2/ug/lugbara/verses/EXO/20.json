              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ongulumuru yi so pa re, te Musa eri si ogogo angu asepi iniciciru Munguni ovuzuria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        },
        {
          "name": "verse",
