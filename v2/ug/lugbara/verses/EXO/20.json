              "items": [
                {
                  "text": "E’do 12:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ede pari edeta edezuri ma dri nyakusi, emi ma fe drinia afa veza edetaru mini ’diyi, azini edeta asi anzuruni mini ’diyi, kabilo piyi ti mini be; pari dria mani fezu ’ba ma ega ru mani aleniaria ma nga emu mi vu, ma nga asi ndriza fe mi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
