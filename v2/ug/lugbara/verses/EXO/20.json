                {
                  "text": "Yos 8:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ka pari edeta edezuri ede ma dri onisi, mi ede eri oni gale garisi ku; a’disiku mi ka aya ’ba eri ruaa, de mi eza eri ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
