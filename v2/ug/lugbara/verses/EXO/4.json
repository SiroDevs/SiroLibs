                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo olu mi ma paria ’ba ongulumuru driliani; te eri nga eca ’dini, eri’i eri nga ovu tile miniru, mi’i mi nga ovu Mungu erinile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te mi nga kali ’dori ’du mi dria, eceta amboru nde ’diyi ’yezu erisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
