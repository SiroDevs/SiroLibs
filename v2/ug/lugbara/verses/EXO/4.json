                  "text": "Mat 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu ’yo, Mi su mi dri mi agatia dika. ’Dini eri su i dri i agatia dika; te ka enze i agatiasi ’bo, mi ne, oja i dika ekile eri ma rua adarile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, yi ka mi a’i ku, yi ka eceta amboru okori ma o’duko eri ku, ka’dini yi nga eceta vileri a’i’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Efu 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, yi ka eceta ’diyi iri tro a’i ku, azini ka 0’duko mini eri ku, ka ’dini mi nga yi eko yi ara Nilia, mi nga yiniri da nyaku a’wiru ma dria; te yi mini ekole yi ara Niliari nga i oja ariru nyaku a’wiru nderi ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
