        },
        {
          "text": "Ka’dini mi mu di, ma nga ovu ti mini be tualu, ma nga mi imba e’yo mini ngale ’yolerisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
