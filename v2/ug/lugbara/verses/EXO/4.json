                }
              ]
            }
          ]
        },
        {
          "text": "Te Musa pi Aroni be yi mu ra, yi oku ’ba ’wara anzi Israelini ’diyi dria tualu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
