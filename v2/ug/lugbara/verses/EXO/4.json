              "items": [
                {
                  "text": "Kal 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.27"
              },
              "items": [
                {
                  "text": "2 Opi 5:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo vini eri tia e’yo azini ’dini, Mi su mi dri mi agatia. Te eri su i dri i agatia; ka enze i agatiasi, mi ne, ofu nya eri ma dri emve forotoru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        },
        {
          "name": "verse",
