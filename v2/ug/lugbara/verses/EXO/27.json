                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.100.4"
              },
              "items": [
                {
                  "text": "Zab 100:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ede irii bereni. Kala uruleruria mi ma o’i bongo mile be nyiria ’diyi irii ma ageia, oconi wuale turu alu kala nde aluria; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "patini agoferu ’diyi ma adri kali iri, ’bileni molaru ’diyi kali iri, te iwu agofe ruaa ’diyi pi kalini alazaru ’diyi be ma ovu dahaburu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dinile indi kala andraleruria, bongo o’izani ovu oco be wuale turu alu, patini agoferu ’diyi ma adri kali iri, ’bileni molaru ’diyi kali iri, te iwu agofe ma ruaa ’diyi pi kalini alazaru ’diyi be daha­buru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irii ma wala etuni ’deria­leruria, bongo o’iza ma ovu oco be wuale kali towi, patini agoferu ’diyi ma ovu mudri, ’bileni mudri indio ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irii ma wala etuni efurialeruria ma ovu wuale kali towi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo o’izaru irii tile ma kala aluria ’diyi ovu wuale mudri drini towi, agofeni na, ’bileni vini na. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo o’iza­ru irii tile ma kala aziniria ’diyi ma ovu wuale mudri drini towi, agofeni na, ’bileni vini na. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo o’izaru irii ma tile a’buzu ’diyi ma ovu oco be wuale kali iri, bongo blururi pisi, okalakokalari pie, ekari pie, azini bongo mile be nyiriari pie, onduou wura cipi bongo ruaari ma dri pamvu; agofeni su, ’bileni vini su. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agofe irii ma kalaa ’diyi dria ma kali alaza ’diyi ma ovu dahaburu; iwuni ’diyi dahaburu indi, ’bileni ’diyi molaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irii ma oco ma ovu wuale turu alu, walani dria dria ma ovu wuale kali towi, oconi edrezari wuale towi dria, bongo mile be nyiriaru, ’bile yini ’diyi ovu molaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa dria bereni ’bani azi ngazu ’diyi, aloni ’diyi dria pie, alo iriini ’diyi be dria, ma ovu molani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
