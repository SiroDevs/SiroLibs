              },
              "items": [
                {
                  "text": "Eze 43:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma de pari edeta edezuri asarau patisi, ocoru alazari wuale towi, walani wuale towi; pari edeta edezu nderi ma kala su ’diyi ma ovu tro tro tro tro, oconi edre­zari ma ovu wuale na. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
          "items": [
