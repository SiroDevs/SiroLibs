                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.44"
              },
              "items": [
                {
                  "text": "’Yeta 7:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ede eri bausi ale be pirini; mi ma ede eri ekile wura ovupi ecezaru mi dri oni dria ’borile ’dini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
