                "loc": "PSA.12.3+PSA.12.4+PSA.12.5"
              },
              "items": [
                {
                  "text": "Zab 12:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.14"
              },
              "items": [
                {
                  "text": "2 Sur 32:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.19"
              },
              "items": [
                {
                  "text": "Efu 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Parau kini, Yehovani a’di’i ya, mani o’duko erini erizu, Israeli kuzu muzu ani ya? Ma nini Yehovani ku, azini vini indi ma ngani Israeli ku muzu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.18"
              },
              "items": [
                {
                  "text": "Efu 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ’yo, Mungu ’ba Ebranianiri fu dri ama be ’bo; ama matu ’ba mi vu, kiri kiri mi ku ama mu o’du pale na roko dria, edeta edezu Yehova Mungu amaniri dri, eri kazu ama ofuzu muasi ku, kazu vini ama olizu seisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.15"
              },
              "items": [
                {
                  "text": "O’be 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Efu 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi Misiriari ’yo yi tia, Emi Musa, Aroni, emi fe ’ba ’diyi ayuna ku a’di e’yosi ya? Emi mu emini teri eminia! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.4",
            "verseOrgIds": [
              "EXO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.7"
              },
              "items": [
                {
                  "text": "Efu 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Parau ’yo ra, ’Ba angu ’doria ’diyi yi kakau, emi ava liza fe yi dri teri kuzu ’doni ya! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.5",
            "verseOrgIds": [
              "EXO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Efu 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du nderisi Farau fe azita ’ba yi agei tepi azi ngaria ’diyi dri, azini ’ba Israelini yini opele yi drilia ’diyi dri kini, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma asi yi dri ase biriki ’bezu ekile ndra okorileri fe dika ku; emi ku yi ma ngulupi ma mu ase nde okuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.7",
            "verseOrgIds": [
              "EXO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te kalafe birikini ndra yini adrile ’beleri, emi li yi dri ’dani, emi omvi kalafe nderi vile aluni ku; a’disiku yini ovule ovuoururisi; e’yo ’disi yi wu kini, Mi ku ama mu edeta edezu Mungu amani dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.8",
            "verseOrgIds": [
              "EXO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi fe azi nzizaru azini ’ba ’diyi dri drinia dika, ’dini yi ma nga azi nde okporu, yi ma nga e’yo inzoru ’diyi eri ku ani beni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
