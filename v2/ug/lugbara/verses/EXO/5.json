              "items": [
                {
                  "text": "Efu 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia Musa pi Aroni be yi mu, yi ’yo Farau be, Yehova Mungu Israelini ’yo ’dini, Mi ku ’ba mani ’diyi ma mu omu ’bazu ma dri roko dria ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.1",
            "verseOrgIds": [
              "EXO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
