            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.12"
              },
              "items": [
                {
                  "text": "O’be 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba yi drilia yi agei tepi azi ngaria ’diyi fu ra, tualu ’ba Israelini yini opele yi drilia ’diyi be, yi ’yo ’ba ongulumuru ma tia kini, Farau ’yo ’dini, Ma ngani emi dri ase fe ma’ini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ngulupi ma mu ase nda emi’i, pari emini ngazu ecozu isuzuria; te yi ngani azi emini omvi vile aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.11",
            "verseOrgIds": [
              "EXO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini ’ba Israelini ere yi angu Misirini drisi dria, ’du pati okuzu ase paria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.12",
            "verseOrgIds": [
              "EXO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba yi drilia yi agei tepi azi ngaria ’diyi odro yi ongusi, kini, Emi de azi emini, ayuna etu vusi etu vusiri, ekile andra emini ’yele ewu aseni ovuzu indirisi­rile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.13",
            "verseOrgIds": [
              "EXO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.13"
              },
              "items": [
                {
                  "text": "E’do 15:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi oco ’ba ’ba yi agei tepi Farauni ’diyini opele anzi Israelini ma drilia ’diyi, yi zi yi tia, Emi deni ayuna emini biriki ’bezuri aje azini andru ekile ndra okorile ku a’di e’yo efisi ya?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia ’ba anzi Israelini yini opele yi ma drilia ’diyi emu Farau vu wuzu kini, Mi ’ye ’dini ati’ba mini vu a’di e’yosi ya?, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.15",
            "verseOrgIds": [
              "EXO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi feni ase ati’ba mini dri ku, te yi ’yo ama ria, Emi ’be biriki! Te mi ne, yi oco ari’ba mini oco oco; te di e’yo onziniri ’ba mi ngulupi vile ’diyini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.16",
            "verseOrgIds": [
              "EXO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ’yo, Emi ovuouni, emi ovuouni; e’yo ’disi fe emi dri ’yo ani, kini, Mi ku ama mu edeta edezu Yehova dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi mu cucuru’do azi nde ngazu; te yi ngani emi dri ase fe aluni ku, te ti emi nga biriki ma kalafe ’be ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.18",
            "verseOrgIds": [
              "EXO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba anzi Israelini ma drilia ’diyi, yi ka e’yo nde eri kini, Emi ma omvi biriki emini ma kalafe aluni ku, azini ayuna etu vusiri aluni ku indi; yi ni adaru e’yo yini eca onzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.19",
            "verseOrgIds": [
              "EXO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ka efu Farau vusi ’bo, yi isu yi Musa pi Aroni be yini pa soria geria; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.20",
            "verseOrgIds": [
              "EXO.5.20"
            ]
          }
        },
        {
