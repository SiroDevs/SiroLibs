                "loc": "2KI.18.35"
              },
              "items": [
                {
                  "text": "2 Opi 18:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.21.15"
              },
              "items": [
                {
                  "text": "Yob 21:15",
