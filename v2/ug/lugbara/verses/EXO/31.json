        },
        {
          "text": "’Ba ma nga azi o’du azia, te 0’du aziriri sabato ava liza inzitani ovupi alatararu Yehova driri; ’ba ngoni ngori ti azi ngapi sabatosiri, yi nga eri fu adaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi anzi Israelini ’diyi ma mba o’du sabatoni ma ta, 0’du sabatoni ma e’yo osuzu aziza ’daniriru a’bianzi yini vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
