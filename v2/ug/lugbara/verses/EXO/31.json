            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.4+1CO.12.5+1CO.12.6+1CO.12.7+1CO.12.8"
              },
              "items": [
                {
                  "text": "1 Kor 12:4-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini ma fe eri ma ga tre Orindi Mungunisi, onduasi, e’yo vazasi, e’yo nizasi, azini ondua azi ndu ndu dria ’yezurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "egazu azi onduouni ’yezu, azi ngazu melesi, azini daha­busi, azini molasi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini oni osuza ’diyi olizu, azini endrilendri opazu pati ruaa, azi ndu ndu dria ngazu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
