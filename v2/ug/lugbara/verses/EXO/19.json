              "items": [
                {
                  "text": "Azi 33:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma ovu ngonde o’du narisi; a’disiku o’du na nderisi Yehovani nga esi va oni Sinai ma dria ’ba nde ma milia dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.18+HEB.12.19+HEB.12.20"
              },
              "items": [
                {
                  "text": "Ebra 12:18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ede lokiri ’ba nde dri kala vusi kuru kuru, kini, Emi te emi agei, emi kazu tuzu oni dria ku, kani oni ma kala elozu ku; ’ba oni elopiri yi nga eri fu ada; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.12",
            "verseOrgIds": [
              "EXO.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dri aluni ngani ’ba nderi elo ku, te adaru yi nga eri o’be onisi kani ca ’yesi; kani anyapani kani ’bani, eri ngani ovu idriru ku. Guka ka owu izu, yi ma esi oni vu ogogo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.13",
            "verseOrgIds": [
              "EXO.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa esi oni driarisi ’ba nde ’diyi vu va, eri ’ba yi alaru; yi i oji bongo yini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.14",
            "verseOrgIds": [
              "EXO.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.5"
              },
              "items": [
                {
                  "text": "1 Kor 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ’ba nde ’diyi tia, Emi ede emi ngonde o’du nari tezu; emi mu ogogo oku vu ku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
