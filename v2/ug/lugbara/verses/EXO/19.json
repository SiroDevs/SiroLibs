                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acika enga oni Sinai dria dria, Yehovani esile va eri dria aci aliarisi; te acika nderi nga ru uru ekile ci drole amboruri ma acikale, oni nderi dria nga ya ya okporu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 19:19"
          },
          "items": [
