                {
                  "text": "Azi 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa nga ’ba ’diyi ofu pari yini hema asozuriasi muzu yi isuzu Mungu be; te yi so pa oni etia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
            "verseOrgIds": [
              "EXO.19.17"
            ]
          }
        },
