            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri eca ’dini o’du na nderi ma o’bitisi, angu onoza piyi ovi ogaza be, iriti asepi iniciciri be oni dria, o’duko gukani okporu turi be; ’ba dria ovupi pari yini hema asozuria, ’diyi ma rua ya ya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
