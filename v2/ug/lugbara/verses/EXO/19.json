                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo Musa tia, Mi mu ’ba nde ’diyi vu, mi ’ba yi alaru andru azini dru, yi ma oji bongo yini, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
