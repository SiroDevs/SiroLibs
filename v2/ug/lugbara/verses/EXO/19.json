                {
                  "text": "Neh 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.81.7"
              },
              "items": [
                {
                  "text": "Zab 81:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’duko gukani ka wu i erezu okporu dika dika, Musani e’yo ’yo, Munguni e’yo omvi tinia o’dukosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehova nga esi oni Sinai ma dria kpere drini mbiliria; Yehova nga Musani omve tuzu oni dri mbiliria; Musa tu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.19"
              },
              "items": [
                {
                  "text": "1 Sam 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga ’yo, Musa tia, Mi si va, mi azi e’yo ’ba nde ’diyi dri, yi kazu lokiri agazu Yehovani nizu milesi birri ku, yi ma azi kazu odrazu kakau ani ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.3"
              },
              "items": [
                {
                  "text": "Lev 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.7"
              },
              "items": [
                {
                  "text": "2 Sam 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi fe ’ba edeta edepi osipi ogogo Mungu vu ’diyi ma ’ba yi alaru indi, Yehova kazu e’dezu yi ma dria adrasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Musa nga ’yo Yehova tia, ’Ba nde econi tuzu oni Sinai dria ku; mini azita fele ama dri ’borisi kini, Mi osi lokiri oni ageia, mi ’ba eri alaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo eri tia, Mi mu, mi si va, mi nga eru uru, emi Aroni be tualu; te ’ba edeta edepi ’diyi ’ba nde be yi ma anyo lokiri agazu tuzu Yehova vu ku, eri kazu e’dezu yi ma dria adrasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini Musa nga si va ’ba nde vu, olu yi tia ra.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.25",
            "verseOrgIds": [
              "EXO.19.25"
            ]
          }
