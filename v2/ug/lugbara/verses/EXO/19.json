        },
        {
          "text": "Mba na anzi Israelini yini efuzu anga Misiriasi ’bori ma eselia, o’du nderisi yi ca roko Sinaiaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.1",
            "verseOrgIds": [
              "EXO.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yini engaria Refi-di­mua ’boria, ka ca roko Sinaiaria ’bo, yi aso hema yini roko dria; ’dale Israeli adri oni nderi ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.2",
            "verseOrgIds": [
              "EXO.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 19:3"
          },
          "items": [
