          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mo­la ndesi eri ede ’bile hema ti ecitaniri ma tileni ’diyi, pari edeta edezu molaruri pie, keikei molaru erini pie, afa dria pari edeta edezuria ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
