                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede irii bereni; kala urule­ruria o’i bongo mile be nyiria ’diyi irii ma ageia oconi wuale turu alu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "patini agoferu ’diyi ovu kali iri, ’bileni ’diyi kali iri, yi molaru, te iwu agofe ruaa ’diyi pi kalini alazaru ’diyi be ovu dahaburu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala andraleruria oconi wuale turu alu, patini agoferu ’diyi ovu kali iri, ’bileni ’diyi kali iri, yi molaru, te iwu agofe ruaa ’diyi piyi kalini alazaru ’diyi be ovu dahaburu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irii ma wala etuni ’dezurialeruria bongo o’iza ovu oco be wuale kali towi, patini agoferu ’diyi mudri, ’bileni mudri indi; iwuni agofe ma ruaa ’diyi pi kalini alazaru ’diyi be ovu dahaburu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walani etuni efurialeruria ovu wuale kali towi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo o’izaru irii tile ma kala aluria ’diyi ovu wuale mudri drini towi, agofeni na, ’bileni vini na. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ovu ’dinile indi kala aziniria; irii tilia dri ejialeru azini dri ndialeru iri tro bongo o’ile ’diyi ma oconi ovu wuale mudri drini towi, agofeni na, ’bileni na indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo o’ile irii ma ageia ’diyi dria ovu bongo mile be nyiriaru ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Bile agofe ’diyini ovu molaru, iwu agofe ma ruaa ’diyi pi kalini alazaru ’diyi be ovu dahaburu; afa drini a’buzuri dahabuni, azini agofe irii ma kalaa ’diyi dria ma kali alazaru ’diyi ovu dahabusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.14"
              },
              "items": [
                {
                  "text": "2 Sur 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bongo o’izaru irii ma tile a’buzu ’diyi ovu onduou wura sopi bongo ruaari ma dripamvu, ede eri bongo bluru pisi okalakokalari pie, ekari pie, bongo mile be nyiriari pie; oconi wuale kali iri, azini oconi edrezari wuale towi, ekile bongo iriini ’diyile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agofeni su, ’bileni vini su molaru; iwuni ’diyi ovu dahaburu, afa drini piyi a’buzu kalini alazaru ’diyi beri dahaburu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
