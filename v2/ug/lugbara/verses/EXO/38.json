          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekeli alifu alu turo aziri drini kali aziri drini towi ’diyisi, eri ede iwu pati agofero ’diyi dri, azini eri a’bu dri yini ma ruaa dria dria, ede vini kali alazaru ’diyi yi dri indio ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
