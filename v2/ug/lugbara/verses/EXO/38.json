              "items": [
                {
                  "text": "Efu 26:19-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Onzi turo alu dahabuni ’diyi ma azi ovu ’bile pari alatararoria ’diyi edezu, ’bile bongo jo ale alizurini ’diyi be; onzi turo alu ’bile turo alu ’diyi edezu, onzi alu ’bile alu vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
