        },
        {
          "text": "Eri ede awala rua ojizuri molasi, pani molasi indi, ede eri mandara oku yi okopi azi ngazu hema ti ecitaniri ma jotilea ’diyinisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
