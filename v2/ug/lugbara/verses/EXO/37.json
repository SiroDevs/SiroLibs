              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.29"
              },
              "items": [
                {
                  "text": "Efu 25:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede afazu mesa dria ’diyi mele alarusi, saani erini pie, kabileni pie, okeleani pie, imvuni pie, yi bezu ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        }
