              "items": [
                {
                  "text": "Kal 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.11"
              },
              "items": [
                {
                  "text": "Yer 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tala nderi ma pati adaria kopo su ekile alimondi fule, ongbuni ’diyi pie funi be, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ongbu alu arakala iri etia tala nderi ma ruaa afa aluru, azini ongbu alu arakala iri etia tala nderi, ma ruaa afa aluru, azini ongbu alu arakala iri etia tala nderi ma ruaa afa aluru-arakala azia fupi tala nderi ma ruaa ’diyi yi ovu ’dinile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongbu yini piyi arakala yini be ovu tala nderi ma ruaa afa aluru; tala nderi dria ovu edezaru mele alaru dile dirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
