              "items": [
                {
                  "text": "Eceza 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede talapati mele alarusi, Eri ede talapati nderi mele dile dirisi, nduni pi ruani be; koponi pie, ongbuni pie, funi pie dria ovu dria tala nderi ma ruaa afa aluru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arakala azia efu eri ma ruaa, tala arakala na eje aluria, tala arakala na eje aziniria; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kopo na ekile alimondi fule ovu eri ma arakala aluria, ongbu alu azini fu alu; kopo na ekile alimondi fule ovu eri ma arakala aziniria, ongbu alu azini fu alu-arakala azia fupi tala nderi ma ruaa ’diyi ovu ’dinile, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.17.8"
