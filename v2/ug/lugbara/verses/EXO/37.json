        },
        {
          "text": "Eri ede mesa asarau patisi;oconi alazari ovu wuale iri, walani ovu wuale alu, oconi edrezari wuale alu ali be; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
            "verseOrgIds": [
              "EXO.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri a’bu ruani dria dria mele alarusi, azini eri ede ekilaza melesi drinia kalaasi kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.11",
            "verseOrgIds": [
              "EXO.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ede eri dri eri ma kalaa dria eseleni tini beri, walani drianzi su, azini eri ede indi ekilaza melesi esele nderi ma tia kalaniasi kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.12",
            "verseOrgIds": [
              "EXO.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ede eri dri emve su mele rapi acisirisi, eri o’ba yi kalania su tro pani su ’diyia dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.13",
            "verseOrgIds": [
              "EXO.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emve ’diyi ovu ogogo eseleni tini beria, pari pati eri ’duzu ’diyi suzuriru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.14",
            "verseOrgIds": [
              "EXO.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ede patiniru asarau pati’i, eri a’bu yi rua dria dria melesi, mesa ’duzu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.15",
            "verseOrgIds": [
              "EXO.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
