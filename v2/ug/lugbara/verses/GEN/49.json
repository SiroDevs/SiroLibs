              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "amvu nde oni gule ovupi aleniari be ndra jele anzi Hetini driri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
