                "loc": "HEB.6.18"
              },
              "items": [
                {
                  "text": "Ebra 6:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Noa nga di fi maburua eri’i anzi erini pie, oku erini pie, anzi ma okupiyi be, yi tiza ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyapa alaru ’diyi piyi anyapa alaru ku ’diyi pie, aria pie, afa dria acipi aci valesi nyakua ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga fi Noa vu maburu ma alia iri iri, ago pi aroni be, Munguni azile Noa ma tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini o’du aziri nde ’diyi ma vutia, yi tiza nga ovu nyaku ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
