              "items": [
                {
                  "text": "Zab 119:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Noa nga di ’ye tro tro ekile e’yo dria Yehovani azile eri ma tiarile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
