          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.1+LEV.11.2+LEV.11.3+LEV.11.4+LEV.11.5+LEV.11.6+LEV.11.7+LEV.11.8+LEV.11.9+LEV.11.10+LEV.11.11+LEV.11.12+LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19+LEV.11.20+LEV.11.21+LEV.11.22+LEV.11.23+LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28+LEV.11.29+LEV.11.30+LEV.11.31"
              },
              "items": [
                {
                  "text": "Lev 11:1-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma o’du mi be anyapa alaru ’diyi aziri aziri, ago piyi aroni be; te anyapa alaru ku ’diyi iri iri, ago piyi aroni be; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ’du aria ’bua ’diyi indi aziri aziri, ago piyi aroni be, ori ta mbazu idriru wudrikuru dria ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
