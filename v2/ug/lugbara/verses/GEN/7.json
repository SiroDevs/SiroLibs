          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozoo ’di nyaku dria o’du kali su etusi inisi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du nde alu ’dasi Noa pi nga fi maburu ma alia, Semi pie, Hamu pie, Yafeti pie, yi anzi Noani, Noa vile okuri pie, anzi eri vile ’diyi ma okupiyi be dria; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi fi yi’i anyapa asea ’diyi pie dria esele yini vusi, anyapa akua ’diyi pie dria esele yini vusi, afa dria acipi aci valesi nyakua ’diyi pie esele yini vusi, aria dria pie esele yini vusi, ada aria ma esele dria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa rua be ovupi ava idrini be ’diyi dria nga fi dria Noa vu maburu ma alia iri ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
