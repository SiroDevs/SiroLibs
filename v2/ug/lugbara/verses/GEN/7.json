                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "2 Pet 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ace nga o’du aziri, mani ngazu ozoo fezu ’dizu nyakua o’du kali su etusi inisi dria; ma nga afa idri be mani o’bale ’diyi ma dri ja dria nyaku ma driarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
