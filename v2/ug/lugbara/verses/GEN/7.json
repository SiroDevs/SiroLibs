        {
          "text": "Noa ma eli turu azia ma mba iriri ma mbao’du mudri drini azirisi, o’du nde ’dasi yi aliru amboru ma yi a’di dria nga ova okposi, ’bu ma derisa nga yi ozi mgboru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
