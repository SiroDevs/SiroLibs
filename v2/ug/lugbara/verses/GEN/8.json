              },
              "items": [
                {
                  "text": "Yob 38:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga yi a’di yi alirurini ’diyi opi derisa ’bua ’diyi pie ci, eri nga vini ozoo ’buari oga si, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.24"
              },
              "items": [
                {
                  "text": "E’do 7:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi nde nga dro ri nzusi nyaku ma driarisi ’dani. O’du turu alu drini kali towi ma vutia, yi nde ace de wereru ’bo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "maburu nga ri oni Araratiari ma dria, mba aziri ma mbao’du mudri drini azirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.4",
            "verseOrgIds": [
              "GEN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga nzu ’dani cazu mba mudriria; mba mudri ma o’du alurisi oni ma dri mbili ’diyi endre ra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
    {
