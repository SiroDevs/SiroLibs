              "items": [
                {
                  "text": "Zab 104:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu ega e’yo Noa pini, afa dria idri be ’diyi pie, anyapa dria ovupi eri be maburu ma alia ’diyi pie dria. Mungu nga fe olini lizu nyaku ma dria, yi nga anga ani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
