              },
              "items": [
                {
                  "text": "24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yusufu nga asi ndriza isu eri vu ra, eri nga azi nga eri dri; eri nga eri ’ba aku erini ma drilia, nga afa dria erini ovuzu yi be ’diyi ku eri dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.4",
            "verseOrgIds": [
              "GEN.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.27"
              },
              "items": [
                {
                  "text": "E’do 30:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, engazu o’du erini eri ’bazu aku erini ma drilia, afa dria erini ovuzu yi be ’diyi kuzu eri ma driarisi, Yehova fe asi ndriza aku Misiriou vileri dri e’yo Yusufunisi; asi ndriza Yehovaniri ovu ani afa dria erini ovuzu yi be ’diyi ma dria, kani joa, kani amvua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.12"
              },
              "items": [
                {
                  "text": "1 Sam 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga afa erini ovuzu yi be ’diyi ku Yusufu dri dria ra; eri nini afa erini ma e’yo aluni ku, pe lu nyaka erini nyaleri’i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
