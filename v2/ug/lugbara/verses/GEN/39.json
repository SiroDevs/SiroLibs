        },
        {
          "text": "Yehova ovu Yusufu be, eri ofu ’ba drilebaru; eri ovu eri ma opi Misiriou­ruri ma joa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
