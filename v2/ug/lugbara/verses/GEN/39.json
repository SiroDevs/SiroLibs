              "items": [
                {
                  "text": "28:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi erini ndre kini Yehova ovu eri be, azini Yehova fe afa dria erini ’yele ’diyi ma eca eri dri drilebaru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
