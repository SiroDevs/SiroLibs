          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.3"
              },
              "items": [
                {
                  "text": "E’do 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.19"
              },
              "items": [
                {
                  "text": "19:19",
