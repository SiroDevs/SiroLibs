                  "text": "26:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo eri tia e’yo takarile, kini, Ati’bo Ebraniouru mini ejile ama vuri, efi ma vu ma aji dizu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        },
        {
