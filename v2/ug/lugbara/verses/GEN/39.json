          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yusufu ma mile ndrizaru, ruani alaru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.11"
              },
              "items": [
                {
                  "text": "2 Sam 13:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini e’yo ’diyi ma vutia, opi erini ma oku nga mile ’ba Yusufu ma ruaa avasi, nga ’yo eri tia, Mi la masi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.7",
            "verseOrgIds": [
              "GEN.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri gasi, nga ’yo opi vile okuri ma tia, Mi ndre, opi mani nini afa ovupi ma be joa ’diyi ma e’yo ku, te eri ku afa erini dria ovuzu yi be ’diyi ma dria ’bo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.8",
            "verseOrgIds": [
              "GEN.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.6.29"
              },
              "items": [
                {
                  "text": "O’be 6:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
