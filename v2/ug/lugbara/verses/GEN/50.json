        },
        {
          "text": "O’du eri wuzu ’diyi ka yi de ra, Yusufu nga ’yo ’ba Farau ma joa ’diyi ma tia kini, Ma ka asi ndriza isu emi vu ’bo, ma zi emi tia, emi ’yo e’yo Farau ma bilia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
