                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.60"
              },
              "items": [
                {
                  "text": "Mat 27:60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ati, fe ndra mani oyo sozu kini, Mi ndre, ma nga dra ra; mi ma sa avu mani ’bile mani gale ma dri angu Kana­niariuri ma alia. E’yo ’disi ma zi mi tia, mi fe ma tu mu uru ma ati ma avu sazu; te ma nga emvi dika, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farau nga ’yo ra, Mi tu uru, mi ati ma avu sazu yi ekile erini fele mi dri oyo sozurile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nga di tu uru i ati ma avu sazu; ati’ba dria Farauni ’diyi pi nga mueri be tualu, ’ba ’wara eri ma joa ’diyi pie, ’ba ’wara dria angu Misiria ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba dria Yusufu ma joa ’diyi pie, adripi erini pie, ’ba eri ma ati ma joa ’diyi pie dria; kule vile angu Gosenia ’diyi yi kiri anzi nyirini a’dule, anyapa yini nyiri ’diyi pi ’wara ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba nzupi magalisi ’diyi pi, ’ba tupi akanya dria ’diyi be, nga tu mu eri be indi; yi ’ba ongulumuru karakarau ’tu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.2"
              },
              "items": [
                {
                  "text": "’Yeta 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.2.13"
              },
              "items": [
                {
                  "text": "Yob 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga ca akuma anya cozu Atadini Yoridania ’aa’dasiria, yi nga, awu owu ’dale wuta amboru candi be turisi; eri nga i atini owu o’du aziri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba angu e’ipi ’ba Kanania ’diyi ka wuta akuma Atadiniari ndre ra, yi nga ’yo ra, ’Di ’ba Misiria ’diyi ma awu candiru turi’i; nga di angu nde ma ru ’da Abeli-miziraimu’i; angu nderi Yoridania ’aa’dasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi erini ’ye eri vu ekile erini azile yi tiarile; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.16"
              },
              "items": [
                {
                  "text": "E’do 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.16"
              },
              "items": [
                {
                  "text": "’Yeta 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku anzi erini, nga eri ma avu ’du ji angu Kanania, nga eri sa oni gule amvu Makipelaa, ndra Iburahimuni jele awitaru amvu be tualu pari ’ba avu sazuriru Efironi ’ba Hetini dri Mamire ma driliaria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nga di mvi Misiria, ka de i ati ma avu sazu ’bo, eri’i, adripi erini pie, ’ba dria tupi mupi eri be eri ma ati ma avu sazu ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
