            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu ma adripi ka ndre yi ma ati dra ’bo, yi ’yo ra, Kani Yusufuni nga ama ngu onzi, nga e’yo onzi dria ndra amani ’yele i vu ma arioti dria ofe ama ruaa yani, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.15",
            "verseOrgIds": [
              "GEN.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga e’yo ti pe Yusufu vu ani kini, Mi ati azi e’yo de nga eri drani ku, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.16",
            "verseOrgIds": [
              "GEN.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.13"
              },
              "items": [
                {
                  "text": "O’be 28:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.25"
              },
              "items": [
                {
                  "text": "E’do 49:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ’yo Yusufu ma tia ’dini, kini, Ma zi mi tia, mi ma wu mi adripi ma e’yo onzi pi ezata yini be, yini ’yele onzi mi vurisi. Te di curu’do, ama zi mi tia, mi wu Mungu mi atiniri ma ati’ba ma ezata fo! Yusufu nga wu mindresi, yini e’yo ’diri ’yoria eri tia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        },
        {
          "name": "verse",
