            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.48.14"
              },
              "items": [
                {
                  "text": "E’do 48:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yusufu ka ndre i ati ’ba eri ma dri ndiri Efiraimu ma dria, e’yo nde ovu eri ma milia onzi; eri nga i ma ati ma dri ’du uru, eri ’duzu Efiraimu ma driarisi ’bazu Manase ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nga ’yo i ati ma tia, ’Dini ku, ma ati la; te mva ’diri mva okori’i; mi ’ba mi dri ndiri eri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.18",
            "verseOrgIds": [
              "GEN.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.2.19"
              },
              "items": [
                {
                  "text": "Kal 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.33.17"
              },
              "items": [
                {
                  "text": "Azi 33:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ati gasi, nga ’yo ra, Ma ni ra, mva mani la, ma ni ra; eri nga efu ovuzu sururu indi, eri’i nga ovu amboru indi; te ti, adri wereri nga eri aga ambosi ra, eri ma orini nga efu ovuzu suru ongulumu­ru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.19",
            "verseOrgIds": [
              "GEN.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.11"
              },
              "items": [
                {
                  "text": "Rut 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga asi ndriza fe yi dri o’du ’dasi, kini,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    }
