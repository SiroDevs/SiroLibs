                  "text": "Ebra 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Orobi nga eri obi ra, te mi ndre, apife enga nyakua, drini ca ’bua uru; te mi ndre, malaika Munguni ’diyini turia azini esiria eri ma driarisi! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
