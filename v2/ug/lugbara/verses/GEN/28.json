        },
        {
          "text": "Yakobo nga di efu Beeri-se­baarisi muzu Haranialeru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
