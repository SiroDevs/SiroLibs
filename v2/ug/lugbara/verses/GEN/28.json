              "items": [
                {
                  "text": "E’do 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.3"
              },
              "items": [
                {
                  "text": "36:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esau nga di mu Isimaeli vu ani, nga Mahalati Isimaeli Iburahimu mvi ma zi, Ne­bayoti ma amvipiruri je i ma okuru, oku erini ovuzu yi be ’diyi ma aziru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
