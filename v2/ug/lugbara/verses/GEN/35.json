              "items": [
                {
                  "text": "E’do 30:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini erini mva osiria ewaru, oku azani kopiri nga ’yo tinia, Mi ru ku; mi agimva azini osi ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, eri ma orindini ’yeria furia (a’disiku dra ra), eri nga runi ’da Benoni’i; te ati ’da runi Benyami­ni’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        },
