              "items": [
                {
                  "text": "1 Sam 10:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo nga oni i’di piriru nyadri erini ma dria; oni piriru Rakeli ma nyadri driari eri indi kpere andru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        },
