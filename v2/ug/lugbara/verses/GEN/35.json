                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Yakobo nga eca Luzi ovupi angu Kananini ma aliaria (pari nde Beteli’i), eri’i ’ba dria ovupi eri be ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
