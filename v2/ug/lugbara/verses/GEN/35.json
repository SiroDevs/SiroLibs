          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo nga pari Munguni e’yo ’yozu eri beri ma ru ’da Beteli’i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        }
      ]
