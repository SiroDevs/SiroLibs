              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga aci yini e’do Beteliasi; isu aci ace izu cazu Efiratia, mvaazo nga Rakelini e’du, te ositani ewaru tu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        },
        {
