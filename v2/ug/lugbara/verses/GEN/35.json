                "loc": "EXO.1.2"
              },
              "items": [
                {
                  "text": "Efu 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Leani: Rubeni Yakobo ma mvi okori pi, Simeoni pi, Levi pi, Yuda pi, Isakari pi, Zebuluni pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Rakelini: Yusufu pi Benya­mini be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Bila Rakeli vile zamva ati’borurini: Dani pi Nafutali be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Zilipa Lea vile zamva ati’borurini: Gadi pi Aseri be. ’Diyi anzi Yakoboni otile Padani-aramua ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
