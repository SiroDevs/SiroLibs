                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu nga tu uru eri vurisi, pari erini te e’yo ’yozu eri beria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
