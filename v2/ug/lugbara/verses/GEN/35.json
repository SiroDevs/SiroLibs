              "items": [
                {
                  "text": "Mat 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rakeli dra di ra nga avuni sa geri muzu Efiratiaria (pari nde Betelehemu’i). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
