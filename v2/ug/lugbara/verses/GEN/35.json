                  "text": "E’do 28:18-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo nga ani afa i’diza i’di piriru pari erini e’yo ’yozu eri beria, adani i’di oni piriru; eri osu edeta edele afa mvuzasiri drinia, nga odu osu drinia indio ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
