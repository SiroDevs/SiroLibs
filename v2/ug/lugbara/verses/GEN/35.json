              "items": [
                {
                  "text": "E’do 28:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga pari edeta edezuri ede ’dale, nga runi ’da Eli­beteli’i, a’disiku Mungu e’da ndra i eri vu ’dale, erini aparia adripi ma miliarisiria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
