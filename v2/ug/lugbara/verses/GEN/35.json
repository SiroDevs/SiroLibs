                  "text": "E’do 24:59",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Debora Rebeka ma endriaruri dra ’dale, yi nga eri ma avu sa Beteli ma etia andraleru, kumara ma etia; yi nga runi ’da Aloni-bakuti’i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
