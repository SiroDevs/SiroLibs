              "items": [
                {
                  "text": "’Yeta 13:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburahimu ma ava fu ra, eri nga dra ra, de eri de fu dri ci, eri ’ba dezani eli be kakau, nga di mu ’ba ini odrapi ’bo ’diyi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
