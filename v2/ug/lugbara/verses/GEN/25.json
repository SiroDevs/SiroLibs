              },
              "items": [
                {
                  "text": "50:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi erini Isaka pi Isimaeli be nga eri ma avu sa oni gule Makipelani, amvu Efironi Zohari ’ba Hitini ma mvini ovupi Mamire ma driliari ma alia, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.3+GEN.23.4+GEN.23.5+GEN.23.6+GEN.23.7+GEN.23.8+GEN.23.9+GEN.23.10+GEN.23.11+GEN.23.12+GEN.23.13+GEN.23.14+GEN.23.15+GEN.23.16"
              },
              "items": [
                {
                  "text": "E’do 23:3-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amvu nde Iburahimuni jele anzi Hetini driri’i. Yi sa Iburahimu ma avu ’dale oku erini Sara be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.14"
              },
              "items": [
                {
                  "text": "E’do 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.62"
              },
              "items": [
                {
                  "text": "24:62",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, Iburahimu ka dra ’bo, Mungu nga asi ndriza fe mvi erini Isaka dri. Isaka ovu Beeri­lahai-roja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
