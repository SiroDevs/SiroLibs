        },
        {
          "text": "Anzi nde nga zo ra; Esau eri ’ba za gbipi onduasi, ’ba ’a’api aseariru, te Yakoboni ’ba e’yereni ’a’api hemaari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
