              "items": [
                {
                  "text": "E’do 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga adri engazu Havilaa kpere Suri Misiri ma driliaria, mini muria Asuriaaleru; eri adri ndra i adripi dria ma milia ’aa’daleru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
