                "loc": "1KI.2.7"
              },
              "items": [
                {
                  "text": "1 Opi 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ma ega e’yo mani, e’yo mini ka nga ofu drilebaru ’borisi, mi ece asi ndriza ma dri, ma zi mi tia, mi ma olu e’yo mani Farau tia indi, ma ofuzu jo ’doriasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.20"
              },
              "items": [
                {
                  "text": "E’do 39:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ada yi ogu ma ’ba Ebrania ’diyi ma anguasi, te ’doa indi ma ’yeni e’yo onzi fudri yini ani ma ’bazu ’bile gale arujoruri ma alia ’dini ku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
