              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ’ba nyaka a’dipi ’diyi ma driliari ka ndre orobi ma efi ovu onyiru, eri nga ’yo Yusufu ma tia, Ma’i indi, orobi mani ma alia, te mi ndre: ma adro afazu na ma dria, yi ma alia mikati emveru ’diyi indi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.16",
            "verseOrgIds": [
              "GEN.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "afazu dridriru ururi ma alia nyaka ndu ndu a’dile Farau dri ’diyi indi, te aria nga yi oga nya afazu ma driari ma alealesi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.17",
            "verseOrgIds": [
              "GEN.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nga e’yo omvi ’yo ra, Efini ’dini: afazu na ece o’du na; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "de nga o’du na agani ku, Farauni nga mi dri enga-ga mi ruaarisi!-nga mi avu ’i pati sia; aria yi nga za oce mi ruaarisi nya ra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        }
      ]
    },
