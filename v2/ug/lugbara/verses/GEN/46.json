              "attrs": {
                "loc": "JOB.33.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu nga e’yo ’yo Israeli ma tia ara ndreza inisirisi, nga ’yo ra, Yakobo! Yakobo! Eri nga ’yo ra, Ma ’do’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 46:3"
          },
          "items": [
