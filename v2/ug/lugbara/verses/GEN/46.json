            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.15"
              },
              "items": [
                {
                  "text": "Kal 26:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Gadini: Zifioni pi, Hagi pi, Suni pi, Eziboni pi, Eri pi, Arodi pi, Areli pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.7.30"
              },
              "items": [
                {
                  "text": "1 Sur 7:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Aserini: Imina pi, Isiva pi, Isivi pi, Beria pi, yi amvi Sera pie. Anzi Beriani: Heberi pi Malikieli pie ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
