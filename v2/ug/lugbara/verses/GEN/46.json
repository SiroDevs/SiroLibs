              "items": [
                {
                  "text": "1 Sur 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Yudani: Eri pi, Onani pie, Sela pi, Perezi pi, Zera pie (te Eri pi Onani be odra angu Kanania); anzi Perezini yi Hezironi pi Hamuli be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Isakarini: Tola pi, Puva pi, Yasubu pi, Simironi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Zebulunini: Seredi pi, Eloni pi, Yaleeli pie ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "(’diyi dria yi anzi Leani, erini otile Yakobo dri Padani-aramua, zamva erini Dina be ’diyi; anzi piyi ma kalafe ezopi beri kali na drini na). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.15",
            "verseOrgIds": [
              "GEN.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 46:16"
          },
          "items": [
