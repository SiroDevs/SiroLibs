              "items": [
                {
                  "text": "Efu 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo ra, Ma Mungu, Mungu mi atiniri’i; mi ’ye urisi sizu muzu Misiria ku; a’disiku ma nga mi ’ba ovuzu suru amboru ’dale. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.3",
            "verseOrgIds": [
              "GEN.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
