              "type": "tag",
              "attrs": {
                "loc": "ISA.52.4"
              },
              "items": [
                {
                  "text": "Isa 52:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga yi ma anyapa piyi ji ara yini isu angu Kanania ’diyi be, nga eca Misiria, Yakobo ori’ba erini be: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.6",
            "verseOrgIds": [
              "GEN.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "anzi erini pie, anzi ma anzipi pie, ezopi pie, anzipi ma ezopi pie, ori erini be dria, eri nga yi ji dria eri be Misiria ra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        }
      ]
