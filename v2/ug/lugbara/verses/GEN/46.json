              "type": "tag",
              "attrs": {
                "loc": "LUK.2.29"
              },
              "items": [
                {
                  "text": "Luk 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Israeli nga ’yo Yusufu ma tia, Mi ku di ma dra yio, mani mi mile ndrele ’borisi, mi de ’di nga idriru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 46:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nga ’yo i adripi piyi ma tia, ’ba i ati ma joa ’diyi be, Ma nga tu mu e’yo olu Farau ma tia, ma nga ’yo eri tia, Ma adripi, ’ba ma ati vile joa ’diyi be ndra angu Kananinia ’diyi eca di ma vu ’bo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba nde yi ’ba kabilo ocepi ’diyi, yi ’ba ndra anyapa oce drio; yi eji anyapa yini nyiri ’diyi pi ’wara ’diyi pie, afa yini ovuzu yi be ’diyi be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
