                "loc": "1CH.5.1"
              },
              "items": [
                {
                  "text": "1 Sur 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Israelini emupi Misiria ’diyi yi ma ru ’di, Yakobo pi anzipi be. Rubeni Yakobo ma mva okori, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini anzi Rubenini: Hanoki pi, i Palu pi, Hezironi pi, Karimi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.15"
              },
              "items": [
                {
                  "text": "Efu 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.4.24"
              },
              "items": [
                {
                  "text": "1 Sur 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Simeonini: Yemueli pi, Yamini pi, Ohadi pi, Yakini pi, Zohari pi, Saulo oku Kanani ezoruri ma mvi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Levini: Gerisoni pi, Kohati pi, Merari pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
