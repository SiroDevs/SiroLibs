        },
        {
          "text": "Ma nga si Misiria mi beni, ma nga vini mi oru ’dasi etuzu emuzu dika I’doa ada ada; Yusufuni nga mi mile omvi i ma drisini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.4",
            "verseOrgIds": [
              "GEN.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
