                {
                  "text": "E’do 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.33.14"
              },
              "items": [
                {
                  "text": "Yob 33:14",
