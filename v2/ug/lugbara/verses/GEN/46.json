                "loc": "GEN.12.2"
              },
              "items": [
                {
                  "text": "E’do 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
