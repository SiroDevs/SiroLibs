                "loc": "GEN.38.3"
              },
              "items": [
                {
                  "text": "E’do 38:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.29"
              },
              "items": [
