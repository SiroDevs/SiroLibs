                  "text": "’Yeta 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo nga enga Beeri-sebaarisi; auzi Israelini nga yi ati Yakobo pi ji magali Farauni tini pele yi ejizu ’diyisi, anzi yini nyiri nyiri ’diyi pie, oku yini be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.5",
            "verseOrgIds": [
              "GEN.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
