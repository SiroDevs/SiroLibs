        },
        {
          "text": "Eri nga Yuda ma ti pe oko i ma drilia Yusufu vu, geri muzu Goseniari ecezu i dri; yi nga di eca angu Goseniaria ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
