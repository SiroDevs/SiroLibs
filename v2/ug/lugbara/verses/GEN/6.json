        {
          "text": "Yehova ovu ani candisi erini ndra ’ba ’bale nyakuarisi, e’yo nde ovu eri ma asia candiru tu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
