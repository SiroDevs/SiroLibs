          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma ofi maburu ma alia afa rua be idriru ’diyi dria ma azi iri iri, esele be dria dria, yi ta mbazu idriru mi be; ma ovu ago pi aroni be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
