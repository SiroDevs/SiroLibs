          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aria piyi esele yini be, anyapa piyi esele yini be, afa dria acipi aci valesi nyakua ’diyi pie esele yini be, afa ’diyi ma esele dria ma emu mi vu iri iri, yi ta mbazu idriru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
