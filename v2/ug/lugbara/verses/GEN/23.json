                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini amvu Efironini ovupi Makipela ma alia, Mamire ma driliari, amvu nde ma ada pi, oni gule ovupi aleniari pie, pati dria amvu nde ma alia azini ovupi kalatiniasi kuru ’diyi pie dria, yi fe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu dri ovuzu eri ma afaru, anzi Hetini ma milia azini ’ba dria fipi aku erini ma kalitilea ’diyi ma drilia indi. ",
          "type": "text",
          "attrs": {
