            "number": "3",
            "style": "v",
            "sid": "GEN 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu nga enga avu driarisi, nga ’yo anzi Hetini ma tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.3",
            "verseOrgIds": [
              "GEN.23.3"
