              "items": [
                {
                  "text": "Mar 6:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yusufu nga ’yo i adripi ma tia, Ma Yusufu’i; ma atini nga idriru ya? Te adripi erini econi e’yo omvizaru eri ma tia ku, yi ma asini otile yini eri ma mile rulerisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        }
      ]
