              "items": [
                {
                  "text": "Luk 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga e’yo olu eri tia, kini, Yusufuni nga idriru, eri opiru angu Misiriari ma drilia dria! Eri ma ava oti ra, erini yi ma e’yo a’ile kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga e’yo Yusufuni ’yole yi tia ’diyi ’olu eri ma tia dria, te eri ka magali Yusufuni ti epele eri jizu ’diyi ndre ra, yi ati Yakobo nga i asi omvi ra; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli nga ’yo ra, Awa’do; ma mvi Yusufuni nga idriru; ama nga di mu ama ne eri be, de nga ma drani ku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
            "verseOrgIds": [
              "GEN.45.28"
            ]
          }
        }
