                "loc": "GEN.41.43"
              },
              "items": [
                {
                  "text": "E’do 41:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.10"
