                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di, candi ma fu emi ku, aoko ma nya vini emi emini fele ma ozile ’doarisi, ku; a’disiku Mungu pe ma ti emi, drilia ’ba ma idri ta mbazu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.5",
            "verseOrgIds": [
              "GEN.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liki ’de angua eli iri ’bo, te eli ’bani ani ngazu amvu ’yazu ku azini nyaka lozu ku ’diyi ace nga towi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.6",
            "verseOrgIds": [
              "GEN.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Mungu pe ma ti emi drilia ’ba emini ma joloko ta mbazu nyakua, azini emi idri pazu pata amborusi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.7",
            "verseOrgIds": [
              "GEN.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
