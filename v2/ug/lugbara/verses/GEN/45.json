                "loc": "JOB.29.16"
              },
              "items": [
                {
                  "text": "Yob 29:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dini emi peni ma ti ’doa emi’i ku, te Mungu’i; eri ’ba ma ovuzu Farau dri ataru, azini opiru ’ba dria eri ma joa ’diyi ma drilia, ’ba vini ma opiru ’ba dri cezu angu Misiriari ma drilia dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.8",
            "verseOrgIds": [
              "GEN.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "’Yeta 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ’ye mbele mbele, emi tu mu ma ati vu, emi ma ’yo eri tia, Mi mvi Yusufu ’yo ’dini, Mungu ’ba ma opiru Misiri ma drilia dria; mi esi ma vu, mi ci dri ku; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.9",
            "verseOrgIds": [
              "GEN.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.1"
              },
              "items": [
                {
                  "text": "E’do 47:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te mi nga ovu angu Gosenia, mi nga ovu ma be ogogo, mi’i anzi mini pie, mi anzi ma anzipi pie, anyapa mini nyiri ’diyi pie, ’wara’diyi pie, afa dria mini ovuzu yi be ’diyi pie dria; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.4"
              },
              "items": [
                {
                  "text": "1 Tim 5:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma nga nyaka fe mi dri ’dale, a’disiku liki ma eli ace nga towi; mi kazu ecazu ’ba alioru ku, mi’i, ’ba mi vile joa ’diyi pie, afa dria mini ovuzu yi be ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.11",
            "verseOrgIds": [
              "GEN.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.23"
              },
              "items": [
                {
                  "text": "E’do 42:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ndre, emi ndre emi milesi, azini ma adri Benyamini ndre vini i ma milesi indi, kini, ma ngulupini e’yo ’yo emi tia ma tisi ma’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.12",
            "verseOrgIds": [
              "GEN.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12"
              },
              "items": [
                {
                  "text": "Kal 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "’Yeta 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga diza mani dria angu Misiriari ma e’yo olu ma ati tia, afa dria emini ndrele ’diyi be. Te emi nga ’ye mbele mbele, emi nga ma atini eji ’doa ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.13",
            "verseOrgIds": [
              "GEN.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga i adri Benyaminini 0’de ombelea, nga wu mindresi; Benyamini nga vini wu mindresi eri ma ombelea indi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.14",
            "verseOrgIds": [
              "GEN.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga i adripi dria ma o’bolo ndru, nga wu mindresi yi ma dria; vutinia eri ma adripi nga di e’yo ’yo eri be ndo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        }
      ]
    },
