              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba opiru ovupi Esau ma oriru, ori’ba yini vusi, pari yini vusi, ru yini vusi yi ’di: opi Timina pi, opi Aliva pi, opi Yeteti pi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
