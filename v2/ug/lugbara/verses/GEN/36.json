                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.24"
              },
              "items": [
                {
                  "text": "1 Sam 10:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi ambo ambo angu nyapi Edomua de opi amboruni ’ba Israelini ma drilia nga yo ’diyi, yi ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.31",
            "verseOrgIds": [
              "GEN.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela Beori mvi nya angu Edomua, aku erini ma ru Dinihaba’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.32",
            "verseOrgIds": [
              "GEN.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela dra ra, Yobabu Zera Bozi­raari ma mvi nga opi nya eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.33",
            "verseOrgIds": [
              "GEN.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobabu dra ra, Husamu engapi angu ’ba Temania ’diyi­niari nga opi nya eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.34",
            "verseOrgIds": [
              "GEN.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Husamu dra ra, Hadadi Bedadi mvi, Midiani ofupi angu Moabuari nga opi nya eri ma pariani, aku erini ma ru Aviti’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi dra ra, Samila Masirekaari nga opi nya eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samila dra ra, Saulo Rehoboti yi Ara ma tialeruriari nga opi nya eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo dra ra, Baali-hanani Akibori mvi nga opi nya eri ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.50"
              },
              "items": [
                {
                  "text": "1 Sur 1:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baali-hanani Akibori mvi dra ra, Hadari nga opi nya eri ma pariani, aku erini ma ru Pau’i; oku erini ma ru Mehetabei’i, eri Mezahabu Ma­tredi ma zamva ma zi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
      ]
