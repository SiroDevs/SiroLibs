        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, o’du mva­azoni eri e’duzurisi, mi ndre, anzi yi ejoru eri ma opojoa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, erini nga osiria, mva aluri ega dri esu amve; oku eri osipiri nga baka ekaru ’du a’di eri ma dria, kini, Mva ’diri efu okoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, eri ka i dri se vile ’bo, mi ndre, adripi osi ra; eri nga ’yo ra, Mi asi pari mi dri okposi ’dini a’disi ya? ’Da runi ani Perezi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma adri baka ekaru be driari nga osi vileru, ’da eri ma ru Zera’i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        }
      ]
