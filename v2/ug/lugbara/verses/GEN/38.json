                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.21"
              },
              "items": [
                {
                  "text": "Azi 22:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, ka ca mba nale ’ba olu Yuda ma tia kini, Mi zia Tamari ofu mile aci be, azini vini mi ndre, ti mva aliru ’bo. Yuda nga ’yo ra, Emi eji eri ’doa, ma eve eri acisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.32"
              },
              "items": [
                {
                  "text": "E’do 37:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ka eri ofu amve ’bo, eri pe ’ba ti anyi vu, kini, Mva ma aliari afa ’diyi ma e’ini. Eri nga ’yo ra, Mi ini nga,ma zi mi fo, afa ’diyi, driadriamva ecetaruri pi baku pie kali pie, bani yi a’dini ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.24.17"
              },
              "items": [
                {
                  "text": "1 Sam 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.14"
              },
              "items": [
                {
                  "text": "E’do 38:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.31"
              },
              "items": [
                {
                  "text": "Yob 34:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuda nga afa nde a’i ra, nga ’yo ra, Eri ma e’yo kilili aga mani ra, mani eri fele ma mvi Sela dri kurisi. Asini la erisi dika ku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
