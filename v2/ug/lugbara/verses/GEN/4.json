              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu nga oku erini ni dika, eri nga mva ti, nga runi ’da Seti’i;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
