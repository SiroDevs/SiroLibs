                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.11"
              },
              "items": [
                {
                  "text": "Yud 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kaini nga ’yo i adripi Habili ma tia kini, Onyiru ama ma fu mu amvua. Te eri nga eca ’dini, yini de ovuria amvua, Kaini nga enga i adripi Habili ma ruaa ombasi, nga eri fu kai ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.8",
            "verseOrgIds": [
              "GEN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga di ’yo Kaini ma tia, Mi adri Habilini ngoa ya ? Eri nga ’yo ra, Ma nini ku; ma ’ba ma adripi ma ta mbapiri ma’i ya ? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.24"
              },
              "items": [
                {
                  "text": "Ebra 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.10"
              },
              "items": [
                {
                  "text": "Eceza 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo eri tia, Mi ’ye ngoni ya? O’duko mi adripi ma ariniri wu ma bilia engazu nyakuarisi ’do. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.10",
            "verseOrgIds": [
              "GEN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.15+DEU.28.16+DEU.28.17+DEU.28.18+DEU.28.19+DEU.28.20"
              },
              "items": [
                {
                  "text": "Azi 28:15-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.10"
              },
              "items": [
                {
                  "text": "Gal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.16.18"
              },
              "items": [
                {
                  "text": "Yob 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do mi ovu trizaru nyakuarisi ’bo, nyaku nderini i ti zile mi adripi ma ari mini adaleri mvuzurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.11",
            "verseOrgIds": [
              "GEN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ka nga nyaku nde ’ya ra, eri ngani curu’do afa ka mi dri eri ma okposi ku; mi nga ovu ’ba apapi apariru, azini ’ba abapi saaruriru oro drisi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.12",
            "verseOrgIds": [
              "GEN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaini ang ’yo Yehova ma tia, Panga mani nde ma ra, okpo mani eri ’duzu yo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ndre, mi dro ma andru nyakuarisi bo; ma nga ovu zizaru mi milia; ma nga ovu ’ba apapi apariru azini ’ba abapi saaruriru oro drisi dria, te eri nga eca ’dini, ’ba ma isupiri nga ma fu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.14",
            "verseOrgIds": [
              "GEN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Eze 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga ’yo eri tia, E’yo ’disi ’ba ka Kainini fu ra, eri nga avutani ofe paleko aziri. Yehova nga eceta ’ba Kaini ma dria, ’ba eri isupiri kazu eri ’dizu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.23"
              },
              "items": [
                {
                  "text": "2 Opi 13:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.20"
              },
              "items": [
                {
                  "text": "24:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.39"
              },
              "items": [
                {
                  "text": "Yer 23:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.3"
              },
              "items": [
                {
                  "text": "52:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kaini nga di fu Yehova ma driliarisi, nga mu ovu angu Nodia Edeni ma kala etuni efurialeruria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        }
      ]
    },
