            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.16"
              },
              "items": [
                {
                  "text": "Efu 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini nga e’yo ’yoria yi be, Rakeli emu i ati ma kabilo be; erini yi agei telenirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.17"
              },
              "items": [
                {
                  "text": "Efu 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Yakobo ka Rakeli Labani i andri ma adripi ma zi pi ndre, kabilo Labani i andri ma adripini be, Yakobo nga esi ogogo, nga oni ogu yi a’di ma tiliasi, nga yi fe kabilo ongulumuru Labani i andri ma adripini dri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.33.4"
              },
              "items": [
                {
                  "text": "E’do 33:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.14"
              },
              "items": [
                {
                  "text": "45:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.16"
              },
              "items": [
                {
                  "text": "Rum 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.20"
              },
              "items": [
                {
                  "text": "1 Kor 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.12"
              },
              "items": [
                {
                  "text": "2 Kor 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.14"
              },
              "items": [
                {
                  "text": "1 Pet 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo nga Rakeli ma o’bolo ndru, nga wu mindresi o’duko urusi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.8"
              },
              "items": [
                {
                  "text": "E’do 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.28"
              },
              "items": [
                {
                  "text": "24:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo nga di: ’yo Rakeli tia kini i ovu ati ma adri, kini i Rebeka ma mvi’i; eri nga di nzu ani e’yo nde olu i ati ma tia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
