              },
              "items": [
                {
                  "text": "E’do 30:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ndre kini ngu Leani onzi, eri nga ani eri ma opojo zi mva tizu; te Rakelini ondoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
