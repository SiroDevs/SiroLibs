              "items": [
                {
                  "text": "Hos 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga fi Rakeli vu indi, azini vini le Rakelini aga Leani ra, eri nga azi azini nga eri dri eli aziri dika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
