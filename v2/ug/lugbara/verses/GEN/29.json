            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.44"
              },
              "items": [
                {
                  "text": "106:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lea nga mva isu i ma alia, nga osi agupia­ni, nga runi ’da Rubeni’i; te eci ’yo ra, Yehova lu inzata mani vu ’bo; curu’do agupi ma vileri nga ma le ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga vini mva isu dika, nga osi agupiani, nga ’yo ra, Yehovani e’yoni erile kini ngu ma onzirisi, fe vini mva ’diri ma dri ani; nga runi ’da Simeoni’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga mva isu dika, nga osi agupiani, nga ’yo ra, Curu’do agupi ma vileri nga ri eci ma be, mani agianzi otile eri dri narisi; ’da ani runi Levi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga mva isu dika, nga vini osi agu­piani, nga ’yo ra, Curu’do ’dorisi ma nga Yehovani inzi ra; eri ’da ani runi Yuda’i; nga di asi tizu ra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
