  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "GEN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’bianzi Noa anzipi Semi pini, Hamu pie, Yafeti pie ’diyi yi ’di; yi oti anzi yi tiza ma vutia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.5+1CH.1.6+1CH.1.7"
              },
              "items": [
                {
                  "text": "1 Sur 1:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Yafetini: Gomeri pi, Magogi pi, Madai pi, Yavani pi, Tubali pi, Meseki pi, Tirasi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Gomerini: Asikenazi pi, Rifati pi, Togarima pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.3",
            "verseOrgIds": [
              "GEN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Yavanini: Elisa pi, Tarisisi pi, Kitimu pi, Dodanimu pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.4",
            "verseOrgIds": [
              "GEN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ovupi angu yi olipi miri ma alia ’diyia suru ndu nduni ’diyi enga ’ba ’diyi ma eselia, awa yi angu vusi, ’ba dria alu alu ti ’yoza yini vosi, ori’ba yini vusi, suru yini ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Hamuni: Kusi pi, Mizirai­mu pi, Putu pi, Kanani pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.6",
            "verseOrgIds": [
              "GEN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Kusini; Seba pi, Havila pi, Sabita pi, Raama pi, Sabiteka pie. Anzi Raamani: Seba pi Dedani be. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusi ti Nimirodini; eri e’do ovu ’ba okporu nyakuani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.8",
            "verseOrgIds": [
              "GEN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.11"
              },
              "items": [
                {
                  "text": "E’do 6:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’ba okporu za gbipi tu Yehova ma miliari; e’yo ’disi yi ’yo ’dini, Ekile Nimirodi ’ba okporu za gbipi tu Yehova ma miliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.9",
            "verseOrgIds": [
              "GEN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.6"
              },
              "items": [
                {
                  "text": "Mik 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi nyaza erini e’do oko Babeli pisi, Ereki pie, Akadi pie, Kaline pie, yi dria angu Sinaria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.10",
            "verseOrgIds": [
              "GEN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri efu angu nderiasi mu fi Asuriaa, nga Nineve pi si Rehoboti­Iri pie, Kala pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.11",
            "verseOrgIds": [
              "GEN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reseni Nineve pi ma eselia Kala beri pie dria; Kala nderi aku amboru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miziraimu oti ’ba Ludini piyi, ’ba Anamunipie, ’ba Lehabini pie, ’ba Nafituhini pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.13",
            "verseOrgIds": [
              "GEN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.12"
              },
              "items": [
                {
                  "text": "1 Sur 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba Patirusini pie, ’ba Kasiluhini pie (’ba Filistini efu ’ba ’diyi ma alia), ’ba Kafitorini pie dria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanani oti Zidoni mva erini okori pi, Heti pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.15",
            "verseOrgIds": [
              "GEN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba Yebusini: pie, ’ba Amorini pie, ’ba Girigasini pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.16",
            "verseOrgIds": [
              "GEN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba Hivini pie, ’ba Arikini pie, ’ba Sinini pie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.17",
            "verseOrgIds": [
              "GEN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba Arivadini pie, ’ba Zemarini pie, ’ba Hamatini pie. Vilerisi ’ba Kananini ’diyi ma ori’ba nga yi ere ndu ndu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.12+GEN.13.13+GEN.13.14+GEN.13.15"
              },
              "items": [
                {
                  "text": "E’do 13:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18+GEN.15.19+GEN.15.20+GEN.15.21"
              },
              "items": [
                {
                  "text": "15:18-21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.2"
              },
              "items": [
                {
                  "text": "Kal 34:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.7"
              },
              "items": [
                {
                  "text": "Yos 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Kananini ma kalati enga ndra Zido­niasi, mini muria geri Gerariarisi kpere Gazaa, azini mini muria geri Sodomu piarisi Gomora pie, Adima pie, Zeboimu pie kpere Lasaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.19",
            "verseOrgIds": [
              "GEN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Diyi yi anzi Hamuni ori’ba yini vusi, ti ’yoza yini vusi, angu yini ma alia azini suru yini ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oti anzi Semi ovupi Eberi ma anzipi dria ma a’biruri dri indi, eri Yafeti ma adripi amboruri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.21",
            "verseOrgIds": [
              "GEN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.17"
              },
              "items": [
                {
                  "text": "1 Sur 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Semini: Elamu pi, Asuri pi, Aripa­kisadi pi, Ludi pi, Aramu pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.22",
            "verseOrgIds": [
              "GEN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Aramuni: Uzi pi, Huli pi, Geteri pi, Masi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.23",
            "verseOrgIds": [
              "GEN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.12"
              },
              "items": [
                {
                  "text": "E’do 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aripakisadi ti Selani; Sela ti Eberini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.24",
            "verseOrgIds": [
              "GEN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.19"
              },
              "items": [
                {
                  "text": "1 Sur 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oti anzi iri Eberi dri: aluri ma ru Pelegi’i,’yini ndra angu wudrikuru awale ewu erinisirisi; adripi ma ru Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokitani ti Alimodadi pi, Selefi pi, Hazarimaveti pi, Yera pi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
