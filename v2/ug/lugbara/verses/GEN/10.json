          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obali pi, Abimaeli pi, Seba pi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.28",
            "verseOrgIds": [
              "GEN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofiri pi, Havila pi, Yobabu pie; ’diyi dria anzi Yokitani­ni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.29",
            "verseOrgIds": [
              "GEN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari yini ovuzurie’do Mesaa, mi ka mu geri Sefari vuleru, oni etuni efurialeruria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Diyi anzi Semini, ori’ba yini vusi, ti ’yoza yini vusi, angu yini ma alia, suru yini vusi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.31",
            "verseOrgIds": [
              "GEN.10.31"
            ]
          }
        }
