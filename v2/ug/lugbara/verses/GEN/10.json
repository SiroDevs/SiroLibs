              "type": "text"
            }
          ]
        },
        {
          "text": "Hadoramu pi, lizali Pi, Dikila pi ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.27",
            "verseOrgIds": [
              "GEN.10.27"
            ]
          }
