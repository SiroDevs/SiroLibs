                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ajirikolo ’du i rua fazu, nga di ri ofuta ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.8",
            "verseOrgIds": [
              "JOB.2.8"
