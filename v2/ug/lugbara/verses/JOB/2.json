                }
              ]
            }
          ]
        },
        {
          "text": "Te di Yobu ma agyi na ’diyi ka e’yo onzi dria ecapi eri ma ruaari ma e’yo eri ra, yi dria alu alu enga yi ma ngulupi ma pariasi, Elifazi ’ba Temanini pi, Bilidadi ’ba Suhini pi, Zofari ’ba Naamatini pie. Yi otu e’yo yi eselia emuzu eri owuzu, azini asini omizu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
