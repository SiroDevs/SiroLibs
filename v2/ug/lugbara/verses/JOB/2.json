              "items": [
                {
                  "text": "Yob 19:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.3"
              },
              "items": [
                {
                  "text": "Zab 32:3",
                  "type": "text"
