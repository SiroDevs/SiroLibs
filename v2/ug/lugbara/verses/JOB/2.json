            }
          ]
        },
        {
          "text": "Yi ka yi mile enga uru ziri, yi nini eri ku; yi nga di wu o’duko urusi; yi alu alu nga yi ma bongo ’beza asi ra, nga irifura omvu uru yi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
            "verseOrgIds": [
              "JOB.2.12"
            ]
          }
        },
