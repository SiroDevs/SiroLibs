                "loc": "PSA.32.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi eju mi dri curu’do, mi elo eri ma fala pi rua be, eri nga mi o’da kpere va mi milia ’dia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo Satani ma ria, Mi ndre, ma fe eri mi dria; te kiri mi ma ku idri erini’i.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        }
      ]
