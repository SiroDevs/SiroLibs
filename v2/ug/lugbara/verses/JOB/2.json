              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Satani nga fu Yehova ma miliasi, nga Yobuni co apipi onzika­nyarusi kurubu, engazu eri ma pa agelea kpere eri ma dri olubua. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
