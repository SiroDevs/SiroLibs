                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, o’du anzi erini ezoanzi erini be yini nyaka nyazu patiefi ma su mvuzu yi adri ambori ma joarisi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ojio nga eca Yobu vu kini, Ti yini e’bu seria, akanya aroni yini iribi nyaria yi ageia, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.7"
              },
              "items": [
                {
                  "text": "E’do 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba Sabeaa ’diyi o’de yi ma dria, nga yi opa jizu ra, ada yi ofu ati’ba seisi ’bo; kiri ma pa ma a’dule e’yoni ejizu mi vuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini de e’yo ’yoria ’ba azini nga vini eca, kini, Aci Munguni e’de ’bua, ove kabilo piyi teketeke ati’ba be, ja yi dri dria; kiri ma pa ma a’dule e’yoni ejizu mi vuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini de e’yo ’yoria ’ba azini nga vini eca, kini, ’Ba Kalideyaa ’diyi awa yi esele ongulu­muru ongulumuru na, o’de ngamia ma dria, ji yi ra, ada ofu ati’ba seisi ’bo; kiri ma pa ma a’dule e’yoni ejizu mi vuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini de e’yo ’yoria ’ba azini nga vini eca, kini, Agianzi mini piyi mi ezopi be yini de nyaka nyaria patiefi ma su mvuria, yi adri ambori ma joa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
