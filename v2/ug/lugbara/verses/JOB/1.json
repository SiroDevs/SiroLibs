                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu o’du azinisi anzi Munguni emu yi e’dazu Yehova ma milia, te Satani emu alu indi yi ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.43"
              },
              "items": [
                {
                  "text": "Mat 12:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.8"
              },
              "items": [
                {
                  "text": "1 Pet 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo Satani ma tia, Mi enga ngoa ya? Satani nga di e’yo omvi Yehova ma tia, ’yo kini, Ma ibi enga mani aciria ’dile ’dale nyaku ma dria, mani kelekele coria ’dale ’dole eri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo Satani ma tia, Mi ega ati’bo mani Yobu ma e’yo ra ya? ’ba azini erile nyaku ma driani yo, eri ’ba e’yo kokori, ’ba kililiruni, ’ba Mungu rupi, i onapi e’yo onzisiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Eceza 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Satani nga di e’yo omvi Yehova ma tia, nga ’yo kini, Yobuni Mungu ru oye ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
