          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri pe e’yo ti nabi Natani ma tisi; ’dini eri ’da runi Yedidia’i, Yehova ma e’yosi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
