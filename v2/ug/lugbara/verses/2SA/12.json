                "loc": "EXO.22.1"
              },
              "items": [
                {
                  "text": "Efu 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.8"
