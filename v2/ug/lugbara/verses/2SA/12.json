              "items": [
                {
                  "text": "2 Sam 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi sei ngani ori’ba mini ku aluni ku, mini ma onzolerisi, mini oku Uria ’ba Hitiniri ’duzu ovuzu oku miniru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
