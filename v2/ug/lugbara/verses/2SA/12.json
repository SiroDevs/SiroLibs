          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma fe mi dri opi mi vileri ma jo, azini oku opi mi vilerini ’diyi mi agatia, ma fe vini mi dri suru Israelini pi Yudani be; te ’di ka ovu ndra were te’do ma fe mi dri afa ’diyi ’diyi drinia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
