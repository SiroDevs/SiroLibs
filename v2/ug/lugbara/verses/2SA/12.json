              "items": [
                {
                  "text": "1 Sur 22:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi omi oku erini Bati­seba ma asi, fi eri vu, la eri be, te oku nde osi mva, ’da runi Sulemani’i. Te Yehova le eri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
