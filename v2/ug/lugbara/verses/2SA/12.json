              "items": [
                {
                  "text": "Luk 19:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te eri ma omvi kabilo su alu nderi ma Paria, erini e’yo ’di ’yelerisi, azini erini ovule yiki kokorurisi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
