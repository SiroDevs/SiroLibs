        },
        {
          "text": "Te Daudi nga enga nyakuasi, oji i rua, efi i odusi, su bongo azini; te eri nga fi; Yeho­vani alia eri inzizu; vutinia eri mu jo i ngulupiniria; eri ka omve, yi ’ba nyaka eri drilia, te eri nya ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
