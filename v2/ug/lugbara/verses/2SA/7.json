                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Natani nga ’yo opi tia, Mi mu, mi ’ye e’yo dria ovupi mi asiarile; a’di­siku Yehovani mi be ci. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri eca ’dini ini nderisi, e’yo Yehovani eca Natani vu, ’yozu kini, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi mu ’yo ati’bo mani Daudi ma tia, Yehova kini ’dini, Mi nga jo si ma dri mani ovuzu alenia ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.16"
              },
              "items": [
                {
                  "text": "1 Opi 8:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ovuni jo be ku engazu o’du mani Israeli anzi ofuzu Misiriasirisi ecazu kpere andru, te mani aciria ma ovu hema alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
