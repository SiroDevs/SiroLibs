                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "opi nga ’yo nabi Natani tia kini, Mi ne nga, ma ovu jo sile mario patisiri ma alia, te sanduku Munguni ovu hema alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
            "verseOrgIds": [
