                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do, Opi Yehova la, mi ovu Mungu, e’yo mini ’yole ’diyi Yi adaru, te mi azi e’yo onyiru ’dori ati’bo mini dri ’bo; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
