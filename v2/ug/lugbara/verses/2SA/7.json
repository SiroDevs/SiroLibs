              },
              "items": [
                {
                  "text": "Azi 26:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi edre mi ngulupi dri ’ba mini Israeli ovuzu ’ba miniru ’dani ’dani; te mi, Yehova, eca ndra Mungu yiniru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
