            "number": "8",
            "style": "v",
            "sid": "2SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi curu’do, mi nga ’yo ’dini ati’bo mani Daudi ma tia, kini, Yehova asikari ongulumuruniri ’yo ’dini, Ma e’du mi ndra nyamukoa kabilo oceria, ’dini mini ovuzu opiru ’ba mani Israeli ma drilia; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
