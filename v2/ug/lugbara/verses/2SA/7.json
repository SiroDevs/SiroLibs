          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mungu la,curu­’do e’yo mini ’yole ’bo ati’bo mini pi ma e’yosi ori’ba erini beri, mi edre eri ’dani ’dani, mi ’ye ekile mini ’yolerile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
