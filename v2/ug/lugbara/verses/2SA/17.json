          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia Daudi enga, ’ba dria ovupi eri be ’diyi be, yi zo Yoridanini, etuni ’baria efuria ’ba aluni acepi zokokoruni yo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        }
