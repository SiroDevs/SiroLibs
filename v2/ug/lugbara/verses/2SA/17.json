                "loc": "1KI.1.9"
              },
              "items": [
                {
                  "text": "1 Opi 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yonatani pi Ahimaazi be yi awu te Eni-rogelia; zamva ati’boru adri mu e’yo ’yo yi be, yi adri mu e’yo olu opi Daudi ma tia beni; a’disiku yi ma e’da yini efiria aku alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.16"
              },
              "items": [
                {
                  "text": "2 Sam 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.5"
              },
              "items": [
                {
                  "text": "16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te agupimva alu ne yi ra, ’yo Abisalomu tia; te yi enga iri tro mbele, yi eca agu Bahurimua ovupi yi ’bile be iriidri eriniari vile joa; yi si va alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.6"
              },
              "items": [
                {
                  "text": "Yos 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te oku nderi a’bu ’bile nderi ma ti ci, eri aja anya drinia; te ’ba aluni nini e’yo nderi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
