            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.2"
              },
              "items": [
                {
                  "text": "21:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ati’ba Abi­salomuni ’diyi ka eca oku nderi vu joa ’bo, yi ’yo kini, Ahimaazi pi Yonatani be ngoa ya? Te oku ’yo yi tia kini, Yi zo yi tia ’aa’dasi ’bo Te yini yi ndaria ’boria, yi isuni yi ku, yi mvi Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.20",
            "verseOrgIds": [
              "2SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
