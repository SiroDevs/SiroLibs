              "items": [
                {
                  "text": "2 Sam 3:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi nga azita fe karile erini ’diyi dri, yi fu yi ra, oli yi ma dri pa pie, o’i yi yi alio Hebironiari ma tia. Te yi ’du Isiboseti ma dri, sa eri Hebironia Abineri ma nyadria.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.12",
