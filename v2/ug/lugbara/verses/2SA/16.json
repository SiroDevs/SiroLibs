          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi nga ’yo Abisai pi ma tia ati’ba ini ’diyi be dria kini, Emi ne, ma mvi efupi ma ruaari, eri nda ma fuzu; agapi turi ’ba, suru Benyaminini ’dori eco e’yo nde ’yezaru ra! Emi ku eri, eri ma o’da; a’disiku Yehova azi eri ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
