            }
          ]
        },
        {
          "text": "Te Abisalomu ’yo Husai ma tia, ’Di asi adaru mini mi agyi vuri ya? Mi muni mi agyi be ku a’di e’yosi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.17",
            "verseOrgIds": [
              "2SA.16.17"
            ]
          }
        },
