          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Husai nga ’yo Abi­salomu ma ria, kini, Yo; te ’ba Yehova pini pele, ’ba erini ’diyi pie, ’ba dria Israelini ’diyi pieri, ma nga mani ovu ’ba eriniri, ma nga ovu eri be. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
              "2SA.16.18"
            ]
          }
        },
