              "items": [
                {
                  "text": "2 Sam 19:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi nga ’yo, Opi miniri ma mvini ngoa ya? Ziba nga ’yo opi tia kini, Mi ne, eri ovu Yerusalemua; te eri ’yo, Andru suru Israelini nga opi nyaza ma atini omvi ma dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
