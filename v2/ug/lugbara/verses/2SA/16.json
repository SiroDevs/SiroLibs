              },
              "items": [
                {
                  "text": "2 Sam 12:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi yi aso hema Abisalomu ma dri jo dri senderuri ma dria; te Abi­salomu nga fi oku ati’baru i ati vile ’diyi vu Israeli dria ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
              "2SA.16.22"
            ]
          }
        },
