              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi nya opi Israeli drilia; eri li e’yo, eri ’ye e’yo kilili ’ba erini ’diyi dri dria, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
