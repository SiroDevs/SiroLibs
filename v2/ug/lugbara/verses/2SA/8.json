              "items": [
                {
                  "text": "1 Sur 24:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini Zadoki Ahitubu mvi pi Ahimeleki Abiatari mvi be, yi ovu kuhanini; Serayani ’ba waraga sipiri’i; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
            "verseOrgIds": [
              "2SA.8.17"
            ]
          }
        },
