                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri aga Moabuni ra, eri o’bi yi bakasi fezu yini lazu va nyakua; o’bile baka irisi ’diyi odra ra, te o’bile baka alusi tre ’ba kule idriru ’diyi. Te ’ba Moabua ’diyi yi eca ati’ba Daudiniru, yi eji afa feza azileri Daudi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.10.6"
              },
              "items": [
                {
                  "text": "2 Sam 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "E’do 15:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi fu vini Hadadezeri Re­hobu mvini opi Zobaari, erini muzu angu yi Ufirateari ’duzu dikaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi obi asikari tupi akanya dria ’diyi alifu alu turu aziri, azini asikari pasi ’diyi alifu kali iri; Daudi nga isu akanya ma paa ’diyi oli dria, Ite ku azini ’diyi gari turu alu ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba Suriaa Damasikia ’diyi ka eca Hadadezeri opi Zobaari ma aza kozu, Daudi ofu ’ba Suriaa ’diyi alifu kali iri drini iri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi nga asikari o’ba Suria Damasikiari ma agei tezu, te ’ba Suriaa ’diyi nga eca ati’ba Daudiniru, nga afa feza azileri eji eri dri. Te Yehova fe Daudi dri agazu pari dria erini muzuria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi o’du gombere meleru ovupi ati’ba Ha­dadezeri vile ’diyi ma dria ’diyi, eji ’yi Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi Daudi o’du mola kakau engazu Beta pia ’Berotai be, yi aku Hadadezerini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Toi opi Hamatuari ka eri kini Daudi ofu asikari ongulumuru Hadadezeri vile ’diyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toi pe mvi Yoramu ma ti opi Daudi vu, i zi mi ci ci fezu eri dri, azini asi ndriza fezu eri dri erini a’di ’dile Hadadezeri be, erini eri fulerisi; a’disiku Hadadezeri pi adri a’di ’di Toi be. Te Yoramu eji imvu dahabuni pi, imvu meleni pie, imvu molani pie; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
