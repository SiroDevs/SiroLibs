                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "opi Daudi ’ba afa ’diyi ndu Yehova dri, tualu dahabu pi, mele pie, erini ’bale ndu engazu suru dria erini agale ’diyi ma eselia ’diyi be, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "engapi Suria pia, Moabu be, engazu vini Amoni anzi pi vu, ’ba Filisitiaa ’diyi ’pie, Amaleki pie, afa opale Hada­dezeri Rehobu mvi opi Zobaari vu ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.60.1"
              },
              "items": [
                {
                  "text": "Zab 60:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.7"
              },
              "items": [
                {
                  "text": "2 Opi 14:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi ma ru ku, erini emviria ’ba Suriaa alifu mudri drini aro ’diyi ofuzu e’bu A’iniari ma vutia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
