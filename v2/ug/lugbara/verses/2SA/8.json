                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yoabu Zeruiya mvi ovu ambo asikari ongulumuru ma driliari’i; azini Yehosafati Ahi­ludi mvi ovu ’ba suru ma e’yo sipiri’i; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 8:17"
          },
          "items": [
            {
