              },
              "items": [
                {
                  "text": "Yos 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.17.5"
              },
              "items": [
                {
                  "text": "Isa 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te isu ’ba Filisitiaa ’diyi eca, ere yi e’bu Refaimuaria ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.18",
            "verseOrgIds": [
              "2SA.5.18"
            ]
          }
        },
