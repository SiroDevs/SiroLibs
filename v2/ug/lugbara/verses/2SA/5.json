          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nya opi Yuda ma drilia Hebi­ronia eli aziri drinia mba azia; eri nya vini opi Yerusalemua Israeli pi ma drilia Yuda be eli kali na drini na.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
