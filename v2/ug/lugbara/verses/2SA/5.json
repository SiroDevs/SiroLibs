                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eli Daudini ovu kali na erini e’dozu opi nyazurisi, eri nya opi eli kali su. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
