              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi ’ tile eri dri Yerusalemua ’diyi ma ru ’di: Samua pi, Sobabu pi, Natani pi,Sulemani pi, ",
          "type": "text",
          "attrs": {
