                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Hanuni o’du ati’ba Daudini, fa yi ma tibi ega alua ega alua, li yi ma bongo agadua oro vusi kpi, fe yi dri geri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ka e’yo nderi olu Daudi tia, eri pe ’ba ti muzu dri fuzu yi be, toko ku ’ba ’diyi ovu drinza be tu. Te opi ’yo, Emi te Yerikoa, cazu tibi eminini duzuria, emi nga emvi ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
