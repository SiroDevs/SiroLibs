              "type": "text"
            }
          ]
        },
        {
          "text": "Te Daudi mu uru ekile Gadini ’yolerile, ekile Yehovani azita felerile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
