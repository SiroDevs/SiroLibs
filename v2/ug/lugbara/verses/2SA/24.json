            }
          ]
        },
        {
          "text": "Te Gadi nga emu Daudi vu etu nderisi, ’yo eri tia kini, Mi mu uru, mi ede pari edeta edezuri Yehova dri, pari anya dizu Arauna i’ba Yebusini vileria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
