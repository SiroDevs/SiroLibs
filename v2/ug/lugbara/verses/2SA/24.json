                  "text": "9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudini engaria o’bitisi, e’yo Yehovani eca nabi Gadi, ’ba e’yo ndreza ndrepi Daudi driri vu, ’yozu kini, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi mu ’yo Daudi tia, Yehova ’yo ’dini, Ma ’ba mi drilia e’yo na; mi pe yi ma alu, ’dini ma ma ’ye e’yo nderi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
