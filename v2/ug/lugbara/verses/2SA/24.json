          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi eca pari okporu Turoaria, azini aku dria ’ba Hivini pima ’ba Kananini pie; yi fu mu Yuda vu andraleru Beeri-sebaa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        },
        {
