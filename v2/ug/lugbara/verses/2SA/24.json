              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini yi ka aga ’dale ’dole ’dale ’dole angu eseliasi dria, yi ca Yerusalemua mba oromi drinia o’du kali iriri ka yi de ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        },
        {
