          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeleki Amoniari, Naharai Bee­rotiari, ’ba afa suza ayaru ombani, Yoabu Zeruiya mvi vile ’diyi ojipiri, ",
          "type": "text",
