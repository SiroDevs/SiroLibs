          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.12"
              },
              "items": [
                {
                  "text": "1 Sur 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma vutia Sama Agee mvi ’ba Harariari. ’Ba Filisitiaa ’diyi oku yi ongulumuru Lehia, pari amvu osunini ovuzuria; te ’ba yi apa ’ba Filisitiaa ’diyi driliasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri so pa amvu nderi ma eselia ageini tezu, ofu ’ba Filisitiaa ’diyi ra; te Yehova fe agaza amboru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        },
