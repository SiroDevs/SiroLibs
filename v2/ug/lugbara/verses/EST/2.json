                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu Mori­dekai eri e’yo ’diri ra, eri olu Esiteri oku opiniri ma tia, Esiteri indi eri olu e’yo nderi opi ma tia Moridekai ma rusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
            "verseOrgIds": [
              "EST.2.22"
            ]
