                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi nga di omu amboru ’ba ’ba amboru erini ’diyi pi dri dria, ati’ba erini be, ’di’i omu Esiterini. Dika eri fe ’ba ma li ava angu awaza erini nyale ’diyi ma alia, azini eri fe afa feza ’ba dri, ekile lonyi opinirile. Moridekaini e’yo otule opi ma ruaari ecezuri ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 2:19"
          },
          "items": [
