          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.7"
              },
              "items": [
                {
                  "text": "Esi 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini yi ji di Esiterini opi Ahasueru vu jo erini opiniria mba mudrisi, ’di mba Tebeti’i, eli aziri erini opi nyazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
              "EST.2.16"
            ]
          }
        },
