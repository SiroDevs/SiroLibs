            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu ndra Yahudiou alu ovu Susani aku opiniria ’dale, runi Moridekai, Simei Kisi mvi ma mva Yairi ma mvi, suruti Benyaminini, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
