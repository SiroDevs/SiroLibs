                "loc": "1KI.1.2"
              },
              "items": [
                {
                  "text": "1 Opi 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ati’ba opini azi ngapi eri dri ’diyi nga di ’yo ra, ’Ba ma ndru ezoanzi aliriaru yi ecipi agupi be ku, ndrizaru ’diyi, opi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi ma o’ba ’ba amboru angu opi nyaza erini ma alia ’diyia dria, yi ma oku lezoanzi aliriaru yi ecipi agupi be ku, ndrizaru ’diyi, ma eji yi Susani aku opiniria yi o’bazu okujoa Hegai ovupi ati’bo opini oku ma agei tepiri ma dria; azini ’ba ma fe yi dri afa onyiafaru yini yi ’bazu alaru ani’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te zamva ngapi ayiko fepi opi driri ma ovu opi okuru Vasiti ma paria. E’yo ’diri ovu opi ma milia onyiru, eri ’ye ’dini indi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
