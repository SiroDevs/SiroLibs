              "items": [
                {
                  "text": "Dan 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Hamani ka ndre Moridekai osini kumuti ku, inzini ku indi, adra ga tre Hamani ma asia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.4"
              },
              "items": [
                {
                  "text": "Zab 83:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ma milia Mori­dekaini bizu a’duleri ovu toko; a’disiku yini eri dri Moridekai ma suru ma e’yo olule rarisi. E’yo ’disi Hamani ndru geri ’ba Yahudini o zupi suru dria opi Ahasueruniri ma alia ’diyi dria ma dri jazu, adam suru Moridekaini.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
