          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi yi omve o’du nde ’diyi Purimu, ru Puriri vusi. E’yo dria ndra waraga ’dori ma alia ’diyi pi ma e’yosi, e’yo dria ovupi yi drilia yini nele ngapi ecapi yi vu e’yo ’dori ma alia ’diyi pie, e’yo ecapi yi vu ’bo ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
