                }
              ]
            }
          ]
        },
        {
          "text": "o’du nderisi ’ba Yahudini yi oku yi aku yinia angu dria opi Aha­sueru vileria, yini lezu ’ba yi ’yepi onzi ’diyi ofuzu dri yinisi. Te di isu ’ba aluni yi ogapini yo, a’disiku rota ’ba ’diyi ruzurini ’dele ’ba dria ma dria ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
