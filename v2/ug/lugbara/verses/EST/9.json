          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini ’ba ma ega o’du ambo ’diyi ’dani, ma mba yi ma ta yi eselia a’bianzi vusi dria, enyati vusi dria’i angu awaza vusi dria, aku vusi dria, azini o’du ambo Purimuni ’diyi ma avi ’ba Yahudini ’diyi ma eseliasi ku, egatani ma de i ori’ba yini ma eseliasi ku indio, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        },
        {
