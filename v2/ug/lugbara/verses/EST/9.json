                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba Yahudini fe azita, yi a’i eri yi ma ngulupi pi dri ori’ba yini pie, ’ba ngapi yi ecipi yi be tualu ’diyi pie, ’dini yi ma ece ku o’du iri ’diyi ma ta mbazu, ekile e’yo siza nderini ’yolerile, ekile o’du ndeni ecale eli vusi eli vusi ’bani pele ’borile, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
