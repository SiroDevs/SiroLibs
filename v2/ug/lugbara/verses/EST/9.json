                  "text": "O’be 16:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ambo angu awaza dria ma drilia ’diyi, ’ba opiru angu nyapi ’diyi pie, ’ba ambo ’diyi pie, ’ba azi opini ngapi ’diyi pie, yi ko ’ba Yahudini ma aza, a’disiku ruta Moridekaini ruzuri ’de yi ma dria ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
