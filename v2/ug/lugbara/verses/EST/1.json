                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ewu ndesi, Ahasueruni riria oguna ini opiniri ma dria, aku opini Susani ma alia, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
