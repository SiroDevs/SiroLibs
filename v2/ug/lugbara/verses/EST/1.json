                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.21"
              },
              "items": [
                {
                  "text": "Mar 6:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eli na erini opi nyazurisi eri ’ba omu amboru ’ba amboru erini ’diyi pi dri dria, ati’ba ini ’diyi be, ’ba okporu engapi Perisiaa azini Mediaa ’diyi pini ovuria eri drilia, ’ba ’wara anguni ’diyi pie, ’ba amboru ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga lonyi opi nyaza dizaru erinirini pi ece, diza erini opini inzile turi be o’du kakausi, cazu kpere o’du turu alu drini kali aro. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’diyi ka aga ra, opi ’ye omu eri vile aku opiniri ma iriia, ’ba dria ovupi aku Susania ’diyi dri, ’ba kuza pi dri ’ba soroa ’diyi be dria; omu nde nya o’du aziri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.7.8"
              },
              "items": [
                {
                  "text": "Esi 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.8"
              },
              "items": [
                {
                  "text": "Amo 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dale ’ba o’i bongo mile be nyiriari, azini emveru azini bluru; buka o’beza edele bongo mile be nyiriasiri pisi okalakokalari be ’diyi ombe bongo ’ile nde ’diyi emvea dahaburu ’diyi pi ma ruaa oni ndrizaru pa sopi piriru ’diyi be; ’ba gbolo meleru azini dahaburu oni otiza edele oni ekaru pisi, emveru pie, fororu pie, iniru pieri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi fe ’ba dri afa mvuza mvuzu okelea meleru ma alia (obi yini ndu ndu), azini patiefi ma su opi vile fudri ci tu, opi ma lonyile. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba mvu dria azita ’bani azileri vusi, ’ba econi ’ba omi ani okposi ku; opini e’yoni azile ’ba amboru eri vile joa ’diyi ma tia ’dinirisi, kini yi ma ’ye ekile ’ba alu aluni lelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dale vini indi oku opini Vasiti’i, eri ’ba omu okuyi dri opi Ahasueru vile joa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du azirisi, opi ma asini garia tre ayikosi patiefi susi, eri azi Mehu­mani pi dri, Bizita pie, Haribona pie, Bigita pie, Abagita pie, Zetari pie, Karikasi pie, yi ati’ba aziri azi ngapi Ahasueru ma ngulupi dri ’diyi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.9"
              },
              "items": [
                {
                  "text": "O’be 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ma eji Vasiti oku opini opi ma drilia, ekilaza opiniri be eri dria, onyi erini ecezu ’ba dria ma milia, azini ’ba ambo ’diyi ma milia indi; a’disiku eri ovu nezaru ndrizaru tu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te oku opini Vasiti ga azita opini azile ati’ba erini ’diyi ma tiari eri­ko si, E’yo ’disi opi ovu aokosi tu, adra enga eri ma alia aciru.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
