                  "text": "Mat 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi nga di ’yo ’ba onduaru o’du nde nipi ’diyi ma tia-opini adri ’ye ’dini ’ba azita pi nipi e’yo liza suruni be ’diyi vu; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.14"
              },
              "items": [
                {
                  "text": "Ezr 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba eri ageia ’diyi yi evu Karisena, Setari pie, Adimata pie, Tarisisi pie, Meresi pie, Marisena pie, Memukani pie, ’ba ’diyi yi ambo aziri Perisiaa azini Mediaa ’diyi, yi’i opi ma mile ndrepi, ripi drile suru opini nyaleri ma alia ’diyi- ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri zi yi tia, Azita ’yo ama ma ’ye Vasiti oku opiniri vu ngoni ya, erini azita opi Ahasueruni azile ati’ba erini ’diyi ma tiari ’yele kurisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memukani nga di e’yo omvi opi ma drilia azini ’ba amboru ’diyi ma drilia indi, kini, Vasiti oku opini ’yeni onzi opi dri a’dule ku, te eri ’ye onzi ’ba ’wara ’diyi dri dria, azini ’ba dria ovupi angu opi Ahasueruni ma alia ’diyi dri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku e’yo Vasiti oku opinirini ’yele ’diri, eri nga ku wakaka oku dria ma eselia, yi nga ani agupi yini ’ba aparakaru yi ma milia, ’bani e’yoni oluria kini, Opi Aha­sueru azi ’ba ma eji oku ini Vasitini i ma drilia, te eri emuni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du andrurisi ’ba amboru Perisiaa azini Mediaa ’diyi yi ma okupi, e’yo ’diri oku opinirini ’yeleri eripi ’diyi, yi nga mvi mu olu ’ba amboru opini ’diyi ma tia trotro ’dinile. E’yo ’disi edematara amboru nga fu ’ba ma eselia aoko amboru be tu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi ka e’yo ’di ndre onyiru, ma fe azita opini ma fu eri vurisi ra, ma si ’ba Perisiaa ’diyi pi ma azita ma alia ’ba Mediaa ’diyi be, ’ba ma oja eri dika ku ani, kini, Vasiti ma emu dika opi Ahasueru ma drilia ku; te opi ma fe bandre erini opiniri oku azini eri agapi onyisi rari dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
