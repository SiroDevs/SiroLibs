                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.10"
              },
              "items": [
                {
                  "text": "2 Kor 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ka jo ini ’ba ndu ovuzu alatararu Yehova dri, kuhani ma li ajeni, kani eri onyiru kani onzi; ekile kuhanini ajeni lilerile, e’yoni ma so pa ’dini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba eri ’bapi ndu alatararuri ka le i ma jo nde onze, eri ma o’ba aje mini lileri ma esele alu drinia esele towi towi ’diyi vusi, eri nga ovu ani erini beni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
