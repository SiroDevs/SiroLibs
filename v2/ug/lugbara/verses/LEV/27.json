                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo anzi Israelini ’diyi ma tia, mi kini, ’Ba azini ka oyo erini soleri ma e’yo de ra, ’baniri nga ovu Yehovani ekile mini eri ma aje lilerile, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
