              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ka le afa kaza erini ma esele alu esele mudri mudri ’diyini ma azi onze, eri ma o’ba esele alu esele towi towi ’diyiniri drinia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
