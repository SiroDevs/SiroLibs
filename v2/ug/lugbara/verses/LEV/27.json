            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.12"
              },
              "items": [
                {
                  "text": "2 Kor 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te alio ka ’ba oga sekeli ani aje li drinia; kuhanini nga ajeni li ekile ’ba oyo sopirini ecole feleri vusi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
