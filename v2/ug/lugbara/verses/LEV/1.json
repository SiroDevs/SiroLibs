                  "text": "E’do 22:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuhani Aroni ma anzipi ma edu aci pari edeta edezuri ma dria, ma oti eja aci nderi ma dria; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
