              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni anzipi kuhaniru ’diyi ma oti za nde ma esele, drini pi osoni pie, eja ovupi aci pari edeta edezuri ma driari ma dria; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
