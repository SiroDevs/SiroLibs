        {
          "text": "Afa erini fele edeta vezaruri ka enga anyapa nyiri ma eselia, kani kabiloni kani ndrini, eri ma fe agoni rua be onyiru nyebile kokoruri’i; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
              "LEV.1.10"
            ]
