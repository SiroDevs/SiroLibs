                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kani ’ba ngukua ongurua beri, kani ’ba zopi ku atrupi atruri, kani ’ba mile be fularuri, kani ’ba ayiribeni nyaleri, kani ’ba bileofa be ruaari, kani ’ba otufinini drale rari; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
