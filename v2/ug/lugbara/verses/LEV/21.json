            }
          ]
        },
        {
          "text": "E’yo ’disi mi ma pe eri ndu alatararu ani, a’disiku eri enya fe Mungu minirinini; eri ma ovu alatararu mi dri; a’disiku ma Yehova mi ’bapi alatararuri, ma alatararu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "verse",
