                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te nyazaruni eri nga Mungu ini ma enya nya ra, ada afa alatatararu agapi rari pi alatararuri be iri tro, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
              "LEV.21.22"
            ]
