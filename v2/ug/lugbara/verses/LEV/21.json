                  "text": "Lev 22:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ’ba nyebileko be i ruaari aluni ma esi ogogo ku: ’ba mile kokoruri, kani ’ba acozaruri, kani ’ba omvu be akpafua­ri, kani ’ba afani efuzu eri ma ruaa ereniruri, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
