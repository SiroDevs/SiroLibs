          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri ejipi oko hema ti ecizaniri ma tilia eri edezu Yehova dri kuri; yi nga ’ba nderi dri ja o’dipi ma eseliasi ra.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
