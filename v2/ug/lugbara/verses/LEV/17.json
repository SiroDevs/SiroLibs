            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ngoni ngori suru Israelini ma eselia ka ri so, kani kabilo li, kani ndrini, pari ’bani hema asozuri ma alia, kani ka eri li pari ’bani hema asozuri ma tia amve, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
