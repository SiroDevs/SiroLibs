            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ’yo Aroni pi ma ria anzipi be, anzi Israelini ’diyi pie dria, mi ’yo yi tia kini; ’Diri e’yo Yehovani azileri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
