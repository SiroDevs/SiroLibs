              "type": "text"
            }
          ]
        },
        {
          "text": "Te mi ma ’yo yi tia kini, ’Ba dria alu alu suru Israelini ma eselia, kani ani’ba ovupi yi ma eselia ’diyi ma eselia, edeta vezaru vepi kani edeta edepi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
