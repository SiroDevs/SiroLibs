        {
          "text": "Te joloko acepi edeta edele anyafurasiriniri ma ovu Aroni pi dri anzipi be; eri ovu edeta vele acisi Yehova dri ’diyi ma eselia afa alatararu tu agapi rari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
