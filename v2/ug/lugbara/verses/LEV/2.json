              "items": [
                {
                  "text": "Efu 29:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ka edeta edele anyafurasi ozozaru furu ma aliari fe, eri ma ovu mikate akufi kokoru, edele anyafura inikinirisi, olizaru, osale odusi ’diyi, kani mikate akufi kokoru pekepeke odu trile drinia ci ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa edetaru mini feleri ka ovu edeta anyafurasi ozozaru saanisiri, eri ma ovu edezaru akufi kokoru anyafura inikini osale odusirisi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ma ondi eri eselesi eselesi, odu osuzu drinia; eri ovu edeta edele anya-furasiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa edetaru mini feleri ka ovu edeta anyafurasi osizaru ajikoasiri, eri ma ovu edezaru anyafura inikini odu berisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma eji edeta anyafurasi edele afa nde ’diyisiri Yehova vu; ma fe eri kuhani dri, kuhanini nga eri ji pari edeta edezuriani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
