        },
        {
          "text": "’Dini yi esi ogogo, nga yi ji koti yini be yi ma ruaa ’dani, pari ’bani hema asozuri ma tia amve, ekile Musani ’yolerile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.5",
            "verseOrgIds": [
              "LEV.10.5"
            ]
          }
