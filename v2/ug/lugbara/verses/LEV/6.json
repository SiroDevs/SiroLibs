        },
        {
          "text": "Yehova nga di ’yo Musa tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
