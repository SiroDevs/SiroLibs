              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre ra, te mi ne, akanya emveru, azini ’ba ripi eri ma ngukuari ovu osu be; yi fe ekilaza driari eri dri, eri fu ani agazu omba ma alia, azini eri ma nga aga ani beni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
