            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.2"
              },
              "items": [
                {
                  "text": "6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akanya azini efu ra, eri akanya ekaru; yi fe ’ba ripi eri ma ngukuari dri eri ma nze asi anzuru nyakuarisi ra, ’ba ma ofu yi ceni ceni beni; yi fe sei amboru eri dri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
