              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ka eceta iriri zi ra, ma eri ra anyapa idriru iririni ’yoria kini, Mi emu! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
