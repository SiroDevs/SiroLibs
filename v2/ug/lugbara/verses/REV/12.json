            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.15"
              },
              "items": [
                {
                  "text": "Eceza 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri osi agiamva, ngapi suru dria ma dri cepi kali ayarusiri; yi ari mva erini eri ’duzu Mungu vu oguna erinia, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
