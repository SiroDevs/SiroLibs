                "loc": "MAT.2.13"
              },
              "items": [
                {
                  "text": "Mat 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.2"
              },
              "items": [
                {
                  "text": "Eceza 11:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te oku nde apa roko dria, pari Munguni edele eri driria, ma fe nyaka eri dri ’dale o’du alifu alu drini turu iri drini kali azia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
      ]
