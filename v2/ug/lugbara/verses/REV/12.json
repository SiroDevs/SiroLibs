              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ’be uri amboru nderi va, eri uri oku drio, omvele ’Ba asu Supiri’i, azini Satani’iri, eri ’ba wudrikuru dria icipiri-yi ’be eri va nyakua, o’be vini malaika erini ’diyi va eri be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 12:10"
          },
          "items": [
