              "items": [
                {
                  "text": "Yud 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Omba nga di ovu ’bua: Mikaeli mu malaika erini be omba ’bazu uri nde be; te uri pi malaika erini be ’ba omba ra, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "te yi agani ku, isuni pari yini ’bua dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
