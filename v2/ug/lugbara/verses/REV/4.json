        },
        {
          "text": "Oguna ma alia azini ogona ma ageia, anyapa idriru su ’diyi indi, yi ma ruaa mile ga tre tre agatialeru razini ngukualeru: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
