              },
              "items": [
                {
                  "text": "Eze 1:26-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ripiri ma wura e’da ekile oni yasiperile, azini sadiusile; gari e’dapi ekile oni emerodeleri ace oguna nde agei kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
