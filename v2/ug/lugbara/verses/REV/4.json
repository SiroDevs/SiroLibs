                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Coti ma ovu Orindi alia, te mi ne, isu de ’ba ndra oguna ’bua ’bo, azini ’baniri ri oguqa dria! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
