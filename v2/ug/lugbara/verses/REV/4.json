              },
              "items": [
                {
                  "text": "10:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "anyapa okori ovo kamile, anyapa iriri ovu koja­ mvale, anyapa nari ma andreti ovu ’banirile, anyapa suri ovu aji sapi sarile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
