                  "text": "Eceza 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kiri e’yo ovupi emi be indiri, emi bi ci cazu etu mani emuzuria. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
