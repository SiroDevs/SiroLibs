              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini emi indi emi ovu ’ba azini imbata ’ba Niko­laitini ’diyini a’ipi ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
