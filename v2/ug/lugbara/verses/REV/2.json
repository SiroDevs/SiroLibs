          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ’yo emi ’ba acepi Tuatiraa, imbata ’diri a’ipi ku, e’yo Satanini ’bani adrile omvele e’yo aliru va ’diyi nipi ku ’diyi ma tia: ma o’bani afa nziza azini emi dria ku; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
