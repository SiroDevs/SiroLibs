              "items": [
                {
                  "text": "Zab 2:8-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba agapi azini ’yeta mani ta mbapi cazu etu asizuriari dri, ma nga okpo fe suru ’diyi dri cezu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
