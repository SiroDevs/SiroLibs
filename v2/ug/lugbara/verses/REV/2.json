              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi oja mi asi ani. Ka’dini ku ma emu mi vu mbele, ma nga a’di ’di yi be sei ma tiliarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
