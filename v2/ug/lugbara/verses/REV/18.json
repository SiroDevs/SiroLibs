              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.13"
              },
              "items": [
                {
                  "text": "Eze 27:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "madalasini pie, afa aji be arikariruri pie, obiese vele veri pie, odu rua efizuri pie, odu arikariruri pie, patiefi ma su pie, mizeitu odu pie, anyafura inikiniruri pie, nganu pie, ti pie, kabilo pie, akanya pie, gari aka­nyani pie, ’ba rua pie, orindi ’bani pie.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
