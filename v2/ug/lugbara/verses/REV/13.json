        },
        {
          "text": "Ma ndre nguruni efuria miri alia, eri o’yu be mudri, dri erini ’diyi aziri, o’yu erini ’diyi ma dria oku opini mudri indi, dri erini ’diyi ma dria ru Mungu o’daro ’diyi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
