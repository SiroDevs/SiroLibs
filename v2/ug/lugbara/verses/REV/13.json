        },
        {
          "text": "Fe eri dri ti e’yo amboru ’diyi pi ’yozo, o’data Mungu o’dazuri be; yi fe okpo eri dri e’yo ’yezu mba kali su drini iri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri zi i ma tile Mungu o’dazu, ru erini pi o’daro pari erini adrizuri pie, ’ba ovupi ’bua ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
