                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre nguru azinini efuria nyakuarisi; eri ovu o’yu be iri ekile kabilomvale, eri ’yo e’yo ekile urile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye e’yo okpo dria nguru okorinirisi eri ma milia. Eri fe nyaku ’ba ovupi alenia ’diyi be ma inzi nguru okori, eri’i bele erini ndra ’yewi drazurini atizu rari. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
        {
