                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’ye eceta amboru ndu ndu, ecazu kpere erini aci feria esizu ’buarisi va nyakua ’ba ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
