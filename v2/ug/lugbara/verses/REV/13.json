          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Eceza 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Fe eri dri omba ’bazu ’ba alatararu be, yi agazu, Fe vini okpo opiniri eri dri enyati pi ma dria, ’ba pie, ti ’yoza pie, suru pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
