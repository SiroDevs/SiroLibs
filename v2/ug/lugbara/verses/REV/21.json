                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba e’yo nzepi ma beri ovu ozu i afa o’bizu edele melesiri be aku pi o’bizu, kalitileni ’diyi pie, abini pie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
