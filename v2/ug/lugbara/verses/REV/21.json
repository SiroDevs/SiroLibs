                  "text": "Isa 54:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Si abi rua asi­pesi, te aku nde ovu mele alaru ekile oni talatala alarurile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
