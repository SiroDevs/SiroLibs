          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "towiri eri sara donukisini, aziari eri sadiusini, aziriri eri kurusolitoni, arori beruleni, oromiri eri topazeni, mudriri eri kurusoparasoni, mudri drini aluri eri huakintoni, mudri drini iriri eri ametusitoni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalitile mudri dri­ni iri yi nyoro ndrizaru aje nyapi tu mudri drini iri ’diyi, kalitile alu alu vusi nyoro alu alu, geri amboru aku eselesiri eri mele alaru, ekile oni talatala dizarurile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
