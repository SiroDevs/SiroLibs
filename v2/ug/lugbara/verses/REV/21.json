                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede abi kaliru aku ageiari ma ndu ndrizaru oni ndu ndu dria aje nyapi tu ’diyisi; abi ndu okori jasipeni, iriri eri safirani, nari eri kalakedoni, suri eri emerodeni, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
