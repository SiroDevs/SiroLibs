                  "text": "Mat 24:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre malaika aziri pa sopi Mungu ma drilia ’eliyi, yi fe yi dri guka aziri. ",
          "type": "text",
