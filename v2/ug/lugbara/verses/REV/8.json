          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "afa Munguni ’bale ovupi miri ma alia idri be ’diyi ma esele na ma azi aluri odra ra, oguru ma esele na ma azi alu ja dri indi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
