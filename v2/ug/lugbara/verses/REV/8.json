                  "text": "Zab 141:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acika obieseniri nga di efu malaika ma driasi tuzu uru ziza ’ba alatararu ’diyini be Mungu ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
