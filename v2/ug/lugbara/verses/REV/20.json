                {
                  "text": "1 Tes 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba draza azini acepi ’diyi engani idriru ku de nga eli alifu alu ’diyi deni yi ku. ’Di engata okori’i. ",
          "type": "text",
          "attrs": {
