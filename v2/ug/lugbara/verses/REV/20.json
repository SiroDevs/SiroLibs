          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.9"
              },
              "items": [
                {
                  "text": "2 Tes 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ’bezu ’bile asikokoruri ma alia, nga tini eci ci, nga oderi ’ba drinia ecetaru, eri kazu suru icizu dika ku de nga eli alifu alu ’diyi deni yi ku, te ’di ma vutia eri ma ovu truzaru ewu weresi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
