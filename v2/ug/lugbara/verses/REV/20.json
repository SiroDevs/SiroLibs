                }
              ]
            }
          ]
        },
        {
          "text": "Eri bi uri nderi, uri oku drio ovupi ’Ba asu Supiri azini Satani’iri, nga eri ombe eli alifu alu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
