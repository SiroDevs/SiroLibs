                "loc": "JUD.1.5"
              },
              "items": [
                {
                  "text": "Yud 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa’dini, ma nga ovu ci ngo­nde ’dani fezu emini e’yo ’diyi egazu, emi ka tro yi ni ra, ka tro ovu okporu e’yo adaru ovupi emi beri ma alia ti. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.1"
              },
              "items": [
                {
                  "text": "2 Kor 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma kini eri ’yeke, mani nga ovuria rua borokoru ’dori ma alia, ma ma fe emi ma enga e’yoni egazu dika, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.18"
              },
              "items": [
                {
                  "text": "Yoh 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mani nile ma ’ye rua mani borokoru ’dori anzu anzurisi, ekile Opi amani Yesu Kristoni ecele ma dri ’borile. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga ma asi ’ba fezu emini e’yo ’diyi egazu ewu vusi dria, mani drazu ’bori ma vutia.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama bini o’duko olule ondua ’banisi ’diyi ma vuti ku, amani okpo Opi amani Yesu Kristoni pi ma e’yo eceria emi dri emviza erini be, te ama ngulupi ndre ambo erini inzitaruri ama milesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.1+MAT.17.2+MAT.17.3+MAT.17.4+MAT.17.5"
              },
              "items": [
                {
                  "text": "Mat 17:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.2+MRK.9.3+MRK.9.4+MRK.9.5+MRK.9.6+MRK.9.7"
              },
              "items": [
                {
                  "text": "Mar 9:2-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.28+LUK.9.29+LUK.9.30+LUK.9.31+LUK.9.32+LUK.9.33+LUK.9.34+LUK.9.35"
              },
              "items": [
                {
                  "text": "Luk 9:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri isu inzita pi diza be engazu Mungu Ata vu, o’duko ibipi engapi diza inzitaru tori ma aliari ka eca eri vu, kini, ’Di Mvi mani lele tu ayiko Ifepi ma dri turi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama eri o’duko ibipi engapi ’bua ’diri ama’i, amani ovuria eri be oni alatararu ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
