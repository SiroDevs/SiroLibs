            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta anzutiri pi ma ere yi drile drile emi vu asi anzuru be, Mungu pi nizu Yesu Opi amaniri be.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
