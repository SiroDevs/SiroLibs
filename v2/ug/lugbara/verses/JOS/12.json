              "items": [
                {
                  "text": "Azi 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.20"
              },
              "items": [
                {
                  "text": "Yos 13:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nya vini Araba cazu miri Cinerotia azini kala etuni efurialeru, azini cazu kpere miri Arabaaria (’di Miri A’iruri’i) kala etuni efurialeru, geri muzu Beti-yesimotiaria, dika engazu angu uruleruria nya angu eluza Pisiganiri indi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
