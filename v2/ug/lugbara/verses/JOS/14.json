                  "text": "Eceza 14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ti ma adripi amani muzu yi be ’diyi fe ’ba ’diyi ma asi ca ra; te ma ’ba ma asi dria ’dani Yehova Mungu mani ma vuti bizu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
