              "items": [
                {
                  "text": "Mat 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yosua nga oku awuouru Rahabu pi opa idriru, ’ba eri ati vile akua ’diyi pie, ’ba erini pie dria; te eri nga ovu ’ba Israelini ma eselia ’dani kpere ecazu ani o’du andru ’diri ma alia, erini ’ba Yosuani ti pele Yeriko ma orile gazu ’diyi ozilerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        },
