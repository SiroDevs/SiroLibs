                "loc": "NUM.10.25"
              },
              "items": [
                {
                  "text": "Kal 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.12"
              },
              "items": [
                {
                  "text": "Isa 42:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ’ba afa ombani ’dupi ’diyi mu ’ba edeta edepi guka vupi ’diyi ma drilia, te ’ba vutialeru ’diyi mu di sanduku ma vutisi, te ’ba edeta edepi ’diyi ri mu guka vusi ’dani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosua azi ’ba nde ma tia kini, Emi ma o’be cere ku, ma ’yo o’dukosi ku, e’yo aluni ma efu emi tilia ku indi, kpere o’du mani ’yozu emi ma o’be cereria, emi di nga cere o’be ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini yi aci sanduku Ye­hovani ’diri be aku ’diri ma agei ecizu pale alu ra; yi mvi pari yini hema asozuria, yi la pari ndea ’daa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
