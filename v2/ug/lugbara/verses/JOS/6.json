            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Yosua ka e’yo ’yo ’ba nde ma tia ’bo, ’ba edeta edepi aziri guka kabilo o’yuru, o’dupi Yehova ma milia ’diyi nga aga drile, yi nga guka vu ra, sanduku aziza Yehovanirini mu di yi ma vutisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
