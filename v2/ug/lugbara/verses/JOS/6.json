              "type": "text"
            }
          ]
        },
        {
          "text": "Yosua nga enga ’darisi o’bitisi drio drio, ’ba edeta edepi ’diyi nga sanduku Yehovani ’du uru indio ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
