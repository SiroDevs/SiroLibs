              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te dahabu dria, mele pie, afazu molaru pie, afazu ayaru ’diyi pie, yi ovu alaru Yehova dri; yi nga fi pari lonyi Yehovani ma ta mbazuria. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        },
