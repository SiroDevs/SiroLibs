                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova ’yo Yosua ma tia, Mi ndre, ma fe Yeri­koni mi dria ’bo, opi amboru aleniari pi, ’ba amboru asi agupirusi ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi nga aku nderi ma agei eci kuru, emi ’ba dria ombani ’diyi, acizu aku nderi ma ageiasi kuru pale alu. Emi nga ’ye ’dini ’dini o’du paleko azia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.16"
              },
              "items": [
                {
                  "text": "Lip 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.8"
              },
              "items": [
                {
                  "text": "Kal 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba edeta edepi aziri ’diyi yi nga kabilo o’yu edele gukaru aziri ’diyi o’du sanduku ma drilia; o’du aziririsi emi nga aku nderi ma agei eci paleko aziri, ’ba edeta edepi ’diyi nga di guka vu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga ovu ’dini, yi ka guka kabilo o’yuru ’diyi vu okposi biribiri ’bo, emi ka guka o’duko eri ra, ’ba dria yi nga cere o’be o’duko urusi; te abi aku nderini nga e’de wayi va ani, ’ba dria alu aluni nga tu i ma drilia kilili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Yosua Nuni mvi nga ba edeta,edepi ’diyi omve, ’yo yi ma tia kini, Emi ’du sanduku aziza ndeni ’diri, ’ba edeta edepi ’diyi ma o’du guka kabilo o’yuru aziri ’diyi sandu­ku Yehovani ma driliani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo vini ’ba ongulumuru ma tia kini, Emi aga drile, emi mu aku nde ma agei ecizu, emi ku ’ba afa ombani ’dupi ’diyi ma aga sanduku Yehovani ma driliani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        }
      ]
    },
