        },
        {
          "text": "Yosua ’yo ’ba Rubenini piyi ma tia, ’ba Gadini pie, suru Mana­seni ma egalapi pie, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.12",
