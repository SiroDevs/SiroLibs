                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pari dria emini ngale pa agele ’bazu driniari ma fe emi dri ’bo, ekile mani ndra ’yole Musa ma tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.3",
