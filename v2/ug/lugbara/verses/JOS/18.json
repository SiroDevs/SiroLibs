                }
              ]
            }
          ]
        },
        {
          "text": "idri i ti cozu andraleru fuzu Eni-semesia, efuzu cazu vini kpere Geliloti i otipi angu tuza Adumimuni beria; vilerisi si kata Bohani Rubeni mviniria; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.17",
            "verseOrgIds": [
              "JOS.18.17"
            ]
          }
        },
        {
