              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "engazu ’darisi idri i agazu kala andraleru Araba vuleruriasi, vilerisi elu vini i Arabaa ’dia; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
              "JOS.18.18"
            ]
          }
        },
        {
