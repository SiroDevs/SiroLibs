        },
        {
          "text": "’Ba ongulumuru dria Israeli anzipiruri nga yi oku tualu Siloa, yi nga hema ti ecizaniri aso ’daa; te angu nderi ovu ndezaru yi ma drilia ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Israeli anzipi vile suru ace aziri, angu esele yini isupi nga ku ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
