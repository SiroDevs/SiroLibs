            }
          ]
        },
        {
          "text": "O’du ’dasi Yehova fe Yosuani ovuzu amboru anzi Israelini ma milia dria; yi ru eri ra, ekile yini ndra Musani rulerile, ewu erini ovuzu idrirurisi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        },
