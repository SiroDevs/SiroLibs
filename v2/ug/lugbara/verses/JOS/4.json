          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba ekile alifu kali sule yi otupi ngonde a’di ’dizu ’diyi zo Yehova ma milia muzu ombaa, angu senderu Yerikoniria. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
