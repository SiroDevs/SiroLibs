                {
                  "text": "Kal 32:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini anzi Rubenini piyi, anzi Gadini pie, suru Manaseni ma ega­lapi pie, yi zo ’aa’dasi afa ombani yini be anzi Israelini ma drilia, ekile ndra Musani ’yole yi ma tiarile; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
