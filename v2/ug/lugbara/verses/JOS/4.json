          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri eca ’dini, ’ba dria ka zo ’aa’dasi de ’bo, sanduku Yehovani nga di zo, ’ba edeta edepi ’diyi pie, ’ba nde ’diyi ma milia ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
