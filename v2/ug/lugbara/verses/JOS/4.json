        {
          "text": "Mi ’du ’ba mudri drini iri engazu ’ba nde ’diyi ma eselia, suruti alu alu ma ’alia ’ba alu alu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
