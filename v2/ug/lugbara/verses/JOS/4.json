          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "-emi nga di fe anzi emini ma ni kini, Israeli zo Yoridani ’diri angu a’wiru ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
