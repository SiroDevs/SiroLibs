              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini Yosua nga di azi ’ba edeta edepi ’diyi ma tia kini, Emi etu di Yoridaniarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di eca ’dini, ’ba edeta edepi te sanduku aziza Yehovanirini ’dupi ’diyi ka etu Yoridani ma agaduarisi ’boria, ’ba edeta edepi ’diyi ka mu yi ma pa agele o’du o’ba angu a’wiru ma dria ’bo, yi Yoridanini nga emvi i ma paria, yini nga ti kpere aparaca tia amve ekile okorile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
