                "loc": "1SA.7.12"
              },
              "items": [
                {
                  "text": "1 Sam 7:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yosua odro oni mudri drini iri Yoridania agadua, pari teka ’ba edeta edepi sanduku azizani ’dupi ’diyini pa sozuria; yi ovu ’dale indi kpere o’du andru ’dorisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’di­siku ’ba edeta edepi sanduku ’dupi ’diyi oso pa Yoridania agadua, de nga e’yo dria Yehovani azile Yosua ma tia ’yozu ’ba nde dri ’diyini yi deria, tro tro ekile e’yo dria Musani azile Yosua ma tiarile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        }
      ]
