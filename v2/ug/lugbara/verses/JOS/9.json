        {
          "text": "’Ba Israelini omvi e’yo ’ba Hivini ’diyi ma tia kini, Kani emi adri ovu ama eselia ’doa yani ’dele ’di; ka’dinile ama nga eco aziza azi emi be ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
