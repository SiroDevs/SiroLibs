          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "paa yi nga enyiriko deza osu’i ecizaru indi, ruaa yi bongo iriko ’diyi osu’i; enya yini muzu yi be aciari ’wi dria a’buzaru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
