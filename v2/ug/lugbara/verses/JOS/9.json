            }
          ]
        },
        {
          "text": "Yi ’yo Yosua tia, Ama’i ama ati’ba mini. Yosua nga yi zi, Emi a’dikoni ya? Emi enga ngoa ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
