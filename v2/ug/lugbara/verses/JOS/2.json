        },
        {
          "text": "Te mi ka ayua amani ’di ma e’yo ece ra, e’yo ngani ama nde oyo mini fele ama ma sori ma e’yosi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
