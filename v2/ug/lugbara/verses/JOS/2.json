        },
        {
          "text": "Te ’ba olu e’yoni opi amboru Yeri­koari dri kini, Mi lu, ’ba azini yi emu te ’dia inisi engazu anzi sraelini ma eselia, angu ma orile gazu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka­’dini opi amboru Yerikoari pe ’ba ti Rahabu vu kini, Mi ofu ’ba emupi mi vu fipi mi vile joa ’diyi; yini ecale angu ’dori dria ma orile gazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
