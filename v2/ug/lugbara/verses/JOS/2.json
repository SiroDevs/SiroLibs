        },
        {
          "text": "Te oku nde ji ’ba iri ’diyi, ozi yi ra; eri ’yo ra, E, ’ba nde ’diyi emu ma vu ’do ra ’bo, te ma nini te yi enga ngoari ku; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga eca etu ’bani kalitile opizurisi ’dini, angu ka bi ’bo, ’ba nde yi fu ra; ’ba nde ’diyi mu ngoari, ma nini ku; emi dro yi ma vuti mbele mbele, a’disiku emi nga ca yi isu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
