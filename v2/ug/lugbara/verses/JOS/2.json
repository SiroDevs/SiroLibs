                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te de isu oku nde ji te yi jo dria uru, ozi yi ’bo baka palale erini ajale jo driari ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ’ba nde ’diyi dro yi geri muzu Yoridaniarisi kpere kiji yi zozuria; ’ba yi dropi ’diyi ka fu ’bo, coti yi opi kalitile ci.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
