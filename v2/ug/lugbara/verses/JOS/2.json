          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo yi ma tia, Emi apa oni dria, ’ba emi vuti dropi ’diyi kazu muzu emi isuzu ku; emi ma zi emi ’daa o’du na kpere ’ba emi vuti dropi ’diyini emvizu ’boria; vutinia emi di nga mu geri eminia ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
