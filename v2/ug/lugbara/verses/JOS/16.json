              "items": [
                {
                  "text": "Yos 17:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "esele nde ma lokiri fu etuni ’ deria­leru kpere Mikimetatia angu andraleruria; ago i vini eca etuni efurialeru kpere Taanati-siloa, aga tiniarisi geri Yanoa ma kala etuni efurialeruria; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
