              },
              "items": [
                {
                  "text": "1 Sur 7:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "engazu Yanoasi si va cazu Atarotia, azini Naaraa, cazu kpere Yerikoa, nga fu mu asi Yoridania. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
