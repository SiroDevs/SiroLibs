                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Efiraimuni ma angu ma esele enyati yini vusiri ovu ’dinile: angu yini awurusoruri ma kalati etuni efurialeruri ovu Ataroti-ada­,ri’i, kpere Beti-horoni uruleruri vu ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
