        },
        {
          "text": "Te anzi Yusufuni, Manase pi Efiraimu be, bi di yi ma awuruso ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
