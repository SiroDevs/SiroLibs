              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te mi ma azi ’ba edeta edepi sanduku azizani ’dupi ’diyi ma tia kini, Emi ka nga eca yi Yorida­nini ma kutia ’bo, eri i nga pa oso ci Yoridani ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        },
        {
