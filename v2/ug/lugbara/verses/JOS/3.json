              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosua nga ’yo anzi Israelini ma tia, Emi emu ’doa, emi ma eri e’yo Yehova Mungu eminirini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
