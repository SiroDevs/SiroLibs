                "loc": "1TH.2.5"
              },
              "items": [
                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mungu ovu ’ba e’yo mani ma eti nipiri, eri ni kini ava emini dria va ma tu leta i avasi Kristo Yesuniri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma zi Mungu ’dini, kini, leta avasi eminiri ma zo nga drile dika dika nita pi ma alia ondua e’yo eti vazuri be dria, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
