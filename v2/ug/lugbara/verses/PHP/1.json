          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaru ’ba azini yi e’yo Kristoni olu ma’yalasi azini abalasi, te ’ba azini ’diyi olu asi onyirusi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba nde ’diyi yi e’yo olu leta avasirisi yini nile Mungu ’ba ma ’doa e’yo bari ma eti nzezurisi; ",
          "type": "text",
          "attrs": {
