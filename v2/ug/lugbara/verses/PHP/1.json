        },
        {
          "text": "Te ma le emi ma ni, ma adripi, e’yo ndra yi ’yepi ma ruaa ’diyi efu tuni e’yo barini kuzu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
