          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ovu fezaru emi dri Kristosi, kiri eri a’izu a’dule ku, te candi nyazu eri ma e’yosi indi, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
