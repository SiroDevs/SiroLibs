            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.6+1CO.1.7+1CO.1.8"
              },
              "items": [
                {
                  "text": "1 Kor 1:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma a’i e’yo ’diri ma asia ada kini, Mungu azi onyiru e’dopi emi aliari nga fe azi ndeni i dezu dri fuzu kilili cazu kpere o’du Yesu Kristoniria. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mani emi dria ma e’yo egazu ’dinileri eri ’yeke, a’disiku e’yo eminirini ovule ma asiarisi, azini mani de ovuria ombe­zaru kani mani de agata garia e’yo bari ma e’yosi azini e’yo oluria okposi, emi dria ovu ti ecizu ma be ’yeta anzutirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
