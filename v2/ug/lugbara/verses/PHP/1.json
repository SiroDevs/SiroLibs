                  "text": "Efe 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te geri ’disi asikari dria aku opini ma agei tepi ’diyi, ’ba azini pie dria, yi ni ra ma ovu ombezaru Kristo ma e’yosi; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
