              "items": [
                {
                  "text": "Gal 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mani ovuzu idriruri eri Kristo’i, te drazu rari eri orodriru. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
