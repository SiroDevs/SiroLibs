                  "text": "1 Pet 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ma ovu asi tezasi azini ma ega asi driasi ma ngani ovu drinzasi e’yo alunisi ku, te curu’do ekile driorile, mani e’yo olule uri kokorurisi, Kristo ma ovu inzizaru rua maniri ma alia, kani idrisi, kani dratasi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
