              "items": [
                {
                  "text": "2 Kor 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Asi mani le e’yo ’diyi iri tro. Ma le dri kozu muzu ovuzu Kristo be ra ’bo, ’di onyiru aga dria. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te agapi rari le ma ma ovu rua ma alia ’dani e’yo eminisi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te mani e’yo a’iria ma asia ’dinile ma ni ra ma nga ovu ’dani, ma nga ovu emi be dria emini zozu ani drile a’ita ma alia ayikosi, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ma enya emi tu aga ra Kristo Yesu ma alia e’yo manisi beni, mani ecale emi eselia dikarisi., ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        },
