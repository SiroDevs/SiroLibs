                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ni ra e’yo ’diri nga ofu ma dri pataru, zita eminisi azini Orindi Yesu Kristoni ovupi fezaru ma dririsi; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
