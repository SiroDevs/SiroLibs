              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini adripi Opi ma alia ’diyi ma esele tu tuni isu a’ita o’diru anziriku mani ma e’yosi, ovuzu ani asi tezasi e’yo Munguni oluzu uri kokoru aga ra.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
