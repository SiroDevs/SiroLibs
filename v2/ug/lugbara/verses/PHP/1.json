              "items": [
                {
                  "text": "Rum 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka ovu mani ngazu ovuzu idriru ruasiri’i, ’diri nga ovu ma dri efi ’yaza azi mani ’yelerini. Ka’dini ma nini ku ma nga ngonileri pe ya. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
