              },
              "items": [
                {
                  "text": "Efe 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi dria anzi dizani, emi anzi etuni; ama ovuni ini pini angu biza be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ama ma ko o’du ekile ’ba azi ’diyile ku, te ama ma te mile be azini asisile be. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku ’ba o’du kopi ’diyi yi o’du ko inisi, azini ’ba trapi ewasi ’diyi yi tra inisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
