        {
          "text": "’Bani de ’yoria, E’yo ’ya pi asi anzuru be, coti dri jazani nga emu yi ma dria rugbu, ekile mva azoni okporovu e’dulerile, te yi ngani yi pa aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
