            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.13+MAT.19.14+MAT.19.15"
              },
              "items": [
                {
                  "text": "Mat 19:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.13+MRK.10.14+MRK.10.15+MRK.10.16"
              },
              "items": [
                {
                  "text": "Mar 10:13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi eji vini anzi odekuaru yini eri vu, eri ma elo yi rua ani; te ’ba erini imbale ’diyi ka ndre ra, yi nga ega yi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yesu nga yi omve i vu, kini, Emi ku anzi nyiri nyiri ma emu ma vu, emi ma oga yi ku; te suru Munguni ovu ’ba ’dinile ’diyini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.3"
              },
              "items": [
                {
                  "text": "Mat 18:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia ndi ndi, ’ba azini ka ngoni ti, ka suru Munguni a’i mva gakandiarule ku, eri ngani fi alenia aluni ku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
