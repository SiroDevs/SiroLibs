        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.22"
              },
              "items": [
                {
                  "text": "Luk 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri oku ’ba mudri drini iri ’diyi i vu, nga ’yo yi tia, Mi ndre, ama tu uru Yerusalemua, azini e’yo dria nabini sile Mvi ’bani ma e’yosi ’diyi nga yi ’ye ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga ovu fezaru ’ba jururu dri, yi nga eri ede ogutasi, yi nga drinza fe eri dri, yi nga cucu wu eri ruaa; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi nga eri co ninisi, yi nga eri fu kai ra, te o’du nasi eri nga enga dika. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.32"
              },
              "items": [
                {
                  "text": "Mar 9:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi vani e’yo ’diyi ma azi aluni ku; e’yo ’yoza ’diri ovu zizaru yi dri, yi nini e’yo erini ’yole ’diyi ku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
