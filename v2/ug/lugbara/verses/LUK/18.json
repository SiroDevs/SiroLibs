              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.17+MRK.10.18+MRK.10.19+MRK.10.20+MRK.10.21+MRK.10.22+MRK.10.23+MRK.10.24+MRK.10.25+MRK.10.26+MRK.10.27+MRK.10.28+MRK.10.29+MRK.10.30"
              },
              "items": [
                {
                  "text": "Mar 10:17-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ambo alu zi eri tia ’dini kini, ’Ba ’ba Imbapi bari, ma nga ’ye ngoni mani idri ’dani ’dani isuzu ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.18",
            "verseOrgIds": [
              "LUK.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nga ’yo eri tia, Mi omve ma ’ba baru a’disi ya? ’Ba ba­runi yo, kiri alu Mungu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.12+EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16"
              },
              "items": [
                {
                  "text": "Efu 20:12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16+DEU.5.17+DEU.5.18+DEU.5.19+DEU.5.20"
              },
              "items": [
                {
                  "text": "Azi 5:16-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ni azita ra: Mi ’ba ali ku, Mi ’di ’ba ku, Mi ogu ku, Mi nze e’yo eti inzoru ku, Mi inzi mi ati pi mi andri be. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.20",
            "verseOrgIds": [
              "LUK.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo ra, Ma mba e’yo ’diyi ma ta dria gbu mvaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.21",
            "verseOrgIds": [
              "LUK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.20"
              },
              "items": [
                {
                  "text": "Mat 6:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu ka eri ra, eri ’yo eri tia, Afa azini alu ece nga mi dri ’yekokoru. Mi fe afa dria mini ovuzu yi be ’diyi ozi ra, mi awa ’ba alioru ’diyi dri, mi nga ani lonyi isu ’bua; mi emu di ma vuti bi ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.22",
            "verseOrgIds": [
              "LUK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ka e’yo ’diri eri ra, eri ’ba ovu candisi tu, erini ovule ’ba afa e’iru turisi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuni eri ndreria ’yo ra, ’Ba afa e’iru ’diyini fizu suru Munguni­ria ewani ’doni! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamiani fizu sindani ma talaasiri bani ewa ko­koruni aga ’ba afa e’iruni fizu suru Munguniari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
            "verseOrgIds": [
              "LUK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba eripi ’diyi ’yo ra, Ka’dini a’di eco i pazaruni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ’yo, E’yo ecopi ’basi ku ’diyi eco Mungusi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ’yo ra, Mi lu, ama ku afa ama vile ’diyi ra, mi vuti bizu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo yi tia, Ma ’yo emi tia ndi ndi, ’ba jo pi kupi suru Munguniri ma e’yosi, oku pie, adripi pie, ’ba yi tipi ’diyi pie, anzi pie dria ’diyi ma aluni ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngani ece afa isuzu parinia pale karakarau ewu ’dorisi ku, eri nga vini ovu idri ’dani ’daniri be ewu ngapi emupirisi indi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        }
      ]
