            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.11"
              },
              "items": [
                {
                  "text": "Mar 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Orindi onzi fu ’ba kakau ma ruaa, yini oyuria uru ’yoria kini, Mi Mvi Munguni! Te eri ega yi dria, eri a’ini yi dri e’yo ’yozu ku, yini nile kini eri ovu Kristo’irisi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
