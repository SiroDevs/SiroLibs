                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga emvi Galilia okpo Orindinisi; e’yo erini nga ku angu ageiniaria dria wakaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri imba ’ba pari yini yi okuzuria, eri ovu inzizaru ’ba driasi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
