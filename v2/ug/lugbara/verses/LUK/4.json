                "loc": "MRK.1.29+MRK.1.30+MRK.1.31+MRK.1.32+MRK.1.33+MRK.1.34+MRK.1.35+MRK.1.36+MRK.1.37+MRK.1.38+MRK.1.39"
              },
              "items": [
                {
                  "text": "Mar 1:29-39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga enga uru, fu pari ’bani yi okuzuriasi, nga fi Simoni vile joa. Isu rua driza amboru bi Simoni ma idrinini, yi nga eri zi eri ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri so pa drilenia, nga ega rua driza nde ma dria; azo nga eri ku ani ra; coti eri nga enga uru azi ’yezu yi dri,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
