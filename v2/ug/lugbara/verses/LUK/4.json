              },
              "items": [
                {
                  "text": "2 Opi 5:1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ewu nabi Elisani ovozurisi, ’ba ofu be yi kakau Israeli ma eselia; te yi ma azi aluni atini ku, alu Naamani Surioururi ati uri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        },
        {
