                "loc": "LUK.8.1"
              },
              "items": [
                {
                  "text": "Luk 8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te eri ’yo yi tia, Ma ma olu e’yo baru suru Mungunirini aku azini ma tia indi; a’disiku epe ma ti e’yo ’disi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        },
