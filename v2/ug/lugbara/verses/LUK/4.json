                }
              ]
            }
          ]
        },
        {
          "text": "Eri si va Kaperinaumu aku Galilinia. Eri ovu yi imbaria saba tosi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.31",
            "verseOrgIds": [
