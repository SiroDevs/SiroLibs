          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etuni caria ’bile tia ogogo, ’ba dria ovupi ’ba yini azoru azo ndu ndusi ’diyi be ’diyi nga yi eji eri vu; eri nga dri ti yi dria alu alu, eri ati yi rua dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
