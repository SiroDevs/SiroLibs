                  "text": "58:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi fe eri dri buku nabi Isayani.Eri ka buku zi ’bo, eri isu pari yini sile ’diniri,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
