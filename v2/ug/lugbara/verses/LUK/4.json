                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.17"
              },
              "items": [
                {
                  "text": "Yak 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ’yo emi tia ada, Ndra ewu Eliyani ovuzurisi, ewu ’buni ovuzu ecizaru eli na drinia mba azia, tiki amboruni ovuzu oro drisi driarisi, awuzi yi karakarau ’ba Israelini ma eselia; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
