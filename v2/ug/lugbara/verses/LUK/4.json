          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu ka ati ra, eri fu amve mu roko dria. ’Ba ongulumuru nga eri nda, nga emu eri vu, yi le eri oga si, eri kazu yi kuzu ku; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
