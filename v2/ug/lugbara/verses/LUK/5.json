              "items": [
                {
                  "text": "Luk 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Levi a’di eri dri omu amboru jo ini ma alia; ’ba ongulumuru kakau musoro okupi ’diyi ’ba azini be indi, yi ori nyaka tia yi be. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.1+LUK.15.2"
              },
              "items": [
                {
                  "text": "Luk 15:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Farisaini piyi karani yini be nga no ’ba erini imbale ’diyi ma dria, ’yozu kini, Emi nya azini emi mvu ’ba musoro okupi ’diyi be tualu, ’ba e’yo onzi ’yepi ’diyi be, a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nga e’yo omvi, ’yo yi tia, ’Ba rua be alaru ’diyi leni ojou ku, te ’ba azo be ’diyi leni; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma emuni ’ba kililiru ’diyi omvezu ku, te ’ba e’yo onzi ’yepi ’diyi omvezu asi ojazu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.32",
            "verseOrgIds": [
              "LUK.5.32"
            ]
          }
        }
      ]
    },
