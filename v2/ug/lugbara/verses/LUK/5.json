            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.13+MRK.2.14+MRK.2.15+MRK.2.16+MRK.2.17"
              },
              "items": [
                {
                  "text": "Mar 2:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’diyi ma vutia eri fu amve, nga ’ba musoro okupiri alu ndre, runi Levi’i, erini riria pari ’bani musoro ’bezuria; eri ’yo eri tia, Mi bi ma vuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ku afa dria, eri enga uru, bi vutini.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        }
