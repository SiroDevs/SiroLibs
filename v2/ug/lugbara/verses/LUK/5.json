                "loc": "MAT.8.1+MAT.8.2+MAT.8.3+MAT.8.4"
              },
              "items": [
                {
                  "text": "Mat 8:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.40+MRK.1.41+MRK.1.42+MRK.1.43+MRK.1.44+MRK.1.45"
              },
              "items": [
                {
                  "text": "Mar 1:40-45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, de eri ovu aku ’diyi ma azi alu ma alia, isu agupi alu indi, ofu nya eri rua kurubu; eri ka Yesuni ndre ra, eri nga i eco o’bukuru va, nga matu ’ba eri vu kini, Opi, mi ka le ra, eco mini ma rua ’bazaru alaru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.12",
            "verseOrgIds": [
              "LUK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri eju i dri, eri elo eri rua, kini, Ma le ra; mi ovu di alaru. Ofu ku di eri rua coti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.1+LEV.14.2+LEV.14.3+LEV.14.4+LEV.14.5+LEV.14.6+LEV.14.7+LEV.14.8+LEV.14.9+LEV.14.10+LEV.14.11+LEV.14.12+LEV.14.13+LEV.14.14+LEV.14.15+LEV.14.16+LEV.14.17+LEV.14.18+LEV.14.19+LEV.14.20+LEV.14.21+LEV.14.22+LEV.14.23+LEV.14.24+LEV.14.25+LEV.14.26+LEV.14.27+LEV.14.28+LEV.14.29+LEV.14.30+LEV.14.31+LEV.14.32"
              },
              "items": [
                {
                  "text": "Lev 14:1-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.13.49"
              },
              "items": [
                {
                  "text": "13:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri azi e’yo eri tia, eri ma ’yo ’ba azini ria aluni ku; te kini, Mi mu leti minia, mi ece mi ngulupi kuhani dri, mi ofe edeta mi ruani ecazu ’alaruri ma e’yosi kile Musani azilerile, e’yo eti nzezu yi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.14",
            "verseOrgIds": [
              "LUK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te di e’yo erini ku tu aga ra; ’ba ongulumuru kakau nga yi oku tualu ani e’yo erizu, azini dra yini ma ati ani beni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.15",
            "verseOrgIds": [
              "LUK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.35"
              },
              "items": [
                {
                  "text": "Mar 1:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ma ngulupi enga yi eselia, mu roko dria Mungu zizu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        }
      ]
    },
    {
