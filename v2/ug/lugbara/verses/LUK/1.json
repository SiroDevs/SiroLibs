            "sid": "LUK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba kakau yini dri ’bale e’yo ovupi ’yezaru yi paria ama eselia ’diyi otizu waraka ma alia kililirurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.1",
            "verseOrgIds": [
              "LUK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.27"
              },
              "items": [
                {
                  "text": "Yoh 15:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ekile ’ba e’yo nde ndrepi milesi engazu okokele e’yo ma azi ngapi ’diyini idrile ama vurile, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.2",
            "verseOrgIds": [
              "LUK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.1"
              },
              "items": [
                {
                  "text": "’Yeta 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e’yo ’disi ma ndre eri onyiru ma ma si ani waraka e’yo alu alu ecezu mi dri indi, ambo Teofilo, mani e’yo dria ma vuti drole kililiru engazu drio­risi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.3",
            "verseOrgIds": [
              "LUK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ma ni e’yo yini mi imbazuri ma ada ani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.5",
            "verseOrgIds": [
              "LUK.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.24.10"
              },
              "items": [
                {
                  "text": "1 Sur 24:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewu Herodeni ovuzu opiru Yudiaarisi, ’ba edeta edepiri ndra indi runi Zakaria’i, amutini Abiya vileri’i eri vile okuri ezoanzi Aronini ’diyi ma azi, ma ru Eliza­beti’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.5",
            "verseOrgIds": [
              "LUK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi iritro ovu ’ba kililiru Mungu ma milia, yi aci azita azini e’yo Opini azile ’diyi ma alia e’yo onzi kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.6",
            "verseOrgIds": [
              "LUK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te mva yini yo, Elizabetini ovule ondonirisi, yi iri tro ’ba dezani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, erini azi kuhanini ovupi pezaru eri driri ngaria amuti erini ma alia Mungu milia, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.8",
            "verseOrgIds": [
              "LUK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.7"
              },
              "items": [
                {
                  "text": "Efu 30:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ekile kubanini adrile ’yele rile, pe eri fizu Opi vile hekalua afa aji be arikariruri vezu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.9",
            "verseOrgIds": [
              "LUK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te etu ’bani afa aji be arikariruri vezuria, ’ba dria yi okupi nguluru ’diyi yi yini de Mungu a’iria amve. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.10",
            "verseOrgIds": [
              "LUK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika Opini pa sopi pari afa aji be arikariruri vezuri ma dri ndiriari nga i e’da eri ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.11",
            "verseOrgIds": [
              "LUK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakaria erini ndreria asi erini nga ori oti, urini nga eri bi ci. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.12",
            "verseOrgIds": [
              "LUK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te malaika ’yo eri tia, Mi ru ku, Zakaria, a’disiku zita mini ovu erizaru ’bo, oku mini Elizabetini nga mva ti mi dri, mi nga runi ’da Yohana’i.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.13",
            "verseOrgIds": [
              "LUK.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’diyi ma vutia oku erini Elizabeti nga mva isu i ma alia, nga i zi mba towi, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.24",
            "verseOrgIds": [
              "LUK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.23"
              },
              "items": [
                {
                  "text": "E’do 30:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi ’ye ma be ’dini ’bo o’du erini ma ndrezu, drinza mani nzezu ’ba ma eseliarisi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        }
      ]
    },
    {
