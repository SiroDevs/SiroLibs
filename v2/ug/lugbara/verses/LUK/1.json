      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba aziasi Mungu pe malaika Gabiraeli ma ti aku Galilia omvele Nazareti’iria, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.26",
            "verseOrgIds": [
              "LUK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.16"
              },
              "items": [
                {
                  "text": "Mat 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.5"
              },
              "items": [
                {
                  "text": "Luk 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aliria agu Daudi ma oriru omvele Yusufu’irini e’dole jeleri vu; aliria ma ru Mariamu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.27",
            "verseOrgIds": [
              "LUK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.24"
              },
              "items": [
                {
                  "text": "Lip 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika emu eri vu, nga ’yo ra, zi mi ci, mi ’ba ’yeta anzutiri a’ipi turi, Opi eri mi be! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.28",
            "verseOrgIds": [
              "LUK.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo ’dirisi asini nga oti oti, eri nga i zi ceni kini, ziza ’diri eri ziza ngoni ngori. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.29",
            "verseOrgIds": [
              "LUK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika ’yo eri tia kini, Mi ru ku, Mariamu, mi isu ’yeta anzutiri Mungu vu ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.30",
            "verseOrgIds": [
              "LUK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.21+MAT.1.22+MAT.1.23"
              },
              "items": [
                {
                  "text": "Mat 1:21-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.3"
              },
              "items": [
                {
                  "text": "Lip 13:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.14"
              },
              "items": [
                {
                  "text": "Isa 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi: ndre, mi nga mva isu mi alia, mi nga agimva ti, mi nga eri ru ’da Yesu’i.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.31",
            "verseOrgIds": [
              "LUK.1.31"
            ]
          }
        }
      ]
    },
    {
