          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orindi Alatararu nga ga ati Zakaria ma asia tre, eri nga e’yo ondri ’yozu kini,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
